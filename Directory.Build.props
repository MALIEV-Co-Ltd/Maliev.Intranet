<Project>
  <PropertyGroup>
    <SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Components.Authorization" Version="10.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.SignalR.Client" Version="10.0.3" />
    <PackageReference Update="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Update="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Update="MudBlazor" Version="9.1.0" />
    <PackageReference Update="MassTransit" Version="[8.5.8, 9.0.0)" />
    <PackageReference Update="MassTransit.Abstractions" Version="[8.5.8, 9.0.0)" />
    <PackageReference Update="MassTransit.RabbitMQ" Version="[8.5.8, 9.0.0)" />
  </ItemGroup>
</Project>
