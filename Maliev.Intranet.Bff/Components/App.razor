@inject PersistentComponentState ApplicationState
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<App> Logger
@using Maliev.Intranet.Client
@implements IDisposable

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Critical CSS: Apply background immediately to prevent flash -->
    <style>
        :root[data-theme="dark"] {
            color-scheme: dark;
        }
        :root[data-theme="dark"] body {
            background-color: #0d1117 !important;
            color: #c9d1d9 !important;
        }
        :root[data-theme="light"] {
            color-scheme: light;
        }
        :root[data-theme="light"] body {
            background-color: #ffffff !important;
            color: #24292f !important;
        }
    </style>

    <!-- CRITICAL: Blocking script BEFORE any CSS loads -->
    <script>
        (function() {
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            function getThemePreference() {
                // Priority: Cookie > localStorage > 'system'
                const cookie = getCookie('maliev_theme');
                if (cookie === 'dark' || cookie === 'light' || cookie === 'system') return cookie;

                try {
                    const local = localStorage.getItem('maliev_theme');
                    if (local === 'dark' || local === 'light' || local === 'system') return local;
                } catch (e) { /* localStorage blocked in Safari private mode */ }

                return 'system'; // Default
            }

            function applyTheme() {
                const pref = getThemePreference();
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                let effectiveTheme = 'light';

                if (pref === 'dark') {
                    effectiveTheme = 'dark';
                } else if (pref === 'light') {
                    effectiveTheme = 'light';
                } else {
                    if (systemDark) {
                        effectiveTheme = 'dark';
                    }
                }

                // Apply theme SYNCHRONOUSLY (blocks rendering)
                document.documentElement.setAttribute('data-theme', effectiveTheme);
                
                // Set a short-lived hint cookie for the server to avoid flicker on refresh
                document.cookie = `maliev_system_dark=${systemDark}; path=/; max-age=31536000; SameSite=Lax`;
            }

            applyTheme();
        })();
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;700&family=Noto+Sans+Thai:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="Maliev.Intranet.Client.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>

    <Routes @rendermode="InteractiveAuto" />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    // PersistentComponentState doesn't work reliably with InteractiveAuto
    // The blocking script handles theme persistence instead
    
    public void Dispose()
    {
        // No resources to dispose
    }
}
