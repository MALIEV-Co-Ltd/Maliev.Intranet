@using Maliev.Intranet.Client
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Loading MALIEV Intranet</title>
    
    <!-- Critical CSS: Apply background immediately to prevent flash -->
    <style>
        :root {
            --blazor-load-percentage: 0%;
            --blazor-load-percentage-text: "0%";
            --wasm-logo-progress: 0%;
            --wasm-logo-empty: #d7dde6;
            --wasm-logo-fill: #000000;
        }

        :root[data-maliev-theme="dark"] {
            color-scheme: dark;
            --wasm-loader-bg: #ffffff;
            --maliev-logo-loader-shadow:
                drop-shadow(0 20px 32px rgba(10, 20, 40, 0.34))
                drop-shadow(0 0 42px rgba(10, 20, 40, 0.18));
        }
        :root[data-maliev-theme="dark"] body {
            background-color: #0d1117 !important;
            color: #c9d1d9 !important;
        }
        :root[data-maliev-theme="light"] {
            color-scheme: light;
            --wasm-loader-bg: #ffffff;
            --maliev-logo-loader-shadow:
                drop-shadow(0 20px 32px rgba(10, 20, 40, 0.34))
                drop-shadow(0 0 42px rgba(10, 20, 40, 0.18));
        }
        :root[data-maliev-theme="light"] body {
            background-color: #ffffff !important;
            color: #24292f !important;
        }

        .wasm-loading {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: grid;
            place-items: center;
            background: var(--wasm-loader-bg, #ffffff);
            color: var(--wasm-logo-fill, #000000);
            transition: opacity 260ms ease, visibility 260ms ease;
        }

        .wasm-app-host {
            min-height: 100dvh;
            opacity: 0;
            transform: translateY(6px);
            transition:
                opacity 300ms ease,
                transform 300ms ease;
            will-change: opacity, transform;
        }

        html.maliev-wasm-ready .wasm-app-host {
            opacity: 1;
            transform: translateY(0);
            will-change: auto;
        }

        html.maliev-wasm-ready .wasm-loading {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        html.maliev-wasm-failed .wasm-loading-failure {
            display: block;
        }

        .wasm-loading-stage {
            display: grid;
            justify-items: center;
            gap: 22px;
        }

        .wasm-loading .maliev-logo-loader {
            --logo-width: clamp(150px, 38vw, 236px);
            --wasm-logo-progress: 0%;
            width: var(--logo-width);
            aspect-ratio: 449.33078 / 103.18751;
            position: relative;
            overflow: hidden;
            color: transparent;
            opacity: 0;
            background: var(--wasm-logo-empty, #d7dde6);
            -webkit-mask: url('/images/logo.svg') center / contain no-repeat;
            mask: url('/images/logo.svg') center / contain no-repeat;
            filter: var(--maliev-logo-loader-shadow);
            transition: opacity 180ms ease;
        }

        .wasm-loading .maliev-logo-loader::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: var(--wasm-logo-progress);
            background: var(--wasm-logo-fill, #000000);
        }

        html.maliev-wasm-loader-visible .wasm-loading .maliev-logo-loader {
            opacity: 1;
        }

        .wasm-loading-failure {
            display: none;
            max-width: 320px;
            color: var(--wasm-logo-fill, #000000);
            font-size: 13px;
            line-height: 1.45;
            opacity: 0.72;
            text-align: center;
        }

        @@media (prefers-reduced-motion: reduce) {
            .wasm-loading,
            .wasm-app-host {
                transition: none;
            }

            .wasm-app-host {
                transform: none;
            }
        }
    </style>

    <!-- CRITICAL: Blocking script BEFORE any CSS loads -->
    <script>
        (function() {
            const root = document.documentElement;

            root.classList.remove('maliev-wasm-runtime-ready', 'maliev-wasm-ready', 'maliev-wasm-failed');
            root.style.setProperty('--blazor-load-percentage', '0%');
            root.style.setProperty('--blazor-load-percentage-text', '"0%"');
            root.style.setProperty('--wasm-logo-progress', '0%');

            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            function getThemePreference() {
                // Priority: Cookie > localStorage > 'system'
                const cookie = getCookie('maliev_theme');
                if (cookie === 'dark' || cookie === 'light' || cookie === 'system') return cookie;

                try {
                    const local = localStorage.getItem('maliev_theme');
                    if (local === 'dark' || local === 'light' || local === 'system') return local;
                } catch (e) { /* localStorage blocked in Safari private mode */ }

                return 'system'; // Default
            }

            function applyTheme() {
                const pref = getThemePreference();
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                let effectiveTheme = 'light';

                if (pref === 'dark') {
                    effectiveTheme = 'dark';
                } else if (pref === 'light') {
                    effectiveTheme = 'light';
                } else {
                    if (systemDark) {
                        effectiveTheme = 'dark';
                    }
                }

                // Apply theme SYNCHRONOUSLY (blocks rendering)
                root.setAttribute('data-maliev-theme', effectiveTheme);

                // Set a short-lived hint cookie for the server to avoid flicker on refresh
                document.cookie = `maliev_system_dark=${systemDark}; path=/; max-age=31536000; SameSite=Lax`;
            }

            applyTheme();

            window.requestAnimationFrame(function () {
                window.requestAnimationFrame(function () {
                    root.classList.add('maliev-wasm-loader-visible');
                });
            });
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&family=Noto+Sans+Thai:wght@100..900&display=swap" rel="stylesheet">
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/design-tokens.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="css/module-pages.css" rel="stylesheet" />
    <link href="css/mudblazor-overrides.css" rel="stylesheet" />
    <link href="css/utilities.css" rel="stylesheet" />
    <link href="Maliev.Intranet.Client.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="WasmRenderMode" />
</head>

<body>
    <div id="wasm-loading" class="wasm-loading" aria-live="polite" aria-busy="true">
        <div class="wasm-loading-stage">
            <WasmLogoLoadingAnimation />
            <div class="wasm-loading-failure" role="alert">Unable to start the employee intranet. Refresh the page or contact support.</div>
        </div>
    </div>
    <div class="wasm-app-host">
        <Routes @rendermode="WasmRenderMode" />
    </div>
    <script>
        window.malievWasmLoader = (function () {
            const root = document.documentElement;
            const seenResources = new Set();
            let loadedResources = 0;
            let totalResources = 0;
            let displayedProgress = 0;

            function clamp(value) {
                return Math.max(0, Math.min(100, value));
            }

            function setProgress(value, allowDecrease) {
                const progress = clamp(Number.isFinite(value) ? value : 0);
                displayedProgress = allowDecrease
                    ? progress
                    : Math.max(displayedProgress, progress);

                const progressText = `${displayedProgress}%`;
                root.style.setProperty('--blazor-load-percentage', `${progress}%`);
                root.style.setProperty('--blazor-load-percentage-text', `"${Math.floor(displayedProgress)}%"`);
                root.style.setProperty('--wasm-logo-progress', progressText);

                document.querySelectorAll('.maliev-logo-loader').forEach(function (loader) {
                    loader.style.setProperty('--wasm-logo-progress', progressText);
                });
            }

            function markRuntimeReady() {
                setProgress(100, true);
                root.classList.add('maliev-wasm-runtime-ready');
            }

            function markReady() {
                markRuntimeReady();
                window.setTimeout(function () {
                    root.classList.add('maliev-wasm-ready');
                }, 220);
            }

            function markFailed(error) {
                console.error('MALIEV WASM startup failed', error);
                root.classList.add('maliev-wasm-failed');
            }

            function updateResourceProgress() {
                const estimatedTotal = Math.max(totalResources + 3, loadedResources + 1);
                setProgress(Math.min((loadedResources / estimatedTotal) * 100, 95));
            }

            function loadBootResource(type, name, defaultUri, integrity) {
                if (type === 'dotnetjs') {
                    return null;
                }

                const key = `${type}:${name}:${defaultUri}`;
                if (!seenResources.has(key)) {
                    seenResources.add(key);
                    totalResources += 1;
                    updateResourceProgress();
                }

                const requestInit = integrity ? { integrity } : undefined;
                return fetch(defaultUri, requestInit).then(
                    function (response) {
                        loadedResources += 1;
                        updateResourceProgress();
                        return response;
                    },
                    function (error) {
                        markFailed(error);
                        throw error;
                    });
            }

            setProgress(0, true);

            return {
                loadBootResource,
                markRuntimeReady,
                markReady,
                markFailed,
                setProgress
            };
        })();
        window.malievMarkWasmReady = window.malievWasmLoader.markReady;
    </script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            webAssembly: {
                loadBootResource: window.malievWasmLoader.loadBootResource
            }
        }).then(function () {
            window.malievWasmLoader.markRuntimeReady();
        }).catch(function (error) {
            window.malievWasmLoader.markFailed(error);
        });
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/note-editor.js"></script>
    <script src="js/chat.js"></script>
    <script src="js/uploadWithProgress.js"></script>
    <script src="js/address-map.js"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode WasmRenderMode =
        new InteractiveWebAssemblyRenderMode(prerender: false);
}
