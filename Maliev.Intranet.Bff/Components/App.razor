@using Maliev.Intranet.Client
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Critical CSS: Apply background immediately to prevent flash -->
    <style>
        :root[data-maliev-theme="dark"] {
            color-scheme: dark;
            --wasm-loader-bg: #0d1117;
            --maliev-logo-loader-outline: color-mix(in oklch, #ffffff 24%, transparent);
            --maliev-logo-loader-fill: #ffffff;
            --wasm-logo-outline: var(--maliev-logo-loader-outline);
            --wasm-logo-fill: var(--maliev-logo-loader-fill);
        }
        :root[data-maliev-theme="dark"] body {
            background-color: #0d1117 !important;
            color: #c9d1d9 !important;
        }
        :root[data-maliev-theme="light"] {
            color-scheme: light;
            --wasm-loader-bg: #ffffff;
            --maliev-logo-loader-outline: color-mix(in oklch, #000000 24%, transparent);
            --maliev-logo-loader-fill: #000000;
            --wasm-logo-outline: var(--maliev-logo-loader-outline);
            --wasm-logo-fill: var(--maliev-logo-loader-fill);
        }
        :root[data-maliev-theme="light"] body {
            background-color: #ffffff !important;
            color: #24292f !important;
        }

        .wasm-loading {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: grid;
            place-items: center;
            background: var(--wasm-loader-bg, #ffffff);
            color: var(--wasm-logo-fill, #000000);
            transition: opacity 180ms ease, visibility 180ms ease;
        }

        html.maliev-wasm-ready .wasm-loading {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .wasm-loading .maliev-logo-loader {
            --logo-width: clamp(150px, 38vw, 236px);
            width: var(--logo-width);
            aspect-ratio: 449.33078 / 103.18751;
            position: relative;
            color: transparent;
            background: var(--wasm-logo-outline, color-mix(in oklch, #000000 24%, transparent));
            -webkit-mask: url('/images/logo.svg') center / contain no-repeat;
            mask: url('/images/logo.svg') center / contain no-repeat;
        }

        .wasm-loading .maliev-logo-loader::after {
            content: "";
            position: absolute;
            inset: 0;
            background: conic-gradient(var(--wasm-logo-fill, #000000) 0 0) 0 / 0% 100% no-repeat;
            animation: maliev-logo-load 1s linear infinite;
        }

        @@keyframes maliev-logo-load {
            to {
                background-size: 120% 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .wasm-loading .maliev-logo-loader::after {
                animation: none;
                background-size: 120% 100%;
            }
        }
    </style>

    <!-- CRITICAL: Blocking script BEFORE any CSS loads -->
    <script>
        (function() {
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            function getThemePreference() {
                // Priority: Cookie > localStorage > 'system'
                const cookie = getCookie('maliev_theme');
                if (cookie === 'dark' || cookie === 'light' || cookie === 'system') return cookie;

                try {
                    const local = localStorage.getItem('maliev_theme');
                    if (local === 'dark' || local === 'light' || local === 'system') return local;
                } catch (e) { /* localStorage blocked in Safari private mode */ }

                return 'system'; // Default
            }

            function applyTheme() {
                const pref = getThemePreference();
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                let effectiveTheme = 'light';

                if (pref === 'dark') {
                    effectiveTheme = 'dark';
                } else if (pref === 'light') {
                    effectiveTheme = 'light';
                } else {
                    if (systemDark) {
                        effectiveTheme = 'dark';
                    }
                }

                // Apply theme SYNCHRONOUSLY (blocks rendering)
                document.documentElement.setAttribute('data-maliev-theme', effectiveTheme);

                // Set a short-lived hint cookie for the server to avoid flicker on refresh
                document.cookie = `maliev_system_dark=${systemDark}; path=/; max-age=31536000; SameSite=Lax`;
            }

            applyTheme();
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/design-tokens.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="css/module-pages.css" rel="stylesheet" />
    <link href="css/mudblazor-overrides.css" rel="stylesheet" />
    <link href="css/utilities.css" rel="stylesheet" />
    <link href="Maliev.Intranet.Client.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="WasmRenderMode" />
</head>

<body>
    <div id="wasm-loading" class="wasm-loading" aria-live="polite" aria-busy="true">
        <WasmLogoLoadingAnimation />
    </div>
    <Routes @rendermode="WasmRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/note-editor.js"></script>
    <script src="js/chat.js"></script>
    <script src="js/uploadWithProgress.js"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode WasmRenderMode =
        new InteractiveWebAssemblyRenderMode(prerender: false);
}
