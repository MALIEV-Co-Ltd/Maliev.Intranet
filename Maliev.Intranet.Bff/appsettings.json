{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.StaticFiles": "Warning",
      "Microsoft.AspNetCore.StaticAssets": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CompanyParams": {
    "LogoUrl": "https://storage.googleapis.com/maliev.com/web-contents/images/logo-white-20px.png"
  },
  "Upload": {
    "MaxConcurrentUploads": 3,
    "MaxFileSizeBytes": {
      "ThreeDModel": 104857600,
      "Drawing": 52428800,
      "Document": 52428800
    }
  },
  "FileTypes": {
    "ThreeDExtensions": [".stl", ".step", ".stp", ".3mf", ".obj", ".igs", ".iges", ".fbx", ".gltf", ".glb"],
    "DrawingExtensions": [".pdf", ".dxf", ".dwg", ".png", ".jpg", ".jpeg"],
    "SupplementaryExtensions": [".png", ".jpg", ".jpeg", ".tiff", ".bmp", ".webp", ".doc", ".docx", ".xls", ".xlsx", ".zip", ".rar", ".7z"],
    "DocumentExtensions": [".pdf", ".dxf", ".dwg"],
    "ImageExtensions": [".png", ".jpg", ".jpeg", ".tiff", ".bmp", ".webp"],
    "OfficeExtensions": [".doc", ".docx", ".xls", ".xlsx"],
    "ArchiveExtensions": [".zip", ".rar", ".7z"]
  }
}
