@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Current status: <strong>@FormatStatus(CurrentStatus)</strong>
        </MudText>

        <MudSelect @bind-Value="_request.NewStatus"
                   Label="New Status"
                   Required="true"
                   Variant="Variant.Outlined"
                   Class="mb-3">
            @foreach (var transition in GetAllowedTransitions(CurrentStatus))
            {
                <MudSelectItem Value="@transition">@FormatStatus(transition)</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_request.Reason"
                      Label="Reason (optional)"
                      Variant="Variant.Outlined"
                      Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="Submit"
                   Disabled="@(_isSaving || string.IsNullOrEmpty(_request.NewStatus))">
            @(_isSaving ? "Saving..." : "Change Status")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the ID of the equipment whose status is being changed.</summary>
    [Parameter] public Guid EquipmentId { get; set; }

    /// <summary>Gets or sets the current status of the equipment.</summary>
    [Parameter] public string CurrentStatus { get; set; } = string.Empty;

    private bool _isSaving;

    private readonly ChangeEquipmentStatusRequest _request = new()
    {
        NewStatus = string.Empty,
        RowVersion = 0u
    };

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(_request.NewStatus)) return;
        _isSaving = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/equipments/{EquipmentId}/status", _request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Equipment status updated.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var statusCode = (int)response.StatusCode;
                Snackbar.Add(statusCode == 422
                    ? "Invalid status transition."
                    : statusCode == 409
                        ? "Concurrent modification — please reload."
                        : "Failed to update status.",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatStatus(string status) => status switch
    {
        "UnderMaintenance" => "Under Maintenance",
        "OnLoan" => "On Loan",
        _ => status
    };

    private static IReadOnlyList<string> GetAllowedTransitions(string current) => current switch
    {
        "Active" => ["UnderMaintenance", "OnLoan", "Lost", "Decommissioned"],
        "UnderMaintenance" => ["Active", "Decommissioned"],
        "OnLoan" => ["Active"],
        "Lost" => ["Active", "Decommissioned"],
        _ => []
    };
}
