@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="3">
                <MudSelect T="string" @bind-Value="_leaveType" Label="Leave Type" Variant="Variant.Outlined" Required="true" RequiredError="Please select leave type">
                    <MudSelectItem Value="@("Annual")">Annual Leave</MudSelectItem>
                    <MudSelectItem Value="@("Sick")">Sick Leave</MudSelectItem>
                    <MudSelectItem Value="@("Personal")">Personal Leave</MudSelectItem>
                    <MudSelectItem Value="@("Maternity")">Maternity Leave</MudSelectItem>
                    <MudSelectItem Value="@("Paternity")">Paternity Leave</MudSelectItem>
                    <MudSelectItem Value="@("Bereavement")">Bereavement Leave</MudSelectItem>
                </MudSelect>

                <MudDatePicker @bind-Date="_startDate" Label="Start Date" Variant="Variant.Outlined" Required="true" />
                <MudDatePicker @bind-Date="_endDate" Label="End Date" Variant="Variant.Outlined" Required="true" />

                <MudCheckBox T="bool" @bind-Value="_isHalfDay" Label="Half Day" />

                <MudTextField @bind-Value="_reason" Label="Reason" Variant="Variant.Outlined" Lines="3" Placeholder="Brief description of the leave request..." />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_isSaving || !_isValid)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Submit Request
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private DateTime? _startDate = DateTime.Today.AddDays(1);
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private string _leaveType = string.Empty;
    private string _reason = string.Empty;
    private bool _isHalfDay;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (_startDate == null || _endDate == null)
        {
            Snackbar.Add("Please select start and end dates", Severity.Warning);
            return;
        }

        if (_endDate < _startDate)
        {
            Snackbar.Add("End date must be after start date", Severity.Warning);
            return;
        }

        var request = new SubmitLeaveRequestDto
        {
            LeaveType = _leaveType,
            StartDate = _startDate.Value,
            EndDate = _endDate.Value,
            HalfDayPeriod = _isHalfDay ? "Morning" : null,
            Reason = _reason
        };

        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/timeoff/requests", request);
            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to submit request: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
