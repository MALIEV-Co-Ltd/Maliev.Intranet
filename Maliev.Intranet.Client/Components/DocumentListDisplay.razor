<MudPaper Class="pa-4" Elevation="1">
    <div class="d-flex align-center justify-space-between mb-3">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@Title (@Documents.Count)</MudText>
        </div>
    </div>

    @if (!Documents.Any())
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            No documents uploaded yet
        </MudAlert>
    }
    else
    {
        <MudList T="string" Dense="true">
            @foreach (var doc in Documents.OrderBy(d => d.DisplayOrder ?? 0).ThenBy(d => d.FileName))
            {
                <MudListItem T="string">
                    <div class="d-flex justify-space-between align-center py-1">
                        <div class="d-flex align-center flex-grow-1">
                            <MudIcon Icon="@GetFileIcon(doc.FileName)"
                                     Size="Size.Small"
                                     Class="mr-3" />
                            <div class="flex-grow-1">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.body2">@doc.FileName</MudText>
                                    @if (!IsNdaSection)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                            @doc.DocumentCategory
                                        </MudChip>
                                    }
                                    @if (!string.IsNullOrEmpty(doc.DocumentSubType))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @doc.DocumentSubType
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @FormatFileSize(doc.FileSize)
                                    @if (!string.IsNullOrEmpty(doc.Description))
                                    {
                                        <span> • @doc.Description</span>
                                    }
                                </MudText>
                            </div>
                        </div>
                        @if (AllowRemove)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => HandleRemove(doc))" />
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "Uploaded Documents";

    [Parameter]
    public bool IsNdaSection { get; set; }

    [Parameter]
    public List<CreateDocumentRequest> Documents { get; set; } = [];

    [Parameter]
    public EventCallback<CreateDocumentRequest> OnRemove { get; set; }

    [Parameter]
    public bool AllowRemove { get; set; } = true;

    private async Task HandleRemove(CreateDocumentRequest doc)
    {
        await OnRemove.InvokeAsync(doc);
    }

    private string GetFileIcon(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".jpg" or ".jpeg" or ".png" => Icons.Material.Filled.Image,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
