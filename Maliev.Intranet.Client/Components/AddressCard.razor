@using MudBlazor
@using Maliev.Intranet.Shared

<MudPaper Elevation="2" Class="address-card-paper">
    <div class="address-card-header">
        <MudChip T="string" 
                 Color="@GetTypeColor()" 
                 Size="Size.Small" 
                 Class="address-type-chip">
            @Address.Type
            @if (Address.IsDefault)
            {
                @if (Address.Type == "Billing")
                {
                    <span class="default-indicator">• Default Billing</span>
                }
                else if (Address.Type == "Shipping")
                {
                    <span class="default-indicator">• Default Shipping</span>
                }
                else
                {
                    <span class="default-indicator">• Default</span>
                }
            }
        </MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                       Size="Size.Small" 
                       Color="Color.Error"
                       OnClick="@(() => OnRemove?.Invoke(Index))"
                       Class="btn-delete-address" />
    </div>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudRadioGroup T="string" 
                           Value="@Address.Type"
                           ValueChanged="@((string val) => OnTypeChanged?.Invoke(Index, val))"
                           Class="mt-2">
                <MudRadio Value="@("Billing")" Color="Color.Primary" Size="Size.Small" Dense="true">Billing</MudRadio>
                <MudRadio Value="@("Shipping")" Color="Color.Default" Size="Size.Small" Dense="true">Shipping</MudRadio>
            </MudRadioGroup>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudCheckBox T="bool" 
                         Value="@Address.IsDefault"
                         ValueChanged="@((bool val) => OnDefaultChanged?.Invoke(Index, val))"
                         Color="Color.Primary" 
                         Dense="true"
                         Class="mt-1">
                <span style="font-size: var(--mud-typography-default-size);">@GetDefaultLabel()</span>
            </MudCheckBox>
        </MudItem>

        @if (Address.Type == "Billing")
        {
            @if (HasCompany)
            {
                <MudItem xs="12">
                    <MudTextField T="string" 
                                  Label="Company Name" 
                                  Value="@CompanyName" 
                                  Variant="Variant.Outlined" 
                                  ReadOnly="true" 
                                  Disabled="true" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" 
                                  Label="Customer Name" 
                                  Value="@CustomerName" 
                                  Variant="Variant.Outlined" 
                                  ReadOnly="true" 
                                  Disabled="true"
                                  HelperText="From personal information" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" 
                                  Label="Customer Mobile" 
                                  Value="@CustomerMobile" 
                                  Variant="Variant.Outlined" 
                                  ReadOnly="true" 
                                  Disabled="true"
                                  HelperText="From personal information" />
                </MudItem>
            }
        }

        @if (Address.Type == "Shipping")
        {
            <MudItem xs="12" sm="6">
                <MudTextField T="string" 
                              Label="Recipient Name" 
                              @bind-Value="Address.RecipientName"
                              Variant="Variant.Outlined"
                              />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField T="string" 
                              Label="Recipient Phone" 
                              @bind-Value="Address.RecipientPhone"
                              Variant="Variant.Outlined"
                              Placeholder="+66812345678"
                              />
            </MudItem>
        }

        <MudItem xs="12">
            <MudTextField T="string" 
                          Label="Address Line 1" 
                          @bind-Value="Address.AddressLine1"
                          Variant="Variant.Outlined"
                          Required="true"
                          Placeholder="House/building number, street"
                          />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string" 
                          Label="Address Line 2 (Optional)" 
                          @bind-Value="Address.AddressLine2"
                          Variant="Variant.Outlined"
                          Placeholder="Floor, unit, building name"
                          />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string" 
                          Label="Address Line 3 (Optional)" 
                          @bind-Value="Address.AddressLine3"
                          Variant="Variant.Outlined"
                          Placeholder="Additional details"
                          />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudAutocomplete T="RegistryThaiLocation"
                             Label="District/Subdistrict"
                             Value="@SelectedLocation"
                             Text="@Address.District"
                             TextChanged="@((string text) => Address.District = text)"
                             SearchFunc="@SearchLocations"
                             ToStringFunc="@(l => l != null ? (IsThai(Address.District) ? l.SubDistrictTh : l.SubDistrictEn) : (Address.District ?? string.Empty))"
                             Variant="Variant.Outlined"
                             Clearable="true"
                             CoerceText="false"
                             CoerceValue="false"
                             ResetValueOnEmptyText="false"
                             DebounceInterval="500"
                             MinCharacters="2"
                             ValueChanged="@((RegistryThaiLocation? loc) => OnLocationSelected?.Invoke(Index, loc))"
                            >
                <ItemTemplate Context="loc">
                    <div class="autocomplete-item py-1">
                        @if (IsThai(Address.District) || IsThai(loc.SubDistrictTh))
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                        }
                    </div>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudAutocomplete T="RegistryThaiLocation"
                             Label="City/District"
                             Value="@SelectedLocation"
                             Text="@Address.City"
                             TextChanged="@((string text) => Address.City = text)"
                             SearchFunc="@SearchLocations"
                             ToStringFunc="@(l => l != null ? (IsThai(Address.City) ? l.DistrictTh : l.DistrictEn) : (Address.City ?? string.Empty))"
                             Variant="Variant.Outlined"
                             Required="true"
                             Clearable="true"
                             CoerceText="false"
                             CoerceValue="false"
                             ResetValueOnEmptyText="false"
                             DebounceInterval="500"
                             MinCharacters="2"
                             ValueChanged="@((RegistryThaiLocation? loc) => OnLocationSelected?.Invoke(Index, loc))"
                            >
                <ItemTemplate Context="loc">
                    <div class="autocomplete-item py-1">
                        @if (IsThai(Address.City) || IsThai(loc.DistrictTh))
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                        }
                    </div>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudAutocomplete T="RegistryThaiLocation"
                             Label="State/Province"
                             Value="@SelectedLocation"
                             Text="@Address.StateProvince"
                             TextChanged="@((string text) => Address.StateProvince = text)"
                             SearchFunc="@SearchLocations"
                             ToStringFunc="@(l => l != null ? (IsThai(Address.StateProvince) ? l.ProvinceTh : l.ProvinceEn) : (Address.StateProvince ?? string.Empty))"
                             Variant="Variant.Outlined"
                             Required="true"
                             Clearable="true"
                             CoerceText="false"
                             CoerceValue="false"
                             ResetValueOnEmptyText="false"
                             DebounceInterval="500"
                             MinCharacters="2"
                             ValueChanged="@((RegistryThaiLocation? loc) => OnLocationSelected?.Invoke(Index, loc))"
                            >
                <ItemTemplate Context="loc">
                    <div class="autocomplete-item py-1">
                        @if (IsThai(Address.StateProvince) || IsThai(loc.ProvinceTh))
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@($"{loc.SubDistrictEn}, {loc.DistrictEn}, {loc.ProvinceEn} {loc.PostalCode}")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictTh} {loc.DistrictTh} {loc.ProvinceTh} {loc.PostalCode}")</MudText>
                        }
                    </div>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudAutocomplete T="RegistryThaiLocation"
                             Label="Postal Code"
                             Value="@SelectedLocation"
                             Text="@Address.PostalCode"
                             TextChanged="@((string text) => Address.PostalCode = text)"
                             SearchFunc="@SearchLocations"
                             ToStringFunc="@(l => l?.PostalCode ?? (Address.PostalCode ?? string.Empty))"
                             Variant="Variant.Outlined"
                             Required="true"
                             Clearable="true"
                             CoerceText="false"
                             CoerceValue="false"
                             ResetValueOnEmptyText="false"
                             DebounceInterval="500"
                             MinCharacters="2"
                             ValueChanged="@((RegistryThaiLocation? loc) => OnLocationSelected?.Invoke(Index, loc))"
                            >
                <ItemTemplate Context="loc">
                    <div class="autocomplete-item py-1">
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@loc.PostalCode</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">@($"{loc.SubDistrictTh}, {loc.DistrictTh}, {loc.ProvinceTh}")</MudText>
                    </div>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12">
            <MudAutocomplete T="CountryDto"
                             Label="Country"
                             Value="@SelectedCountry"
                             SearchFunc="@SearchCountries"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Variant="Variant.Outlined"
                             Required="true"
                             DebounceInterval="300"
                             ValueChanged="@((CountryDto? c) => OnCountrySelected?.Invoke(Index, c))"
                             />
        </MudItem>
    </MudGrid>
</MudPaper>


@code {
    [Parameter] public CreateAddressRequest Address { get; set; } = new();
    [Parameter] public int Index { get; set; }
    [Parameter] public CountryDto? SelectedCountry { get; set; }
    [Parameter] public RegistryThaiLocation? SelectedLocation { get; set; }
    [Parameter] public bool HasCompany { get; set; }
    [Parameter] public string? CompanyName { get; set; }
    [Parameter] public string? CustomerName { get; set; }
    [Parameter] public string? CustomerMobile { get; set; }
    [Parameter] public Action<int, string>? OnTypeChanged { get; set; }
    [Parameter] public Action<int, bool>? OnDefaultChanged { get; set; }
    [Parameter] public Action<int, RegistryThaiLocation?>? OnLocationSelected { get; set; }
    [Parameter] public Action<int, CountryDto?>? OnCountrySelected { get; set; }
    [Parameter] public Action<int>? OnRemove { get; set; }
    [Parameter] public Func<string?, CancellationToken, Task<IEnumerable<RegistryThaiLocation>>>? SearchLocations { get; set; }
    [Parameter] public Func<string?, CancellationToken, Task<IEnumerable<CountryDto>>>? SearchCountries { get; set; }

    private Color GetTypeColor() => Address.Type switch
    {
        "Billing" => Color.Primary,
        "Shipping" => Color.Default,
        _ => Color.Default
    };

    private string GetDefaultLabel() => Address.Type switch
    {
        "Billing" => "Default billing",
        "Shipping" => "Default shipping",
        _ => "Default address"
    };

    private static bool IsThai(string? value) => value?.Any(c => c >= 0x0E00 && c <= 0x0E7F) ?? false;
}
