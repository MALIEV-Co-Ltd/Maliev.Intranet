@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudTextField Label="Customer PO Number"
                              @bind-Value="_customerPoNumber"
                              Variant="Variant.Outlined" />

                <MudTextField Label="Notes"
                              @bind-Value="_notes"
                              Lines="3"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_isValid || _isSaving)"
                   OnClick="Submit">
            @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save Changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string OrderId { get; set; } = string.Empty;

    [Parameter]
    public OrderDetailDto? Order { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private string? _customerPoNumber;
    private string? _notes;

    protected override void OnParametersSet()
    {
        if (Order != null)
        {
            _customerPoNumber = Order.CustomerPoNumber;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isSaving = true;
        try
        {
            var request = new UpdateOrderRequest
            {
                CustomerPoNumber = _customerPoNumber,
                Notes = _notes
            };
            var response = await Http.PutAsJsonAsync($"api/orders/{OrderId}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Order updated successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update order.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
