@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @Checklist.Tasks.Count(t => t.IsCompleted) of @Checklist.Tasks.Count tasks completed
        </MudText>
        <MudProgressLinear Color="Color.Primary" Value="@ProgressPercent" Class="mb-4" />

        <MudList T="OnboardingTaskDto" Dense="true">
            @foreach (var task in Checklist.Tasks)
            {
                <MudListItem T="OnboardingTaskDto" Value="task">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudCheckBox T="bool" Value="@task.IsCompleted" ValueChanged="@((v) => ToggleTask(task, v))" Color="Color.Success" />
                        <MudText Typo="Typo.body2" Style="@(task.IsCompleted ? "text-decoration: line-through; opacity: 0.6;" : "")">@task.Title</MudText>
                    </MudStack>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public OnboardingChecklistDto Checklist { get; set; } = null!;
    [Parameter] public string EmployeeName { get; set; } = string.Empty;

    private double ProgressPercent => Checklist.Tasks.Count > 0
        ? (double)Checklist.Tasks.Count(t => t.IsCompleted) / Checklist.Tasks.Count * 100
        : 0;

    private async Task ToggleTask(OnboardingTaskDto task, bool completed)
    {
        var previousValue = task.IsCompleted;
        task.IsCompleted = completed;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/onboarding/{Checklist.EmployeeId}/tasks/{task.Id}", new UpdateOnboardingProgressRequest
            {
                TaskId = task.Id,
                IsCompleted = completed
            });
            if (!response.IsSuccessStatusCode)
            {
                task.IsCompleted = previousValue;
                Snackbar.Add("Failed to update task", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            task.IsCompleted = previousValue;
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
