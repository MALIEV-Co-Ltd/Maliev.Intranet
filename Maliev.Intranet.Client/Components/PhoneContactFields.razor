@* Structured phone number input with corporate context *@
<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 500;">
            Personal Contact
        </MudText>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField Label="Mobile Phone"
                      Value="@Mobile"
                      ValueChanged="@((string value) => MobileChanged.InvokeAsync(value))"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Placeholder="e.g., +66812345678" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField Label="Landline"
                      Value="@Landline"
                      ValueChanged="@((string value) => LandlineChanged.InvokeAsync(value))"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </MudItem>

    @if (ShowCorporateFields)
    {
        <MudItem xs="12" Class="mt-2">
            <MudDivider />
            <MudText Typo="Typo.body2" Class="mt-3 mb-1" Style="font-weight: 500;">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
                Corporate Extension
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-2">
                    For company customers
                </MudChip>
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField Label="Company Main Number"
                          Value="@CompanyPhone"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="true"
                          HelperText="From company profile" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField Label="Extension"
                          Value="@Extension"
                          ValueChanged="@((string value) => ExtensionChanged.InvokeAsync(value))"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="e.g., 101"
                          HelperText="Direct extension at company" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter]
    public string? Mobile { get; set; }

    [Parameter]
    public EventCallback<string?> MobileChanged { get; set; }

    [Parameter]
    public string? Landline { get; set; }

    [Parameter]
    public EventCallback<string?> LandlineChanged { get; set; }

    [Parameter]
    public string? Extension { get; set; }

    [Parameter]
    public EventCallback<string?> ExtensionChanged { get; set; }

    [Parameter]
    public string? CompanyPhone { get; set; }

    [Parameter]
    public bool ShowCorporateFields { get; set; }
}
