@using Maliev.Intranet.Shared

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Edit Country
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="3">
                <MudTextField Value="@Country.Code"
                              Label="Code"
                              ReadOnly="true"
                              Variant="Variant.Outlined"
                              Disabled="true" />
                <MudTextField @bind-Value="_name"
                              Label="Name"
                              Required="true"
                              RequiredError="Name is required"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isBusy">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isBusy)">
            @(_isBusy ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Parameter] public CountryDto Country { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isBusy;
    private string _name = string.Empty;

    protected override void OnInitialized()
    {
        _name = Country.Name;
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isBusy = true;
        try
        {
            var payload = new { Name = _name };
            var response = await Http.PatchAsJsonAsync($"api/reference-data/countries/{Country.Code}", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Country updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update country", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
