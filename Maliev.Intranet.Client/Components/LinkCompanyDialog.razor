@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-4 pt-4">
            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Link Company</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="px-4">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                Assign this customer to an existing company or create a new company profile.
            </MudText>

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                <MudTabPanel Text="Search Existing" Icon="@Icons.Material.Filled.Search">
                    <MudAutocomplete T="CompanySummaryDto"
                                     Label="Search Company Name or Tax ID"
                                     Value="@_selectedExistingCompany"
                                     ValueChanged="OnExistingCompanySelected"
                                     SearchFunc="SearchExistingCompanies"
                                     ToStringFunc="@(c => c == null ? "" : $"{c.Name} ({c.VatNumber})")"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Placeholder="Type to search..."
                                     Class="rounded-xl" />
                    
                    @if (_selectedExistingCompany != null)
                    {
                        <MudPaper Class="pa-4 mt-4 rounded-lg border-solid border-1 mud-border-lines-default" Elevation="0">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@_selectedExistingCompany.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Tax ID: @_selectedExistingCompany.VatNumber</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Segment: @_selectedExistingCompany.Segment | Tier: @_selectedExistingCompany.Tier</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Add New" Icon="@Icons.Material.Filled.AddBusiness">
                    <MudStack Spacing="4">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudTextField T="string"
                                          Label="Tax ID / Juristic ID"
                                          @bind-Value="_newCompany.VatNumber"
                                          Variant="Variant.Outlined"
                                          Placeholder="0105500002375 (13 digits)"
                                          ReadOnly="@_newCompany.IsVerifiedFromBdex"
                                          Class="flex-grow-1"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Badge" />

                            @if (!_newCompany.IsVerifiedFromBdex)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="LookupCompanyByTaxId"
                                           Disabled="@(_isLookingUp || string.IsNullOrWhiteSpace(_newCompany.VatNumber))"
                                           Style="margin-top: 4px; min-width: 120px;">
                                    @if (_isLookingUp)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <span>Verify</span>
                                    }
                                </MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="ResetLookup" Style="margin-top: 4px;" />
                            }
                        </MudStack>

                        <MudTextField T="string" Label="Company Name" @bind-Value="_newCompany.Name" Variant="Variant.Outlined" Required="true" ReadOnly="@_newCompany.IsVerifiedFromBdex" />
                        
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudSelect T="string" Label="Segment" @bind-Value="_newCompany.Segment" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                    <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                    <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect T="string" Label="Tier" @bind-Value="_newCompany.Tier" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("Bronze")">Bronze</MudSelectItem>
                                    <MudSelectItem Value="@("Silver")">Silver</MudSelectItem>
                                    <MudSelectItem Value="@("Gold")">Gold</MudSelectItem>
                                    <MudSelectItem Value="@("Platinum")">Platinum</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-8 pb-8 d-flex w-100 justify-end gap-2">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Class="rounded-lg">CANCEL</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Submit"
                       Disabled="@(!IsValid())"
                       Class="px-8 rounded-lg shadow-none">
                LINK COMPANY
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid CustomerId { get; set; }

    private CompanySummaryDto? _selectedExistingCompany;
    private CreateCompanyRequest _newCompany = new() { Segment = "Retail", Tier = "Bronze" };
    private bool _isLookingUp = false;

    private void OnExistingCompanySelected(CompanySummaryDto? company)
    {
        _selectedExistingCompany = company;
        if (company != null)
        {
            // Reset new company if existing is selected
            _newCompany = new CreateCompanyRequest { Segment = "Retail", Tier = "Bronze" };
        }
    }

    private async Task<IEnumerable<CompanySummaryDto>> SearchExistingCompanies(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value)) return Array.Empty<CompanySummaryDto>();
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CompanySummaryDto>>($"api/companies?query={Uri.EscapeDataString(value)}", ct);
            return response?.Data ?? Array.Empty<CompanySummaryDto>();
        }
        catch
        {
            return Array.Empty<CompanySummaryDto>();
        }
    }

    private async Task LookupCompanyByTaxId()
    {
        if (string.IsNullOrWhiteSpace(_newCompany.VatNumber)) return;
        _isLookingUp = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<RegistryCompanyProfile>>($"api/customers/companies/search?query={Uri.EscapeDataString(_newCompany.VatNumber)}&limit=1");
            if (response?.Any() == true)
            {
                var company = response.First();
                _newCompany.Name = company.CompanyNameTh;
                _newCompany.FullNameTh = company.FullNameTh;
                _newCompany.CompanyStatus = company.StatusCode;
                _newCompany.CompanyStatusNameTh = company.StatusNameTh;
                _newCompany.IsVerifiedFromBdex = true;
                Snackbar.Add("Company verified from DBD", Severity.Success);
            }
            else
            {
                Snackbar.Add("Company not found in registry. You can enter manually.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lookup failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLookingUp = false;
        }
    }

    private void ResetLookup()
    {
        var vat = _newCompany.VatNumber;
        _newCompany = new CreateCompanyRequest { VatNumber = vat, Segment = "Retail", Tier = "Bronze" };
    }

    private bool IsValid()
    {
        if (_selectedExistingCompany != null) return true;
        return !string.IsNullOrWhiteSpace(_newCompany.Name) && !string.IsNullOrWhiteSpace(_newCompany.VatNumber);
    }

    private void Submit()
    {
        if (_selectedExistingCompany != null)
        {
            MudDialog.Close(DialogResult.Ok(new LinkCompanyResult { CompanyId = _selectedExistingCompany.Id }));
        }
        else
        {
            MudDialog.Close(DialogResult.Ok(new LinkCompanyResult { NewCompany = _newCompany }));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public class LinkCompanyResult
    {
        public Guid? CompanyId { get; set; }
        public CreateCompanyRequest? NewCompany { get; set; }
    }
}
