@using Maliev.Intranet.Shared
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudTextField Label="Title / Position"
                              @bind-Value="_title"
                              Variant="Variant.Outlined" />

                <MudTextField Label="Department"
                              @bind-Value="_department"
                              Variant="Variant.Outlined" />

                <MudTextField Label="Phone"
                              @bind-Value="_phone"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_isValid || _isSaving)"
                   OnClick="Submit">
            @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save Changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid EmployeeId { get; set; }

    [Parameter]
    public EmployeeDetailDto? Employee { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private string? _title;
    private string? _department;
    private string? _phone;

    protected override void OnParametersSet()
    {
        if (Employee != null)
        {
            _title = Employee.JobTitle;
            _department = Employee.DepartmentName;
            _phone = Employee.MobilePhone;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isSaving = true;
        try
        {
            var request = new UpdateEmployeeRequest
            {
                Title = _title,
                Department = _department,
                Phone = _phone
            };
            var response = await Http.PutAsJsonAsync($"api/employees/{EmployeeId}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Employee updated successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update employee.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
