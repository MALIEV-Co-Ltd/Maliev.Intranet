@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Approving this loan will activate it. For customer loans, a loan agreement PDF will be generated.
        </MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField @bind-Value="_request.BorrowerDisplayName"
                              Label="Borrower Display Name"
                              Required="true"
                              Variant="Variant.Outlined"
                              HelperText="Used in the loan agreement PDF (e.g., 'John Doe', 'Acme Corp')" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   OnClick="Submit"
                   Disabled="@(_isSaving || string.IsNullOrWhiteSpace(_request.BorrowerDisplayName))">
            @(_isSaving ? "Approving..." : "Approve Loan")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the ID of the loan to approve.</summary>
    [Parameter] public Guid LoanId { get; set; }

    /// <summary>Gets or sets the xmin row version for optimistic concurrency.</summary>
    [Parameter] public uint RowVersion { get; set; }

    private bool _isSaving;

    private ApproveLoanRequest _request = new()
    {
        BorrowerDisplayName = string.Empty
    };

    protected override void OnParametersSet()
    {
        _request = _request with { RowVersion = RowVersion };
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_request.BorrowerDisplayName)) return;
        _isSaving = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/equipments/loans/{LoanId}/approve", _request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Loan approved.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var statusCode = (int)response.StatusCode;
                Snackbar.Add(statusCode == 409
                    ? "Concurrent modification — please reload and try again."
                    : "Failed to approve loan.",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
