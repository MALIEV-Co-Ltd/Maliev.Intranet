@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudStack Spacing="4">
    <MudText Typo="Typo.h6">Pricing History</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@_snapshots" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>By</MudTh>
                <MudTh>Tech</MudTh>
                <MudTh>Material</MudTh>
                <MudTh>Config</MudTh>
                <MudTh>Price (Calc)</MudTh>
                <MudTh>Override</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.CreatedAt.ToString("g")</MudTd>
                <MudTd DataLabel="By">@context.EmployeeId</MudTd>
                <MudTd DataLabel="Tech">@context.Technology</MudTd>
                <MudTd DataLabel="Material">@context.MaterialBrand @context.MaterialCode</MudTd>
                <MudTd DataLabel="Config">
                    <MudTooltip Text="@($"Layer: {context.LayerHeight}µm, Infill: {context.InfillPercentage}%")">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Price (Calc)">@context.CalculatedPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="Override">@context.ManualOverridePrice?.ToString("N2")</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Status == "Accepted")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Accepted</MudChip>
                    }
                    else if (context.Status == "Superseded")
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Superseded</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Draft</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    @if (context.Status != "Accepted")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="@(() => AcceptSnapshot(context))">Accept</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenPricingCalculator">New Calculation</MudButton>
</MudStack>

@code {
    [Parameter]
    public string OrderId { get; set; } = string.Empty;

    private List<PricingSnapshotDto> _snapshots = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(OrderId))
        {
            await LoadSnapshots();
        }
    }

    private async Task LoadSnapshots()
    {
        _loading = true;
        try
        {
            _snapshots = await Http.GetFromJsonAsync<List<PricingSnapshotDto>>($"api/pricing/snapshots?orderId={OrderId}") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading pricing history: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AcceptSnapshot(PricingSnapshotDto snapshot)
    {
        try
        {
            await Http.PatchAsync($"api/pricing/snapshots/{snapshot.Id}/accept", null);
            Snackbar.Add("Pricing snapshot accepted", Severity.Success);
            await LoadSnapshots();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error accepting snapshot: {ex.Message}", Severity.Error);
        }
    }

    private void OpenPricingCalculator()
    {
        // Navigate to Pricing Calculator or open dialog
        // For now, just show a message
        Snackbar.Add("Pricing Calculator integration coming soon", Severity.Info);
    }
}
