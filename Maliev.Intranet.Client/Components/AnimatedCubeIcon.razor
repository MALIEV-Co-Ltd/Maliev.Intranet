@namespace Maliev.Intranet.Client.Components

<span class="animated-cube-icon @Class"
      style="--cube-size:@(Size)px; cursor:pointer;"
      title="View in 3D"
      @onclick="OnClickHandler">
    <span class="cube-card">
        <div class="cube">
            <div></div>
        </div>
    </span>
</span>

<style>
    .animated-cube-icon {
        display: inline-flex;
        align-items: center;
        perspective: 600px;
    }

    .animated-cube-icon .cube-card {
        width: var(--cube-size);
        height: var(--cube-size);
        transform-style: preserve-3d;
    }

    .animated-cube-icon .cube {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transform-origin: center center;
        background: linear-gradient(135deg, #ffffff 0%, #e8e8e8 100%);
        border-radius: 3px;
        animation: cubeRotate 6s linear infinite;
    }

    .animated-cube-icon .cube::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #ffffff 0%, #d8d8d8 100%);
        border-radius: 3px;
        transform-origin: top center;
        transform: rotateX(90deg);
    }

    .animated-cube-icon .cube::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, #c8c8c8 0%, #b0b0b0 100%);
        border-radius: 3px;
        transform-origin: left center;
        transform: rotateY(-90deg);
    }

    .animated-cube-icon .cube > div {
        position: absolute;
        width: 100%;
        height: 100%;
        transform-origin: right center;
        transform: rotateY(90deg);
        background: linear-gradient(270deg, #b8b8b8 0%, #a0a0a0 100%);
        border-radius: 3px;
        transform-style: preserve-3d;
    }

    .animated-cube-icon .cube > div::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, #a8a8a8 0%, #909090 100%);
        border-radius: 3px;
        transform-origin: bottom center;
        transform: rotateX(-90deg);
    }

    .animated-cube-icon .cube > div::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #b0b0b0 0%, #888888 100%);
        border-radius: 3px;
        transform: rotateY(180deg);
    }

    .animated-cube-icon:hover .cube {
        animation-play-state: paused;
        transform: translate3d(0, -15%, 0);
    }

    @@keyframes cubeRotate {
        from { rotate: y 0deg; }
        to { rotate: y 360deg; }
    }
</style>

@code {
    /// <summary>
    /// Icon size in pixels (default: 22 to match button context).
    /// </summary>
    [Parameter] public int Size { get; set; } = 22;

    /// <summary>
    /// Additional CSS classes for the container span.
    /// </summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>
    /// Click event callback.
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private Task OnClickHandler()
    {
        if (OnClick.HasDelegate)
            return OnClick.InvokeAsync();
        return Task.CompletedTask;
    }
}
