@namespace Maliev.Intranet.Client.Components

<span class="animated-cube-icon @Class"
      style="--cube-size:@(Size)px; cursor:pointer;"
      @onclick="OnClickHandler">
    <span class="cube-card">
        <div class="cube">
            <div class="face face-front"></div>
            <div class="face face-back"></div>
            <div class="face face-right"></div>
            <div class="face face-left"></div>
            <div class="face face-top"></div>
            <div class="face face-bottom"></div>
        </div>
    </span>
</span>

<style>
    .animated-cube-icon {
        display: inline-flex;
        align-items: center;
        perspective: 600px;
    }

    .animated-cube-icon .cube-card {
        width: var(--cube-size);
        height: var(--cube-size);
        position: relative;
        perspective: 600px;
    }

    .animated-cube-icon .cube {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transform-origin: center center;
        opacity: 0;
        transition: opacity 0.3s ease, transform 0.4s ease;
    }

    .animated-cube-icon .face {
        position: absolute;
        width: var(--cube-size);
        height: var(--cube-size);
        backface-visibility: hidden;
    }

    .animated-cube-icon .face {
        background: transparent;
        border: 1.5px solid;
        box-sizing: border-box;
    }

    .animated-cube-icon .face-front {
        border-color: rgba(255, 255, 255, 0.9);
        transform: translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-back {
        border-color: rgba(150, 150, 150, 0.8);
        transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-right {
        border-color: rgba(180, 180, 180, 0.8);
        transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-left {
        border-color: rgba(180, 180, 180, 0.8);
        transform: rotateY(-90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-top {
        border-color: rgba(220, 220, 220, 0.9);
        transform: rotateX(90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-bottom {
        border-color: rgba(120, 120, 120, 0.8);
        transform: rotateX(-90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon:hover .cube {
        opacity: 1;
        animation: cubeRotate 6s linear infinite;
        transform: translate3d(0, -15%, 0);
    }

    @@keyframes cubeRotate {
        from { transform: rotateY(0deg); }
        to { transform: rotateY(360deg); }
    }
</style>

@code {
    /// <summary>
    /// Icon size in pixels (default: 80).
    /// </summary>
    [Parameter] public int Size { get; set; } = 80;

    /// <summary>
    /// Additional CSS classes for the container span.
    /// </summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>
    /// Click event callback.
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private Task OnClickHandler()
    {
        if (OnClick.HasDelegate)
            return OnClick.InvokeAsync();
        return Task.CompletedTask;
    }
}
