@namespace Maliev.Intranet.Client.Components

<span class="animated-cube-icon @Class"
      style="--cube-size:@(Size)px; cursor:pointer;"
      @onclick="OnClickHandler">
    <div class="cube">
        <div class="face front"></div>
        <div class="face back"></div>
        <div class="face right"></div>
        <div class="face left"></div>
        <div class="face top"></div>
        <div class="face bottom"></div>
    </div>
</span>

<style>
    .animated-cube-icon {
        display: inline-block;
        width: var(--cube-size);
        height: var(--cube-size);
        vertical-align: middle;
    }

    .animated-cube-icon .cube {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        /* Lowering the camera perspective down */
        transform: rotateX(-15deg) rotateY(45deg);
    }

    /* Hover starts the infinite rotation loop using a snappier springy cubic-bezier */
    .animated-cube-icon:hover .cube {
        animation: cubeRotate 2.5s infinite cubic-bezier(0.4, -0.4, 0.25, 1.3);
    }

    @@keyframes cubeRotate {
        from {
            transform: rotateX(-15deg) rotateY(45deg);
        }
        to {
            transform: rotateX(-15deg) rotateY(405deg);
        }
    }

    .animated-cube-icon .face {
        position: absolute;
        width: 100%;
        height: 100%;
        /* Transparent background lets you see through the cube */
        background-color: transparent;
        box-sizing: border-box;
        transform-style: preserve-3d;
        /* Anti-aliasing fix for some browsers */
        outline: 1px solid transparent; 
    }

    /* Front-facing solid edges */
    .animated-cube-icon .face::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border: 4px solid var(--mud-palette-dark-darken);
        box-sizing: border-box;
        /* Force hardware anti-aliasing on the border edges */
        box-shadow: 0 0 1px var(--mud-palette-dark-darken), inset 0 0 1px var(--mud-palette-dark-darken);
        /* Hides these edges when the face rotates to the back */
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    /* Back-facing (x-ray) lighter edges */
    .animated-cube-icon .face::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border: 2px solid var(--mud-palette-dark-lighten);
        box-sizing: border-box;
        /* Force hardware anti-aliasing on the faint border edges */
        box-shadow: 0 0 1px var(--mud-palette-dark-lighten), inset 0 0 1px var(--mud-palette-dark-lighten);
        /* These stay visible to create the x-ray skeleton */
        z-index: -1;
    }

    /* Pushing faces to edge of cube */
    .animated-cube-icon .front  { transform: rotateY(0deg) translateZ(calc(var(--cube-size) / 2)); }
    .animated-cube-icon .back   { transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2)); }
    .animated-cube-icon .right  { transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2)); }
    .animated-cube-icon .left   { transform: rotateY(-90deg) translateZ(calc(var(--cube-size) / 2)); }
    .animated-cube-icon .top    { transform: rotateX(90deg) translateZ(calc(var(--cube-size) / 2)); }
    .animated-cube-icon .bottom { transform: rotateX(-90deg) translateZ(calc(var(--cube-size) / 2)); }

    .pdc-cube-label {
        font-size: var(--mud-typography-button-size);
        font-weight: var(--mud-typography-button-weight);
        color: var(--mud-palette-primary-text);
        background: rgba(0, 0, 0, 0.55);
        padding: 8px 16px;
        border-radius: 16px;
        white-space: nowrap;
        pointer-events: none;
        margin-top: 16px;
    }
</style>

@code {
    /// <summary>
    /// Icon size in pixels (default: 80).
    /// </summary>
    [Parameter] public int Size { get; set; } = 80;

    /// <summary>
    /// Additional CSS classes for the container span.
    /// </summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>
    /// Click event callback.
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private Task OnClickHandler()
    {
        if (OnClick.HasDelegate)
            return OnClick.InvokeAsync();
        return Task.CompletedTask;
    }
}
