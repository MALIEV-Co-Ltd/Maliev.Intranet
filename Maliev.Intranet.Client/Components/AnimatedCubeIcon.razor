@namespace Maliev.Intranet.Client.Components

<span class="animated-cube-icon @Class"
      style="cursor:pointer; --cube-size:@(Size)px;"
      title="View in 3D"
      @onclick="OnClickHandler">
    <span class="cube-card">
        <span class="cube">
            <span class="face face-top"></span>
            <span class="face face-front"></span>
            <span class="face face-back"></span>
            <span class="face face-left"></span>
            <span class="face face-right"></span>
            <span class="face face-bottom"></span>
        </span>
    </span>
</span>

<style>
    .animated-cube-icon {
        display: inline-flex;
        align-items: center;
        perspective: 600px;
    }

    .animated-cube-icon .cube-card {
        width: var(--cube-size);
        height: var(--cube-size);
        perspective: 600px;
    }

    .animated-cube-icon .cube {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transform: rotateX(-30deg) rotateY(-45deg);
        transition: transform 0.4s ease-in-out;
    }

    .animated-cube-icon .face {
        position: absolute;
        width: var(--cube-size);
        height: var(--cube-size);
        border-radius: 3px;
        backface-visibility: hidden;
    }

    .animated-cube-icon .face-top {
        background: linear-gradient(135deg, #ffffff 0%, #e8e8e8 100%);
        transform: rotateX(90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-bottom {
        background: linear-gradient(135deg, #b0b0b0 0%, #909090 100%);
        transform: rotateX(-90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-front {
        background: linear-gradient(180deg, #d8d8d8 0%, #c0c0c0 100%);
        transform: translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-back {
        background: linear-gradient(180deg, #a0a0a0 0%, #888888 100%);
        transform: translateZ(calc(var(--cube-size) / -2));
    }

    .animated-cube-icon .face-left {
        background: linear-gradient(90deg, #c8c8c8 0%, #b0b0b0 100%);
        transform: rotateY(-90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon .face-right {
        background: linear-gradient(270deg, #b8b8b8 0%, #a0a0a0 100%);
        transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
    }

    .animated-cube-icon:hover .cube {
        transform: rotateX(-30deg) rotateY(-45deg) translate3d(0, calc(var(--cube-size) * -0.2), 0);
    }
</style>

@code {
    /// <summary>
    /// Icon size in pixels (default: 22 to match button context).
    /// </summary>
    [Parameter] public int Size { get; set; } = 22;

    /// <summary>
    /// Additional CSS classes for the container span.
    /// </summary>
    [Parameter] public string Class { get; set; } = "";

    /// <summary>
    /// Click event callback.
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private Task OnClickHandler()
    {
        if (OnClick.HasDelegate)
            return OnClick.InvokeAsync();
        return Task.CompletedTask;
    }
}
