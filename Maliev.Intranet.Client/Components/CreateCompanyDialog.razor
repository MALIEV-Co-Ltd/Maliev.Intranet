@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_request.Name" Label="Company Name" Variant="Variant.Outlined" Required="true" RequiredError="Company name is required" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_request.RegistrationNumber" Label="Registration Number" Variant="Variant.Outlined" Placeholder="0105XXXXXXXXX" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_request.VatNumber" Label="VAT / Tax ID" Variant="Variant.Outlined" Placeholder="0105XXXXXXXXX" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_request.Segment" Label="Industry Segment" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("Manufacturing")">Manufacturing</MudSelectItem>
                        <MudSelectItem Value="@("Automotive")">Automotive</MudSelectItem>
                        <MudSelectItem Value="@("Electronics")">Electronics</MudSelectItem>
                        <MudSelectItem Value="@("Medical")">Medical</MudSelectItem>
                        <MudSelectItem Value="@("Aerospace")">Aerospace</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_request.Tier" Label="Customer Tier" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("Tier1")">Tier 1 (Enterprise)</MudSelectItem>
                        <MudSelectItem Value="@("Tier2")">Tier 2 (Business)</MudSelectItem>
                        <MudSelectItem Value="@("Tier3")">Tier 3 (Standard)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_request.ContactEmail" Label="Company Email" Variant="Variant.Outlined" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_request.ContactPhone" Label="Company Phone" Variant="Variant.Outlined" Placeholder="+66 2 XXX XXXX" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_request.Address" Label="Company Address" Variant="Variant.Outlined" Lines="3" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_isSaving || !_isValid)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create Company
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;

    private CreateCompanyRequest _request = new();

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/companies", _request);
            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to create company: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class CreateCompanyRequest
    {
        public string Name { get; set; } = string.Empty;
        public string? RegistrationNumber { get; set; }
        public string? VatNumber { get; set; }
        public string? Segment { get; set; }
        public string? Tier { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
        public string? Address { get; set; }
    }
}
