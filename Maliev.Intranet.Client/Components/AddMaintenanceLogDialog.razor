@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="_request.Type"
                           Label="Maintenance Type"
                           Required="true"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Preventive")">Preventive</MudSelectItem>
                    <MudSelectItem Value="@("Corrective")">Corrective</MudSelectItem>
                    <MudSelectItem Value="@("Calibration")">Calibration</MudSelectItem>
                    <MudSelectItem Value="@("Inspection")">Inspection</MudSelectItem>
                    <MudSelectItem Value="@("Repair")">Repair</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_occurredAtNullable"
                               Label="Date Performed"
                               Required="true"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_request.Description"
                              Label="Description"
                              Required="true"
                              Variant="Variant.Outlined"
                              Lines="3"
                              HelperText="Describe the work performed." />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.VendorName"
                              Label="Vendor / Technician (optional)"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_request.CostTHB"
                                 Label="Cost (THB)"
                                 Variant="Variant.Outlined"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="THB" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_nextServiceNullable"
                               Label="Next Service Due (optional)"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="Submit"
                   Disabled="@(_isSaving || string.IsNullOrEmpty(_request.Type) || string.IsNullOrWhiteSpace(_request.Description))">
            @(_isSaving ? "Saving..." : "Log Maintenance")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the ID of the equipment to log maintenance for.</summary>
    [Parameter] public Guid EquipmentId { get; set; }

    private bool _isSaving;

    private readonly AddMaintenanceLogRequest _request = new()
    {
        Type = string.Empty,
        Description = string.Empty,
        OccurredAt = DateTime.UtcNow
    };

    private DateTime? _occurredAtNullable
    {
        get => _request.OccurredAt == default ? DateTime.Today : _request.OccurredAt;
        set => _request.OccurredAt = value ?? DateTime.UtcNow;
    }

    private DateTime? _nextServiceNullable
    {
        get => _request.NextServiceDueDate?.ToDateTime(TimeOnly.MinValue);
        set => _request.NextServiceDueDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(_request.Type) || string.IsNullOrWhiteSpace(_request.Description)) return;
        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/equipments/{EquipmentId}/maintenance", _request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Maintenance log added.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to log maintenance.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
