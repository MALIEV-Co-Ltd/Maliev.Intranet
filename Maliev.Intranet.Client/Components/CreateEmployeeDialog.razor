@using Maliev.Intranet.Shared
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_model.FirstName"
                                      Label="First Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="First Name is required" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField @bind-Value="_model.LastName"
                                      Label="Last Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Last Name is required" />
                    </MudItem>
                </MudGrid>

                <MudTextField @bind-Value="_model.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Email is required"
                              InputType="InputType.Email" />

                <MudSelect @bind-Value="_model.Department"
                           Label="Department"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Department is required">
                    <MudSelectItem Value="@("Engineering")">Engineering</MudSelectItem>
                    <MudSelectItem Value="@("Sales")">Sales</MudSelectItem>
                    <MudSelectItem Value="@("HR")">HR</MudSelectItem>
                    <MudSelectItem Value="@("Finance")">Finance</MudSelectItem>
                    <MudSelectItem Value="@("Marketing")">Marketing</MudSelectItem>
                    <MudSelectItem Value="@("Manufacturing")">Manufacturing</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_model.Title"
                              Label="Job Title"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Title is required" />

                <MudDatePicker Label="Start Date"
                               @bind-Date="_startDate"
                               Variant="Variant.Outlined"
                               Required="true" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <text>Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;
    private CreateEmployeeRequest _model = new();
    private DateTime? _startDate = DateTime.Today;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        if (_startDate.HasValue)
        {
            _model.StartDate = _startDate.Value;
        }

        _isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/employees", _model);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Employee created successfully", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to create employee", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
