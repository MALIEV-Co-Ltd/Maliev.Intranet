@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="px-6 pt-6">
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Style="font-weight: 800;">@(_isComplete ? "Onboarding Successful" : "Establishing Profile...")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="px-4 py-4">
            <MudStepper @ref="_stepper" Vertical NonLinear="false" ActiveIndex="_activeIndex" Class="mud-width-full">
                <ChildContent>
                    @if (HasCompany)
                    {
                        <MudStep Title="Company Identity Setup">
                            <ChildContent>
                                <MudStack Spacing="2">
                                    <div class="d-flex align-center gap-3">
                                        @if (_currentStep == Step.Company) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                                        <MudText Typo="Typo.body2">Checking for existing company records and establishing a unique identity in our registry. This ensures data consistency across all services.</MudText>
                                    </div>
                                    @if (_stepErrors.ContainsKey(Step.Company)) { <MudText Typo="Typo.caption" Color="Color.Error">@_stepErrors[Step.Company]</MudText> }
                                </MudStack>
                            </ChildContent>
                        </MudStep>
                    }
                    
                    <MudStep Title="Customer Profile Creation">
                        <ChildContent>
                            <MudStack Spacing="2">
                                <div class="d-flex align-center gap-3">
                                    @if (_currentStep == Step.Customer) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                                    <MudText Typo="Typo.body2">Creating the primary customer profile, including contact information and system preferences. This profile serves as the hub for all future interactions.</MudText>
                                </div>
                                @if (_stepErrors.ContainsKey(Step.Customer)) { <MudText Typo="Typo.caption" Color="Color.Error">@_stepErrors[Step.Customer]</MudText> }
                            </MudStack>
                        </ChildContent>
                    </MudStep>

                    @if (Request.Addresses.Any())
                    {
                        <MudStep Title="@($"Registering Addresses ({Request.Addresses.Count})")">
                            <ChildContent>
                                <MudStack Spacing="2">
                                    <div class="d-flex align-center gap-3">
                                        @if (_currentStep == Step.Addresses) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                                        <MudText Typo="Typo.body2">Adding physical locations to the customer profile. These will be used for billing, shipping, and service delivery coordination.</MudText>
                                    </div>
                                    @if (_stepErrors.ContainsKey(Step.Addresses)) { <MudText Typo="Typo.caption" Color="Color.Error">@_stepErrors[Step.Addresses]</MudText> }
                                </MudStack>
                            </ChildContent>
                        </MudStep>
                    }

                    @if (Request.Documents.Any())
                    {
                        <MudStep Title="@($"Linking Documents ({Request.Documents.Count})")">
                            <ChildContent>
                                <MudStack Spacing="2">
                                    <div class="d-flex align-center gap-3">
                                        @if (_currentStep == Step.Documents) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                                        <MudText Typo="Typo.body2">Processing and attaching uploaded files to the customer record. This includes ID copies, business certificates, and other required documentation.</MudText>
                                    </div>
                                    @if (_stepErrors.ContainsKey(Step.Documents)) { <MudText Typo="Typo.caption" Color="Color.Error">@_stepErrors[Step.Documents]</MudText> }
                                </MudStack>
                            </ChildContent>
                        </MudStep>
                    }

                    @if (IncludeNda)
                    {
                        <MudStep Title="NDA Lifecycle Initialization">
                            <ChildContent>
                                <MudStack Spacing="2">
                                    <div class="d-flex align-center gap-3">
                                        @if (_currentStep == Step.Nda) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                                        <MudText Typo="Typo.body2">Setting up the Non-Disclosure Agreement tracking. This ensures legal compliance and sets the baseline for secure business communications.</MudText>
                                    </div>
                                    @if (_stepErrors.ContainsKey(Step.Nda)) { <MudText Typo="Typo.caption" Color="Color.Error">@_stepErrors[Step.Nda]</MudText> }
                                </MudStack>
                            </ChildContent>
                        </MudStep>
                    }
                </ChildContent>
                <ActionContent>
                    @* Hidden navigation buttons *@
                </ActionContent>
                <CompletedContent>
                    @if (!_hasFailed)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="py-4">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Onboarding Completed</MudText>
                            <MudText Typo="Typo.body2">The customer profile has been successfully established and configured.</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4 rounded-xl shadow-none">
                            Establishing the profile was interrupted. Please review the errors above.
                        </MudAlert>
                    }
                </CompletedContent>
            </MudStepper>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-10 pb-10 d-flex w-100 justify-end gap-3">
            @if (_isComplete && !_hasFailed)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           OnClick="ViewCustomer" 
                           Class="px-12 py-3 rounded-lg shadow-none"
                           Style="font-weight: 700;">PROCEED TO PROFILE</MudButton>
            }
            else if (_hasFailed)
            {
                <MudButton Variant="Variant.Text" OnClick="Close" Class="rounded-lg mr-2">CLOSE</MudButton>
                @if (_customerId.HasValue)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ViewCustomer" Class="px-10 py-3 rounded-lg shadow-none">VIEW PARTIAL PROFILE</MudButton>
                }
            }
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CustomerOnboardingRequest Request { get; set; } = new();
    [Parameter] public bool HasCompany { get; set; }
    [Parameter] public bool IncludeNda { get; set; }

    private MudStepper _stepper = null!;
    private int _activeIndex = 0;
    private enum Step { Company, Customer, Addresses, Documents, Nda }
    private enum StepState { Pending, InProgress, Completed, Failed, Skipped }

    private Step? _currentStep;
    private Dictionary<Step, StepState> _stepStates = new();
    private Dictionary<Step, string> _stepErrors = new();
    private Guid? _customerId;
    private bool _isComplete;
    private bool _hasFailed;
    private List<DocumentResponse> _createdDocuments = new();

    protected override async Task OnInitializedAsync()
    {
        if (HasCompany) _stepStates[Step.Company] = StepState.Pending;
        _stepStates[Step.Customer] = StepState.Pending;
        if (Request.Addresses.Any()) _stepStates[Step.Addresses] = StepState.Pending;
        if (Request.Documents.Any()) _stepStates[Step.Documents] = StepState.Pending;
        if (IncludeNda) _stepStates[Step.Nda] = StepState.Pending;

        await RunOnboarding();
    }

    private async Task RunOnboarding()
    {
        try
        {
            if (HasCompany) 
            {
                await SetStep(Step.Company, StepState.InProgress);
            }
            else
            {
                await SetStep(Step.Customer, StepState.InProgress);
            }

            var response = await Http.PostAsJsonAsync("api/customers/create-basic", Request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await ReadError(response);
                var failStep = HasCompany ? Step.Company : Step.Customer;
                await SetStep(failStep, StepState.Failed, error);
                _hasFailed = true; _isComplete = true; 
                _activeIndex = GetTotalSteps();
                return;
            }

            var customer = await response.Content.ReadFromJsonAsync<CustomerResponse>();
            _customerId = customer?.Id;
            
            if (HasCompany) 
            {
                await SetStep(Step.Company, StepState.Completed);
                await Task.Delay(500);
                await SetStep(Step.Customer, StepState.InProgress);
                await Task.Delay(800);
            }
            await SetStep(Step.Customer, StepState.Completed);

            if (_customerId == null) { _hasFailed = true; _isComplete = true; _activeIndex = GetTotalSteps(); return; }

            if (Request.Addresses.Any())
            {
                await SetStep(Step.Addresses, StepState.InProgress);
                var addrResponse = await Http.PostAsJsonAsync($"api/customers/{_customerId}/addresses", Request.Addresses);
                if (!addrResponse.IsSuccessStatusCode)
                {
                    var error = await ReadError(addrResponse);
                    await SetStep(Step.Addresses, StepState.Failed, error);
                    _hasFailed = true; _isComplete = true; _activeIndex = GetTotalSteps(); return;
                }
                await SetStep(Step.Addresses, StepState.Completed);
            }

            if (Request.Documents.Any())
            {
                await SetStep(Step.Documents, StepState.InProgress);
                var docResponse = await Http.PostAsJsonAsync($"api/aiprocessing/link-documents?ownerType=Customer&ownerId={_customerId}", Request.Documents);
                if (docResponse.IsSuccessStatusCode)
                {
                    _createdDocuments = await docResponse.Content.ReadFromJsonAsync<List<DocumentResponse>>() ?? [];
                    await SetStep(Step.Documents, StepState.Completed);
                }
                else
                {
                    var error = await ReadError(docResponse);
                    await SetStep(Step.Documents, StepState.Failed, error);
                }
            }

            if (IncludeNda && Request.Nda != null)
            {
                await SetStep(Step.Nda, StepState.InProgress);
                var ndaRequest = new CreateNdaStepRequest { Nda = Request.Nda, Documents = _createdDocuments };
                var ndaResponse = await Http.PostAsJsonAsync($"api/customers/{_customerId}/nda", ndaRequest);
                if (!ndaResponse.IsSuccessStatusCode)
                {
                    var error = await ReadError(ndaResponse);
                    await SetStep(Step.Nda, StepState.Failed, error);
                }
                else await SetStep(Step.Nda, StepState.Completed);
            }

            _activeIndex = GetTotalSteps();
            _isComplete = true;
            if (!_hasFailed) { await Task.Delay(2000); ViewCustomer(); }
        }
        catch (Exception ex)
        {
            if (_currentStep.HasValue) await SetStep(_currentStep.Value, StepState.Failed, ex.Message);
            _hasFailed = true; _isComplete = true;
            _activeIndex = GetTotalSteps();
        }
    }

    private async Task SetStep(Step step, StepState state, string? error = null)
    {
        _stepStates[step] = state;
        if (state == StepState.InProgress) 
        {
            _currentStep = step;
            _activeIndex = GetStepIndex(step);
        }
        if (error != null) _stepErrors[step] = error;
        if (state is StepState.Completed or StepState.Failed) _currentStep = null;
        await InvokeAsync(StateHasChanged);
    }

    private int GetStepIndex(Step step)
    {
        int index = 0;
        if (HasCompany) { if (step == Step.Company) return index; index++; }
        if (step == Step.Customer) return index; index++;
        if (Request.Addresses.Any()) { if (step == Step.Addresses) return index; index++; }
        if (Request.Documents.Any()) { if (step == Step.Documents) return index; index++; }
        if (IncludeNda) { if (step == Step.Nda) return index; index++; }
        return index;
    }

    private int GetTotalSteps()
    {
        int count = 0;
        if (HasCompany) count++;
        count++;
        if (Request.Addresses.Any()) count++;
        if (Request.Documents.Any()) count++;
        if (IncludeNda) count++;
        return count;
    }

    private static async Task<string> ReadError(HttpResponseMessage response)
    {
        try
        {
            var apiErr = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            if (apiErr?.Message != null) return apiErr.Message;
        }
        catch
        {
            try { var raw = await response.Content.ReadAsStringAsync(); if (raw.Length < 200) return raw; } catch { }
        }
        return $"Request failed with status {(int)response.StatusCode}";
    }

    private void ViewCustomer() => MudDialog.Close(DialogResult.Ok(_customerId));
    private void Close() => MudDialog.Close(DialogResult.Cancel());
}
