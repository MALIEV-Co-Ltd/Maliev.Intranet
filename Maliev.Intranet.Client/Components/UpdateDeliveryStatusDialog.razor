@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudSelect @bind-Value="_status"
                           Label="Status"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                    <MudSelectItem Value="@("InTransit")">In Transit</MudSelectItem>
                    <MudSelectItem Value="@("Delivered")">Delivered</MudSelectItem>
                    <MudSelectItem Value="@("PartiallyDelivered")">Partially Delivered</MudSelectItem>
                    <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                </MudSelect>

                @if (_status == "Delivered" || _status == "PartiallyDelivered")
                {
                    <MudTextField @bind-Value="_receivedBy"
                                  Label="Received By"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Receiver name is required for delivery" />
                                  
                    <MudDatePicker Label="Received At"
                                   @bind-Date="_receivedAtDate"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                                   
                    <MudTimePicker Label="Time"
                                   @bind-Time="_receivedAtTime"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                }

                <MudTextField @bind-Value="_notes"
                              Label="Notes"
                              Variant="Variant.Outlined"
                              Lines="3" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Updating...</MudText>
            }
            else
            {
                <text>Update</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Guid DeliveryNoteId { get; set; }
    [Parameter] public string CurrentStatus { get; set; } = string.Empty;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;

    private string _status = "Pending";
    private string? _receivedBy;
    private DateTime? _receivedAtDate = DateTime.Today;
    private TimeSpan? _receivedAtTime = DateTime.Now.TimeOfDay;
    private string? _notes;

    protected override void OnInitialized()
    {
        _status = CurrentStatus;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isSubmitting = true;
        try
        {
            DateTime? receivedAt = null;
            if (_receivedAtDate.HasValue && _receivedAtTime.HasValue)
            {
                receivedAt = _receivedAtDate.Value.Add(_receivedAtTime.Value);
            }

            var request = new UpdateDeliveryStatusRequest
            {
                Status = _status,
                ReceivedBy = _receivedBy,
                ReceivedAt = receivedAt,
                Notes = _notes
            };

            var response = await Http.PatchAsJsonAsync($"api/deliverynotes/{DeliveryNoteId}/status", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Status updated successfully", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update status", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
