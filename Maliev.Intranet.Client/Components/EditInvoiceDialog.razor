@using Maliev.Intranet.Shared
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudDatePicker Label="Due Date"
                               @bind-Date="_dueDate"
                               Required="true"
                               Variant="Variant.Outlined" />

                <MudTextField Label="Notes"
                              @bind-Value="_notes"
                              Lines="3"
                              Variant="Variant.Outlined" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_isValid || _isSaving)"
                   OnClick="Submit">
            @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save Changes
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid InvoiceId { get; set; }

    [Parameter]
    public InvoiceDetailDto? Invoice { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private DateTime? _dueDate;
    private string? _notes;

    protected override void OnParametersSet()
    {
        if (Invoice != null)
        {
            _dueDate = Invoice.DueDate;
            _notes = Invoice.Notes;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isSaving = true;
        try
        {
            var request = new UpdateInvoiceRequest
            {
                DueDate = _dueDate,
                Notes = _notes
            };
            var response = await Http.PutAsJsonAsync($"api/invoices/{InvoiceId}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Invoice updated successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to update invoice.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
