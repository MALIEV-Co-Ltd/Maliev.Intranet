@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_request.Content"
                      Label="Note"
                      Required="true"
                      Variant="Variant.Outlined"
                      Lines="4"
                      HelperText="Notes are permanent and cannot be edited or deleted." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(_isSaving || string.IsNullOrWhiteSpace(_request.Content))">
            @(_isSaving ? "Saving..." : "Add Note")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the ID of the equipment to attach the note to.</summary>
    [Parameter] public Guid EquipmentId { get; set; }

    private bool _isSaving;

    private readonly AddEquipmentNoteRequest _request = new()
    {
        Content = string.Empty
    };

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_request.Content)) return;
        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/equipments/{EquipmentId}/notes", _request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Note added.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to add note.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
