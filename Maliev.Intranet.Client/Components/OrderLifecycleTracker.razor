@using Maliev.Intranet.Shared.Dtos
@inject NavigationManager Navigation

@* ── Compact mode (horizontal icon strip, for embedding in lists) ── *@
@if (Compact)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="lifecycle-compact">
        @foreach (var stage in _stages)
        {
            <MudTooltip Text="@stage.Label" Placement="Placement.Top">
                <MudIconButton Icon="@stage.Icon"
                               Size="Size.Small"
                               Color="@GetStageColor(stage.Status)"
                               Class="@($"lifecycle-icon {stage.Status.ToLowerInvariant()}")"
                               OnClick="@(() => NavigateToStage(stage))"
                               Disabled="@(stage.NavigateTo == null)" />
            </MudTooltip>
            @if (stage != _stages[^1])
            {
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Default" Style="opacity:.3;" />
            }
        }
    </MudStack>
}
else
{
    @* ── Expanded mode (full horizontal stepper with detail panel) ── *@
    <MudPaper Elevation="0" Class="pa-4 rounded-lg lifecycle-tracker"
              Style="border: 1px solid var(--mud-palette-lines-default);">

        @* Stage strip *@
        <div class="lifecycle-stages">
            @for (int i = 0; i < _stages.Count; i++)
            {
                var stage = _stages[i];
                var isLast = i == _stages.Count - 1;

                <div class="lifecycle-stage @(stage.Status.ToLowerInvariant()) @(_selected == stage ? "active" : "")"
                     @onclick="@(() => ToggleDetail(stage))">
                    <div class="stage-icon-wrap">
                        <div class="stage-pulse-ring @(stage.Status == "Current" ? "pulse" : "")"></div>
                        <MudIcon Icon="@stage.Icon"
                                 Size="Size.Small"
                                 Color="@GetStageColor(stage.Status)"
                                 Class="stage-icon" />
                    </div>
                    <MudText Typo="Typo.caption"
                             Class="stage-label"
                             Color="@(stage.Status == "Pending" ? Color.Default : Color.Default)">
                        @stage.Label
                    </MudText>
                    @if (stage.CompletedAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="stage-date">
                            @stage.CompletedAt.Value.ToString("dd MMM")
                        </MudText>
                    }
                </div>

                @if (!isLast)
                {
                    <div class="lifecycle-connector @(stage.Status == "Completed" ? "done" : "")"></div>
                }
            }
        </div>

        @* Detail panel (shown on click) *@
        @if (_selected != null)
        {
            <MudPaper Elevation="0" Class="lifecycle-detail pa-3 mt-3 rounded"
                      Style="background: var(--mud-palette-background-grey);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@_selected.Icon" Color="@GetStageColor(_selected.Status)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@_selected.Label</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetStageColor(_selected.Status)">@_selected.Status</MudChip>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                   OnClick="@(() => _selected = null)" />
                </MudStack>

                @if (!string.IsNullOrEmpty(_selected.EntityReference))
                {
                    <MudText Typo="Typo.body2" Class="mt-1">
                        Ref: <strong>@_selected.EntityReference</strong>
                    </MudText>
                }
                @if (_selected.CompletedAt.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @(_selected.Status == "Completed" ? "Completed" : "Updated"):
                        @_selected.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                    </MudText>
                }
                @if (!string.IsNullOrEmpty(_selected.Note))
                {
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-1">@_selected.Note</MudText>
                }
                @if (!string.IsNullOrEmpty(_selected.NavigateTo))
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               EndIcon="@Icons.Material.Outlined.OpenInNew"
                               Class="mt-2"
                               OnClick="@(() => NavigateToStage(_selected))">
                        View @_selected.Label
                    </MudButton>
                }
            </MudPaper>
        }
    </MudPaper>
}


@code {
    /// <summary>Gets or sets the lifecycle DTO to visualize. When null a loading skeleton is shown.</summary>
    [Parameter] public OrderLifecycleDto? Lifecycle { get; set; }

    /// <summary>Gets or sets whether to render in compact (icon-strip) mode.</summary>
    [Parameter] public bool Compact { get; set; }

    private List<OrderLifecycleStageDto> _stages = new();
    private OrderLifecycleStageDto? _selected;

    protected override void OnParametersSet()
    {
        _stages = Lifecycle?.Stages ?? new();
        _selected = null;
    }

    private void ToggleDetail(OrderLifecycleStageDto stage) =>
        _selected = _selected == stage ? null : stage;

    private void NavigateToStage(OrderLifecycleStageDto stage)
    {
        if (!string.IsNullOrEmpty(stage.NavigateTo))
            Navigation.NavigateTo(stage.NavigateTo);
    }

    private static Color GetStageColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Current"   => Color.Primary,
        "Failed"    => Color.Error,
        _           => Color.Default
    };
}
