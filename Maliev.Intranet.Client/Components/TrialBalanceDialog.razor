@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-4 text-center">@Report.ReportName</MudText>
        @foreach (var section in Report.Sections)
        {
            <div class="mb-4">
                <MudText Typo="Typo.subtitle2" Style="font-weight:700; text-transform:uppercase;">@(section.Title)</MudText>
                <MudDivider Class="my-1" />
                @foreach (var row in section.Rows)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudText Typo="Typo.body2">@(row.Label)</MudText>
                        <MudText Typo="Typo.body2">@(row.Amount.ToString("N2"))</MudText>
                    </MudStack>
                }
                <MudDivider Class="mt-1" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Style="font-weight:600;">Total @(section.Title)</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@(section.Total.ToString("N2"))</MudText>
                </MudStack>
            </div>
        }
        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-4">Generated: @Report.GeneratedAt.ToString("f")</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public FinancialReportDto Report { get; set; } = null!;
}
