@using MudBlazor
@using Maliev.Intranet.Shared

@if (Steps.Count > 0)
{
    <MudPaper Elevation="0" Class="rounded-lg mb-2 ml-12 thinking-chain" Style="border: 1px solid var(--mud-palette-divider); overflow: hidden;">
        <div class="d-flex align-center pa-2 cursor-pointer" @onclick="ToggleExpanded"
             style="background-color: var(--mud-palette-background-grey); user-select: none;">
            <MudIcon Icon="@(IsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Color="Color.Secondary" Class="mr-2" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 500;">
                @GetSummaryText()
            </MudText>
            @if (IsProcessing)
            {
                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" Class="ml-2"
                                     Style="width: 14px; height: 14px;" />
            }
        </div>

        @if (IsExpanded)
        {
            <div class="pa-2" style="max-height: 300px; overflow-y: auto;">
                @foreach (var step in Steps)
                {
                    <div class="d-flex align-start mb-1">
                        <MudIcon Icon="@GetStepIcon(step.Type)" Size="Size.Small"
                                 Color="@GetStepColor(step.Type)" Class="mr-2 mt-1" Style="flex-shrink: 0;" />
                        <div style="min-width: 0;">
                            <MudText Typo="Typo.caption" Style="font-weight: 500; line-height: 1.3;">
                                @step.Title
                                @if (step.DurationMs.HasValue)
                                {
                                    <span style="color: var(--mud-palette-text-secondary); font-weight: 400;">
                                        (@(step.DurationMs)ms)
                                    </span>
                                }
                            </MudText>
                            @if (!string.IsNullOrEmpty(step.Detail) && step.Type == "function_result")
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="font-size: 0.7rem; line-height: 1.2; white-space: pre-wrap; word-break: break-all; max-height: 60px; overflow: hidden;">
                                    @TruncateDetail(step.Detail)
                                </MudText>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

<style>
    .thinking-chain {
        transition: all 0.2s ease;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .cursor-pointer:hover {
        opacity: 0.85;
    }
</style>

@code {
    [Parameter] public List<ThinkingStepDto> Steps { get; set; } = new();
    [Parameter] public bool IsProcessing { get; set; }

    private bool IsExpanded { get; set; } = true;
    private bool? _lastIsProcessing;

    protected override void OnParametersSet()
    {
        // Auto-collapse when processing completes, or auto-expand when it starts
        if (_lastIsProcessing != IsProcessing)
        {
            if (!IsProcessing && Steps.Count > 0)
            {
                IsExpanded = false;
            }
            else if (IsProcessing)
            {
                IsExpanded = true;
            }
            _lastIsProcessing = IsProcessing;
        }
    }

    private void ToggleExpanded() => IsExpanded = !IsExpanded;

    private string GetSummaryText()
    {
        var toolCalls = Steps.Count(s => s.Type == "function_call");
        if (IsProcessing)
        {
            var lastStep = Steps.LastOrDefault();
            return lastStep?.Title ?? "Thinking...";
        }
        return toolCalls > 0
            ? $"Searched {toolCalls} source{(toolCalls != 1 ? "s" : "")}"
            : $"{Steps.Count} step{(Steps.Count != 1 ? "s" : "")}";
    }

    private static string GetStepIcon(string type) => type switch
    {
        "function_call" => Icons.Material.Filled.Search,
        "function_result" => Icons.Material.Filled.CheckCircleOutline,
        "reasoning" => Icons.Material.Filled.Lightbulb,
        _ => Icons.Material.Filled.Circle
    };

    private static Color GetStepColor(string type) => type switch
    {
        "function_call" => Color.Info,
        "function_result" => Color.Success,
        "reasoning" => Color.Warning,
        _ => Color.Default
    };

    private static string TruncateDetail(string detail)
    {
        return detail.Length > 200 ? detail[..200] + "..." : detail;
    }
}
