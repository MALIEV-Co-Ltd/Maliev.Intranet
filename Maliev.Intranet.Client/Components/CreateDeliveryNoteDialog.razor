@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <!-- Order Selection -->
                <MudAutocomplete T="OrderSummaryDto"
                                 Value="_selectedOrder"
                                 Label="Order"
                                 Required="true"
                                 RequiredError="Order is required"
                                 SearchFunc="SearchOrders"
                                 DebounceInterval="300"
                                 ToStringFunc="@(o => o != null ? $"{o.OrderNumber} - {o.CustomerName}" : string.Empty)"
                                 ValueChanged="OnOrderChanged"
                                 Variant="Variant.Outlined">
                    <ItemTemplate Context="order">
                        <MudStack Row="false" Spacing="0">
                            <MudText Typo="Typo.body1">@order.OrderNumber</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">@order.CustomerName</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_selectedOrder != null && _orderDetail != null)
                {
                    <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle2">Order Details</MudText>
                        <MudGrid>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Ordered Quantity</MudText>
                                <MudText>@_orderDetail.OrderedQuantity</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Manufactured</MudText>
                                <MudText>@_orderDetail.ManufacturedQuantity</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Delivery Details -->
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudDatePicker Label="Delivery Date"
                                           @bind-Date="_deliveryDate"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_trackingNumber"
                                          Label="Tracking Number"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_carrierName"
                                          Label="Carrier Name"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_deliveryContact"
                                          Label="Delivery Contact"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_deliveryPhone"
                                          Label="Delivery Phone"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                    <!-- Items -->
                    <MudText Typo="Typo.h6" Class="mt-4">Items to Deliver</MudText>
                    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg pa-3">
                         @foreach (var item in _itemsToDeliver)
                         {
                             <MudGrid>
                                 <MudItem xs="8">
                                     <MudText>@_orderDetail.OrderId (Main Item)</MudText>
                                 </MudItem>
                                 <MudItem xs="4">
                                     <MudNumericField @bind-Value="item.Quantity"
                                                      Label="Quantity"
                                                      Variant="Variant.Outlined"
                                                      Min="1"
                                                      Max="@(_orderDetail.ManufacturedQuantity ?? _orderDetail.OrderedQuantity ?? int.MaxValue)"
                                                      Required="true" />
                                 </MudItem>
                             </MudGrid>
                         }
                    </MudPaper>

                    <MudTextField @bind-Value="_notes"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Class="mt-3" />
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSubmitting || _selectedOrder == null)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <text>Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;

    private OrderSummaryDto? _selectedOrder;
    private OrderDetailDto? _orderDetail;
    
    private DateTime? _deliveryDate = DateTime.Today;
    private string? _trackingNumber;
    private string? _carrierName;
    private string? _deliveryContact;
    private string? _deliveryPhone;
    private string? _notes;

    private List<CreateDeliveryNoteItemRequest> _itemsToDeliver = new();

    private async Task<IEnumerable<OrderSummaryDto>> SearchOrders(string value, CancellationToken cancellationToken)
    {
        // TODO: Implement search in OrdersController/Client. For now fetching paged.
        // Or if API supports search param, use it.
        // Assuming GetOrdersAsync(page: 1) returns recent orders.
        // In real app, we need a search endpoint.
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>($"api/orders?page=1", cancellationToken);
            var items = response?.Data ?? Enumerable.Empty<OrderSummaryDto>();
            
            if (!string.IsNullOrWhiteSpace(value))
            {
                items = items.Where(o => o.OrderNumber.Contains(value, StringComparison.OrdinalIgnoreCase) || 
                                         o.CustomerName.Contains(value, StringComparison.OrdinalIgnoreCase));
            }
            return items;
        }
        catch
        {
            return Array.Empty<OrderSummaryDto>();
        }
    }

    private async Task OnOrderChanged(OrderSummaryDto? order)
    {
        _selectedOrder = order;
        _orderDetail = null;
        _itemsToDeliver.Clear();

        if (order == null) return;

        try
        {
            // Use Guid Id if OrderSummary has it. 
            // Note: OrderSummaryDto has Guid Id. OrderDetailDto has Guid Id.
            // Maliev.OrderService uses string ID, but mapped to Guid in DTO? 
            // My DTO update added Guid Id to OrderDetailDto.
            // Assuming OrderSummaryDto.Id is valid.
            // But controller GetById takes string id.
            // I should use order.Id.ToString() or order.OrderNumber if ID is Guid.
            // Wait, OrderSummaryDto.Id is Guid.
            // I'll assume standard Guid usage.
            _orderDetail = await Http.GetFromJsonAsync<OrderDetailDto>($"api/orders/{order.Id}");
            
            if (_orderDetail != null)
            {
                // Add single item for the order
                _itemsToDeliver.Add(new CreateDeliveryNoteItemRequest
                {
                    OrderItemId = _orderDetail.Id, // Assuming OrderId = ItemId for 1-to-1
                    Quantity = _orderDetail.OrderedQuantity ?? 1
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load order details: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid || _selectedOrder == null) return;

        _isSubmitting = true;
        try
        {
            var request = new CreateDeliveryNoteRequest
            {
                OrderId = _selectedOrder.Id,
                DeliveryDate = _deliveryDate ?? DateTime.Today,
                TrackingNumber = _trackingNumber,
                CarrierName = _carrierName,
                DeliveryContact = _deliveryContact,
                DeliveryPhone = _deliveryPhone,
                Notes = _notes,
                Items = _itemsToDeliver
            };

            var response = await Http.PostAsJsonAsync("api/deliverynotes", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Delivery Note created", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to create delivery note", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
