@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Note" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Internal Notes</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="pa-4" Style="max-height: 600px; overflow-y: auto;">
            <MudStack Spacing="4">
                @if (Notes?.Any() == true)
                {
                    @foreach (var note in Notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <MudPaper Elevation="0" Class="pa-4 rounded-lg border-solid border-1 mud-border-lines-default" Style="background-color: var(--mud-palette-background-grey);">
                            @if (_editingNoteId == note.Id)
                            {
                                <MudPaper Outlined="true" Class="mt-2">
                                    <MudToolBar Dense="true" Class="px-2 border-b">
                                        <MudTooltip Text="Bold">
                                            <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" OnClick='() => WrapEditSelection("**", "**")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Italic">
                                            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" Size="Size.Small" OnClick='() => WrapEditSelection("_", "_")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Heading">
                                            <MudIconButton Icon="@Icons.Material.Filled.Title" Size="Size.Small" OnClick='() => PrefixEditLine("# ")' />
                                        </MudTooltip>
                                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                                        <MudTooltip Text="Unordered List">
                                            <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" OnClick='() => PrefixEditLine("- ")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Ordered List">
                                            <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" OnClick='() => PrefixEditLine("1. ")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Check List">
                                            <MudIconButton Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small" OnClick='() => PrefixEditLine("- [ ] ")' />
                                        </MudTooltip>
                                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                                        <MudTooltip Text="Blockquote">
                                            <MudIconButton Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" OnClick='() => PrefixEditLine("> ")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Code">
                                            <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small" OnClick='() => WrapEditSelection("`", "`")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Table">
                                            <MudIconButton Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" OnClick="InsertEditTable" />
                                        </MudTooltip>
                                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                                        <MudTooltip Text="Link">
                                            <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" OnClick='() => WrapEditSelection("[", "](url)")' />
                                        </MudTooltip>
                                        <MudTooltip Text="Image">
                                            <MudIconButton Icon="@Icons.Material.Filled.Image" Size="Size.Small" OnClick='() => WrapEditSelection("![alt text](", ")")' />
                                        </MudTooltip>
                                    </MudToolBar>
                                    <MudTabs Elevation="0" Outlined="false" Color="Color.Primary" Rounded="true" PanelClass="pa-0">
                                        <MudTabPanel Text="Edit" Icon="@Icons.Material.Filled.Edit">
                                            <MudTextField T="string" @bind-Value="_editText" Label="Note Content (Markdown supported)" Lines="6" AutoGrow="false" Variant="Variant.Text" Immediate="true" Counter="5000" MaxLength="5000" Style="font-family: monospace; padding: 12px; border: none;" />
                                        </MudTabPanel>
                                        <MudTabPanel Text="Preview" Icon="@Icons.Material.Filled.Visibility">
                                            <MudPaper Outlined="false" Class="pa-4 mud-bg-surface-light" Style="min-height: 150px; max-height: 400px; overflow-y: auto;">
                                                <MarkdownRenderer Markdown="@_editText" />
                                            </MudPaper>
                                        </MudTabPanel>
                                    </MudTabs>
                                </MudPaper>
                                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                                    <MudButton Size="Size.Small" OnClick="CancelEdit">Cancel</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => SaveEdit(note)" Disabled="@(string.IsNullOrWhiteSpace(_editText))">Save</MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <div class="d-flex justify-space-between align-start">
                                    <div class="flex-grow-1 mr-4">
                                        <MarkdownRenderer Markdown="@note.NoteText" />
                                    </div>
                                    <MudStack Row="true" Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => StartEdit(note)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteNote(note)" />
                                    </MudStack>
                                </div>
                                <MudDivider Class="my-2" />
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Added by @(!string.IsNullOrEmpty(note.CreatedByName) ? $"{note.CreatedByName} ({note.CreatedByEmail})" : note.CreatedBy)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@note.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                </MudStack>
                            }
                        </MudPaper>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info">No notes found for this customer.</MudAlert>
                }
            </MudStack>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<InternalNoteResponse> Notes { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }

    private Guid? _editingNoteId;
    private string _editText = string.Empty;

    private void StartEdit(InternalNoteResponse note)
    {
        _editingNoteId = note.Id;
        _editText = note.NoteText;
    }

    private void CancelEdit()
    {
        _editingNoteId = null;
        _editText = string.Empty;
    }

    private async Task SaveEdit(InternalNoteResponse note)
    {
        if (string.IsNullOrWhiteSpace(_editText)) return;

        try
        {
            var request = new UpdateInternalNoteRequest
            {
                NoteText = _editText,
                Version = note.Version
            };

            var response = await Http.PatchAsJsonAsync($"api/customers/notes/{note.Id}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Note updated successfully", Severity.Success);
                note.NoteText = _editText; // Optimistic update
                _editingNoteId = null;
                await OnChanged.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Failed to update note", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteNote(InternalNoteResponse note)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/customers/notes/{note.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Note deleted successfully", Severity.Success);
                Notes.Remove(note);
                await OnChanged.InvokeAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete note", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close();

    private void WrapEditSelection(string prefix, string suffix)
    {
        _editText += prefix + "text" + suffix;
        StateHasChanged();
    }

    private void PrefixEditLine(string prefix)
    {
        if (string.IsNullOrEmpty(_editText) || _editText.EndsWith("\n"))
            _editText += prefix;
        else
            _editText += "\n" + prefix;
        StateHasChanged();
    }

    private void InsertEditTable()
    {
        var table = "\n| Column 1 | Column 2 |\n| -------- | -------- |\n| Item 1   | Item 2   |\n";
        _editText += table;
        StateHasChanged();
    }
}
