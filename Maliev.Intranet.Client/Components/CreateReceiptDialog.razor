@using Maliev.Intranet.Shared
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <MudAlert Severity="Severity.Info">
                    Receipts are issued for paid or partially paid invoices.
                </MudAlert>

                <!-- Invoice Selection -->
                <MudAutocomplete T="InvoiceDto"
                                 Value="_selectedInvoice"
                                 Label="Invoice"
                                 Required="true"
                                 RequiredError="Invoice is required"
                                 SearchFunc="SearchInvoices"
                                 ToStringFunc="@(i => i?.InvoiceNumber ?? string.Empty)"
                                 ValueChanged="OnInvoiceChanged"
                                 Variant="Variant.Outlined">
                    <ItemTemplate Context="invoice">
                        <MudStack Row="false" Spacing="0">
                            <MudText Typo="Typo.body1">@invoice.InvoiceNumber - @invoice.CustomerName</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Amount: @invoice.TotalAmount.ToString("C2") | Due: @invoice.DueDate.ToString("dd MMM yyyy")
                            </MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_selectedInvoice != null)
                {
                    <!-- Invoice Summary -->
                    <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded-lg">
                        <MudStack Row="false" Spacing="2">
                            <MudText Typo="Typo.h6">Invoice Details</MudText>
                            <MudGrid Spacing="1">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Customer</MudText>
                                    <MudText Typo="Typo.body1">@_selectedInvoice.CustomerName</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Invoice Number</MudText>
                                    <MudText Typo="Typo.body1">@_selectedInvoice.InvoiceNumber</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total Amount</MudText>
                                    <MudText Typo="Typo.body1">@_selectedInvoice.TotalAmount.ToString("C2")</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Already Paid</MudText>
                                    <MudText Typo="Typo.body1">@_selectedInvoice.PaidAmount.ToString("C2")</MudText>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Remaining Balance</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Primary">@(_selectedInvoice.TotalAmount - _selectedInvoice.PaidAmount).ToString("C2")</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <!-- Receipt Details -->
                    <MudNumericField @bind-Value="_amount"
                                     Label="Receipt Amount"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     Min="0.01m"
                                     Max="@(_selectedInvoice.TotalAmount - _selectedInvoice.PaidAmount)"
                                     Format="N2"
                                     HelperText="@($"Maximum: {(_selectedInvoice.TotalAmount - _selectedInvoice.PaidAmount):C2}")" />

                    <MudSelect T="string"
                               @bind-Value="_paymentMethod"
                               Label="Payment Method"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                        <MudSelectItem Value="@("Bank Transfer")">Bank Transfer</MudSelectItem>
                        <MudSelectItem Value="@("Credit Card")">Credit Card</MudSelectItem>
                        <MudSelectItem Value="@("Debit Card")">Debit Card</MudSelectItem>
                        <MudSelectItem Value="@("Check")">Check</MudSelectItem>
                    </MudSelect>

                    <MudTextField @bind-Value="_notes"
                                  Label="Notes (Optional)"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Placeholder="Add any additional notes about this payment..." />
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateReceipt"
                   Disabled="@(!_isValid || _selectedInvoice == null || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <text>Issue Receipt</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;

    private InvoiceDto? _selectedInvoice;
    private decimal _amount = 0;
    private string _paymentMethod = "Bank Transfer";
    private string? _notes;

    private async Task<IEnumerable<InvoiceDto>> SearchInvoices(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return Array.Empty<InvoiceDto>();

        try
        {
            // TODO: Replace with actual BFF API call to get unpaid/partially paid invoices
            // var invoices = await Http.GetFromJsonAsync<List<InvoiceDto>>($"api/invoices/unpaid?q={value}", cancellationToken);
            // return invoices ?? Array.Empty<InvoiceDto>();

            // Mock data for now
            return new[]
            {
                new InvoiceDto
                {
                    Id = Guid.NewGuid(),
                    InvoiceNumber = "INV-2026-001",
                    CustomerName = "John Doe",
                    TotalAmount = 10000.00m,
                    PaidAmount = 0m,
                    DueDate = DateTime.Today.AddDays(15)
                },
                new InvoiceDto
                {
                    Id = Guid.NewGuid(),
                    InvoiceNumber = "INV-2026-002",
                    CustomerName = "Jane Smith",
                    TotalAmount = 25000.00m,
                    PaidAmount = 10000.00m,
                    DueDate = DateTime.Today.AddDays(20)
                }
            };
        }
        catch
        {
            return Array.Empty<InvoiceDto>();
        }
    }

    private void OnInvoiceChanged(InvoiceDto? invoice)
    {
        _selectedInvoice = invoice;
        if (invoice != null)
        {
            // Auto-fill amount with remaining balance
            _amount = invoice.TotalAmount - invoice.PaidAmount;
        }
    }

    private async Task CreateReceipt()
    {
        if (_selectedInvoice == null)
            return;

        _isSubmitting = true;

        try
        {
            var request = new CreateReceiptRequestDto
            {
                InvoiceId = _selectedInvoice.Id,
                Amount = _amount,
                PaymentMethod = _paymentMethod,
                Notes = _notes
            };

            // TODO: Replace with actual BFF API call
            // var response = await Http.PostAsJsonAsync("api/receipts", request);
            // response.EnsureSuccessStatusCode();

            Snackbar.Add("Receipt issued successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create receipt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    public class InvoiceDto
    {
        public Guid Id { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public decimal TotalAmount { get; set; }
        public decimal PaidAmount { get; set; }
        public DateTime DueDate { get; set; }
    }

    public class CreateReceiptRequestDto
    {
        public Guid InvoiceId { get; set; }
        public decimal Amount { get; set; }
        public string PaymentMethod { get; set; } = string.Empty;
        public string? Notes { get; set; }
    }
}
