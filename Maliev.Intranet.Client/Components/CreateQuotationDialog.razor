@using Maliev.Intranet.Shared
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <!-- Customer Selection -->
                <MudAutocomplete T="CustomerSummaryDto"
                                 Value="_selectedCustomer"
                                 Label="Customer"
                                 Required="true"
                                 RequiredError="Customer is required"
                                 SearchFunc="SearchCustomers"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 ValueChanged="OnCustomerChanged"
                                 Variant="Variant.Outlined">
                    <ItemTemplate Context="customer">
                        <MudStack Row="false" Spacing="0">
                            <MudText Typo="Typo.body1">@customer.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@customer.Email</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_selectedCustomer != null && _customerIdentity != null)
                {
                    <!-- Billing Identity Selector -->
                    <BillingIdentitySelector Customer="_customerIdentity"
                                             @bind-SelectedIdentityType="_billingIdentityType" />

                    <!-- Validity Period -->
                    <MudDateRangePicker Label="Validity Period"
                                        @bind-DateRange="_validityPeriod"
                                        Required="true"
                                        Variant="Variant.Outlined" />

                    <!-- Line Items -->
                    <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded-lg">
                        <MudStack Row="false" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">Line Items</MudText>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           OnClick="AddLineItem">
                                    Add Item
                                </MudButton>
                            </MudStack>

                            @if (_lineItems.Count == 0)
                            {
                                <MudText Color="Color.Secondary">No items added yet. Click "Add Item" to get started.</MudText>
                            }
                            else
                            {
                                @foreach (var (item, index) in _lineItems.Select((item, i) => (item, i)))
                                {
                                    <MudPaper Elevation="1" Class="pa-2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="5">
                                                <MudTextField @bind-Value="item.Description"
                                                              Label="Description"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Required="true" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudNumericField @bind-Value="item.Quantity"
                                                                 Label="Quantity"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0.01m"
                                                                 Required="true" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudNumericField @bind-Value="item.UnitPrice"
                                                                 Label="Unit Price"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Format="N2"
                                                                 Min="0m"
                                                                 Required="true" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total</MudText>
                                                <MudText Typo="Typo.h6">@((item.Quantity * item.UnitPrice).ToString("C2"))</MudText>
                                            </MudItem>
                                            <MudItem xs="1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => RemoveLineItem(index)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }

                                <MudDivider />
                                <MudStack Row="true" Justify="Justify.FlexEnd">
                                    <MudText Typo="Typo.h6">Total: @CalculateTotal().ToString("C2")</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>

                    <!-- Delivery Expectations -->
                    <MudTextField @bind-Value="_deliveryExpectations"
                                  Label="Delivery Expectations"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Placeholder="e.g., 2-3 weeks from order confirmation" />
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateQuotation"
                   Disabled="@(!_isValid || _selectedCustomer == null || _lineItems.Count == 0 || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <text>Create Quotation</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;

    private CustomerSummaryDto? _selectedCustomer;
    private CustomerIdentityDto? _customerIdentity;
    private BillingIdentityType _billingIdentityType = BillingIdentityType.Corporate;
    private DateRange? _validityPeriod = new DateRange(DateTime.Today, DateTime.Today.AddDays(30));
    private string? _deliveryExpectations;
    private List<QuotationItemDto> _lineItems = new();

    private async Task<IEnumerable<CustomerSummaryDto>> SearchCustomers(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return Array.Empty<CustomerSummaryDto>();

        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>($"api/customers?search={value}", cancellationToken);
            return response?.Data ?? Array.Empty<CustomerSummaryDto>();
        }
        catch
        {
            return Array.Empty<CustomerSummaryDto>();
        }
    }

    private async Task OnCustomerChanged(CustomerSummaryDto? customer)
    {
        _selectedCustomer = customer;
        _customerIdentity = null;

        if (customer == null)
            return;

        try
        {
            _customerIdentity = await Http.GetFromJsonAsync<CustomerIdentityDto>($"api/customers/{customer.Id}/identity");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customer identity: {ex.Message}", Severity.Error);
        }
    }

    private void AddLineItem()
    {
        _lineItems.Add(new QuotationItemDto
        {
            Description = "",
            Quantity = 1,
            UnitPrice = 0
        });
    }

    private void RemoveLineItem(int index)
    {
        _lineItems.RemoveAt(index);
    }

    private decimal CalculateTotal()
    {
        return _lineItems.Sum(item => item.Quantity * item.UnitPrice);
    }

    private async Task CreateQuotation()
    {
        if (_selectedCustomer == null || _validityPeriod == null)
            return;

        _isSubmitting = true;

        try
        {
            var request = new CreateQuotationRequest
            {
                CustomerId = _selectedCustomer.Id,
                BillingIdentityType = _billingIdentityType,
                ValidityPeriodStart = _validityPeriod.Start ?? DateTime.Today,
                ValidityPeriodEnd = _validityPeriod.End ?? DateTime.Today.AddDays(30),
                Items = _lineItems,
                DeliveryExpectations = _deliveryExpectations
            };

            var response = await Http.PostAsJsonAsync("api/quotations", request);
            response.EnsureSuccessStatusCode();

            Snackbar.Add("Quotation created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create quotation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
