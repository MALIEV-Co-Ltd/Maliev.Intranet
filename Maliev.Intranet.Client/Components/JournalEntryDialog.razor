@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (IsReadOnly && ExistingEntry != null)
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Entry Number</MudText>
                    <MudText Typo="Typo.body1">@ExistingEntry.EntryNumber</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Date</MudText>
                    <MudText Typo="Typo.body1">@ExistingEntry.Date.ToString("dd MMM yyyy")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Default">Description</MudText>
                    <MudText Typo="Typo.body1">@ExistingEntry.Description</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Journal Lines</MudText>
                    <MudTable Items="ExistingEntry.Lines" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Account</MudTh>
                            <MudTh Style="text-align:right">Debit</MudTh>
                            <MudTh Style="text-align:right">Credit</MudTh>
                             <MudTh>Description</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Account">@(context.AccountId)</MudTd>
                            <MudTd DataLabel="Debit" Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("N2") : "-")</MudTd>
                            <MudTd DataLabel="Credit" Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("N2") : "-")</MudTd>
                            <MudTd DataLabel="Description">@(context.Description)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudDivider Class="mt-2" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="4" Class="mt-2 pr-2">
                        <MudText Typo="Typo.body2">Total Debit: <strong>@ExistingEntry.TotalDebit.ToString("N2")</strong></MudText>
                        <MudText Typo="Typo.body2">Total Credit: <strong>@ExistingEntry.TotalCredit.ToString("N2")</strong></MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_entryDate" Label="Entry Date" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Required="true" RequiredError="Description is required" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Journal Lines (minimum 2)</MudText>
                        @for (int i = 0; i < _lines.Count; i++)
                        {
                            var idx = i;
                            <MudGrid Spacing="2" Class="mb-2">
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" @bind-Value="_lines[idx].AccountId" Label="Account" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                                        @foreach (var account in Accounts)
                                        {
                                            <MudSelectItem Value="@account.Id.ToString()">@account.Code - @account.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudNumericField T="decimal" @bind-Value="_lines[idx].Debit" Label="Debit" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="N2" />
                                </MudItem>
                                <MudItem xs="12" sm="2">
                                    <MudNumericField T="decimal" @bind-Value="_lines[idx].Credit" Label="Credit" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="N2" />
                                </MudItem>
                                <MudItem xs="12" sm="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveLine(idx))" Disabled="@(_lines.Count <= 2)" />
                                </MudItem>
                            </MudGrid>
                        }
                        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine" Size="Size.Small" Class="mt-2">Add Line</MudButton>
                    </MudItem>

                    @if (_lines.Count >= 2)
                    {
                        var totalDebit = _lines.Sum(l => l.Debit);
                        var totalCredit = _lines.Sum(l => l.Credit);
                        var isBalanced = totalDebit == totalCredit && totalDebit > 0;
                        <MudItem xs="12">
                            <MudDivider />
                            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="4" Class="mt-2">
                                <MudText Typo="Typo.body2">Total Debit: <strong>@totalDebit.ToString("N2")</strong></MudText>
                                <MudText Typo="Typo.body2">Total Credit: <strong>@totalCredit.ToString("N2")</strong></MudText>
                                @if (!isBalanced)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Error">Entry must be balanced (Debit = Credit)</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success">Balanced</MudText>
                                }
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())" Disabled="@_isSaving">@(IsReadOnly ? "Close" : "Cancel")</MudButton>
        @if (!IsReadOnly)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_isSaving || !IsEntryBalanced)">
                @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Post Entry
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public List<ChartOfAccountDto> Accounts { get; set; } = new();
    [Parameter] public JournalEntryDto? ExistingEntry { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private DateTime? _entryDate = DateTime.Today;
    private string _description = string.Empty;
    private List<JournalLineInput> _lines = new()
    {
        new JournalLineInput(),
        new JournalLineInput()
    };

    private bool IsEntryBalanced
    {
        get
        {
            var totalDebit = _lines.Sum(l => l.Debit);
            var totalCredit = _lines.Sum(l => l.Credit);
            return totalDebit == totalCredit && totalDebit > 0;
        }
    }

    private void AddLine() => _lines.Add(new JournalLineInput());
    private void RemoveLine(int idx) { if (_lines.Count > 2) _lines.RemoveAt(idx); }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid || !IsEntryBalanced || _entryDate == null) return;

        _isSaving = true;
        try
        {
            var request = new CreateJournalEntryRequest
            {
                Date = _entryDate.Value,
                Description = _description,
                Lines = _lines.Select(l => new JournalEntryLineDto
                {
                    AccountId = Guid.TryParse(l.AccountId, out var id) ? id : Guid.Empty,
                    Debit = l.Debit,
                    Credit = l.Credit,
                    Description = l.Description
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/accounting/journal-entries", request);
            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to create entry: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private class JournalLineInput
    {
        public string AccountId { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string Description { get; set; } = string.Empty;
    }
}
