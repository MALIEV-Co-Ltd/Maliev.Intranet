@using MudBlazor
@using Maliev.Intranet.Shared
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="mr-3 mb-n1"/>
            Upload 3D Models
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           FilesChanged="OnFilesSelected"
                           Accept=".stl,.obj,.step,.stp,.step.gz,.stp.gz"
                           MaximumFileCount="10"
                           @ref="_fileUpload">
                <CustomContent>
                    <MudPaper Outlined="true"
                              @onclick="@context.OpenFilePickerAsync"
                              Class="@($"relative d-flex flex-column align-center justify-center py-12 px-6 border-dashed border-2 rounded-xl transition-all {(_dragOver ? "mud-border-primary mud-bg-primary-hover" : "mud-border-lines-default")}")"
                              Style="cursor: pointer;"
                              @ondragenter="@(() => _dragOver = true)"
                              @ondragleave="@(() => _dragOver = false)"
                              @ondragover:preventDefault
                              @ondrop="@(() => _dragOver = false)">
                        <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                        <MudText Typo="Typo.h6">Click to upload or drag and drop</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Upload 3D models up to 100MB each (STL, OBJ, STEP)</MudText>
                    </MudPaper>
                </CustomContent>
            </MudFileUpload>

            @if (!string.IsNullOrEmpty(_fileCountWarning))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@_fileCountWarning</MudAlert>
            }

            @if (_uploadingFiles.Any())
            {
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Selected Models (@_uploadingFiles.Count)</MudText>
                <div style="max-height: 300px; overflow-y: auto;" class="pr-2">
                    <MudStack Spacing="2">
                        @foreach (var file in _uploadingFiles)
                        {
                            <MudPaper Outlined="true" Class="pa-3 rounded-lg d-flex flex-column gap-2">
                                <div class="d-flex align-center justify-space-between">
                                    <div class="d-flex align-center gap-3">
                                        <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Color="Color.Primary" Size="Size.Small" />
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@file.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(file.Size)</MudText>
                                        </div>
                                    </div>
                                    @if (!file.IsUploading && !file.IsCompleted)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveFile(file))" />
                                    }
                                    @if (file.IsCompleted)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    }
                                    @if (file.Error != null)
                                    {
                                        <MudTooltip Text="@file.Error">
                                            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                </div>
                                @if (file.IsUploading)
                                {
                                    <MudProgressLinear Color="Color.Primary" Value="@file.Progress" Class="rounded-pill" />
                                }
                            </MudPaper>
                        }
                    </MudStack>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isBusy">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="StartUpload"
                   Disabled="@(!_uploadingFiles.Any() || _isBusy || _uploadingFiles.All(f => f.IsCompleted))">
            @(_isBusy ? "Uploading..." : "Start Upload")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private bool _dragOver;
    private bool _isBusy;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;
    private List<UploadFileState> _uploadingFiles = new();

    private class UploadFileState
    {
        public IBrowserFile BrowserFile { get; set; } = default!;
        public string Name => BrowserFile.Name;
        public long Size => BrowserFile.Size;
        public int Progress { get; set; }
        public bool IsUploading { get; set; }
        public bool IsCompleted { get; set; }
        public string? Error { get; set; }
        public string? UploadId { get; set; }
    }

    private const int MaxFileCount = 10;
    private string? _fileCountWarning;

    private void OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        _fileCountWarning = null;
        var incoming = files.ToList();
        if (incoming.Count > MaxFileCount)
        {
            _fileCountWarning = $"Only the first {MaxFileCount} files will be accepted.";
            incoming = incoming.Take(MaxFileCount).ToList();
        }
        foreach (var file in incoming)
        {
            if (!_uploadingFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
            {
                _uploadingFiles.Add(new UploadFileState { BrowserFile = file });
            }
        }
    }

    private void RemoveFile(UploadFileState file) => _uploadingFiles.Remove(file);

    private async Task StartUpload()
    {
        _isBusy = true;
        bool anySuccess = false;

        foreach (var file in _uploadingFiles.Where(f => !f.IsCompleted))
        {
            file.IsUploading = true;
            file.Progress = 10;
            StateHasChanged();

            try
            {
                using var content = new MultipartFormDataContent();
                // 3D models can be large, up to 100MB
                var stream = file.BrowserFile.OpenReadStream(100 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.BrowserFile.ContentType ?? "application/octet-stream");
                content.Add(fileContent, "file", file.Name);

                file.Progress = 40;
                StateHasChanged();

                var response = await Http.PostAsync("api/models/upload", content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<BffUploadResponse>();
                    if (result != null)
                    {
                        file.IsCompleted = true;
                        file.Progress = 100;
                        file.UploadId = result.UploadId;
                        anySuccess = true;
                    }
                }
                else
                {
                    file.Error = $"Upload failed: {response.StatusCode}";
                }
            }
            catch (Exception ex)
            {
                file.Error = ex.Message;
            }
            finally
            {
                file.IsUploading = false;
                StateHasChanged();
            }
        }

        _isBusy = false;
        if (anySuccess)
        {
            Snackbar.Add("Upload(s) complete. Models are being analyzed.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private string FormatFileSize(long bytes) => $"{(bytes / 1024.0 / 1024.0):F2} MB";
}
