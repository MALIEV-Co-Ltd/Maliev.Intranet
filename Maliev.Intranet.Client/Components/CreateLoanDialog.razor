@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="_request.BorrowerType"
                           Label="Borrower Type"
                           Required="true"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Employee")">Employee</MudSelectItem>
                    <MudSelectItem Value="@("Customer")">Customer</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_borrowerIdText"
                              Label="Borrower ID (GUID)"
                              Required="true"
                              Variant="Variant.Outlined"
                              HelperText="Paste the employee or customer ID." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_request.Purpose"
                              Label="Purpose"
                              Required="true"
                              Variant="Variant.Outlined"
                              Lines="2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_startDateNullable"
                               Label="Loan Start Date"
                               Required="true"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_returnDateNullable"
                               Label="Expected Return Date"
                               Required="true"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
        </MudGrid>

        @if (_request.BorrowerType == "Customer")
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                Customer loans require approval and will generate a loan agreement PDF.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   OnClick="Submit"
                   Disabled="@(_isSaving)">
            @(_isSaving ? "Saving..." : "Create Loan")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the ID of the equipment to create a loan for.</summary>
    [Parameter] public Guid EquipmentId { get; set; }

    private bool _isSaving;
    private string _borrowerIdText = string.Empty;

    private readonly CreateLoanRequest _request = new()
    {
        BorrowerType = "Employee",
        Purpose = string.Empty
    };

    private DateTime? _startDateNullable
    {
        get => _request.LoanStartDate == default ? DateTime.Today : _request.LoanStartDate.ToDateTime(TimeOnly.MinValue);
        set => _request.LoanStartDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : DateOnly.FromDateTime(DateTime.Today);
    }

    private DateTime? _returnDateNullable
    {
        get => _request.ExpectedReturnDate == default ? null : _request.ExpectedReturnDate.ToDateTime(TimeOnly.MinValue);
        set => _request.ExpectedReturnDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : default;
    }

    private async Task Submit()
    {
        if (!Guid.TryParse(_borrowerIdText, out var borrowerId))
        {
            Snackbar.Add("Please enter a valid Borrower ID (GUID format).", Severity.Warning);
            return;
        }

        _request.BorrowerId = borrowerId;
        _request.EquipmentId = EquipmentId;

        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/equipments/loans", _request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Loan created.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var statusCode = (int)response.StatusCode;
                Snackbar.Add(statusCode == 409
                    ? "Equipment is not available for loan."
                    : "Failed to create loan.",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
