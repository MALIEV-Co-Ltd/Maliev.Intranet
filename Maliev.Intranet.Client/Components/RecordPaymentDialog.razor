@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Recording payment for Invoice @InvoiceNumber. Outstanding: @CurrencyFormatter.Format(OutstandingAmount, "THB", 2)
        </MudText>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="3">
                <MudNumericField T="decimal" @bind-Value="_amount" Label="Payment Amount" Variant="Variant.Outlined"
                                 Min="0.01m" Max="@OutstandingAmount" Format="N2"
                                 Required="true" RequiredError="Amount is required" />
                <MudSelect T="string" @bind-Value="_paymentMethod" Label="Payment Method" Variant="Variant.Outlined" Required="true">
                    <MudSelectItem Value="@("Bank Transfer")">Bank Transfer</MudSelectItem>
                    <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                    <MudSelectItem Value="@("Cheque")">Cheque</MudSelectItem>
                    <MudSelectItem Value="@("Credit Card")">Credit Card</MudSelectItem>
                    <MudSelectItem Value="@("PromptPay")">PromptPay</MudSelectItem>
                </MudSelect>
                <MudDatePicker @bind-Date="_paymentDate" Label="Payment Date" Variant="Variant.Outlined" Required="true" />
                <MudTextField @bind-Value="_reference" Label="Reference / Transaction ID" Variant="Variant.Outlined" Placeholder="Bank reference number" />
                <MudTextField @bind-Value="_notes" Label="Notes (optional)" Variant="Variant.Outlined" Lines="2" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_isSaving || !_isValid)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Record Payment
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid InvoiceId { get; set; }
    [Parameter] public string InvoiceNumber { get; set; } = string.Empty;
    [Parameter] public decimal OutstandingAmount { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSaving;
    private decimal _amount;
    private string _paymentMethod = "Bank Transfer";
    private DateTime? _paymentDate = DateTime.Today;
    private string _reference = string.Empty;
    private string _notes = string.Empty;

    protected override void OnInitialized()
    {
        _amount = OutstandingAmount;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid || _paymentDate == null) return;

        _isSaving = true;
        try
        {
            var createRequest = new CreatePaymentRequest
            {
                InvoiceId = InvoiceId,
                Amount = _amount,
                PaymentMethod = _paymentMethod,
                PaymentDate = _paymentDate.Value
            };

            var createResponse = await Http.PostAsJsonAsync("api/payments", createRequest);
            if (!createResponse.IsSuccessStatusCode)
            {
                var error = await createResponse.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to record payment: {error}", Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
