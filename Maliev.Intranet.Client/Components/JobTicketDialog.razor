@using Maliev.Intranet.Shared.Dtos
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* ── Job Ticket Dialog (WP-UIX-6.4) ─────────────────────────────────────── *@
<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Class="d-block mx-auto my-6" />
        }
        else if (_job == null || _detail == null)
        {
            <MudAlert Severity="Severity.Error">Could not load job ticket data.</MudAlert>
        }
        else
        {
            <div id="job-ticket-printable" class="ticket-container">
                @* QR code *@
                <MudStack AlignItems="AlignItems.Center" Class="mb-3">
                    @if (!string.IsNullOrEmpty(_job.QrPngBase64))
                    {
                        <img src="data:image/png;base64,@_job.QrPngBase64"
                             alt="Job QR Code"
                             style="width: 140px; height: 140px;" />
                    }
                    else
                    {
                        @* Fallback: render QR client-side via JS *@
                        <div id="qr-placeholder" style="width: 140px; height: 140px;
                             border: 1px dashed var(--mud-palette-lines-default);
                             display: flex; align-items: center; justify-content: center;">
                            <MudIcon Icon="@Icons.Material.Outlined.QrCode2"
                                     Style="font-size: 60px;" Color="Color.Secondary" />
                        </div>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 10px; word-break: break-all;">
                        @_job.Url
                    </MudText>
                </MudStack>

                <MudDivider Class="mb-3" />

                @* Ticket fields *@
                <MudGrid Spacing="1">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Job #</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_detail!.JobNumber</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Priority</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(_detail!.Priority)">
                            @_detail!.Priority
                        </MudChip>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Part</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600;">@_detail!.PartDescription</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Process</MudText>
                        <MudText Typo="Typo.body2">@_detail!.ProcessType</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Material</MudText>
                        <MudText Typo="Typo.body2">@(_detail!.Material ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Quantity</MudText>
                        <MudText Typo="Typo.body2">@_detail!.Quantity.ToString("N0")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Machine</MudText>
                        <MudText Typo="Typo.body2">@(_detail!.MachineName ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Customer</MudText>
                        <MudText Typo="Typo.body2">@_detail!.CustomerName</MudText>
                    </MudItem>
                    @if (_detail!.EstimatedCompletionAt.HasValue)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">ETA</MudText>
                            <MudText Typo="Typo.body2">@_detail!.EstimatedCompletionAt.Value.ToString("dd MMM yyyy HH:mm")</MudText>
                        </MudItem>
                    }
                </MudGrid>

                @* Company footer *@
                <MudDivider Class="mt-3 mb-2" />
                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                    Maliev Co., Ltd. — Manufacturing Division — Printed @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </MudText>
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@MudDialog.Cancel" Variant="Variant.Text">Close</MudButton>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Outlined.Print"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_job == null)"
                   OnClick="PrintTicket">
            Print Ticket
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .ticket-container {
        font-family: 'Courier New', monospace;
        max-width: 380px;
        margin: 0 auto;
    }
    @@media print {
        body * { visibility: hidden; }
        #job-ticket-printable, #job-ticket-printable * { visibility: visible; }
        #job-ticket-printable {
            position: fixed;
            top: 0; left: 0;
            width: 100%;
            font-size: 11pt;
        }
    }
</style>

@code {
    /// <summary>Gets or sets the job ID to render the ticket for.</summary>
    [Parameter] public Guid JobId { get; set; }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _loading = true;
    private JobQrDto? _job;
    private JobDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var qrTask     = Http.GetFromJsonAsync<JobQrDto>($"api/jobs/{JobId}/qr");
            var detailTask = Http.GetFromJsonAsync<JobDetailDto>($"api/jobs/{JobId}");

            await Task.WhenAll(qrTask, detailTask);

            _job    = await qrTask;
            _detail = await detailTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading job ticket: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task PrintTicket()
    {
        // Trigger browser print dialog — only the ticket area renders thanks to @media print CSS
        await JS.InvokeVoidAsync("window.print");
    }

    private static Color GetPriorityColor(string priority) => priority switch
    {
        "Urgent" => Color.Error,
        "High"   => Color.Warning,
        "Normal" => Color.Primary,
        _        => Color.Default
    };
}
