@using MudBlazor
@using Maliev.Intranet.Shared
@inject IJSRuntime JSRuntime

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.EditNote : Icons.Material.Filled.AddComment)" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(IsEdit ? "Edit Internal Note" : "Add Internal Note")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudPaper Outlined="true" Class="rounded-lg overflow-hidden">
            <MudToolBar Dense="true" Class="px-2 border-b mud-bg-surface-light">
                <MudTooltip Text="Bold">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" OnClick='() => WrapSelection("**", "**")' />
                </MudTooltip>
                <MudTooltip Text="Italic">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" Size="Size.Small" OnClick='() => WrapSelection("_", "_")' />
                </MudTooltip>
                <MudTooltip Text="Heading">
                    <MudIconButton Icon="@Icons.Material.Filled.Title" Size="Size.Small" OnClick='() => PrefixLine("# ")' />
                </MudTooltip>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                <MudTooltip Text="Unordered List">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" OnClick='() => PrefixLine("- ")' />
                </MudTooltip>
                <MudTooltip Text="Ordered List">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" OnClick='() => PrefixLine("1. ")' />
                </MudTooltip>
                <MudTooltip Text="Check List">
                    <MudIconButton Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small" OnClick='() => PrefixLine("- [ ] ")' />
                </MudTooltip>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                <MudTooltip Text="Blockquote">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" OnClick='() => PrefixLine("> ")' />
                </MudTooltip>
                <MudTooltip Text="Code">
                    <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small" OnClick='() => WrapSelection("`", "`")' />
                </MudTooltip>
                <MudTooltip Text="Table">
                    <MudIconButton Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" OnClick="InsertTable" />
                </MudTooltip>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                <MudTooltip Text="Link">
                    <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" OnClick='() => WrapSelection("[", "](url)")' />
                </MudTooltip>
                <MudSpacer />
                <MudTooltip Text="@(_showPreview ? "Hide Preview" : "Show Preview")">
                    <MudToggleIconButton @bind-Toggled="_showPreview"
                                         Icon="@Icons.Material.Filled.Visibility" Color="@Color.Default" 
                                         ToggledIcon="@Icons.Material.Filled.VisibilityOff" ToggledColor="@Color.Primary" />
                </MudTooltip>
            </MudToolBar>

            <MudGrid Spacing="0">
                <MudItem xs="12" sm="@(_showPreview ? 6 : 12)">
                    <MudTextField T="string" 
                                  @bind-Value="_noteText" 
                                  Lines="15" 
                                  Variant="Variant.Text" 
                                  Placeholder="Enter internal note here... Use Markdown for formatting."
                                  Required="true"
                                  AutoGrow="false"
                                  Immediate="true"
                                  Counter="5000"
                                  MaxLength="5000"
                                  id="markdown-editor-area"
                                  Style="font-family: monospace; padding: 16px; border: none; font-size: 0.9rem;" />
                </MudItem>
                @if (_showPreview)
                {
                    <MudItem xs="12" sm="6" Class="border-l mud-border-lines-default mud-bg-surface-light">
                        <div class="pa-4 overflow-y-auto" style="height: 400px;">
                            <MarkdownRenderer Markdown="@_noteText" />
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="Submit" 
                   Disabled="@(string.IsNullOrWhiteSpace(_noteText))">@(IsEdit ? "Update Note" : "Add Note")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? ExistingNote { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    private string _noteText = string.Empty;
    private bool _showPreview = false;

    protected override void OnInitialized()
    {
        if (IsEdit && !string.IsNullOrEmpty(ExistingNote))
        {
            _noteText = ExistingNote;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_noteText))
        {
            MudDialog.Close(DialogResult.Ok(_noteText));
        }
    }

    private async Task WrapSelection(string prefix, string suffix)
    {
        var result = await JSRuntime.InvokeAsync<TextSelection>("eval", "((el) => { if (!el) return null; return { start: el.selectionStart, end: el.selectionEnd, value: el.value }; })(document.getElementById('markdown-editor-area'))");
        if (result != null)
        {
            var selectedText = result.Value.Substring(result.Start, result.End - result.Start);
            var newVal = result.Value.Substring(0, result.Start) + prefix + selectedText + suffix + result.Value.Substring(result.End);
            _noteText = newVal;
            StateHasChanged();
        }
        else
        {
            _noteText += prefix + "text" + suffix;
        }
    }

    private async Task PrefixLine(string prefix)
    {
        var result = await JSRuntime.InvokeAsync<TextSelection>("eval", "((el) => { if (!el) return null; return { start: el.selectionStart, end: el.selectionEnd, value: el.value }; })(document.getElementById('markdown-editor-area'))");
        if (result != null)
        {
            // Find start of line
            var startOfLine = result.Value.LastIndexOf('\n', Math.Max(0, result.Start - 1)) + 1;
            var newVal = result.Value.Substring(0, startOfLine) + prefix + result.Value.Substring(startOfLine);
            _noteText = newVal;
            StateHasChanged();
        }
        else
        {
            if (string.IsNullOrEmpty(_noteText) || _noteText.EndsWith("\n"))
                _noteText += prefix;
            else
                _noteText += "\n" + prefix;
        }
    }

    private void InsertTable()
    {
        var table = "\n| Column 1 | Column 2 |\n| -------- | -------- |\n| Item 1   | Item 2   |\n";
        _noteText += table;
        StateHasChanged();
    }

    private class TextSelection
    {
        public int Start { get; set; }
        public int End { get; set; }
        public string Value { get; set; } = string.Empty;
    }
}
