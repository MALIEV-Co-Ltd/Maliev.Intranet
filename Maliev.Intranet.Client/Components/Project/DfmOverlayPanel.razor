@namespace Maliev.Intranet.Client.Components.Project

@{
    var dfmSource = DfmIssues.Count > 0 ? DfmIssues[0].Source : null;
    var isLocalSource = string.Equals(dfmSource, "local", StringComparison.OrdinalIgnoreCase);
    var sourceIcon = isLocalSource ? Icons.Material.Outlined.Computer : Icons.Material.Outlined.Cloud;
    var sourceLabel = isLocalSource ? "Local" : "Server";
    var sourceColor = isLocalSource ? Color.Info : Color.Primary;
}

@if (TimedOut)
{
    <div class="dfm-overlay dfm-overlay--timed-out">
        <div class="dfm-overlay-header">
            <div class="dfm-header-left">
                <MudIcon Icon="@Icons.Material.Outlined.Info"
                         Size="Size.Small"
                         Color="Color.Default" />
                <span>@(string.IsNullOrEmpty(ErrorMessage) ? "DFM analysis unavailable" : ErrorMessage)</span>
            </div>
            @if (OnErrorAction.HasDelegate && !string.IsNullOrEmpty(ErrorActionLabel))
            {
                <button type="button" class="dfm-error-action-btn" @onclick="OnErrorAction">@ErrorActionLabel</button>
            }
        </div>
    </div>
}
else if (Analyzing)
{
    <div class="dfm-overlay dfm-overlay--analyzing">
        <div class="dfm-overlay-header">
            <div class="dfm-header-left">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>@(AnalyzingMessage ?? "Analyzing your model...")</span>
            </div>
        </div>
    </div>
}
else if (IsVisible && DfmIssues.Count > 0)
{
    <div class="dfm-overlay @(_acknowledged ? "dfm-overlay--success" : "")">
        <div class="dfm-overlay-header" @onclick="@ToggleExpanded">
            <div class="dfm-header-left">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Size="Size.Small"
                         Color="@(_acknowledged ? Color.Success : Color.Warning)" />
                <span>@(_acknowledged ? "Issues acknowledged" : $"{DfmIssues.Count} DFM issue{(DfmIssues.Count > 1 ? "s" : "")}")</span>
                @if (!string.IsNullOrWhiteSpace(dfmSource))
                {
                    <MudIcon Icon="@sourceIcon"
                             Size="Size.Small"
                             Color="@sourceColor"
                             Class="dfm-source-icon"
                             Title="@($"DFM analysis: {sourceLabel}")" />
                }
            </div>
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Size="Size.Small" />
        </div>
        @if (_expanded && !_acknowledged)
        {
            <MudList T="DfmIssue"
                     SelectionMode="SelectionMode.ToggleSelection"
                     SelectedValue="@_selectedIssue"
                     SelectedValueChanged="@OnIssueSelectionChanged"
                     Class="dfm-overlay-issues pa-0">
                @foreach (var issue in DfmIssues)
                {
                    var isActive = _selectedIssue == issue;
                    // Server overlays need a GLB URL; local (browser-runtime) overlays are
                    // rebuilt in the viewer from the issue's triangle face indices.
                    var canToggle = OnToggleOverlay.HasDelegate
                        && (issue.OverlayUrl != null || issue.FaceIndices is { Count: > 0 });
                    <MudListItem T="DfmIssue"
                                 Value="@issue"
                                 Disabled="@(!canToggle)"
                                 Class="@($"dfm-issue-row {(isActive ? "dfm-issue-row--active" : "")} {(canToggle ? "dfm-issue-row--clickable" : "")}")"
                                 Style="padding:4px 4px 4px 6px;">
                        <div style="display:flex;align-items:flex-start;gap:8px;width:100%;">
                            <MudIcon Icon="@issue.Icon"
                                     Size="Size.Small"
                                     Color="@(issue.Severity == DfmIssueSeverity.Error ? Color.Error : Color.Warning)"
                                     Class="dfm-issue-icon" />
                            <div style="flex:1; min-width:0;">
                                <MudText Typo="Typo.caption" Class="dfm-issue-title">@issue.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@issue.Description</MudText>
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       Size="Size.Small"
                       Class="mt-2"
                       OnClick="@Acknowledge">
                Acknowledge Issues
            </MudButton>
        }
    </div>
}

<style>
    .dfm-overlay {
        position: absolute;
        top: 16px;
        left: 16px;
        max-width: 320px;
        background: color-mix(in srgb, var(--mud-palette-surface) 80%, transparent);
        backdrop-filter: blur(8px);
        border: 1px solid var(--mud-palette-lines-default);
        border-top: 4px solid var(--mud-palette-warning);
        border-radius: 8px;
        padding: 12px 16px;
        z-index: 10;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transition: border-color 0.3s, opacity 0.5s ease;
    }
    .dfm-overlay--analyzing {
        border-top-color: var(--mud-palette-info);
    }
    .dfm-overlay--timed-out {
        border-top-color: var(--mud-palette-lines-default);
        background: color-mix(in srgb, var(--mud-palette-surface) 70%, transparent);
    }
    .dfm-overlay--success {
        border-top-color: var(--mud-palette-success) !important;
    }
    .dfm-overlay-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: var(--mud-typography-body1-size);
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        user-select: none;
    }
    .dfm-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dfm-error-action-btn {
        padding: 4px 10px;
        border: 1px solid var(--maliev-border);
        border-radius: 4px;
        background: var(--maliev-panel);
        color: var(--maliev-ink);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .dfm-error-action-btn:hover {
        background: var(--maliev-danger-soft, #fee2e2);
        border-color: var(--maliev-danger, #ef4444);
        color: var(--maliev-danger, #ef4444);
    }
    .dfm-overlay-issues {
        margin-top: 12px;
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-top: 4px;
        max-height: 200px;
        overflow-y: auto;
    }
    .dfm-issue-row {
        border-left: 3px solid transparent;
        border-radius: 4px;
        transition: border-color 0.15s;
    }
    .dfm-issue-row--active {
        border-left-color: var(--mud-palette-primary);
        background: var(--maliev-primary-soft);
    }
    .dfm-issue-icon { margin-top: 2px; flex-shrink: 0; }
    .dfm-issue-title { display: block; font-weight: 600; color: var(--mud-palette-text-primary); margin-bottom: 2px; }
    .dfm-overlay-indicator { flex-shrink: 0; margin-top: 2px; opacity: 0.6; }
    @@media (max-width: 768px) {
        .dfm-overlay { left: 16px; right: 16px; max-width: none; }
    }
</style>

@code {
    /// <summary>The list of DFM issues to display.</summary>
    [Parameter] public IReadOnlyList<DfmIssue> DfmIssues { get; set; } = [];

    /// <summary>True when the overlay should be shown (i.e., when there are unacknowledged DFM issues).</summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>True while DFM analysis is in progress but no report has arrived yet.</summary>
    [Parameter] public bool Analyzing { get; set; }

    /// <summary>Optional message shown while DFM analysis is in progress.</summary>
    [Parameter] public string? AnalyzingMessage { get; set; }

    /// <summary>True when DFM analysis timed out on the client or a failure event arrived. Shows 'unavailable' notice.</summary>
    [Parameter] public bool TimedOut { get; set; }

    /// <summary>Optional user-friendly message describing why DFM is unavailable. Shown instead of the generic label when set.</summary>
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>Invoked when the user clicks the Acknowledge button.</summary>
    [Parameter] public EventCallback OnAcknowledged { get; set; }

    /// <summary>Invoked when the user clicks the eye icon on a DFM issue to toggle its overlay on the 3D model.</summary>
    [Parameter] public EventCallback<DfmIssue> OnToggleOverlay { get; set; }

    /// <summary>Optional action callback shown as a button in the error/timed-out state.</summary>
    [Parameter] public EventCallback OnErrorAction { get; set; }

    /// <summary>Label for the optional error action button.</summary>
    [Parameter] public string? ErrorActionLabel { get; set; }

    private bool _acknowledged;
    private bool _expanded;
    // Tracks the currently selected issue whose overlay is shown on the 3D model (single-select).
    private DfmIssue? _selectedIssue;
    // Kept for backward compatibility: parent reads this to determine isActive for ToggleDfmOverlayAsync.
    internal readonly HashSet<string> _activeOverlays = [];
    private bool _previousIsVisible;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (DfmIssues.Count == 0 || (IsVisible && !_previousIsVisible))
        {
            _acknowledged = false;
            _expanded = true;
        }
        _previousIsVisible = IsVisible;
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }

    private async Task Acknowledge()
    {
        _acknowledged = true;
        await OnAcknowledged.InvokeAsync();
    }

    private async Task OnIssueSelectionChanged(DfmIssue? newIssue)
    {
        // Deactivate the previously selected overlay (if any and different from the new selection).
        if (_selectedIssue != null && _selectedIssue != newIssue && _selectedIssue.OverlayKey != null)
        {
            _activeOverlays.Remove(_selectedIssue.OverlayKey);
            await OnToggleOverlay.InvokeAsync(_selectedIssue);
        }

        _selectedIssue = newIssue;

        if (newIssue?.OverlayKey != null)
        {
            // Toggle on: activate the new overlay.
            _activeOverlays.Add(newIssue.OverlayKey);
            await OnToggleOverlay.InvokeAsync(newIssue);
        }
    }

    /// <summary>Clears all active overlay and animation state (e.g. when the active part changes).</summary>
    public void ResetOverlays()
    {
        _selectedIssue = null;
        _activeOverlays.Clear();
    }
}
