@namespace Maliev.Intranet.Client.Components.Project

@if (Analyzing && TimedOut)
{
    <div class="dfm-overlay dfm-overlay--timed-out">
        <div class="dfm-overlay-header">
            <div class="dfm-header-left">
                <MudIcon Icon="@Icons.Material.Outlined.Info"
                         Size="Size.Small"
                         Color="Color.Default" />
                <span>DFM analysis unavailable</span>
            </div>
        </div>
    </div>
}
else if (Analyzing)
{
    <div class="dfm-overlay dfm-overlay--analyzing">
        <div class="dfm-overlay-header">
            <div class="dfm-header-left">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>Analyzing your model&hellip;</span>
            </div>
        </div>
    </div>
}
else if (_allClearShown)
{
    <div class="dfm-overlay dfm-overlay--all-clear @( _allClearFading ? "dfm-overlay--fade-out" : "")">
        <div class="dfm-overlay-header">
            <div class="dfm-header-left">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Size="Size.Small"
                         Color="Color.Success" />
                <span>All Clear &mdash; No Issues Found</span>
            </div>
        </div>
    </div>
}
else if (IsVisible && DfmIssues.Count > 0)
{
    <div class="dfm-overlay @(_acknowledged ? "dfm-overlay--success" : "")">
        <div class="dfm-overlay-header" @onclick="@ToggleExpanded">
            <div class="dfm-header-left">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Size="Size.Small"
                         Color="@(_acknowledged ? Color.Success : Color.Warning)" />
                <span>@(_acknowledged ? "Issues acknowledged" : $"{DfmIssues.Count} DFM issue{(DfmIssues.Count > 1 ? "s" : "")}")</span>
            </div>
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Size="Size.Small" />
        </div>
        @if (_expanded && !_acknowledged)
        {
            <div class="dfm-overlay-issues">
                @foreach (var issue in DfmIssues)
                {
                    var isActive = issue.OverlayKey != null && _activeOverlays.Contains(issue.OverlayKey);
                    var canToggle = issue.OverlayUrl != null && OnToggleOverlay.HasDelegate;
                    <div class="dfm-issue-row @(isActive ? "dfm-issue-row--active" : "") @(canToggle ? "dfm-issue-row--clickable" : "")"
                         @onclick="@(canToggle ? () => ToggleOverlay(issue) : null)">
                        <MudIcon Icon="@issue.Icon"
                                 Size="Size.Small"
                                 Color="@(issue.Severity == DfmIssueSeverity.Error ? Color.Error : Color.Warning)"
                                 Class="dfm-issue-icon" />
                        <div style="flex:1; min-width:0;">
                            <MudText Typo="Typo.caption" Class="dfm-issue-title">@issue.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@issue.Description</MudText>
                        </div>
                        @if (canToggle)
                        {
                            <MudIcon Icon="@(isActive ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.VisibilityOff)"
                                     Size="Size.Small"
                                     Color="@(isActive ? Color.Primary : Color.Default)"
                                     Class="dfm-overlay-indicator" />
                        }
                    </div>
                }
            </div>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       Size="Size.Small"
                       Class="mt-2"
                       OnClick="@Acknowledge">
                Acknowledge Issues
            </MudButton>
        }
    </div>
}

<style>
    .dfm-overlay {
        position: absolute;
        top: 16px;
        left: 16px;
        max-width: 320px;
        background: rgba(255,255,255,0.5);
        backdrop-filter: blur(8px);
        border: 1px solid var(--mud-palette-lines-default);
        border-top: 4px solid var(--mud-palette-warning);
        border-radius: 8px;
        padding: 12px 16px;
        z-index: 10;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transition: border-color 0.3s, opacity 0.5s ease;
    }
    .dfm-overlay--analyzing {
        border-top-color: var(--mud-palette-info);
    }
    .dfm-overlay--timed-out {
        border-top-color: var(--mud-palette-lines-default);
        background: rgba(200,200,200,0.35);
    }
    .dfm-overlay--all-clear {
        border-top-color: var(--mud-palette-success);
        background: rgba(220,255,220,0.5);
    }
    .dfm-overlay--fade-out {
        opacity: 0;
    }
    .dfm-overlay--success {
        border-top-color: var(--mud-palette-success) !important;
    }
    .dfm-overlay-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: var(--mud-typography-body1-size);
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        cursor: pointer;
        user-select: none;
    }
    .dfm-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dfm-overlay-issues {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 12px;
        border-top: 1px solid var(--mud-palette-lines-default);
        padding-top: 12px;
        max-height: 180px;
        overflow-y: auto;
    }
    .dfm-issue-row {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        border-left: 3px solid transparent;
        padding: 4px 4px 4px 6px;
        margin: 0 -4px 0 -6px;
        border-radius: 4px;
        transition: background 0.15s, border-color 0.15s;
    }
    .dfm-issue-row--clickable {
        cursor: pointer;
    }
    .dfm-issue-row--clickable:hover {
        background: rgba(0,0,0,0.03);
    }
    .dfm-issue-row--active {
        border-left-color: var(--mud-palette-primary);
        background: rgba(37,99,235,0.06);
    }
    .dfm-issue-icon { margin-top: 2px; flex-shrink: 0; }
    .dfm-issue-title { display: block; font-weight: 600; color: var(--mud-palette-text-primary); margin-bottom: 2px; }
    .dfm-overlay-indicator { flex-shrink: 0; margin-top: 2px; opacity: 0.6; }
    @@media (max-width: 768px) {
        .dfm-overlay { left: 16px; right: 16px; max-width: none; }
    }
</style>

@code {
    /// <summary>The list of DFM issues to display.</summary>
    [Parameter] public IReadOnlyList<DfmIssue> DfmIssues { get; set; } = [];

    /// <summary>True when the overlay should be shown (i.e., when there are unacknowledged DFM issues).</summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>True while DFM analysis is in progress but no report has arrived yet.</summary>
    [Parameter] public bool Analyzing { get; set; }

    /// <summary>True when DFM analysis timed out on the client (60 s with no event). Shows 'unavailable' notice.</summary>
    [Parameter] public bool TimedOut { get; set; }

    /// <summary>True when DFM analysis completed and no issues were found.</summary>
    [Parameter] public bool AllClear { get; set; }

    /// <summary>Invoked when the user clicks the Acknowledge button.</summary>
    [Parameter] public EventCallback OnAcknowledged { get; set; }

    /// <summary>Invoked when the user clicks the eye icon on a DFM issue to toggle its overlay on the 3D model.</summary>
    [Parameter] public EventCallback<DfmIssue> OnToggleOverlay { get; set; }

    private bool _acknowledged;
    private bool _expanded;
    internal readonly HashSet<string> _activeOverlays = [];
    private bool _previousIsVisible;
    private bool _allClearFading;
    private bool _allClearShown;
    private CancellationTokenSource? _allClearCts;
    // Tracks the last issue count we transitioned *from* when showing All Clear.
    // Prevents re-triggering the banner every time parameters change.
    private int _previousIssueCount = -1;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (DfmIssues.Count == 0 || (IsVisible && !_previousIsVisible))
        {
            _acknowledged = false;
            _expanded = true;
        }
        _previousIsVisible = IsVisible;

        if (AllClear && !_allClearShown)
        {
            // Only fire the All Clear dismissal when transitioning from issues → clear,
            // not on every re-render. _previousIssueCount tracks the last count that
            // triggered a meaningful state change.
            var isNewAllClear = _previousIssueCount != 0;
            _previousIssueCount = 0;

            if (isNewAllClear)
            {
                _allClearShown = true;
                _allClearFading = false;
                _ = TriggerAllClearAutoDismiss();
            }
        }
        else if (!AllClear)
        {
            if (DfmIssues.Count > 0)
                _previousIssueCount = DfmIssues.Count;
            _allClearShown = false;
            _allClearFading = false;
            _allClearCts?.Cancel();
        }
    }

    private async Task TriggerAllClearAutoDismiss()
    {
        _allClearCts?.Cancel();
        _allClearCts = new CancellationTokenSource();
        var token = _allClearCts.Token;
        try
        {
            await Task.Delay(3000, token);
            _allClearFading = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500, token);
            _allClearShown = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }

    private async Task Acknowledge()
    {
        _acknowledged = true;
        await OnAcknowledged.InvokeAsync();
    }

    private async Task ToggleOverlay(DfmIssue issue)
    {
        if (issue.OverlayKey == null) return;
        if (_activeOverlays.Contains(issue.OverlayKey))
            _activeOverlays.Remove(issue.OverlayKey);
        else
            _activeOverlays.Add(issue.OverlayKey);
        await OnToggleOverlay.InvokeAsync(issue);
    }

    /// <summary>Clears all active overlay state (e.g. when the process changes).</summary>
    public void ResetOverlays()
    {
        _activeOverlays.Clear();
    }
}
