@code {
    [Parameter] public CustomerSummaryDto? SelectedCustomer { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<CustomerSummaryDto>>>? SearchCustomers { get; set; }
    [Parameter] public EventCallback<CustomerSummaryDto?> OnCustomerSelected { get; set; }

    [Parameter, EditorRequired] public List<PartViewModel> Parts { get; set; } = [];
    [Parameter] public List<LeadTimeOptionDto> LeadTimeOptions { get; set; } = [];
    [Parameter] public LeadTimeOptionDto? SelectedLeadTime { get; set; }
    [Parameter] public EventCallback<LeadTimeOptionDto> OnLeadTimeChanged { get; set; }
    [Parameter] public decimal ShippingCost { get; set; }
    [Parameter] public EventCallback<decimal> ShippingCostChanged { get; set; }
    [Parameter] public decimal ManualDiscountAmount { get; set; }
    [Parameter] public EventCallback<decimal> ManualDiscountAmountChanged { get; set; }
    [Parameter] public string? QuotationTerms { get; set; }
    [Parameter] public EventCallback<string?> QuotationTermsChanged { get; set; }
    [Parameter] public bool CanQuote { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnQuote { get; set; }
    [Parameter] public EventCallback OnGeneratePdf { get; set; }

    [Parameter] public string? ShippingDestinationCountry { get; set; }
    [Parameter] public string? ShippingDestinationPostalCode { get; set; }
    [Parameter] public decimal TotalWeightKg { get; set; }

    private bool _generatingPdf;
    private bool _detailsOpen;
    private bool _fetchingRates;
    private List<ShippingRateOptionDto> _rateOptions = [];
    private string _shippingToName = "Customer";
    private string _shippingToPhone = "";
    private string _shippingToAddress = "";
    private string _shippingToDistrict = "";
    private string _shippingToState = "";
    private string _shippingToProvince = "";
    private string _shippingToPostcode = "";
    private decimal _shippingWeightGrams = 1000m;
    private decimal _shippingLengthCm = 20m;
    private decimal _shippingWidthCm = 15m;
    private decimal _shippingHeightCm = 10m;
    private bool IsLeadTimeLoading => LeadTimeOptions.Count == 0 && Parts.Any(p => p.PricingLoading);
    private string LeadTimeEmptyText => Parts.Count == 0
        ? "Configure a part to calculate lead time."
        : "Complete the part configuration to calculate lead time.";

    private async Task HandleGeneratePdfAsync()
    {
        _generatingPdf = true;
        StateHasChanged();
        try
        {
            await OnGeneratePdf.InvokeAsync();
        }
        finally
        {
            _generatingPdf = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        CurrencyService.Changed += OnCurrencyChanged;
        _shippingToPostcode = ShippingDestinationPostalCode ?? "";
        _shippingWeightGrams = Math.Max(1m, Math.Ceiling(Math.Max(TotalWeightKg, 0.001m) * 1000m));
    }

    public void Dispose() => CurrencyService.Changed -= OnCurrencyChanged;

    private void OnCurrencyChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void ToggleDetails() => _detailsOpen = !_detailsOpen;

    private void CloseDetails() => _detailsOpen = false;

    private async Task OnQuotationTermsChanged(string? value) =>
        await QuotationTermsChanged.InvokeAsync(value);

    private async Task FetchCourierRatesAsync()
    {
        _shippingToPostcode = FirstNonEmpty(_shippingToPostcode, ShippingDestinationPostalCode);
        _shippingWeightGrams = Math.Max(1m, Math.Ceiling(Math.Max(TotalWeightKg, 0.001m) * 1000m));

        var validationError = ValidateShippingRateInputs();
        if (validationError is not null)
        {
            Snackbar.Add(validationError, Severity.Warning);
            return;
        }

        _fetchingRates = true;
        _rateOptions = [];
        StateHasChanged();

        try
        {
            var request = BuildShippingRateRequest();
            var result = await ShippingService.GetRatesAsync(request);
            if (result?.Rates is { Count: > 0 })
            {
                _rateOptions = result.Rates;
            }
            else
            {
                Snackbar.Add("No shipping rates available for this destination.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to fetch shipping rates. Please try again.", Severity.Error);
        }
        finally
        {
            _fetchingRates = false;
            StateHasChanged();
        }
    }

    private ShippingRateRequestDto BuildShippingRateRequest()
    {
        return new ShippingRateRequestDto
        {
            From = new ShippingAddressDto
            {
                Name = "MALIEV",
                Address = "MALIEV",
                District = "Pathum Wan",
                State = "Pathum Wan",
                Province = "Bangkok",
                Postcode = "10400",
                Tel = "020000000"
            },
            To = new ShippingAddressDto
            {
                Name = FirstNonEmpty(_shippingToName, SelectedCustomer?.Name, "Customer"),
                Address = FirstNonEmpty(_shippingToAddress),
                District = FirstNonEmpty(_shippingToDistrict),
                State = FirstNonEmpty(_shippingToState),
                Province = FirstNonEmpty(_shippingToProvince),
                Postcode = FirstNonEmpty(_shippingToPostcode, ShippingDestinationPostalCode),
                Tel = FirstNonEmpty(_shippingToPhone)
            },
            Parcel = new ShippingParcelDto
            {
                Name = "MALIEV quote shipment",
                Weight = Math.Max(1m, _shippingWeightGrams),
                Length = Math.Max(0.1m, _shippingLengthCm),
                Width = Math.Max(0.1m, _shippingWidthCm),
                Height = Math.Max(0.1m, _shippingHeightCm)
            }
        };
    }

    private string? ValidateShippingRateInputs()
    {
        if (string.IsNullOrWhiteSpace(_shippingToPhone) ||
            string.IsNullOrWhiteSpace(_shippingToAddress) ||
            string.IsNullOrWhiteSpace(_shippingToDistrict) ||
            string.IsNullOrWhiteSpace(_shippingToState) ||
            string.IsNullOrWhiteSpace(_shippingToProvince) ||
            string.IsNullOrWhiteSpace(FirstNonEmpty(_shippingToPostcode, ShippingDestinationPostalCode)))
        {
            return "Enter destination phone, address, district, state, province, and postal code before checking courier rates.";
        }

        if (_shippingWeightGrams <= 0 || _shippingLengthCm <= 0 || _shippingWidthCm <= 0 || _shippingHeightCm <= 0)
        {
            return "Enter positive parcel weight and dimensions before checking courier rates.";
        }

        return null;
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;

    private async Task SelectCourierRate(ShippingRateOptionDto rate)
    {
        await ShippingCostChanged.InvokeAsync(rate.TotalPrice);
        _rateOptions = [];
        StateHasChanged();
    }

    private decimal ComputeQuoteTotal()
    {
        var lineSubtotal = Parts.Sum(p => ProjectQuotationPdfMapper.ResolveBaseLineTotal(p) * CurrencyService.ExchangeRate);
        var bulkDiscount = Parts.Sum(p => ProjectQuotationPdfMapper.ResolveBulkDiscount(p) * CurrencyService.ExchangeRate);
        var discount = Math.Min(bulkDiscount + Math.Max(0m, ManualDiscountAmount), lineSubtotal);
        var taxableSubtotal = lineSubtotal - discount + Math.Max(0m, ShippingCost);
        var vat = Math.Round(taxableSubtotal * 0.07m, 2, MidpointRounding.AwayFromZero);
        return taxableSubtotal + vat;
    }

    private string ComputeShipDate()
    {
        if (SelectedLeadTime == null || SelectedLeadTime.MinDays <= 0)
            return "—";
        var days = Math.Max(SelectedLeadTime.MinDays, SelectedLeadTime.MaxDays);
        var shipDate = AddBusinessDays(DateTime.UtcNow.Date, days);
        return shipDate.ToString("MMM d");
    }

    private static string FormatLeadTimeDays(LeadTimeOptionDto leadTime) =>
        leadTime.MaxDays > leadTime.MinDays
            ? $"{leadTime.MinDays} - {leadTime.MaxDays}"
            : leadTime.MinDays.ToString();

    private static DateTime AddBusinessDays(DateTime date, int businessDays)
    {
        var result = date;
        var remaining = businessDays;

        while (remaining > 0)
        {
            result = result.AddDays(1);
            if (result.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                continue;

            remaining--;
        }

        return result;
    }
}
