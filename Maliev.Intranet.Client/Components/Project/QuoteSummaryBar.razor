@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Pages
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared.Dtos
@inject CurrencyService CurrencyService
@inject ShippingService ShippingService
@inject ISnackbar Snackbar
@implements IDisposable

@* The quote total stays visible even without a selected customer — only the
   final Quote action requires one. The PDF action produces a preliminary
   quote that works without a customer. *@
<div class="qsb-root qsb-root--has-customer">
    @{
        @* ── Zone 2: Total + Actions ──────────────────────────────────────────── *@
    }
    <div class="qsb-zone-total">
        <div class="qsb-total-top">
            <div class="qsb-total-ships">
                <div class="qsb-zone-label">Quote Total</div>
                <div class="qsb-ships-by">
                    Ships by&nbsp;
                    @if (LeadTimeOptions.Count == 0 && IsLeadTimeLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="48px" Style="display:inline-block;" />
                    }
                    else
                    {
                        <span class="qsb-ship-date">@ComputeShipDate()</span>
                    }
                </div>
            </div>
            @if (Parts.Any(p => p.PricingLoading))
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="36px" />
            }
            else
            {
                var total = ComputeQuoteTotal();
                <div class="qsb-total-amount">
                    @if (total == 0 && Parts.Count == 0)
                    {
                        <span>—</span>
                    }
                    else if (CurrencyService.IsConverting)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="18px" />
                    }
                    else
                    {
                        @($"{CurrencyService.Symbol} {total:N2}")
                    }
                </div>
            }
        </div>
        <div class="qsb-actions">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.EditNote"
                       OnClick="ToggleDetails"
                       Class="@($"qsb-btn-details {(_detailsOpen ? "qsb-btn-details--active" : "")}")">
                Details
            </MudButton>
            @* Preliminary quote PDF works without a customer. *@
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.PictureAsPdf"
                       Disabled="@(Parts.Count == 0 || _generatingPdf)"
                       OnClick="@HandleGeneratePdfAsync"
                       Class="qsb-btn-pdf">
                @if (_generatingPdf)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                PDF
            </MudButton>
            <MudTooltip Text="@(SelectedCustomer == null ? "Select a customer to create the quote" : null)"
                        Disabled="@(SelectedCustomer != null)">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@(!CanQuote || Parts.Count == 0 || Saving || SelectedCustomer == null)"
                           OnClick="@OnQuote"
                           Class="qsb-btn-checkout">
                    @if (Saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Quote
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                </MudButton>
            </MudTooltip>
        </div>
        @if (_detailsOpen)
        {
            <button type="button"
                    class="qsb-details-click-away"
                    aria-label="Close quote details"
                    @onclick="CloseDetails"></button>
            <div class="qsb-details-popover">
                <div class="qsb-details-header">
                    <div class="qsb-details-heading">
                        <div class="qsb-zone-label qsb-details-title">
                            <MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" />
                            Quote Details
                        </div>
                        <div class="qsb-details-subtitle">Commercial adjustments</div>
                    </div>
                    <button type="button" class="qsb-details-close" title="Close quote details" @onclick="ToggleDetails">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
                <div class="qsb-adjustment-grid">
                    <section class="qsb-adjustment-card qsb-adjustment-card--shipping" aria-label="Shipping adjustment">
                        <div class="qsb-adjustment-top">
                            <span class="qsb-adjustment-icon">
                                <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                            </span>
                            <span class="qsb-adjustment-copy">
                                <span class="qsb-adjustment-name">Shipping</span>
                                <span class="qsb-adjustment-hint">Freight, courier, or delivery charge</span>
                            </span>
                        </div>
                        <div class="qsb-money-entry">
                            <CurrencyInput Label="Shipping"
                                           HelperText="Freight, courier, or delivery charge"
                                           @bind-ThbValue="ShippingCost"
                                           Min="0m" />
                        </div>
                        <div class="qsb-shipping-entry-grid">
                            <MudTextField T="string" Label="Recipient" @bind-Value="_shippingToName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="Phone" @bind-Value="_shippingToPhone" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="Address" @bind-Value="_shippingToAddress" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="District" @bind-Value="_shippingToDistrict" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="State" @bind-Value="_shippingToState" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="Province" @bind-Value="_shippingToProvince" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField T="string" Label="Postcode" @bind-Value="_shippingToPostcode" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="decimal" Label="Weight (g)" @bind-Value="_shippingWeightGrams" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1m" />
                            <MudNumericField T="decimal" Label="L (cm)" @bind-Value="_shippingLengthCm" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" />
                            <MudNumericField T="decimal" Label="W (cm)" @bind-Value="_shippingWidthCm" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" />
                            <MudNumericField T="decimal" Label="H (cm)" @bind-Value="_shippingHeightCm" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" />
                        </div>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Outlined.LocalShipping"
                                   OnClick="FetchCourierRatesAsync"
                                   Disabled="_fetchingRates"
                                   FullWidth="true">
                            @if (_fetchingRates)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Get Courier Rates
                        </MudButton>
                        @if (_rateOptions.Count > 0 && !_fetchingRates)
                        {
                            <div class="qsb-rate-options">
                                @foreach (var rate in _rateOptions)
                                {
                                    <button type="button"
                                            class="qsb-rate-option"
                                            @onclick="@(() => SelectCourierRate(rate))">
                                        <span class="qsb-rate-name">@rate.ProductName</span>
                                        <span class="qsb-rate-price">@rate.TotalPrice.ToString("N0") @rate.CurrencyCode</span>
                                        @if (!string.IsNullOrWhiteSpace(rate.EstimatedDeliveryDate))
                                        {
                                            <span class="qsb-rate-edd">@rate.EstimatedDeliveryDate</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </section>
                    <section class="qsb-adjustment-card qsb-adjustment-card--discount" aria-label="Discount adjustment">
                        <div class="qsb-adjustment-top">
                            <span class="qsb-adjustment-icon">
                                <MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" />
                            </span>
                            <span class="qsb-adjustment-copy">
                                <span class="qsb-adjustment-name">Discount</span>
                                <span class="qsb-adjustment-hint">Manual reduction before VAT</span>
                            </span>
                        </div>
                        <div class="qsb-money-entry">
                            <CurrencyInput Label="Discount"
                                           HelperText="Manual reduction before VAT"
                                           @bind-ThbValue="ManualDiscountAmount"
                                           Min="0m" />
                        </div>
                    </section>
                </div>
                <section class="qsb-terms-panel" aria-label="Quote terms">
                    <div class="qsb-terms-heading">
                        <span class="qsb-adjustment-icon qsb-terms-icon">
                            <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                        </span>
                        <span>
                            <span class="qsb-adjustment-name">Terms</span>
                            <span class="qsb-adjustment-hint">Payment, validity, and delivery conditions</span>
                        </span>
                    </div>
                    <MudTextField T="string"
                                  Label="Terms"
                                  Value="@QuotationTerms"
                                  ValueChanged="OnQuotationTermsChanged"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Lines="4"
                                  FullWidth="true"
                                  Class="qsb-terms-field" />
                </section>
            </div>
        }
    </div>
</div>

<style>
    .qsb-root {
        display: flex;
        align-items: stretch;
        background: var(--maliev-panel);
        border-top: 1px solid var(--maliev-border);
        flex-shrink: 0;
        overflow: visible;
    }

    /* ── Quote total: always visible ──────────────────────────────────────── */
    .qsb-root--has-customer {
        display: flex;
        flex-direction: column;
    }

    .qsb-root--has-customer .qsb-zone-total {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 4px;
        width: 340px;
        padding: 8px 16px 10px;
        position: relative;
    }

    .qsb-divider {
        width: 1px;
        background: var(--maliev-border);
        flex-shrink: 0;
    }

    .qsb-zone-label {
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--maliev-muted);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 6px;
        font-family: 'Inter', sans-serif;
    }

    /* ── Zone 1: Lead Time ────────────────────────────────────────────────── */
    .qsb-zone-lead {
        flex: 1;
        padding: 10px 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

    .qsb-lead-options {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: stretch;
    }

    .qsb-lead-btn {
        flex: 1;
        min-width: 140px;
        padding: 6px 10px;
        border: 1px solid var(--maliev-border);
        background: transparent;
        border-radius: 5px;
        cursor: pointer;
        text-align: left;
        transition: all 0.15s;
        color: var(--maliev-ink);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 1px;
        font-family: inherit;
    }

    .qsb-lead-skeleton {
        flex: 1;
        min-width: 140px;
    }

    .qsb-lead-btn:hover {
        background: var(--maliev-panel-3);
    }

    .qsb-lead-btn--active {
        background: color-mix(in oklch, var(--mud-palette-primary) 12%, transparent);
        border-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary);
    }

    .qsb-lead-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        width: 100%;
        gap: 6px;
    }

    .qsb-lead-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
        font-weight: 600;
    }

    .qsb-lead-mult {
        font-size: 10px;
        color: var(--maliev-muted);
        font-family: 'JetBrains Mono', monospace;
    }

    .qsb-lead-btn--active .qsb-lead-mult {
        color: var(--mud-palette-primary);
    }

    .qsb-lead-days {
        font-size: 10.5px;
        color: var(--maliev-muted);
        font-family: 'JetBrains Mono', monospace;
        margin-top: 1px;
    }

    .qsb-bd-short {
        display: none;
    }

    .qsb-lead-btn--active .qsb-lead-days {
        color: var(--maliev-ink);
        font-weight: 600;
    }

    .qsb-lead-empty {
        width: 100%;
        min-height: 52px;
        display: flex;
        align-items: center;
        color: var(--maliev-muted);
        font-size: 12px;
    }

    /* ── Zone 2: Total + Actions ─────────────────────────────────────────── */
    .qsb-zone-total {
        width: 340px;
        padding: 8px 16px 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 4px;
        position: relative;
    }

    .qsb-total-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .qsb-total-ships {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .qsb-ships-by {
        font-size: 10.5px;
        color: var(--maliev-muted);
    }

    .qsb-ship-date {
        font-weight: 600;
        color: var(--maliev-ink);
        font-family: 'JetBrains Mono', monospace;
    }

    .qsb-total-amount {
        font-size: 26px;
        font-weight: 700;
        color: var(--maliev-ink);
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.02em;
    }

    .qsb-actions {
        display: flex;
        gap: 6px;
    }

    .qsb-btn-details {
        padding: 0 10px;
        height: 32px;
        border: 1px solid var(--maliev-border) !important;
        border-radius: 5px !important;
        font-size: 12px;
        font-weight: 600;
        color: var(--maliev-muted) !important;
        flex: 0 0 auto;
    }

    .qsb-btn-details--active {
        border-color: var(--mud-palette-primary) !important;
        color: var(--mud-palette-primary) !important;
        background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent) !important;
    }

    .qsb-btn-pdf {
        padding: 0 12px;
        height: 32px;
        border: 1px solid var(--maliev-border) !important;
        border-radius: 5px !important;
        font-size: 12px;
        font-weight: 600;
        color: var(--maliev-muted) !important;
    }

    .qsb-btn-checkout {
        flex: 1;
        height: 32px;
        border-radius: 5px !important;
        font-size: 13px;
        font-weight: 600;
    }

    .qsb-details-click-away {
        position: fixed;
        inset: 0;
        z-index: 19;
        border: 0;
        padding: 0;
        background: transparent;
        cursor: default;
    }

    .qsb-details-popover {
        position: absolute;
        right: 16px;
        bottom: calc(100% + 8px);
        z-index: 20;
        width: min(460px, calc(100vw - 32px));
        padding: 0;
        overflow: hidden;
        background:
            linear-gradient(180deg, color-mix(in oklch, var(--mud-palette-primary) 8%, var(--maliev-panel)) 0%, var(--maliev-panel) 42%),
            var(--maliev-panel);
        border: 1px solid color-mix(in oklch, var(--mud-palette-primary) 24%, var(--maliev-border));
        border-radius: 8px;
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.18);
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .qsb-details-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 14px 10px;
        border-bottom: 1px solid color-mix(in oklch, var(--mud-palette-primary) 14%, var(--maliev-border));
    }

    .qsb-details-heading {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .qsb-details-title {
        margin-bottom: 0;
    }

    .qsb-details-subtitle {
        color: var(--maliev-muted);
        font-size: var(--mud-typography-caption-size);
        font-weight: 500;
        letter-spacing: 0;
    }

    .qsb-details-close {
        width: 26px;
        height: 26px;
        display: grid;
        place-items: center;
        border: 1px solid transparent;
        border-radius: 5px;
        background: transparent;
        color: var(--maliev-muted);
        cursor: pointer;
    }

    .qsb-details-close:hover {
        background: var(--maliev-panel-3);
        color: var(--maliev-ink);
    }

    .qsb-adjustment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        padding: 12px;
    }

    .qsb-adjustment-card,
    .qsb-terms-panel {
        border: 1px solid var(--maliev-border);
        border-radius: 8px;
        background: var(--maliev-panel-2);
    }

    .qsb-adjustment-card {
        min-width: 0;
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .qsb-adjustment-card--shipping {
        border-color: color-mix(in oklch, var(--mud-palette-info) 28%, var(--maliev-border));
        background: color-mix(in oklch, var(--mud-palette-info) 7%, var(--maliev-panel));
    }

    .qsb-adjustment-card--discount {
        border-color: color-mix(in oklch, var(--mud-palette-success) 26%, var(--maliev-border));
        background: color-mix(in oklch, var(--mud-palette-success) 7%, var(--maliev-panel));
    }

    .qsb-adjustment-top,
    .qsb-terms-heading {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
    }

    .qsb-adjustment-icon {
        width: 30px;
        height: 30px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 7px;
        color: var(--mud-palette-primary);
        background: color-mix(in oklch, var(--mud-palette-primary) 10%, var(--maliev-panel));
        border: 1px solid color-mix(in oklch, var(--mud-palette-primary) 18%, transparent);
    }

    .qsb-adjustment-card--shipping .qsb-adjustment-icon {
        color: var(--mud-palette-info);
        background: color-mix(in oklch, var(--mud-palette-info) 12%, var(--maliev-panel));
        border-color: color-mix(in oklch, var(--mud-palette-info) 20%, transparent);
    }

    .qsb-adjustment-card--discount .qsb-adjustment-icon {
        color: var(--mud-palette-success);
        background: color-mix(in oklch, var(--mud-palette-success) 12%, var(--maliev-panel));
        border-color: color-mix(in oklch, var(--mud-palette-success) 20%, transparent);
    }

    .qsb-adjustment-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .qsb-adjustment-name {
        display: block;
        color: var(--maliev-ink);
        font-size: var(--mud-typography-body2-size);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: 0;
    }

    .qsb-adjustment-hint {
        display: block;
        color: var(--maliev-muted);
        font-size: var(--mud-typography-caption-size);
        line-height: 1.25;
        letter-spacing: 0;
    }

    .qsb-money-entry {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        min-width: 0;
    }

    .qsb-money-prefix {
        height: 40px;
        min-width: 40px;
        padding: 0 8px;
        display: grid;
        place-items: center;
        border: 1px solid var(--maliev-border);
        border-radius: 6px;
        background: var(--maliev-panel);
        color: var(--maliev-ink);
        font-family: 'JetBrains Mono', monospace;
        font-size: var(--mud-typography-body2-size);
        font-weight: 700;
        letter-spacing: 0;
    }

    .qsb-money-entry ::deep .mud-input-control {
        flex: 1 1 auto;
        min-width: 0;
    }

    .qsb-terms-panel {
        margin: 0 12px 12px;
        padding: 10px;
        border-color: color-mix(in oklch, var(--mud-palette-warning) 24%, var(--maliev-border));
        background: color-mix(in oklch, var(--mud-palette-warning) 7%, var(--maliev-panel));
    }

    .qsb-terms-heading {
        margin-bottom: 10px;
    }

    .qsb-terms-icon {
        color: var(--mud-palette-warning);
        background: color-mix(in oklch, var(--mud-palette-warning) 12%, var(--maliev-panel));
        border-color: color-mix(in oklch, var(--mud-palette-warning) 20%, transparent);
    }

    .qsb-details-popover ::deep .mud-input-control {
        margin-top: 0;
        margin-bottom: 0;
    }

    .qsb-details-popover ::deep .mud-input-slot {
        font-size: 12px;
    }

    .qsb-details-popover ::deep textarea {
        min-height: 84px !important;
        line-height: 1.35;
        resize: vertical;
    }

    @@media (max-width: 1400px) {
        .qsb-root {
            height: auto;
            flex-wrap: wrap;
            padding: 0;
            gap: 0;
        }
        .qsb-zone-customer {
            max-width: none;
            flex: 0 1 280px;
            padding: 10px 16px;
        }
        .qsb-zone-lead {
            flex: 1 1 420px;
            min-width: 420px;
            padding: 10px 16px;
        }
        .qsb-zone-total {
            width: 330px;
            padding: 8px 16px 10px;
        }
    }

    @@media (max-width: 900px) {
        .qsb-zone-customer {
            flex: 1 1 260px;
        }
        .qsb-zone-lead {
            order: 3;
            flex: 1 0 100%;
            min-width: 0;
            border-top: 1px solid var(--maliev-border);
        }
        .qsb-zone-total {
            flex: 1 1 320px;
            width: auto;
        }
        .qsb-details-popover {
            right: 16px;
        }
    }

    @@media (max-width: 600px) {
        .qsb-root {
            flex-direction: column;
            align-items: stretch;
            flex-wrap: nowrap;
            padding: 14px 12px;
            gap: 14px;
        }
        .qsb-divider {
            display: none;
        }
        .qsb-zone-customer,
        .qsb-zone-lead,
        .qsb-zone-total {
            flex: 0 0 auto;
            width: 100%;
            max-width: none;
            min-width: 0;
            padding: 0;
        }
        .qsb-zone-customer {
            flex: 0 0 auto;
        }
        .qsb-zone-lead,
        .qsb-zone-total {
            padding-top: 12px;
            border-top: 1px solid var(--maliev-border);
        }
        .qsb-zone-label {
            margin-bottom: 8px;
            font-size: 11px;
        }
        .qsb-zone-customer .customer-picker-trigger {
            height: 52px;
            min-height: 52px;
            padding: 0 14px;
            gap: 9px;
            border-radius: 7px;
            font-size: 13px;
        }
