@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos
@using Maliev.MessagingContracts.Contracts.Geometry
@using MudBlazor

<div class="dfm-tab-root">
    <div class="dfm-tab-container">
    @* ── Header ── *@
    <div class="dfm-header">
        <div class="dfm-header-top">
            <span class="dfm-title">Design for Manufacturability</span>
            @if (!string.IsNullOrEmpty(Part.ProcessCode))
            {
                <div class="dfm-badge @(AnalysisFailed ? "dfm-badge--error" : AllPassed ? "dfm-badge--ok" : FailedCount > 0 ? "dfm-badge--warn" : "dfm-badge--warn")">
                    <MudIcon Icon="@(AnalysisFailed ? Icons.Material.Filled.Error : AllPassed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                             Color="@(AnalysisFailed ? Color.Error : AllPassed ? Color.Success : Color.Warning)"
                             Size="Size.Small" Class="dfm-badge-icon" />
                    <span>@(AnalysisFailed ? "Analysis failed" : $"{PassedCount}/{TotalCount} checks passed")</span>
                </div>
            }
        </div>
        <div class="dfm-caption">Automated analysis against shop-floor tooling library. No sign-off required.</div>
    </div>

    @* ── Checks list ── *@
    <div class="dfm-checks-list">
        @if (AnalysisFailed)
        {
            <MudAlert Severity="Severity.Error" Class="ma-3">
                @DfmStatusMessages.GetFriendlyMessage(Part.AnalysisErrorCode)
                @if (Part.AnalysisErrorCode != "FILE_MISSING")
                {
                    <span> Select the process again to retry.</span>
                }
            </MudAlert>
        }
        else
        {
        @* Pending checks render as skeleton rows above the expansion panels *@
        @foreach (var check in Checks.Where(c => GetCheckState(c.Category) == DfmCheckState.Pending))
        {
            <div @key="@($"skeleton-{check.Category}")" class="dfm-check-row--skeleton">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="20px" Height="20px" />
                <div style="flex:1;">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" />
                </div>
            </div>
        }
        <MudExpansionPanels MultiExpansion="true" Dense="true" Elevation="0" Class="dfm-expansions">
            @foreach (var check in Checks.Where(c => GetCheckState(c.Category) != DfmCheckState.Pending))
            {
                var isFailed = GetCheckState(check.Category) == DfmCheckState.Failed;
                var detail = GetCheckDetail(check);
                <MudExpansionPanel @key="@($"check-{check.Category}")"
                                   Expanded="@isFailed"
                                   Class="@($"dfm-expansion-panel {(isFailed ? "dfm-expansion-panel--fail" : "dfm-expansion-panel--pass")}")">
                    <TitleContent>
                        <div class="dfm-panel-header">
                            @if (isFailed)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Style="flex-shrink:0;margin-top:1px;" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="flex-shrink:0;margin-top:1px;" />
                            }
                            <div class="dfm-panel-text">
                                <span class="dfm-panel-title">@check.Label</span>
                                <span class="dfm-panel-summary">@(isFailed ? detail.FailSummary : GetPassSummary(check))</span>
                            </div>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (isFailed)
                        {
                            <div class="dfm-detail-body">
                                <div class="dfm-detail-section">
                                    <div class="dfm-detail-section-label">Description</div>
                                    <div class="dfm-detail-desc">@detail.Description</div>
                                </div>
                                @if (!string.IsNullOrEmpty(detail.MeasuredLabel))
                                {
                                    <div class="dfm-detail-section">
                                        <div class="dfm-detail-section-label">Why it failed</div>
                                        <div class="dfm-measure-grid">
                                            <span class="dfm-measure-label">Detected</span>
                                            <span class="dfm-measure-value dfm-measure-value--fail">@detail.MeasuredLabel</span>
                                            @if (!string.IsNullOrEmpty(detail.RecommendedLabel))
                                            {
                                                <span class="dfm-measure-label">Recommended</span>
                                                <span class="dfm-measure-value">@detail.RecommendedLabel</span>
                                            }
                                        </div>
                                    </div>
                                }
                                @if (detail.Fixes.Count > 0)
                                {
                                    <div class="dfm-detail-section">
                                        <div class="dfm-detail-section-label">How to fix</div>
                                        <ul class="dfm-fix-list">
                                            @foreach (var fix in detail.Fixes)
                                            {
                                                <li class="dfm-fix-item">
                                                    <div class="dfm-fix-bullet"></div>
                                                    <span>@fix</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dfm-pass-detail-body">
                                <div class="dfm-detail-desc">@GetPassDetail(check)</div>
                            </div>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        }

        @* No-process notice shown when no manufacturing process is selected *@
        @if (string.IsNullOrEmpty(Part.ProcessCode))
        {
            <div class="dfm-process-notice">
                <MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" Color="Color.Default" />
                <span>Select a manufacturing process to run process-specific checks (thin walls, overhangs, etc.)</span>
            </div>
        }
    </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PartViewModel Part { get; set; } = null!;

    private enum DfmCheckState { Pending, Passed, Failed }

    private record CheckDef(string Category, string Label);

    private record CheckDetail(
        string Description,
        string FailSummary,
        string? MeasuredLabel,
        string? RecommendedLabel,
        List<string> Fixes);

    // Process-agnostic Phase 1 checks — always shown regardless of process selection.
    private static readonly IReadOnlyList<CheckDef> IntrinsicChecks =
    [
        new("non_manifold", "Mesh integrity"),
        new("multi_body",   "Single body"),
    ];

    private static readonly IReadOnlyList<CheckDef> FdmChecks =
    [
        new("thin_wall",    "Thin walls"),
        new("overhang",     "Overhangs / supports"),
        new("small_feature","Small features"),
        new("bridge",       "Bridge length"),
    ];

    private static readonly IReadOnlyList<CheckDef> CncChecks =
    [
        new("internal_radius","Internal radii"),
        new("undercut",       "Undercuts"),
        new("drill_hole",     "Drill holes"),
        new("edm",            "EDM required"),
        new("grinding",       "Surface grinding"),
    ];

    private static readonly IReadOnlyList<CheckDef> SlaChecks =
    [
        new("thin_wall",     "Thin walls"),
        new("escape_hole",   "Resin drainage"),
        new("overhang",      "Suction risk"),
        new("hollow",        "Hollow regions"),
    ];

    // Process-specific checks (intrinsic categories excluded — rendered separately above).
    private IReadOnlyList<CheckDef> ProcessChecks => Part.ProcessCode?.ToUpperInvariant() switch
    {
        "CNC" or "CNC_MILL" or "CNC_TURN" => CncChecks,
        "SLA" or "SLA_DLP" or "DLP"       => SlaChecks,
        _                                  => FdmChecks,
    };

    // Combined set for header badge counts and unified rendering.
    private IEnumerable<CheckDef> Checks =>
        string.IsNullOrEmpty(Part.ProcessCode)
            ? IntrinsicChecks
            : IntrinsicChecks.Concat(ProcessChecks);

    // ── Per-check state (tri-state: Pending / Passed / Failed) ────────

    private DfmCheckState GetCheckState(string category) => category switch
    {
        "non_manifold" => Part.IsManifold is null
                            ? DfmCheckState.Pending
                            : Part.IsManifold == false
                                ? DfmCheckState.Failed
                                : DfmCheckState.Passed,
        "multi_body"   => Part.BodyCount is null
                            ? DfmCheckState.Pending
                            : Part.BodyCount > 1
                                ? DfmCheckState.Failed
                                : DfmCheckState.Passed,
        _ => Part.DfmReport is null
                ? DfmCheckState.Pending
                : IsProcessCheckFailed(category)
                    ? DfmCheckState.Failed
                    : DfmCheckState.Passed,
    };

    private bool IsProcessCheckFailed(string category) => (category, Part.DfmReport) switch
    {
        ("thin_wall",       FdmDfmReportPayload fdm) => fdm.ThinWallCount > 0,
        ("overhang",        FdmDfmReportPayload fdm) => fdm.OverhangFaceCount > 0 || fdm.SupportRequired,
        ("small_feature",   FdmDfmReportPayload fdm) => fdm.SmallDetailCount > 0,
        ("thin_wall",       SlaDfmReportPayload sla) => sla.ThinWallCount > 0,
        ("escape_hole",     SlaDfmReportPayload sla) => sla.ResinTrappingRisk,
        ("overhang",        SlaDfmReportPayload sla) => sla.SuctionRisk,
        ("hollow",          SlaDfmReportPayload sla) => sla.HollowRegions?.Count > 0,
        ("internal_radius", CncDfmReportPayload cnc) => cnc.SharpCornerCount > 0,
        ("undercut",        CncDfmReportPayload cnc) => cnc.HasUndercuts,
        ("drill_hole",      CncDfmReportPayload cnc) => cnc.HasDrillHoles && cnc.DrillHoleCount > 0,
        ("edm",             CncDfmReportPayload cnc) => cnc.RequiresEdm,
        ("grinding",        CncDfmReportPayload cnc) => cnc.RequiresGrinding,
        // Fallback for DfmReport DTO (from HTTP on-demand analysis path).
        // When the report comes through the two-phase DFM endpoint, it's a DfmReport DTO
        // rather than a typed payload — match by issue category.
        (_, DfmReport dto) => dto.Issues.Any(i => string.Equals(i.Category, category, StringComparison.OrdinalIgnoreCase)),
        _ => false,
    };

    // ── Header counts ─────────────────────────────────────────────────

    private int TotalCount   => Checks.Count();
    private int FailedCount  => Checks.Count(ch => GetCheckState(ch.Category) == DfmCheckState.Failed);
    private int PendingCount => Checks.Count(ch => GetCheckState(ch.Category) == DfmCheckState.Pending);
    private int PassedCount  => TotalCount - FailedCount - PendingCount;
    private bool AnalysisFailed => Part.DfmAnalysisTimedOut || Part.AnalysisErrorCode == "FILE_MISSING";
    private bool AllPassed => !AnalysisFailed && PendingCount == 0 && FailedCount == 0;

    // ── Pass-state text (data-driven, replaces static PassDescription) ─

    private string GetPassSummary(CheckDef check) => check.Category switch
    {
        "non_manifold"   => "Mesh is manifold (watertight)",
        "multi_body"     => $"Single solid body",
        "thin_wall"      => "Wall thicknesses within limits",
        "overhang"       => Part.ProcessCode?.ToUpperInvariant() is "SLA" or "SLA_DLP" or "DLP"
                                ? "No suction risk detected"
                                : "No overhangs exceed printable angle",
        "small_feature"  => "All details above resolution limit",
        "bridge"         => "Bridge spans within unsupported limits",
        "escape_hole"    => "No enclosed cavities",
        "hollow"         => "No hollow regions detected",
        "internal_radius"=> "All corners compatible with end mills",
        "undercut"       => "No undercut features",
        "drill_hole"     => "Hole geometry compatible with standard drills",
        "edm"            => "No EDM-required features",
        "grinding"       => "No grinding-required surfaces",
        _                => "Check passed",
    };

    private string GetPassDetail(CheckDef check) => check.Category switch
    {
        "non_manifold" => "Mesh is watertight — no open boundary edges, non-manifold edges, or holes detected.",
        "multi_body"   => $"File contains {Part.BodyCount ?? 1} solid body — single-body geometry confirmed.",
        "thin_wall" when Part.DfmReport is FdmDfmReportPayload =>
            "No thin walls detected. All wall thicknesses are ≥ 1.2 mm (FDM printable limit).",
        "thin_wall" when Part.DfmReport is SlaDfmReportPayload =>
            "No thin walls detected. All wall thicknesses are ≥ 0.5 mm (SLA resin printable limit).",
        "overhang" when Part.DfmReport is FdmDfmReportPayload fdm =>
            fdm.OverhangFaceCount == 0
                ? "No overhanging faces detected. Part is self-supporting without support structures."
                : $"{fdm.OverhangFaceCount} overhang region(s) detected, but all are within the ≤ 45° self-supporting limit.",
        "overhang" when Part.DfmReport is SlaDfmReportPayload =>
            "No large flat surfaces at risk of suction during SLA peeling.",
        "small_feature" when Part.DfmReport is FdmDfmReportPayload fdm =>
            fdm.SmallDetailCount == 0
                ? "No features below the FDM resolution limit (≥ 0.4 mm) detected."
                : $"All {fdm.SmallDetailCount} fine detail(s) are within printable resolution.",
        "bridge"         => "All bridge spans are within the self-supporting limit (≤ 50 mm for FDM).",
        "escape_hole"    => "No enclosed cavities detected — resin drainage is unobstructed.",
        "hollow"         => "No hollow regions detected inside the part.",
        "internal_radius" when Part.DfmReport is CncDfmReportPayload cnc =>
            cnc.SharpCornerCount == 0
                ? "All internal corners have adequate radius for standard end mill tooling."
                : $"0 sharp corners detected — all corners are within tolerance.",
        "undercut"       => "No undercut features detected. Part is accessible by standard 3-axis CNC tooling.",
        "drill_hole" when Part.DfmReport is CncDfmReportPayload cnc =>
            cnc.HasDrillHoles && cnc.DrillHoleCount > 0
                ? $"{cnc.DrillHoleCount} drill hole(s) detected — all compatible with standard drill sizes."
                : "No drill holes detected.",
        "edm"            => "No features requiring EDM detected. All geometry is accessible by conventional cutting.",
        "grinding"       => "No surfaces requiring grinding detected. Standard machined finish is sufficient.",
        _                => GetPassSummary(check),
    };

    // ── Fail detail ───────────────────────────────────────────────────

    private CheckDetail GetCheckDetail(CheckDef check) => check.Category switch
    {
        "thin_wall" => BuildThinWallDetail(),
        "overhang" when Part.ProcessCode?.ToUpperInvariant() is "SLA" or "SLA_DLP" or "DLP" => new CheckDetail(
            "Large flat horizontal surfaces create a suction force during the peeling step of SLA printing, which can distort or detach the part from the build plate.",
            "Suction risk on large flats",
            "Flat surface area at risk", "Add tilt or drainage cutouts",
            ["Tilt the part 10–15° to reduce peel force", "Add small drainage/relief holes to large flat surfaces", "Discuss orientation with your engineer"]),
        "overhang" => BuildOverhangDetail(),
        "small_feature" => new CheckDetail(
            "Fine details smaller than the printer's minimum feature resolution may not reproduce accurately, resulting in missing or distorted geometry.",
            GetThinWallFailSummary() ?? "Fine details detected",
            null, null,
            ["Increase minimum feature size to ≥ 0.4 mm for FDM", "Consider SLA/SLS for higher resolution", "Simplify small decorative details"]),
        "non_manifold" => new CheckDetail(
            "A manifold (watertight) mesh has no holes, duplicate faces, or self-intersections. Non-manifold geometry can cause slicing failures or machining errors.",
            "Mesh has geometry issues",
            "Non-manifold edges or holes detected", "Manifold (zero errors)",
            ["Use mesh repair tools (Meshmixer, Netfabb, or PrusaSlicer)", "Check for intersecting bodies and Boolean them together", "Fill any holes or open edges before export"]),
        "multi_body" => new CheckDetail(
            "Most additive processes expect a single contiguous solid body per file. Multiple disconnected bodies may not print correctly or may be costed as separate parts.",
            $"{Part.BodyCount} bodies found",
            $"{Part.BodyCount} separate bodies", "1 body",
            ["Merge all bodies into one solid before export", "Upload each body as a separate part", "Use a Boolean Union operation in your CAD tool"]),
        "escape_hole" => new CheckDetail(
            "Enclosed cavities trap liquid resin during SLA printing. If uncured resin is trapped inside the part it can crack the part or cause print failure.",
            "Enclosed cavities detected",
            "Resin escape holes missing", "≥ 2 mm drainage holes",
            ["Add drainage holes (≥ 2 mm diameter) to enclosed cavities", "Orient the part so cavities face downward", "Consider redesigning hollow regions as open pockets"]),
        "hollow" => new CheckDetail(
            "Hollow regions inside a resin print can trap liquid resin, leading to internal pressure, cracking, or uncured material affecting structural integrity.",
            "Hollow regions without drainage",
            "Hollow regions detected", "Open or drained cavities",
            ["Add 2 mm drainage holes at the lowest print point", "Fill hollow regions if structural", "Re-orient so drainage is natural during printing"]),
        "internal_radius" => new CheckDetail(
            "CNC end mills are cylindrical, so they cannot cut perfectly sharp internal corners. The minimum internal radius equals at least half the tool diameter.",
            "Sharp corners incompatible with end mills",
            $"{(Part.DfmReport is CncDfmReportPayload c ? c.SharpCornerCount : 0)} sharp corner(s)", "Radius ≥ tool radius",
            ["Add fillet radius ≥ 1 mm to all internal corners", "Specify the acceptable corner radius in your drawing", "Use undercut relief (\"dogbone\") cutouts to accommodate tool geometry"]),
        "undercut" => new CheckDetail(
            "Undercut features — geometry hidden from a straight cutting path — require special tooling such as T-slot cutters, EDM, or multi-axis strategies.",
            "Undercut features need special tooling",
            "Undercuts detected", "Accessible by 3-axis CNC",
            ["Redesign undercut geometry as open pockets where possible", "Split the part and machine in multiple setups", "Accept EDM or 5-axis machining — it will be reflected in the quote"]),
        "drill_hole" => new CheckDetail(
            "Drill holes should align with standard drill bit sizes for reliable, cost-effective machining. Non-standard diameters require custom end-mill plunging.",
            "Drill holes detected",
            $"{(Part.DfmReport is CncDfmReportPayload cnc ? cnc.DrillHoleCount : 0)} hole(s) to machine", "Standard drill size preferred",
            ["Specify hole tolerances on drawing (H7 for fits, free for clearance)", "Align diameters to standard drill sizes where possible", "Add thread callouts if threaded holes are needed"]),
        "edm" => new CheckDetail(
            "Electrical Discharge Machining (EDM) is required for very narrow slots, blind cavities, or hard materials that conventional cutting cannot reach.",
            "EDM required for internal geometry",
            "EDM-only features detected", "Conventional CNC accessible",
            ["Widen slots to ≥ 1 mm to allow end-mill access", "Replace blind cavities with through-features where functional", "Accept EDM processing — it will be quoted separately"]),
        "grinding" => new CheckDetail(
            "CNC milling leaves a Ra 1.6–3.2 µm surface finish. Tighter tolerances or smoother surfaces (Ra < 0.8 µm) require surface grinding.",
            "Grinding required for tight tolerances",
            "Ground surfaces required", "Ra ≤ 0.8 µm or IT6 tolerance",
            ["Specify tolerances only where functionally necessary", "Use H7/h6 fits rather than tighter unless required", "Accept grinding operation — add to drawing notes"]),
        "bridge" => new CheckDetail(
            "FDM can print short unsupported spans (bridges) up to ~50–80 mm depending on material and settings. Longer bridges sag during printing.",
            "Bridge span may sag without support",
            "Long bridge span detected", "≤ 50 mm unsupported",
            ["Add a mid-span support column if the bridge is structural", "Orient the print so the bridge is minimized", "Accept support material under long bridges"]),
        _ => new CheckDetail(GetPassSummary(check), "Issue detected", null, null, []),
    };

    private string? BuildThinWallDetail_FailSummary() =>
        Part.DfmReport switch
        {
            FdmDfmReportPayload fdm => $"{fdm.ThinWallCount} thin region(s)",
            SlaDfmReportPayload sla => $"{sla.ThinWallCount} thin region(s)",
            _ => "Thin walls detected"
        };

    private CheckDetail BuildThinWallDetail()
    {
        var processCode = Part.ProcessCode?.ToUpperInvariant() ?? "";
        var isSla = processCode is "SLA" or "SLA_DLP" or "DLP";
        return new CheckDetail(
            isSla
                ? "Walls thinner than the resin printer's minimum may fail to cure correctly, resulting in fragile or missing features."
                : "Walls thinner than the FDM minimum may not extrude reliably, causing weak or missing sections in the printed part.",
            BuildThinWallDetail_FailSummary() ?? "Thin walls detected",
            BuildThinWallDetail_FailSummary(),
            isSla ? "≥ 0.5 mm wall thickness" : "≥ 1.2 mm wall thickness",
            isSla
                ? ["Increase all wall thicknesses to ≥ 0.5 mm", "Use SLS instead of SLA for thin flexible features", "Add internal ribs for stiffness instead of increasing overall wall thickness"]
                : ["Increase wall thickness to ≥ 1.2 mm (preferred ≥ 1.5 mm)", "Use a stiffer material to allow thinner walls", "Add ribs or gussets to maintain stiffness with less material"]);
    }

    private string? GetThinWallFailSummary() =>
        Part.DfmReport switch
        {
            FdmDfmReportPayload fdm => $"{fdm.SmallDetailCount} detail(s) below resolution",
            _ => null
        };

    private CheckDetail BuildOverhangDetail()
    {
        var fdm = Part.DfmReport as FdmDfmReportPayload;
        var summary = fdm?.OverhangFaceCount > 0
            ? $"{fdm.OverhangFaceCount} overhang region(s)"
            : "Support required";
        return new CheckDetail(
            "FDM printers cannot print unsupported material past ~45°. Material beyond this angle needs support structures, which add cost and leave surface marks where removed.",
            summary,
            summary, "≤ 45° self-supporting",
            ["Redesign overhangs to ≤ 45° where possible", "Split the part along the overhang and bond after printing", "Accept support material — it will be quoted and removed"]);
    }
}
