@namespace Maliev.Intranet.Client.Components.Project

<div class="pmc-card @(IsActive ? "pmc-active" : "")" @onclick="OnSelect">
    <div class="pmc-thumb">
        @if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && !Part.PreviewLoadFailed)
        {
            <img src="@Part.ThumbnailSmallUrl" alt="@Part.Name"
                 @onerror="@(() => { Part.PreviewLoadFailed = true; StateHasChanged(); })" />
        }
        else
        {
            <MudIcon Icon="@GetFileIcon(Part.Name)" Size="Size.Medium" Color="Color.Default" />
        }
        @if (Part.IsManifold == false)
        {
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Color="Color.Warning" Class="pmc-badge" />
        }
        else if (!Part.PreviewLoadFailed && !string.IsNullOrEmpty(Part.ThumbnailSmallUrl))
        {
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" Class="pmc-badge" />
        }
    </div>
    <div class="pmc-info">
        <MudTooltip Text="@Part.Name">
            <div class="pmc-name">@Part.Name</div>
        </MudTooltip>
        @if (Part.Dimensions != null)
        {
            <div class="pmc-dim">
                @($"{Part.Dimensions.X:N1} × {Part.Dimensions.Y:N1} × {Part.Dimensions.Z:N1} mm")
                @if (Part.VolumeMm3.HasValue)
                {
                    <text> · @FormatVolume(Part.VolumeMm3.Value)</text>
                }
            </div>
        }
        <div class="pmc-meta">
            <span class="pmc-process-material">
                @if (!string.IsNullOrEmpty(Part.ProcessCode)) { <text>@Part.ProcessCode</text> }
                @if (!string.IsNullOrEmpty(Part.ProcessCode) && !string.IsNullOrEmpty(Part.MaterialCode)) { <text> · </text> }
                @if (!string.IsNullOrEmpty(Part.MaterialCode)) { <text>@Part.MaterialCode</text> }
            </span>
            @if (Part.Quantity > 1)
            {
                <span class="pmc-qty">×@Part.Quantity</span>
            }
        </div>
        <div class="pmc-price">
            @if (Part.PricingLoading) { <MudSkeleton Width="50px" Height="12px" /> }
            else if (Part.EstimatedTotalAmount.HasValue) { <text>@FormatPrice(Part.EstimatedTotalAmount.Value)</text> }
        </div>
    </div>
    @if (Part.Uploading)
    {
        <div class="pmc-progress">
            <MudProgressLinear Value="Part.ProgressPercent" Color="Color.Primary" />
        </div>
    }
    <span class="pmc-remove" @onclick:stopPropagation="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                       Size="Size.Small"
                       Color="Color.Error"
                       OnClick="@(() => OnRemove.InvokeAsync())"
                       Disabled="@Part.Uploading" />
    </span>
</div>

<style>
    .pmc-card {
        display: flex;
        align-items: stretch;
        border: 2px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-background);
        cursor: pointer;
        min-width: 280px;
        max-width: 300px;
        height: 80px;
        flex-shrink: 0;
        position: relative;
        transition: border-color 0.15s, background 0.15s;
        overflow: hidden;
    }
    .pmc-card:hover { border-color: var(--mud-palette-primary-hover); background: var(--mud-palette-surface); }
    .pmc-active { border-color: var(--mud-palette-primary) !important; background: var(--mud-palette-surface) !important; }
    .pmc-thumb {
        width: 80px;
        min-width: 80px;
        height: 100%;
        border-radius: 4px 0 0 4px;
        background: var(--mud-palette-background-grey);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        position: relative;
    }
    .pmc-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pmc-badge {
        position: absolute;
        bottom: 2px;
        right: 2px;
        font-size: var(--mud-typography-default-size);
    }
    .pmc-badge-uploading { background: rgba(var(--mud-palette-black-rgb), 0.2); color: rgba(var(--mud-palette-black-rgb), 0.6); }
    .pmc-badge-warning { color: var(--mud-palette-warning); }
    .pmc-badge-ok { background: rgba(var(--mud-palette-success-rgb), 0.15); color: var(--mud-palette-success); }
    .pmc-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
        padding: 6px 30px 6px 8px;
        overflow: hidden;
    }
    .pmc-name {
        font-size: 11px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pmc-dim {
        font-size: 10px;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pmc-meta {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 18px;
    }
    .pmc-process-material {
        font-size: 10px;
        color: var(--mud-palette-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pmc-qty {
        font-size: 10px;
        color: var(--mud-palette-primary);
        font-weight: 600;
        margin-left: auto;
        flex-shrink: 0;
    }
    .pmc-price {
        font-size: 11px;
        color: var(--mud-palette-text-primary);
        font-weight: 500;
        margin-top: auto;
    }
    .pmc-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        z-index: 3;
    }
    .pmc-remove {
        opacity: 0;
        transition: opacity 0.15s;
        position: absolute;
        top: 0;
        right: 0;
        transform: translateX(15%);
    }
    .pmc-card:hover .pmc-remove { opacity: 1; }
    .pmc-remove .mud-icon-button:hover,
    .pmc-remove .mud-icon-button:focus {
        background-color: transparent !important;
    }
    .pmc-remove .mud-icon-button::after { display: none !important; }
</style>

@code {
    [Parameter] public PartViewModel Part { get; set; } = null!;
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private string FormatPrice(decimal amount) => $"฿{amount:N0}";

    private static string FormatVolume(double volumeMm3)
    {
        var cm3 = volumeMm3 / 1000.0;
        return cm3 >= 1000 ? $"{cm3 / 1000:N1} L" : $"{cm3:N1} cm³";
    }

    private static string GetFileIcon(string name) =>
        Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".stl" or ".step" or ".stp" or ".3mf" or ".obj" or ".igs" or ".iges"
            or ".blend" or ".fbx" or ".gltf" or ".glb" => Icons.Material.Outlined.ViewInAr,
            ".pdf" => Icons.Material.Outlined.PictureAsPdf,
            ".dxf" or ".dwg" => Icons.Material.Outlined.Architecture,
            ".png" or ".jpg" or ".jpeg" or ".tiff" or ".bmp" or ".webp" => Icons.Material.Outlined.Image,
            ".doc" or ".docx" => Icons.Material.Outlined.Description,
            ".xls" or ".xlsx" => Icons.Material.Outlined.TableChart,
            ".zip" or ".rar" or ".7z" => Icons.Material.Outlined.FolderZip,
            _ => Icons.Material.Outlined.InsertDriveFile,
        };
}
