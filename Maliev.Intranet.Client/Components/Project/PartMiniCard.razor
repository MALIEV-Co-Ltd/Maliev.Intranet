@namespace Maliev.Intranet.Client.Components.Project

<div class="pmc-card @(IsActive ? "pmc-card--active" : "")"
     @onclick="@OnClick">
    @* Thumbnail *@
    <div class="pmc-thumb">
        @if (Part.QueuedUpload)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Color="Color.Secondary" />
        }
        else if (Part.Uploading)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="false"
                                 Value="@Part.ProgressPercent"
                                 Color="Color.Primary" />
        }
        else if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl))
        {
            <img src="@Part.ThumbnailSmallUrl"
                 class="pmc-thumb-img"
                 onerror="this.style.display='none'"
                 alt="@Part.Name" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Outlined.ViewInAr"
                     Size="Size.Small"
                     Color="Color.Tertiary" />
        }
        @* DFM status indicator overlay *@
        @if (Part.RequiresDfmAcknowledgement)
        {
            <div class="mc-indicator warn">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Size="Size.Small"
                         Color="Color.Warning" />
            </div>
        }
        else if (Part.HasProcessRelevantDfmIssues && Part.DfmAcknowledged)
        {
            <div class="mc-indicator ack">
                <MudIcon Icon="@Icons.Material.Outlined.TaskAlt"
                         Size="Size.Small"
                         Color="Color.Info" />
            </div>
        }
        else if (!Part.IsFullyConfigured && Part.FileId != Guid.Empty)
        {
            @* Part is uploaded (possibly DFM-ready) but not yet fully configured *@
            <div class="mc-indicator cfg">
                <MudIcon Icon="@Icons.Material.Filled.BuildCircle"
                         Size="Size.Small"
                         Color="Color.Info" />
            </div>
        }
        else if (Part.IsFullyConfigured)
        {
            <div class="mc-indicator ok">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline"
                         Size="Size.Small"
                         Color="Color.Success" />
            </div>
        }
    </div>

    @* Info *@
    <div class="pmc-info">
        <MudText Typo="Typo.body2" Class="pmc-name" Style="font-weight:600;">
            @TruncateName(Part.Name)
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pmc-meta">
            @(Part.ProcessCode ?? "No process") · @(Part.MaterialCode ?? "No material")
        </MudText>
        <div class="mc-bottom">
            @if (Part.PricingLoading)
            {
                <MudSkeleton Width="60px" Height="12px" Animation="Animation.Wave" />
            }
            else
            {
                <MudText Typo="Typo.caption" Style="font-weight:700;" Class="pmc-price">
                    @(Part.EstimatedUnitPrice.HasValue ? $"{CurrencyCode} {Part.EstimatedUnitPrice.Value * ExchangeRate:N2}" : "—")
                </MudText>
            }
            @if (Part.BodyCount.HasValue && Part.BodyCount.Value > 1)
            {
                <div class="mc-bodies">@Part.BodyCount bodies</div>
            }
            <MudText Typo="Typo.caption" Class="mc-qty">
                ×@Part.Quantity
            </MudText>
        </div>
    </div>

    @* Remove button — visible on card hover *@
    <button class="pmc-remove"
            @onclick:stopPropagation="true"
            @onclick="@OnRemove">
        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
    </button>
</div>

<style>
    .pmc-card {
        position: relative;
        width: 260px;
        min-width: 260px;
        height: 72px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 8px 0 0;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        cursor: pointer;
        overflow: hidden;
        box-shadow: var(--maliev-shadow-card, 0 1px 4px rgba(0,0,0,0.06));
        transition: border-color 0.15s, box-shadow 0.15s;
        flex-shrink: 0;
    }
    .pmc-card:hover {
        border-color: var(--mud-palette-lines-default);
    }
    .pmc-card--active {
        border-color: var(--mud-palette-primary) !important;
        background: var(--mud-palette-primary-lighten) !important;
        box-shadow: var(--shadow-glow) !important;
    }
    .pmc-thumb {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-surface);
        overflow: hidden;
        position: relative;
        border-right: 1px solid var(--mud-palette-lines-default);
    }
    .pmc-thumb-img { width: 100%; height: 100%; object-fit: contain; }
    .mc-indicator {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 10px;
    }
    .mc-indicator.warn { background: var(--mud-palette-warning-bg); color: var(--mud-palette-warning); }
    .mc-indicator.ack  { background: var(--mud-palette-info-lighten); color: var(--mud-palette-info); }
    .mc-indicator.ok   { background: var(--mud-palette-success-bg); color: var(--mud-palette-success); }
    .mc-indicator.cfg  { background: var(--mud-palette-info-lighten); color: var(--mud-palette-info); }
    .pmc-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
    }
    .pmc-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .pmc-meta {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .mc-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }
    .mc-qty {
        font-size: 11px;
        color: var(--mud-palette-primary);
        font-weight: 600;
    }
    .mc-bodies {
        font-size: 10px;
        font-weight: 600;
        color: var(--mud-palette-primary);
        background: var(--mud-palette-primary-bg);
        padding: 2px 6px;
        border-radius: 4px;
    }
    .pmc-price { flex-shrink: 0; }
    .pmc-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 20px;
        height: 20px;
        background: transparent;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s, color 0.15s;
        color: var(--mud-palette-text-secondary);
        padding: 0;
    }
    .pmc-card:hover .pmc-remove { opacity: 1; }
    .pmc-remove:hover { color: var(--mud-palette-error) !important; }
</style>

@code {
    /// <summary>The part view model to display.</summary>
    [Parameter] public PartViewModel Part { get; set; } = null!;

    /// <summary>True when this card is the active/selected part in the configurator.</summary>
    [Parameter] public bool IsActive { get; set; }

    /// <summary>The currency code for displaying the unit price (e.g. "THB", "USD").</summary>
    [Parameter] public string CurrencyCode { get; set; } = "THB";

    /// <summary>Multiplier applied to THB-denominated prices for display (e.g. 0.028 for USD). Defaults to 1.</summary>
    [Parameter] public decimal ExchangeRate { get; set; } = 1m;

    /// <summary>Invoked when the card body is clicked (selects the part).</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Invoked when the remove (×) button is clicked.</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    private static string TruncateName(string? name)
    {
        if (string.IsNullOrEmpty(name)) return string.Empty;
        if (name.Length <= 20) return name;
        var ext = System.IO.Path.GetExtension(name);
        var stem = System.IO.Path.GetFileNameWithoutExtension(name);
        return (stem.Length > 14 ? stem[..14] : stem) + "…" + ext;
    }
}
