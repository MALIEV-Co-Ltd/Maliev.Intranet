@namespace Maliev.Intranet.Client.Components.Project

<MudDialog>
    <DialogContent>
        <div style="width:100%; height:70vh; min-height:400px;">
            @if (_loading)
            {
                <div style="display:flex; align-items:center; justify-content:center; height:100%;">
                    <MudProgressCircular Indeterminate="true" />
                    <MudText Class="ml-3" Color="Color.Secondary">Loading 3D model...</MudText>
                </div>
            }
            else if (_error != null)
            {
                <div style="display:flex; align-items:center; justify-content:center; height:100%; flex-direction:column; gap:8px;">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                    <MudText Color="Color.Error">@_error</MudText>
                    <MudButton Color="Color.Primary" OnClick="@LoadViewerUrlAsync">Retry</MudButton>
                </div>
            }
            else if (!string.IsNullOrEmpty(_viewerUrl))
            {
                <ModelViewer ViewerUrl="@_viewerUrl" FileExtension=".glb" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = null!;

    [Parameter] public string? StoragePath { get; set; }
    [Parameter] public string? Title { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _viewerUrl;

    protected override async Task OnInitializedAsync()
    {
        await LoadViewerUrlAsync();
    }

    private async Task LoadViewerUrlAsync()
    {
        if (string.IsNullOrEmpty(StoragePath))
        {
            _error = "No 3D model available.";
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        _viewerUrl = null;

        try
        {
            var response = await Http.GetAsync($"api/uploads/viewer-url?storagePath={Uri.EscapeDataString(StoragePath)}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ViewerUrlResponse>();
                _viewerUrl = result?.Url;
                if (string.IsNullOrEmpty(_viewerUrl))
                    _error = "Could not retrieve model URL.";
            }
            else
            {
                _error = $"Failed to load model ({(int)response.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private record ViewerUrlResponse(string Url);
}
