@namespace Maliev.Intranet.Client.Components.Project

<MudPaper Class="@CardClass"
          @onclick="OnClick"
          Elevation="0">
    <div class="catalog-card-img">
        <img src="@(ImageUrl ?? "images/image-placeholder.svg")" alt="@Title" />
    </div>
    <div class="catalog-card-body">
        <MudText Typo="Typo.caption" Class="catalog-card-title">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.caption" Class="catalog-card-subtitle" Color="Color.Secondary">@Subtitle</MudText>
        }
    </div>
    @if (IsSelected)
    {
        <div class="catalog-card-check">
            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
        </div>
    }
</MudPaper>

<style>
    .catalog-card {
        min-width: 120px;
        max-width: 140px;
        border: 2px solid var(--mud-palette-lines-default);
        cursor: pointer;
        position: relative;
        padding: 0;
        transition: border-color 0.15s;
        flex-shrink: 0;
    }
    .catalog-card:hover { border-color: var(--mud-palette-primary-hover); }
    .catalog-card-selected { border-color: var(--mud-palette-primary) !important; }
    .catalog-card-img img {
        width: 100%;
        height: 72px;
        object-fit: cover;
        display: block;
        border-radius: calc(var(--mud-default-border-radius) - 2px) calc(var(--mud-default-border-radius) - 2px) 0 0;
    }
    .catalog-card-body { padding: 6px 8px 8px; }
    .catalog-card-title {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }
    .catalog-card-subtitle {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        margin-top: 1px;
    }
    .catalog-card-check {
        position: absolute; top: 4px; right: 4px;
        background: var(--mud-palette-surface);
        border-radius: 50%;
        width: 20px; height: 20px;
        display: flex; align-items: center; justify-content: center;
    }
</style>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string CardClass => $"catalog-card{(IsSelected ? " catalog-card-selected" : "")}";
}
