@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos

<div class="plr-wrapper">
    @* ── Collapsed card row ─────────────────────────────────────────── *@
    <div class="plr-card-row">

        @* Checkbox *@
        <div class="plr-cell plr-cell--check">
            <MudCheckBox T="bool"
                         Value="@IsSelected"
                         ValueChanged="@((bool v) => OnSelectChanged.InvokeAsync(v))"
                         Size="Size.Small" />
        </div>

        @* Thumbnail *@
        <div class="plr-cell plr-cell--thumb"
             @onclick="@(async () => await OnViewIn3D.InvokeAsync())">
            @if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl))
            {
                <img src="@Part.ThumbnailSmallUrl"
                     class="plr-thumb-img"
                     onerror="this.style.display='none'"
                     alt="@Part.Name" />
            }
            else if (Part.Uploading || Part.AwaitingPreview)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.ViewInAr"
                         Size="Size.Small"
                         Color="Color.Tertiary" />
            }
        </div>

        @* File info: name + dims + DFM badge *@
        <div class="plr-cell plr-cell--info">
            <MudText Typo="Typo.body2" Class="plr-filename">@Part.Name</MudText>
            <div class="plr-meta-row">
                @if (Part.Dimensions != null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="plr-dims">
                        @($"{Part.Dimensions.X:N1} × {Part.Dimensions.Y:N1} × {Part.Dimensions.Z:N1} mm")
                    </MudText>
                }
                @if (Part.VolumeMm3.HasValue)
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="plr-volume">
                        · @((Part.VolumeMm3.Value / 1000.0).ToString("F2")) cm³
                    </MudText>
                }
            </div>
            @* DFM status badge *@
            <div class="plr-badge-row">
                @if (Part.DfmReport != null && !Part.DfmAcknowledged)
                {
                    <MudChip T="string"
                             Label="true"
                             Color="Color.Warning"
                             Size="Size.Small"
                             Class="plr-dfm-badge">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                                 Size="Size.Small"
                                 Class="mr-1" />
                        DFM Warnings
                    </MudChip>
                }
                else if (Part.IsFullyConfigured)
                {
                    <MudChip T="string"
                             Label="true"
                             Color="Color.Success"
                             Size="Size.Small"
                             Class="plr-dfm-badge">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline"
                                 Size="Size.Small"
                                 Class="mr-1" />
                        DFM Passed
                    </MudChip>
                }
            </div>
        </div>

        @* Process dropdown *@
        <div class="plr-cell plr-cell--process">
            <MudSelect T="ProcessDto"
                       Value="@SelectedProcess"
                       ValueChanged="@((ProcessDto? p) => OnProcessChanged(p))"
                       ToStringFunc="@(p => p?.Name ?? string.Empty)"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Label="Process"
                       Class="plr-select">
                @foreach (var proc in Processes)
                {
                    <MudSelectItem T="ProcessDto" Value="@proc">@proc.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        @* Material dropdown *@
        <div class="plr-cell plr-cell--material">
            <MudSelect T="CatalogMaterialDto"
                       Value="@SelectedMaterial"
                       ValueChanged="@((CatalogMaterialDto? m) => OnMaterialChanged(m))"
                       ToStringFunc="@(m => m?.Name ?? string.Empty)"
                       Disabled="@(Part.AvailableMaterials.Count == 0)"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Label="Material"
                       Class="plr-select">
                @foreach (var mat in Part.AvailableMaterials)
                {
                    <MudSelectItem T="CatalogMaterialDto" Value="@mat">@mat.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        @* Quantity *@
        <div class="plr-cell plr-cell--qty">
            <MudNumericField T="int"
                             Value="@Part.Quantity"
                             ValueChanged="@((int qty) => OnQuantityChanged(qty))"
                             Min="1"
                             Max="10000"
                             Margin="Margin.Dense"
                             Variant="Variant.Outlined"
                             Label="Qty"
                             Class="plr-qty-field" />
        </div>

        @* Total price *@
        <div class="plr-cell plr-cell--price">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="plr-total">
                @(Part.EstimatedTotalAmount.HasValue ? $"฿{Part.EstimatedTotalAmount.Value:N0}" : "—")
            </MudText>
            @if (Part.EstimatedUnitPrice.HasValue)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="plr-unit-price">
                    ฿@Part.EstimatedUnitPrice.Value.ToString("N0") ea
                </MudText>
            }
        </div>

        @* Action buttons *@
        <div class="plr-cell plr-cell--actions">
            <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Size="Size.Small"
                           OnClick="@(() => _expanded = !_expanded)" />
            <MudIconButton Icon="@Icons.Material.Filled.ViewInAr"
                           Size="Size.Small"
                           Disabled="@(string.IsNullOrEmpty(Part.GlbStoragePath) && string.IsNullOrEmpty(Part.GlbSignedUrl))"
                           OnClick="@(async () => await OnViewIn3D.InvokeAsync())" />
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(async () => await OnRemove.InvokeAsync())" />
        </div>
    </div>

    @* ── Expanded configuration panel ─────────────────────────────── *@
    @if (_expanded)
    {
        <div class="plr-config-panel">
            <PartConfigSidebar Part="@Part"
                               Processes="@Processes"
                               TempProjectId="@TempProjectId"
                               DisplayMode="@PartConfigSidebarDisplayMode.Inline"
                               OnPartChanged="@OnPartChanged" />
        </div>
    }
</div>

@code {
    /// <summary>The part view model this row represents.</summary>
    [Parameter] public PartViewModel Part { get; set; } = null!;

    /// <summary>True when this row's checkbox is checked.</summary>
    [Parameter] public bool IsSelected { get; set; }

    /// <summary>The list of available manufacturing processes.</summary>
    [Parameter] public List<ProcessDto> Processes { get; set; } = [];

    /// <summary>The temporary project identifier, forwarded to <see cref="PartConfigSidebar"/>.</summary>
    [Parameter] public Guid TempProjectId { get; set; }

    /// <summary>Callback invoked when the selection checkbox changes.</summary>
    [Parameter] public EventCallback<bool> OnSelectChanged { get; set; }

    /// <summary>Callback invoked when the user clicks the remove button.</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>Callback invoked when the user clicks the View in 3D button.</summary>
    [Parameter] public EventCallback OnViewIn3D { get; set; }

    /// <summary>Callback invoked after any mutation to the part configuration.</summary>
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }

    private bool _expanded;

    private ProcessDto? SelectedProcess =>
        Processes.FirstOrDefault(p => p.Code == Part.ProcessCode);

    private CatalogMaterialDto? SelectedMaterial =>
        Part.AvailableMaterials.FirstOrDefault(m => m.Id == Part.MaterialId);

    private async Task OnProcessChanged(ProcessDto? p)
    {
        Part.ProcessCode = p?.Code;
        Part.ProcessId = p?.Id;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnMaterialChanged(CatalogMaterialDto? m)
    {
        Part.MaterialCode = m?.Code;
        Part.MaterialId = m?.Id;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnQuantityChanged(int qty)
    {
        Part.Quantity = qty;
        await OnPartChanged.InvokeAsync(Part);
    }
}
