@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos

<div class="pnl-left">
    @* ── Section 1: Customer ─────────────────────────────────────────── *@
    @if (SelectedCustomer != null && !ShowCustomerSearch)
    {
        <div class="pnl-section pnl-section-customer">
            <div class="pnl-customer-card">
                <MudText Typo="Typo.body2" Style="font-weight:600;">@SelectedCustomer.Name</MudText>
                @if (!string.IsNullOrEmpty(SelectedCustomer.Email))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@SelectedCustomer.Email</MudText>
                }
                @if (!string.IsNullOrEmpty(SelectedCustomer.CompanyName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@SelectedCustomer.CompanyName</MudText>
                }
                <div class="pnl-customer-actions">
                    @if (!string.IsNullOrEmpty(SelectedCustomer.Email))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Email"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Href="@($"mailto:{SelectedCustomer.Email}")"
                                       Target="_blank" />
                    }
                    @if (!string.IsNullOrEmpty(SelectedCustomer.Mobile))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Phone"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Href="@($"tel:{SelectedCustomer.Mobile}")" />
                    }
                    else if (!string.IsNullOrEmpty(SelectedCustomer.Landline))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Phone"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Href="@($"tel:{SelectedCustomer.Landline}")" />
                    }
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   OnClick="@(() => OnShowSearchChanged.InvokeAsync(true))" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pnl-section">
            <MudAutocomplete T="CustomerSummaryDto"
                             Label="Search customers"
                             SearchFunc="@(SearchCustomersFunc ?? ((_,__) => Task.FromResult(Enumerable.Empty<CustomerSummaryDto>())))"
                             ValueChanged="@OnCustomerSelected"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             DebounceInterval="300"
                             MinCharacters="2">
                <ItemTemplate Context="customer">
                    <MudStack Row="false" Spacing="0">
                        <MudText Typo="Typo.body2">@customer.Name</MudText>
                        @if (!string.IsNullOrEmpty(customer.CompanyName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">@customer.CompanyName</MudText>
                        }
                        @if (!string.IsNullOrEmpty(customer.Email))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@customer.Email</MudText>
                        }
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
        </div>
    }

    <div style="margin: 0; padding: 0;">
        <MudDivider Class="my-0" />
    </div>

    @* ── Section 2: Project Details ──────────────────────────────────── *@
    <div class="pnl-section pnl-section-grow" style="padding-top: 0;">
        <MudTextField T="string"
                      Value="@Title"
                      ValueChanged="@OnTitleChanged"
                      Label="Project Title *"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Error="@TitleHasError"
                      ErrorText="@TitleError"
                      Immediate="true"
                      MaxLength="500"
                      Class="mb-4" />

        <MudTextField T="string"
                      Value="@Description"
                      ValueChanged="@OnDescriptionChanged"
                      Label="Description"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="8"
                      Immediate="true"
                      MaxLength="2000" />
    </div>

    @* ── Section 3: Upload (only when ShowUploadSection is true) ────── *@
    @if (ShowUploadSection)
    {
        <div class="pnl-section pnl-upload-section">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="pnl-section-label">Parts</MudText>

            <div class="pnl-dropzone @(DragOver ? "pnl-dropzone-active" : "")"
                 @ondragenter="@(() => OnDragEnter.InvokeAsync())"
                 @ondragleave="@(() => OnDragLeave.InvokeAsync())"
                 @ondragover:preventDefault="true"
                 @ondrop:preventDefault="true"
                 @onclick="@(() => OnOpenFilePicker.InvokeAsync())">
                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload"
                         Size="Size.Large"
                         Color="@(DragOver ? Color.Primary : Color.Default)" />
                <MudText Typo="Typo.body2"
                         Color="@(DragOver ? Color.Primary : Color.Secondary)"
                         Class="mt-1">
                    @(DragOver ? "Drop files here" : "Drag & drop or click to upload")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                    STL, STEP, 3MF, OBJ, and more
                </MudText>
            </div>
        </div>
    }
</div>

<style>
    .pnl-left {
        width: 340px;
        min-width: 340px;
        height: 100%;
        overflow-y: auto;
        background: var(--mud-palette-surface);
        border-right: 1px solid var(--mud-palette-lines-default);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }
    .pnl-section {
        padding: 14px;
        flex-shrink: 0;
    }
    .pnl-section-grow {
        flex: 1;
    }
    .pnl-section-label {
        display: block;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
    }
    .pnl-section-customer {
        padding-bottom: 8px;
    }
    .pnl-customer-card {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
    }
    .pnl-customer-actions {
        display: flex;
        gap: 4px;
        align-items: center;
        padding-top: 4px;
    }
    .pnl-customer-actions .mud-icon-button:hover {
        background-color: transparent !important;
    }
    .pnl-customer-actions .mud-icon-button:focus-visible {
        background-color: transparent !important;
    }
    .pnl-customer-actions .mud-icon-button:active {
        background-color: transparent !important;
    }
    .pnl-upload-section {
        flex-shrink: 0;
    }
    .pnl-left .mud-autocomplete .mud-input-control-input-control,
    .pnl-left .mud-autocomplete .mud-input-label {
        font-size: var(--mud-typography-body1-size, 1rem);
    }
    .pnl-dropzone {
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        min-height: 120px;
    }
    .pnl-dropzone:hover {
        border-color: var(--mud-palette-primary);
        background: var(--mud-palette-primary-hover);
    }
    .pnl-dropzone-active {
        border-color: var(--mud-palette-primary);
        background: var(--mud-palette-primary-hover);
    }
</style>

@code {
    [Parameter] public CustomerSummaryDto? SelectedCustomer { get; set; }
    [Parameter] public bool ShowCustomerSearch { get; set; }
    [Parameter] public EventCallback<CustomerSummaryDto?> OnCustomerSelected { get; set; }
    [Parameter] public EventCallback<bool> OnShowSearchChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public bool TitleHasError { get; set; }
    [Parameter] public string? TitleError { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public EventCallback<string?> OnDescriptionChanged { get; set; }
    [Parameter] public bool DescriptionHasError { get; set; }
    [Parameter] public string? DescriptionError { get; set; }
    [Parameter] public bool DragOver { get; set; }
    [Parameter] public EventCallback OnDragEnter { get; set; }
    [Parameter] public EventCallback OnDragLeave { get; set; }
    [Parameter] public EventCallback OnOpenFilePicker { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<CustomerSummaryDto>>>? SearchCustomersFunc { get; set; }
    [Parameter] public bool ShowUploadSection { get; set; } = true;
}
