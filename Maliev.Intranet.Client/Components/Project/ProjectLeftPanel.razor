@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="pnl-left">
    @* ── Section 1: Customer ─────────────────────────────────────────── *@
    @if (SelectedCustomer != null && !ShowCustomerSearch)
    {
        <div class="pnl-section">
            <div class="section-header">Customer</div>
            <div class="pnl-customer-card">
                <MudText Typo="Typo.body2" Style="font-weight:600;">@SelectedCustomer.Name</MudText>
                @if (!string.IsNullOrEmpty(SelectedCustomer.CompanyName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@SelectedCustomer.CompanyName</MudText>
                }
                @if (!string.IsNullOrEmpty(SelectedCustomer.Email))
                {
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@SelectedCustomer.Email</MudText>
                }
                <div class="pnl-customer-actions">
                    @if (!string.IsNullOrEmpty(SelectedCustomer.Email))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Email" Size="Size.Small"
                                       Href="@($"mailto:{SelectedCustomer.Email}")" Target="_blank" Class="pa-0" />
                    }
                    @if (!string.IsNullOrEmpty(SelectedCustomer.Mobile))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Phone" Size="Size.Small"
                                       Href="@($"tel:{SelectedCustomer.Mobile}")" Class="pa-0" />
                    }
                    else if (!string.IsNullOrEmpty(SelectedCustomer.Landline))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Phone" Size="Size.Small"
                                       Href="@($"tel:{SelectedCustomer.Landline}")" Class="pa-0" />
                    }
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                   OnClick="@(() => OnShowSearchChanged.InvokeAsync(true))" Class="pa-0" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pnl-section">
            <div class="section-header">Customer</div>
            <MudAutocomplete T="CustomerSummaryDto"
                             @bind-Value="_searchCustomer"
                             Label="Search customers"
                             SearchFunc="@(SearchCustomersFunc ?? ((_,__) => Task.FromResult(Enumerable.Empty<CustomerSummaryDto>())))"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ShowProgressIndicator="true"
                             DebounceInterval="300"
                             MinCharacters="2"
                             @bind-Value:after="OnCustomerSelectedFromAutocomplete">
                <ItemTemplate Context="customer">
                    <MudStack Row="false" Spacing="0">
                        <MudText Typo="Typo.body2">@customer.Name</MudText>
                        @if (!string.IsNullOrEmpty(customer.CompanyName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@customer.CompanyName</MudText>
                        }
                        @if (!string.IsNullOrEmpty(customer.Email))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@customer.Email</MudText>
                        }
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
        </div>
    }

    <MudDivider Class="my-0" />

    @* ── Section 2: Requirements ─────────────────────────────────────── *@
    <div class="pnl-section pnl-section-grow">
        <div class="section-header">Requirements</div>
        <MudTextField T="string"
                      Value="@Description"
                      ValueChanged="@OnDescriptionChanged"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="0"
                      Immediate="true"
                      MaxLength="2000"
                      Placeholder="Add specific manufacturing instructions..." />
    </div>

    <MudDivider Class="my-0" />

    @* ── Section 3: Upload ───────────────────────────────────────────── *@
    <div class="pnl-section pnl-upload-section">
        <div class="section-header">Upload 3D Models</div>
        <FileUploadDropzone Icon="@Icons.Material.Filled.ViewInAr"
                            Label="Drag & drop or click to upload"
                            SubLabel="STL, STEP, STP, 3MF, IGS, IGES, SLDPRT, PRT, SAT, X_T"
                            OnClick="@OnOpenFilePicker"
                            OnFilesDropped="@OnOpenFilePicker" />
        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">
            Note: We do not accept files related to firearms, weapons, or illegal items.
        </MudText>
    </div>
</div>

<style>
    .pnl-left {
        width: 320px;
        min-width: 320px;
        height: 100%;
        overflow-y: auto;
        background: var(--mud-palette-surface);
        border-right: 1px solid var(--mud-palette-lines-default);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }
    .pnl-section {
        padding: 14px;
        flex-shrink: 0;
    }
    .pnl-section-grow {
        flex: 1;
        min-height: 200px;
    }
    .pnl-section-label {
        display: block;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
    }
    .pnl-customer-card {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
    }
    .pnl-customer-actions {
        display: flex;
        align-items: center;
        padding-top: 4px;
        gap: 4px;
    }
    .pnl-customer-actions .mud-icon-button:hover,
    .pnl-customer-actions .mud-icon-button:focus-visible,
    .pnl-customer-actions .mud-icon-button:active {
        background-color: transparent !important;
    }
    .pnl-upload-section {
        flex-shrink: 0;
    }
    /* Tablet: 3-column grid */
    @@media (min-width: 769px) and (max-width: 1200px) {
        .pnl-left {
            width: 100%;
            min-width: unset;
            height: auto;
            border-right: none;
            border-bottom: 1px solid var(--mud-palette-lines-default);
            display: grid;
            grid-template-columns: 1.5fr 2fr 1.5fr;
            overflow-y: visible;
            flex-shrink: unset;
        }
        .pnl-section { border-right: 1px solid var(--mud-palette-lines-default); }
        .pnl-section:last-child { border-right: none; }
        .pnl-section-grow { flex: unset; }
    }
    /* Mobile: vertical stack */
    @@media (max-width: 768px) {
        .pnl-left {
            width: 100%;
            min-width: unset;
            height: auto;
            border-right: none;
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }
    }
</style>

@code {
    private CustomerSummaryDto? _searchCustomer;

    /// <summary>The currently selected customer, or null if none.</summary>
    [Parameter] public CustomerSummaryDto? SelectedCustomer { get; set; }

    /// <summary>True to show the customer search autocomplete instead of the selected customer card.</summary>
    [Parameter] public bool ShowCustomerSearch { get; set; }

    /// <summary>Invoked when a customer is selected from the autocomplete.</summary>
    [Parameter] public EventCallback<CustomerSummaryDto?> OnCustomerSelected { get; set; }

    /// <summary>Invoked when the show-customer-search state should change.</summary>
    [Parameter] public EventCallback<bool> OnShowSearchChanged { get; set; }

    /// <summary>The project requirements/description text.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Invoked when the description text changes.</summary>
    [Parameter] public EventCallback<string?> OnDescriptionChanged { get; set; }

    /// <summary>Invoked when the user clicks or drops files on the upload dropzone.</summary>
    [Parameter] public EventCallback OnOpenFilePicker { get; set; }

    /// <summary>Search function for the customer autocomplete. Takes a query string and cancellation token.</summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<CustomerSummaryDto>>>? SearchCustomersFunc { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ShowCustomerSearch && SelectedCustomer != null)
            _searchCustomer = SelectedCustomer;
    }

    private Task OnCustomerSelectedFromAutocomplete() =>
        OnCustomerSelected.InvokeAsync(_searchCustomer);
}
