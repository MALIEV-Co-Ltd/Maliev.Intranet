@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="pnl-left">
    @* ── Section 1: Customer ─────────────────────────────────────────── *@
    @if (SelectedCustomer != null && !ShowCustomerSearch)
    {
        <div class="pnl-section">
            <div class="section-header">Customer</div>
            <div class="pnl-section-content">
                <div class="pnl-customer-card">
                    @* Row: person icon + customer name *@
                    <div class="pcc-row">
                        <MudIcon Icon="@Icons.Material.Outlined.Person"
                                 Size="Size.Small"
                                 Color="Color.Default"
                                 Class="pcc-row-icon" />
                        <MudText Typo="Typo.body1" Class="pcc-name">@SelectedCustomer.Name</MudText>
                    </div>

                    @* Row: business icon + company name *@
                    @if (!string.IsNullOrEmpty(SelectedCustomer.CompanyName))
                    {
                        <div class="pcc-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Business"
                                     Size="Size.Small"
                                     Color="Color.Default"
                                     Class="pcc-row-icon" />
                            <MudText Typo="Typo.subtitle1" Class="pcc-company">@SelectedCustomer.CompanyName</MudText>
                        </div>
                    }

                    @* Row: email icon + email *@
                    @if (!string.IsNullOrEmpty(SelectedCustomer.Email))
                    {
                        <div class="pcc-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Email"
                                     Size="Size.Small"
                                     Color="Color.Default"
                                     Class="pcc-row-icon" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@SelectedCustomer.Email</MudText>
                        </div>
                    }

                    @* Row: phone icon + mobile or landline *@
                    @{
                        var phone = !string.IsNullOrEmpty(SelectedCustomer.Mobile)
                            ? SelectedCustomer.Mobile
                            : SelectedCustomer.Landline;
                    }
                    @if (!string.IsNullOrEmpty(phone))
                    {
                        <div class="pcc-row">
                            <MudIcon Icon="@Icons.Material.Outlined.Phone"
                                     Size="Size.Small"
                                     Color="Color.Default"
                                     Class="pcc-row-icon" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@phone</MudText>
                        </div>
                    }

                    @* Edit button — absolute top-right *@
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Class="pcc-edit-btn"
                                   OnClick="@(() => OnShowSearchChanged.InvokeAsync(true))" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pnl-section">
            <div class="section-header">Customer</div>
            <div class="pnl-section-content">
                <MudAutocomplete T="CustomerSummaryDto"
                                 @bind-Value="_searchCustomer"
                                 Label="Search customers"
                                 SearchFunc="@(SearchCustomersFunc ?? ((_,__) => Task.FromResult(Enumerable.Empty<CustomerSummaryDto>())))"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true"
                                 ShowProgressIndicator="true"
                                 DebounceInterval="300"
                                 MinCharacters="2"
                                 @bind-Value:after="OnCustomerSelectedFromAutocomplete">
                    <ItemTemplate Context="customer">
                        <MudStack Row="false" Spacing="0">
                            <MudText Typo="Typo.body2">@customer.Name</MudText>
                            @if (!string.IsNullOrEmpty(customer.CompanyName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@customer.CompanyName</MudText>
                            }
                            @if (!string.IsNullOrEmpty(customer.Email))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@customer.Email</MudText>
                            }
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>
            </div>
        </div>
    }

    <MudDivider Class="my-0" />

    @* ── Section 2: Requirements ─────────────────────────────────────── *@
    <div class="pnl-section pnl-section-grow">
        <div class="section-header">Requirements</div>
        <MudStack Justify="Justify.SpaceBetween"
                  StretchItems="StretchItems.Middle"
                  Class="pnl-section-content"
                  Style="flex:1;min-height:0;">
            <MudTextField T="string"
                          Value="@Description"
                          ValueChanged="@OnDescriptionChanged"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="0"
                          Immediate="true"
                          MaxLength="2000"
                          Placeholder="Add specific manufacturing instructions..." />
        </MudStack>
    </div>

    <MudDivider Class="my-0" />

    @* ── Section 3: Upload ───────────────────────────────────────────── *@
    <div class="pnl-section">
        <div class="section-header">Upload 3D Models</div>
        <div class="pnl-section-content">
            <FileUploadDropzone Icon="@Icons.Material.Filled.ViewInAr"
                                Label="Drag & drop or click to upload"
                                SubLabel="STL, STEP, STP, 3MF, IGS, IGES, SLDPRT, PRT, SAT, X_T"
                                OnClick="@OnOpenFilePicker"
                                OnFilesDropped="@OnOpenFilePicker" />
            <MudText Typo="Typo.caption" Class="mt-2 pcc-weapons-notice">
                <MudIcon Icon="@Icons.Material.Filled.Campaign"
                         Size="Size.Small"
                         Class="mr-1" />
                Weapons and illegal items are strictly prohibited.
            </MudText>
        </div>
    </div>
</div>

<style>
    .pnl-left {
        width: 320px;
        min-width: 320px;
        height: 100%;
        overflow-y: auto;
        background: var(--mud-palette-surface);
        border-right: 1px solid var(--mud-palette-lines-default);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }

    .pnl-section {
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }

    .pnl-section-grow {
        flex: 1;
        min-height: 200px;
    }

    /* ── Section header ─────────────────────────────────────────────── */
    .section-header {
        background: #e2e8f0;
        padding: 8px 16px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        color: #0f172a;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* ── Section content wrapper ─────────────────────────────────────── */
    .pnl-section-content {
        padding: 16px;
        display: flex;
        flex-direction: column;
    }

    /* ── Customer card ────────────────────────────────────────────────── */
    .pnl-customer-card {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-left: 4px solid var(--mud-palette-primary);
        border-radius: 6px;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
    }

    .pcc-row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .pcc-row-icon {
        flex-shrink: 0;
        color: var(--mud-palette-text-secondary);
        font-size: 16px;
    }

    .pcc-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pcc-company {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pcc-edit-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        color: var(--mud-palette-text-secondary) !important;
        padding: 4px !important;
        min-width: unset !important;
        width: 28px !important;
        height: 28px !important;
    }

    .pcc-edit-btn:hover {
        color: var(--mud-palette-primary) !important;
        background: var(--mud-palette-primary-lighten) !important;
    }

    /* ── Weapons notice ───────────────────────────────────────────────── */
    .pcc-weapons-notice {
        display: flex;
        align-items: center;
        color: var(--mud-palette-error) !important;
    }

    /* ── Tablet: 3-column grid ─────────────────────────────────────── */
    @@media (min-width: 769px) and (max-width: 1200px) {
        .pnl-left {
            width: 100%;
            min-width: unset;
            height: auto;
            border-right: none;
            border-bottom: 1px solid var(--mud-palette-lines-default);
            display: grid;
            grid-template-columns: 1.5fr 2fr 1.5fr;
            overflow-y: visible;
            flex-shrink: unset;
        }
        .pnl-section {
            border-right: 1px solid var(--mud-palette-lines-default);
        }
        .pnl-section:last-child {
            border-right: none;
        }
        .pnl-section-grow {
            flex: unset;
        }
    }

    /* ── Mobile: vertical stack ─────────────────────────────────────── */
    @@media (max-width: 768px) {
        .pnl-left {
            width: 100%;
            min-width: unset;
            height: auto;
            border-right: none;
            border-bottom: 1px solid var(--mud-palette-lines-default);
        }
    }
</style>

@code {
    private CustomerSummaryDto? _searchCustomer;

    /// <summary>The currently selected customer, or null if none.</summary>
    [Parameter] public CustomerSummaryDto? SelectedCustomer { get; set; }

    /// <summary>True to show the customer search autocomplete instead of the selected customer card.</summary>
    [Parameter] public bool ShowCustomerSearch { get; set; }

    /// <summary>Invoked when a customer is selected from the autocomplete.</summary>
    [Parameter] public EventCallback<CustomerSummaryDto?> OnCustomerSelected { get; set; }

    /// <summary>Invoked when the show-customer-search state should change.</summary>
    [Parameter] public EventCallback<bool> OnShowSearchChanged { get; set; }

    /// <summary>The project requirements/description text.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Invoked when the description text changes.</summary>
    [Parameter] public EventCallback<string?> OnDescriptionChanged { get; set; }

    /// <summary>Invoked when the user clicks or drops files on the upload dropzone.</summary>
    [Parameter] public EventCallback OnOpenFilePicker { get; set; }

    /// <summary>Search function for the customer autocomplete. Takes a query string and cancellation token.</summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<CustomerSummaryDto>>>? SearchCustomersFunc { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ShowCustomerSearch && SelectedCustomer != null)
            _searchCustomer = SelectedCustomer;
    }

    private Task OnCustomerSelectedFromAutocomplete() =>
        OnCustomerSelected.InvokeAsync(_searchCustomer);
}
