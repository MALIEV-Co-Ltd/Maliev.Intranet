@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Client.Helpers
@inject CurrencyService CurrencyService

@if (Part == null)
{
    <div class="pcs-empty-state">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Select a part to configure</MudText>
    </div>
    return;
}

<div class="@RootClass">
    <div class="pcs-header">
        <div class="pcs-header-label">Configure</div>
        <div class="pcs-header-name" title="@Part!.Name">@Part!.Name</div>
        <div class="pcs-header-actions">
            @if (OnLayoutModeChanged.HasDelegate)
            {
                <button type="button"
                        class="pcs-header-icon-button"
                        title="Table edit"
                        aria-label="Switch to table edit"
                        @onclick="SwitchToTableEditAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.TableRows" Size="Size.Small" />
                </button>
            }
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="pcs-header-info" title="Configuration info" />
        </div>
    </div>

    <div class="pcs-scroll">
        @* ── Manufacturing Process ─────────────────────────────────────── *@
        <section class="pcs-section">
            <div class="pcs-section-header">
                <span class="pcs-section-title">Manufacturing Process</span>
            </div>
            <div class="pcs-process-grid">
                @foreach (var proc in Processes)
                {
                    var active = SelectedProcess?.Code == proc.Code;
                    <button class="pcs-process-card @(active ? "pcs-process-card--active" : "")"
                            @onclick="@(() => OnProcessChanged(proc))">
                        @if (active)
                        {
                            <div class="pcs-process-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                        }
                        <div class="pcs-process-icon">
                            @((MarkupString)ProcessIconHelper.GetProcessSvg(proc.Code))
                        </div>
                        <div class="pcs-process-name">@proc.Name</div>
                    </button>
                }
            </div>

        </section>

        @* ── Material ─────────────────────────────────────────────────── *@
        <section class="pcs-section">
            <div class="pcs-section-header">
                <span class="pcs-section-title">Material</span>
                <span class="pcs-section-count">@Part!.AvailableMaterials.Count options</span>
            </div>
            <div class="pcs-cards">
                @foreach (var mat in Part!.AvailableMaterials)
                {
                    var active = SelectedMaterial?.Id == mat.Id;
                    <button class="pcs-mat-card @(active ? "pcs-mat-card--active" : "")"
                            @onclick="@(() => OnMaterialChanged(mat))">
                        <div class="pcs-mat-swatch" style="background: @GetMaterialGradient(mat.Code)" />
                        <div class="pcs-mat-info">
                            <div class="pcs-mat-name">@mat.Name</div>
                            @if (!string.IsNullOrEmpty(mat.Description))
                            {
                                <div class="pcs-mat-sub">@mat.Description</div>
                            }
                        </div>
                        @if (active)
                        {
                            <div class="pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                        }
                    </button>
                }
            </div>
        </section>

        @if (RequiresDedicatedMaterialColorSelection)
        {
            @* ── Material Color ───────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Material Color</span>
                    <span class="pcs-section-count">@PomMaterialColors.Count options</span>
                </div>
                <div class="pcs-color-choice-grid">
                    @foreach (var color in PomMaterialColors)
                    {
                        var currentColor = GetProcessOptionValue(MaterialColorKey, PomMaterialColors[0]);
                        var active = string.Equals(currentColor, color, StringComparison.OrdinalIgnoreCase);
                        <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                @onclick="@(() => OnMaterialColorChanged(color))">
                            <span class="pcs-color-chip" style="background: @GetOptionColor(color)" />
                            <span>@color</span>
                            @if (active)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                        </button>
                    }
                </div>
            </section>
        }

        @* ── Surface Finish ───────────────────────────────────────────── *@
        <section class="pcs-section">
            @{
                var visibleFinishes = GetVisibleFinishes(Part!.AvailableFinishes);
            }
            <div class="pcs-section-header">
                <span class="pcs-section-title">Surface Finish</span>
                <span class="pcs-section-count">@visibleFinishes.Count options</span>
            </div>
            <div class="pcs-cards">
                @foreach (var fin in visibleFinishes)
                {
                    var active = IsSelectedFinishGroup(fin);
                    <button class="pcs-fin-card @(active ? "pcs-fin-card--active" : "")"
                            @onclick="@(() => OnFinishChanged(fin))">
                        <div class="pcs-fin-swatch" style="background: @GetFinishGradient(fin.Code)" />
                        <div class="pcs-fin-info">
                            <div class="pcs-fin-name">@GetSurfaceFinishDisplayName(fin)</div>
                            @if (!string.IsNullOrEmpty(fin.Description))
                            {
                                <div class="pcs-fin-sub">@fin.Description</div>
                            }
                        </div>
                        <div class="pcs-fin-price">@FormatFinishPrice(fin)</div>
                            @if (active)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                    }
                </div>
            </section>

            @* ── Tolerance ─────────────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Tolerance</span>
                    <div class="pcs-section-meta">
                        <MudIconButton Icon="@Icons.Material.Outlined.Info"
                                       Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Class="pcs-info-button"
                                       OnClick="OpenToleranceInfoDialog" />
                        <span class="pcs-section-count">@VisibleTolerances.Count() options</span>
                    </div>
                </div>
                <div class="pcs-tol-grid">
                    @foreach (var tol in VisibleTolerances)
                    {
                        var active = SelectedTolerance?.Id == tol.Id;
                        var (tolHead, tolTail) = ToleranceNameHelper.Split(tol.Name);
                        <button class="pcs-tol-card @(active ? "pcs-tol-card--active" : "")"
                                @onclick="@(() => OnToleranceChanged(tol))">
                            <div class="pcs-tol-name">@tolHead</div>
                            <div class="pcs-tol-grade">@(string.IsNullOrEmpty(tolTail) ? tol.Grade : tolTail)</div>
                            <div class="pcs-tol-range">@GetToleranceRange(tol)</div>
                            @if (active)
                            {
                                <div class="pcs-tol-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:10px;width:10px;height:10px;" />
                                </div>
                            }
                        </button>
                    }
                </div>
            </section>

            @if (IsCncProcess)
            {
                @* ── CNC Surface Roughness ─────────────────────────────────────── *@
                <section class="pcs-section">
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Surface Roughness</span>
                        <span class="pcs-section-count">@RoughnessOptions.Count options</span>
                    </div>
                    <div class="pcs-cards">
                        @foreach (var roughness in RoughnessOptions)
                        {
                            var active = string.Equals(Part!.RoughnessCode, roughness.Code, StringComparison.OrdinalIgnoreCase);
                            <button class="pcs-choice-card @(active ? "pcs-choice-card--active" : "")"
                                    @onclick="@(() => OnRoughnessChanged(roughness.Code))">
                                <div class="pcs-choice-swatch pcs-choice-swatch--metal">
                                    <MudIcon Icon="@Icons.Material.Outlined.Grain" Size="Size.Small" />
                                </div>
                                <div class="pcs-choice-info">
                                    <div class="pcs-choice-name">@roughness.Name</div>
                                    <div class="pcs-choice-sub">@roughness.Description</div>
                                </div>
                                @if (active)
                                {
                                    <div class="pcs-card-check">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </div>
                                }
                            </button>
                        }
                    </div>
                </section>
            }

            @* ── Part Features ───────────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Part Features</span>
                    <span class="pcs-section-count">2 options</span>
                </div>
                <div class="pcs-feature-toggle-grid">
                    <button class="pcs-choice-card pcs-feature-card @(Part!.HasThreadedHoles ? "pcs-choice-card--active" : "")"
                            @onclick="@(() => OnThreadedHolesChanged(!Part!.HasThreadedHoles))">
                        <div class="pcs-choice-swatch">
                            <MudIcon Icon="@Icons.Material.Outlined.Construction" Size="Size.Small" />
                        </div>
                        <div class="pcs-choice-info">
                            <div class="pcs-choice-name">Tapped holes</div>
                            <div class="pcs-choice-sub">Internal threads cut into the part.</div>
                        </div>
                        @if (Part!.HasThreadedHoles)
                        {
                            <div class="pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                        }
                    </button>
                    <button class="pcs-choice-card pcs-feature-card @(Part!.HasInserts ? "pcs-choice-card--active" : "")"
                            @onclick="@(() => OnInsertsChanged(!Part!.HasInserts))">
                        <div class="pcs-choice-swatch">
                            <MudIcon Icon="@Icons.Material.Outlined.Hardware" Size="Size.Small" />
                        </div>
                        <div class="pcs-choice-info">
                            <div class="pcs-choice-name">Thread inserts</div>
                            <div class="pcs-choice-sub">Installed threaded hardware such as Helicoil or heat-set inserts.</div>
                        </div>
                        @if (Part!.HasInserts)
                        {
                            <div class="pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                        }
                    </button>
                </div>
                @if (Part!.RequiresThreadSpecificationDrawing && !Part.HasRequiredThreadSpecificationDrawing)
                {
                    <MudAlert Severity="Severity.Warning"
                              Variant="Variant.Text"
                              Dense="true"
                              Class="pcs-feature-warning">
                        Upload a drawing for this part so production has the thread specification.
                    </MudAlert>
                }
            </section>

            @* ── Process Options (anodize color, paint color, etc.) ─────────── *@
            @{
                var visibleOptions = VisibleProcessOptions.ToList();
            }
            @if (visibleOptions.Count > 0)
            {
                <section class="pcs-section">
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Options</span>
                        <span class="pcs-section-count">@visibleOptions.Count options</span>
                    </div>
                    <div class="pcs-options-stack">
                        @foreach (var opt in visibleOptions)
                        {
                            <div class="pcs-option-row">
                                @if (IsBooleanOption(opt))
                                {
                                    var enabled = GetProcessOptionBool(opt.ConfigKey);
                                    <button class="pcs-choice-card @(enabled ? "pcs-choice-card--active" : "")"
                                            @onclick="@(() => OnProcessOptionBoolChanged(opt.ConfigKey, !enabled))">
                                        <div class="pcs-choice-swatch">
                                            <MudIcon Icon="@GetBooleanOptionIcon(opt)" Size="Size.Small" />
                                        </div>
                                        <div class="pcs-choice-info">
                                            <div class="pcs-choice-name">@opt.Label</div>
                                            @if (!string.IsNullOrWhiteSpace(opt.HelpText))
                                            {
                                                <div class="pcs-choice-sub">@opt.HelpText</div>
                                            }
                                        </div>
                                        @if (enabled)
                                        {
                                            <div class="pcs-card-check">
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            </div>
                                        }
                                    </button>
                                }
                                else if (IsPaintColorOption(opt))
                                {
                                    var paintHex = GetProcessOptionValue(PaintColorHexKey, string.Empty);
                                    var paintReference = GetProcessOptionValue(PaintColorReferenceKey, string.Empty);
                                    var customPaintSelected = IsCustomPaintColorSelected(paintHex, paintReference);
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-color-choice-grid">
                                        @foreach (var paint in StandardPaintColors)
                                        {
                                            var active = IsPaintColorSelected(paint, paintHex, paintReference);
                                            <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                    @onclick="@(() => OnStandardPaintColorChanged(opt.ConfigKey, paint))">
                                                <span class="pcs-color-chip" style="background: @paint.Hex" />
                                                <span>@paint.Name</span>
                                                @if (active)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                }
                                            </button>
                                        }
                                        <button class="pcs-color-choice @(customPaintSelected ? "pcs-color-choice--active" : "")"
                                                @onclick="@(() => OnCustomPaintColorSelected(opt.ConfigKey))">
                                            <span class="pcs-color-chip" style="background: @(string.IsNullOrWhiteSpace(paintHex) ? "linear-gradient(135deg, #d8dce4, #a8aeb8)" : paintHex)" />
                                            <span>Custom</span>
                                            @if (customPaintSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    </div>
                                    @if (customPaintSelected)
                                    {
                                        <div class="pcs-color-picker-row">
                                            <label class="pcs-native-color">
                                                <span>Custom color</span>
                                                <input type="color"
                                                       value="@GetProcessOptionValue(PaintColorHexKey, "#111111")"
                                                       @onchange="@(e => OnPaintColorHexChanged(opt.ConfigKey, e.Value?.ToString()))" />
                                            </label>
                                            <MudTextField T="string"
                                                          Label="Custom color name/code"
                                                          Value="@paintReference"
                                                          ValueChanged="@(val => OnPaintColorReferenceChanged(opt.ConfigKey, val))"
                                                          Placeholder="RAL 9005, Pantone Black C..."
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          FullWidth="true" />
                                        </div>
                                    }
                                }
                                else if (IsColorChoiceOption(opt))
                                {
                                    var currentValue = Part!.ProcessOptionValues.TryGetValue(opt.ConfigKey, out var v) ? v : opt.DefaultValue;
                                    var options = GetOptionChoices(opt).ToList();
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-color-choice-grid">
                                        @foreach (var o in options)
                                        {
                                            var active = string.Equals(currentValue, o, StringComparison.OrdinalIgnoreCase);
                                            <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                    @onclick="@(() => OnProcessOptionValueChanged(opt.ConfigKey, o))">
                                                <span class="pcs-color-chip" style="background: @GetOptionColor(o)" />
                                                <span>@FormatOptionLabel(o)</span>
                                                @if (active)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                else if (IsCardChoiceOption(opt))
                                {
                                    var currentValue = Part!.ProcessOptionValues.TryGetValue(opt.ConfigKey, out var v) ? v : opt.DefaultValue;
                                    var options = GetOptionChoices(opt).ToList();
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-cards">
                                        @foreach (var o in options)
                                        {
                                            var active = string.Equals(currentValue, o, StringComparison.OrdinalIgnoreCase);
                                            <button class="pcs-choice-card @(active ? "pcs-choice-card--active" : "")"
                                                    @onclick="@(() => OnProcessOptionValueChanged(opt.ConfigKey, o))">
                                                <div class="pcs-choice-swatch">
                                                    <MudIcon Icon="@GetOptionIcon(opt.ConfigKey)" Size="Size.Small" />
                                                </div>
                                                <div class="pcs-choice-info">
                                                    <div class="pcs-choice-name">@FormatOptionLabel(o)</div>
                                                    @if (!string.IsNullOrWhiteSpace(opt.HelpText))
                                                    {
                                                        <div class="pcs-choice-sub">@opt.HelpText</div>
                                                    }
                                                </div>
                                                @if (active)
                                                {
                                                    <div class="pcs-card-check">
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                    </div>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var currentText = Part!.ProcessOptionValues.TryGetValue(opt.ConfigKey, out var tv) ? tv : opt.DefaultValue;
                                    <MudTextField T="string" Label="@opt.Label" Value="@currentText"
                                                  ValueChanged="@(val => OnProcessOptionValueChanged(opt.ConfigKey, val))"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  HelperText="@opt.HelpText" FullWidth="true" />
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @* ── Quality ─────────────────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Inspection</span>
                    <span class="pcs-section-count">@InspectionOptions.Count options</span>
                </div>
                <div class="pcs-cards">
                    @foreach (var inspection in InspectionOptions)
                    {
                        var active = Part!.InspectionLevel == inspection.Level;
                        <button class="pcs-choice-card @(active ? "pcs-choice-card--active" : "")"
                                @onclick="@(() => OnInspectionChanged(inspection.Level))">
                            <div class="pcs-choice-swatch">
                                <MudIcon Icon="@inspection.Icon" Size="Size.Small" />
                            </div>
                            <div class="pcs-choice-info">
                                <div class="pcs-choice-name">@inspection.Name</div>
                                <div class="pcs-choice-sub">@inspection.Description</div>
                            </div>
                            @if (active)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                    }
                </div>
            </section>

            @* ── Quantity ─────────────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Quantity</span>
                    @if (_bulkTiers.Count > 0)
                    {
                        <span class="pcs-bulk-badge">@(ComputeBulkDiscount())% bulk off</span>
                    }
                </div>
                <div class="pcs-qty-row">
                    <button class="pcs-qty-btn"
                            @onclick="@(() => OnQuantityChanged(Math.Max(1, Part!.Quantity - 1)))">−</button>
                    <input type="number" class="pcs-qty-input" value="@Part!.Quantity" min="1" max="999999"
                           @onchange="@(e => OnQuantityChanged(int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(1, q) : 1))" />
                    <button class="pcs-qty-btn" @onclick="@(() => OnQuantityChanged(Part!.Quantity + 1))">+</button>
                </div>
                <div class="pcs-qty-presets">
                    @foreach (var q in new[] { 1, 10, 25, 50, 100 })
                    {
                        <button class="pcs-qty-preset @(Part!.Quantity == q ? "pcs-qty-preset--active" : "")"
                                @onclick="@(() => OnQuantityChanged(q))">@q</button>
                    }
                </div>
                @if (_bulkTiers.Count > 0)
                {
                    <BulkPricingTable Tiers="@_bulkTiers" CurrentQuantity="@Part!.Quantity" />
                }
            </section>
        </div>

        @* ── Production Routing ───────────────────────────────────────────── *@
        @if (Part!.ProductionRouting != null || Part.ProductionRoutingLoading)
        {
            <div class="pcs-footer">
                <div class="pcs-routing-card">
                    <div class="pcs-routing-header" role="button" tabindex="0"
                         @onclick="@(() => _routingExpanded = !_routingExpanded)"
                         @onkeydown="@((e) => { if (e.Key == "Enter" || e.Key == " ") _routingExpanded = !_routingExpanded; })">
                        <div class="pcs-routing-title">
                            <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="pcs-routing-title-text">Production Routing &amp; Queue</MudText>
                        </div>
                        <MudIcon
                        Icon="@(_routingExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </div>
                    <div class="pcs-routing-body @(_routingExpanded ? "" : "pcs-collapsed")">
                        @if (Part!.ProductionRoutingLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Class="mb-2" />
                        }
                        else if (Part!.ProductionRouting != null)
                        {
                            <div class="pcs-routing-row">
                                <span>@Part!.ProductionRouting?.MachineCode — @Part!.ProductionRouting?.MachineName</span>
                            </div>
                            <div class="pcs-routing-row">
                                <span>Queue Position</span>
                                <span class="pcs-routing-warn">@Part!.ProductionRouting?.QueueAhead
                                    job@(Part!.ProductionRouting?.QueueAhead == 1 ? "" : "s") ahead</span>
                                </div>
                                <div class="pcs-routing-row">
                                    <span>Est. Start Date</span>
                                    <span>@Part!.ProductionRouting?.EstimatedStartDate.ToString("d MMM yyyy")</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.CalendarMonth"
                                           OnClick="OpenScheduleDialog" Class="pcs-schedule-btn">
                                    View Planning Schedule
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .pcs-root {
                width: 340px;
                flex: 0 0 340px;
                display: flex;
                flex-direction: column;
                height: 100%;
                overflow: hidden;
                background: var(--maliev-panel);
                border-left: 1px solid var(--maliev-border);
            }
            .pcs-root.pcs-root--inline {
                width: 100%;
                min-width: 0;
                flex: 1 1 auto;
                height: auto;
                max-height: none;
                overflow: visible;
                border-left: none;
                border-top: 1px solid var(--maliev-border);
            }
            .pcs-root.pcs-root--inline .pcs-scroll {
                overflow: visible;
                min-height: 0;
            }
            .pcs-root.pcs-root--inline .pcs-footer {
                position: static;
            }

            .pcs-empty-state {
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
                color: var(--maliev-muted);
            }

            .pcs-header {
                padding: 10px 14px;
                border-bottom: 1px solid var(--maliev-border);
                display: flex;
                align-items: center;
                gap: 10px;
                background: var(--maliev-panel-3);
                flex-shrink: 0;
            }

            .pcs-header-label {
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--maliev-muted);
            }

            .pcs-header-name {
                flex: 1;
                font-size: 13px;
                font-weight: 600;
                color: var(--maliev-ink);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .pcs-header-actions {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                flex-shrink: 0;
            }

            .pcs-header-icon-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 28px;
                height: 28px;
                padding: 0;
                border: 1px solid var(--maliev-border);
                border-radius: var(--maliev-radius-sm);
                background: var(--maliev-panel);
                color: var(--mud-palette-primary);
