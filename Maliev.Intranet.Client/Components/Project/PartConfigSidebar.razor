                padding: 7px 8px 8px;
                text-align: left;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .pcs-process-name {
                line-height: 1.2;
                text-align: left;
                font-weight: 700;
                color: var(--maliev-text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .pcs-process-category {
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                color: var(--pcs-process-active);
                opacity: 0.72;
                margin-bottom: 1px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .pcs-process-description {
                margin-top: 3px;
                color: var(--maliev-muted);
                font-size: var(--mud-typography-caption-size);
                font-weight: 400;
                line-height: 1.35;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .pcs-process-search {
                flex-shrink: 0;
                padding: 0 0 6px;
            }

            .pcs-process-search-input {
                width: 100%;
                box-sizing: border-box;
                background: var(--maliev-panel-3);
                border: 1px solid var(--maliev-border);
                border-radius: 6px;
                padding: 6px 10px;
                font-size: var(--mud-typography-caption-size);
                font-family: inherit;
                color: var(--maliev-text);
                outline: none;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

            .pcs-process-search-input::placeholder {
                color: var(--maliev-muted);
                opacity: 0.6;
            }

            .pcs-process-search-input:focus {
                border-color: var(--pcs-process-active);
                box-shadow: 0 0 0 2px color-mix(in oklch, var(--pcs-process-active) 18%, transparent);
            }

            .pcs-process-search-input::-webkit-search-cancel-button { display: none; }
            .pcs-process-search-input::-ms-clear { display: none; }

            .pcs-process-no-results {
                text-align: center;
                color: var(--maliev-muted);
                font-size: var(--mud-typography-caption-size);
                padding: 24px 8px;
                opacity: 0.7;
            }

            /* ── Material / Finish Cards ───────────────────────────────────────── */
            .pcs-cards {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .pcs-cards,
            .pcs-feature-toggle-grid,
            .pcs-option-row,
            .pcs-tol-grid,
            .pcs-color-choice-grid {
                position: relative;
                overflow: visible;
                z-index: 0;
            }

            .pcs-cards:has(.pcs-option-image-frame:hover),
            .pcs-cards:has(.pcs-option-image-frame:focus-within),
            .pcs-feature-toggle-grid:has(.pcs-option-image-frame:hover),
            .pcs-feature-toggle-grid:has(.pcs-option-image-frame:focus-within),
            .pcs-option-row:has(.pcs-option-image-frame:hover),
            .pcs-option-row:has(.pcs-option-image-frame:focus-within),
            .pcs-tol-grid:has(.pcs-option-image-frame:hover),
            .pcs-tol-grid:has(.pcs-option-image-frame:focus-within),
            .pcs-color-choice-grid:has(.pcs-option-image-frame:hover),
            .pcs-color-choice-grid:has(.pcs-option-image-frame:focus-within) {
                z-index: 260;
            }

            .pcs-mat-card,
            .pcs-fin-card {
                padding: 8px 10px;
                border: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                border-radius: 5px;
                cursor: pointer;
                display: grid;
                grid-template-columns: 66px minmax(0, 1fr) 18px;
                align-items: center;
                gap: 10px;
                text-align: left;
                transition: all 0.15s;
                position: relative;
                z-index: 0;
                min-height: 74px;
            }

            .pcs-mat-card {
                padding: 8px 10px;
            }

            .pcs-fin-card {
                grid-template-columns: 66px minmax(0, 1fr) max-content 18px;
            }

            .pcs-mat-card:hover,
            .pcs-fin-card:hover {
                background: var(--maliev-panel-3);
            }

            .pcs-mat-card:has(.pcs-option-image-frame:hover),
            .pcs-mat-card:has(.pcs-option-image-frame:focus-within),
            .pcs-fin-card:has(.pcs-option-image-frame:hover),
            .pcs-fin-card:has(.pcs-option-image-frame:focus-within),
            .pcs-choice-card:has(.pcs-option-image-frame:hover),
            .pcs-choice-card:has(.pcs-option-image-frame:focus-within),
            .pcs-color-choice:has(.pcs-option-image-frame:hover),
            .pcs-color-choice:has(.pcs-option-image-frame:focus-within) {
                z-index: 320;
            }

            .pcs-mat-card--active,
            .pcs-fin-card--active {
                border-color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent);
            }

            .pcs-mat-swatch,
            .pcs-fin-swatch,
            .pcs-choice-swatch,
            .pcs-color-chip {
                width: 58px;
                height: 58px;
                border-radius: 5px;
                flex-shrink: 0;
                box-shadow: inset 0 -4px 8px rgba(0, 0, 0, 0.1), inset 0 1px 2px rgba(255, 255, 255, 0.5);
                border: 1px solid rgba(0, 0, 0, 0.08);
            }

            .pcs-option-image-frame {
                position: relative;
                display: grid;
                place-items: center;
                overflow: visible;
                background: #fff;
                color: var(--mud-palette-primary);
            }

            .pcs-option-image-frame--small {
                width: 58px;
                height: 58px;
            }

            .pcs-option-image {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: contain;
                background: #fff;
                border-radius: inherit;
            }

            .pcs-option-image-fallback {
                position: absolute;
                inset: 0;
                display: grid;
                place-items: center;
                background: #fff;
            }

            .pcs-option-image-fallback[hidden] {
                display: none;
            }

            .pcs-image-preview-popout {
                position: absolute;
                left: calc(100% + 10px);
                top: 50%;
                z-index: 340;
                width: min(220px, 64vw);
                aspect-ratio: 1 / 1;
                padding: 6px;
                border: 1px solid color-mix(in oklch, var(--mud-palette-primary) 32%, var(--maliev-border));
                border-radius: 8px;
                background: var(--maliev-panel);
                box-shadow: 0 14px 34px rgba(15, 23, 42, 0.22);
                opacity: 0;
                pointer-events: none;
                transform: translateY(-50%) translateX(-4px) scale(0.98);
                transition: opacity 0.12s ease, transform 0.12s ease;
            }

            .pcs-option-image-frame:hover,
            .pcs-option-image-frame:focus-within {
                z-index: 330;
            }

            .pcs-option-image-frame:hover .pcs-image-preview-popout,
            .pcs-option-image-frame:focus-within .pcs-image-preview-popout {
                opacity: 1;
                transform: translateY(-50%) translateX(0) scale(1);
            }

            .pcs-image-preview {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 5px;
                background: #fff;
            }

            .pcs-mat-info,
            .pcs-fin-info {
                flex: 1;
                min-width: 0;
            }

            .pcs-mat-name,
            .pcs-fin-name {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--maliev-ink);
            }

            .pcs-mat-sub,
            .pcs-fin-sub {
                font-size: 10.5px;
                color: var(--maliev-muted);
            }

            .pcs-fin-price {
                grid-column: 3;
                justify-self: end;
                font-size: 10.5px;
                color: var(--maliev-muted);
                font-family: 'JetBrains Mono', monospace;
                flex-shrink: 0;
                text-align: right;
                white-space: nowrap;
            }

            .pcs-fin-card .pcs-card-check {
                grid-column: 4;
            }

            .pcs-card-check {
                color: var(--mud-palette-primary);
                flex-shrink: 0;
                align-self: center;
                justify-self: end;
            }

            /* ── Right action column: check + Change button for selected cards ── */
            .pcs-card-right {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                justify-content: space-between;
                gap: 6px;
                align-self: stretch;
                flex-shrink: 0;
            }

            .pcs-card-right .pcs-card-check {
                align-self: auto;
                justify-self: auto;
            }

            .pcs-card-right .pcs-process-change-btn {
                align-self: auto;
                margin-top: 0;
            }

            .pcs-card-right .pcs-fin-price {
                grid-column: auto;
                justify-self: auto;
                white-space: nowrap;
            }

            /* Override grid for all selected cards to use auto last column */
            .pcs-mat-card--selected,
            .pcs-choice-card--selected {
                grid-template-columns: 66px minmax(0, 1fr) auto;
                align-items: stretch;
            }

            .pcs-fin-card--selected {
                grid-template-columns: 66px minmax(0, 1fr) auto;
                align-items: stretch;
            }

            /* ── Tolerance Grid ─────────────────────────────────────────────────── */
            .pcs-tolerance-groups {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .pcs-tolerance-group {
                border: 1px solid var(--maliev-border);
                border-radius: 6px;
                padding: 7px;
                background: var(--maliev-panel);
            }

            .pcs-tolerance-group--iso {
                border-color: color-mix(in oklch, var(--mud-palette-primary) 24%, var(--maliev-border));
                background: color-mix(in oklch, var(--mud-palette-primary) 6%, var(--maliev-panel));
            }

            .pcs-tolerance-group--it {
                border-color: color-mix(in oklch, var(--mud-palette-info) 24%, var(--maliev-border));
                background: color-mix(in oklch, var(--mud-palette-info) 6%, var(--maliev-panel));
            }

            .pcs-tolerance-group--process {
                background: var(--maliev-panel-2);
            }

            .pcs-tolerance-group-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 8px;
                margin-bottom: 6px;
            }

            .pcs-tolerance-group-title {
                font-size: var(--mud-typography-caption-size);
                font-weight: 700;
                color: var(--maliev-ink);
                line-height: 1.2;
                letter-spacing: 0;
            }

            .pcs-tolerance-group-standard {
                margin-top: 1px;
                font-size: var(--mud-typography-caption-size);
                color: var(--maliev-muted);
                line-height: 1.2;
                letter-spacing: 0;
            }

            .pcs-tolerance-group-count {
                min-width: 20px;
                height: 20px;
                padding: 0 6px;
                border: 1px solid var(--maliev-border);
                border-radius: 999px;
                background: var(--maliev-panel);
                color: var(--maliev-muted);
                display: inline-grid;
                place-items: center;
                font-size: var(--mud-typography-caption-size);
                font-weight: 700;
                line-height: 1;
                letter-spacing: 0;
            }

            .pcs-tolerance-empty {
                border: 1px dashed var(--maliev-border);
                border-radius: 6px;
                padding: 10px;
                color: var(--maliev-muted);
                font-size: var(--mud-typography-caption-size);
                letter-spacing: 0;
            }

            .pcs-tol-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 4px;
            }

            .pcs-tol-card {
                padding: 7px 8px;
                border: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                border-radius: 5px;
                cursor: pointer;
                text-align: left;
                transition: all 0.15s;
                display: grid;
                grid-template-columns: 1fr auto;
                grid-template-rows: auto auto auto;
                align-items: center;
                gap: 0 4px;
            }

            .pcs-tol-card:hover {
                background: var(--maliev-panel-3);
            }

            .pcs-tol-card--active {
                border-color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent);
            }

            .pcs-tol-name {
                grid-column: 1;
                grid-row: 1;
                font-size: 11.5px;
                font-weight: 600;
                color: var(--maliev-ink);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                min-width: 0;
            }

            .pcs-tol-grade {
                grid-column: 1;
                grid-row: 2;
                font-size: 10px;
                color: var(--maliev-muted);
                font-family: 'JetBrains Mono', monospace;
                margin-top: 1px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                min-width: 0;
            }

            .pcs-tol-range {
                grid-column: 1;
                grid-row: 3;
                font-size: 10px;
                color: var(--mud-palette-primary);
                font-family: 'JetBrains Mono', monospace;
                margin-top: 3px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                min-width: 0;
            }

            .pcs-tol-check {
                grid-column: 2;
                grid-row: 1 / 4;
                display: grid;
                place-items: center;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: var(--mud-palette-primary);
                color: #fff;
                align-self: center;
            }

            /* ── Process Options ──────────────────────────────────────────────── */
            .pcs-options-stack {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .pcs-option-row {
                width: 100%;
            }

            .pcs-feature-toggle-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 4px;
            }

            .pcs-feature-warning {
                margin-top: 8px;
            }

            .pcs-option-label {
                font-size: 11px;
                font-weight: 600;
                color: var(--maliev-ink);
                margin-bottom: 6px;
            }

            .pcs-option-help {
                font-size: 10.5px;
                color: var(--maliev-muted);
                margin: 4px 2px 0;
                line-height: 1.35;
            }

            .pcs-color-choice-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                gap: 6px;
            }

            .pcs-color-choice {
                min-height: 74px;
                border: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                color: var(--maliev-ink);
                border-radius: 5px;
                display: grid;
                grid-template-columns: 66px minmax(0, 1fr) 18px;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                font-size: 11.5px;
                font-weight: 600;
                cursor: pointer;
                text-align: left;
                position: relative;
            }

            .pcs-color-choice > .mud-icon-root {
                justify-self: end;
            }

            .pcs-color-choice--active {
                border-color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent);
            }

            .pcs-color-chip {
                width: 58px;
                height: 58px;
                border-radius: 5px;
                border: 1px solid rgba(0, 0, 0, 0.18);
                box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.45);
                flex-shrink: 0;
            }

            .pcs-choice-card {
                padding: 8px 10px;
                border: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                border-radius: 5px;
                cursor: pointer;
                display: grid;
                grid-template-columns: 66px minmax(0, 1fr) 18px;
                align-items: center;
                gap: 10px;
                text-align: left;
                transition: all 0.15s;
                position: relative;
                min-height: 74px;
            }

            .pcs-choice-card:hover {
                background: var(--maliev-panel-3);
            }

            .pcs-choice-card--active {
                border-color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent);
            }

            .pcs-choice-card--disabled,
            .pcs-choice-card:disabled {
                cursor: not-allowed;
                opacity: 0.55;
            }

            .pcs-choice-card--disabled:hover,
            .pcs-choice-card:disabled:hover {
                background: var(--maliev-panel);
            }

            .pcs-choice-swatch {
                width: 58px;
                height: 58px;
                border-radius: 5px;
                flex-shrink: 0;
                display: grid;
                place-items: center;
                color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 10%, transparent);
                border: 1px solid color-mix(in oklch, var(--mud-palette-primary) 25%, transparent);
            }

            .pcs-choice-swatch.pcs-option-image-frame {
                background: #fff;
                color: var(--mud-palette-primary);
            }

            .pcs-choice-swatch--metal {
                color: #667085;
                background: linear-gradient(135deg, #f1f3f6, #c8ced8);
                border-color: #b8bfcc;
            }

            .pcs-choice-info {
                flex: 1;
                min-width: 0;
            }

            .pcs-choice-name {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--maliev-ink);
            }

            .pcs-choice-sub {
                font-size: 10.5px;
                color: var(--maliev-muted);
                line-height: 1.3;
            }

            .pcs-color-picker-row {
                display: grid;
                grid-template-columns: 88px 1fr;
                gap: 8px;
                align-items: start;
            }

            .pcs-native-color {
                display: flex;
                flex-direction: column;
                gap: 5px;
                font-size: 10.5px;
                font-weight: 600;
                color: var(--maliev-muted);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .pcs-native-color input {
                width: 100%;
                height: 40px;
                padding: 3px;
                border: 1px solid var(--maliev-border);
                border-radius: 5px;
                background: var(--maliev-panel);
                cursor: pointer;
            }

            /* ── Quantity ─────────────────────────────────────────────────────── */
            .pcs-bulk-badge {
                font-size: 10.5px;
                color: var(--maliev-ok);
                font-weight: 600;
            }

            .pcs-qty-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 8px;
            }

            .pcs-qty-btn {
                width: 30px;
                height: 30px;
                border: 1px solid var(--maliev-border);
                border-radius: 4px;
                background: var(--maliev-panel);
                font-size: 16px;
                color: var(--maliev-muted);
                cursor: pointer;
                font-weight: 500;
                display: grid;
                place-items: center;
            }

            .pcs-qty-btn:hover {
                background: var(--maliev-panel-3);
            }

            .pcs-qty-input {
                flex: 1;
                height: 30px;
                border: 1px solid var(--maliev-border);
                border-radius: 4px;
                text-align: center;
                font-size: 14px;
                font-weight: 600;
                font-family: 'JetBrains Mono', monospace;
                color: var(--maliev-ink);
                background: var(--maliev-panel);
                outline: none;
            }

            .pcs-qty-input:focus {
                border-color: var(--mud-palette-primary);
            }

            .pcs-qty-presets {
                display: flex;
                gap: 4px;
                margin-bottom: 8px;
            }

            .pcs-qty-preset {
                flex: 1;
                padding: 5px 0;
                border: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                color: var(--maliev-muted);
                border-radius: 4px;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                font-family: 'JetBrains Mono', monospace;
                transition: all 0.15s;
            }

            .pcs-qty-preset:hover {
                background: var(--maliev-panel-3);
                color: var(--maliev-ink);
            }

            .pcs-qty-preset--active {
                border-color: var(--mud-palette-primary);
                background: color-mix(in oklch, var(--mud-palette-primary) 12%, transparent);
                color: var(--mud-palette-primary);
            }

            .pcs-notes-input {
                width: 100%;
                min-height: 96px;
                padding: 8px 10px;
                border: 1px solid var(--maliev-border);
                border-radius: var(--maliev-radius-sm);
                background: var(--maliev-panel);
                color: var(--maliev-ink);
                font: inherit;
                font-size: 12px;
                line-height: 1.4;
                resize: vertical;
                outline: none;
            }

            .pcs-notes-input:focus {
                border-color: var(--mud-palette-primary);
                box-shadow: 0 0 0 2px var(--maliev-accent-soft);
            }

            /* ── Production Routing Footer ────────────────────────────────────── */
            .pcs-footer {
                border-top: 1px solid var(--maliev-border);
                background: var(--maliev-panel);
                flex-shrink: 0;
                position: relative;
                z-index: 180;
            }

            .pcs-routing-card {
                padding: 0;
            }

            .pcs-routing-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 14px;
                cursor: pointer;
                user-select: none;
            }

            .pcs-routing-title {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pcs-routing-title-text {
                margin: 0;
            }

            .pcs-routing-body {
                padding: 0 14px 10px;
                transition: all 0.2s;
            }

            .pcs-routing-body.pcs-collapsed {
                display: none;
            }

            .pcs-routing-row {
                display: flex;
                justify-content: space-between;
                font-size: 12px;
                color: var(--maliev-muted);
                padding: 3px 0;
            }

            .pcs-routing-warn {
                color: var(--maliev-warn);
                font-weight: 600;
            }

            .pcs-schedule-btn {
                width: 100%;
                margin-top: 12px;
                height: 36px;
                font-weight: 600;
                color: var(--mud-palette-primary) !important;
                background: color-mix(in oklch, var(--mud-palette-primary) 8%, transparent) !important;
                border: 1px dashed var(--mud-palette-primary) !important;
            }

            @@media (max-width: 1200px) {
                .pcs-root {
                    width: 100%;
                    flex: 1 1 auto;
                    height: auto;
                    overflow: visible;
                    border-left: none;
                    border-top: 1px solid var(--maliev-border);
                }

                .pcs-scroll {
                    overflow: visible;
                }

                .pcs-root.pcs-root--inline .pcs-scroll {
                    column-count: 2;
                    column-width: auto;
                    padding: 10px;
                }

