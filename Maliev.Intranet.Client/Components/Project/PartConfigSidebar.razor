@code {
    private static readonly Dictionary<string, string> MaterialGradients = new()
    {
        ["al6061"] = "linear-gradient(135deg, #d8dce4, #a8aeb8)",
        ["al7075"] = "linear-gradient(135deg, #cfd4dc, #9ba0ab)",
        ["ss304"] = "linear-gradient(135deg, #e8ecf0, #b5bac5)",
        ["ss316"] = "linear-gradient(135deg, #dfe3ea, #a7adba)",
        ["brass"] = "linear-gradient(135deg, #e6cf8e, #b4954a)",
        ["delrin"] = "linear-gradient(135deg, #fafafa, #dcdcdc)",
        ["pla"] = "linear-gradient(135deg, #2a6df4, #1a4dc4)",
        ["petg"] = "linear-gradient(135deg, #cff4f0, #7ac6c0)",
        ["abs"] = "linear-gradient(135deg, #333, #111)",
        ["nylon"] = "linear-gradient(135deg, #4a4a50, #1a1a20)",
        ["tough-2000"] = "linear-gradient(135deg, #e8e2d4, #b8ae9a)",
        ["clear"] = "linear-gradient(135deg, #eef4fb, #b8ccdd)",
        ["high-temp"] = "linear-gradient(135deg, #dcc8b4, #8a6b4a)",
        ["pa12"] = "linear-gradient(135deg, #f0ede4, #c8c4b4)",
        ["steel-mild"] = "linear-gradient(135deg, #8a909a, #4a505a)",
    };

    private static readonly Dictionary<string, string> FinishGradients = new()
    {
        ["machined"] = "linear-gradient(135deg, #e8ecf2, #c0c6d0)",
        ["bead-blast"] = "#d4d8e0",
        ["anodized-clear"] = "linear-gradient(135deg, #cdd2da, #959aa4)",
        ["anodized-black"] = "linear-gradient(135deg, #2a2e36, #0a0e14)",
        ["powder"] = "linear-gradient(135deg, #2a3040, #10141c)",
        ["as-printed"] = "repeating-linear-gradient(0deg, #d4d8e0, #d4d8e0 2px, #c4c8d0 2px, #c4c8d0 3px)",
        ["sanded"] = "linear-gradient(135deg, #e2e6ec, #b8bcc4)",
        ["uv-cured"] = "linear-gradient(135deg, #e8e2d4, #a8a294)",
        ["painted"] = "linear-gradient(135deg, #2a6df4, #1a4dc4)",
        ["natural"] = "linear-gradient(135deg, #f0ede4, #c8c4b4)",
        ["turned"] = "repeating-linear-gradient(90deg, #d4d8e0, #d4d8e0 1px, #b8bcc4 1px, #b8bcc4 2px)",
        ["raw"] = "linear-gradient(135deg, #9aa0aa, #6a7080)",
    };

    private static readonly string DefaultGradient = "linear-gradient(135deg, #d8dce4, #a8aeb8)";

    private static string GetMaterialGradient(string? code) =>
        string.IsNullOrEmpty(code) || !MaterialGradients.TryGetValue(code, out var g)
            ? DefaultGradient : g;

    private static string GetFinishGradient(string? code) =>
        string.IsNullOrEmpty(code) || !FinishGradients.TryGetValue(code, out var g)
            ? FinishGradients["machined"]! : g;

    private int ComputeBulkDiscount()
    {
        if (Part == null || _bulkTiers.Count == 0) return 0;
        var activeTier = _bulkTiers.Where(t => t.Quantity <= Part.Quantity)
            .OrderByDescending(t => t.Quantity)
            .FirstOrDefault();
        if (activeTier == null) return 0;
        var firstTier = _bulkTiers.OrderBy(t => t.Quantity).FirstOrDefault();
        if (firstTier == null || firstTier.UnitPrice == 0) return 0;
        return (int)Math.Round((1 - activeTier.UnitPrice / firstTier.UnitPrice) * 100);
    }
}
