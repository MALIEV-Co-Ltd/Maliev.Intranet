@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared

@if (Part == null)
{
    <div class="pcs-sidebar pcs-empty-state">
        <div class="pcs-empty">
            <MudText Typo="Typo.body2" Color="Color.Secondary">Select a part to configure</MudText>
        </div>
    </div>
    return;
}

<div class="pcs-sidebar @(DisplayMode == PartConfigSidebarDisplayMode.Inline ? "pcs-inline" : "")">
    @if (DisplayMode == PartConfigSidebarDisplayMode.Sidebar)
    {
    <div class="pcs-header">
        <MudText Typo="Typo.h6" Class="pcs-part-name">@Part!.Name</MudText>
        @if (Part!.FileId != Guid.Empty && Part!.Dimensions == null)
        {
            <MudSkeleton Width="120px" Height="12px" Class="mb-1" />
            <MudSkeleton Width="80px" Height="10px" />
        }
        else if (Part!.Dimensions != null)
        {
            var dims = Part!.Dimensions;
            <MudText Typo="Typo.caption" Class="pcs-dim">
                @($"{dims.X:N1} × {dims.Y:N1} × {dims.Z:N1} mm")
                @if (Part!.VolumeMm3.HasValue)
                {
                    <text> · @((Part!.VolumeMm3.Value / 1000.0).ToString("F2")) cm³</text>
                }
            </MudText>
        }
    </div>
    }

    <div class="pcs-scroll">

        @* ── Section A: Logistics & Pricing ──────────────────────────────── *@
        <div class="pcs-section">
            <MudText Typo="Typo.overline" Class="pcs-section-label">Logistics &amp; Pricing</MudText>

            <div class="pcs-qty-row">
                <div class="pcs-field" style="flex: 1;">
                    <MudText Typo="Typo.caption" Class="pcs-field-label">Quantity</MudText>
                    <MudNumericField T="int"
                                     Value="@Part!.Quantity"
                                     ValueChanged="@((int qty) => OnQuantityChanged(qty))"
                                     Min="1"
                                     Max="10000"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </div>
                <div class="pcs-field pcs-bag-field" style="flex: 2;">
                    <MudText Typo="Typo.caption" Class="pcs-field-label">Bag &amp; Tag</MudText>
                    <MudChipSet T="string"
                                SelectionMode="SelectionMode.ToggleSelection"
                                CheckMark="true"
                                Color="Color.Default"
                                SelectedColor="Color.Primary"
                                Size="Size.Small"
                                SelectedValues="@(Part!.BagAndTag ? ["BagAndTag"] : [])"
                                SelectedValuesChanged="@OnBagAndTagChanged">
                        <MudChip T="string" Value="@("BagAndTag")">Bag &amp; Tag</MudChip>
                    </MudChipSet>
                </div>
            </div>

            <BulkPricingTable Tiers="@_bulkTiers" CurrentQuantity="@Part!.Quantity" CurrencyCode="@CurrencyCode" />
        </div>

        @* ── Section B: Manufacturing ─────────────────────────────────────── *@
        <div class="pcs-section">
            <MudText Typo="Typo.overline" Class="pcs-section-label">Manufacturing</MudText>

            <div class="pcs-field">
                <MudText Typo="Typo.caption" Class="pcs-field-label">Process</MudText>
                <MudSelect T="ProcessDto"
                           Value="@SelectedProcess"
                           ValueChanged="@((ProcessDto? p) => OnProcessChanged(p))"
                           ToStringFunc="@(p => p?.Name ?? string.Empty)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Label=""
                           Placeholder="">
                    @foreach (var proc in Processes)
                    {
                        <MudSelectItem T="ProcessDto" Value="@proc">@proc.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="pcs-field">
                <MudText Typo="Typo.caption" Class="pcs-field-label">Material</MudText>
                <MudSelect T="CatalogMaterialDto"
                           Value="@SelectedMaterial"
                           ValueChanged="@((CatalogMaterialDto? m) => OnMaterialChanged(m))"
                           ToStringFunc="@(m => m?.Name ?? string.Empty)"
                           Disabled="@(Part!.AvailableMaterials.Count == 0)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Label=""
                           Placeholder="">
                    @foreach (var mat in Part!.AvailableMaterials)
                    {
                        <MudSelectItem T="CatalogMaterialDto" Value="@mat">@mat.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <div class="pcs-field" style="flex: 1;">
                    <MudText Typo="Typo.caption" Class="pcs-field-label">Surface Finish</MudText>
                    <MudSelect T="CatalogSurfaceFinishDto"
                               Value="@SelectedFinish"
                               ValueChanged="@((CatalogSurfaceFinishDto? f) => OnFinishChanged(f))"
                               ToStringFunc="@(f => f?.Name ?? string.Empty)"
                               Disabled="@(Part!.AvailableFinishes.Count == 0)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Label=""
                               Placeholder="">
                        @foreach (var fin in Part!.AvailableFinishes)
                        {
                            <MudSelectItem T="CatalogSurfaceFinishDto" Value="@fin">@fin.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                @if (Part!.ProcessCode == "CNC")
                {
                    <div class="pcs-field" style="flex: 1;">
                        <MudText Typo="Typo.caption" Class="pcs-field-label">Ra / Roughness</MudText>
                        <MudSelect T="string"
                                   Value="@Part!.RoughnessCode"
                                   ValueChanged="@((string? v) => OnRoughnessChanged(v))"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Label=""
                                   Placeholder="">
                            <MudSelectItem T="string" Value="@("Ra0.2")">Ra 0.2</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra0.4")">Ra 0.4</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra0.8")">Ra 0.8</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra1.6")">Ra 1.6</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra3.2")">Ra 3.2</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra6.3")">Ra 6.3</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ra12.5")">Ra 12.5</MudSelectItem>
                        </MudSelect>
                    </div>
                }
            </MudStack>
        </div>

        @* ── Section C: Design & Features ────────────────────────────────── *@
        <div class="pcs-section">
            <MudText Typo="Typo.overline" Class="pcs-section-label">Design &amp; Features</MudText>

            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <div style="flex: 1;">
                    <MudText Typo="Typo.caption" Class="pcs-field-label">Tolerance</MudText>
                    <MudSelect T="CatalogToleranceDto"
                               Value="@SelectedTolerance"
                               ValueChanged="@((CatalogToleranceDto? t) => OnToleranceChanged(t))"
                               ToStringFunc="@(t => t?.Name ?? string.Empty)"
                               Disabled="@(Part!.AvailableTolerances.Count == 0)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Label=""
                               Placeholder="">
                        @foreach (var tol in Part!.AvailableTolerances)
                        {
                            <MudSelectItem T="CatalogToleranceDto" Value="@tol">@tol.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div style="flex: 1;">
                    <MudText Typo="Typo.caption" Class="pcs-field-label">Part Marking</MudText>
                    <MudSelect T="PartMarkingType"
                               Value="@Part!.MarkingType"
                               ValueChanged="@((PartMarkingType v) => OnPartMarkingChanged(v))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Label=""
                               Placeholder="">
                        <MudSelectItem T="PartMarkingType" Value="@PartMarkingType.None">None</MudSelectItem>
                        <MudSelectItem T="PartMarkingType" Value="@PartMarkingType.Laser">Laser Marking</MudSelectItem>
                        <MudSelectItem T="PartMarkingType" Value="@PartMarkingType.Printing">Silkscreen</MudSelectItem>
                        <MudSelectItem T="PartMarkingType" Value="@PartMarkingType.Engraving">CNC Engraving</MudSelectItem>
                    </MudSelect>
                </div>
            </MudStack>

            <MudText Typo="Typo.caption" Class="pcs-field-label">Features</MudText>
            <MudChipSet T="string"
                        SelectionMode="SelectionMode.MultiSelection"
                        CheckMark="true"
                        Color="Color.Default"
                        SelectedColor="Color.Primary"
                        Size="Size.Small"
                        SelectedValues="@_selectedFeatures"
                        SelectedValuesChanged="@OnFeaturesChanged">
                <MudChip T="string" Value="@("ThreadedHoles")">Threaded Holes</MudChip>
                <MudChip T="string" Value="@("Inserts")">Inserts</MudChip>
            </MudChipSet>

            <FileUploadDropzone Variant="FileUploadDropzone.DropzoneVariant.Compact"
                                Icon="@Icons.Material.Outlined.UploadFile"
                                Label="Upload Revised Model"
                                SubLabel="Preserves configuration &amp; notes"
                                MaxFileSizeLabel="max 100 MB"
                                OnClick="@OnReviseModel"
                                OnFilesDropped="@OnReviseModel"
                                Class="mb-3" />

            <DrawingUploadSection PartId="@Part!.FileId"
                                  ProjectId="@TempProjectId"
                                  Attachments="@Part!.DrawingFiles"
                                  AttachmentsChanged="@OnDrawingsChanged" />

            <div class="pcs-field" style="margin-top: 12px;">
                <MudText Typo="Typo.caption" Class="pcs-field-label">Remarks</MudText>
                <MudTextField T="string"
                              Value="@Part!.PartNotes"
                              ValueChanged="@((string? v) => OnNotesChanged(v))"
                              Lines="3"
                              MaxLength="1000"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Label=""
                              Placeholder="Add special instructions, notes, or requirements..." />
            </div>
        </div>

        @* ── Section D: Quality & Compliance ─────────────────────────────── *@
        <div class="pcs-section">
            <MudText Typo="Typo.overline" Class="pcs-section-label">Quality &amp; Compliance</MudText>

            <div class="pcs-field">
                <MudText Typo="Typo.caption" Class="pcs-field-label">Inspection Level</MudText>
                <MudSelect T="InspectionLevel"
                           Value="@Part!.InspectionLevel"
                           ValueChanged="@((InspectionLevel level) => OnInspectionChanged(level))"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Label=""
                           Placeholder="">
                    <MudSelectItem T="InspectionLevel" Value="@InspectionLevel.Standard">Standard</MudSelectItem>
                    <MudSelectItem T="InspectionLevel" Value="@InspectionLevel.Dimensional">Dimensional</MudSelectItem>
                    <MudSelectItem T="InspectionLevel" Value="@InspectionLevel.FullCmm">Full CMM</MudSelectItem>
                </MudSelect>
            </div>

            <div class="pcs-field">
                <MudText Typo="Typo.caption" Class="pcs-field-label">Certificates</MudText>
                <MudSelect T="string"
                           MultiSelection="true"
                           Disabled="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Label=""
                           Placeholder="Select certificates">
                    <MudSelectItem T="string" Value="@("ISO9001")" Disabled="true">ISO 9001</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MaterialCert")" Disabled="true">Material Certificate</MudSelectItem>
                    <MudSelectItem T="string" Value="@("AS9100")" Disabled="true">AS9100</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ITAR")" Disabled="true">ITAR / EAR</MudSelectItem>
                </MudSelect>
            </div>
        </div>

    </div>

    @* ── Production Routing (collapsible sticky footer) ───────────── *@
    @if (Part!.ProductionRouting != null || Part.ProductionRoutingLoading)
    {
        <div class="pcs-footer">
            <div class="pcs-price-card">
                <div class="pcs-routing-header"
                     role="button"
                     tabindex="0"
                     @onclick="@(() => _routingExpanded = !_routingExpanded)"
                     @onkeydown="@((e) => { if (e.Key == "Enter" || e.Key == " ") _routingExpanded = !_routingExpanded; })">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                        <MudText Typo="Typo.overline" Class="pcs-section-label" style="margin: 0; border: none; padding: 0;">
                            Production Routing &amp; Queue
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandLess"
                             Class="@(_routingExpanded ? "pcs-routing-chevron" : "pcs-routing-chevron collapsed")" />
                </div>
                <div class="pcs-routing-content @(_routingExpanded ? "" : "collapsed")">
                    @if (Part!.ProductionRoutingLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mb-2" />
                    }
                    else if (Part!.ProductionRouting != null)
                    {
                        <div class="pcs-routing-row">
                            <span>@Part!.ProductionRouting?.MachineCode — @Part!.ProductionRouting?.MachineName</span>
                        </div>
                        <div class="pcs-routing-row">
                            <span>Queue Position</span>
                            <span style="color: var(--mud-palette-warning); font-weight: 600;">@Part!.ProductionRouting?.QueueAhead job@(Part!.ProductionRouting?.QueueAhead == 1 ? "" : "s") ahead</span>
                        </div>
                        <div class="pcs-routing-row">
                            <span>Est. Start Date</span>
                            <span>@Part!.ProductionRouting?.EstimatedStartDate.ToString("d MMM yyyy")</span>
                        </div>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                                   OnClick="OpenScheduleDialog"
                                   Style="width: 100%; margin-top: 12px; border-radius: var(--radius-md);">
                            View Planning Schedule
                        </MudButton>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The part to configure. When null, an empty state message is shown.</summary>
    [Parameter] public PartViewModel? Part { get; set; }

    /// <summary>The list of available manufacturing processes to select from.</summary>
    [Parameter] public List<ProcessDto> Processes { get; set; } = [];

    /// <summary>The temporary project identifier passed through to <see cref="DrawingUploadSection"/>.</summary>
    [Parameter] public Guid TempProjectId { get; set; }

    /// <summary>The currency code for displaying prices (e.g. "THB", "USD").</summary>
    [Parameter] public string CurrencyCode { get; set; } = "THB";

    /// <summary>Callback invoked after any mutation to the part configuration.</summary>
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }

    /// <summary>Callback invoked when the user wants to upload a revised CAD model for this part.</summary>
    [Parameter] public EventCallback OnReviseModel { get; set; }

    /// <summary>Controls the layout mode of the sidebar. Sidebar renders the full-width panel; Inline renders a compact version for use inside cards.</summary>
    [Parameter] public PartConfigSidebarDisplayMode DisplayMode { get; set; } = PartConfigSidebarDisplayMode.Sidebar;

    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = null!;

    private bool _routingExpanded = true;
    private List<BulkPricingTable.BulkTier> _bulkTiers = [];
    private IReadOnlyCollection<string> _selectedFeatures = [];
    private decimal? _lastLoadedUnitPrice;

    // ── Computed properties ───────────────────────────────────────────────

    private ProcessDto? SelectedProcess =>
        Processes.FirstOrDefault(p => p.Code == Part?.ProcessCode);

    private CatalogMaterialDto? SelectedMaterial =>
        Part?.AvailableMaterials.FirstOrDefault(m => m.Id == Part.MaterialId);

    private CatalogSurfaceFinishDto? SelectedFinish =>
        Part?.AvailableFinishes.FirstOrDefault(f => f.Id == Part.FinishId);

    private CatalogToleranceDto? SelectedTolerance =>
        Part?.AvailableTolerances.FirstOrDefault(t => t.Id == Part.ToleranceId);

    // ── Lifecycle ─────────────────────────────────────────────────────────

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Part == null)
        {
            _lastLoadedUnitPrice = null;
            _bulkTiers = [];
            return;
        }

        var features = new List<string>();
        if (Part.HasThreadedHoles) features.Add("ThreadedHoles");
        if (Part.HasInserts) features.Add("Inserts");
        if (Part.BagAndTag) features.Add("BagAndTag");
        _selectedFeatures = features;

        if (Part.EstimatedUnitPrice.HasValue && Part.EstimatedUnitPrice != _lastLoadedUnitPrice)
        {
            _lastLoadedUnitPrice = Part.EstimatedUnitPrice;
            await FetchBulkTiersAsync();
        }
        else if (!Part.EstimatedUnitPrice.HasValue && _lastLoadedUnitPrice.HasValue)
        {
            _lastLoadedUnitPrice = null;
            _bulkTiers = [];
        }
    }

    private async Task FetchBulkTiersAsync()
    {
        if (Part?.EstimatedUnitPrice == null) return;
        try
        {
            var request = new BulkPricingRequestDto { BaseUnitPrice = Part.EstimatedUnitPrice.Value };
            var response = await Http.PostAsJsonAsync("api/pricing/bulk", request);
            if (response.IsSuccessStatusCode)
            {
                var tiers = await response.Content.ReadFromJsonAsync<List<BulkPriceTierDto>>();
                if (tiers != null)
                    _bulkTiers = tiers.Select(t => new BulkPricingTable.BulkTier(t.Quantity, t.UnitPrice)).ToList();
            }
        }
        catch
        {
            // Non-fatal — bulk pricing table stays empty
        }
    }

    // ── Event handlers ───────────────────────────────────────────────────

    private async Task OnProcessChanged(ProcessDto? p)
    {
        if (Part == null) return;
        Part.ProcessCode = p?.Code;
        Part.ProcessId = p?.Id;
        Part.AvailableMaterials = [];
        Part.AvailableFinishes = [];
        Part.AvailableTolerances = [];
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnMaterialChanged(CatalogMaterialDto? m)
    {
        if (Part == null) return;
        Part.MaterialCode = m?.Code;
        Part.MaterialId = m?.Id;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnFinishChanged(CatalogSurfaceFinishDto? f)
    {
        if (Part == null) return;
        Part.FinishCode = f?.Code;
        Part.FinishId = f?.Id;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnToleranceChanged(CatalogToleranceDto? t)
    {
        if (Part == null) return;
        Part.ToleranceCode = t?.Code;
        Part.ToleranceId = t?.Id;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnRoughnessChanged(string? v)
    {
        if (Part == null) return;
        Part.RoughnessCode = v;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnFeaturesChanged(IReadOnlyCollection<string> selected)
    {
        if (Part == null) return;
        _selectedFeatures = selected;
        Part.HasThreadedHoles = selected.Contains("ThreadedHoles");
        Part.HasInserts = selected.Contains("Inserts");
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnBagAndTagChanged(IReadOnlyCollection<string> selected)
    {
        if (Part == null) return;
        Part.BagAndTag = selected.Contains("BagAndTag");
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnPartMarkingChanged(PartMarkingType markingType)
    {
        if (Part == null) return;
        Part.MarkingType = markingType;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnQuantityChanged(int qty)
    {
        if (Part == null) return;
        Part.Quantity = qty;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnNotesChanged(string? v)
    {
        if (Part == null) return;
        Part.PartNotes = v;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnInspectionChanged(InspectionLevel level)
    {
        if (Part == null) return;
        Part.InspectionLevel = level;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnDrawingsChanged(List<DraftProjectAttachmentDto> files)
    {
        if (Part == null) return;
        Part.DrawingFiles = files;
        await OnPartChanged.InvokeAsync(Part);
    }

    private void OpenScheduleDialog()
    {
        if (Part?.ProductionRouting == null) return;
        var parameters = new DialogParameters<ScheduleDialogContent>
        {
            { x => x.Routing, Part.ProductionRouting }
        };
        DialogService.ShowAsync<ScheduleDialogContent>("Planning Schedule", parameters);
    }
}