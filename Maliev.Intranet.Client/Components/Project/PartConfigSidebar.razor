@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Client.Pages
@inject CurrencyService CurrencyService
@inject ShippingService ShippingService

<div class="@RootClass">
@if (Part == null)
{
    <div class="pcs-empty-state">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Select a part to configure</MudText>
    </div>
}
else
{
    <div class="pcs-header">
        <div class="pcs-header-label">Configure</div>
        <div class="pcs-header-name" title="@Part!.Name">@Part!.Name</div>
        <div class="pcs-header-actions">
            @if (OnLayoutModeChanged.HasDelegate)
            {
                <button type="button"
                        class="pcs-header-icon-button"
                        title="Table edit"
                        aria-label="Switch to table edit"
                        @onclick="SwitchToTableEditAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.TableRows" Size="Size.Small" />
                </button>
            }
        </div>
    </div>

    <div class="pcs-scroll">
         @* ── Manufacturing Process ─────────────────────────────────────── *@
         <section class="pcs-section"
                  data-config-section="manufacturing-process">
            <div class="pcs-section-header">
                <span class="pcs-section-title">Manufacturing Process</span>
            </div>

            @if (!_isChangingProcess && HasSelectedProcess && SelectedProcess != null)
            {
                @* ── Selected process view with Change button ──────────── *@
                var sp = SelectedProcess;
                var name = GetProcessCardName(sp);
                var description = GetProcessDescription(sp);
                var category = GetProcessCategory(sp);
                <div class="pcs-process-selected">
                    <div class="pcs-process-card pcs-process-card--active pcs-process-card--selected">
                        <div class="pcs-process-check">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        </div>
                        <div class="pcs-process-photo"
                             style="background-image:url('/images/processes/@(sp.Code.ToLowerInvariant()).jpg')"
                             role="img"
                             aria-label="@sp.Name"></div>
                        <div class="pcs-process-copy">
                            <div class="pcs-process-category">@category</div>
                            <div class="pcs-process-name">@name</div>
                            <div class="pcs-process-description">@description</div>
                            <button class="pcs-process-change-btn"
                                    @onclick="StartChangingProcess"
                                    type="button">
                                Change
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* ── Process selection list ──────────────────────────── *@
                <div class="pcs-process-search">
                    <input @ref="_processSearchInput"
                           type="search"
                           class="pcs-process-search-input"
                           placeholder="Search processes…"
                           autocomplete="off"
                           @bind="_processSearch"
                           @bind:event="oninput" />
                </div>
                <div class="pcs-process-row" @ref="_processRowElement">
                    @foreach (var proc in FilteredProcesses)
                    {
                        var active = SelectedProcess?.Code == proc.Code;
                        var cardClass = active
                            ? "pcs-process-card pcs-process-card--active"
                            : HasSelectedProcess ? "pcs-process-card pcs-process-card--dimmed" : "pcs-process-card";
                        var pname = GetProcessCardName(proc);
                        var pdescription = GetProcessDescription(proc);
                        var pcategory = GetProcessCategory(proc);
                        <button class="@cardClass"
                                data-process-code="@proc.Code"
                                aria-pressed="@active"
                                title="@proc.Name"
                                @onclick="@(() => OnProcessChanged(proc))">
                            @if (active)
                            {
                                <div class="pcs-process-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                            <div class="pcs-process-photo"
                                 style="background-image:url('/images/processes/@(proc.Code.ToLowerInvariant()).jpg')"
                                 role="img"
                                 aria-label="@proc.Name"></div>
                            <div class="pcs-process-copy">
                                <div class="pcs-process-category">@pcategory</div>
                                <div class="pcs-process-name">@pname</div>
                                <div class="pcs-process-description">@pdescription</div>
                            </div>
                        </button>
                    }
                    @if (!FilteredProcesses.Any())
                    {
                        <div class="pcs-process-no-results">No processes match "@_processSearch"</div>
                    }
                </div>
            }

        </section>

        @if (HasSelectedProcess)
        {
        @* ── Material ─────────────────────────────────────────────────── *@
        <section class="pcs-section" data-config-section="material">
            <div class="pcs-section-header">
                <span class="pcs-section-title">Material</span>
                @if (_isChangingMaterial || SelectedMaterial == null)
                {
                    <span class="pcs-section-count">@Part!.AvailableMaterials.Count options</span>
                }
            </div>
            @if (!_isChangingMaterial && SelectedMaterial != null)
            {
                @* ── Selected material view with Change button ──────────── *@
                var sm = SelectedMaterial;
                <div class="pcs-process-selected">
                    <div class="pcs-mat-card pcs-mat-card--active pcs-mat-card--selected">
                        <OptionImageFrame Class="pcs-mat-swatch"
                                          ImageUrl="@GetMaterialImageUrl(sm)"
                                          FallbackIcon="@Icons.Material.Outlined.Category" />
                        <div class="pcs-mat-info pcs-mat-info--selected">
                            <div class="pcs-mat-name">@sm.Name</div>
                            @if (!string.IsNullOrEmpty(sm.Description))
                            {
                                <div class="pcs-mat-sub">@sm.Description</div>
                            }
                        </div>
                        <div class="pcs-card-right">
                            <div class="pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                            <button class="pcs-process-change-btn"
                                    @onclick="@(() => _isChangingMaterial = true)"
                                    type="button">
                                Change
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="pcs-cards">
                    @foreach (var mat in Part!.AvailableMaterials)
                    {
                        var active = SelectedMaterial?.Id == mat.Id;
                        <button class="pcs-mat-card @(active ? "pcs-mat-card--active" : "")"
                                @onclick="@(() => OnMaterialChanged(mat))">
                            <OptionImageFrame Class="pcs-mat-swatch"
                                              ImageUrl="@GetMaterialImageUrl(mat)"
                                              FallbackIcon="@Icons.Material.Outlined.Category" />
                            <div class="pcs-mat-info">
                                <div class="pcs-mat-name">@mat.Name</div>
                                @if (!string.IsNullOrEmpty(mat.Description))
                                {
                                    <div class="pcs-mat-sub">@mat.Description</div>
                                }
                            </div>
                            @if (active)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                    }
                </div>
            }
        </section>

        @if (RequiresDedicatedMaterialColorSelection)
        {
            @* ── Material Color ───────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Material Color</span>
                    <span class="pcs-section-count">@MaterialColorOptions.Count options</span>
                </div>
                <div class="pcs-color-choice-grid">
                    @foreach (var color in MaterialColorOptions)
                    {
                        var fallback = MaterialColorOptions[0];
                        var currentColor = GetProcessOptionValue(MaterialColorKey, fallback);
                        var active = string.Equals(currentColor, color, StringComparison.OrdinalIgnoreCase);
                        <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                @onclick="@(() => OnMaterialColorChanged(color))">
                            <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                              ImageUrl="@GetMaterialColorImageUrl(color)"
                                              FallbackIcon="@Icons.Material.Outlined.Palette" />
                            <span>@color</span>
                            @if (active)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                        </button>
                    }
                </div>
            </section>
        }

        @* ── Surface Finish ───────────────────────────────────────────── *@
        <section class="pcs-section" data-config-section="surface-finish">
            @{
                var visibleFinishes = GetVisibleFinishes(Part!.AvailableFinishes);
                var selectedFinish = SelectedFinish;
            }
            <div class="pcs-section-header">
                <span class="pcs-section-title">Surface Finish</span>
                @if (_isChangingFinish || selectedFinish == null)
                {
                    <span class="pcs-section-count">@visibleFinishes.Count options</span>
                }
            </div>
            @if (!_isChangingFinish && selectedFinish != null)
            {
                @* ── Selected finish view with Change button ──────────── *@
                <div class="pcs-process-selected">
                    <div class="pcs-fin-card pcs-fin-card--active pcs-fin-card--selected">
                        <OptionImageFrame Class="pcs-fin-swatch"
                                          ImageUrl="@GetSurfaceFinishImageUrl(selectedFinish)"
                                          FallbackIcon="@Icons.Material.Outlined.AutoFixHigh" />
                        <div class="pcs-fin-info pcs-fin-info--selected">
                            <div class="pcs-fin-name">@GetSurfaceFinishDisplayName(selectedFinish)</div>
                            @if (!string.IsNullOrEmpty(selectedFinish.Description))
                            {
                                <div class="pcs-fin-sub">@selectedFinish.Description</div>
                            }
                        </div>
                        <div class="pcs-card-right">
                            <div class="pcs-fin-price">@FormatFinishPrice(selectedFinish)</div>
                            <div class="pcs-card-check">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            </div>
                            <button class="pcs-process-change-btn"
                                    @onclick="@(() => _isChangingFinish = true)"
                                    type="button">
                                Change
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="pcs-cards">
                    @foreach (var fin in visibleFinishes)
                    {
                        var active = IsSelectedFinishGroup(fin);
                        <button class="pcs-fin-card @(active ? "pcs-fin-card--active" : "")"
                                @onclick="@(() => OnFinishChanged(fin))">
                            <OptionImageFrame Class="pcs-fin-swatch"
                                              ImageUrl="@GetSurfaceFinishImageUrl(fin)"
                                              FallbackIcon="@Icons.Material.Outlined.AutoFixHigh" />
                            <div class="pcs-fin-info">
                                <div class="pcs-fin-name">@GetSurfaceFinishDisplayName(fin)</div>
                                @if (!string.IsNullOrEmpty(fin.Description))
                                {
                                    <div class="pcs-fin-sub">@fin.Description</div>
                                }
                            </div>
                            <div class="pcs-fin-price">@FormatFinishPrice(fin)</div>
                            @if (active)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                    }
                </div>
            }
        </section>

        @* ── Color (Finish Options / Material Color) ───────────────────── *@
        @if (ShowColorSection)
        {
            <section class="pcs-section" data-config-section="color-options">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Color</span>
                    <span class="pcs-section-count">@FormatOptionCount(VisibleFinishColorOptions.Count + (ShowMaterialColorForFdm ? MaterialColorOptions.Count : 0))</span>
                </div>
                <div class="pcs-options-stack">
                    @if (ShowMaterialColorForFdm)
                    {
                        <div class="pcs-option-row">
                            <div class="pcs-option-label">Material Color</div>
                            <div class="pcs-color-choice-grid">
                                @foreach (var color in MaterialColorOptions)
                                {
                                    var currentColor = GetProcessOptionValue(MaterialColorKey, MaterialColorOptions[0]);
                                    var active = string.Equals(currentColor, color, StringComparison.OrdinalIgnoreCase);
                                    <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                            @onclick="@(() => OnMaterialColorChanged(color))">
                                        <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                          ImageUrl="@GetMaterialColorImageUrl(color)"
                                                          FallbackIcon="@Icons.Material.Outlined.Palette" />
                                        <span>@color</span>
                                        @if (active)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var opt in VisibleFinishColorOptions)
                    {
                        <div class="pcs-option-row">
                            @if (IsPaintColorOption(opt))
                            {
                                var paintHex = GetProcessOptionValue(PaintColorHexKey, string.Empty);
                                var paintReference = GetProcessOptionValue(PaintColorReferenceKey, string.Empty);
                                var customPaintSelected = IsCustomPaintColorSelected(paintHex, paintReference);
                                <div class="pcs-option-label">@GetFinishColorOptionLabel(opt)</div>
                                <div class="pcs-color-choice-grid">
                                    @foreach (var paint in StandardPaintColors)
                                    {
                                        var active = IsPaintColorSelected(paint, paintHex, paintReference);
                                        <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                @onclick="@(() => OnStandardPaintColorChanged(opt.ConfigKey, paint))">
                                            <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                              ImageUrl="@GetPaintColorImageUrl(paint)"
                                                              FallbackIcon="@Icons.Material.Outlined.Palette" />
                                            <span>@paint.Name</span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    }
                                    <button class="pcs-color-choice @(customPaintSelected ? "pcs-color-choice--active" : "")"
                                            @onclick="@(() => OnCustomPaintColorSelected(opt.ConfigKey))">
                                        <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                          ImageUrl="@GetCustomPaintImageUrl()"
                                                          FallbackIcon="@Icons.Material.Outlined.Palette" />
                                        <span>Custom</span>
                                        @if (customPaintSelected)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        }
                                    </button>
                                </div>
                                @if (customPaintSelected)
                                {
                                    <div class="pcs-color-picker-row">
                                        <label class="pcs-native-color">
                                            <span>Custom color</span>
                                            <input type="color"
                                                   value="@GetProcessOptionValue(PaintColorHexKey, "#111111")"
                                                   @onchange="@(e => OnPaintColorHexChanged(opt.ConfigKey, e.Value?.ToString()))" />
                                        </label>
                                        <MudTextField T="string"
                                                      Label="Custom color name/code"
                                                      Value="@paintReference"
                                                      ValueChanged="@(val => OnPaintColorReferenceChanged(opt.ConfigKey, val))"
                                                      Placeholder="RAL 9005, Pantone Black C..."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      FullWidth="true" />
                                    </div>
                                }
                            }
                            else if (IsColorChoiceOption(opt))
                            {
                                var options = GetOptionChoices(opt).ToList();
                                var currentValue = GetCurrentOptionChoiceValue(opt, options);
                                <div class="pcs-option-label">@GetFinishColorOptionLabel(opt)</div>
                                <div class="pcs-color-choice-grid">
                                    @foreach (var o in options)
                                    {
                                        var active = string.Equals(currentValue, o, StringComparison.OrdinalIgnoreCase);
                                        <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                @onclick="@(() => OnProcessOptionValueChanged(opt.ConfigKey, o))">
                                            <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                              ImageUrl="@GetColorChoiceImageUrl(opt, o)"
                                                              FallbackIcon="@Icons.Material.Outlined.Palette" />
                                            <span>@FormatOptionLabel(o)</span>
                                            @if (active)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

            @* ── Tolerance ─────────────────────────────────────────────────── *@
            <section class="pcs-section" data-config-section="tolerance">
                @{
                    var toleranceGroups = VisibleToleranceGroups;
                    var selectedTol = SelectedTolerance;
                }
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Tolerance</span>
                    @if (_isChangingTolerance || selectedTol == null)
                    {
                        <div class="pcs-section-meta">
                            <span class="pcs-section-count">@FormatOptionCount(toleranceGroups.Sum(group => group.Options.Count))</span>
                        </div>
                    }
                </div>
                @if (!_isChangingTolerance && selectedTol != null)
                {
                    @* ── Selected tolerance view with Change button ──────── *@
                    var (tolHead, tolTail) = ToleranceNameHelper.Split(selectedTol.Name);
                    <div class="pcs-selected-single">
                        <div class="pcs-tol-selected-card">
                            <div class="pcs-tol-selected-info">
                                <span class="pcs-tol-name">@tolHead</span>
                                <span class="pcs-tol-grade pcs-tol-grade--selected">@(string.IsNullOrEmpty(tolTail) ? selectedTol.Grade : tolTail)</span>
                                @if (!string.IsNullOrEmpty(GetToleranceRange(selectedTol)))
                                {
                                    <span class="pcs-tol-range pcs-tol-range--selected">@GetToleranceRange(selectedTol)</span>
                                }
                            </div>
                            <button class="pcs-process-change-btn"
                                    @onclick="@(() => _isChangingTolerance = true)"
                                    type="button">
                                Change
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pcs-tolerance-groups">
                        @foreach (var group in toleranceGroups)
                        {
                            <div class="pcs-tolerance-group @group.CssClass">
                                <div class="pcs-tolerance-group-header">
                                    <div>
                                        <div class="pcs-tolerance-group-title">@group.Title</div>
                                        <div class="pcs-tolerance-group-standard">@group.Standard</div>
                                    </div>
                                    <span class="pcs-tolerance-group-count">@group.Options.Count</span>
                                </div>
                                <div class="pcs-tol-grid">
                                    @foreach (var tol in group.Options)
                                    {
                                        var active = SelectedTolerance?.Id == tol.Id;
                                        var (tolHead, tolTail) = ToleranceNameHelper.Split(tol.Name);
                                        <button class="pcs-tol-card @(active ? "pcs-tol-card--active" : "")"
                                                @onclick="@(() => OnToleranceChanged(tol))">
                                            <div class="pcs-tol-name">@tolHead</div>
                                            <div class="pcs-tol-grade">@(string.IsNullOrEmpty(tolTail) ? tol.Grade : tolTail)</div>
                                            <div class="pcs-tol-range">@GetToleranceRange(tol)</div>
                                            @if (active)
                                            {
                                                <div class="pcs-tol-check">
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:10px;width:10px;height:10px;" />
                                                </div>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        @if (toleranceGroups.Count == 0)
                        {
                            <div class="pcs-tolerance-empty">
                                No tolerance options available for this process.
                            </div>
                        }
                    </div>
                }
            </section>

            @if (IsCncProcess)
            {
                @* ── CNC Surface Roughness ─────────────────────────────────────── *@
                <section class="pcs-section">
                    @{
                        var selectedRoughness = RoughnessOptions.FirstOrDefault(r => string.Equals(Part!.RoughnessCode, r.Code, StringComparison.OrdinalIgnoreCase));
                    }
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Surface Roughness</span>
                        @if (_isChangingRoughness || selectedRoughness == null)
                        {
                            <span class="pcs-section-count">@RoughnessOptions.Count options</span>
                        }
                    </div>
                    @if (!_isChangingRoughness && selectedRoughness != null)
                    {
                        <div class="pcs-process-selected">
                            <div class="pcs-choice-card pcs-roughness-card pcs-choice-card--active pcs-choice-card--selected">
                                <OptionImageFrame Class="pcs-choice-swatch"
                                                  ImageUrl="@GetRoughnessImageUrl(selectedRoughness.Code)"
                                                  FallbackIcon="@Icons.Material.Outlined.Grain" />
                                <div class="pcs-choice-info pcs-choice-info--selected">
                                    <div class="pcs-choice-name">@selectedRoughness.Name</div>
                                    <div class="pcs-choice-sub">@selectedRoughness.Description</div>
                                </div>
                                <div class="pcs-card-right">
                                    <div class="pcs-card-check">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </div>
                                    <button class="pcs-process-change-btn"
                                            @onclick="@(() => _isChangingRoughness = true)"
                                            type="button">
                                        Change
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pcs-cards">
                            @foreach (var roughness in RoughnessOptions)
                            {
                                var active = string.Equals(Part!.RoughnessCode, roughness.Code, StringComparison.OrdinalIgnoreCase);
                                <button class="pcs-choice-card pcs-roughness-card @(active ? "pcs-choice-card--active" : "")"
                                        @onclick="@(() => OnRoughnessChanged(roughness.Code))">
                                    <OptionImageFrame Class="pcs-choice-swatch"
                                                      ImageUrl="@GetRoughnessImageUrl(roughness.Code)"
                                                      FallbackIcon="@Icons.Material.Outlined.Grain" />
                                    <div class="pcs-choice-info">
                                        <div class="pcs-choice-name">@roughness.Name</div>
                                        <div class="pcs-choice-sub">@roughness.Description</div>
                                    </div>
                                    @if (active)
                                    {
                                        <div class="pcs-card-check">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        </div>
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            }

            @if (CanConfigurePartFeaturesAndInspection)
            {
                @* ── Part Features ───────────────────────────────────────────────── *@
                <section class="pcs-section" data-config-section="part-features">
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Part Features</span>
                        <span class="pcs-section-count">2 options</span>
                    </div>
                    <div class="pcs-feature-toggle-grid">
                        <button class="pcs-choice-card pcs-feature-card @(Part!.HasThreadedHoles ? "pcs-choice-card--active" : "") @(!CanConfigurePartFeaturesAndInspection ? "pcs-choice-card--disabled" : "")"
                                disabled="@(!CanConfigurePartFeaturesAndInspection)"
                                aria-disabled="@GetDisabledAriaValue(!CanConfigurePartFeaturesAndInspection)"
                                @onclick="@(() => OnThreadedHolesChanged(!Part!.HasThreadedHoles))">
                            <OptionImageFrame Class="pcs-choice-swatch"
                                              ImageUrl='@GetFeatureImageUrl("tapped_holes")'
                                              FallbackIcon="@Icons.Material.Outlined.Construction" />
                            <div class="pcs-choice-info">
                                <div class="pcs-choice-name">Tapped holes</div>
                                <div class="pcs-choice-sub">Internal threads cut into the part.</div>
                            </div>
                            @if (Part!.HasThreadedHoles)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                        <button class="pcs-choice-card pcs-feature-card @(Part!.HasInserts ? "pcs-choice-card--active" : "") @(!CanConfigurePartFeaturesAndInspection ? "pcs-choice-card--disabled" : "")"
                                disabled="@(!CanConfigurePartFeaturesAndInspection)"
                                aria-disabled="@GetDisabledAriaValue(!CanConfigurePartFeaturesAndInspection)"
                                @onclick="@(() => OnInsertsChanged(!Part!.HasInserts))">
                            <OptionImageFrame Class="pcs-choice-swatch"
                                              ImageUrl='@GetFeatureImageUrl("thread_inserts")'
                                              FallbackIcon="@Icons.Material.Outlined.Hardware" />
                            <div class="pcs-choice-info">
                                <div class="pcs-choice-name">Thread inserts</div>
                                <div class="pcs-choice-sub">Installed threaded hardware such as Helicoil or heat-set inserts.</div>
                            </div>
                            @if (Part!.HasInserts)
                            {
                                <div class="pcs-card-check">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </button>
                    </div>
                    @if (Part!.RequiresThreadSpecificationDrawing && !Part.HasRequiredThreadSpecificationDrawing)
                    {
                        <MudAlert Severity="Severity.Warning"
                                  Variant="Variant.Text"
                                  Dense="true"
                                  Class="pcs-feature-warning">
                            Upload a drawing for this part so production has the thread specification.
                        </MudAlert>
                    }
                </section>
            }

            @* ── Process Options (anodize color, paint color, etc.) ─────────── *@
            var visibleOptions = VisibleProcessOptions.ToList();
            if (visibleOptions.Count > 0)
            {
                <section class="pcs-section" data-config-section="process-options">
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Options</span>
                        <span class="pcs-section-count">@visibleOptions.Count options</span>
                    </div>
                    <div class="pcs-options-stack">
                        @foreach (var opt in visibleOptions)
                        {
                            <div class="pcs-option-row">
                                @if (IsBooleanOption(opt))
                                {
                                    var enabled = GetProcessOptionBool(opt.ConfigKey);
                                    <button class="pcs-choice-card @(enabled ? "pcs-choice-card--active" : "")"
                                            @onclick="@(() => OnProcessOptionBoolChanged(opt.ConfigKey, !enabled))">
                                        <OptionImageFrame Class="pcs-choice-swatch"
                                                          ImageUrl="@GetBooleanOptionImageUrl(opt)"
                                                          FallbackIcon="@GetBooleanOptionIcon(opt)" />
                                        <div class="pcs-choice-info">
                                            <div class="pcs-choice-name">@opt.Label</div>
                                            @if (!string.IsNullOrWhiteSpace(opt.HelpText))
                                            {
                                                <div class="pcs-choice-sub">@opt.HelpText</div>
                                            }
                                        </div>
                                        @if (enabled)
                                        {
                                            <div class="pcs-card-check">
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            </div>
                                        }
                                    </button>
                                }
                                else if (IsPaintColorOption(opt))
                                {
                                    var paintHex = GetProcessOptionValue(PaintColorHexKey, string.Empty);
                                    var paintReference = GetProcessOptionValue(PaintColorReferenceKey, string.Empty);
                                    var customPaintSelected = IsCustomPaintColorSelected(paintHex, paintReference);
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-color-choice-grid">
                                        @foreach (var paint in StandardPaintColors)
                                        {
                                            var active = IsPaintColorSelected(paint, paintHex, paintReference);
                                            <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                    @onclick="@(() => OnStandardPaintColorChanged(opt.ConfigKey, paint))">
                                                <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                                  ImageUrl="@GetPaintColorImageUrl(paint)"
                                                                  FallbackIcon="@Icons.Material.Outlined.Palette" />
                                                <span>@paint.Name</span>
                                                @if (active)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                }
                                            </button>
                                        }
                                        <button class="pcs-color-choice @(customPaintSelected ? "pcs-color-choice--active" : "")"
                                                @onclick="@(() => OnCustomPaintColorSelected(opt.ConfigKey))">
                                            <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                              ImageUrl="@GetCustomPaintImageUrl()"
                                                              FallbackIcon="@Icons.Material.Outlined.Palette" />
                                            <span>Custom</span>
                                            @if (customPaintSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                            }
                                        </button>
                                    </div>
                                    @if (customPaintSelected)
                                    {
                                        <div class="pcs-color-picker-row">
                                            <label class="pcs-native-color">
                                                <span>Custom color</span>
                                                <input type="color"
                                                       value="@GetProcessOptionValue(PaintColorHexKey, "#111111")"
                                                       @onchange="@(e => OnPaintColorHexChanged(opt.ConfigKey, e.Value?.ToString()))" />
                                            </label>
                                            <MudTextField T="string"
                                                          Label="Custom color name/code"
                                                          Value="@paintReference"
                                                          ValueChanged="@(val => OnPaintColorReferenceChanged(opt.ConfigKey, val))"
                                                          Placeholder="RAL 9005, Pantone Black C..."
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Immediate="true"
                                                          FullWidth="true" />
                                        </div>
                                    }
                                }
                                else if (IsColorChoiceOption(opt))
                                {
                                    var options = GetOptionChoices(opt).ToList();
                                    var currentValue = GetCurrentOptionChoiceValue(opt, options);
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-color-choice-grid">
                                        @foreach (var o in options)
                                        {
                                            var active = string.Equals(currentValue, o, StringComparison.OrdinalIgnoreCase);
                                            <button class="pcs-color-choice @(active ? "pcs-color-choice--active" : "")"
                                                    @onclick="@(() => OnProcessOptionValueChanged(opt.ConfigKey, o))">
                                                <OptionImageFrame Class="pcs-color-chip pcs-option-image-frame--small"
                                                                  ImageUrl="@GetColorChoiceImageUrl(opt, o)"
                                                                  FallbackIcon="@Icons.Material.Outlined.Palette" />
                                                <span>@FormatOptionLabel(o)</span>
                                                @if (active)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                else if (IsCardChoiceOption(opt))
                                {
                                    var currentValue = Part!.ProcessOptionValues.TryGetValue(opt.ConfigKey, out var v) ? v : opt.DefaultValue;
                                    var options = GetOptionChoices(opt).ToList();
                                    <div class="pcs-option-label">@opt.Label</div>
                                    <div class="pcs-cards">
                                        @foreach (var o in options)
                                        {
                                            var active = string.Equals(currentValue, o, StringComparison.OrdinalIgnoreCase);
                                            <button class="pcs-choice-card @(active ? "pcs-choice-card--active" : "")"
                                                    @onclick="@(() => OnProcessOptionValueChanged(opt.ConfigKey, o))">
                                                <OptionImageFrame Class="pcs-choice-swatch"
                                                                  ImageUrl="@GetCardChoiceOptionImageUrl(opt, o)"
                                                                  FallbackIcon="@GetOptionIcon(opt.ConfigKey)" />
                                                <div class="pcs-choice-info">
                                                    <div class="pcs-choice-name">@FormatOptionLabel(o)</div>
                                                    @if (!string.IsNullOrWhiteSpace(opt.HelpText))
                                                    {
                                                        <div class="pcs-choice-sub">@opt.HelpText</div>
                                                    }
                                                </div>
                                                @if (active)
                                                {
                                                    <div class="pcs-card-check">
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                                    </div>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var currentText = Part!.ProcessOptionValues.TryGetValue(opt.ConfigKey, out var tv) ? tv : opt.DefaultValue;
                                    <MudTextField T="string" Label="@opt.Label" Value="@currentText"
                                                  ValueChanged="@(val => OnProcessOptionValueChanged(opt.ConfigKey, val))"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Immediate="true"
                                                  HelperText="@opt.HelpText" FullWidth="true" />
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @if (CanConfigurePartFeaturesAndInspection)
            {
                @* ── Quality ─────────────────────────────────────────────────────── *@
                <section class="pcs-section" data-config-section="inspection">
                    @{
                        var selectedInspection = InspectionOptions.FirstOrDefault(i => i.Level == Part!.InspectionLevel);
                    }
                    <div class="pcs-section-header">
                        <span class="pcs-section-title">Inspection</span>
                        @if (_isChangingInspection || selectedInspection == null)
                        {
                            <span class="pcs-section-count">@InspectionOptions.Count options</span>
                        }
                    </div>
                    @if (!_isChangingInspection && selectedInspection != null)
                    {
                        <div class="pcs-process-selected">
                            <div class="pcs-choice-card pcs-choice-card--active pcs-choice-card--selected"
                                 aria-disabled="false">
                                <OptionImageFrame Class="pcs-choice-swatch"
                                                  ImageUrl="@GetInspectionImageUrl(selectedInspection.Level)"
                                                  FallbackIcon="@selectedInspection.Icon" />
                                <div class="pcs-choice-info pcs-choice-info--selected">
                                    <div class="pcs-choice-name">@selectedInspection.Name</div>
                                    <div class="pcs-choice-sub">@selectedInspection.Description</div>
                                </div>
                                <div class="pcs-card-right">
                                    <div class="pcs-card-check">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                    </div>
                                    <button class="pcs-process-change-btn"
                                            @onclick="@(() => _isChangingInspection = true)"
                                            type="button">
                                        Change
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="pcs-cards">
                            @foreach (var inspection in InspectionOptions)
                            {
                                var active = Part!.InspectionLevel == inspection.Level;
                                <button class="pcs-choice-card @(active ? "pcs-choice-card--active" : "") @(!CanConfigurePartFeaturesAndInspection ? "pcs-choice-card--disabled" : "")"
                                        disabled="@(!CanConfigurePartFeaturesAndInspection)"
                                        aria-disabled="@GetDisabledAriaValue(!CanConfigurePartFeaturesAndInspection)"
                                        @onclick="@(() => OnInspectionChanged(inspection.Level))">
                                    <OptionImageFrame Class="pcs-choice-swatch"
                                                      ImageUrl="@GetInspectionImageUrl(inspection.Level)"
                                                      FallbackIcon="@inspection.Icon" />
                                    <div class="pcs-choice-info">
                                        <div class="pcs-choice-name">@inspection.Name</div>
                                        <div class="pcs-choice-sub">@inspection.Description</div>
                                    </div>
                                    @if (active)
                                    {
                                        <div class="pcs-card-check">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                        </div>
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            }

            @* ── Lead Time ────────────────────────────────────────────────── *@
            @if (LeadTimeOptions.Count > 0 || OnLeadTimeChanged.HasDelegate)
            {
                <section class="pcs-section" data-config-section="lead-time">
                    <div class="pcs-section-header">
                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="pcs-section-icon" />
                        <span class="pcs-section-title">Lead Time</span>
                        @if (!(_isChangingLeadTime == false && SelectedLeadTime != null))
                        {
                            <span class="pcs-section-count">@LeadTimeOptions.Count options</span>
                        }
                    </div>
                    @if (!_isChangingLeadTime && SelectedLeadTime != null)
                    {
                        @* ── Selected lead time with Change button ──────────── *@
                        var lt = SelectedLeadTime;
                        var ltMult = lt.PriceMultiplier < 1 ? $"-{Math.Round((1 - lt.PriceMultiplier) * 100)}%"
                                   : lt.PriceMultiplier > 1 ? $"+{Math.Round((lt.PriceMultiplier - 1) * 100)}%"
                                   : "Base";
                        <div class="pcs-process-selected">
                            <div class="pcs-lead-card pcs-lead-card--active pcs-lead-card--selected">
                                <div class="pcs-lead-copy">
                                    <div class="pcs-lead-row">
                                        <span class="pcs-lead-name">@lt.Name</span>
                                        <span class="pcs-lead-mult">@ltMult</span>
                                    </div>
                                    <div class="pcs-lead-days">@lt.MinDays – @lt.MaxDays business days</div>
                                    <button class="pcs-process-change-btn"
                                            @onclick="@(() => _isChangingLeadTime = true)"
                                            type="button">
                                        Change
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (LeadTimeOptions.Count == 0)
                    {
                        <div class="pcs-lead-loading">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="44px" Class="rounded" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="44px" Class="rounded" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="44px" Class="rounded" />
                        </div>
                    }
                    else
                    {
                        @foreach (var lt in LeadTimeOptions)
                        {
                            var ltActive = SelectedLeadTime?.Code == lt.Code;
                            var ltMult = lt.PriceMultiplier < 1 ? $"-{Math.Round((1 - lt.PriceMultiplier) * 100)}%"
                                       : lt.PriceMultiplier > 1 ? $"+{Math.Round((lt.PriceMultiplier - 1) * 100)}%"
                                       : "Base";
                            <button class="pcs-lead-btn @(ltActive ? "pcs-lead-btn--active" : "")"
                                    @onclick="@(async () => { await OnLeadTimeChanged.InvokeAsync(lt); _isChangingLeadTime = false; })">
                                <div class="pcs-lead-row">
                                    <span class="pcs-lead-name">@lt.Name</span>
                                    <span class="pcs-lead-mult">@ltMult</span>
                                </div>
                                <div class="pcs-lead-days">@lt.MinDays – @lt.MaxDays business days</div>
                            </button>
                        }
                    }
                </section>
            }

            @* ── Quantity ─────────────────────────────────────────────────── *@
            <section class="pcs-section" data-config-section="quantity">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Quantity</span>
                    @if (_bulkTiers.Count > 0)
                    {
                        <span class="pcs-bulk-badge">@(ComputeBulkDiscount())% bulk off</span>
                    }
                </div>
                <div class="pcs-qty-row">
                    <button class="pcs-qty-btn"
                            @onclick="@(() => OnQuantityChanged(Math.Max(1, Part!.Quantity - 1)))">−</button>
                    <input type="number" class="pcs-qty-input" value="@Part!.Quantity" min="1" max="999999"
                           @oninput="@(e => OnQuantityChanged(int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(1, q) : 1))" />
                    <button class="pcs-qty-btn" @onclick="@(() => OnQuantityChanged(Part!.Quantity + 1))">+</button>
                </div>
                <div class="pcs-qty-presets">
                    @foreach (var q in new[] { 1, 10, 25, 50, 100 })
                    {
                        <button class="pcs-qty-preset @(Part!.Quantity == q ? "pcs-qty-preset--active" : "")"
                                @onclick="@(() => OnQuantityChanged(q))">@q</button>
                    }
                </div>
                @if (_bulkTiers.Count > 0)
                {
                    <BulkPricingTable Tiers="@_bulkTiers" CurrentQuantity="@Part!.Quantity" />
                }
            </section>

            @* ── Part Notes ─────────────────────────────────────────────────── *@
            <section class="pcs-section">
                <div class="pcs-section-header">
                    <span class="pcs-section-title">Part Notes</span>
                </div>
                <textarea class="pcs-notes-input"
                          value="@Part!.PartNotes"
                          placeholder="Manufacturing notes for this part"
                          rows="4"
                          @oninput="@(e => OnNotesChanged(e.Value?.ToString()))"></textarea>
            </section>
        }
        </div>

        @* ── Production Routing ───────────────────────────────────────────── *@
        @if (HasSelectedProcess && (Part!.ProductionRouting != null || Part.ProductionRoutingLoading))
        {
            <div class="pcs-footer">
                <div class="pcs-routing-card">
                    <div class="pcs-routing-header" role="button" tabindex="0"
                         @onclick="@(() => _routingExpanded = !_routingExpanded)"
                         @onkeydown="@((e) => { if (e.Key == "Enter" || e.Key == " ") _routingExpanded = !_routingExpanded; })">
                        <div class="pcs-routing-title">
                            <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Class="pcs-routing-title-text">Production Routing &amp; Queue</MudText>
                        </div>
                        <MudIcon
                        Icon="@(_routingExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </div>
                    <div class="pcs-routing-body @(_routingExpanded ? "" : "pcs-collapsed")">
                        @if (Part!.ProductionRoutingLoading)
                        {
                            <ProgressiveSkeleton Layout="compact" Rows="2" ShowFilters="false" Class="mb-2" Label="Loading production routing" />
                        }
                        else if (Part!.ProductionRouting != null)
                        {
                            <div class="pcs-routing-row">
                                <span>@Part!.ProductionRouting?.MachineCode — @Part!.ProductionRouting?.MachineName</span>
                            </div>
                            <div class="pcs-routing-row">
                                <span>Queue Position</span>
                                <span class="pcs-routing-warn">@Part!.ProductionRouting?.QueueAhead
                                    job@(Part!.ProductionRouting?.QueueAhead == 1 ? "" : "s") ahead</span>
                                </div>
                                <div class="pcs-routing-row">
                                    <span>Est. Start Date</span>
                                    <span>@Part!.ProductionRouting?.EstimatedStartDate.ToString("d MMM yyyy")</span>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.CalendarMonth"
                                           OnClick="OpenScheduleDialog" Class="pcs-schedule-btn">
                                    View Planning Schedule
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }
}

@* ── Quote Total Footer ──────────────────────────────────────────────── *@
@if (ShowQuoteFooter)
{
    <div class="pcs-quote-footer">
        @* Total + action buttons *@
        @if (SelectedCustomer != null)
        {
            <div class="pcs-qf-total-area">
                <div class="pcs-qf-total-top">
                    <div class="pcs-qf-ships">
                        <div class="pcs-qf-total-label">Quote Total</div>
                        <div class="pcs-qf-ships-by">
                            Ships by&nbsp;
                            @if (LeadTimeOptions.Count == 0 && AllParts.Any(p => p.PricingLoading))
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="48px" Style="display:inline-block;" />
                            }
                            else
                            {
                                <span class="pcs-qf-ship-date">@ComputeQuoteShipDate()</span>
                            }
                        </div>
                    </div>
                    @if (AllParts.Any(p => p.PricingLoading))
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="90px" Height="28px" />
                    }
                    else
                    {
                        var total = ComputeQuoteTotal();
                        <div class="pcs-qf-total-amount">
                            @if (total == 0 && AllParts.Count == 0)
                            {
                                <span>—</span>
                            }
                            else if (CurrencyService.IsConverting)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="80px" Height="18px" />
                            }
                            else
                            {
                                @($"{CurrencyService.Symbol} {total:N2}")
                            }
                        </div>
                    }
                </div>
                <div class="pcs-qf-actions">
                    <button type="button"
                            class="pcs-qf-btn-details @(_quoteDetailsOpen ? "pcs-qf-btn-details--active" : "")"
                            @onclick="@(() => _quoteDetailsOpen = !_quoteDetailsOpen)">
                        <MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" />
                        Details
                    </button>
                    <button type="button"
                            class="pcs-qf-btn-pdf"
                            disabled="@(!CanQuote || AllParts.Count == 0 || _quotePdfGenerating)"
                            @onclick="HandleQuoteGeneratePdfAsync">
                        @if (_quotePdfGenerating)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" />
                        }
                        PDF
                    </button>
                    <button type="button"
                            class="pcs-qf-btn-quote"
                            disabled="@(!CanQuote || AllParts.Count == 0 || Saving)"
                            @onclick="@OnQuote">
                        @if (Saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        Quote
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </button>
                </div>
                @if (_quoteDetailsOpen)
                {
                    <button type="button"
                            class="pcs-qf-click-away"
                            aria-label="Close quote details"
                            @onclick="@(() => _quoteDetailsOpen = false)"></button>
                    <div class="pcs-qf-details-popover">
                        <div class="pcs-qf-details-header">
                            <div class="pcs-qf-details-title">
                                <MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" />
                                Quote Details
                            </div>
                            <button type="button" class="pcs-qf-details-close" @onclick="@(() => _quoteDetailsOpen = false)">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                            </button>
                        </div>
                        <div class="pcs-qf-adjustment-grid">
                            <div class="pcs-qf-adj-card pcs-qf-adj-shipping">
                                <div class="pcs-qf-adj-top">
                                    <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                                    <div>
                                        <div class="pcs-qf-adj-name">Shipping</div>
                                        <div class="pcs-qf-adj-hint">Freight, courier, or delivery charge</div>
                                    </div>
                                </div>
                                <CurrencyInput Label="Shipping"
                                               HelperText="Freight, courier, or delivery charge"
                                               @bind-ThbValue="ShippingCost"
                                               Min="0m" />
                                @if (!string.IsNullOrWhiteSpace(ShippingDestinationCountry) && TotalWeightKg > 0)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Outlined.LocalShipping"
                                               OnClick="FetchQuoteDhlRatesAsync"
                                               Disabled="_quoteFetchingRates"
                                               FullWidth="true">
                                        @if (_quoteFetchingRates)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        }
                                        Get DHL Rate
                                    </MudButton>
                                    @if (_quoteRateOptions.Count > 0 && !_quoteFetchingRates)
                                    {
                                        <div class="pcs-qf-rate-options">
                                            @foreach (var rate in _quoteRateOptions)
                                            {
                                                <button type="button"
                                                        class="pcs-qf-rate-option"
                                                        @onclick="@(() => SelectQuoteDhlRate(rate))">
                                                    <span class="pcs-qf-rate-name">@rate.ProductName</span>
                                                    <span class="pcs-qf-rate-price">@rate.TotalPrice.ToString("N0")</span>
                                                    @if (!string.IsNullOrWhiteSpace(rate.EstimatedDeliveryDate))
                                                    {
                                                        <span class="pcs-qf-rate-edd">Est: @(DateTime.TryParse(rate.EstimatedDeliveryDate, out var d) ? d.ToString("MMM d") : rate.EstimatedDeliveryDate)</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                            <div class="pcs-qf-adj-card pcs-qf-adj-discount">
                                <div class="pcs-qf-adj-top">
                                    <MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" />
                                    <div>
                                        <div class="pcs-qf-adj-name">Discount</div>
                                        <div class="pcs-qf-adj-hint">Manual reduction before VAT</div>
                                    </div>
                                </div>
                                <CurrencyInput Label="Discount"
                                               HelperText="Manual reduction before VAT"
                                               @bind-ThbValue="ManualDiscountAmount"
                                               Min="0m" />
                            </div>
                        </div>
                        <div class="pcs-qf-terms-panel">
                            <div class="pcs-qf-terms-heading">
                                <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                                <div>
                                    <div class="pcs-qf-adj-name">Terms</div>
                                    <div class="pcs-qf-adj-hint">Payment, validity, and delivery conditions</div>
                                </div>
                            </div>
