@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos
@using Maliev.MessagingContracts.Contracts.Geometry
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using MudBlazor
@inject Maliev.Intranet.Client.Services.FileTypesSettings FileTypes

<div class="pdc-root">
    @* ── Left 60%: Viewer Column ──────────────────────────────────── *@
    <div class="pdc-viewer-col">
        <div class="pdc-thumb-area">

            @* ── 3D Viewer Mode (inline, replaces thumbnail) ──────── *@
            @if (_showViewer3d)
            {
                <div class="pdc-3d-viewer-container">
                    @if (!string.IsNullOrEmpty(Part.ViewerUrl))
                    {
                        <ModelViewer ViewerUrl="@Part.ViewerUrl" FileExtension=".glb" />
                    }
                    else
                    {
                        <MudProgressCircular Indeterminate="true" />
                    }
                    <button class="pdc-3d-back-btn"
                            @onclick="@CloseViewer"
                            title="Back to thumbnail">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            else
            {
                @* ── Thumbnail Mode ────────────────────────────────── *@

                @* Blurred small thumbnail while large is loading *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && Part.AwaitingPreview)
                {
                    <img src="@Part.ThumbnailSmallUrl"
                         class="pdc-thumb-blurred"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailSmallUrl, v => Part.ThumbnailSmallUrl = v))" />
                }

                @* Sharp large thumbnail once ready *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailLargeUrl))
                {
                    <img src="@Part.ThumbnailLargeUrl"
                         class="pdc-thumb-sharp pdc-thumb-fade-in"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailLargeGcsPath ?? Part.ThumbnailLargeUrl, v => Part.ThumbnailLargeUrl = v, isLargeThumbnail: true))" />
                }

                @* Upload / processing progress overlay *@
                @if ((Part.Uploading || Part.AwaitingPreview) && string.IsNullOrEmpty(Part.ThumbnailSmallUrl))
                {
                    <div class="pdc-upload-progress">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Part.StatusText</MudText>
                    </div>
                }

                @* Fallback grey background — no preview *@
                @if (string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && !Part.AwaitingPreview && !Part.Uploading)
                {
                    <MudIcon Icon="@FileTypes.GetIcon(Path.GetExtension(Part.Name))" Size="Size.Large" Color="Color.Default" />
                }

                @* AnimatedCubeIcon overlay — always visible when GLB available *@
                @if (!string.IsNullOrEmpty(Part.GlbStoragePath) || !string.IsNullOrEmpty(Part.GlbSignedUrl))
                {
                    <div class="pdc-cube-overlay pdc-cube-active">
                        <AnimatedCubeIcon Size="80" OnClick="@OpenViewer" />
                        <span class="pdc-cube-label">View in 3D</span>
                    </div>
                }
            }
        </div>

        <div class="pdc-viewer-meta">
            <MudText Typo="Typo.caption" Class="pdc-filename">@Part.Name</MudText>
            @if (Part.Dimensions != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @($"{Part.Dimensions.X:N1} × {Part.Dimensions.Y:N1} × {Part.Dimensions.Z:N1} mm")
                </MudText>
            }
        </div>
    </div>

    @* ── Right 40%: Configuration Column ─────────────────────────── *@
    <div class="pdc-config-col">
        <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="false" Border="true" TabPanelsClass="pa-3">

            <MudTabPanel Text="Configuration">
                @* Selection mode toggle *@
                <div class="pdc-selection-mode mb-3">
                    <MudToggleGroup T="string" Value="@_selectionMode" ValueChanged="OnSelectionModeChanged" Style="width:fit-content;">
                        <MudToggleItem Value="@("rich")">Rich</MudToggleItem>
                        <MudToggleItem Value="@("basic")">Basic</MudToggleItem>
                    </MudToggleGroup>
                </div>

                @* Process — always shown first *@
                <div class="pdc-field-group">
                    <MudText Typo="Typo.overline" Class="mb-1">Process *</MudText>

                    @if (_selectionMode == "rich")
                    {
                        <MudStack Row="true" Spacing="2" Style="overflow-x: auto; flex-wrap: nowrap;">
                            @foreach (var p in Processes)
                            {
                                <CatalogCard Title="@p.Name"
                                            Subtitle="@(p.Description ?? "")"
                                            IsSelected="@(Part.ProcessId == p.Id)"
                                            OnClick="@(() => OnProcessChanged(p.Id))" />
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudSelect T="Nullable<Guid>" Label="Process *"
                                   Value="@Part.ProcessId"
                                   ValueChanged="@OnProcessChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var p in Processes)
                            {
                                <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)p.Id)">@p.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>

                @* Material *@
                <div class="pdc-field-group">
                    <MudText Typo="Typo.overline" Class="mb-1">Material *</MudText>

                    @if (Part.CatalogLoading)
                    {
                        <MudStack Row="true" Spacing="2">
                            @for (var i = 0; i < 4; i++)
                            {
                                <MudSkeleton Width="120px" Height="100px" Style="flex-shrink:0;" />
                            }
                        </MudStack>
                    }
                    else if (_selectionMode == "rich")
                    {
                        <MudStack Row="true" Spacing="2" Style="overflow-x: auto; flex-wrap: nowrap;">
                            @foreach (var m in Part.AvailableMaterials)
                            {
                                <CatalogCard Title="@m.Name"
                                            Subtitle="@m.Category"
                                            IsSelected="@(Part.MaterialId == m.Id)"
                                            OnClick="@(() => OnMaterialChanged(m.Id))" />
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudSelect T="Nullable<Guid>" Label="Material *"
                                   Value="@Part.MaterialId"
                                   ValueChanged="@OnMaterialChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@(Part.ProcessId == null || Part.AvailableMaterials.Count == 0)">
                            @foreach (var m in Part.AvailableMaterials)
                            {
                                <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)m.Id)">@m.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>

                @* Surface Finish *@
                <div class="pdc-field-group">
                    <MudText Typo="Typo.overline" Class="mb-1">Surface Finish</MudText>

                    @if (Part.CatalogLoading)
                    {
                        <MudStack Row="true" Spacing="2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <MudSkeleton Width="120px" Height="100px" Style="flex-shrink:0;" />
                            }
                        </MudStack>
                    }
                    else if (_selectionMode == "rich")
                    {
                        <MudStack Row="true" Spacing="2" Style="overflow-x: auto; flex-wrap: nowrap;">
                            <CatalogCard Title="None"
                                        Subtitle=""
                                        IsSelected="@(!Part.FinishId.HasValue)"
                                        OnClick="@(() => OnFinishChanged(null))" />
                            @foreach (var f in Part.AvailableFinishes)
                            {
                                <CatalogCard Title="@f.Name"
                                            Subtitle="@(f.RaValueUm.HasValue ? $"Ra {f.RaValueUm:N1} µm" : (f.Description ?? ""))"
                                            IsSelected="@(Part.FinishId == f.Id)"
                                            OnClick="@(() => OnFinishChanged(f.Id))" />
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudSelect T="Nullable<Guid>" Label="Surface Finish"
                                   Value="@Part.FinishId"
                                   ValueChanged="@OnFinishChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@(Part.ProcessId == null)">
                            <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)null)">None</MudSelectItem>
                            @foreach (var f in Part.AvailableFinishes)
                            {
                                <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)f.Id)">@f.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>

                @* Tolerance *@
                <div class="pdc-field-group">
                    <MudText Typo="Typo.overline" Class="mb-1">Tolerance</MudText>

                    @if (Part.CatalogLoading)
                    {
                        <MudStack Row="true" Spacing="2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <MudSkeleton Width="120px" Height="100px" Style="flex-shrink:0;" />
                            }
                        </MudStack>
                    }
                    else if (_selectionMode == "rich")
                    {
                        <MudStack Row="true" Spacing="2" Style="overflow-x: auto; flex-wrap: nowrap;">
                            <CatalogCard Title="Standard"
                                        Subtitle=""
                                        IsSelected="@(!Part.ToleranceId.HasValue)"
                                        OnClick="@(() => OnToleranceChanged(null))" />
                            @foreach (var t in Part.AvailableTolerances)
                            {
                                <CatalogCard Title="@t.Name"
                                            Subtitle="@(t.Grade)"
                                            IsSelected="@(Part.ToleranceId == t.Id)"
                                            OnClick="@(() => OnToleranceChanged(t.Id))" />
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudSelect T="Nullable<Guid>" Label="Tolerance"
                                   Value="@Part.ToleranceId"
                                   ValueChanged="@OnToleranceChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@(Part.ProcessId == null)">
                            <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)null)">Standard</MudSelectItem>
                            @foreach (var t in Part.AvailableTolerances)
                            {
                                <MudSelectItem T="Nullable<Guid>" Value="@((Guid?)t.Id)">@t.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>

                @* Quantity *@
                <div class="pdc-field-group">
                    <MudNumericField T="int" Label="Quantity"
                                     Value="@Part.Quantity"
                                     ValueChanged="@OnQuantityChanged"
                                     Min="1" Max="999"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </div>

                @* Part Notes *@
                <MudTextField T="string" Value="@Part.PartNotes"
                              ValueChanged="@((string v) => NotifyChanged(p => p.PartNotes = v))"
                              Label="Part Notes"
                              Lines="6"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="2000"
                              Counter="2000"
                              HelperText="Add manufacturing notes, special instructions, or requirements for this part (up to 2000 characters)." />

                @* DFM panel — shown when non-manifold *@
                @if (Part.IsManifold == false)
                {
                    <MudExpansionPanel Class="mt-2"
                                       Style="@(Part.DfmAcknowledged ? "background:#f0fdf4; border:1px solid #bbf7d0;" : "background:#fff7ed; border:1px solid #fed7aa;")">
                        <TitleContent>
                            <div style="display:flex;align-items:center;gap:4px;">
                                <MudIcon Icon="@(Part.DfmAcknowledged ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.WarningAmber)"
                                         Size="Size.Small"
                                         Color="@(Part.DfmAcknowledged ? Color.Success : Color.Warning)" />
                                <MudText Color="@(Part.DfmAcknowledged ? Color.Success : Color.Warning)" Typo="Typo.body2" Style="font-weight:600;">
                                    @(Part.DfmAcknowledged ? "Non-manifold mesh — acknowledged" : "Non-manifold mesh detected")
                                </MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body2">This mesh may have geometry issues affecting manufacturing.</MudText>
                            @{
                                var detailIssues = GetDfmIssueDetailSummary(Part.DfmReport);
                                if (detailIssues.Count > 0)
                                {
                                    <MudList T="string" Dense="true" Class="mt-2" Style="max-height:200px;overflow-y:auto;">
                                        @foreach (var issue in detailIssues)
                                        {
                                            <MudListItem Icon="@issue.Icon" Text="@issue.Text" />
                                        }
                                    </MudList>
                                }
                            }
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       Class="mt-2"
                                       Disabled="@Part.DfmAcknowledged"
                                       OnClick="@(() => NotifyChanged(p => p.DfmAcknowledged = true))"
                                       StartIcon="@(Part.DfmAcknowledged ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.WarningAmber)">
                                @(Part.DfmAcknowledged ? "Acknowledged" : "I understand — proceed")
                            </MudButton>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudTabPanel>

            <MudTabPanel Text="Drawings">
                <div class="pa-3">
                    <DrawingUploadSection PartId="Part.FileId"
                                         ProjectId="TempProjectId"
                                         Attachments="Part.DrawingFiles"
                                         AttachmentsChanged="OnDrawingAttachmentsChanged" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Files">
                <div class="pa-3">
                    <SupplementaryUploadSection PartId="Part.FileId"
                                                ProjectId="TempProjectId"
                                                Attachments="Part.SupplementaryFiles"
                                                AttachmentsChanged="OnSupplementaryAttachmentsChanged" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Bulk Pricing">
                <MudText Color="Color.Secondary" Typo="Typo.body2">
                    Bulk pricing tiers — not yet available
                </MudText>
            </MudTabPanel>
        </MudTabs>
    </div>
</div>

<style>
    @@keyframes blur-pulse {
        0%   { filter: blur(8px); }
        100% { filter: blur(3px); }
    }
    @@keyframes fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    .pdc-root {
        display: flex;
        flex: 1;
        min-height: 0;
        background: var(--mud-palette-surface);
        overflow: hidden;
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    .pdc-viewer-col {
        width: 60%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--mud-palette-lines-default);
    }
    .pdc-config-col {
        width: 40%;
        min-width: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }
    .pdc-thumb-area {
        position: relative;
        flex: 1;
        background: var(--mud-palette-background-grey);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 200px;
    }
    .pdc-thumb-blurred {
        width: 100%;
        height: 100%;
        object-fit: cover;
        animation: blur-pulse 1.8s ease-in-out alternate infinite;
    }
    .pdc-thumb-sharp {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .pdc-thumb-fade-in {
        animation: fade-in 0.4s ease-in-out forwards;
    }
    .pdc-upload-progress {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        z-index: 1;
    }
    .pdc-cube-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: fade-in 0.2s ease-in-out;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
    /* Cube always visible; animate only on hover */
    .pdc-cube-overlay .animated-cube-icon .cube {
        opacity: 1 !important;
    }
    .pdc-cube-overlay:hover .animated-cube-icon .cube {
        animation: cubeRotate 6s linear infinite !important;
    }
    .pdc-cube-label {
        font-size: 11px;
        font-weight: 600;
        color: white;
        background: rgba(0,0,0,0.55);
        padding: 2px 8px;
        border-radius: 10px;
        white-space: nowrap;
        pointer-events: none;
    }
    .pdc-3d-viewer-container {
        position: absolute;
        inset: 0;
        z-index: 3;
        background: var(--mud-palette-background-grey);
    }
    .pdc-3d-back-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 10;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0,0,0,0.5);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }
    .pdc-3d-back-btn:hover { background: rgba(0,0,0,0.7); }
    .pdc-viewer-meta {
        padding: 8px 12px;
        background: var(--mud-palette-surface);
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    .pdc-filename {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pdc-field-group {
        margin-bottom: 12px;
    }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    [Parameter] public PartViewModel Part { get; set; } = null!;
    [Parameter] public List<ProcessDto> Processes { get; set; } = [];
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }
    [Parameter] public EventCallback<PartViewModel> OnOpenViewer { get; set; }
    [Parameter] public Guid TempProjectId { get; set; }

    private bool _showViewer3d;
    private int _activeTab;
    private string _selectionMode = "rich";
    private readonly Dictionary<string, string> _resolvedUrls = [];
    private Guid _lastPartId;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastPartId != Guid.Empty && _lastPartId != Part.FileId && _showViewer3d)
        {
            await CloseViewer();
        }
        _lastPartId = Part.FileId;
        await base.OnParametersSetAsync();
    }

    private async Task OpenViewer()
    {
        _showViewer3d = true;
        await OnOpenViewer.InvokeAsync(Part);
    }

    private async Task CloseViewer()
    {
        _showViewer3d = false;
        Part.ViewerUrl = null;
        Part.GlbSignedUrl = null;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnImageErrorAsync(string? currentSrc, Action<string?> setUrl, bool isLargeThumbnail = false)
    {
        if (string.IsNullOrEmpty(currentSrc))
            return;

        if (_resolvedUrls.TryGetValue(currentSrc, out var cached))
        {
            setUrl(cached);
            await OnPartChanged.InvokeAsync(Part);
            return;
        }

        try
        {
            var resp = await Http.GetAsync($"api/uploads/preview-url?storagePath={Uri.EscapeDataString(currentSrc)}");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<JsonDocument>();
                var resolved = json?.RootElement.GetProperty("url").GetString();
                if (!string.IsNullOrEmpty(resolved))
                {
                    _resolvedUrls[currentSrc] = resolved;
                    setUrl(resolved);
                    Snackbar.Add($"Preview URL resolved for {Part.Name}", Severity.Success);
                    await OnPartChanged.InvokeAsync(Part);
                    return;
                }
            }
            Snackbar.Add($"Preview URL resolution returned empty for {Part.Name} (raw path: {currentSrc})", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Preview URL resolution failed for {Part.Name}: {ex.Message}", Severity.Error);
        }
    }

    private void NotifyChanged(Action<PartViewModel> mutate)
    {
        mutate(Part);
        OnPartChanged.InvokeAsync(Part);
    }

    /// <summary>
    /// Extracts a human-readable list of DFM issue details from a DFM report payload.
    /// </summary>
    private static List<(string Icon, string Text)> GetDfmIssueDetailSummary(object? dfmReport)
    {
        var issues = new List<(string Icon, string Text)>();
        if (dfmReport == null) return issues;

        switch (dfmReport)
        {
            case FdmDfmReportPayload fdm:
                if (fdm.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{fdm.ThinWallCount} thin wall region(s)"));
                if (fdm.OverhangFaceCount > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{fdm.OverhangFaceCount} overhang face(s)"));
                if (fdm.SupportRequired)
                    issues.Add((Icons.Material.Filled.AddHome, "Support structures required"));
                if (fdm.SmallDetailCount > 0)
                    issues.Add((Icons.Material.Filled.ZoomOutMap, $"{fdm.SmallDetailCount} small detail(s) may be lost"));
                break;

            case SlaDfmReportPayload sla:
                if (sla.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{sla.ThinWallCount} thin wall region(s)"));
                if (sla.ResinTrappingRisk)
                    issues.Add((Icons.Material.Filled.Water, "Resin trapping risk"));
                if (sla.SuctionRisk)
                    issues.Add((Icons.Material.Filled.Opacity, "Suction risk during peeling"));
                if (sla.HollowRegions.Count > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{sla.HollowRegions.Count} hollow region(s)"));
                break;

            case CncDfmReportPayload cnc:
                if (cnc.SharpCornerCount > 0)
                    issues.Add((Icons.Material.Filled.BugReport, $"{cnc.SharpCornerCount} sharp corner(s)"));
                if (cnc.HasUndercuts)
                    issues.Add((Icons.Material.Filled.ContentCut, "Undercut features detected"));
                if (cnc.HasDrillHoles && cnc.DrillHoleCount > 0)
                    issues.Add((Icons.Material.Filled.Handyman, $"{cnc.DrillHoleCount} drill hole(s)"));
                if (cnc.RequiresEdm)
                    issues.Add((Icons.Material.Filled.Build, "EDM required for complex features"));
                if (cnc.RequiresGrinding)
                    issues.Add((Icons.Material.Filled.RotateRight, "Grinding required for flat surfaces"));
                break;
        }

        return issues;
    }

    private Task OnSelectionModeChanged(string mode)
    {
        _selectionMode = mode;
        return Task.CompletedTask;
    }

    private void OnProcessChanged(Guid? processId)
    {
        NotifyChanged(p =>
        {
            p.ProcessId = processId;
            p.ProcessCode = Processes.FirstOrDefault(x => x.Id == processId)?.Code;
            p.MaterialId = null; p.MaterialCode = null;
            p.FinishId = null; p.FinishCode = null;
            p.ToleranceId = null; p.ToleranceCode = null;
            p.DfmAcknowledged = false;
            p.AvailableMaterials = [];
            p.AvailableFinishes = [];
            p.AvailableTolerances = [];
        });
    }

    private void OnMaterialChanged(Guid? materialId) =>
        NotifyChanged(p =>
        {
            p.MaterialId = materialId;
            p.MaterialCode = p.AvailableMaterials.FirstOrDefault(x => x.Id == materialId)?.Code;
        });

    private void OnFinishChanged(Guid? finishId) =>
        NotifyChanged(p =>
        {
            p.FinishId = finishId;
            p.FinishCode = p.AvailableFinishes.FirstOrDefault(x => x.Id == finishId)?.Code;
        });

    private void OnToleranceChanged(Guid? toleranceId) =>
        NotifyChanged(p =>
        {
            p.ToleranceId = toleranceId;
            p.ToleranceCode = p.AvailableTolerances.FirstOrDefault(x => x.Id == toleranceId)?.Code;
        });

    private void OnQuantityChanged(int qty) =>
        NotifyChanged(p => p.Quantity = Math.Clamp(qty, 1, 999));

    private Task OnDrawingAttachmentsChanged(List<DraftProjectAttachmentDto> attachments)
    {
        Part.DrawingFiles = attachments;
        return OnPartChanged.InvokeAsync(Part);
    }

    private Task OnSupplementaryAttachmentsChanged(List<DraftProjectAttachmentDto> attachments)
    {
        Part.SupplementaryFiles = attachments;
        return OnPartChanged.InvokeAsync(Part);
    }
}
