// TODO: Auto-enter 3D mode on part selection — the "View in 3D" button currently required
@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos
@using Maliev.MessagingContracts.Contracts.Geometry
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using MudBlazor
@inject Maliev.Intranet.Client.Services.FileTypesSettings FileTypes

<div class="pdc-container">
    <div class="pdc-viewer-wrap pdc-polkadot">
        @* Thumbnail area *@
        <div class="pdc-thumb-area">

            @* ── 3D Viewer Mode (auto-loads when URL is available) ──────── *@
            @if (!string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.GlbSignedUrl))
            {
                <div class="pdc-3d-viewer-container">
                    @if (!string.IsNullOrEmpty(Part.ViewerUrl))
                    {
                        <ModelViewer ViewerUrl="@Part.ViewerUrl" FileExtension=".glb"
                                     KnownDimensions="@Part.Dimensions" />
                    }
                    else
                    {
                        <MudProgressCircular Indeterminate="true" />
                    }
                    <button class="pdc-3d-back-btn"
                            @onclick="@CloseViewer"
                            title="Back to thumbnail">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            else
            {
                @* ── Thumbnail Mode ────────────────────────────────── *@

                @* Blurred small thumbnail while large is loading *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && Part.AwaitingPreview)
                {
                    <img src="@Part.ThumbnailSmallUrl"
                         class="pdc-thumb-blurred"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailSmallUrl, v => Part.ThumbnailSmallUrl = v))" />
                }

                @* Sharp large thumbnail once ready *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailLargeUrl))
                {
                    <img src="@Part.ThumbnailLargeUrl"
                         class="pdc-thumb-sharp pdc-thumb-fade-in"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailLargeGcsPath ?? Part.ThumbnailLargeUrl, v => Part.ThumbnailLargeUrl = v, isLargeThumbnail: true))" />
                }

                @* Upload / processing progress overlay *@
                @if ((Part.Uploading || Part.AwaitingPreview) && string.IsNullOrEmpty(Part.ThumbnailSmallUrl))
                {
                    <div class="pdc-upload-progress">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Part.StatusText</MudText>
                    </div>
                }

                @* Fallback grey background — no preview *@
                @if (string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && !Part.AwaitingPreview && !Part.Uploading)
                {
                    <MudIcon Icon="@FileTypes.GetIcon(Path.GetExtension(Part.Name))" Size="Size.Large" Color="Color.Default" />
                }

            }

            @* DFM overlay — positioned absolute over viewer area *@
            <DfmOverlayPanel DfmIssues="@_dfmIssues"
                             IsVisible="@(_dfmIssues.Count > 0 && !Part.DfmAcknowledged)"
                             OnAcknowledged="@HandleDfmAcknowledged" />
        </div>

        @* Viewer meta *@
        <div class="pdc-viewer-meta">
            <MudText Typo="Typo.caption" Class="pdc-filename">@Part.Name</MudText>
            @if (Part.Dimensions != null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @($"{Part.Dimensions.X:N1} × {Part.Dimensions.Y:N1} × {Part.Dimensions.Z:N1} mm")
                </MudText>
            }
        </div>
    </div>
</div>

<style>
    @@keyframes blur-pulse {
        0%   { filter: blur(8px); }
        100% { filter: blur(3px); }
    }
    @@keyframes fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    .pdc-container {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }
    .pdc-viewer-wrap {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }
    .pdc-polkadot {
        background-color: var(--mud-palette-background);
        background-image: radial-gradient(circle, var(--mud-palette-lines-default) 1px, transparent 1px);
        background-size: 20px 20px;
        position: relative;
    }
    .pdc-thumb-area {
        position: relative;
        flex: 1;
        background: var(--mud-palette-background-grey);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 200px;
    }
    .pdc-thumb-blurred {
        width: 100%;
        height: 100%;
        object-fit: cover;
        animation: blur-pulse 1.8s ease-in-out alternate infinite;
    }
    .pdc-thumb-sharp {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .pdc-thumb-fade-in {
        animation: fade-in 0.4s ease-in-out forwards;
    }
    .pdc-upload-progress {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        z-index: 1;
    }
    .pdc-3d-viewer-container {
        position: absolute;
        inset: 0;
        z-index: 3;
        background: var(--mud-palette-background-grey);
    }
    .pdc-3d-back-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 10;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0,0,0,0.5);
        color: white;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }
    .pdc-3d-back-btn:hover { background: rgba(0,0,0,0.7); }
    .pdc-cube-overlay {
        position: absolute;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        animation: fade-in 0.2s ease-in-out;
    }
    .pdc-viewer-meta {
        padding: 8px 12px;
        background: var(--mud-palette-surface);
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    .pdc-filename {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    /// <summary>Injected HTTP client for refreshing signed thumbnail URLs.</summary>
    [Inject] private HttpClient Http { get; set; } = null!;

    /// <summary>Injected snackbar service for user notifications.</summary>
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    /// <summary>The part view model to display in this card.</summary>
    [Parameter] public PartViewModel Part { get; set; } = null!;

    /// <summary>Callback invoked when any property of <see cref="Part"/> changes.</summary>
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }

    /// <summary>Callback invoked when the user requests to open the 3D viewer for this part.</summary>
    [Parameter] public EventCallback<PartViewModel> OnOpenViewer { get; set; }

    /// <summary>The temporary project ID used for file upload endpoints.</summary>
    [Parameter] public Guid TempProjectId { get; set; }

    private readonly Dictionary<string, string> _resolvedUrls = [];
    private Guid _lastPartId;
    private List<DfmIssue> _dfmIssues = [];

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_lastPartId != Guid.Empty && _lastPartId != Part.FileId && !string.IsNullOrEmpty(Part.ViewerUrl))
        {
            await CloseViewer();
        }
        _lastPartId = Part.FileId;
        _dfmIssues = BuildDfmIssues();
        await base.OnParametersSetAsync();
    }

    private async Task CloseViewer()
    {
        Part.ViewerUrl = null;
        Part.GlbSignedUrl = null;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnImageErrorAsync(string? currentSrc, Action<string?> setUrl, bool isLargeThumbnail = false)
    {
        if (string.IsNullOrEmpty(currentSrc))
            return;

        if (_resolvedUrls.TryGetValue(currentSrc, out var cached))
        {
            setUrl(cached);
            await OnPartChanged.InvokeAsync(Part);
            return;
        }

        try
        {
            var resp = await Http.GetAsync($"api/uploads/preview-url?storagePath={Uri.EscapeDataString(currentSrc)}");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<JsonDocument>();
                var resolved = json?.RootElement.GetProperty("url").GetString();
                if (!string.IsNullOrEmpty(resolved))
                {
                    _resolvedUrls[currentSrc] = resolved;
                    setUrl(resolved);
                    await OnPartChanged.InvokeAsync(Part);
                }
            }
        }
        catch
        {
            // Silently ignore — thumbnail URL refresh is best-effort
        }
    }

    private void NotifyChanged(Action<PartViewModel> mutate)
    {
        mutate(Part);
        OnPartChanged.InvokeAsync(Part);
    }

    private Task HandleDfmAcknowledged()
    {
        NotifyChanged(p => p.DfmAcknowledged = true);
        return Task.CompletedTask;
    }

    private List<DfmIssue> BuildDfmIssues()
    {
        var raw = GetDfmIssueDetailSummary(Part.DfmReport);
        return raw
            .Select(t => new DfmIssue(Icon: t.Icon, Title: t.Text, Description: t.Description, Severity: DfmIssueSeverity.Warning))
            .ToList();
    }

    /// <summary>
    /// Extracts a human-readable list of DFM issue details from a DFM report payload.
    /// </summary>
    private static List<(string Icon, string Text, string Description)> GetDfmIssueDetailSummary(object? dfmReport)
    {
        var issues = new List<(string Icon, string Text, string Description)>();
        if (dfmReport == null) return issues;

        switch (dfmReport)
        {
            case FdmDfmReportPayload fdm:
                if (fdm.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{fdm.ThinWallCount} thin wall region(s)", "Wall thickness below minimum recommended for FDM printing"));
                if (fdm.OverhangFaceCount > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{fdm.OverhangFaceCount} overhang face(s)", "Faces at steep angles may require support structures"));
                if (fdm.SupportRequired)
                    issues.Add((Icons.Material.Filled.AddHome, "Support structures required", "This model requires support structures for printing"));
                if (fdm.SmallDetailCount > 0)
                    issues.Add((Icons.Material.Filled.ZoomOutMap, $"{fdm.SmallDetailCount} small detail(s) may be lost", "Some fine details may not reproduce accurately"));
                break;

            case SlaDfmReportPayload sla:
                if (sla.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{sla.ThinWallCount} thin wall region(s)", "Wall thickness may cause resin drainage or print failure"));
                if (sla.ResinTrappingRisk)
                    issues.Add((Icons.Material.Filled.Water, "Resin trapping risk", "Enclosed cavities may trap resin during printing"));
                if (sla.SuctionRisk)
                    issues.Add((Icons.Material.Filled.Opacity, "Suction risk during peeling", "Large flat surfaces may cause suction during peeling"));
                if (sla.HollowRegions.Count > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{sla.HollowRegions.Count} hollow region(s)", "Hollow regions may require additional drainage holes"));
                break;

            case CncDfmReportPayload cnc:
                if (cnc.SharpCornerCount > 0)
                    issues.Add((Icons.Material.Filled.BugReport, $"{cnc.SharpCornerCount} sharp corner(s)", "Sharp inside corners cannot be cut precisely with standard end mills"));
                if (cnc.HasUndercuts)
                    issues.Add((Icons.Material.Filled.ContentCut, "Undercut features detected", "Undercut features require special machining strategies or EDM"));
                if (cnc.HasDrillHoles && cnc.DrillHoleCount > 0)
                    issues.Add((Icons.Material.Filled.Handyman, $"{cnc.DrillHoleCount} drill hole(s)", $"This model has {cnc.DrillHoleCount} drill hole(s) to machine"));
                if (cnc.RequiresEdm)
                    issues.Add((Icons.Material.Filled.Build, "EDM required for complex features", "Complex internal geometry requires EDM (Electrical Discharge Machining)"));
                if (cnc.RequiresGrinding)
                    issues.Add((Icons.Material.Filled.RotateRight, "Grinding required for flat surfaces", "Flat surfaces require grinding for tight tolerance"));
                break;
        }

        return issues;
    }
}
