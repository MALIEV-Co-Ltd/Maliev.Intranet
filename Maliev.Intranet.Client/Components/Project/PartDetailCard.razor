    private bool _scaleDialogVisible;
    private string _scaleSourceUnit = "mm";
    private double _scaleCustomFactor = 1.0;

    private static readonly string[] RescalableExtensions = [".stl", ".obj"];

    private bool CanRescalePart =>
        OnRescalePart.HasDelegate
        && !string.IsNullOrEmpty(Part.StoragePath)
        && RescalableExtensions.Contains(
            Path.GetExtension(Part.Name ?? Part.StoragePath ?? string.Empty),
            StringComparer.OrdinalIgnoreCase);

    /// <summary>Callback invoked when the user applies a rescale; the page re-uploads the scaled file.</summary>
    [Parameter] public EventCallback<PartRescaleRequest> OnRescalePart { get; set; }

    private void OpenScaleDialog()
    {
        _scaleSourceUnit = "mm";
        _scaleCustomFactor = 1.0;
        _scaleDialogVisible = true;
    }

    private double ResolveScaleFactor()
    {
        var unitFactor = _scaleSourceUnit switch
        {
            "cm" => 10.0,
            "m" => 1000.0,
            "in" => 25.4,
            _ => 1.0,
        };
        var custom = double.IsFinite(_scaleCustomFactor) && _scaleCustomFactor > 0 ? _scaleCustomFactor : 1.0;
        return unitFactor * custom;
    }

    private async Task ApplyRescaleAsync()
    {
        var factor = ResolveScaleFactor();
        _scaleDialogVisible = false;
        if (Math.Abs(factor - 1.0) < 0.0000001 || !OnRescalePart.HasDelegate) return;
        await OnRescalePart.InvokeAsync(new PartRescaleRequest(Part, factor));
    }

    private double GetSelectedMaterialDensityGcm3()
    {
        if (Part.MaterialId.HasValue)
        {
            var selectedMaterial = Part.AvailableMaterials.FirstOrDefault(material => material.Id == Part.MaterialId.Value);
            if (selectedMaterial?.DensityGCm3 is > 0m)
                return (double)selectedMaterial.DensityGCm3.Value;
        }

        return GetMaterialDensityGcm3(Part.MaterialCode);
    }

    private static double GetMaterialDensityGcm3(string? materialCode)
    {
        if (string.IsNullOrEmpty(materialCode)) return 1.0;
        var key = materialCode.ToLowerInvariant().Replace("-", "").Replace(" ", "").Replace("_", "");
        if (key.Contains("al6061") || key.Contains("aluminum6061") || key.Contains("aluminium6061")) return 2.70;
        if (key.Contains("al7075") || key.Contains("aluminum7075") || key.Contains("aluminium7075")) return 2.81;
        if (key.Contains("aluminum") || key.Contains("aluminium") || key.StartsWith("al")) return 2.70;
        if (key.Contains("ss304") || key.Contains("stainlesssteel304") || key.Contains("stainless304")) return 8.00;
        if (key.Contains("ss316") || key.Contains("stainlesssteel316") || key.Contains("stainless316")) return 8.00;
        if (key.Contains("stainless")) return 8.00;
        if (key.Contains("steel") || key.Contains("mildsteel") || key.Contains("steelmild")) return 7.85;
        if (key.Contains("brass")) return 8.50;
        if (key.Contains("copper")) return 8.96;
        if (key.Contains("titanium") || key.Contains("ti6al4v")) return 4.43;
        if (key.Contains("pom") || key.Contains("delrin") || key.Contains("acetal")) return 1.41;
        if (key.Contains("peek")) return 1.32;
        if (key.Contains("pla")) return 1.24;
        if (key.Contains("abs")) return 1.05;
        if (key.Contains("petg")) return 1.27;
        if (key.Contains("nylon") || key.Contains("pa12") || key.Contains("pa11") || key.Contains("pa6")) return 1.01;
        if (key.Contains("resin") || key.Contains("tough") || key.Contains("sladlp")) return 1.15;
        if (key.Contains("carbon") || key.StartsWith("cf")) return 1.55;
        return 1.0;
    }

    private bool DfmUnavailable =>
        Part.DfmAnalysisTimedOut
        || Part.AnalysisErrorCode == "FILE_MISSING";

    private enum LocalDfmEngineStatus { None, Running, Completed, Unavailable, Error }

    private LocalDfmEngineStatus GetLocalDfmEngineStatus()
    {
        var processCode = Part.ProcessCode;
        if (string.IsNullOrEmpty(processCode)) return LocalDfmEngineStatus.None;
        var norm = ProcessCodeNormalizer.Normalize(processCode) ?? processCode;

        if (BrowserDfmReportSync.HasActiveLocalAttempt(Part, processCode))
            return LocalDfmEngineStatus.Running;

        if (Part.LocalDfmRuntimeTerminalProcessCode != null
            && ProcessCodeNormalizer.Equals(Part.LocalDfmRuntimeTerminalProcessCode, norm))
        {
            var reason = Part.LocalDfmRuntimeTerminalReason;
            return reason is "invalid_result" or "worker_failed"
                ? LocalDfmEngineStatus.Error
                : LocalDfmEngineStatus.Unavailable;
        }

        if (Part.LocalDfmRuntimeCompletedForProcessCode != null
            && ProcessCodeNormalizer.Equals(Part.LocalDfmRuntimeCompletedForProcessCode, norm))
            return LocalDfmEngineStatus.Completed;

        return LocalDfmEngineStatus.None;
    }

    private static string GetLocalDfmEngineTooltip(LocalDfmEngineStatus status) => status switch
    {
        LocalDfmEngineStatus.Running     => "Local DFM engine is running on this device",
        LocalDfmEngineStatus.Completed   => "DFM analysis ran locally on this device",
        LocalDfmEngineStatus.Unavailable => "Local DFM engine unavailable — server will be used",
        LocalDfmEngineStatus.Error       => "Local DFM engine encountered an error — server will be used",
        _                                => string.Empty
    };

