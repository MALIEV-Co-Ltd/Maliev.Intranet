    private async Task DownloadOriginalAsync()
    {
        if (string.IsNullOrEmpty(Part.StoragePath)) return;
        _downloading = true;
        try
        {
            var response = await Http.GetAsync($"api/v1/uploads/preview-url?storagePath={Uri.EscapeDataString(Part.StoragePath)}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (result.TryGetProperty("url", out var urlProp))
                {
                    var url = urlProp.GetString();
                    if (url != null)
                    {
                        // Signed storage URLs serve hashed object names — download
                        // through the helper so the file keeps its original name.
                        var fileName = ResolveDownloadFileName();
                        await JS.InvokeVoidAsync("malievFiles.downloadFromUrl", url, fileName);
                    }
                }
            }
        }
        catch
        {
            // Silent — the button is already disabled
        }
        finally
        {
            _downloading = false;
        }
    }

    private string ResolveDownloadFileName()
    {
        var name = Part.Name;
        if (string.IsNullOrWhiteSpace(name))
            name = Path.GetFileName(Part.StoragePath ?? string.Empty);

        // Storage paths prefix the original name with an upload hash
        // ("ab12cd34_stud bolt.step"). Strip it if that storage object name
        // leaks into the part name or when the visible name has no extension.
        var storageName = Path.GetFileName(Part.StoragePath ?? string.Empty);
        if (TryStripGeneratedUploadPrefix(name, out var cleanedName)
            || (string.IsNullOrWhiteSpace(Path.GetExtension(name))
                && TryStripGeneratedUploadPrefix(storageName, out cleanedName)))
        {
            name = cleanedName;
        }

        return string.IsNullOrWhiteSpace(name) ? "part" : name;
    }

    private static bool TryStripGeneratedUploadPrefix(string? fileName, out string cleanedName)
    {
        cleanedName = string.Empty;
        if (string.IsNullOrWhiteSpace(fileName))
            return false;

        var leafName = Path.GetFileName(fileName);
        var underscore = leafName.IndexOf('_', StringComparison.Ordinal);
        if (underscore < 6 || underscore >= leafName.Length - 1)
            return false;

        var prefix = leafName[..underscore];
        if (!prefix.Any(char.IsDigit) || !prefix.All(char.IsAsciiLetterOrDigit))
            return false;

        var candidate = leafName[(underscore + 1)..];
        if (string.IsNullOrWhiteSpace(candidate) || string.IsNullOrWhiteSpace(Path.GetExtension(candidate)))
            return false;

        cleanedName = candidate;
        return true;
    }
    private string? _viewerErrorMessage;
    private CancellationTokenSource? _dfmTimeoutCts;
    private const int DfmTimeoutSeconds = 600;
    private ModelViewer? _modelViewer;
    private DfmOverlayPanel? _dfmPanel;
    private bool _multiBodyInitialized;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var partChanged = Part.FileId != _lastPartId;
        var processChanged = Part.ProcessCode != _lastProcessCode;
        var prevPartId = _lastPartId;
        _lastPartId = Part.FileId;
        _lastProcessCode = Part.ProcessCode;

        if (partChanged || processChanged)
        {
            _dfmPanel?.ResetOverlays();
            if (_modelViewer != null)
            {
                await _modelViewer.ClearTemporaryGridOwnersAsync();
                await _modelViewer.ClearDfmOverlaysAsync(prevPartId.ToString());
            }
            if (partChanged)
            {
                _viewerLoadFailed = false;
                _viewerErrorMessage = null;
                _pendingLocalDfmProcessCode = null;
                _viewerConfigurationPushPending = false;
                _hasPushedInitialMaterialConfig = false;
            }
        }

        _dfmIssues = BuildDfmIssues();
        if (!string.IsNullOrEmpty(Part.ViewerUrl))
        {
            _viewerLoadFailed = false;
            _viewerErrorMessage = null;

            var materialColor = ColorNameToHex(GetMaterialColorFromOptions(Part));
            var materialChanged = !string.Equals(Part.MaterialCode, _lastMaterialCode, StringComparison.Ordinal);
            var colorChanged = !string.Equals(materialColor, _lastMaterialColor, StringComparison.Ordinal);
            var finishChanged = !string.Equals(Part.FinishCode, _lastFinishCode, StringComparison.Ordinal);
            var roughnessChanged = !string.Equals(Part.RoughnessCode, _lastRoughnessCode, StringComparison.Ordinal);
            var initialPush = !_hasPushedInitialMaterialConfig
                && !string.IsNullOrEmpty(Part.MaterialCode);
            if (materialChanged || colorChanged || finishChanged || roughnessChanged || processChanged || initialPush)
                await PushViewerConfiguratorStateAsync(processChanged ? Part.ProcessCode : null);

            // Initialize multi-body viewer when bodies are available
            if (Part.BodyCount > 1 && Part.Bodies.Count > 0 && !_multiBodyInitialized)
            {
                _ = InitializeMultiBodyViewerAsync();
            }
        }

        // DFM watchdog: arm as soon as upload completes (StoragePath assigned), not only when
        // the GLB viewer loads. This ensures the spinner cannot hang indefinitely even when
        // Phase 1 tessellation is slow and GlbReady never arrives within the backend budget.
        // Timer budget matches backend Phase 1 (300 s) + Phase 2 DFM (300 s) = 600 s.
        var uploadCompleted = !Part.Uploading && !string.IsNullOrEmpty(Part.StoragePath);
        var dfmPending = Part.DfmReport == null && !Part.DfmAcknowledged && !DfmUnavailable;

        if (uploadCompleted && dfmPending && _dfmTimeoutCts == null)
        {
            _dfmTimeoutCts = new CancellationTokenSource();
            var token = _dfmTimeoutCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(DfmTimeoutSeconds), token);
                    if (!token.IsCancellationRequested && Part.DfmReport == null)
                    {
                        Part.DfmAnalysisTimedOut = true;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { }
            }, token);
        }
        else if (!uploadCompleted || !dfmPending)
        {
            // Cancel any pending watchdog — report arrived, failure event received, or part changed
            _dfmTimeoutCts?.Cancel();
            _dfmTimeoutCts?.Dispose();
            _dfmTimeoutCts = null;
        }

        await base.OnParametersSetAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_modelViewer == null || string.IsNullOrEmpty(Part.ViewerUrl))
            return;

        if (!_viewerConfigurationPushPending && string.IsNullOrWhiteSpace(_pendingLocalDfmProcessCode))
            return;

        var localDfmProcessCode = _pendingLocalDfmProcessCode;
        if (!string.IsNullOrWhiteSpace(localDfmProcessCode)
            && !ProcessCodeNormalizer.Equals(Part.ProcessCode, localDfmProcessCode))
        {
            localDfmProcessCode = null;
        }

        await PushViewerConfiguratorStateAsync(localDfmProcessCode);
    }

    private async Task PushViewerConfiguratorStateAsync(string? localDfmProcessCode = null)
    {
        if (_modelViewer == null)
        {
            _viewerConfigurationPushPending = true;
            if (!string.IsNullOrWhiteSpace(localDfmProcessCode))
                _pendingLocalDfmProcessCode = Part.ProcessCode;
            return;
        }

        var materialColor = ColorNameToHex(GetMaterialColorFromOptions(Part));
        _lastMaterialCode = Part.MaterialCode;
        _lastMaterialColor = materialColor;
        _lastFinishCode = Part.FinishCode;
        _lastRoughnessCode = Part.RoughnessCode;
        _hasPushedInitialMaterialConfig = true;
        _viewerConfigurationPushPending = false;
        _pendingLocalDfmProcessCode = null;

        await _modelViewer.ApplyConfiguratorMaterialAsync(
            Part.ProcessCode, Part.MaterialCode, materialColor, Part.FinishCode, Part.RoughnessCode);

        if (!string.IsNullOrWhiteSpace(localDfmProcessCode))
            await _modelViewer.RunLocalGeometryRuntimeAsync(localDfmProcessCode);
    }

