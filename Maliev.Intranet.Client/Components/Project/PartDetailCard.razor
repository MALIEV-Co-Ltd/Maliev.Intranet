@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos
@using Maliev.MessagingContracts.Contracts.Geometry
@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using System.Text.Json
@using MudBlazor
@using Maliev.Intranet.Client.Services
@inject FileTypesSettings FileTypes
@inject CurrencyService CurrencyService
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable

<div class="pdc-root">
@* ── Header Row ────────────────────────────────────────────────────────────────────── *@
<div class="pdc-header">
    <div class="pdc-header-left">
        <div class="pdc-header-meta">
            <div class="pdc-header-name-row">
                <span class="pdc-header-name" title="@Part.Name">@System.IO.Path.GetFileNameWithoutExtension(Part.Name)</span>
                @if (GetStatusLabel() == "ANALYZED")
                {
                    <span class="pdc-status-pill pdc-status--ok pdc-status--analyzed">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:10px;width:10px;height:10px;" />
                        ANALYZED
                    </span>
                }
                else
                {
                    <span class="pdc-status-pill pdc-status--@GetStatusClass()">@GetStatusLabel()</span>
                }
            </div>
            <div class="pdc-header-subline">
                @GetUploadedLabel()
                @if (!string.IsNullOrEmpty(GetFormatLabel()))
                {
                    <span class="pdc-subline-sep">·</span>
                    <span>@GetFormatLabel()</span>
                }
                @if (GetFileSize() > 0)
                {
                    <span class="pdc-subline-sep">·</span>
                    <span>@FormatFileSize(GetFileSize())</span>
                }
            </div>
        </div>
    </div>
    <div class="pdc-header-tabs">
        <button class="pdc-tab @(_activeTab == 0 ? "pdc-tab--active" : "")" @onclick="@(async () => { _activeTab = 0; await Task.Yield(); if (_modelViewer != null) await _modelViewer.NotifyVisibleAsync(); })">
            <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" Class="pdc-tab-icon" />
            3D Model
        </button>
        <button class="pdc-tab @(_activeTab == 1 ? "pdc-tab--active" : "")" @onclick="@(() => _activeTab = 1)">
            <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" Class="pdc-tab-icon" />
            Drawing
        </button>
        <button class="pdc-tab @(_activeTab == 2 ? "pdc-tab--active" : "")" @onclick="@(() => _activeTab = 2)">
            <MudIcon Icon="@Icons.Material.Outlined.Science" Size="Size.Small" Class="pdc-tab-icon" />
            DFM
            @if (_dfmIssues.Count > 0)
            {
                <span class="pdc-tab-badge">@_dfmIssues.Count</span>
            }
        </button>
    </div>
    <div class="pdc-header-right">
        @if (!string.IsNullOrEmpty(Part.StoragePath))
        {
            <button class="pdc-icon-btn" title="Download original file" @onclick="DownloadOriginalAsync" disabled="@_downloading">
                @if (_downloading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                }
            </button>
        }
        @if (OnRemovePart.HasDelegate)
        {
            <button class="pdc-icon-btn pdc-icon-btn--danger" title="Remove part"
                    @onclick="@(() => OnRemovePart.InvokeAsync(Part))">
                <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
            </button>
        }
    </div>
</div>

<div class="pdc-container">
    @* ── Tab: DFM Checks ───────────────────────────────────────────────────────────── *@
    @if (_activeTab == 2)
    {
        <DfmChecksTab Part="@Part" />
    }

    @* ── Tab: Drawing Files ─────────────────────────────────────────────────────────────── *@
    @if (_activeTab == 1)
    {
        <DrawingAttachmentsTab Part="@Part"
                               TempProjectId="@TempProjectId"
                               OnPartChanged="@OnPartChanged" />
    }

    @* ── Tab: 3D Viewer + Body Selection ───────────────────────────────────────────────── *@
    @* Retain-and-hide: keep the Babylon engine alive across tab switches so GLB isn't reloaded. *@
    <div class="pdc-viewer-wrap pdc-polkadot" style="@(_activeTab == 0 ? "" : "display:none")"
         aria-hidden="@(_activeTab != 0 ? "true" : null)">

        @* Thumbnail area *@
        <div class="pdc-thumb-area">

            @* ── 3D Viewer Mode (auto-loads when URL is available) ──────── *@
            @if (!string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.GlbSignedUrl))
            {
                <div class="pdc-3d-viewer-container">
                    @if (!string.IsNullOrEmpty(Part.ViewerUrl))
                    {
                        <ModelViewer @ref="_modelViewer"
                                     ViewerUrl="@Part.ViewerUrl" FileExtension=".glb"
                                     KnownDimensions="@Part.Dimensions"
                                     TurningAxis="@BuildTurningAxis()"
                                     OnLoadFailed="HandleViewerLoadFailed"
                                     OnBodyPicked="HandleBodyPickedAsync" />
                    }
                    else if (_viewerLoadFailed)
                    {
                        <div class="pdc-viewer-error">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Warning" />
                            <MudText Typo="Typo.body2" Color="Color.Warning">3D preview failed</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@_viewerErrorMessage</MudText>
                        </div>
                    }
                    else
                    {
                        <MudProgressCircular Indeterminate="true" />
                    }
                </div>
            }
            else
            {
                @* ── Thumbnail Mode ────────────────────────────────── *@

                @* Blurred small thumbnail while large is loading *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && Part.AwaitingPreview)
                {
                    <img src="@Part.ThumbnailSmallUrl"
                         class="pdc-thumb-blurred"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailSmallUrl, v => Part.ThumbnailSmallUrl = v))" />
                }

                @* Sharp large thumbnail once ready *@
                @if (!string.IsNullOrEmpty(Part.ThumbnailLargeUrl))
                {
                    <img src="@Part.ThumbnailLargeUrl"
                         class="pdc-thumb-sharp pdc-thumb-fade-in"
                         alt="@Part.Name"
                         @onerror="@(async () => await OnImageErrorAsync(Part.ThumbnailLargeGcsPath ?? Part.ThumbnailLargeUrl, v => Part.ThumbnailLargeUrl = v, isLargeThumbnail: true))" />
                }

                @* Upload / processing progress overlay *@
                @if (Part.QueuedUpload || Part.Uploading || Part.AwaitingPreview)
                {
                    <div class="pdc-upload-progress">
                        <MudProgressCircular Indeterminate="@(!Part.Uploading)"
                                             Value="@Part.ProgressPercent"
                                             Size="Size.Small"
                                             Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Part.StatusText</MudText>
                    </div>
                }

                @* Fallback grey background — no preview *@
                @if (string.IsNullOrEmpty(Part.ThumbnailSmallUrl) && string.IsNullOrEmpty(Part.ThumbnailLargeUrl) && !Part.QueuedUpload && !Part.AwaitingPreview && !Part.Uploading)
                {
                    <MudIcon Icon="@FileTypes.GetIcon(Path.GetExtension(Part.Name))" Size="Size.Large" Color="Color.Default" />
                }

            }

            @* Body tree — floating overlay top-right, visible only for multi-body files *@
            @if (Part.BodyCount > 1 && Part.Bodies.Count > 0)
            {
                <div class="pdc-body-tree @(_bodyTreeExpanded ? "pdc-body-tree--open" : "")">
                    <button class="pdc-body-tree-header" @onclick="@(() => _bodyTreeExpanded = !_bodyTreeExpanded)">
                        <span class="pdc-body-tree-icon">@((MarkupString)"<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='currentColor'><path d='M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z'/></svg>")</span>
                        <span class="pdc-body-tree-title">Bodies (@Part.BodyCount)</span>
                        <span class="pdc-body-tree-chevron @(_bodyTreeExpanded ? "pdc-body-tree-chevron--up" : "")">
                            @((MarkupString)"<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='currentColor'><path d='M7 10l5 5 5-5z'/></svg>")
                        </span>
                    </button>
                    @if (_bodyTreeExpanded)
                    {
                        <div class="pdc-body-tree-list">
                            <button class="pdc-body-tree-row @(Part.SelectedBodyIndex is null ? "pdc-body-tree-row--active" : "")"
                                    @onclick="ClearBodySelectionAsync">
                                <span class="pdc-body-swatch pdc-body-swatch--all"></span>
                                <span class="pdc-body-tree-name">All bodies</span>
                                @if (Part.SelectedBodyIndex is null)
                                {
                                    <span class="pdc-body-tree-check">✓</span>
                                }
                            </button>
                            @foreach (var body in Part.Bodies)
                            {
                                var b = body;
                                <button class="pdc-body-tree-row @(Part.SelectedBodyIndex == b.Index ? "pdc-body-tree-row--active" : "")"
                                        @onclick="@(() => SelectBodyAsync(b.Index))">
                                    <span class="pdc-body-swatch" style="@GetBodySwatchStyle(b)"></span>
                                    <span class="pdc-body-tree-name">@b.Name</span>
                                    @if (Part.SelectedBodyIndex == b.Index)
                                    {
                                        <span class="pdc-body-tree-check">✓</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @* DFM overlay — positioned absolute over viewer area *@
            <DfmOverlayPanel @ref="_dfmPanel" @key="@Part.FileId"
                             DfmIssues="@_dfmIssues"
                             IsVisible="@(_dfmIssues.Count > 0 && !Part.DfmAcknowledged)"
                             Analyzing="@(_dfmIssues.Count == 0 && Part.ViewerUrl != null && Part.DfmReport == null && !Part.DfmAcknowledged && !string.IsNullOrEmpty(Part.ProcessCode))"
                             TimedOut="@Part.DfmAnalysisTimedOut"
                             ErrorMessage="@(Part.DfmAnalysisTimedOut ? DfmStatusMessages.GetFriendlyMessage(Part.AnalysisErrorCode) : null)"
                             AllClear="@ShouldShowAllClearOverlay()"
                             OnAcknowledged="@HandleDfmAcknowledged"
                             OnToggleOverlay="@HandleToggleOverlay"
                             OnAllClearDismissed="@HandleAllClearDismissed" />
        </div>

    </div>

    @* end viewer wrap — always in DOM, hidden via CSS when not on the 3D tab *@
</div>

@* ── Footer Row ─────────────────────────────────────────────────────────────────────── *@
@if (!Part.Uploading && !Part.AwaitingPreview && !string.IsNullOrEmpty(Part.ProcessCode))
{
    <div class="pdc-footer">
        <div class="pdc-footer-chips">
            @if (!string.IsNullOrEmpty(Part.ProcessCode))
            {
                <div class="pdc-chip pdc-chip--process">
                    @((MarkupString)ProcessIconHelper.GetProcessSvg(Part.ProcessCode))
                    <span class="pdc-chip-process-label">@GetProcessName(Part.ProcessCode)</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Part.MaterialCode))
            {
                <span class="pdc-chip-sep">·</span>
                <span class="pdc-chip pdc-chip--material">@Part.MaterialCode</span>
            }
            @if (!string.IsNullOrEmpty(Part.FinishCode))
            {
                <span class="pdc-chip-sep">·</span>
                <span class="pdc-chip pdc-chip--finish">@FinishDisplay.Humanize(Part.FinishCode)</span>
            }
        </div>
        <div style="flex:1;" />
        @if (Part.EstimatedUnitPrice.HasValue)
        {
            <div class="pdc-footer-vdivider"></div>
            <span class="pdc-footer-price">
                @if (CurrencyService.IsConverting)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="120px" Height="16px" />
                }
                else
                {
                    <span class="pdc-footer-unit maliev-mono">@CurrencyService.Format(Part.EstimatedUnitPrice.Value) / ea</span>
                    <span class="pdc-footer-sep">·</span>
                    <span class="pdc-footer-total maliev-mono">@CurrencyService.Format(Part.EstimatedUnitPrice.Value * Part.Quantity) total</span>
                }
            </span>
        }
        else if (Part.PricingLoading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </div>
}

</div>@* end pdc-root *@


@code {
    /// <summary>Injected snackbar service for user notifications.</summary>
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    /// <summary>The part view model to display in this card.</summary>
    [Parameter] public PartViewModel Part { get; set; } = null!;

    /// <summary>Callback invoked when any property of <see cref="Part"/> changes.</summary>
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }

    /// <summary>Callback invoked when the user requests to open the 3D viewer for this part.</summary>
    [Parameter] public EventCallback<PartViewModel> OnOpenViewer { get; set; }

    /// <summary>Callback invoked when the 3D viewer fails to load (e.g., expired signed URL) to request a fresh URL.</summary>
    [Parameter] public EventCallback<string> OnRequestFreshViewerUrl { get; set; }

    /// <summary>The temporary project ID used for file upload endpoints.</summary>
    [Parameter] public Guid TempProjectId { get; set; }

    /// <summary>Callback invoked when the user clicks the remove button.</summary>
    [Parameter] public EventCallback<PartViewModel> OnRemovePart { get; set; }

    private int _activeTab = 0;
    private bool _bodyTreeExpanded = false;

    protected override void OnInitialized() => CurrencyService.Changed += OnCurrencyChanged;
    public void Dispose() => CurrencyService.Changed -= OnCurrencyChanged;
    private void OnCurrencyChanged(object? s, EventArgs e) => InvokeAsync(StateHasChanged);

    private string GetStatusClass() => Part switch
    {
        { QueuedUpload: true } => "muted",
        { Uploading: true } => "muted",
        { AwaitingPreview: true } => "warn",
        { Error: not null } => "error",
        { DfmReport: not null } => "ok",
        _ when (!string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.ThumbnailLargeUrl))
             && string.IsNullOrEmpty(Part.ProcessCode) => "warn",
        _ when !string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.ThumbnailLargeUrl) => "ok",
        _ => "muted"
    };

    private string GetStatusLabel() => Part switch
    {
        { QueuedUpload: true } => "QUEUED",
        { Uploading: true } => "UPLOADING",
        { AwaitingPreview: true } => "PROCESSING",
        { Error: not null } => "ERROR",
        { DfmReport: not null } => "ANALYZED",
        _ when (!string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.ThumbnailLargeUrl))
             && string.IsNullOrEmpty(Part.ProcessCode) => "AWAITING PROCESS",
        _ when !string.IsNullOrEmpty(Part.ViewerUrl) || !string.IsNullOrEmpty(Part.ThumbnailLargeUrl) => "READY",
        _ => "PENDING"
    };

    private string GetUploadedLabel()
    {
        if (Part.QueuedUpload) return "Queued...";
        if (Part.Uploading) return "Uploading…";
        if (Part.AwaitingPreview) return "Processing…";
        if (Part.UploadedAt.HasValue)
            return $"Uploaded {FormatRelative(Part.UploadedAt.Value)}";
        return "Uploaded";
    }

    private static string FormatRelative(DateTimeOffset t)
    {
        var elapsed = DateTimeOffset.UtcNow - t;
        if (elapsed.TotalSeconds < 60) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} min ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours} hr ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private string GetFormatLabel()
    {
        var ext = System.IO.Path.GetExtension(Part.Name).ToLowerInvariant();
        return ext switch
        {
            ".step" or ".stp" => "STEP AP214",
            ".iges" or ".igs" => "IGES",
            ".stl"            => "STL",
            ".3mf"            => "3MF",
            ".glb"            => "GLB",
            ".obj"            => "OBJ",
            _                 => ext.TrimStart('.').ToUpperInvariant(),
        };
    }

    private long GetFileSize() => Part.FileSizeBytes ?? 0;

    private static string FormatFileSize(long bytes) => bytes switch
    {
        >= 1048576 => $"{bytes / 1048576.0:F1} MB",
        >= 1024    => $"{bytes / 1024} KB",
        > 0        => $"{bytes} B",
        _          => string.Empty,
    };

    private readonly Dictionary<string, string> _resolvedUrls = [];
    private Guid _lastPartId;
    private string? _lastProcessCode;
    private List<DfmIssue> _dfmIssues = [];
    private bool _viewerLoadFailed;
    private bool _downloading;

    private async Task DownloadOriginalAsync()
    {
        if (string.IsNullOrEmpty(Part.StoragePath)) return;
        _downloading = true;
        try
        {
            var response = await Http.GetAsync($"api/v1/uploads/preview-url?storagePath={Uri.EscapeDataString(Part.StoragePath)}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (result.TryGetProperty("url", out var urlProp))
                {
                    var url = urlProp.GetString();
                    if (url != null) await JS.InvokeVoidAsync("window.open", url, "_blank");
                }
            }
        }
        catch
        {
            // Silent — the button is already disabled
        }
        finally
        {
            _downloading = false;
        }
    }
    private string? _viewerErrorMessage;
    private CancellationTokenSource? _dfmTimeoutCts;
    private const int DfmTimeoutSeconds = 600;
    private ModelViewer? _modelViewer;
    private DfmOverlayPanel? _dfmPanel;
    private bool _multiBodyInitialized;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var partChanged = Part.FileId != _lastPartId;
        var processChanged = Part.ProcessCode != _lastProcessCode;
        var prevPartId = _lastPartId;
        _lastPartId = Part.FileId;
        _lastProcessCode = Part.ProcessCode;

        if (partChanged || processChanged)
        {
            _dfmPanel?.ResetOverlays();
            if (_modelViewer != null)
                await _modelViewer.ClearDfmOverlaysAsync(prevPartId.ToString());
            if (partChanged)
            {
                _viewerLoadFailed = false;
                _viewerErrorMessage = null;
            }
        }

        _dfmIssues = BuildDfmIssues();
        if (!string.IsNullOrEmpty(Part.ViewerUrl))
        {
            _viewerLoadFailed = false;
            _viewerErrorMessage = null;

            // Initialize multi-body viewer when bodies are available
            if (Part.BodyCount > 1 && Part.Bodies.Count > 0 && !_multiBodyInitialized)
            {
                _ = InitializeMultiBodyViewerAsync();
            }
        }

        // DFM watchdog: arm as soon as upload completes (StoragePath assigned), not only when
        // the GLB viewer loads. This ensures the spinner cannot hang indefinitely even when
        // Phase 1 tessellation is slow and GlbReady never arrives within the backend budget.
        // Timer budget matches backend Phase 1 (300 s) + Phase 2 DFM (300 s) = 600 s.
        var uploadCompleted = !Part.Uploading && !string.IsNullOrEmpty(Part.StoragePath);
        var dfmPending = Part.DfmReport == null && !Part.DfmAcknowledged && !Part.DfmAnalysisTimedOut;

        if (uploadCompleted && dfmPending && _dfmTimeoutCts == null)
        {
            _dfmTimeoutCts = new CancellationTokenSource();
            var token = _dfmTimeoutCts.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(DfmTimeoutSeconds), token);
                    if (!token.IsCancellationRequested && Part.DfmReport == null)
                    {
                        Part.DfmAnalysisTimedOut = true;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { }
            }, token);
        }
        else if (!uploadCompleted || !dfmPending)
        {
            // Cancel any pending watchdog — report arrived, failure event received, or part changed
            _dfmTimeoutCts?.Cancel();
            _dfmTimeoutCts?.Dispose();
            _dfmTimeoutCts = null;
        }

        await base.OnParametersSetAsync();
    }

    private async Task CloseViewer()
    {
        Part.ViewerUrl = null;
        Part.GlbSignedUrl = null;
        await OnPartChanged.InvokeAsync(Part);
    }

    private async Task OnImageErrorAsync(string? currentSrc, Action<string?> setUrl, bool isLargeThumbnail = false)
    {
        if (string.IsNullOrEmpty(currentSrc))
            return;

        if (_resolvedUrls.TryGetValue(currentSrc, out var cached))
        {
            setUrl(cached);
            await OnPartChanged.InvokeAsync(Part);
            return;
        }

        try
        {
            var resp = await Http.GetAsync($"api/v1/uploads/preview-url?storagePath={Uri.EscapeDataString(currentSrc)}");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<JsonDocument>();
                var resolved = json?.RootElement.GetProperty("url").GetString();
                if (!string.IsNullOrEmpty(resolved))
                {
                    _resolvedUrls[currentSrc] = resolved;
                    setUrl(resolved);
                    await OnPartChanged.InvokeAsync(Part);
                }
            }
        }
        catch
        {
            // Silently ignore — thumbnail URL refresh is best-effort
        }
    }

    private void NotifyChanged(Action<PartViewModel> mutate)
    {
        mutate(Part);
        OnPartChanged.InvokeAsync(Part);
    }

    private Task HandleDfmAcknowledged()
    {
        NotifyChanged(p => p.DfmAcknowledged = true);
        return Task.CompletedTask;
    }

    private bool ShouldShowAllClearOverlay() =>
        _dfmIssues.Count == 0
        && Part.DfmReport != null
        && !Part.DfmAcknowledged
        && !Part.DfmAllClearNotified
        && !string.IsNullOrEmpty(Part.ProcessCode);

    private Task HandleAllClearDismissed()
    {
        Part.DfmAllClearNotified = true;
        return Task.CompletedTask;
    }

    private ModelViewer.TurningAxisViewModel? BuildTurningAxis()
    {
        if (!IsCncTurningProcess(Part.ProcessCode))
            return null;

        if (Part.CncDfmReport is CncDfmReportPayload cnc)
        {
            if (IsNotTurnableReport(cnc))
                return null;

            if (cnc.AxisVector.Count >= 3
                && !string.IsNullOrWhiteSpace(cnc.PrimaryAxis))
            {
                return new ModelViewer.TurningAxisViewModel(cnc.PrimaryAxis, cnc.AxisVector.Take(3).ToArray());
            }
        }

        if (Part.DfmReport is DfmReport dto
            && string.Equals(dto.ReportType, "CNC_TURN", StringComparison.OrdinalIgnoreCase)
            && !IsNotTurnableReport(dto)
            && dto.AxisVector.Count >= 3
            && !string.IsNullOrWhiteSpace(dto.PrimaryAxis))
        {
            return new ModelViewer.TurningAxisViewModel(dto.PrimaryAxis, dto.AxisVector.Take(3).ToArray());
        }

        if (Part.CncDfmReport is DfmReport cachedDto
            && !IsNotTurnableReport(cachedDto)
            && cachedDto.AxisVector.Count >= 3
            && !string.IsNullOrWhiteSpace(cachedDto.PrimaryAxis))
        {
            return new ModelViewer.TurningAxisViewModel(cachedDto.PrimaryAxis, cachedDto.AxisVector.Take(3).ToArray());
        }

        return BuildProvisionalTurningAxis();
    }

    private static bool IsCncTurningProcess(string? processCode) =>
        string.Equals(processCode, "CNC_TURN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(processCode, "CNC_TURNING", StringComparison.OrdinalIgnoreCase);

    private ModelViewer.TurningAxisViewModel? BuildProvisionalTurningAxis()
    {
        return new ModelViewer.TurningAxisViewModel("AUTO", [0.0, 0.0, 0.0]);
    }

    private static bool IsNotTurnableReport(CncDfmReportPayload report) =>
        !report.IsTurnable && HasNotTurnableIssue(report.Issues);

    private static bool IsNotTurnableReport(DfmReport report) =>
        report.IsTurnable == false || HasNotTurnableIssue(report.Issues);

    private static bool HasNotTurnableIssue(IEnumerable<CncDfmReportPayloadIssuesItem> issues) =>
        issues.Any(issue => IsNotTurnableIssue(issue.Category, issue.Title));

    private static bool HasNotTurnableIssue(IEnumerable<Maliev.Intranet.Shared.Dtos.DfmIssue> issues) =>
        issues.Any(issue => IsNotTurnableIssue(issue.Category, issue.Title));

    private static bool IsNotTurnableIssue(string? category, string? title) =>
        string.Equals(category, "not_turnable", StringComparison.OrdinalIgnoreCase)
        || (!string.IsNullOrWhiteSpace(title)
            && title.Contains("Not Suitable for Turning", StringComparison.OrdinalIgnoreCase));

    private async Task HandleViewerLoadFailed(string errorMessage)
    {
        _viewerLoadFailed = true;
        _viewerErrorMessage = errorMessage;

        // BabylonJS internal errors (TypeError, WebGL issues) are NOT retryable -
        // retrying just creates an infinite flash loop. Only retry for recoverable errors.
        var isRetryable = errorMessage != null &&
            !errorMessage.Contains("TypeError") &&
            !errorMessage.Contains("backbuffer") &&
            !errorMessage.Contains("WebGL");

        if (isRetryable)
        {
            var storagePath = Part.GlbStoragePath ?? Part.StoragePath;
            if (!string.IsNullOrEmpty(storagePath) && OnRequestFreshViewerUrl.HasDelegate)
            {
                await OnRequestFreshViewerUrl.InvokeAsync(storagePath);
                _viewerLoadFailed = false;
                _viewerErrorMessage = null;
            }
        }
        else
        {
            Snackbar.Add($"3D preview unavailable: {errorMessage}", Severity.Warning);
        }

        await InvokeAsync(StateHasChanged);
    }

    private List<DfmIssue> BuildDfmIssues()
    {
        // Without a selected manufacturing process, show only general mesh quality issues.
        // Process-specific checks (thin wall, overhang, sharp corners, etc.) are meaningless
        // and misleading until the user picks a process.
        if (string.IsNullOrEmpty(Part.ProcessCode))
            return BuildGeneralMeshIssues();

        var raw = GetDfmIssueDetailSummary(Part.DfmReport);
        var processCode = Part.ProcessCode.ToUpperInvariant();
        // "CNC" is the legacy alias for "CNC_MILL" — overlay GLBs are keyed under CNC_MILL.
        var overlayProcessCode = processCode == "CNC" ? "CNC_MILL" : processCode;
        var issues = raw.Select(t =>
        {
            var overlayKey = t.Category != null ? $"{overlayProcessCode}__{t.Category}" : null;
            var overlayUrl = overlayKey != null ? Part.OverlayUrls?.GetValueOrDefault(overlayKey) : null;
            return new DfmIssue(
                Icon: t.Icon,
                Title: t.Text,
                Description: t.Description,
                Severity: DfmIssueSeverity.Warning,
                Category: t.Category,
                OverlayKey: overlayKey,
                OverlayUrl: overlayUrl);
        }).ToList();
        // Always append general mesh issues (non-manifold, multi-body) regardless of process.
        issues.AddRange(BuildGeneralMeshIssues());
        return issues;
    }

    /// <summary>
    /// Returns mesh-quality issues that are process-agnostic.
    /// Shown when no manufacturing process is selected yet.
    /// </summary>
    private List<DfmIssue> BuildGeneralMeshIssues()
    {
        var issues = new List<DfmIssue>();

        if (Part.IsManifold == false)
        {
            var nmDesc = Part.NonManifoldReason is { Length: > 0 } reason
                ? $"Mesh geometry issue: {reason}."
                  + (Part.NonManifoldFaceCount is { } fc ? $" Approximately {fc} affected face(s)." : string.Empty)
                  + " This may cause problems during manufacturing."
                : "The mesh has holes or overlapping geometry. This may cause issues during manufacturing regardless of process.";
            issues.Add(new DfmIssue(
                Icon: Icons.Material.Filled.WarningAmber,
                Title: "Non-manifold mesh",
                Description: nmDesc,
                Severity: DfmIssueSeverity.Warning));
        }

        if (Part.BodyCount > 1)
        {
            var overlayKey = "GENERAL__multi_body";
            var resolvedOverlayUrl = Part.OverlayUrls?.GetValueOrDefault(overlayKey);
            issues.Add(new DfmIssue(
                Icon: Icons.Material.Filled.CallSplit,
                Title: $"Multiple bodies detected ({Part.BodyCount})",
                Description: $"This file contains {Part.BodyCount} separate bodies. Each body is shown in a different colour. Please upload one part per file.",
                Severity: DfmIssueSeverity.Warning,
                Category: "multi_body",
                OverlayKey: overlayKey,
                OverlayUrl: resolvedOverlayUrl));
        }

        return issues;
    }

    private async Task HandleToggleOverlay(DfmIssue issue)
    {
        if (_modelViewer == null || issue.OverlayKey == null || issue.OverlayUrl == null) return;
        // _dfmPanel tracks active state; just check if the key is now active
        var isActive = _dfmPanel?._activeOverlays.Contains(issue.OverlayKey) ?? false;
        var fileId = Part.FileId.ToString();
        await _modelViewer.ToggleDfmOverlayAsync(fileId, issue.OverlayKey, issue.OverlayUrl, isActive);

        // Co-toggle the support-tower overlay whenever an overhang overlay is toggled.
        // Support key is the same key with "_support" appended to the "__overhang" suffix.
        if (issue.Category == "overhang" && issue.OverlayKey.EndsWith("__overhang"))
        {
            var supportKey = issue.OverlayKey + "_support";
            var supportUrl = Part.OverlayUrls?.GetValueOrDefault(supportKey);
            // For hide, pass empty URL — the JS only needs the key to set isVisible=false.
            // For show, we need the actual URL; skip if unavailable.
            if (!isActive)
                await _modelViewer.ToggleDfmOverlayAsync(fileId, supportKey, supportUrl ?? string.Empty, false);
            else if (supportUrl != null)
                await _modelViewer.ToggleDfmOverlayAsync(fileId, supportKey, supportUrl, true);
        }

        // Show/hide the grid floor when support-related overlays are toggled.
        if (issue.Category is "overhang" or "support_required")
        {
            if (isActive)
                await _modelViewer.ShowGridAsync();
            else
                await _modelViewer.HideGridAsync();
        }
    }

    /// <summary>
    /// Extracts a human-readable list of DFM issue details from a DFM report payload.
    /// </summary>
    private static List<(string Icon, string Text, string Description, string? Category)> GetDfmIssueDetailSummary(object? dfmReport)
    {
        var issues = new List<(string Icon, string Text, string Description, string? Category)>();
        if (dfmReport == null) return issues;

        switch (dfmReport)
        {
            case FdmDfmReportPayload fdm:
                if (fdm.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{fdm.ThinWallCount} thin wall region(s)", "Wall thickness below minimum recommended for FDM printing", "thin_wall"));
                if (fdm.OverhangFaceCount > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{fdm.OverhangFaceCount} overhang region(s)", "Overhang regions exceeding the angle limit — support structures likely required", "overhang"));
                else if (fdm.SupportRequired)
                    issues.Add((Icons.Material.Filled.AddHome, "Support structures required", "This model requires support structures for printing", "support_required"));
                if (fdm.SmallDetailCount > 0)
                    issues.Add((Icons.Material.Filled.ZoomOutMap, $"{fdm.SmallDetailCount} small detail(s) may be lost", "Some fine details may not reproduce accurately", "small_feature"));
                break;

            case SlaDfmReportPayload sla:
                if (sla.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{sla.ThinWallCount} thin wall region(s)", "Wall thickness may cause resin drainage or print failure", "thin_wall"));
                if (sla.ResinTrappingRisk)
                    issues.Add((Icons.Material.Filled.Water, "Resin trapping risk", "Enclosed cavities may trap resin during printing", "escape_hole"));
                if (sla.SuctionRisk)
                    issues.Add((Icons.Material.Filled.Opacity, "Suction risk during peeling", "Large flat surfaces may cause suction during peeling", "overhang"));
                if (sla.HollowRegions.Count > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{sla.HollowRegions.Count} hollow region(s)", "Hollow regions may require additional drainage holes", null));
                break;

            case CncDfmReportPayload cnc:
                if (cnc.Issues.Count > 0)
                {
                    issues.AddRange(cnc.Issues.Select(issue =>
                    {
                        var (icon, category) = GetCncIssuePresentation(issue.Category);
                        return (icon, issue.Title, issue.Description, category);
                    }));
                }
                else
                {
                    if (cnc.SharpCornerCount > 0)
                        issues.Add((Icons.Material.Filled.BugReport, $"{cnc.SharpCornerCount} sharp corner(s)", "Sharp inside corners cannot be cut precisely with standard end mills", "internal_radius"));
                    if (cnc.HasUndercuts)
                        issues.Add((Icons.Material.Filled.ContentCut, "Undercut features detected", "Undercut features require special machining strategies or EDM", "undercut"));
                    if (cnc.HasDrillHoles && cnc.DrillHoleCount > 0)
                        issues.Add((Icons.Material.Filled.Handyman, $"{cnc.DrillHoleCount} drill hole(s)", $"This model has {cnc.DrillHoleCount} drill hole(s) to machine", null));
                    if (cnc.RequiresEdm)
                        issues.Add((Icons.Material.Filled.Build, "EDM required for complex features", "Complex internal geometry requires EDM (Electrical Discharge Machining)", null));
                    if (cnc.RequiresGrinding)
                        issues.Add((Icons.Material.Filled.RotateRight, "Grinding required for flat surfaces", "Flat surfaces require grinding for tight tolerance", null));
                }
                break;

            // Fallback for DfmReport DTO (from HTTP on-demand analysis path).
            // Maps raw issue categories to the same icon/text/category tuples as the typed payloads above.
            case DfmReport dto:
                foreach (var issue in dto.Issues)
                {
                    var (icon, text, desc, cat) = issue.Category switch
                    {
                        "thin_wall"        => (Icons.Material.Filled.Rectangle,     issue.Title, issue.Description, "thin_wall"),
                        "overhang"         => (Icons.Material.Filled.Layers,        issue.Title, issue.Description, "overhang"),
                        "small_feature"    => (Icons.Material.Filled.ZoomOutMap,    issue.Title, issue.Description, "small_feature"),
                        "hole"             => (Icons.Material.Filled.RadioButtonUnchecked, issue.Title, issue.Description, "hole"),
                        "internal_radius"  => (Icons.Material.Filled.BugReport,     issue.Title, issue.Description, "internal_radius"),
                        "undercut"         => (Icons.Material.Filled.ContentCut,    issue.Title, issue.Description, "undercut"),
                        "escape_hole"      => (Icons.Material.Filled.Water,         issue.Title, issue.Description, "escape_hole"),
                        "connecting_clearance" => (Icons.Material.Filled.Compress, issue.Title, issue.Description, "connecting_clearance"),
                        "drill_hole"       => (Icons.Material.Filled.Handyman,      issue.Title, issue.Description, null),
                        _                  => (Icons.Material.Filled.Warning,       issue.Title, issue.Description, issue.Category.Length > 0 ? issue.Category : null),
                    };
                    issues.Add((icon, text, desc, cat));
                }
                break;
        }

        return issues;
    }

    private static (string Icon, string? Category) GetCncIssuePresentation(string category) => category switch
    {
        "internal_radius" => (Icons.Material.Filled.BugReport, "internal_radius"),
        "sharp_corner"   => (Icons.Material.Filled.BugReport, "internal_radius"),
        "undercut"       => (Icons.Material.Filled.ContentCut, "undercut"),
        "hole"           => (Icons.Material.Filled.RadioButtonUnchecked, "drill_hole"),
        "drill_hole"     => (Icons.Material.Filled.Handyman, "drill_hole"),
        "edm"            => (Icons.Material.Filled.Build, "edm"),
        "grinding"       => (Icons.Material.Filled.RotateRight, "grinding"),
        "not_turnable"   => (Icons.Material.Filled.SyncProblem, "not_turnable"),
        "ld_ratio"       => (Icons.Material.Filled.Straighten, "ld_ratio"),
        "groove"         => (Icons.Material.Filled.LinearScale, "groove"),
        _                 => (Icons.Material.Filled.Warning, category.Length > 0 ? category : null),
    };

    /// <summary>
    /// Initializes multi-body viewer functionality when bodies are available.
    /// </summary>
    private static readonly string[] BodyPalette =
    [
        "#597fbb",
        "#bf5959",
        "#59bf59",
        "#bfbf59",
        "#bf59bf",
        "#5959bf",
        "#99734d",
        "#737380",
        "#bf8c4d",
        "#bf598c",
        "#59bfbf",
        "#8cbf59",
    ];

    private PartViewModel.BodyInfo? SelectedBody =>
        Part.SelectedBodyIndex is int bodyIndex
            ? Part.Bodies.FirstOrDefault(body => body.Index == bodyIndex)
            : null;

    private string BodySelectorLabel => SelectedBody?.Name ?? $"{Part.BodyCount} bodies";

    private string BodySelectorMeta =>
        SelectedBody is { VolumeCm3: double volume }
            ? FormatBodyVolume(volume)
            : "All bodies";

    private static string FormatBodyVolume(double? volumeCm3) =>
        volumeCm3.HasValue ? $"{volumeCm3.Value:F2} cm³" : "Volume pending";

    private static string GetBodySwatchStyle(PartViewModel.BodyInfo body)
    {
        var color = body.ColorHex;
        if (string.IsNullOrWhiteSpace(color))
        {
            color = BodyPalette[Math.Abs(body.Index) % BodyPalette.Length];
        }

        return $"background-color: {color};";
    }

    private async Task InitializeMultiBodyViewerAsync()
    {
        if (_modelViewer == null || Part.Bodies.Count == 0)
            return;

        try
        {
            // Convert bodies to the format expected by ModelViewer
            var bodyViewModels = Part.Bodies.Select(b =>
                new ModelViewer.BodyViewModel(b.Index, b.Name, b.VolumeCm3, b.ColorHex)).ToList();

            // Assign colors to all bodies
            await _modelViewer.SetBodiesAsync(bodyViewModels);

            // Enable click-to-select functionality
            await _modelViewer.EnableBodyPickingAsync();

            _multiBodyInitialized = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initialize multi-body viewer: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Handles body selection from the body list panel.
    /// </summary>
    private async Task SelectBodyAsync(int bodyIndex)
    {
        // Update selected state in the view model
        Part.SelectedBodyIndex = Part.SelectedBodyIndex == bodyIndex ? null : bodyIndex;

        // Update the viewer to highlight the selected body
        if (_modelViewer != null)
        {
            await _modelViewer.SelectBodyAsync(Part.SelectedBodyIndex);
        }

        // Notify parent of part state change
        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Clears body selection and returns the viewer to the full assembly.
    /// </summary>
    private async Task ClearBodySelectionAsync()
    {
        if (Part.SelectedBodyIndex is null)
            return;

        Part.SelectedBodyIndex = null;

        if (_modelViewer != null)
        {
            await _modelViewer.SelectBodyAsync(null);
        }

        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles body picking callback from the 3D viewer.
    /// Called by ModelViewer when user clicks on a body in the 3D scene.
    /// </summary>
    private async Task HandleBodyPickedAsync(int? bodyIndex)
    {
        Part.SelectedBodyIndex = bodyIndex;

        // Notify parent of part state change
        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    private static string GetProcessName(string? code) => code?.ToUpperInvariant() switch
    {
        "FDM" or "FFF"                     => "FDM",
        "3D_PRINTING"                      => "3D Print",
        "SLA" or "SLA_DLP"                 => "SLA",
        "DLP"                              => "DLP",
        "SLS" or "SLS_PA"                  => "SLS",
        "CNC" or "CNC_MILL"               => "CNC Milling",
        "CNC_TURN"                         => "CNC Turning",
        "SHEET_METAL" or "SHEET-METAL"     => "Sheet Metal",
        "INJECTION_MOLDING"                => "Injection Molding",
        "CASTING" or "DIE_CASTING"         => "Die Casting",
        _                                  => code?.ToUpperInvariant() ?? "—",
    };
}
