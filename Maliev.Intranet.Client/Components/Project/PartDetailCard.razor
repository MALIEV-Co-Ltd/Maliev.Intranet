    private ModelViewer.TurningAxisViewModel? BuildTurningAxis()
    {
        if (!IsCncTurningProcess(Part.ProcessCode))
            return null;

        if (Part.CncDfmReport is CncDfmReportPayload cnc)
        {
            if (IsNotTurnableReport(cnc))
                return null;

            if (cnc.AxisVector.Count >= 3
                && cnc.AxisPoint.Count >= 3
                && !string.IsNullOrWhiteSpace(cnc.PrimaryAxis))
            {
                return new ModelViewer.TurningAxisViewModel(cnc.PrimaryAxis, cnc.AxisVector.Take(3).ToArray(), cnc.AxisPoint.Take(3).ToArray());
            }
        }

        if (Part.DfmReport is DfmReport dto
            && string.Equals(dto.ReportType, "CNC_TURN", StringComparison.OrdinalIgnoreCase)
            && !IsNotTurnableReport(dto)
            && dto.AxisVector.Count >= 3
            && dto.AxisPoint.Count >= 3
            && !string.IsNullOrWhiteSpace(dto.PrimaryAxis))
        {
            return new ModelViewer.TurningAxisViewModel(dto.PrimaryAxis, dto.AxisVector.Take(3).ToArray(), dto.AxisPoint.Take(3).ToArray());
        }

        if (Part.CncDfmReport is DfmReport cachedDto
            && !IsNotTurnableReport(cachedDto)
            && cachedDto.AxisVector.Count >= 3
            && cachedDto.AxisPoint.Count >= 3
            && !string.IsNullOrWhiteSpace(cachedDto.PrimaryAxis))
        {
            return new ModelViewer.TurningAxisViewModel(cachedDto.PrimaryAxis, cachedDto.AxisVector.Take(3).ToArray(), cachedDto.AxisPoint.Take(3).ToArray());
        }

        if (Part.DfmReport is DfmReport report && IsNotTurnableReport(report))
            return null;

        // Local-first DFM reports carry no axis data — send an "auto" request so
        // the viewer derives the turning axis from the model bounds and ring fit.
        // Restores the axis-of-turning marker lost in the local-DFM migration.
        return new ModelViewer.TurningAxisViewModel("auto", [0d, 0d, 0d], [0d, 0d, 0d]);
    }

    private string ResolveViewerFileExtension()
    {
        var ext = !string.IsNullOrWhiteSpace(Part.ViewerFileExtension)
            ? Part.ViewerFileExtension.Trim()
            : System.IO.Path.GetExtension(Part.ViewerStoragePath ?? Part.GlbStoragePath ?? Part.StoragePath);

        if (string.IsNullOrWhiteSpace(ext))
            return ".glb";

        return ext.StartsWith('.') ? ext.ToLowerInvariant() : "." + ext.ToLowerInvariant();
    }

    private static bool IsCncTurningProcess(string? processCode) =>
        string.Equals(processCode, "CNC_TURN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(processCode, "CNC_TURNING", StringComparison.OrdinalIgnoreCase);

    private static bool IsNotTurnableReport(CncDfmReportPayload report) =>
        !report.IsTurnable && HasNotTurnableIssue(report.Issues);

    private static bool IsNotTurnableReport(DfmReport report) =>
        report.IsTurnable == false || HasNotTurnableIssue(report.Issues);

    private static bool HasNotTurnableIssue(IEnumerable<CncDfmReportPayloadIssuesItem> issues) =>
        issues.Any(issue => IsNotTurnableIssue(issue.Category, issue.Title));

    private static bool HasNotTurnableIssue(IEnumerable<Maliev.Intranet.Shared.Dtos.DfmIssue> issues) =>
        issues.Any(issue => IsNotTurnableIssue(issue.Category, issue.Title));

    private static bool IsNotTurnableIssue(string? category, string? title) =>
        string.Equals(category, "not_turnable", StringComparison.OrdinalIgnoreCase)
        || (!string.IsNullOrWhiteSpace(title)
            && title.Contains("Not Suitable for Turning", StringComparison.OrdinalIgnoreCase));

    private async Task HandleViewerLoadFailed(string errorMessage)
    {
        _viewerLoadFailed = true;
        _viewerErrorMessage = errorMessage;

        // BabylonJS internal errors (TypeError, WebGL issues) are NOT retryable -
        // retrying just creates an infinite flash loop. Only retry for recoverable errors.
        var isRetryable = errorMessage != null &&
            !errorMessage.Contains("TypeError") &&
            !errorMessage.Contains("backbuffer") &&
            !errorMessage.Contains("WebGL");

        if (isRetryable)
        {
            var storagePath = Part.StoragePath ?? Part.GlbStoragePath;
            if (!string.IsNullOrEmpty(storagePath) && OnRequestFreshViewerUrl.HasDelegate)
            {
                await OnRequestFreshViewerUrl.InvokeAsync(storagePath);
                _viewerLoadFailed = false;
                _viewerErrorMessage = null;
            }
        }
        else
        {
            Snackbar.Add($"3D preview unavailable: {errorMessage}", Severity.Warning);
        }

        await InvokeAsync(StateHasChanged);
    }

    private List<DfmIssue> BuildDfmIssues()
    {
        // Without a selected manufacturing process, show only general mesh quality issues.
        // Process-specific checks (thin wall, overhang, sharp corners, etc.) are meaningless
        // and misleading until the user picks a process.
        if (string.IsNullOrEmpty(Part.ProcessCode))
            return BuildGeneralMeshIssues();

        var raw = GetDfmIssueDetailSummary(Part.DfmReport);
        var processCode = Part.ProcessCode.ToUpperInvariant();
        // "CNC" is the legacy alias for "CNC_MILL" — overlay GLBs are keyed under CNC_MILL.
        var overlayProcessCode = processCode == "CNC" ? "CNC_MILL" : processCode;

        // Extract source information from the DFM report if available
        var reportIssues = GetDfmReportIssues(Part.DfmReport);
        var sourceByCategory = reportIssues
            .GroupBy(i => i.Category ?? string.Empty)
            .ToDictionary(g => g.Key, g => g.First().Source ?? "server", StringComparer.OrdinalIgnoreCase);

        // Browser-local DFM issues carry triangle face indices; the viewer rebuilds the
        // overlay mesh locally from them when no server overlay GLB exists.
        var localFaceIndicesByCategory = reportIssues
            .Where(i => string.Equals(i.Source, "local", StringComparison.OrdinalIgnoreCase)
                && i.FaceIndices is { Count: > 0 })
            .GroupBy(i => i.Category ?? string.Empty)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<int>)g.SelectMany(i => i.FaceIndices).Distinct().ToList(),
                StringComparer.OrdinalIgnoreCase);

        var issues = raw.Select(t =>
        {
            var overlayKey = t.Category != null ? $"{overlayProcessCode}__{t.Category}" : null;
            var overlayUrl = overlayKey != null ? Part.OverlayUrls?.GetValueOrDefault(overlayKey) : null;
            var source = !string.IsNullOrWhiteSpace(t.Category) && sourceByCategory.TryGetValue(t.Category, out var src)
                ? src
                : "server";
            var faceIndices = overlayUrl == null
                && t.Category != null
                && localFaceIndicesByCategory.TryGetValue(t.Category, out var localFaces)
                ? localFaces
                : null;
            return new DfmIssue(
                Icon: t.Icon,
                Title: t.Text,
                Description: t.Description,
                Severity: DfmIssueSeverity.Warning,
                Category: t.Category,
                OverlayKey: overlayKey,
                OverlayUrl: overlayUrl,
                Source: source,
                FaceIndices: faceIndices);
        }).ToList();

        // Append general mesh issues (multi-body always; non-manifold only when not already
        // covered by a mesh_integrity issue from the DFM report — local analysis takes priority).
        var hasLocalMeshIntegrity = issues.Any(i => string.Equals(i.Category, "mesh_integrity", StringComparison.OrdinalIgnoreCase));
        issues.AddRange(BuildGeneralMeshIssues("server", skipNonManifold: hasLocalMeshIntegrity));
        return issues;
    }

    private static List<Maliev.Intranet.Shared.Dtos.DfmIssue> GetDfmReportIssues(object? dfmReport)
    {
        return dfmReport switch
        {
            FdmDfmReportPayload fdm => [],
            SlaDfmReportPayload sla => [],
            CncDfmReportPayload cnc => (cnc.Issues ?? []).Select(i => new Maliev.Intranet.Shared.Dtos.DfmIssue
            {
                Category = i.Category,
                Severity = i.Severity,
                Title = i.Title,
                Description = i.Description,
                Value = i.Value,
                Threshold = i.Threshold,
                Source = "server"
            }).ToList(),
            Maliev.Intranet.Shared.Dtos.DfmReport dto => dto.Issues ?? [],
            _ => []
        };
    }

    /// <summary>
    /// Returns mesh-quality issues that are process-agnostic.
    /// Shown when no manufacturing process is selected yet.
    /// </summary>
    private List<DfmIssue> BuildGeneralMeshIssues(string source = "server", bool skipNonManifold = false)
    {
        var issues = new List<DfmIssue>();

        if (!skipNonManifold && Part.IsManifold == false)
        {
            var nmDesc = Part.NonManifoldReason is { Length: > 0 } reason
                ? $"{reason} This may cause problems during manufacturing."
                : "The mesh has holes or overlapping geometry. This may cause issues during manufacturing regardless of process.";
            issues.Add(new DfmIssue(
                Icon: Icons.Material.Filled.WarningAmber,
                Title: "Non-manifold mesh",
                Description: nmDesc,
                Severity: DfmIssueSeverity.Warning,
                Source: source));
        }

        if (Part.BodyCount > 1)
        {
            var overlayKey = "GENERAL__multi_body";
            var resolvedOverlayUrl = Part.OverlayUrls?.GetValueOrDefault(overlayKey);
            issues.Add(new DfmIssue(
                Icon: Icons.Material.Filled.CallSplit,
                Title: $"Multiple bodies detected ({Part.BodyCount})",
                Description: $"This file contains {Part.BodyCount} separate bodies. Each body is shown in a different colour. Please upload one part per file.",
                Severity: DfmIssueSeverity.Warning,
                Category: "multi_body",
                OverlayKey: overlayKey,
                OverlayUrl: resolvedOverlayUrl,
                Source: source));
        }

        return issues;
    }

    private async Task HandleToggleOverlay(DfmIssue issue)
    {
        if (_modelViewer == null || issue.OverlayKey == null) return;
        var hasLocalFaces = issue.FaceIndices is { Count: > 0 };
        if (issue.OverlayUrl == null && !hasLocalFaces) return;
        // _dfmPanel tracks active state; just check if the key is now active
        var isActive = _dfmPanel?._activeOverlays.Contains(issue.OverlayKey) ?? false;
        var fileId = Part.FileId.ToString();
        if (issue.OverlayUrl != null)
            await _modelViewer.ToggleDfmOverlayAsync(fileId, issue.OverlayKey, issue.OverlayUrl, isActive);
        else
            await _modelViewer.ToggleLocalDfmOverlayAsync(fileId, issue.OverlayKey, issue.FaceIndices!, isActive);

        // Co-toggle the support-tower overlay whenever an overhang overlay is toggled.
        // Support key is the same key with "_support" appended to the "__overhang" suffix.
        if (issue.Category == "overhang" && issue.OverlayKey.EndsWith("__overhang"))
        {
            var supportKey = issue.OverlayKey + "_support";
            var supportUrl = Part.OverlayUrls?.GetValueOrDefault(supportKey);
            // For hide, pass empty URL — the JS only needs the key to set isVisible=false.
            // For show, we need the actual URL; skip if unavailable.
            if (!isActive)
                await _modelViewer.ToggleDfmOverlayAsync(fileId, supportKey, supportUrl ?? string.Empty, false);
            else if (supportUrl != null)
                await _modelViewer.ToggleDfmOverlayAsync(fileId, supportKey, supportUrl, true);
        }

        // Show/hide the grid floor when support-related overlays are toggled.
        if (issue.Category is "overhang" or "support_required")
        {
            await _modelViewer.SetTemporaryGridVisibilityAsync(
                GetDfmGridOwnerKey(fileId, issue),
                isActive);
        }
    }

    private static string GetDfmGridOwnerKey(string fileId, DfmIssue issue)
    {
        var overlayKey = string.IsNullOrWhiteSpace(issue.OverlayKey)
            ? issue.Category ?? "overlay"
            : issue.OverlayKey;

        return $"dfm:{fileId}:{overlayKey}";
    }

    /// <summary>
    /// Extracts a human-readable list of DFM issue details from a DFM report payload.
    /// </summary>
    private static List<(string Icon, string Text, string Description, string? Category)> GetDfmIssueDetailSummary(object? dfmReport)
    {
        var issues = new List<(string Icon, string Text, string Description, string? Category)>();
        if (dfmReport == null) return issues;

        switch (dfmReport)
        {
            case FdmDfmReportPayload fdm:
                if (fdm.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{fdm.ThinWallCount} thin wall region(s)", "Wall thickness below minimum recommended for FDM printing", "thin_wall"));
                if (fdm.OverhangFaceCount > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{fdm.OverhangFaceCount} overhang region(s)", "Overhang regions exceeding the angle limit — support structures likely required", "overhang"));
                else if (fdm.SupportRequired)
                    issues.Add((Icons.Material.Filled.AddHome, "Support structures required", "This model requires support structures for printing", "support_required"));
                if (fdm.SmallDetailCount > 0)
                    issues.Add((Icons.Material.Filled.ZoomOutMap, $"{fdm.SmallDetailCount} small detail(s) may be lost", "Some fine details may not reproduce accurately", "small_feature"));
                break;

            case SlaDfmReportPayload sla:
                if (sla.ThinWallCount > 0)
                    issues.Add((Icons.Material.Filled.Rectangle, $"{sla.ThinWallCount} thin wall region(s)", "Wall thickness may cause resin drainage or print failure", "thin_wall"));
                if (sla.ResinTrappingRisk)
                    issues.Add((Icons.Material.Filled.Water, "Resin trapping risk", "Enclosed cavities may trap resin during printing", "escape_hole"));
                if (sla.SuctionRisk)
                    issues.Add((Icons.Material.Filled.Opacity, "Suction risk during peeling", "Large flat surfaces may cause suction during peeling", "overhang"));
                if (sla.HollowRegions.Count > 0)
                    issues.Add((Icons.Material.Filled.Layers, $"{sla.HollowRegions.Count} hollow region(s)", "Hollow regions may require additional drainage holes", null));
                break;

            case CncDfmReportPayload cnc:
                if (cnc.Issues.Count > 0)
                {
                    issues.AddRange(cnc.Issues.Select(issue =>
                    {
                        var (icon, category) = GetCncIssuePresentation(issue.Category);
                        return (icon, issue.Title, issue.Description, category);
                    }));
                }
                else
                {
                    if (cnc.SharpCornerCount > 0)
                        issues.Add((Icons.Material.Filled.BugReport, $"{cnc.SharpCornerCount} sharp corner(s)", "Sharp inside corners cannot be cut precisely with standard end mills", "internal_radius"));
                    if (cnc.HasUndercuts)
                        issues.Add((Icons.Material.Filled.ContentCut, "Undercut features detected", "Undercut features require special machining strategies or EDM", "undercut"));
                    if (cnc.HasDrillHoles && cnc.DrillHoleCount > 0)
                        issues.Add((Icons.Material.Filled.Handyman, $"{cnc.DrillHoleCount} drill hole(s)", $"This model has {cnc.DrillHoleCount} drill hole(s) to machine", null));
                    if (cnc.RequiresEdm)
                        issues.Add((Icons.Material.Filled.Build, "EDM required for complex features", "Complex internal geometry requires EDM (Electrical Discharge Machining)", null));
                    if (cnc.RequiresGrinding)
                        issues.Add((Icons.Material.Filled.RotateRight, "Grinding required for flat surfaces", "Flat surfaces require grinding for tight tolerance", null));
                }
                break;

            // Fallback for DfmReport DTO (from HTTP on-demand analysis path).
            // Maps raw issue categories to the same icon/text/category tuples as the typed payloads above.
            case DfmReport dto:
                foreach (var issue in dto.Issues)
                {
                    var (icon, text, desc, cat) = issue.Category switch
                    {
                        "thin_wall"        => (Icons.Material.Filled.Rectangle,     issue.Title, issue.Description, "thin_wall"),
                        "overhang"         => (Icons.Material.Filled.Layers,        issue.Title, issue.Description, "overhang"),
                        "small_feature"    => (Icons.Material.Filled.ZoomOutMap,    issue.Title, issue.Description, "small_feature"),
                        "hole"             => (Icons.Material.Filled.RadioButtonUnchecked, issue.Title, issue.Description, "hole"),
                        "internal_radius"  => (Icons.Material.Filled.BugReport,     issue.Title, issue.Description, "internal_radius"),
                        "undercut"         => (Icons.Material.Filled.ContentCut,    issue.Title, issue.Description, "undercut"),
                        "escape_hole"      => (Icons.Material.Filled.Water,         issue.Title, issue.Description, "escape_hole"),
                        "connecting_clearance" => (Icons.Material.Filled.Compress, issue.Title, issue.Description, "connecting_clearance"),
                        "drill_hole"       => (Icons.Material.Filled.Handyman,      issue.Title, issue.Description, null),
                        _                  => (Icons.Material.Filled.Warning,       issue.Title, issue.Description, issue.Category.Length > 0 ? issue.Category : null),
                    };
                    issues.Add((icon, text, desc, cat));
                }
                break;
        }

        return issues;
    }

    private static (string Icon, string? Category) GetCncIssuePresentation(string category) => category switch
    {
        "internal_radius" => (Icons.Material.Filled.BugReport, "internal_radius"),
        "sharp_corner"   => (Icons.Material.Filled.BugReport, "internal_radius"),
        "undercut"       => (Icons.Material.Filled.ContentCut, "undercut"),
        "hole"           => (Icons.Material.Filled.RadioButtonUnchecked, "drill_hole"),
        "drill_hole"     => (Icons.Material.Filled.Handyman, "drill_hole"),
        "edm"            => (Icons.Material.Filled.Build, "edm"),
        "grinding"       => (Icons.Material.Filled.RotateRight, "grinding"),
        "not_turnable"   => (Icons.Material.Filled.SyncProblem, "not_turnable"),
        "ld_ratio"       => (Icons.Material.Filled.Straighten, "ld_ratio"),
        "groove"         => (Icons.Material.Filled.LinearScale, "groove"),
        _                 => (Icons.Material.Filled.Warning, category.Length > 0 ? category : null),
    };

    /// <summary>
    /// Initializes multi-body viewer functionality when bodies are available.
    /// </summary>
    private static readonly string[] BodyPalette =
    [
        "#597fbb",
        "#bf5959",
        "#59bf59",
        "#bfbf59",
        "#bf59bf",
        "#5959bf",
        "#99734d",
        "#737380",
        "#bf8c4d",
        "#bf598c",
        "#59bfbf",
        "#8cbf59",
    ];

    private PartViewModel.BodyInfo? SelectedBody =>
        Part.SelectedBodyIndex is int bodyIndex
            ? Part.Bodies.FirstOrDefault(body => body.Index == bodyIndex)
            : null;

    private string BodySelectorLabel => SelectedBody?.Name ?? $"{Part.BodyCount} bodies";

    private string BodySelectorMeta =>
        SelectedBody is { VolumeCm3: double volume }
            ? FormatBodyVolume(volume)
            : "All bodies";

    private static string FormatBodyVolume(double? volumeCm3) =>
        volumeCm3.HasValue ? $"{volumeCm3.Value:F2} cm³" : "Volume pending";

    private static string GetBodySwatchStyle(PartViewModel.BodyInfo body)
    {
        var color = body.ColorHex;
        if (string.IsNullOrWhiteSpace(color))
        {
            color = BodyPalette[Math.Abs(body.Index) % BodyPalette.Length];
        }

        return $"background-color: {color};";
    }

    private async Task InitializeMultiBodyViewerAsync()
    {
        if (_modelViewer == null || Part.Bodies.Count == 0)
            return;

        try
        {
            // Convert bodies to the format expected by ModelViewer
            var bodyViewModels = Part.Bodies.Select(b =>
                new ModelViewer.BodyViewModel(b.Index, b.Name, b.VolumeCm3, b.ColorHex)).ToList();

            // Assign colors to all bodies
            await _modelViewer.SetBodiesAsync(bodyViewModels);

            // Enable click-to-select functionality
            await _modelViewer.EnableBodyPickingAsync();

            _multiBodyInitialized = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to initialize multi-body viewer: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Handles body selection from the body list panel.
    /// </summary>
    private async Task SelectBodyAsync(int bodyIndex)
    {
        // Update selected state in the view model
        Part.SelectedBodyIndex = Part.SelectedBodyIndex == bodyIndex ? null : bodyIndex;

        // Update the viewer to highlight the selected body
        if (_modelViewer != null)
        {
            await _modelViewer.SelectBodyAsync(Part.SelectedBodyIndex);
        }

        // Notify parent of part state change
        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Clears body selection and returns the viewer to the full assembly.
    /// </summary>
    private async Task ClearBodySelectionAsync()
    {
        if (Part.SelectedBodyIndex is null)
            return;

        Part.SelectedBodyIndex = null;

        if (_modelViewer != null)
        {
            await _modelViewer.SelectBodyAsync(null);
        }

        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles body picking callback from the 3D viewer.
    /// Called by ModelViewer when user clicks on a body in the 3D scene.
    /// </summary>
    private async Task HandleBodyPickedAsync(int? bodyIndex)
    {
        Part.SelectedBodyIndex = bodyIndex;

        // Notify parent of part state change
        await OnPartChanged.InvokeAsync(Part);
        await InvokeAsync(StateHasChanged);
    }

    private static string GetProcessName(string? code) =>
        ProcessDisplayHelper.GetName(code, "—");

    private static string? GetMaterialColorFromOptions(PartViewModel part)
    {
        var finishLower = (part.FinishCode ?? "").ToLowerInvariant();

        // Painted/powder: return paint hex; filament "color" must not override it
        if (finishLower.Contains("paint") || finishLower.Contains("powder"))
        {
            part.ProcessOptionValues.TryGetValue("paint_color_hex", out var hex);
            return string.IsNullOrWhiteSpace(hex) ? null : hex;
        }

        // Anodized: dye colour — Clear/Natural means no albedo override
        if (finishLower.Contains("anod"))
        {
            foreach (var k in new[] { "anodize_color", "anodise_color" })
            {
                if (part.ProcessOptionValues.TryGetValue(k, out var anod)
                    && !string.IsNullOrWhiteSpace(anod)
                    && !string.Equals(anod, "Clear", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(anod, "Natural", StringComparison.OrdinalIgnoreCase))
                    return anod;
            }
            return null;
        }

        // All other finishes: material/filament colour
        if (part.ProcessOptionValues.TryGetValue("material_color", out var materialColor)
            && !string.IsNullOrWhiteSpace(materialColor))
            return materialColor;

        if (part.ProcessOptionValues.TryGetValue("color", out var color)
            && !string.IsNullOrWhiteSpace(color))
            return color;

        return null;
    }

    private static string? ColorNameToHex(string? color)
    {
        if (string.IsNullOrWhiteSpace(color))
            return null;
        if (color.StartsWith('#') && color.Length >= 4)
            return color;
        return color.Trim().ToLowerInvariant() switch
        {
            "black" or "matte black" => "#111111",
            "white" or "natural white" => "#f7f7f2",
            "natural" => "#eee7d2",
            "clear" or "transparent" => "#f6fbff",
            "blue" => "#2f6fd6",
            "red" => "#c8333a",
            "green" => "#2f8f5b",
            "yellow" => "#f1c232",
            "gray" or "grey" or "silver" => "#9ba3af",
            "orange" => "#e47c2f",
            "gold" => "#d4a72c",
            "purple" => "#7c4dff",
            "peek natural" => "#B3AA9E",
            "raw" => null,               // use material preset's intrinsic colour
            "pink" => "#ff69b4",
            _ => null,
        };
    }
