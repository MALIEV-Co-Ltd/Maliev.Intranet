@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject CurrencyService CurrencyService
@inject FileTypesSettings FileTypes
@inject UploadSettings UploadSettings

<div class="pbt-root">
    <div class="pbt-header">
        <div class="pbt-heading">
            <div class="pbt-title-row">
                <div class="pbt-kicker">Table edit</div>
                @if (OnLayoutModeChanged.HasDelegate)
                {
                    <button type="button"
                            class="pbt-icon-button pbt-configurator-button"
                            title="Configurator"
                            aria-label="Switch to configurator"
                            @onclick="@(() => OnLayoutModeChanged.InvokeAsync(LayoutMode.Configurator))">
                        <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                    </button>
                }
            </div>
            <div class="pbt-title">@Parts.Count part@(Parts.Count == 1 ? "" : "s")</div>
        </div>
        <div class="pbt-actions">
            @if (OnAddPart.HasDelegate)
            {
                <FileUploadDropzone Variant="FileUploadDropzone.DropzoneVariant.Compact"
                                    Icon="@Icons.Material.Outlined.CloudUpload"
                                    Label="Add CAD files"
                                    SubLabel="@FileTypes.ThreeDSubLabel"
                                    MaxFileSizeLabel="@($"max {UploadSettings.ThreeDModelLimit / 1048576} MB")"
                                    Class="pbt-upload-zone"
                                    OnClick="@OnAddPart"
                                    OnFilesDropped="@OnAddPart" />
            }
            <button type="button"
                    class="pbt-action-button"
                    @onclick="ToggleAllAsync">
                <MudIcon Icon="@(AreAllSelected ? Icons.Material.Outlined.Deselect : Icons.Material.Outlined.SelectAll)" Size="Size.Small" />
                <span>@(AreAllSelected ? "Clear" : "Select all")</span>
            </button>
        </div>
    </div>

    @if (SelectedCount > 0)
    {
        <div class="pbt-bulk-panel">
            <div class="pbt-bulk-summary">
                <strong>@SelectedCount selected</strong>
                <span class="pbt-bulk-summary-note">Auto-applies compatible fields.</span>
            </div>

            <div class="pbt-bulk-grid">
                <span class="pbt-bulk-field">Process</span>
                <select class="pbt-input"
                        value="@(_bulkPatch.Process?.Code ?? string.Empty)"
                        @onchange="OnBulkProcessChanged">
                    <option value="">Select process</option>
                    @foreach (var process in Processes)
                    {
                        <option value="@process.Code">@process.Name</option>
                    }
                </select>

                <span class="pbt-bulk-field">Material</span>
                <select class="pbt-input"
                        value="@(_bulkPatch.Material?.Id.ToString() ?? string.Empty)"
                        disabled="@(BulkSourcePart?.AvailableMaterials.Count == 0)"
                        @onchange="OnBulkMaterialChanged">
                    <option value="">Select material</option>
                    @foreach (var material in BulkSourcePart?.AvailableMaterials ?? [])
                    {
                        <option value="@material.Id">@material.Name</option>
                    }
                </select>

                <span class="pbt-bulk-field">Finish</span>
                <select class="pbt-input"
                        value="@(_bulkPatch.Finish?.Id.ToString() ?? string.Empty)"
                        disabled="@(BulkSourcePart?.AvailableFinishes.Count == 0)"
                        @onchange="OnBulkFinishChanged">
                    <option value="">Select finish</option>
                    @foreach (var finish in BulkSourcePart?.AvailableFinishes ?? [])
                    {
                        <option value="@finish.Id">@finish.Name</option>
                    }
                </select>

                <span class="pbt-bulk-field">Tolerance</span>
                <select class="pbt-input"
                        value="@(_bulkPatch.Tolerance?.Id.ToString() ?? string.Empty)"
                        disabled="@(BulkSourcePart?.AvailableTolerances.Count == 0)"
                        @onchange="OnBulkToleranceChanged">
                    <option value="">Select tolerance</option>
                    @foreach (var tolerance in BulkSourcePart?.AvailableTolerances ?? [])
                    {
                        <option value="@tolerance.Id">@tolerance.Name</option>
                    }
                </select>

                <span class="pbt-bulk-field">Quantity</span>
                <input class="pbt-input"
                       type="number"
                       min="1"
                       value="@_bulkPatch.Quantity"
                       @oninput="OnBulkQuantityChanged" />

                <span class="pbt-bulk-field">Inspection</span>
                <select class="pbt-input"
                        value="@_bulkPatch.InspectionLevel.ToString()"
                        @onchange="OnBulkInspectionChanged">
                    @foreach (var level in Enum.GetValues<InspectionLevel>())
                    {
                        <option value="@level">@FormatInspection(level)</option>
                    }
                </select>

                @if (BulkSourceSupportsRoughness)
                {
                    <span class="pbt-bulk-field">Roughness</span>
                    <input class="pbt-input"
                           value="@_bulkPatch.RoughnessCode"
                           placeholder="RA_3_2"
                           @oninput="OnBulkRoughnessChanged" />
                }

                <span class="pbt-bulk-field">Threaded holes</span>
                <label class="pbt-inline-check">
                    <input type="checkbox"
                           checked="@_bulkPatch.HasThreadedHoles"
                           @onchange="OnBulkThreadedHolesChanged" />
                    <span>Required</span>
                </label>

                <span class="pbt-bulk-field">Inserts</span>
                <label class="pbt-inline-check">
                    <input type="checkbox"
                           checked="@_bulkPatch.HasInserts"
                           @onchange="OnBulkInsertsChanged" />
                    <span>Required</span>
                </label>

                <span class="pbt-bulk-field">Notes</span>
                <textarea class="pbt-input pbt-input--notes"
                          value="@_bulkPatch.PartNotes"
                          placeholder="Part note"
                          rows="3"
                          @oninput="OnBulkNotesChanged"></textarea>
            </div>
        </div>
    }

    <div class="pbt-table-surface">
        <table class="pbt-table">
            <thead>
                <tr>
                    <th class="pbt-col-check">
                        <input type="checkbox"
                               checked="@AreAllSelected"
                               @onchange="@((ChangeEventArgs _) => ToggleAllAsync())"
                               aria-label="Select all parts" />
                    </th>
                    <th>Part</th>
                    <th>Process</th>
                    <th>Material</th>
                    <th>Finish</th>
                    <th>Tolerance</th>
                    <th>Qty</th>
                    <th>Inspection</th>
                    <th>Price</th>
                    <th>DFM</th>
                    <th class="pbt-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Parts)
                {
                    var selected = IsPartSelected(part);
                    <tr class="@($"pbt-table-row{(selected ? " pbt-table-row--selected" : string.Empty)}")">
                        <td class="pbt-col-check">
                            <input type="checkbox"
                                   checked="@selected"
                                   @onchange="@((ChangeEventArgs args) => TogglePartAsync(part, IsChecked(args)))"
                                   aria-label="@($"Select {part.Name}")" />
                        </td>
                        <td>
                            <div class="pbt-part-cell">
                                <div class="pbt-part-thumb">
                                    <ThumbnailImage StoragePath="@part.StoragePath"
                                                    Version="@part.ThumbnailVersion"
                                                    SignedDownloadUrl="@part.SignedDownloadUrl"
                                                    Alt="@part.Name" />
                                </div>
                                <div class="pbt-part-copy">
                                    <div class="pbt-part-name">@part.Name</div>
                                    <div class="pbt-part-meta">@ResolvePartMeta(part)</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <select class="pbt-input"
                                    value="@(part.ProcessCode ?? string.Empty)"
                                    @onchange="@((ChangeEventArgs args) => ChangeProcessAsync(part, args.Value?.ToString()))">
                                <option value="">Process</option>
                                @foreach (var process in Processes)
                                {
                                    <option value="@process.Code">@process.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="pbt-input"
                                    value="@(part.MaterialId?.ToString() ?? string.Empty)"
                                    disabled="@(part.AvailableMaterials.Count == 0)"
                                    @onchange="@((ChangeEventArgs args) => ChangeMaterialAsync(part, args.Value?.ToString()))">
                                <option value="">Material</option>
                                @foreach (var material in part.AvailableMaterials)
                                {
                                    <option value="@material.Id">@material.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="pbt-input"
                                    value="@(part.FinishId?.ToString() ?? string.Empty)"
                                    disabled="@(part.AvailableFinishes.Count == 0)"
                                    @onchange="@((ChangeEventArgs args) => ChangeFinishAsync(part, args.Value?.ToString()))">
                                <option value="">Finish</option>
                                @foreach (var finish in part.AvailableFinishes)
                                {
                                    <option value="@finish.Id">@finish.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="pbt-input"
                                    value="@(part.ToleranceId?.ToString() ?? string.Empty)"
                                    disabled="@(part.AvailableTolerances.Count == 0)"
                                    @onchange="@((ChangeEventArgs args) => ChangeToleranceAsync(part, args.Value?.ToString()))">
                                <option value="">Tolerance</option>
                                @foreach (var tolerance in part.AvailableTolerances)
                                {
                                    <option value="@tolerance.Id">@tolerance.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input class="pbt-input pbt-input--qty"
                                   type="number"
                                   min="1"
                                   value="@part.Quantity"
                                   @oninput="@((ChangeEventArgs args) => ChangeQuantityAsync(part, args.Value?.ToString()))" />
                        </td>
                        <td>
                            <select class="pbt-input"
                                    value="@part.InspectionLevel.ToString()"
                                    @onchange="@((ChangeEventArgs args) => ChangeInspectionAsync(part, args.Value?.ToString()))">
                                @foreach (var level in Enum.GetValues<InspectionLevel>())
                                {
                                    <option value="@level">@FormatInspection(level)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="@($"pbt-price{(part.PricingLoading ? " pbt-price--loading" : string.Empty)}")">
                                @if (part.PricingLoading)
                                {
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                }
                                <span>@ResolvePrice(part)</span>
                            </div>
                            @if (part.EstimatedUnitPrice.HasValue)
                            {
                                <div class="pbt-subtext">@CurrencyService.Format(part.EstimatedUnitPrice.Value) ea</div>
                            }
                        </td>
                        <td>
                            <button type="button"
                                    class="@ResolveDfmClass(part)"
                                    disabled="@(!CanUseDfmBadge(part))"
                                    title="@ResolveDfmTitle(part)"
                                    @onclick="@(() => ActivateDfmBadgeAsync(part))">
                                @ResolveDfmText(part)
                            </button>
                        </td>
                        <td class="pbt-col-actions">
                            <div class="pbt-row-actions">
                                <button type="button"
                                        class="pbt-icon-button pbt-expand-button"
                                        title="Advanced configuration"
                                        @onclick="@(() => ToggleExpanded(part))">
                                    <MudIcon Icon="@(IsExpanded(part) ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                                </button>
                                <button type="button"
                                        class="pbt-icon-button"
                                        title="Open viewer"
                                        disabled="@(!CanOpenViewer(part))"
                                        @onclick="@(() => OnOpenViewer.InvokeAsync(part))">
                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                </button>
                                <button type="button"
                                        class="pbt-icon-button"
                                        title="Duplicate part"
                                        @onclick="@(() => OnDuplicatePart.InvokeAsync(part))">
                                    <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                                </button>
                                <button type="button"
                                        class="pbt-icon-button pbt-icon-button--danger"
                                        title="Remove part"
                                        @onclick="@(() => OnRemovePart.InvokeAsync(part))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
                                </button>
                            </div>
                        </td>
                    </tr>
                    @if (IsExpanded(part))
                    {
                        <tr class="pbt-expanded-row">
                            <td colspan="11">
                                <div class="pbt-advanced-panel">
                                    <PartConfigSidebar Part="@part"
                                                       Processes="@Processes"
                                                       TempProjectId="@TempProjectId"
                                                       CustomerId="@CustomerId"
                                                       BrowserPrimaryServerDfmFallbackEnabled="@BrowserPrimaryServerDfmFallbackEnabled"
                                                       DisplayMode="@PartConfigSidebarDisplayMode.Inline"
                                                       OnPartChanged="@OnPartChanged" />
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="pbt-card-stack">
        @foreach (var part in Parts)
        {
            var selected = IsPartSelected(part);
            <article class="@($"pbt-part-card{(selected ? " pbt-part-card--selected" : string.Empty)}")">
                <div class="pbt-card-head">
                    <span class="pbt-part-thumb">
                        @if (part.QueuedUpload || part.AwaitingPreview)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                        }
                        else if (part.Uploading)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="false"
                                                 Value="@part.ProgressPercent"
                                                 Color="Color.Primary" />
                        }
                        <ThumbnailImage StoragePath="@part.StoragePath"
                                        Version="@part.ThumbnailVersion"
                                        SignedDownloadUrl="@part.SignedDownloadUrl"
                                        Alt="@part.Name" />
                    </span>
                    <label class="pbt-card-select">
                        <input type="checkbox"
                               checked="@selected"
                               @onchange="@((ChangeEventArgs args) => TogglePartAsync(part, IsChecked(args)))" />
                        <span class="pbt-card-title-copy">
                            <span class="pbt-card-title">@part.Name</span>
                            <span class="pbt-card-subtitle">@ResolvePartMeta(part)</span>
                        </span>
                    </label>
                    <button type="button"
                            class="pbt-icon-button pbt-expand-button"
                            title="Advanced configuration"
                            @onclick="@(() => ToggleExpanded(part))">
                        <MudIcon Icon="@(IsExpanded(part) ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                    </button>
                </div>

                <div class="pbt-card-meta">
                    <span class="@($"pbt-card-price{(part.PricingLoading ? " pbt-price--loading" : string.Empty)}")">
                        @if (part.PricingLoading)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                        }
                        <span>@ResolvePrice(part)</span>
                    </span>
                    <button type="button"
                            class="@ResolveDfmClass(part)"
                            disabled="@(!CanUseDfmBadge(part))"
                            title="@ResolveDfmTitle(part)"
                            @onclick="@(() => ActivateDfmBadgeAsync(part))">
                        @ResolveDfmText(part)
                    </button>
                </div>

                <div class="pbt-card-grid">
                    <label>
                        <span>Process</span>
                        <select class="pbt-input"
                                value="@(part.ProcessCode ?? string.Empty)"
                                @onchange="@((ChangeEventArgs args) => ChangeProcessAsync(part, args.Value?.ToString()))">
                            <option value="">Process</option>
                            @foreach (var process in Processes)
                            {
                                <option value="@process.Code">@process.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Material</span>
                        <select class="pbt-input"
                                value="@(part.MaterialId?.ToString() ?? string.Empty)"
                                disabled="@(part.AvailableMaterials.Count == 0)"
                                @onchange="@((ChangeEventArgs args) => ChangeMaterialAsync(part, args.Value?.ToString()))">
                            <option value="">Material</option>
                            @foreach (var material in part.AvailableMaterials)
                            {
                                <option value="@material.Id">@material.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Finish</span>
                        <select class="pbt-input"
                                value="@(part.FinishId?.ToString() ?? string.Empty)"
                                disabled="@(part.AvailableFinishes.Count == 0)"
                                @onchange="@((ChangeEventArgs args) => ChangeFinishAsync(part, args.Value?.ToString()))">
                            <option value="">Finish</option>
                            @foreach (var finish in part.AvailableFinishes)
                            {
                                <option value="@finish.Id">@finish.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Tolerance</span>
                        <select class="pbt-input"
                                value="@(part.ToleranceId?.ToString() ?? string.Empty)"
                                disabled="@(part.AvailableTolerances.Count == 0)"
                                @onchange="@((ChangeEventArgs args) => ChangeToleranceAsync(part, args.Value?.ToString()))">
                            <option value="">Tolerance</option>
                            @foreach (var tolerance in part.AvailableTolerances)
                            {
                                <option value="@tolerance.Id">@tolerance.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Qty</span>
                        <input class="pbt-input"
                               type="number"
                               min="1"
                               value="@part.Quantity"
                               @oninput="@((ChangeEventArgs args) => ChangeQuantityAsync(part, args.Value?.ToString()))" />
                    </label>
                    <label>
                        <span>Inspection</span>
                        <select class="pbt-input"
                                value="@part.InspectionLevel.ToString()"
                                @onchange="@((ChangeEventArgs args) => ChangeInspectionAsync(part, args.Value?.ToString()))">
                            @foreach (var level in Enum.GetValues<InspectionLevel>())
                            {
                                <option value="@level">@FormatInspection(level)</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="pbt-card-actions">
                    <button type="button" class="pbt-action-button" disabled="@(!CanOpenViewer(part))" @onclick="@(() => OnOpenViewer.InvokeAsync(part))">
                        <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                        <span>View</span>
                    </button>
                    <button type="button" class="pbt-action-button" @onclick="@(() => OnDuplicatePart.InvokeAsync(part))">
                        <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                        <span>Duplicate</span>
                    </button>
                    <button type="button" class="pbt-action-button pbt-action-button--danger" @onclick="@(() => OnRemovePart.InvokeAsync(part))">
                        <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" />
                        <span>Remove</span>
                    </button>
                </div>

                @if (IsExpanded(part))
                {
                    <div class="pbt-advanced-panel">
                        <PartConfigSidebar Part="@part"
                                           Processes="@Processes"
                                           TempProjectId="@TempProjectId"
                                           CustomerId="@CustomerId"
                                           BrowserPrimaryServerDfmFallbackEnabled="@BrowserPrimaryServerDfmFallbackEnabled"
                                           DisplayMode="@PartConfigSidebarDisplayMode.Inline"
                                           OnPartChanged="@OnPartChanged" />
                    </div>
                }
            </article>
        }
    </div>

    @if (_previewPart is not null && ResolvePreviewImageUrl(_previewPart) is { Length: > 0 } previewImageUrl)
    {
        <div class="pbt-preview-backdrop" @onclick="CloseThumbnailPreview">
            <div class="pbt-preview-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@($"Preview {_previewPart.Name}")"
                 @onclick:stopPropagation="true">
                <div class="pbt-preview-header">
                    <div>
                        <div class="pbt-kicker">Preview</div>
                        <div class="pbt-preview-title">@_previewPart.Name</div>
                    </div>
                    <div class="pbt-preview-actions">
                        @if (CanPreviewPartModel(_previewPart))
                        {
                            <MudTooltip Text="@(_preview3dActive ? "Show thumbnail" : "Show 3D view")">
                                <button type="button"
                                        class="@($"pbt-icon-button pbt-preview-view-toggle{(_preview3dActive ? " active" : string.Empty)}")"
                                        title="@(_preview3dActive ? "Show thumbnail" : "Show 3D view")"
                                        aria-label="@(_preview3dActive ? "Show thumbnail preview" : "Show 3D preview")"
                                        @onclick="ToggleThumbnailPreview3dAsync">
                                    <MudIcon Icon="@(_preview3dActive ? Icons.Material.Outlined.Image : Icons.Material.Outlined.ViewInAr)" Size="Size.Small" />
                                </button>
                            </MudTooltip>
                        }
                        <button type="button"
                                class="pbt-icon-button"
                                title="Close preview"
                                aria-label="Close preview"
                                @onclick="CloseThumbnailPreview">
                            <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                        </button>
                    </div>
                </div>
                <div class="pbt-preview-frame">
                    @if (_preview3dActive && ResolvePreviewViewerUrl(_previewPart) is { Length: > 0 } viewerUrl)
                    {
                        <div class="pbt-preview-viewer-frame">
                            <ModelViewer ViewerUrl="@viewerUrl"
                                         FileExtension="@ResolvePreviewViewerFileExtension(_previewPart)"
                                         KnownDimensions="@_previewPart.Dimensions"
                                         ViewerSettings="@_previewPart.ViewerSettings"
                                         OnLoadFailed="HandlePreviewViewerLoadFailed" />
                        </div>
                    }
                    else
                    {
                        <img src="@previewImageUrl" alt="@_previewPart.Name" class="pbt-preview-image" />
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_previewViewerError))
                {
                    <p class="pbt-preview-note">@_previewViewerError</p>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>All parts in the current draft.</summary>
    [Parameter] public List<PartViewModel> Parts { get; set; } = [];

    /// <summary>Available manufacturing processes.</summary>
    [Parameter] public List<ProcessDto> Processes { get; set; } = [];

    /// <summary>The currently selected part instances. Selection uses object references.</summary>
    [Parameter] public IReadOnlyCollection<PartViewModel> SelectedParts { get; set; } = [];

    /// <summary>Callback invoked when the selected part set changes.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<PartViewModel>> SelectedPartsChanged { get; set; }

    /// <summary>Callback invoked after a part's configuration has changed.</summary>
    [Parameter] public EventCallback<PartViewModel> OnPartChanged { get; set; }

    /// <summary>Callback invoked when a row changes its manufacturing process.</summary>
    [Parameter] public EventCallback<ProjectPartProcessChange> OnProcessChanged { get; set; }

    /// <summary>Callback invoked when the bulk editor applies an explicit patch.</summary>
    [Parameter] public EventCallback<ProjectPartsBulkApplyRequest> OnBulkApply { get; set; }

    /// <summary>Callback invoked when the user opens the 3-D viewer for a part.</summary>
    [Parameter] public EventCallback<PartViewModel> OnOpenViewer { get; set; }

    /// <summary>Callback invoked when the user activates a DFM status badge.</summary>
    [Parameter] public EventCallback<ProjectPartDfmActionRequest> OnDfmAction { get; set; }

    /// <summary>Callback invoked when the user removes a part.</summary>
    [Parameter] public EventCallback<PartViewModel> OnRemovePart { get; set; }

    /// <summary>Callback invoked when the user duplicates a part.</summary>
    [Parameter] public EventCallback<PartViewModel> OnDuplicatePart { get; set; }

    /// <summary>Callback invoked when the user wants to upload more CAD files.</summary>
    [Parameter] public EventCallback OnAddPart { get; set; }

    /// <summary>Callback invoked when the user requests a different project editor layout.</summary>
    [Parameter] public EventCallback<LayoutMode> OnLayoutModeChanged { get; set; }

    /// <summary>The temporary project identifier, forwarded to advanced configuration panels.</summary>
    [Parameter] public Guid TempProjectId { get; set; }

    /// <summary>The selected customer identifier, forwarded to advanced configuration panels.</summary>
    [Parameter] public Guid? CustomerId { get; set; }

    /// <summary>True when browser-primary uploads may fall back to server DFM during interactive quoting.</summary>
    [Parameter] public bool BrowserPrimaryServerDfmFallbackEnabled { get; set; } = true;

    private readonly HashSet<PartViewModel> _expandedParts = new(ReferenceEqualityComparer.Instance);
    private readonly PartConfigurationBulkPatch _bulkPatch = new();
    private PartViewModel? _lastBulkSourcePart;
    private PartViewModel? _previewPart;
    private string? _previewViewerError;
    private bool _preview3dActive;

    private int SelectedCount => SelectedParts.Count(part => Parts.Contains(part));

    private bool AreAllSelected =>
        Parts.Count > 0 && Parts.All(IsPartSelected);

    private PartViewModel? BulkSourcePart =>
        SelectedParts.FirstOrDefault(part => Parts.Contains(part));

    private bool BulkSourceSupportsRoughness =>
        IsCncProcessCode(BulkSourcePart?.ProcessCode);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _expandedParts.RemoveWhere(part => !Parts.Contains(part));

        var source = BulkSourcePart;
        if (!ReferenceEquals(source, _lastBulkSourcePart))
        {
            _lastBulkSourcePart = source;
            SeedBulkPatch(source);
        }
    }

    private void SeedBulkPatch(PartViewModel? source)
    {
        if (source == null)
            return;

        _bulkPatch.Process = Processes.FirstOrDefault(process => process.Code == source.ProcessCode);
        _bulkPatch.Material = source.MaterialId.HasValue
            ? source.AvailableMaterials.FirstOrDefault(material => material.Id == source.MaterialId.Value)
            : null;
        _bulkPatch.Finish = source.FinishId.HasValue
            ? source.AvailableFinishes.FirstOrDefault(finish => finish.Id == source.FinishId.Value)
            : null;
        _bulkPatch.Tolerance = source.ToleranceId.HasValue
            ? source.AvailableTolerances.FirstOrDefault(tolerance => tolerance.Id == source.ToleranceId.Value)
            : null;
        _bulkPatch.Quantity = Math.Max(1, source.Quantity);
        _bulkPatch.InspectionLevel = source.InspectionLevel;
        _bulkPatch.RoughnessCode = source.RoughnessCode;
        _bulkPatch.HasThreadedHoles = source.HasThreadedHoles;
        _bulkPatch.HasInserts = source.HasInserts;
        _bulkPatch.BagAndTag = source.BagAndTag;
        _bulkPatch.PartNotes = source.PartNotes;
    }

    private bool IsPartSelected(PartViewModel part) =>
        SelectedParts.Contains(part);

    private bool IsExpanded(PartViewModel part) =>
        _expandedParts.Contains(part);

    private void ToggleExpanded(PartViewModel part)
    {
        if (!_expandedParts.Add(part))
            _expandedParts.Remove(part);
    }

    private void OpenThumbnailPreview(PartViewModel part)
    {
        _previewPart = part;
        _previewViewerError = null;
        _preview3dActive = false;
    }

    private void CloseThumbnailPreview()
    {
        _previewPart = null;
        _previewViewerError = null;
        _preview3dActive = false;
    }

    private static string? ResolvePreviewImageUrl(PartViewModel part) =>
        !string.IsNullOrWhiteSpace(part.ThumbnailLargeUrl)
            ? part.ThumbnailLargeUrl
            : part.ThumbnailSmallUrl;

    private async Task ToggleThumbnailPreview3dAsync()
    {
        if (_previewPart is null)
            return;

        _previewViewerError = null;

        if (_preview3dActive)
        {
            _preview3dActive = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(ResolvePreviewViewerUrl(_previewPart)) && OnOpenViewer.HasDelegate)
            await OnOpenViewer.InvokeAsync(_previewPart);

        if (string.IsNullOrWhiteSpace(ResolvePreviewViewerUrl(_previewPart)))
        {
            _previewViewerError = "3D view is not available yet for this part.";
            return;
        }

        _preview3dActive = true;
    }

    private Task HandlePreviewViewerLoadFailed(string errorMessage)
    {
        _previewViewerError = string.IsNullOrWhiteSpace(errorMessage)
            ? "3D view could not be loaded."
            : $"3D view could not be loaded: {errorMessage}";
        _preview3dActive = false;
        return Task.CompletedTask;
    }

    private static bool CanPreviewPartModel(PartViewModel part) =>
        !string.IsNullOrWhiteSpace(part.ViewerUrl)
        || !string.IsNullOrWhiteSpace(part.GlbSignedUrl)
        || !string.IsNullOrWhiteSpace(part.GlbStoragePath);

    private static string? ResolvePreviewViewerUrl(PartViewModel part) =>
        !string.IsNullOrWhiteSpace(part.ViewerUrl)
            ? part.ViewerUrl
            : part.GlbSignedUrl;

    private static string ResolvePreviewViewerFileExtension(PartViewModel? part)
    {
        var ext = !string.IsNullOrWhiteSpace(part?.ViewerFileExtension)
            ? part.ViewerFileExtension.Trim()
            : System.IO.Path.GetExtension(part?.ViewerStoragePath ?? part?.GlbStoragePath ?? part?.StoragePath);

        if (string.IsNullOrWhiteSpace(ext))
            return ".glb";

        return ext.StartsWith('.') ? ext.ToLowerInvariant() : "." + ext.ToLowerInvariant();
    }

    private static bool IsCncProcessCode(string? processCode) =>
        string.Equals(processCode, "CNC", StringComparison.OrdinalIgnoreCase)
        || string.Equals(processCode, "CNC_MILL", StringComparison.OrdinalIgnoreCase)
        || string.Equals(processCode, "CNC_TURN", StringComparison.OrdinalIgnoreCase);

    private async Task ToggleAllAsync()
    {
        IReadOnlyCollection<PartViewModel> next = AreAllSelected
            ? []
            : new HashSet<PartViewModel>(Parts, ReferenceEqualityComparer.Instance);

        await SelectedPartsChanged.InvokeAsync(next);
    }

    private async Task TogglePartAsync(PartViewModel part, bool selected)
    {
        var next = new HashSet<PartViewModel>(SelectedParts, ReferenceEqualityComparer.Instance);
        if (selected)
            next.Add(part);
        else
            next.Remove(part);

        await SelectedPartsChanged.InvokeAsync(next);
    }

    private async Task ChangeProcessAsync(PartViewModel part, string? processCode)
    {
        var process = Processes.FirstOrDefault(item => string.Equals(item.Code, processCode, StringComparison.OrdinalIgnoreCase));
        await OnProcessChanged.InvokeAsync(new ProjectPartProcessChange(part, process));
    }

    private async Task ChangeMaterialAsync(PartViewModel part, string? materialId)
    {
        var material = TryFindById(part.AvailableMaterials, materialId);
        part.MaterialId = material?.Id;
        part.MaterialCode = material?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeFinishAsync(PartViewModel part, string? finishId)
    {
        var finish = TryFindById(part.AvailableFinishes, finishId);
        part.FinishId = finish?.Id;
        part.FinishCode = finish?.Code;
        await OnPartChanged.InvokeAsync(part);
    }

    private async Task ChangeToleranceAsync(PartViewModel part, string? toleranceId)
    {
        var tolerance = TryFindById(part.AvailableTolerances, toleranceId);
        part.ToleranceId = tolerance?.Id;
        part.ToleranceCode = tolerance?.Code;
