    private async Task ActivateDfmBadgeAsync(PartViewModel part)
    {
        if (!CanUseDfmBadge(part))
            return;

        var action = part.DfmAnalysisTimedOut && part.DfmReport == null
            ? ProjectPartDfmAction.Retry
            : ProjectPartDfmAction.Review;

        if (OnDfmAction.HasDelegate)
            await OnDfmAction.InvokeAsync(new ProjectPartDfmActionRequest(part, action));
        else if (action == ProjectPartDfmAction.Review && OnOpenViewer.HasDelegate)
            await OnOpenViewer.InvokeAsync(part);
    }

    private static bool IsChecked(ChangeEventArgs args) =>
        args.Value is bool checkedValue && checkedValue;

    private static bool CanOpenViewer(PartViewModel part) =>
        !string.IsNullOrEmpty(part.GlbStoragePath) ||
        !string.IsNullOrEmpty(part.GlbSignedUrl) ||
        !string.IsNullOrEmpty(part.ViewerUrl);

    private static T? TryFindById<T>(IReadOnlyCollection<T> items, string? id)
        where T : class
    {
        if (!Guid.TryParse(id, out var parsedId))
            return null;

        return items.FirstOrDefault(item => item switch
        {
            CatalogMaterialDto material => material.Id == parsedId,
            CatalogSurfaceFinishDto finish => finish.Id == parsedId,
            CatalogToleranceDto tolerance => tolerance.Id == parsedId,
            _ => false,
        });
    }

    private string ResolvePrice(PartViewModel part)
    {
        if (part.PricingLoading)
            return "Pricing";

        return part.EstimatedTotalAmount.HasValue
            ? CurrencyService.Format(part.EstimatedTotalAmount.Value)
            : "Not priced";
    }

    private static bool CanUseDfmBadge(PartViewModel part) =>
        part.DfmAnalysisTimedOut ||
        part.DfmReport != null ||
        part.HasProcessRelevantDfmIssues;

    private static string ResolveDfmText(PartViewModel part)
    {
        if (part.RequiresDfmAcknowledgement)
            return "Review";
        if (part.DfmReport != null)
            return "Ready";
        if (part.DfmAnalysisTimedOut)
            return "Retry";
        if (part.ProcessId.HasValue)
            return "Pending";

        return "No process";
    }

    private static string ResolveDfmTitle(PartViewModel part)
    {
        if (part.DfmAnalysisTimedOut)
            return "Retry DFM analysis";
        if (part.RequiresDfmAcknowledgement)
            return "Open DFM review";
        if (part.DfmReport != null)
            return "Open DFM report";

        return "DFM not ready";
    }

    private static string ResolveDfmClass(PartViewModel part) =>
        part.RequiresDfmAcknowledgement
            ? "pbt-dfm pbt-dfm--warning"
            : part.DfmReport != null
                ? "pbt-dfm pbt-dfm--ready"
                : part.DfmAnalysisTimedOut
                    ? "pbt-dfm pbt-dfm--error"
                    : "pbt-dfm";

    private static string ResolvePartMeta(PartViewModel part)
    {
        if (part.Dimensions == null)
            return part.StatusText;

        return $"{part.Dimensions.X:N1} x {part.Dimensions.Y:N1} x {part.Dimensions.Z:N1} mm";
    }

    private static string FormatInspection(InspectionLevel level) =>
        level switch
        {
            InspectionLevel.FullCmm => "Full CMM",
            _ => level.ToString(),
        };
}
