@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Client.Services
@inject CurrencyService CurrencyService
@implements IDisposable

<div class="bpt-container">
    <div class="bpt-header" @onclick="@(() => _expanded = !_expanded)">
        <MudIcon Icon="@Icons.Material.Filled.Discount" Size="Size.Small" Color="Color.Primary" />
        <MudText Typo="Typo.body2" Class="ml-1" Style="font-weight:600;" Color="Color.Primary">Volume Savings</MudText>
        <MudSpacer />
        @if (!_expanded && ActiveTier != null && SavingAmount > 0)
        {
            @if (CurrencyService.IsConverting)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="60px" Height="14px" />
            }
            else
            {
                <span class="bpt-saved-chip">Saved @CurrencyService.Format(SavingAmount)</span>
            }
        }
        <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                 Size="Size.Small" Color="Color.Secondary" Class="bpt-expand-icon" />
    </div>

    <div class="bpt-content" style="@(_expanded ? "grid-template-rows: 1fr;" : "grid-template-rows: 0fr;")">
        <div class="bpt-tiers-inner">
            @for (var i = 0; i < Tiers.Count; i++)
            {
                var tier = Tiers[i];
                var isActive = CurrentQuantity >= tier.Quantity &&
                               (i == Tiers.Count - 1 || CurrentQuantity < Tiers[i + 1].Quantity);
                <div class="bpt-tier-row @(isActive ? "bpt-tier-row--active" : "")">
                    <MudText Typo="Typo.body2">@tier.Quantity+ units</MudText>
                    @if (CurrencyService.IsConverting)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="50px" Height="14px" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="@(isActive ? "font-weight:700;" : "")">
                            @CurrencyService.Format(tier.UnitPrice)
                        </MudText>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bpt-container {
        border: 1px dashed var(--mud-palette-primary);
        border-radius: var(--mud-default-borderradius);
        overflow: hidden;
    }
    .bpt-saved-chip {
        background: var(--mud-palette-primary);
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
        font-size: var(--mud-typography-caption-size);
        white-space: nowrap;
    }
    .bpt-header {
        display: flex;
        align-items: center;
        padding: 8px 10px;
        cursor: pointer;
        background: var(--mud-palette-surface);
        user-select: none;
    }
    .bpt-header:hover { background: var(--mud-palette-background); }
    .bpt-expand-icon {
        transition: transform 0.2s ease;
    }
    .bpt-content {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.2s ease-out;
    }
    .bpt-tiers-inner {
        overflow: hidden;
    }
    .bpt-tier-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 10px;
        transition: background 0.1s;
    }
    .bpt-tier-row--active {
        background: var(--mud-palette-success-lighten);
    }
</style>

@code {
    /// <summary>The list of volume pricing tiers, ordered by minimum quantity ascending.</summary>
    [Parameter] public List<BulkTier> Tiers { get; set; } = [];

    /// <summary>The current part quantity, used to highlight the active pricing tier.</summary>
    [Parameter] public int CurrentQuantity { get; set; } = 1;

    private bool _expanded;

    protected override void OnInitialized() =>
        CurrencyService.Changed += OnCurrencyChanged;

    public void Dispose() =>
        CurrencyService.Changed -= OnCurrencyChanged;

    private void OnCurrencyChanged(object? sender, EventArgs e) =>
        InvokeAsync(StateHasChanged);

    private BulkTier? ActiveTier => Tiers
        .Where(t => CurrentQuantity >= t.Quantity)
        .OrderByDescending(t => t.Quantity)
        .FirstOrDefault();

    private BulkTier? BaseTier => Tiers.Count > 0 ? Tiers[0] : null;

    private decimal SavingAmount =>
        ActiveTier != null && BaseTier != null && ActiveTier != BaseTier
            ? (BaseTier.UnitPrice - ActiveTier.UnitPrice) * CurrentQuantity
            : 0;

    /// <summary>
    /// Represents a single volume pricing tier.
    /// </summary>
    /// <param name="Quantity">Minimum quantity to qualify for this tier.</param>
    /// <param name="UnitPrice">Unit price at this tier.</param>
    public record BulkTier(int Quantity, decimal UnitPrice);
}
