@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos

<div class="pn-topbar">
    @* Back arrow *@
    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                   Href="/sales/projects"
                   Size="Size.Small"
                   Color="Color.Default" />

    @* Inline-editable title *@
    @if (_editingTitle)
    {
        <MudTextField T="string"
                      Value="@_titleDraft"
                      ValueChanged="@(v => _titleDraft = v)"
                      Immediate="true"
                      AutoFocus="true"
                      Variant="Variant.Text"
                      Margin="Margin.Dense"
                      @onblur="@CommitTitle"
                      Style="font-weight:600; font-size:14px; min-width:200px;" />
    }
    else
    {
        <span class="pn-topbar-title" @onclick="@(() => { _titleDraft = Title; _editingTitle = true; })">
            @(string.IsNullOrWhiteSpace(Title) ? "Untitled Project" : Title)
            <MudIcon Icon="@Icons.Material.Outlined.Edit" Class="pn-title-edit-icon" Size="Size.Small" />
        </span>
    }
    <MudChip T="string" Size="Size.Small" Color="Color.Default" Label="true" Class="ml-1">Draft</MudChip>

    <MudSpacer />

    @* Currency select *@
    <MudSelect T="CurrencyDto"
               Value="@SelectedCurrency"
               ValueChanged="@OnCurrencyChanged"
               ToStringFunc="@(c => c == null ? "" : $"{c.Code} — {c.Name}")"
               Label="Currency"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="width:180px;"
               Clearable="false">
        @foreach (var c in Currencies)
        {
            <MudSelectItem T="CurrencyDto" Value="@c">@c.Code — @c.Name</MudSelectItem>
        }
    </MudSelect>

    @* Saved status *@
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mx-2" Style="white-space:nowrap;">
        @if (AutoSaving) { <text>Saving...</text> }
        else if (LastSavedAt.HasValue) { <text>@GetRelativeTime(LastSavedAt.Value)</text> }
    </MudText>

    @* New project button *@
    <MudTooltip Text="New project">
        <MudIconButton Icon="@Icons.Material.Outlined.Add"
                       Size="Size.Small"
                       Href="/sales/projects/new" />
    </MudTooltip>

    @* Duplicate button *@
    <MudTooltip Text="Duplicate project">
        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                       Size="Size.Small"
                       OnClick="@OnDuplicate" />
    </MudTooltip>

    @* Layout toggle *@
    <MudTooltip Text="@(LayoutMode == LayoutMode.Configurator ? "Switch to table view" : "Switch to configurator")">
        <MudIconButton Icon="@(LayoutMode == LayoutMode.Configurator ? Icons.Material.Outlined.TableRows : Icons.Material.Outlined.GridView)"
                       Size="Size.Small"
                       OnClick="@ToggleLayout" />
    </MudTooltip>
</div>

<style>
    .pn-topbar {
        height: 52px;
        min-height: 52px;
        background: var(--mud-palette-surface);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        display: flex;
        align-items: center;
        padding: 0 8px;
        gap: 6px;
        flex-shrink: 0;
    }
    .pn-topbar-title {
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 300px;
    }
    .pn-topbar-title:hover { text-decoration: underline; }
    .pn-title-edit-icon {
        font-size: 14px !important;
        opacity: 0;
        transition: opacity 0.15s;
        vertical-align: middle;
        margin-left: 3px;
        color: var(--mud-palette-text-secondary);
    }
    .pn-topbar-title:hover .pn-title-edit-icon { opacity: 0.7; }
</style>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public CurrencyDto? SelectedCurrency { get; set; }
    [Parameter] public List<CurrencyDto> Currencies { get; set; } = [];
    [Parameter] public EventCallback<CurrencyDto?> OnCurrencyChanged { get; set; }
    [Parameter] public DateTimeOffset? LastSavedAt { get; set; }
    [Parameter] public bool AutoSaving { get; set; }
    [Parameter] public LayoutMode LayoutMode { get; set; }
    [Parameter] public EventCallback<LayoutMode> OnLayoutModeChanged { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }

    private bool _editingTitle;
    private string _titleDraft = string.Empty;

    private async Task CommitTitle()
    {
        _editingTitle = false;
        if (_titleDraft != Title)
            await OnTitleChanged.InvokeAsync(_titleDraft);
    }

    private Task ToggleLayout() =>
        OnLayoutModeChanged.InvokeAsync(
            LayoutMode == LayoutMode.Configurator ? LayoutMode.SummaryTable : LayoutMode.Configurator);

    private string GetRelativeTime(DateTimeOffset time)
    {
        var diff = DateTimeOffset.Now - time.ToLocalTime();
        if (diff.TotalMinutes < 1) return "Saved just now";
        if (diff.TotalMinutes < 60) return $"Saved {(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24) return $"Saved {(int)diff.TotalHours}h ago";
        return $"Saved {time.ToLocalTime():dd MMM HH:mm}";
    }
}
