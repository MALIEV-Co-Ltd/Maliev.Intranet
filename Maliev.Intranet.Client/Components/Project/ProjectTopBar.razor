@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos

<div class="pn-topbar">
    @* Back arrow *@
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIosNew"
                   Href="/sales/projects"
                   Size="Size.Small"
                   Color="Color.Default" />

    @* Inline-editable title *@
    <input type="text"
           value="@_titleDraft"
           @onchange="(e) => _titleDraft = e.Value?.ToString() ?? string.Empty"
           @onblur="CommitTitle"
           class="tb-title-input"
           size="14" />

    @* Save indicator *@
    @if (AutoSaving)
    {
        <MudIcon Icon="@Icons.Material.Filled.CloudSync" Class="pn-save-icon pn-save-icon--spin" Size="Size.Small" />
    }
    else
    {
        <span class="badge">
            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Small" />
            Saved
        </span>
    }

    <MudSpacer />

    @* Currency select *@
    <MudSelect T="CurrencyDto"
               Value="@SelectedCurrency"
               ValueChanged="@OnCurrencyChanged"
               ToStringFunc="@(c => c?.Code ?? "")"
               Label=""
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Dense="true"
               Style="width:90px;flex-grow:0;flex-shrink:0;"
               Clearable="false">
        @foreach (var c in Currencies)
        {
            <MudSelectItem T="CurrencyDto" Value="@c">@c.Code @c.Symbol</MudSelectItem>
        }
    </MudSelect>

    @* Layout toggle *@
    <MudTooltip Text="@(LayoutMode == LayoutMode.Configurator ? "Switch to table view" : "Switch to configurator")">
        <MudIconButton Icon="@(LayoutMode == LayoutMode.Configurator ? Icons.Material.Filled.ViewList : Icons.Material.Filled.AutoAwesomeMosaic)"
                       Size="Size.Small"
                       OnClick="@ToggleLayout" />
    </MudTooltip>

    @* Duplicate button *@
    <MudTooltip Text="Duplicate project">
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                       Size="Size.Small"
                       OnClick="@OnDuplicate" />
    </MudTooltip>
</div>

<style>
    .pn-topbar {
        height: 48px;
        min-height: 48px;
        background: var(--mud-palette-surface);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        display: flex;
        align-items: center;
        padding: 0 8px;
        gap: 6px;
        flex-shrink: 0;
    }

</style>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public CurrencyDto? SelectedCurrency { get; set; }
    [Parameter] public List<CurrencyDto> Currencies { get; set; } = [];
    [Parameter] public EventCallback<CurrencyDto?> OnCurrencyChanged { get; set; }
    [Parameter] public bool AutoSaving { get; set; }
    [Parameter] public LayoutMode LayoutMode { get; set; }
    [Parameter] public EventCallback<LayoutMode> OnLayoutModeChanged { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }

    private string _titleDraft = string.Empty;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _titleDraft = Title;
    }

    private async Task CommitTitle()
    {
        if (_titleDraft != Title)
            await OnTitleChanged.InvokeAsync(_titleDraft);
    }

    private Task ToggleLayout() =>
        OnLayoutModeChanged.InvokeAsync(
            LayoutMode == LayoutMode.Configurator ? LayoutMode.SummaryTable : LayoutMode.Configurator);
}
