@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos

<MudStack Row AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="pn-topbar">

    @* LEFT: back + title + badge *@
    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIosNew"
                       Href="/sales/projects"
                       Size="Size.Small"
                       Color="Color.Default" />

        <input type="text"
               value="@_titleDraft"
               @onchange="(e) => _titleDraft = e.Value?.ToString() ?? string.Empty"
               @onblur="CommitTitle"
               class="tb-title-input"
               style="min-width:200px"
               size="14" />

        @if (AutoSaving)
        {
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Class="pn-save-icon pn-save-icon--spin" Size="Size.Small" />
        }
        else
        {
            <span class="badge">
                <MudIcon Icon="@Icons.Material.Outlined.CloudDone" Size="Size.Small" />
                Saved
            </span>
        }
    </MudStack>

    @* RIGHT: currency + action buttons *@
    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
        <MudAutocomplete T="object"
                       Value="@_selectedCurrencyWrapper"
                       ValueChanged="@OnCurrencySelected"
                       ToStringFunc="@CurrencyToString"
                       SearchFunc="@SearchCurrencies"
                       Label=""
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width:120px;flex-shrink:0;"
                       Clearable="false"
                       ShowProgressIndicator="true"
                       DebounceInterval="300"
                       CoerceText="true">
            <ItemTemplate Context="item">
                @if (item is DividerItem)
                {
                    <div class="currency-divider">All Currencies</div>
                }
                else if (item is CurrencyDto currency)
                {
                    <MudText Typo="Typo.body2">@currency.Code @currency.Symbol</MudText>
                }
            </ItemTemplate>
        </MudAutocomplete>

        <MudTooltip Text="@(LayoutMode == LayoutMode.Configurator ? "Switch to table view" : "Switch to configurator")">
            <MudIconButton Icon="@(LayoutMode == LayoutMode.Configurator ? Icons.Material.Filled.ViewList : Icons.Material.Filled.AutoAwesomeMosaic)"
                           Size="Size.Small"
                           OnClick="@ToggleLayout" />
        </MudTooltip>

        <MudTooltip Text="Duplicate project">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Small"
                           OnClick="@OnDuplicate" />
        </MudTooltip>
    </MudStack>
</MudStack>

<style>
    .pn-topbar {
        height: 48px;
        min-height: 48px;
        background: var(--mud-palette-surface);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        padding: 0 8px;
        flex-shrink: 0;
    }

    .currency-divider {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--mud-palette-text-tertiary);
        padding: 8px 12px 4px;
        border-top: 1px solid var(--mud-palette-lines-default);
        margin-top: 4px;
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public CurrencyDto? SelectedCurrency { get; set; }
    [Parameter] public List<CurrencyDto> Currencies { get; set; } = [];
    [Parameter] public EventCallback<CurrencyDto?> OnCurrencyChanged { get; set; }
    [Parameter] public bool AutoSaving { get; set; }
    [Parameter] public LayoutMode LayoutMode { get; set; }
    [Parameter] public EventCallback<LayoutMode> OnLayoutModeChanged { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }

    private string _titleDraft = string.Empty;

    private object? _selectedCurrencyWrapper;

    private static readonly string[] TopCurrencyCodes = ["THB", "USD", "EUR", "GBP", "JPY"];

    /// <summary>A non-selectable divider item used to visually separate currency sections in the dropdown.</summary>
    private sealed class DividerItem;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _titleDraft = Title;
        _selectedCurrencyWrapper ??= SelectedCurrency;
    }

    private async Task CommitTitle()
    {
        if (_titleDraft != Title)
            await OnTitleChanged.InvokeAsync(_titleDraft);
    }

    private Task ToggleLayout() =>
        OnLayoutModeChanged.InvokeAsync(
            LayoutMode == LayoutMode.Configurator ? LayoutMode.SummaryTable : LayoutMode.Configurator);

    private string CurrencyToString(object? item) =>
        item switch
        {
            CurrencyDto c => $"{c.Code} {c.Symbol}",
            _ => string.Empty
        };

    private async Task OnCurrencySelected(object? item)
    {
        if (item is CurrencyDto currency)
        {
            await OnCurrencyChanged.InvokeAsync(currency);
        }
    }

    private Task<IEnumerable<object>> SearchCurrencies(string text, CancellationToken _)
    {
        if (Currencies.Count == 0)
            return Task.FromResult<IEnumerable<object>>([]);

        if (string.IsNullOrWhiteSpace(text))
        {
            var top = Currencies
                .Where(c => c != null && TopCurrencyCodes.Contains(c.Code))
                .OrderBy(c => Array.IndexOf(TopCurrencyCodes, c.Code))
                .Cast<object>()
                .ToList();

            var rest = Currencies
                .Where(c => c != null && !TopCurrencyCodes.Contains(c.Code))
                .OrderBy(c => c.Code)
                .Cast<object>()
                .ToList();

            if (rest.Count > 0)
                top.Add(new DividerItem());

            top.AddRange(rest);
            return Task.FromResult<IEnumerable<object>>(top);
        }

        var filtered = Currencies
            .Where(c => c != null)
            .Where(c =>
                c.Code.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                c.Symbol.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                c.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => !TopCurrencyCodes.Contains(c.Code))
            .ThenBy(c => Array.IndexOf(TopCurrencyCodes, c.Code) is var idx && idx >= 0 ? idx : int.MaxValue)
            .ThenBy(c => c.Code)
            .Cast<object>();

        return Task.FromResult<IEnumerable<object>>(filtered);
    }
}
