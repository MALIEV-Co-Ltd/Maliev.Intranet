@namespace Maliev.Intranet.Client.Components.Project
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared
@inject IDialogService DialogService

<div class="prp-root">
    @if (Loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (Routing != null)
    {
        <div class="prp-info">
            <MudText Typo="Typo.body2">
                <strong>@Routing.MachineCode</strong> — @Routing.MachineName
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Queue ahead: @Routing.QueueAhead job@(Routing.QueueAhead == 1 ? "" : "s")
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Est. start: @Routing.EstimatedStartDate.ToString("d MMM yyyy")
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                   OnClick="OpenScheduleDialog"
                   Class="mt-2">
            View Planning Schedule
        </MudButton>
    }
</div>

<style>
    .prp-root {
        padding: 12px 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .prp-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .psi-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 6px 0;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .psi-item:last-child { border-bottom: none; }
</style>

@code {
    [Parameter] public ProductionRoutingDto? Routing { get; set; }
    [Parameter] public bool Loading { get; set; }

    private void OpenScheduleDialog()
    {
        var parameters = new DialogParameters<ScheduleDialogContent>
        {
            { x => x.Routing, Routing }
        };
        DialogService.ShowAsync<ScheduleDialogContent>("Planning Schedule", parameters);
    }

    private Color GetStatusColor(string status) => status.ToUpperInvariant() switch
    {
        "COMPLETE" => Color.Success,
        "INPROGRESS" => Color.Warning,
        "CANCELLED" => Color.Error,
        _ => Color.Default
    };
}