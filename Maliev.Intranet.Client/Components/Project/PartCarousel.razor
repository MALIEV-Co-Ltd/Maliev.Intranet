@namespace Maliev.Intranet.Client.Components.Project

<div class="pc-row">
    @for (var i = 0; i < Parts.Count; i++)
    {
        var idx = i;
        <PartMiniCard Part="@Parts[idx]"
                      IsActive="@(idx == SelectedIndex)"
                      OnClick="@(() => OnSelectPart.InvokeAsync(idx))"
                      OnRemove="@(() => OnRemovePart.InvokeAsync(Parts[idx]))" />
    }
    <div class="pc-add" @onclick="OnAddPart">
        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" Color="Color.Default" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Add Part</MudText>
    </div>
</div>

<style>
    .pc-row {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding: 16px;
        background: var(--mud-palette-surface);
        flex-shrink: 0;
        align-items: stretch;
        gap: 8px;
    }
    .pc-add {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 80px;
        height: 100%;
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        cursor: pointer;
        flex-shrink: 0;
        gap: 2px;
        padding: 8px;
        transition: border-color 0.15s;
    }
    .pc-add:hover { border-color: var(--mud-palette-primary); }
</style>

@code {
    /// <summary>The list of parts to display as mini-cards.</summary>
    [Parameter] public List<PartViewModel> Parts { get; set; } = [];

    /// <summary>The index of the currently active/selected part.</summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>Invoked when the user clicks a part card, passing the part's index.</summary>
    [Parameter] public EventCallback<int> OnSelectPart { get; set; }

    /// <summary>Invoked when the user clicks the remove button on a part card.</summary>
    [Parameter] public EventCallback<PartViewModel> OnRemovePart { get; set; }

    /// <summary>Invoked when the user clicks the Add Part button.</summary>
    [Parameter] public EventCallback OnAddPart { get; set; }
}
