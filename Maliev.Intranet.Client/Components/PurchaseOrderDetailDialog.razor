@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            @for (int i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2 rounded" />
            }
        }
        else if (_po == null)
        {
            <MudAlert Severity="Severity.Error">Purchase order not found.</MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">PO Number</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight:600;">@_po.PoNumber</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_po.Status)">@_po.Status</MudChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Supplier</MudText>
                    <MudText Typo="Typo.body1">@_po.SupplierName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Expected Delivery</MudText>
                    <MudText Typo="Typo.body1">@_po.ExpectedDelivery?.ToString("dd MMM yyyy")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Line Items</MudText>
                    <MudTable Items="_po.Items" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Material</MudTh>
                            <MudTh Style="text-align:right">Qty</MudTh>
                            <MudTh Style="text-align:right">Unit Price</MudTh>
                            <MudTh Style="text-align:right">Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Material">@context.MaterialId</MudTd>
                            <MudTd DataLabel="Qty" Style="text-align:right">@context.Quantity</MudTd>
                            <MudTd DataLabel="Unit Price" Style="text-align:right">@CurrencyFormatter.Format(context.UnitPrice, "THB", 2)</MudTd>
                            <MudTd DataLabel="Total" Style="text-align:right">@CurrencyFormatter.Format(context.Quantity * context.UnitPrice, "THB", 2)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudDivider Class="mt-2" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                        <MudText Typo="Typo.subtitle1">Total: <strong>@CurrencyFormatter.Format(_po.TotalValue, "THB", 2)</strong></MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid PurchaseOrderId { get; set; }

    private bool _isLoading = true;
    private PurchaseOrderDto? _po;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _po = await Http.GetFromJsonAsync<PurchaseOrderDto>($"api/procurement/{PurchaseOrderId}");
        }
        catch { }
        finally
        {
            _isLoading = false;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Pending Approval" => Color.Warning,
        "Approved" => Color.Info,
        "Ordered" => Color.Primary,
        "Received" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
