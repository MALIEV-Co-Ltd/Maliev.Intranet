@namespace Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="ccc-root">
    @if (!string.IsNullOrWhiteSpace(Customer.ProfileImageUrl))
    {
        <img class="ccc-avatar ccc-avatar-image"
             src="@Customer.ProfileImageUrl"
             alt=""
             aria-hidden="true"
             referrerpolicy="no-referrer" />
    }
    else
    {
        <div class="ccc-avatar">@GetInitials(Customer.Name)</div>
    }
    <div class="ccc-info">
        <div class="ccc-name-row">
            <div class="ccc-name">@Customer.Name</div>
            @if (!string.IsNullOrEmpty(Customer.Tier))
            {
                <span class="ccc-tier ccc-tier--@Customer.Tier.ToLowerInvariant()">@Customer.Tier</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Customer.CompanyName))
        {
            <div class="ccc-sub">@Customer.CompanyName</div>
        }
        <div class="ccc-contact">
            @if (!string.IsNullOrEmpty(Customer.Email))
            {
                <span class="ccc-contact-item" title="@Customer.Email">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6c0-1.1.9-2 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" stroke="currentColor" stroke-width="2"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="2"/></svg>
                    @Customer.Email
                </span>
            }
            @if (!string.IsNullOrEmpty(PrimaryPhone))
            {
                <span class="ccc-contact-item" title="@PrimaryPhone">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2"/></svg>
                    @PrimaryPhone
                </span>
            }
        </div>
    </div>
    @if (ShowClear)
    {
        <button class="ccc-clear" title="Change customer" @onclick="@(() => OnClear.InvokeAsync())">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <line x1="2" y1="2" x2="10" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="2" x2="2" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    }
</div>


@code {
    [Parameter, EditorRequired] public CustomerSummaryDto Customer { get; set; } = null!;
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public bool ShowClear { get; set; } = true;

    private string? PrimaryPhone =>
        FirstNonEmpty(Customer.Mobile, Customer.Landline, Customer.CompanyPhone);

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : name.Length >= 2
                ? $"{name[0]}{name[1]}".ToUpperInvariant()
                : name[0].ToString().ToUpperInvariant();
    }
}
