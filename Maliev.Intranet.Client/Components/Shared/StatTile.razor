<div class="mlv-stat-tile @Class" aria-busy="@Loading.ToString().ToLowerInvariant()">
    <div class="mlv-stat-label">@Label</div>
    <div class="mlv-stat-value @(ChildContent is null ? null : "content")" style="@ValueStyle">
        @if (Loading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="84px" Height="30px" Animation="Animation.Wave" />
        }
        else if (ChildContent is null)
        {
            @Value
        }
        else
        {
            @ChildContent
        }
    </div>
    @if (Loading)
    {
        <MudSkeleton Class="mlv-stat-sub-skeleton" SkeletonType="SkeletonType.Text" Width="112px" Height="13px" Animation="Animation.Wave" />
    }
    else if (!string.IsNullOrWhiteSpace(Subtext))
    {
        <div class="mlv-stat-sub @TrendClass">
            @if (Trend == true)
            {
                <MudIcon Icon="@Icons.Material.Outlined.TrendingUp" Size="Size.Small" />
            }
            else if (Trend == false)
            {
                <MudIcon Icon="@Icons.Material.Outlined.TrendingDown" Size="Size.Small" />
            }
            <span>@Subtext</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Subtext { get; set; }
    [Parameter] public bool? Trend { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Loading { get; set; }

    private string? ValueStyle => string.IsNullOrWhiteSpace(Color) ? null : $"color:{Color}";
    private string TrendClass => Trend == true ? "up" : Trend == false ? "down" : string.Empty;
}
