@namespace Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="pc-root">
    @* ── Month navigation header ──────────────────────────────────────────────*@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                       OnClick="PrevMonth" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">
            @CurrentMonth.ToString("MMMM yyyy")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                       OnClick="NextMonth" />
    </MudStack>

    @* ── 7-column CSS grid ───────────────────────────────────────────────────*@
    <div class="pc-grid">
        @* Day-of-week headers *@
        @foreach (var dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
        {
            <div class="pc-dow-header">
                <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">@dow</MudText>
            </div>
        }

        @* Day cells *@
        @foreach (var day in _calendarDays)
        {
            var dayItems = _itemsByDate.GetValueOrDefault(DateOnly.FromDateTime(day.Date), []);
            <PlanningCalendarDay Date="@day"
                                 Items="@dayItems"
                                 IsCurrentMonth="@(day.Month == CurrentMonth.Month)"
                                 IsToday="@(DateOnly.FromDateTime(day.Date) == _today)"
                                 OnDayClicked="@OnDayClicked" />
        }
    </div>

    @* ── Legend *@
    @if (ProposedSlotStart.HasValue)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
            <div class="pc-legend-proposed"></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Proposed slot for this part</MudText>
        </MudStack>
    }
</div>

<style>
    .pc-root { width: 100%; }

    .pc-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0;
        width: 100%;
    }

    .pc-dow-header {
        padding: 4px 2px;
        text-align: center;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        border-right: 1px solid var(--mud-palette-lines-default);
    }

    .pc-dow-header:last-child {
        border-right: none;
    }

    .pc-legend-proposed {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border: 2px dashed var(--mud-palette-secondary);
        background: color-mix(in srgb, var(--mud-palette-secondary) 15%, transparent);
    }
</style>

@code {
    [Parameter] public IReadOnlyList<PlanningScheduleItemDto> ScheduleItems { get; set; } = [];
    [Parameter] public DateTime CurrentMonth { get; set; } = DateTime.Today;
    [Parameter] public DateTimeOffset? ProposedSlotStart { get; set; }
    [Parameter] public DateTimeOffset? ProposedSlotEnd { get; set; }
    [Parameter] public string ProposedMachineName { get; set; } = string.Empty;
    [Parameter] public EventCallback<DateTime> OnDayClicked { get; set; }
    [Parameter] public EventCallback<DateTime> OnMonthChanged { get; set; }

    private List<DateTime> _calendarDays = [];
    private Dictionary<DateOnly, List<PlanningScheduleItemDto>> _itemsByDate = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    protected override void OnParametersSet()
    {
        BuildCalendar();
        BuildItemIndex();
    }

    private void BuildCalendar()
    {
        _calendarDays = [];
        var first = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        // Monday-first: Mon=0 … Sun=6
        var offset = ((int)first.DayOfWeek + 6) % 7;
        var start = first.AddDays(-offset);
        for (int i = 0; i < 42; i++)
            _calendarDays.Add(start.AddDays(i));
    }

    private void BuildItemIndex()
    {
        _itemsByDate = ScheduleItems
            .GroupBy(i => DateOnly.FromDateTime(i.PlannedDate.Date))
            .ToDictionary(g => g.Key, g => g.ToList());

        // Inject proposed slot into the index
        if (ProposedSlotStart.HasValue)
        {
            var proposedDate = DateOnly.FromDateTime(ProposedSlotStart.Value.Date);
            var proposed = new PlanningScheduleItemDto(
                PlannedDate:      ProposedSlotStart.Value,
                PlannedEndDate:   ProposedSlotEnd ?? ProposedSlotStart.Value.AddHours(1),
                JobReference:     "This part",
                Status:           "Proposed",
                JobId:            Guid.Empty,
                MachineName:      ProposedMachineName,
                SetupTimeMinutes: 0,
                PrintTimeMinutes: 0,
                IsProposed:       true
            );
            if (!_itemsByDate.TryGetValue(proposedDate, out var list))
            {
                list = [];
                _itemsByDate[proposedDate] = list;
            }
            list.Add(proposed);
        }
    }

    private async Task PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        BuildCalendar();
        BuildItemIndex();
        await OnMonthChanged.InvokeAsync(CurrentMonth);
    }

    private async Task NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        BuildCalendar();
        BuildItemIndex();
        await OnMonthChanged.InvokeAsync(CurrentMonth);
    }
}
