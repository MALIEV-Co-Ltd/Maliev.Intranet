@namespace Maliev.Intranet.Client.Components.Shared

@if (Variant == DropzoneVariant.Hero)
{
    <div class="fud-hero @(DragOver ? "fud-hero--active" : "") @Class"
         @ondragenter:preventDefault="true"
         @ondragover:preventDefault="true"
         @ondragleave:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondragenter="@OnDragEnter"
         @ondragleave="@OnDragLeave"
         @ondrop="@HandleDrop"
         @onclick="@HandleClick">
        <div class="fud-hero-content">
            <MudIcon Icon="@Icon" Size="@Size.Large" Color="Color.Primary" Class="fud-hero-icon" />
            <MudText Typo="Typo.h5" Class="fud-hero-title">@(DragOver ? "Drop files here" : Label)</MudText>
            @if (!string.IsNullOrEmpty(SubLabel) || !string.IsNullOrEmpty(MaxFileSizeLabel))
            {
                <MudText Typo="Typo.body1" Class="fud-hero-sub">
                    @if (!string.IsNullOrEmpty(SubLabel) && !string.IsNullOrEmpty(MaxFileSizeLabel))
                    {
                        @($"{SubLabel} · {MaxFileSizeLabel}")
                    }
                    else if (!string.IsNullOrEmpty(SubLabel))
                    {
                        @SubLabel
                    }
                    else
                    {
                        @MaxFileSizeLabel
                    }
                </MudText>
            }
            <MudText Typo="Typo.caption" Class="fud-hero-hint">Supports drag & drop or click to browse</MudText>
        </div>
    </div>
}
else if (Variant == DropzoneVariant.Compact)
{
    <div class="fud-compact @(DragOver ? "fud-compact--active" : "") @Class"
         @ondragenter:preventDefault="true"
         @ondragover:preventDefault="true"
         @ondragleave:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondragenter="@OnDragEnter"
         @ondragleave="@OnDragLeave"
         @ondrop="@HandleDrop"
         @onclick="@HandleClick">
        <MudIcon Icon="@Icon" Size="Size.Medium" Color="Color.Primary" Class="fud-compact-icon" />
        <div class="fud-compact-body">
            <span class="fud-compact-title">@(DragOver ? "Drop files here" : Label)</span>
            @if (!string.IsNullOrEmpty(SubLabel) || !string.IsNullOrEmpty(MaxFileSizeLabel))
            {
                <span class="fud-compact-sub">
                    @if (!string.IsNullOrEmpty(SubLabel) && !string.IsNullOrEmpty(MaxFileSizeLabel))
                    {
                        @($"{SubLabel} · {MaxFileSizeLabel}")
                    }
                    else if (!string.IsNullOrEmpty(SubLabel))
                    {
                        @SubLabel
                    }
                    else
                    {
                        @MaxFileSizeLabel
                    }
                </span>
            }
        </div>
    </div>
}
else
{
    <div class="fud-dropzone @(DragOver ? "fud-dropzone--active" : "") @Class"
         @ondragenter:preventDefault="true"
         @ondragover:preventDefault="true"
         @ondragleave:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondragenter="@OnDragEnter"
         @ondragleave="@OnDragLeave"
         @ondrop="@HandleDrop"
         @onclick="@HandleClick">
        <MudIcon Icon="@Icon"
                 Size="Size.Large"
                 Color="Color.Primary"
                 Class="fud-icon" />
        <MudText Typo="Typo.body2" Class="@($"fud-label{(DragOver ? " fud-label--drag" : "")}")">
            @(DragOver ? "Drop files here" : Label)
        </MudText>
        @if (!string.IsNullOrEmpty(SubLabel) || !string.IsNullOrEmpty(MaxFileSizeLabel))
        {
            <MudText Typo="Typo.caption" Class="fud-sublabel">
                @if (!string.IsNullOrEmpty(SubLabel) && !string.IsNullOrEmpty(MaxFileSizeLabel))
                {
                    @($"{SubLabel} · {MaxFileSizeLabel}")
                }
                else if (!string.IsNullOrEmpty(SubLabel))
                {
                    @SubLabel
                }
                else
                {
                    @MaxFileSizeLabel
                }
            </MudText>
        }
    </div>
}

<style>
    /* ── Normal variant ─────────────────────────────────────────────── */
    .fud-dropzone {
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        min-height: 120px;
        text-align: center;
        user-select: none;
        background: var(--mud-palette-background);
    }

    .fud-dropzone:hover,
    .fud-dropzone--active {
        border-color: var(--mud-palette-primary);
        background: var(--maliev-primary-soft);
    }

    .fud-icon {
        transition: transform 0.25s ease;
    }

    .fud-dropzone:hover .fud-icon,
    .fud-dropzone--active .fud-icon {
        transform: translateY(-4px) scale(1.1);
    }

    .fud-label {
        font-weight: 600 !important;
        color: var(--mud-palette-text-primary) !important;
        margin-top: 4px;
    }

    .fud-label--drag {
        color: var(--mud-palette-primary) !important;
    }

    .fud-sublabel {
        color: var(--mud-palette-text-secondary) !important;
        margin-top: 2px;
    }

    /* ── Hero variant ─────────────────────────────────────────────────── */
    .fud-hero {
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 16px;
        padding: 64px 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color 0.3s, background 0.3s, transform 0.2s;
        user-select: none;
        background: linear-gradient(180deg, var(--mud-palette-background) 0%, var(--mud-palette-surface) 100%);
        min-height: 320px;
        position: relative;
        overflow: hidden;
    }

    .fud-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(ellipse at center, var(--maliev-primary-soft) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .fud-hero:hover,
    .fud-hero--active {
        border-color: var(--mud-palette-primary);
        background: var(--maliev-primary-soft);
        transform: scale(1.01);
    }

    .fud-hero:hover::before,
    .fud-hero--active::before {
        opacity: 1;
    }

    .fud-hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 480px;
    }

    .fud-hero-icon {
        transition: transform 0.3s ease;
        filter: drop-shadow(0 8px 24px rgba(var(--mud-palette-primary-rgb), 0.3));
    }

    .fud-hero:hover .fud-hero-icon,
    .fud-hero--active .fud-hero-icon {
        transform: translateY(-8px) scale(1.15);
    }

    .fud-hero-title {
        font-weight: 600 !important;
        color: var(--mud-palette-text-primary) !important;
        margin: 0;
    }

    .fud-hero-sub {
        color: var(--mud-palette-text-secondary) !important;
        margin: 0;
        line-height: 1.6;
    }

    .fud-hero-hint {
        color: var(--mud-palette-text-tertiary) !important;
        margin: 8px 0 0 0;
        font-style: italic;
    }

    /* ── Compact variant ─────────────────────────────────────────────── */
    .fud-compact {
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 6px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
        user-select: none;
        background: var(--mud-palette-surface);
    }

    .fud-compact:hover,
    .fud-compact--active {
        border-color: var(--mud-palette-primary);
        background: var(--maliev-primary-soft);
    }

    .fud-compact-icon { flex-shrink: 0; }

    .fud-compact-body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .fud-compact-title {
        font-size: var(--mud-typography-body2-size);
        font-weight: 500;
        color: var(--mud-palette-text-primary);
    }

    .fud-compact-sub {
        font-size: var(--mud-typography-caption-size);
        color: var(--mud-palette-text-secondary);
        line-height: 1.4;
    }
</style>

@code {
    /// <summary>Additional CSS classes applied to the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Visual variant: <see cref="DropzoneVariant.Normal"/> (large centred) or <see cref="DropzoneVariant.Compact"/> (small horizontal row).</summary>
    [Parameter] public DropzoneVariant Variant { get; set; } = DropzoneVariant.Normal;

    /// <summary>Material icon string shown in the dropzone.</summary>
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.ViewInAr;

    /// <summary>Primary label shown when not dragging.</summary>
    [Parameter] public string Label { get; set; } = "Drag & drop or click to upload";

    /// <summary>Secondary hint text (file type list, description, etc.).</summary>
    [Parameter] public string? SubLabel { get; set; }

    /// <summary>Max file size string appended to SubLabel (e.g. "max 250 MB").</summary>
    [Parameter] public string? MaxFileSizeLabel { get; set; }

    /// <summary>Invoked when the user clicks the dropzone.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Invoked when files are dropped. Signal-only — the parent handles actual file access.</summary>
    [Parameter] public EventCallback OnFilesDropped { get; set; }

    private bool DragOver { get; set; }
    private int _dragDepth;
    private bool _suppressNextClick;

    private void OnDragEnter() { _dragDepth++; DragOver = _dragDepth > 0; }
    private void OnDragLeave() { _dragDepth--; DragOver = _dragDepth > 0; }

    private async Task HandleDrop()
    {
        _dragDepth = 0;
        DragOver = false;
        _suppressNextClick = true;
        await OnFilesDropped.InvokeAsync();
    }

    private async Task HandleClick()
    {
        if (_suppressNextClick) { _suppressNextClick = false; return; }
        await OnClick.InvokeAsync();
    }

    /// <summary>Display variant for <see cref="FileUploadDropzone"/>.</summary>
    public enum DropzoneVariant { Normal, Compact, Hero }
}
