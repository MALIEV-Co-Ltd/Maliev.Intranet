@namespace Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="pcd-cell @(_isCurrentMonth ? "" : "pcd-other-month") @(_isToday ? "pcd-today" : "")"
     @onclick="HandleClick">
    @* Day number *@
    <div class="pcd-day-num">
        <MudText Typo="Typo.caption"
                 Style="@(_isToday ? "font-weight:800;" : "")"
                 Color="@(_isCurrentMonth ? Color.Default : Color.Tertiary)">
            @Date.Day
        </MudText>
    </div>
    @* Job chips (up to 3 real + proposed always shown) *@
    @{
        var real = Items.Where(i => !i.IsProposed).Take(3).ToList();
        var proposed = Items.FirstOrDefault(i => i.IsProposed);
    }
    @foreach (var item in real)
    {
        <MudChip T="string" Size="Size.Small"
                 Color="@GetStatusColor(item.Status)"
                 Variant="Variant.Filled"
                 Class="pcd-chip">
            @item.JobReference
        </MudChip>
    }
    @if (Items.Count(i => !i.IsProposed) > 3)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pcd-more">
            +@(Items.Count(i => !i.IsProposed) - 3) more
        </MudText>
    }
    @if (proposed is not null)
    {
        <div class="pcd-chip pcd-proposed-chip">This part</div>
    }
</div>

<style>
    .pcd-cell {
        padding: 4px;
        border-right: 1px solid var(--mud-palette-lines-default);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        overflow: hidden;
        min-height: 72px;
        cursor: pointer;
    }
    .pcd-cell:nth-child(7n) { border-right: none; }
    .pcd-cell:hover { background: var(--mud-palette-action-hover); }
    .pcd-other-month { opacity: 0.4; }
    .pcd-today { background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent) !important; }
    .pcd-day-num { margin-bottom: 2px; }
    .pcd-chip {
        font-size: 9px !important;
        height: 16px !important;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 1px;
        padding: 0 4px !important;
        min-width: 0 !important;
    }
    .pcd-proposed-chip {
        border: 1.5px dashed var(--mud-palette-secondary) !important;
        background: color-mix(in srgb, var(--mud-palette-secondary) 12%, transparent) !important;
        color: var(--mud-palette-secondary-text) !important;
        border-radius: 4px;
        line-height: 14px;
        font-weight: 600;
    }
    .pcd-more { font-size: 9px !important; }
</style>

@code {
    [Parameter] public DateTime Date { get; set; }
    [Parameter] public List<PlanningScheduleItemDto> Items { get; set; } = [];
    [Parameter] public bool IsCurrentMonth { get; set; } = true;
    [Parameter] public bool IsToday { get; set; }
    [Parameter] public EventCallback<DateTime> OnDayClicked { get; set; }

    private bool _isCurrentMonth => IsCurrentMonth;
    private bool _isToday => IsToday;

    private async Task HandleClick() => await OnDayClicked.InvokeAsync(Date);

    private static Color GetStatusColor(string status) => status.ToUpperInvariant() switch
    {
        "COMPLETED" or "COMPLETE" => Color.Success,
        "INPROGRESS"              => Color.Warning,
        "CANCELLED"               => Color.Error,
        _                         => Color.Primary
    };
}
