@namespace Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Shared.Dtos

<div class="dsv-root">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                       OnClick="@OnBack" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">
            @Date.ToString("dddd, d MMMM yyyy")
        </MudText>
    </MudStack>

    @{
        var real = Items.Where(i => !i.IsProposed).OrderBy(i => i.PlannedDate).ToList();
        var proposed = Items.FirstOrDefault(i => i.IsProposed);
    }

    @if (!real.Any() && proposed is null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-4">
            No jobs scheduled on this day.
        </MudText>
    }

    @foreach (var item in real)
    {
        <MudCard Elevation="0" Class="dsv-card mb-2 border mud-border-lines-default">
            <MudCardContent Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@item.JobReference</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(item.Status)" Variant="Variant.Filled">
                        @item.Status
                    </MudChip>
                </MudStack>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @item.PlannedDate.ToString("HH:mm") — @item.PlannedEndDate.ToString("HH:mm")
                </MudText>

                @if (!string.IsNullOrEmpty(item.MachineName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing" Size="Size.Small" />
                        @item.MachineName
                    </MudText>
                }

                @{
                    var total = item.SetupTimeMinutes + item.PrintTimeMinutes;
                    var setupPct = total > 0 ? (int)(100.0 * item.SetupTimeMinutes / total) : 0;
                    var printPct = 100 - setupPct;
                }
                <div class="dsv-time-bar mt-2">
                    <div class="dsv-setup" style="width:@setupPct%;"></div>
                    <div class="dsv-print" style="width:@printPct%;"></div>
                </div>
                <MudStack Row="true" Spacing="2" Class="mt-1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Setup @item.SetupTimeMinutes min</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">Print @item.PrintTimeMinutes min</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }

    @if (proposed is not null)
    {
        <MudCard Elevation="0" Class="dsv-card dsv-proposed mb-2">
            <MudCardContent Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;" Color="Color.Secondary">
                            This part (proposed)
                        </MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                        Proposed
                    </MudChip>
                </MudStack>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @proposed.PlannedDate.ToString("HH:mm") — @proposed.PlannedEndDate.ToString("HH:mm")
                </MudText>

                @if (!string.IsNullOrEmpty(proposed.MachineName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing" Size="Size.Small" />
                        @proposed.MachineName
                    </MudText>
                }

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    Estimated slot — actual times assigned when order enters production.
                </MudText>
            </MudCardContent>
        </MudCard>
    }
</div>

<style>
    .dsv-root { width: 100%; }
    .dsv-card { border-radius: 8px; }
    .dsv-time-bar { height: 6px; border-radius: 3px; overflow: hidden; display: flex; background: var(--mud-palette-lines-default); }
    .dsv-setup { background: var(--mud-palette-warning); }
    .dsv-print { background: var(--mud-palette-primary); }
    .dsv-proposed {
        border: 1.5px dashed var(--mud-palette-secondary) !important;
        background: color-mix(in srgb, var(--mud-palette-secondary) 8%, transparent) !important;
    }
</style>

@code {
    [Parameter] public DateTime Date { get; set; }
    [Parameter] public IEnumerable<PlanningScheduleItemDto> Items { get; set; } = [];
    [Parameter] public EventCallback OnBack { get; set; }

    private static Color GetStatusColor(string status) => status.ToUpperInvariant() switch
    {
        "COMPLETED" or "COMPLETE" => Color.Success,
        "INPROGRESS"              => Color.Warning,
        "CANCELLED"               => Color.Error,
        _                         => Color.Primary
    };
}
