@using Maliev.Intranet.Shared
@using MudBlazor
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudStack Spacing="3">
                <!-- Customer Selection -->
                <MudAutocomplete T="CustomerSummaryDto"
                                 Value="_selectedCustomer"
                                 Label="Customer"
                                 Required="true"
                                 RequiredError="Customer is required"
                                 SearchFunc="SearchCustomers"
                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                 ValueChanged="OnCustomerChanged"
                                 Variant="Variant.Outlined">
                    <ItemTemplate Context="customer">
                        <MudStack Row="false" Spacing="0">
                            <MudText Typo="Typo.body1">@customer.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@customer.Email</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_selectedCustomer != null && _customerIdentity != null)
                {
                    <!-- Billing Identity Selector -->
                    <BillingIdentitySelector Customer="_customerIdentity"
                                             @bind-SelectedIdentityType="_billingIdentityType" />

                    <!-- Invoice Details -->
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudDatePicker Label="Issue Date"
                                           @bind-Date="_issueDate"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker Label="Due Date"
                                           @bind-Date="_dueDate"
                                           Required="true"
                                           Variant="Variant.Outlined"
                                           MinDate="_issueDate" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="_paymentTermsDays"
                                             Label="Payment Terms (Days)"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="365"
                                             Required="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudSelect T="string"
                                       @bind-Value="_currency"
                                       Label="Currency"
                                       Variant="Variant.Outlined"
                                       Required="true">
                                <MudSelectItem Value="@("THB")">THB - Thai Baht</MudSelectItem>
                                <MudSelectItem Value="@("USD")">USD - US Dollar</MudSelectItem>
                                <MudSelectItem Value="@("EUR")">EUR - Euro</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <!-- Line Items -->
                    <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded-lg">
                        <MudStack Row="false" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">Line Items</MudText>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           OnClick="AddLineItem">
                                    Add Item
                                </MudButton>
                            </MudStack>

                            @if (_lineItems.Count == 0)
                            {
                                <MudText Color="Color.Secondary">No items added yet. Click "Add Item" to get started.</MudText>
                            }
                            else
                            {
                                @foreach (var (item, index) in _lineItems.Select((item, i) => (item, i)))
                                {
                                    <MudPaper Elevation="1" Class="pa-2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="item.Description"
                                                              Label="Description"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Required="true" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudNumericField @bind-Value="item.Quantity"
                                                                 Label="Quantity"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0.01m"
                                                                 Required="true" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudNumericField @bind-Value="item.UnitPrice"
                                                                 Label="Unit Price"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Format="N2"
                                                                 Min="0m"
                                                                 Required="true" />
                                            </MudItem>
                                            <MudItem xs="1">
                                                <MudNumericField @bind-Value="item.TaxRate"
                                                                 Label="VAT %"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Min="0m"
                                                                 Max="100m" />
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total</MudText>
                                                <MudText Typo="Typo.h6">@ThaiCurrency.Format(CalculateLineTotal(item), 2)</MudText>
                                            </MudItem>
                                            <MudItem xs="1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="() => RemoveLineItem(index)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }

                                <MudDivider />
                                <MudStack Row="false" AlignItems="AlignItems.End" Spacing="1">
                                    <MudText Typo="Typo.body1">Subtotal: @ThaiCurrency.Format(CalculateSubtotal(), 2)</MudText>
                                    <MudText Typo="Typo.body1">VAT: @ThaiCurrency.Format(CalculateTotalVat(), 2)</MudText>
                                    <MudText Typo="Typo.h6">Total: @ThaiCurrency.Format(CalculateTotal(), 2)</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateInvoice"
                   Disabled="@(!_isValid || _selectedCustomer == null || _lineItems.Count == 0 || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating...</MudText>
            }
            else
            {
                <text>Create Invoice</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isSubmitting;

    private CustomerSummaryDto? _selectedCustomer;
    private CustomerIdentityDto? _customerIdentity;
    private BillingIdentityType _billingIdentityType = BillingIdentityType.Corporate;
    private DateTime? _issueDate = DateTime.Today;
    private DateTime? _dueDate = DateTime.Today.AddDays(30);
    private int _paymentTermsDays = 30;
    private string _currency = "THB";
    private List<InvoiceItemDto> _lineItems = new();

    private async Task<IEnumerable<CustomerSummaryDto>> SearchCustomers(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return Array.Empty<CustomerSummaryDto>();

        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>($"api/customers?search={value}", cancellationToken);
            return response?.Data ?? Array.Empty<CustomerSummaryDto>();
        }
        catch
        {
            return Array.Empty<CustomerSummaryDto>();
        }
    }

    private async Task OnCustomerChanged(CustomerSummaryDto? customer)
    {
        _selectedCustomer = customer;
        _customerIdentity = null;

        if (customer == null)
            return;

        try
        {
            _customerIdentity = await Http.GetFromJsonAsync<CustomerIdentityDto>($"api/customers/{customer.Id}/identity");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customer identity: {ex.Message}", Severity.Error);
        }
    }

    private void AddLineItem()
    {
        _lineItems.Add(new InvoiceItemDto
        {
            Description = "",
            Quantity = 1,
            UnitPrice = 0,
            TaxRate = 7.00m
        });
    }

    private void RemoveLineItem(int index)
    {
        _lineItems.RemoveAt(index);
    }

    private decimal CalculateLineTotal(InvoiceItemDto item)
    {
        var subtotal = item.Quantity * item.UnitPrice;
        var tax = subtotal * (item.TaxRate / 100);
        return subtotal + tax;
    }

    private decimal CalculateSubtotal()
    {
        return _lineItems.Sum(item => item.Quantity * item.UnitPrice);
    }

    private decimal CalculateTotalVat()
    {
        return _lineItems.Sum(item => item.Quantity * item.UnitPrice * (item.TaxRate / 100));
    }

    private decimal CalculateTotal()
    {
        return CalculateSubtotal() + CalculateTotalVat();
    }

    private async Task CreateInvoice()
    {
        if (_selectedCustomer == null || _issueDate == null || _dueDate == null)
            return;

        _isSubmitting = true;

        try
        {
            var request = new CreateInvoiceRequest
            {
                CustomerId = _selectedCustomer.Id,
                BillingIdentityType = _billingIdentityType,
                IssueDate = _issueDate.Value,
                DueDate = _dueDate.Value,
                PaymentTermsDays = _paymentTermsDays,
                Currency = _currency,
                Items = _lineItems
            };

            var response = await Http.PostAsJsonAsync("api/invoices", request);
            response.EnsureSuccessStatusCode();

            Snackbar.Add("Invoice created successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create invoice: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
