@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatService ChatService
@implements IDisposable

<div class="d-flex flex-column" style="height: 100%; overflow: hidden;">
    <!-- Header Area -->
    <div class="pa-4 pb-0">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6" Style="line-height: 1.1;">Assistant</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Context: @ChatService.CurrentContext</MudText>
        </MudStack>
        <MudDivider Class="mt-2" />
    </div>

    <!-- Chat Messages Area -->
    <div class="flex-grow-1 px-4 py-4" style="overflow-y: auto;">
        <MudChat ChatPosition="ChatBubblePosition.Start">
             <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
            </MudAvatar>
            <MudChatBubble>
                Hello! I'm your AI assistant. I see you are currently viewing the <b>@GetPageName()</b> page. How can I help you?
            </MudChatBubble>
        </MudChat>

        @foreach (var message in ChatService.Messages)
        {
            <MudChat ChatPosition="@(message.IsUser ? ChatBubblePosition.End : ChatBubblePosition.Start)">
                @if (message.IsUser)
                {
                    <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                        @if (!string.IsNullOrEmpty(_userPicture))
                        {
                            <MudImage Src="@_userPicture" />
                        }
                        else
                        {
                            @(_userName?[0] ?? 'U')
                        }
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                    </MudAvatar>
                }
                <MudChatBubble>
                    <div style="white-space: pre-wrap;">@message.Text</div>
                </MudChatBubble>
            </MudChat>
        }
    </div>

    <!-- Bottom Input Area (Redesigned) -->
    <div class="pa-4 mt-auto @(IsMobile ? "mb-16" : "")">
        <MudPaper Elevation="0" Class="rounded-xl pa-2 chat-input-container border border-solid mud-border-lines-default" Style="background-color: var(--mud-palette-surface);">
            <div class="px-2 pt-1">
                <MudTextField @bind-Value="_currentInput" 
                              Placeholder="Ask anything" 
                              Variant="Variant.Text" 
                              Underline="false"
                              Lines="1"
                              AutoGrow="true"
                              MaxLines="8"
                              OnKeyDown="@HandleKeyDown"
                              Immediate="true"
                              autocomplete="off"
                              Class="mt-0"
                              Style="font-size: 0.95rem;" />
            </div>

            <div class="d-flex align-center justify-space-between mt-1 px-1">
                <div class="d-flex align-center gap-1">
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFiles" Hidden="true">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" Class="action-icon" />
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudIconButton Icon="@Icons.Material.Outlined.Public" Size="Size.Small" Class="action-icon" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" Class="action-icon" />
                    <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz" Size="Size.Small" Class="action-icon" />
                </div>

                <div class="send-button-wrapper">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" 
                                   OnClick="@SendMessage" 
                                   Class="send-button-square"
                                   Size="Size.Small" />
                </div>
            </div>
        </MudPaper>
        
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="d-block mt-2" Style="font-size: 0.75rem;">
            AI can make mistakes. Please double-check responses.
        </MudText>
    </div>
</div>

<style>
    .chat-input-container {
        transition: box-shadow 0.2s;
    }
    
    .chat-input-container:focus-within {
        box-shadow: 0 0 0 1px var(--mud-palette-primary) !important;
    }

    .action-icon {
        color: var(--mud-palette-text-secondary);
        border: 1px solid var(--mud-palette-divider);
        padding: 6px !important;
    }

    .send-button-square {
        background-color: var(--mud-palette-text-primary) !important;
        color: var(--mud-palette-surface) !important;
        border-radius: 8px !important;
        padding: 6px !important;
    }

    .send-button-square:hover {
        opacity: 0.9;
    }

    .send-button-square:disabled {
        background-color: var(--mud-palette-action-disabled-background) !important;
    }
</style>

@code {
    [Parameter] public bool IsMobile { get; set; }

    private string _currentInput = "";
    private string? _userPicture;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnChange += StateHasChanged;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userPicture = user.FindFirst("picture")?.Value;
            _userName = user.Identity.Name;
        }
    }

    private string GetPageName()
    {
        return ChatService.CurrentContext.Trim('/').Split('/').LastOrDefault() ?? "Home";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Send on Enter, but allow Shift+Enter for new lines
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        var input = _currentInput;
        if (string.IsNullOrWhiteSpace(input)) return;

        _currentInput = ""; // Clear immediately
        ChatService.AddMessage(input, true);
        
        // Mock response
        _ = Task.Delay(500).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                ChatService.AddMessage($"I'm a mockup assistant. You asked about '{input}' while on the {GetPageName()} page. Integration with Maliev.Chatbot is coming soon!", false);
            });
        });
        
        await InvokeAsync(StateHasChanged);
    }

    private void UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            ChatService.AddMessage($"[Attachment: {file.Name} ({file.Size} bytes)]", true);
        }
    }

    public void Dispose()
    {
        ChatService.OnChange -= StateHasChanged;
    }
}
