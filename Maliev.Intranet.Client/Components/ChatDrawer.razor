@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatService ChatService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="d-flex flex-column" style="height: 100%; overflow: hidden;">
    <!-- Header Area -->
    <div class="pa-4 pb-0">
        <div class="d-flex align-center justify-space-between">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Style="line-height: 1.1;">Assistant</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Context: @ChatService.CurrentContext</MudText>
            </MudStack>
            @if (!IsMobile)
            {
                <MudIconButton Icon="@(IsExpanded ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                               Size="Size.Small"
                               Color="Color.Secondary"
                               OnClick="@(() => IsExpandedChanged.InvokeAsync(!IsExpanded))" />
            }
        </div>
        <MudDivider Class="mt-2" />
    </div>

    @if (_isCheckingAvailability)
    {
        <!-- Loading while checking AI availability -->
        <div class="flex-grow-1 d-flex align-center justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!_isAiAvailable)
    {
        <!-- AI Unavailable Message -->
        <div class="flex-grow-1 d-flex align-center justify-center pa-4">
            <MudAlert Severity="Severity.Warning" Dense="false" Class="mt-2">
                <MudText>AI Assistant is currently unavailable. Unable to establish a connection with the chatbot service.</MudText>
            </MudAlert>
        </div>
    }
    else
    {
        <!-- Chat Messages Area -->
    <div id="chat-container" class="flex-grow-1 px-4 py-4 scroll-container" style="overflow-y: auto; position: relative;" @onscroll="HandleScroll">
        @foreach (var message in ChatService.Messages)
        {
            @* Show thinking chain above assistant messages that have thinking steps *@
            @if (!message.IsUser && message.ThinkingSteps.Count > 0)
            {
                <ThinkingChain Steps="message.ThinkingSteps" IsProcessing="message.IsProcessing" />
            }

            @* Show processing placeholder with thinking chain only *@
            @if (message.IsProcessing && string.IsNullOrEmpty(message.Text))
            {
                @if (message.ThinkingSteps.Count == 0)
                {
                    <MudChat ChatPosition="ChatBubblePosition.Start">
                        <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                            <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                        </MudAvatar>
                        <MudChatBubble>
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" Style="width: 120px;" />
                        </MudChatBubble>
                    </MudChat>
                }
                continue;
            }

            <MudChat ChatPosition="@(message.IsUser ? ChatBubblePosition.End : ChatBubblePosition.Start)">
                @if (message.IsUser)
                {
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Style="align-self: flex-start; margin-top: 4px;">
                        @if (!string.IsNullOrEmpty(_userPicture))
                        {
                            <MudImage Src="@_userPicture" />
                        }
                        else
                        {
                            @(_userName?[0] ?? 'U')
                        }
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                    </MudAvatar>
                }
                <MudChatBubble Color="@(message.IsUser ? Color.Primary : Color.Surface)"
                               Variant="Variant.Filled" >
                    @if (message.IsUser)
                    {
                        <div style="white-space: pre-wrap;">@message.Text</div>
                    }
                    else
                    {
                        <MarkdownRenderer Markdown="@message.Text" />
                    }
                </MudChatBubble>
            </MudChat>

            @if (message.SuggestedActions != null && message.SuggestedActions.Count > 0)
            {
                <div class="d-flex flex-wrap gap-1 mt-1 mb-2 ml-12">
                    @foreach (var action in message.SuggestedActions)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => HandleSuggestedAction(action.Text))">
                            @action.Text
                        </MudButton>
                    }
                </div>
            }
        }

        @if (ChatService.IsLoading && !ChatService.Messages.Any(m => m.IsProcessing))
        {
            <MudChat ChatPosition="ChatBubblePosition.Start">
                <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Style="align-self: flex-start; margin-top: 4px;">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                </MudAvatar>
                <MudChatBubble>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" Style="width: 120px;" />
                </MudChatBubble>
            </MudChat>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_errorMessage</MudAlert>
        }

        @if (_showScrollButton)
        {
            <div style="position: sticky; bottom: 10px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; z-index: 10;">
                <MudFab Color="Color.Primary" 
                        StartIcon="@Icons.Material.Filled.ArrowDownward" 
                        Size="Size.Small" 
                        OnClick="ScrollToBottom"
                        Style="pointer-events: auto;" />
            </div>
        }
    </div>

    <!-- Bottom Input Area -->
    <div class="pa-4 mt-auto @(IsMobile ? "mb-16" : "")">
        <MudPaper Elevation="0" Class="rounded-xl pa-2 chat-input-container border border-solid mud-border-lines-default" Style="background-color: var(--mud-palette-surface);">
            <div class="px-2 pt-1">
                <MudTextField @ref="_inputField"
                              @bind-Value="_currentInput"
                              Placeholder="Ask anything"
                              Variant="Variant.Text"
                              Underline="false"
                              Lines="1"
                              AutoGrow="true"
                              MaxLines="8"
                              OnKeyDown="@HandleKeyDown"
                              Immediate="true"
                              autocomplete="off"
                              Disabled="@ChatService.IsLoading"
                              Class="mt-0"
                              Style="font-size: 0.95rem;" />
            </div>

            <div class="d-flex align-center justify-space-between mt-1 px-1">
                <div class="d-flex align-center gap-1">
                    <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFiles" Hidden="true">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" Class="action-icon" />
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudIconButton Icon="@Icons.Material.Outlined.Public" Size="Size.Small" Class="action-icon" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" Class="action-icon" />
                    <MudIconButton Icon="@Icons.Material.Outlined.MoreHoriz" Size="Size.Small" Class="action-icon" />
                </div>

                <div class="send-button-wrapper">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                   OnClick="@SendMessage"
                                   Class="send-button-square"
                                   Size="Size.Small"
                                   Disabled="@ChatService.IsLoading" />
                </div>
            </div>
        </MudPaper>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="d-block mt-2" Style="font-size: 0.75rem;">
            AI can make mistakes. Please double-check responses.
        </MudText>
    </div>
    }
</div>

<style>
    .chat-input-container {
        transition: box-shadow 0.2s;
    }

    .chat-input-container:focus-within {
        box-shadow: 0 0 0 1px var(--mud-palette-primary) !important;
    }

    .action-icon {
        color: var(--mud-palette-text-secondary);
        border: 1px solid var(--mud-palette-divider);
        padding: 6px !important;
    }

    .send-button-square {
        background-color: var(--mud-palette-text-primary) !important;
        color: var(--mud-palette-surface) !important;
        border-radius: 8px !important;
        padding: 6px !important;
    }

    .send-button-square:hover {
        opacity: 0.9;
    }

    .send-button-square:disabled {
        background-color: var(--mud-palette-action-disabled-background) !important;
    }

    .scroll-container::-webkit-scrollbar {
        width: 6px;
    }

    .scroll-container::-webkit-scrollbar-thumb {
        background-color: var(--mud-palette-divider);
        border-radius: 10px;
    }

</style>

@code {
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }

    private MudTextField<string>? _inputField;

    private string _currentInput = "";
    private string? _userPicture;
    private string? _userName;
    private string? _errorMessage;
    private bool _isAiAvailable = false;
    private bool _isCheckingAvailability = true;
    private bool _showScrollButton = false;
    private bool _shouldScrollToBottom = false;

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnChange += HandleChatChange;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userPicture = user.FindFirst("picture")?.Value;
            _userName = user.Identity.Name;
        }

        // Check if AI service is available by attempting to initiate a session
        await CheckAiAvailability();

        // Connect to SignalR for real-time thinking steps
        await ChatService.ConnectSignalRAsync();
    }

    private void HandleChatChange()
    {
        _shouldScrollToBottom = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await ScrollToBottom();
        }
    }

    private async Task HandleScroll()
    {
        var atBottom = await JSRuntime.InvokeAsync<bool>("chatHelpers.isAtBottom", "chat-container");
        if (_showScrollButton == atBottom)
        {
            _showScrollButton = !atBottom;
            StateHasChanged();
        }
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("chatHelpers.scrollToBottom", "chat-container");
        _showScrollButton = false;
        StateHasChanged();
    }

    private async Task CheckAiAvailability()
    {
        try
        {
            var response = await Http.GetAsync("api/aiprocessing/health");
            if (response.IsSuccessStatusCode)
            {
                var healthData = await response.Content.ReadFromJsonAsync<AiHealthResponse>();
                _isAiAvailable = healthData?.CanInitiateSession ?? false;
            }
            else
            {
                _isAiAvailable = false;
            }
        }
        catch
        {
            _isAiAvailable = false;
        }
        finally
        {
            _isCheckingAvailability = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class AiHealthResponse
    {
        public string Status { get; set; } = string.Empty;
        public string Service { get; set; } = string.Empty;
        public Guid? SessionId { get; set; }
        public bool CanInitiateSession { get; set; }
        public string? Message { get; set; }
    }

    private static readonly Dictionary<string, string> PageNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["/"] = "Dashboard",
        ["/sales/customers"] = "Customers",
        ["/sales/customers/new"] = "Create New Customer",
        ["/sales/orders"] = "Orders",
        ["/sales/quotations"] = "Quotations",
        ["/sales/pricing-ai"] = "AI Pricing",
        ["/finance/invoices"] = "Invoices",
        ["/finance/payments"] = "Payments",
        ["/finance/receipts"] = "Receipts",
        ["/finance/ledger"] = "Ledger",
        ["/mfg/materials"] = "Materials",
        ["/mfg/suppliers"] = "Suppliers",
        ["/mfg/procurement"] = "Procurement",
        ["/mfg/models"] = "3D Models",
        ["/hr/employees"] = "Employees",
        ["/hr/directory"] = "Directory",
        ["/hr/onboarding"] = "Onboarding",
        ["/hr/recruitment"] = "Recruitment",
        ["/hr/compensation"] = "Compensation",
        ["/hr/performance"] = "Performance",
        ["/hr/compliance"] = "Compliance",
        ["/hr/time-off"] = "Time Off",
        ["/admin/iam"] = "Identity & Access",
        ["/admin/reference-data"] = "Reference Data",
        ["/admin/notifications"] = "Notification Templates",
        ["/admin/system-health"] = "System Health",
        ["/permissions"] = "Permissions",
    };

    private string GetPageName()
    {
        var path = ChatService.CurrentContext.TrimEnd('/');
        if (string.IsNullOrEmpty(path)) path = "/";

        // Exact match
        if (PageNames.TryGetValue(path, out var name))
            return name;

        // Customer detail page: /sales/customers/{guid}
        if (path.StartsWith("/sales/customers/", StringComparison.OrdinalIgnoreCase) && path.Length > 18)
            return "Customer Details";

        // Fallback: humanize the last segment
        var lastSegment = path.Split('/').LastOrDefault() ?? "Home";
        return char.ToUpper(lastSegment[0]) + lastSegment[1..].Replace("-", " ");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Send on Enter, but allow Shift+Enter for new lines
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        var input = _currentInput;
        if (string.IsNullOrWhiteSpace(input) || ChatService.IsLoading) return;

        _currentInput = "";
        _errorMessage = null;
        ChatService.AddMessage(input, true);

        try
        {
            var response = await ChatService.SendMessageAsync(input);
            if (response != null)
            {
                // When using streaming, ChatService already updates the placeholder message
                // Only add a new message when NOT streaming (no placeholder exists)
                var existingPlaceholder = ChatService.Messages.LastOrDefault(m => !m.IsUser && !m.IsProcessing && m.Text == response.Content);
                if (existingPlaceholder == null)
                {
                    // No streaming placeholder was used — add normally
                    if (!ChatService.Messages.Any(m => !m.IsUser && m.Text == response.Content))
                    {
                        ChatService.AddMessage(response.Content, false, response.SuggestedActions);
                    }
                }
            }
            else
            {
                _errorMessage = "Failed to get a response. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Something went wrong. Please try again.";
        }

        await InvokeAsync(StateHasChanged);
        if (_inputField != null)
        {
            await _inputField.FocusAsync();
        }
    }

    private async Task HandleSuggestedAction(string actionText)
    {
        _currentInput = actionText;
        await SendMessage();
    }

    private void UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            ChatService.AddMessage($"[Attachment: {file.Name} ({file.Size} bytes)]", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ChatService.OnChange -= HandleChatChange;
        await ChatService.DisposeAsync();
    }
}
