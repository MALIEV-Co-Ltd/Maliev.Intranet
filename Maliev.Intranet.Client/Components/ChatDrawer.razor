@using MudBlazor
@using Maliev.Intranet.Shared

<MudDrawerContainer>
    <MudStack Class="pa-4 flex-grow-1" Style="height: calc(100vh - 120px); overflow-y: auto;">
        <MudText Typo="Typo.h6">Maliev Assistant</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Context: @Context</MudText>
        
        <MudDivider Class="my-2" />

        <div class="flex-grow-1">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Hello! I'm your Maliev AI assistant. I see you are currently viewing the <b>@GetPageName()</b> page. How can I help you?
            </MudAlert>
            
            @foreach (var message in _messages)
            {
                <div class="@(message.IsUser ? "d-flex justify-end" : "d-flex justify-start") mb-2">
                    <MudPaper Class="pa-3" 
                              Elevation="1" 
                              Style="@(message.IsUser ? "background-color: var(--mud-palette-primary-lighten); color: white; max-width: 80%;" : "max-width: 80%;")">
                        <MudText Typo="Typo.body2">@message.Text</MudText>
                    </MudPaper>
                </div>
            }
        </div>
    </MudStack>

    <MudPaper Elevation="0" Class="pa-4 mt-auto">
        <MudTextField @bind-Value="_currentInput" 
                      Placeholder="Ask a question..." 
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense"
                      Adornment="Adornment.End" 
                      AdornmentIcon="@Icons.Material.Filled.Send" 
                      OnKeyDown="@HandleKeyDown" />
    </MudPaper>
</MudDrawerContainer>

@code {
    [Parameter] public string Context { get; set; } = "/";

    private string _currentInput = "";
    private List<ChatMessage> _messages = new();

    private string GetPageName()
    {
        return Context.Trim('/').Split('/').LastOrDefault() ?? "Home";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentInput)) return;

        _messages.Add(new ChatMessage { Text = _currentInput, IsUser = true });
        var input = _currentInput;
        _currentInput = "";

        // Mock response
        _ = Task.Delay(500).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                _messages.Add(new ChatMessage 
                { 
                    Text = $"I'm a mockup assistant. You asked about '{input}' while on the {GetPageName()} page. Integration with Maliev.Chatbot is coming soon!", 
                    IsUser = false 
                });
                StateHasChanged();
            });
        });
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
    }
}
