@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatService ChatService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<section class="sidekick-root" aria-label="AI assistant conversation">
    <header class="sidekick-header">
        <div class="sidekick-header-title">
            <MudMenu AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft"
                     Dense="true"
                     Class="sidekick-title-menu"
                     PopoverClass="sidekick-title-popover">
                <ActivatorContent>
                    <button type="button"
                            class="sidekick-title-button"
                            aria-label="Conversation menu"
                            @onclick="context.ToggleAsync">
                        <span>@GetConversationTitle()</span>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Outlined.AddComment" OnClick="@StartNewConversation">
                        New conversation
                    </MudMenuItem>
                    @if (ChatService.Conversations.Count > 0)
                    {
                        <MudDivider />
                        @foreach (var conversation in ChatService.Conversations)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.ChatBubbleOutline"
                                         Class="@GetConversationMenuItemClass(conversation)"
                                         OnClick="@(() => SelectConversation(conversation.SessionId))">
                                <div class="sidekick-history-entry">
                                    <span class="sidekick-history-title">@GetConversationPreview(conversation)</span>
                                    <span class="sidekick-history-meta">@FormatConversationTime(conversation.LastActivityAt)</span>
                                </div>
                            </MudMenuItem>
                        }
                        <MudDivider />
                    }
                    <MudMenuItem Icon="@Icons.Material.Outlined.TravelExplore" OnClick="@(() => HandleSuggestedAction(GetSummarizePrompt()))">
                        Summarize current page
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.HealthAndSafety" OnClick="@(() => HandleSuggestedAction(GetSystemHealthPrompt()))">
                        Check system health
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
            <span class="sidekick-context-chip">@GetPageName()</span>
            <div class="sidekick-workspace-pings" aria-label="Assistant workspace updates">
                @RenderWorkspacePing("Artifacts", Icons.Material.Outlined.Inventory2, "No new artifacts")
                @RenderWorkspacePing("Summary", Icons.Material.Outlined.Subject, "Project summary is current")
            </div>
        </div>

        <div class="sidekick-header-actions">
            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                           Size="Size.Small"
                           Class="sidekick-icon-button"
                           aria-label="Start new conversation"
                           OnClick="@StartNewConversation" />
            @if (!IsMobile)
            {
                <MudIconButton Icon="@(IsExpanded ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                               Size="Size.Small"
                               Class="sidekick-icon-button"
                               aria-label="Toggle assistant width"
                               OnClick="@(() => IsExpandedChanged.InvokeAsync(!IsExpanded))" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Class="sidekick-icon-button"
                           aria-label="Close assistant"
                           OnClick="@(() => OnClose.InvokeAsync())" />
        </div>
    </header>

    @if (_isCheckingAvailability)
    {
        <div class="sidekick-state" aria-live="polite">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!_isAiAvailable)
    {
        <div class="sidekick-state">
            <MudAlert Severity="Severity.Warning" Dense="false" Class="sidekick-unavailable">
                <MudText>AI Assistant is currently unavailable. Unable to establish a connection with the chatbot service.</MudText>
            </MudAlert>
        </div>
    }
    else
    {
        <div id="chat-container" class="sidekick-stream scroll-container" @onscroll="HandleScroll">
            <div class="sidekick-stream-inner">
                @if (ChatService.Messages.Count == 0 && string.IsNullOrEmpty(_errorMessage))
                {
                    <section class="sidekick-empty-state" aria-label="Assistant welcome">
                        <div class="sidekick-mascot" aria-hidden="true">
                            <img src="images/chatbot-avatar.webp" alt="" aria-hidden="true" class="sidekick-chatbot-avatar" />
                        </div>
                        <MudText Typo="Typo.h6" Class="sidekick-empty-greeting">@GetGreeting(), @GetDisplayName()</MudText>
                        <MudText Typo="Typo.h5" Class="sidekick-empty-title">How can I help?</MudText>
                        <button type="button" class="sidekick-suggestion-pill" @onclick="@(() => HandleSuggestedAction(GetWhatsNewPrompt()))">
                            <span class="sidekick-suggestion-dot" aria-hidden="true"></span>
                            What's new?
                        </button>
                    </section>
                }

                @foreach (var message in ChatService.Messages)
                {
                    @if (!message.IsUser && message.ThinkingSteps.Count > 0)
                    {
                        <ThinkingChain Steps="message.ThinkingSteps" IsProcessing="message.IsProcessing" />
                    }

                    @if (message.IsProcessing && string.IsNullOrEmpty(message.Text))
                    {
                        @if (message.ThinkingSteps.Count == 0)
                        {
                            <div class="sidekick-processing-row" aria-live="polite">
                                <MudIcon Icon="@Icons.Material.Outlined.ManageSearch" Size="Size.Small" />
                                <span>Working on it</span>
                                <span class="sidekick-loading-dot" aria-hidden="true"></span>
                            </div>
                        }
                        continue;
                    }

                    <article class="sidekick-message-row @(message.IsUser ? "sidekick-message-row-user" : "sidekick-message-row-assistant")">
                        @if (!message.IsUser)
                        {
                            <div class="sidekick-assistant-mark" aria-hidden="true">
                                <img src="images/chatbot-avatar.webp" alt="" aria-hidden="true" class="sidekick-chatbot-avatar" />
                            </div>
                        }

                        <div class="sidekick-message-bubble @(message.IsUser ? "sidekick-user-bubble" : "sidekick-assistant-bubble")">
                            @if (message.IsUser)
                            {
                                <div class="sidekick-user-text">@message.Text</div>
                            }
                            else
                            {
                                <MarkdownRenderer Markdown="@message.Text" />
                            }

                            @if (!message.IsUser)
                            {
                                <div class="sidekick-message-actions" aria-label="Assistant response actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                                   Size="Size.Small"
                                                   Class="sidekick-inline-action"
                                                   aria-label="Copy response"
                                                   OnClick="@(() => CopyMessageAsync(message.Text))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.ThumbUpOffAlt"
                                                   Size="Size.Small"
                                                   Class="sidekick-inline-action"
                                                   Color="@GetFeedbackColor(message, "up")"
                                                   aria-label="Mark response helpful"
                                                   OnClick="@(() => SetFeedback(message, "up"))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.ThumbDownOffAlt"
                                                   Size="Size.Small"
                                                   Class="sidekick-inline-action"
                                                   Color="@GetFeedbackColor(message, "down")"
                                                   aria-label="Mark response not helpful"
                                                   OnClick="@(() => SetFeedback(message, "down"))" />
                                </div>
                            }
                        </div>
                    </article>

                    @if (message.SuggestedActions != null && message.SuggestedActions.Count > 0)
                    {
                        <div class="sidekick-suggested-actions">
                            @foreach (var action in message.SuggestedActions)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           Class="sidekick-suggested-action"
                                           OnClick="@(() => HandleSuggestedAction(action))">
                                    @action.Text
                                </MudButton>
                            }
                        </div>
                    }
                }

                @if (ChatService.IsLoading && !ChatService.Messages.Any(m => m.IsProcessing))
                {
                    <div class="sidekick-processing-row" aria-live="polite">
                        <MudIcon Icon="@Icons.Material.Outlined.ManageSearch" Size="Size.Small" />
                        <span>Working on it</span>
                        <span class="sidekick-loading-dot" aria-hidden="true"></span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="sidekick-error">@_errorMessage</MudAlert>
                }

                @if (_showScrollButton)
                {
                    <div class="sidekick-scroll-jump">
                        <MudFab Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.ArrowDownward"
                                Size="Size.Small"
                                OnClick="ScrollToBottom" />
                    </div>
                }
            </div>
        </div>

        <footer class="sidekick-composer-shell @(IsMobile ? "sidekick-composer-mobile" : "")">
            <MudPaper Elevation="0" Class="sidekick-composer">
                <div class="sidekick-composer-avatar" aria-hidden="true">
                    <img src="images/chatbot-avatar.webp" alt="" aria-hidden="true" class="sidekick-chatbot-avatar" />
                </div>

                <textarea @ref="_inputElement"
                          class="sidekick-composer-input"
                          value="@_currentInput"
                          placeholder="Ask anything..."
                          rows="1"
                          autocomplete="off"
                          disabled="@ChatService.IsLoading"
                          @oninput="HandleComposerInput"
                          @onkeydown="HandleKeyDown"></textarea>

                <div class="sidekick-composer-actions">
                    <MudMenu Icon="@Icons.Material.Outlined.Add"
                             Label="Assistant actions"
                             Size="Size.Small"
                             Dense="true"
                             AnchorOrigin="Origin.TopRight"
                             TransformOrigin="Origin.BottomRight"
                             Class="sidekick-composer-menu"
                             PopoverClass="sidekick-composer-popover">
                        <ChildContent>
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFiles" Hidden="true">
                                <CustomContent>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.UploadFile" OnClick="@context.OpenFilePickerAsync">
                                        Upload from device
                                    </MudMenuItem>
                                </CustomContent>
                            </MudFileUpload>
                            <MudMenuItem Icon="@Icons.Material.Outlined.TravelExplore" OnClick="@(() => HandleSuggestedAction(GetSummarizePrompt()))">
                                Summarize current page
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Outlined.AutoAwesome" OnClick="@(() => HandleSuggestedAction(GetNextStepsPrompt()))">
                                Ask for next steps
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudIconButton Icon="@Icons.Material.Outlined.GraphicEq"
                                   Size="Size.Small"
                                   Class="sidekick-icon-button"
                                   aria-label="Voice input is not available"
                                   Disabled="true" />

                    <MudIconButton Icon="@(ChatService.IsLoading ? Icons.Material.Filled.StopCircle : Icons.Material.Filled.ArrowUpward)"
                                   OnClick="@SendMessage"
                                   Class="sidekick-send-button"
                                   Size="Size.Small"
                                   aria-label="Send message"
                                   Disabled="@(ChatService.IsLoading || string.IsNullOrWhiteSpace(_currentInput))" />
                </div>
            </MudPaper>
        </footer>
    }
</section>

@code {
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly Dictionary<ChatMessage, string> _feedback = new();
    private ElementReference _inputElement;

    private string _currentInput = "";
    private string? _userName;
    private string? _errorMessage;
    private bool _isAiAvailable = false;
    private bool _isCheckingAvailability = true;
    private bool _showScrollButton = false;
    private bool _shouldScrollToBottom = false;

    protected override async Task OnInitializedAsync()
    {
        ChatService.OnChange += HandleChatChange;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.Identity.Name;
        }

        await CheckAiAvailability();
        if (_isAiAvailable)
        {
            await ChatService.LoadConversationsAsync();
        }

        await ChatService.ConnectSignalRAsync();
    }

    private void HandleChatChange()
    {
        _shouldScrollToBottom = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await ScrollToBottom();
        }
    }

    private async Task HandleScroll()
    {
        var atBottom = await JSRuntime.InvokeAsync<bool>("chatHelpers.isAtBottom", "chat-container");
        if (_showScrollButton == atBottom)
        {
            _showScrollButton = !atBottom;
            StateHasChanged();
        }
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("chatHelpers.scrollToBottom", "chat-container");
        _showScrollButton = false;
        StateHasChanged();
    }

    private async Task CheckAiAvailability()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/aiprocessing/health");
            if (response.IsSuccessStatusCode)
            {
                var healthData = await response.Content.ReadFromJsonAsync<AiHealthResponse>();
                _isAiAvailable = healthData?.CanInitiateSession ?? false;
            }
            else
            {
                _isAiAvailable = false;
            }
        }
        catch
        {
            _isAiAvailable = false;
        }
        finally
        {
            _isCheckingAvailability = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class AiHealthResponse
    {
        public string Status { get; set; } = string.Empty;
        public string Service { get; set; } = string.Empty;
        public Guid? SessionId { get; set; }
        public bool CanInitiateSession { get; set; }
        public string? Message { get; set; }
    }

    private static readonly Dictionary<string, string> PageNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["/"] = "Dashboard",
        ["/sales/customers"] = "Customers",
        ["/sales/customers/new"] = "Create New Customer",
        ["/sales/orders"] = "Orders",
        ["/sales/quotations"] = "Quotations",
        ["/sales/pricing-ai"] = "AI Pricing",
        ["/finance/invoices"] = "Invoices",
        ["/finance/payments"] = "Payments",
        ["/finance/receipts"] = "Receipts",
        ["/finance/ledger"] = "Ledger",
        ["/mfg/materials"] = "Materials",
        ["/mfg/suppliers"] = "Suppliers",
        ["/mfg/procurement"] = "Procurement",
        ["/mfg/models"] = "3D Models",
        ["/hr/employees"] = "Employees",
        ["/hr/directory"] = "Directory",
        ["/hr/onboarding"] = "Onboarding",
        ["/hr/recruitment"] = "Recruitment",
        ["/hr/compensation"] = "Compensation",
        ["/hr/performance"] = "Performance",
        ["/hr/compliance"] = "Compliance",
        ["/hr/time-off"] = "Time Off",
        ["/admin/iam"] = "Identity & Access",
        ["/admin/reference-data"] = "Reference Data",
        ["/admin/notifications"] = "Notification Templates",
        ["/admin/system-health"] = "System Health",
        ["/permissions"] = "Permissions",
    };

    private string GetPageName()
    {
        var path = ChatService.CurrentContext.TrimEnd('/');
        if (string.IsNullOrEmpty(path))
        {
            path = "/";
        }

        if (PageNames.TryGetValue(path, out var name))
        {
            return name;
        }

        if (path.StartsWith("/sales/customers/", StringComparison.OrdinalIgnoreCase) && path.Length > 18)
        {
            return "Customer Details";
        }

        var lastSegment = path.Split('/').LastOrDefault() ?? "Home";
        return char.ToUpper(lastSegment[0]) + lastSegment[1..].Replace("-", " ");
    }

    private string GetConversationTitle()
    {
        var firstUserMessage = ChatService.Messages.FirstOrDefault(m => m.IsUser && !string.IsNullOrWhiteSpace(m.Text));
        if (firstUserMessage is null)
        {
            return ChatService.ActiveConversation is { } activeConversation
                ? GetConversationPreview(activeConversation)
                : "New conversation";
        }

        var title = firstUserMessage.Text.Trim();
        return title.Length > 48 ? title[..45] + "..." : title;
    }

    private string GetConversationPreview(BffChatConversationSummary conversation)
    {
        var preview = conversation.Preview;
        if (string.IsNullOrWhiteSpace(preview))
        {
            preview = $"Conversation from {FormatConversationTime(conversation.LastActivityAt)}";
        }

        preview = preview.Trim();
        return preview.Length > 48 ? preview[..45] + "..." : preview;
    }

    private static string FormatConversationTime(DateTimeOffset timestamp)
    {
        var local = timestamp.ToLocalTime();
        var now = DateTimeOffset.Now;

        if (local.Date == now.Date)
        {
            return local.ToString("h:mm tt", System.Globalization.CultureInfo.CurrentCulture);
        }

        if (local.Date == now.Date.AddDays(-1))
        {
            return "Yesterday";
        }

        return local.ToString("MMM d", System.Globalization.CultureInfo.CurrentCulture);
    }

    private RenderFragment RenderWorkspacePing(string target, string icon, string fallbackTitle) => builder =>
    {
        var ping = GetLatestUiPing(target);
        var sequence = 0;

        builder.OpenComponent<MudTooltip>(sequence++);
        builder.AddAttribute(sequence++, "Placement", Placement.Bottom);
        builder.AddAttribute(sequence++, "Arrow", true);
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(child =>
        {
            child.OpenElement(0, "button");
            child.AddAttribute(1, "type", "button");
            child.AddAttribute(2, "class", GetWorkspacePingClass(ping));
            child.AddAttribute(3, "aria-label", GetWorkspacePingTitle(target, ping, fallbackTitle));
            child.OpenComponent<MudIcon>(4);
            child.AddAttribute(5, "Icon", icon);
            child.AddAttribute(6, "Size", Size.Small);
            child.CloseComponent();
            child.OpenElement(7, "span");
            child.AddContent(8, target);
            child.CloseElement();
            if (ping?.Count > 0)
            {
                child.OpenElement(9, "span");
                child.AddAttribute(10, "class", "sidekick-workspace-badge");
                child.AddContent(11, ping.Count.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
                child.CloseElement();
            }
            child.CloseElement();
        }));
        builder.AddAttribute(sequence++, "TooltipContent", (RenderFragment)(content =>
        {
            content.OpenElement(0, "div");
            content.AddAttribute(1, "class", "sidekick-ping-tooltip");
            content.OpenComponent<MudIcon>(2);
            content.AddAttribute(3, "Icon", GetWorkspacePingIcon(target, ping, icon));
            content.AddAttribute(4, "Size", Size.Small);
            content.CloseComponent();
            content.OpenElement(5, "div");
            content.OpenComponent<MudText>(6);
            content.AddAttribute(7, "Typo", Typo.subtitle2);
            content.AddAttribute(8, "Class", "sidekick-ping-tooltip-title");
            content.AddAttribute(9, "ChildContent", (RenderFragment)(title =>
            {
                title.AddContent(0, GetWorkspacePingTitle(target, ping, fallbackTitle));
            }));
            content.CloseComponent();
            content.OpenComponent<MudText>(10);
            content.AddAttribute(11, "Typo", Typo.body2);
            content.AddAttribute(12, "Class", "sidekick-ping-tooltip-detail");
            content.AddAttribute(13, "ChildContent", (RenderFragment)(detail =>
            {
                detail.AddContent(0, GetWorkspacePingDetail(target, ping));
            }));
            content.CloseComponent();
            content.CloseElement();
            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private BffChatUiPing? GetLatestUiPing(string target)
    {
        return ChatService.Messages
            .SelectMany(message => message.UiPings)
            .Where(ping => ping.Target.Equals(target, StringComparison.OrdinalIgnoreCase))
            .OrderBy(ping => ping.Timestamp)
            .LastOrDefault();
    }

    private static string GetWorkspacePingClass(BffChatUiPing? ping)
    {
        return ping is null
            ? "sidekick-workspace-chip"
            : "sidekick-workspace-chip sidekick-workspace-chip-active";
    }

    private static string GetWorkspacePingIcon(string target, BffChatUiPing? ping, string fallbackIcon)
    {
        if (!string.IsNullOrWhiteSpace(ping?.Icon))
        {
            return ping.Icon;
        }

        return target.Equals("Summary", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Outlined.AutoStories
            : fallbackIcon;
    }

    private static string GetWorkspacePingTitle(string target, BffChatUiPing? ping, string fallbackTitle)
    {
        if (!string.IsNullOrWhiteSpace(ping?.Title))
        {
            return ping.Title;
        }

        if (ping?.Count > 0 && target.Equals("Artifacts", StringComparison.OrdinalIgnoreCase))
        {
            var noun = ping.Count.Value == 1 ? "artifact" : "artifacts";
            return $"{ping.Count.Value} {noun} added";
        }

        if (ping is not null && target.Equals("Summary", StringComparison.OrdinalIgnoreCase))
        {
            return "Project summary updated";
        }

        return fallbackTitle;
    }

    private static string GetWorkspacePingDetail(string target, BffChatUiPing? ping)
    {
        if (!string.IsNullOrWhiteSpace(ping?.Detail))
        {
            return ping.Detail;
        }

        if (ping?.Count > 0 && target.Equals("Artifacts", StringComparison.OrdinalIgnoreCase))
        {
            var noun = ping.Count.Value == 1 ? "artifact" : "artifacts";
            return $"Agent has added {ping.Count.Value} {noun}.";
        }

        if (ping is not null && target.Equals("Artifacts", StringComparison.OrdinalIgnoreCase))
        {
            return "New artifacts are ready to review.";
        }

        if (ping is not null && target.Equals("Summary", StringComparison.OrdinalIgnoreCase))
        {
            return "The project summary has changed since you last reviewed it.";
        }

        return "No recent assistant updates for this section.";
    }

    private string GetConversationMenuItemClass(BffChatConversationSummary conversation)
    {
        return ChatService.SessionId == conversation.SessionId
            ? "sidekick-history-menu-item sidekick-history-menu-item-active"
            : "sidekick-history-menu-item";
    }

    private string GetSummarizePrompt() => $"Summarize {GetPageName()}";

    private static string GetSystemHealthPrompt() => "Check current system health";

    private static string GetWhatsNewPrompt() => "What's new?";

    private static string GetNextStepsPrompt() => "What should I focus on next?";

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12)
        {
            return "Good morning";
        }

        return hour < 18 ? "Good afternoon" : "Good evening";
    }

    private string GetDisplayName()
    {
        if (string.IsNullOrWhiteSpace(_userName))
        {
            return "there";
        }

        var name = _userName.Trim();
        if (name.Contains('@', StringComparison.Ordinal))
        {
            name = name[..name.IndexOf('@', StringComparison.Ordinal)];
        }

        var firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return string.IsNullOrWhiteSpace(firstName) ? "there" : firstName;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void HandleComposerInput(ChangeEventArgs e)
    {
        _currentInput = e.Value?.ToString() ?? string.Empty;
    }

    private async Task SendMessage()
    {
        var input = _currentInput;
        if (string.IsNullOrWhiteSpace(input) || ChatService.IsLoading)
        {
            return;
        }

        _currentInput = "";
        _errorMessage = null;
        ChatService.AddMessage(input, true);

        try
        {
            var response = await ChatService.SendMessageAsync(input);
            if (response != null)
            {
                var existingPlaceholder = ChatService.Messages.LastOrDefault(m => !m.IsUser && !m.IsProcessing && m.Text == response.Content);
                if (existingPlaceholder == null && !ChatService.Messages.Any(m => !m.IsUser && m.Text == response.Content))
                {
                    ChatService.AddMessage(response.Content, false, response.SuggestedActions, response.UiPings);
                }
            }
            else
            {
                _errorMessage = "Failed to get a response. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Something went wrong. Please try again.";
        }

        await InvokeAsync(StateHasChanged);
        await _inputElement.FocusAsync();
    }

    private async Task HandleSuggestedAction(string actionText)
    {
        _currentInput = actionText;
        await SendMessage();
    }

    private async Task HandleSuggestedAction(BffSuggestedAction action)
    {
        await HandleSuggestedAction(BuildSuggestedActionPrompt(action));
    }

    private static string BuildSuggestedActionPrompt(BffSuggestedAction action)
    {
        if (string.IsNullOrWhiteSpace(action.Data))
        {
            return action.Text;
        }

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(action.Data);
            var root = document.RootElement;

            if (root.TryGetProperty("quotationId", out var quotationId) &&
                quotationId.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var value = quotationId.GetString();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    if (action.Action.Equals("SendReminder", StringComparison.OrdinalIgnoreCase) ||
                        action.Text.Contains("reminder", StringComparison.OrdinalIgnoreCase))
                    {
                        return $"Send reminder for quotation {value}";
                    }

                    return $"{action.Text} for quotation {value}";
                }
            }

            if (root.TryGetProperty("orderId", out var orderId) &&
                orderId.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var value = orderId.GetString();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    return $"{action.Text} for order {value}";
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Keep suggested actions usable even if a service returns malformed action data.
        }

        return action.Text;
    }

    private void StartNewConversation()
    {
        _feedback.Clear();
        _errorMessage = null;
        _currentInput = "";
        ChatService.StartNewConversation();
    }

    private async Task SelectConversation(Guid sessionId)
    {
        _feedback.Clear();
        _errorMessage = null;
        _currentInput = "";
        await ChatService.SelectConversationAsync(sessionId);
    }

    private async Task CopyMessageAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // Clipboard access can be blocked outside a user gesture.
        }
    }

    private void SetFeedback(ChatMessage message, string value)
    {
        if (_feedback.TryGetValue(message, out var current) && current == value)
        {
            _feedback.Remove(message);
        }
        else
        {
            _feedback[message] = value;
        }
    }

    private Color GetFeedbackColor(ChatMessage message, string value)
    {
        return _feedback.TryGetValue(message, out var current) && current == value
            ? Color.Primary
            : Color.Default;
    }

    private void UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            ChatService.AddMessage($"[Attachment: {file.Name} ({file.Size} bytes)]", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ChatService.OnChange -= HandleChatChange;
        await ChatService.DisposeAsync();
    }
}
