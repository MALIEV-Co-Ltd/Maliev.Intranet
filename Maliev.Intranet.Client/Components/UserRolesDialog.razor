@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Helpers
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">@(User.DisplayName?[0].ToString().ToUpper() ?? "?")</MudAvatar>
                <div>
                    <MudText Typo="Typo.h6">@User.DisplayName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">@User.Email</MudText>
                </div>
            </MudStack>

            <MudDivider />

            <MudText Typo="Typo.subtitle1">Current Role Bindings</MudText>
            @if (_isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_bindings.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No roles currently assigned.</MudAlert>
            }
            else
            {
                <MudList T="RoleBindingDto">
                    @foreach (var binding in _bindings)
                    {
                        <MudListItem T="RoleBindingDto">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">@binding.RoleId</MudText>
                                    @if (!string.IsNullOrEmpty(binding.ResourcePath))
                                    {
                                        <MudText Typo="Typo.caption">Scope: @binding.ResourcePath</MudText>
                                    }
                                </MudStack>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RevokeRole(binding))" />
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }

            <MudDivider />

            <MudText Typo="Typo.subtitle1">Grant New Role</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudSelect T="string" Label="Select Role" @bind-Value="_selectedRoleId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    @foreach (var role in AvailableRoles)
                    {
                        <MudSelectItem Value="@role.RoleId">@role.RoleId</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GrantRole" Disabled="@(string.IsNullOrEmpty(_selectedRoleId) || _isProcessing)">
                    Grant
                </MudButton>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PrincipalSummaryDto User { get; set; } = default!;
    [Parameter] public List<RoleDto> AvailableRoles { get; set; } = new();

    private List<RoleBindingDto> _bindings = new();
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private string? _selectedRoleId;

    protected override async Task OnInitializedAsync()
    {
        await LoadBindings();
    }

    private async Task LoadBindings()
    {
        _isLoading = true;
        try
        {
            _bindings = await Http.GetFromJsonAsync<List<RoleBindingDto>>($"api/iam/users/{User.PrincipalId}/roles") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading bindings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GrantRole()
    {
        if (string.IsNullOrEmpty(_selectedRoleId)) return;

        _isProcessing = true;
        try
        {
            var request = new GrantRoleRequestDto { RoleId = _selectedRoleId };
            var response = await Http.PostAsJsonAsync($"api/iam/users/{User.PrincipalId}/roles", request);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Role {_selectedRoleId} granted successfully.", Severity.Success);
                _selectedRoleId = null;
                await LoadBindings();
            }
            else
            {
                var errorMessage = await ApiResponseHelper.GetErrorMessageAsync(response);
                Snackbar.Add($"Failed to grant role: {errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error granting role: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task RevokeRole(RoleBindingDto binding)
    {
        _isProcessing = true;
        try
        {
            var response = await Http.DeleteAsync($"api/iam/users/{User.PrincipalId}/roles/{binding.BindingId}");
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Role {binding.RoleId} revoked successfully.", Severity.Success);
                await LoadBindings();
            }
            else
            {
                var errorMessage = await ApiResponseHelper.GetErrorMessageAsync(response);
                Snackbar.Add($"Failed to revoke role: {errorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error revoking role: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void Close() => MudDialog.Close();
}
