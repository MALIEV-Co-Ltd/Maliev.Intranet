@using MudBlazor

<MudPaper Elevation="0" Class="pa-6 mb-6" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="4">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="flex-grow-1">
                <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 700; min-width: 3rem;">@SectionNumber</MudText>
                <MudStack Spacing="1" Class="flex-grow-1">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        @if (Icon != null)
                        {
                            <MudIcon Icon="@Icon" Size="Size.Small" Color="Color.Primary" />
                        }
                        <MudText Typo="Typo.h5" Style="font-weight: 600;">@Title</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity: 0.7;">@Description</MudText>
                </MudStack>
            </MudStack>
            @if (HeaderActions != null)
            {
                <div>
                    @HeaderActions
                </div>
            }
        </MudStack>
        
        <MudDivider />
        
        <div style="padding-left: 4rem;">
            @ChildContent
        </div>
    </MudStack>
</MudPaper>

<style>
    @@media (max-width: 960px) {
        .form-section-paper > div > div:last-child {
            padding-left: 0 !important;
        }
    }
</style>

@code {
    [Parameter] public string SectionNumber { get; set; } = "01";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
