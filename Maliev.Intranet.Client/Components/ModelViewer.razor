@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Services
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject LayoutService LayoutService
@inject ILogger<ModelViewer> Logger

<div class="model-viewer-container" style="position: relative; width: 100%; height: 100%; min-height: 200px; overflow: visible; contain: layout style;" @onclick="CloseAnalysisPanels">
    <canvas id="@_canvasId" style="width: 100%; height: 100%; touch-action: none; outline: none; display: block;"></canvas>

    @if (Model != null)
    {
        <div class="overlay-info" style="position: absolute; top: 12px; left: 12px; background: var(--mud-palette-overlay-dark); color: var(--mud-palette-white); padding: 12px; border-radius: var(--maliev-radius-sm); backdrop-filter: blur(4px); pointer-events: none;">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Model.FileName</MudText>
            @if (Model.GeometryAnalyzed)
            {
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Volume: @(Model.VolumeCm3?.ToString("F2") ?? "-") cm³</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Surface Area: @(Model.SurfaceAreaCm2?.ToString("F2") ?? "-") cm²</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Triangles: @(Model.TriangleCount?.ToString("N0") ?? "-")</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Manifold: @(Model.IsManifold == true ? "Yes" : "No")</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2" Style="display: block; font-style: italic;">Geometry Analysis Pending...</MudText>
            }
            @if (_activeAnalysisTool == "measure" && _lastMeasurement != null)
            {
                <MudText Typo="Typo.caption" Class="mt-2" Style="display: block; color: #ffd700;">@_lastMeasurement</MudText>
            }
        </div>
    }

    @* ── Analysis tools — top-right rail beside the axis gizmo ── *@
    <div class="vp-analysis-rail" @onclick:stopPropagation>
        <MudTooltip Text="Section View" Placement="Placement.Left" Arrow="false">
            <button class="@($"vp-cube-btn {(_sectionEnabled ? "vp-active" : "")}")"
                    @onclick="ToggleSectionAsync" type="button">
                <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" />
            </button>
        </MudTooltip>
        @foreach (var tool in _analysisTools)
        {
            <MudTooltip Text="@tool.Label" Placement="Placement.Left" Arrow="false">
                <button class="@($"vp-cube-btn {(_activeAnalysisTool == tool.Key ? "vp-active" : "")}")"
                        @onclick="@(() => SetAnalysisTool(tool.Key))" type="button">
                    <MudIcon Icon="@tool.Icon" Size="Size.Small" />
                </button>
            </MudTooltip>
        }
        @if (_activeAnalysisTool != null)
        {
            <MudTooltip Text="Clear Analysis Tool" Placement="Placement.Left" Arrow="false">
                <button class="vp-cube-btn" @onclick="ClearAnalysisTool" type="button">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </MudTooltip>
        }
    </div>

    @if (_sectionMenuOpen)
    {
        <MudPaper Elevation="16" Class="pa-3 vp-section-panel" @onclick:stopPropagation>
            <MudSwitch T="bool" Value="_sectionEnabled"
                       ValueChanged="@((bool v) => SetSectionEnabledAsync(v))"
                       Label="Enable section view"
                       Color="Color.Primary" Class="mb-2" />
            <div class="d-flex gap-1 mb-2">
                @foreach (var ax in new[] { "x", "y", "z" })
                {
                    <button class="@($"vp-cube-btn {(_sectionAxis == ax ? "vp-active" : "")}")"
                            @onclick='@(() => SetSectionAxisAsync(ax))' type="button"
                            style="width: 56px;">@ax.ToUpperInvariant()</button>
                }
            </div>
            <MudSlider T="double" Min="@SectionMin" Max="@SectionMax" Step="0.5"
                       Value="_sectionOffset"
                       ValueChanged="@((double v) => SetSectionOffsetAsync(v))">
                Offset: @_sectionOffset.ToString("F1") mm
            </MudSlider>
            <MudCheckBox T="bool" Value="_sectionInverted"
                         ValueChanged="@((bool v) => SetSectionInvertedAsync(v))"
                         Label="Invert" Color="Color.Primary" />
        </MudPaper>
    }

    @* ── CAD Toolbar — bottom-center, floating ── *@
    <div class="vp-toolbar-shell">
        <MudPaper Elevation="8" Class="d-flex align-center pa-1 vp-toolbar-paper">

            @* View presets *@
            @foreach (var v in _viewPresets)
            {
                <MudTooltip Text="@v.Label" Placement="Placement.Top" Arrow="false">
                    <button class="@($"vp-cube-btn {(_cameraPreset == v.Key ? "vp-active" : "")}")"
                            @onclick="@(() => SetCameraPreset(v.Key))" type="button">
                        @GetCubeIconSvg(v.Key, _cameraPreset == v.Key)
                    </button>
                </MudTooltip>
            }

            <div class="vp-divider" />

            @* Render modes *@
            <MudTooltip Text="Solid" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_renderMode == "solid" ? "vp-active" : "")}")"
                        @onclick='@(() => SetRenderModeAsync("solid"))' type="button">
                    @GetModeIconSvg("solid", _renderMode == "solid")
                </button>
            </MudTooltip>
            <MudTooltip Text="Wireframe" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_renderMode == "wireframe" ? "vp-active" : "")}")"
                        @onclick='@(() => SetRenderModeAsync("wireframe"))' type="button">
                    @GetModeIconSvg("wireframe", _renderMode == "wireframe")
                </button>
            </MudTooltip>
            <MudTooltip Text="Transparent" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_renderMode == "transparent" ? "vp-active" : "")}")"
                        @onclick='@(() => SetRenderModeAsync("transparent"))' type="button">
                    @GetModeIconSvg("transparent", _renderMode == "transparent")
                </button>
            </MudTooltip>

            <div class="vp-divider" />

            @* Projection mode *@
            <MudTooltip Text="Perspective" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_cameraProjection == "perspective" ? "vp-active" : "")}")"
                        @onclick='@(() => SetCameraProjectionAsync("perspective"))' type="button">
                    @GetModeIconSvg("perspective", _cameraProjection == "perspective")
                </button>
            </MudTooltip>
            <MudTooltip Text="Orthographic" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_cameraProjection == "orthographic" ? "vp-active" : "")}")"
                        @onclick='@(() => SetCameraProjectionAsync("orthographic"))' type="button">
                    @GetModeIconSvg("ortho", _cameraProjection == "orthographic")
                </button>
            </MudTooltip>

            <div class="vp-divider" />

            @* Toggle tools *@
            <MudTooltip Text="Edges" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_edgesEnabled ? "vp-active" : "")}")"
                        @onclick="ToggleEdgesAsync" type="button">
                    @GetModeIconSvg("edges", _edgesEnabled)
                </button>
            </MudTooltip>
            <MudTooltip Text="Bounding Box" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_bboxEnabled ? "vp-active" : "")}")"
                        @onclick="ToggleBoundingBoxAsync" type="button">
                    @GetModeIconSvg("bounds", _bboxEnabled)
                </button>
            </MudTooltip>
            <MudTooltip Text="Grid Floor" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn {(_gridEnabled ? "vp-active" : "")}")"
                        @onclick="ToggleGridAsync" type="button">
                    @GetModeIconSvg("grid", _gridEnabled)
                </button>
            </MudTooltip>

            <div class="vp-divider" />

            @* Rotate model *@
            <MudTooltip Text="Rotate 90°" Placement="Placement.Top" Arrow="false">
                <button class="@($"vp-cube-btn")"
                        @onclick='@(() => RotateModelAsync(90))' type="button">
                    <MudIcon Icon="@Icons.Material.Filled.RotateRight" Size="Size.Small" />
                </button>
            </MudTooltip>
            <MudTooltip Text="Reset View" Placement="Placement.Top" Arrow="false">
                <MudIconButton Icon="@Icons.Material.Filled.FlipCameraIos"
                               Class="vp-icon-btn"
                               Size="Size.Small" OnClick="ResetCamera" />
            </MudTooltip>

        </MudPaper>
    </div>

</div>

@code {
    [Parameter] public Model3DDto?                Model          { get; set; }
    [Parameter] public string?                    ViewerUrl      { get; set; }
    [Parameter] public string?                    FileExtension  { get; set; }
    /// <summary>Optional bounding-box dimensions in mm. Used when Model is null (e.g. PartDetailCard).</summary>
    [Parameter] public FileAnalysisDimensionsDto? KnownDimensions { get; set; }
    /// <summary>Invoked when the 3D model fails to load (e.g. 404, network error).</summary>
    [Parameter] public EventCallback<string>       OnLoadFailed  { get; set; }
    /// <summary>Invoked when a body is clicked in the multi-body viewer.</summary>
    [Parameter] public EventCallback<int?>        OnBodyPicked   { get; set; }
    /// <summary>Optional CNC turning axis overlay for the loaded model.</summary>
    [Parameter] public TurningAxisViewModel?      TurningAxis    { get; set; }
    /// <summary>Per-part persisted viewer visual settings.</summary>
    [Parameter] public PartViewerSettings         ViewerSettings { get; set; } = new();
    /// <summary>Raised when a persisted viewer setting changes.</summary>
    [Parameter] public EventCallback<PartViewerSettings> ViewerSettingsChanged { get; set; }

    /// <summary>Body metadata for multi-body CAD files.</summary>
    public record BodyViewModel(int Index, string Name, double? VolumeCm3, string? ColorHex);

    /// <summary>Detected CNC turning axis in model coordinates.</summary>
    public record TurningAxisViewModel(string PrimaryAxis, IReadOnlyList<double> AxisVector, IReadOnlyList<double> AxisPoint);

    private string _canvasId    = $"babylon-canvas-{Guid.NewGuid()}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<ModelViewer>? _dotNetRef;
    private string _renderMode        = "solid";
    private string _cameraPreset      = "iso";
    private string _cameraProjection  = "orthographic";
    private bool   _edgesEnabled;
    private bool   _bboxEnabled;
    private bool   _gridEnabled;
    private string? _lastViewerUrl;
    private string? _lastTurningAxisKey;
    private string? _activeAnalysisTool;  // "flippedTriangles" | "measure" | "thickness" | null
    private string? _lastMeasurement;     // Display last measurement result in overlay
    private string? _lastViewerSettingsKey;

    // ── Section view ─────────────────────────────────────────────────────────
    private bool   _sectionEnabled;
    private string _sectionAxis     = "x";
    private bool   _sectionInverted;
    private double _sectionOffset;
    private bool   _sectionMenuOpen;

    private double SectionMin => _sectionAxis switch
    {
        "x" => -(KnownDimensions?.X ?? Model?.BoundingBoxX ?? 100.0) / 2.0,
        "y" => -(KnownDimensions?.Y ?? Model?.BoundingBoxY ?? 100.0) / 2.0,
        "z" => -(KnownDimensions?.Z ?? Model?.BoundingBoxZ ?? 100.0) / 2.0,
        _   => -100.0,
    };

    private double SectionMax => _sectionAxis switch
    {
        "x" => (KnownDimensions?.X ?? Model?.BoundingBoxX ?? 100.0) / 2.0,
        "y" => (KnownDimensions?.Y ?? Model?.BoundingBoxY ?? 100.0) / 2.0,
        "z" => (KnownDimensions?.Z ?? Model?.BoundingBoxZ ?? 100.0) / 2.0,
        _   => 100.0,
    };

    private record ViewPreset(string Key, string Label);
    private record AnalysisTool(string Key, string Label, string Icon);

    private static readonly AnalysisTool[] _analysisTools =
    [
        new("flippedTriangles", "Flipped Triangles", Icons.Material.Filled.ChangeHistory),
        new("measure", "Measure", Icons.Material.Filled.Straighten),
        new("thickness", "Thickness Analysis", Icons.Material.Filled.Fullscreen),
    ];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        ApplyViewerSettings(ViewerSettings);
    }

    private void ApplyViewerSettings(PartViewerSettings settings)
    {
        var key = GetViewerSettingsKey(settings);
        if (string.Equals(key, _lastViewerSettingsKey, StringComparison.Ordinal))
            return;

        _renderMode = NormalizeRenderMode(settings.RenderMode);
        _cameraProjection = NormalizeProjection(settings.CameraProjection);
        _edgesEnabled = settings.EdgesEnabled && _renderMode != "wireframe";
        _gridEnabled = settings.GridEnabled;
        _bboxEnabled = settings.BoundingBoxEnabled;
        _sectionEnabled = settings.SectionEnabled;
        _sectionAxis = NormalizeSectionAxis(settings.SectionAxis);
        _sectionOffset = settings.SectionOffsetMm;
        _sectionInverted = settings.SectionInverted;
        _lastViewerSettingsKey = key;
    }

    private PartViewerSettings CaptureViewerSettings() => new()
    {
        RenderMode = _renderMode,
        CameraProjection = _cameraProjection,
        EdgesEnabled = _edgesEnabled,
        GridEnabled = _gridEnabled,
        BoundingBoxEnabled = _bboxEnabled,
        SectionEnabled = _sectionEnabled,
        SectionAxis = _sectionAxis,
        SectionOffsetMm = _sectionOffset,
        SectionInverted = _sectionInverted,
    };

    private async Task NotifyViewerSettingsChangedAsync()
    {
        var settings = CaptureViewerSettings();
        _lastViewerSettingsKey = GetViewerSettingsKey(settings);
        if (ViewerSettingsChanged.HasDelegate)
            await ViewerSettingsChanged.InvokeAsync(settings);
    }

    private static string GetViewerSettingsKey(PartViewerSettings settings) =>
        string.Join(
            "|",
            NormalizeRenderMode(settings.RenderMode),
            NormalizeProjection(settings.CameraProjection),
            settings.EdgesEnabled,
            settings.GridEnabled,
            settings.BoundingBoxEnabled,
            settings.SectionEnabled,
            NormalizeSectionAxis(settings.SectionAxis),
            settings.SectionOffsetMm.ToString("G17", CultureInfo.InvariantCulture),
            settings.SectionInverted);

    private static string NormalizeRenderMode(string? mode) =>
        string.Equals(mode, "wireframe", StringComparison.OrdinalIgnoreCase)
            ? "wireframe"
            : string.Equals(mode, "transparent", StringComparison.OrdinalIgnoreCase)
                ? "transparent"
                : "solid";

    private static string NormalizeProjection(string? mode) =>
        string.Equals(mode, "perspective", StringComparison.OrdinalIgnoreCase)
            ? "perspective"
            : "orthographic";

    private static string NormalizeSectionAxis(string? axis) =>
        string.Equals(axis, "y", StringComparison.OrdinalIgnoreCase)
            ? "y"
            : string.Equals(axis, "z", StringComparison.OrdinalIgnoreCase)
                ? "z"
                : "x";

    [JSInvokable]
    public async Task OnLoadError(string errorMessage)
    {
        // Clear _lastViewerUrl so that when the parent fetches a fresh signed URL and sets
        // ViewerUrl again, OnAfterRenderAsync treats it as new and triggers a full reinit.
        // Without this, StripQueryString would match the same base path and skip the reinit.
        _lastViewerUrl = null;
        if (OnLoadFailed.HasDelegate)
            await OnLoadFailed.InvokeAsync(errorMessage);
    }

    // Strips query parameters from a URL so that re-signed GCS URLs pointing to the same
    // file are not treated as a new model, preventing duplicate loading.
    private static string StripQueryString(string url)
        => url.Contains('?') ? url[..url.IndexOf('?')] : url;

    private static readonly ViewPreset[] _viewPresets =
    [
        new("front",  "Front view"),
        new("left",   "Left view"),
        new("back",   "Back view"),
        new("right",  "Right view"),
        new("top",    "Top view"),
        new("bottom", "Bottom view"),
        new("iso",    "Isometric view"),
    ];

    // Face polygon points (viewBox 0 0 100 100) for each view direction.
    private static readonly Dictionary<string, string> _cubeFacePoints = new()
    {
        ["front"]  = "50,86 14,70 14,28 50,44",
        ["back"]   = "86,70 50,54 50,12 86,28",
        ["left"]   = "14,70 50,54 50,12 14,28",
        ["right"]  = "50,86 86,70 86,28 50,44",
        ["top"]    = "50,44 14,28 50,12 86,28",
        ["bottom"] = "50,86 14,70 50,54 86,70",
    };

    private static MarkupString GetCubeIconSvg(string viewKey, bool isActive)
    {
        var fill   = isActive ? "rgba(var(--mud-palette-primary-rgb), 0.50)" : "rgba(var(--mud-palette-primary-rgb), 0.28)";
        var stroke = isActive ? "var(--mud-palette-primary-lighten)" : "var(--mud-palette-primary)";
        var back   = "rgba(var(--mud-palette-text-secondary-rgb), 0.30)";
        var front  = isActive ? "rgba(var(--mud-palette-text-primary-rgb), 0.95)" : "rgba(var(--mud-palette-text-secondary-rgb), 0.75)";

        string face;
        if (viewKey == "iso")
        {
            face = $"""
                <polygon points="50,86 14,70 14,28 50,44"  fill="{fill}" stroke="{stroke}" stroke-width="2.5" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44"  fill="{fill}" stroke="{stroke}" stroke-width="2.5" stroke-linejoin="round"/>
                <polygon points="50,44 14,28 50,12 86,28"  fill="{fill}" stroke="{stroke}" stroke-width="2.5" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,12 86,28 86,70" fill="none" stroke="{stroke}" stroke-width="3" stroke-linejoin="round"/>
                """;
        }
        else if (_cubeFacePoints.TryGetValue(viewKey, out var pts))
        {
            face = $"""<polygon points="{pts}" fill="{fill}" stroke="{stroke}" stroke-width="2.5" stroke-linejoin="round"/>""";
        }
        else
        {
            face = "";
        }

        return new MarkupString($"""
            <svg viewBox="0 0 100 100" width="22" height="22" style="display:block;" aria-hidden="true">
              <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{back}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{front}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{front}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              {face}
            </svg>
            """);
    }

    /// <summary>Generates inline SVG icons for render-mode and projection toolbar buttons.</summary>
    private static MarkupString GetModeIconSvg(string modeKey, bool isActive)
    {
        var edgeC  = isActive ? "rgba(var(--mud-palette-primary-rgb), 0.95)" : "rgba(var(--mud-palette-text-secondary-rgb), 0.72)";
        var backC  = isActive ? "rgba(var(--mud-palette-text-secondary-rgb), 0.40)" : "rgba(var(--mud-palette-text-secondary-rgb), 0.28)";
        var activeHighlight = isActive ? "rgba(var(--mud-palette-primary-rgb), 0.22)" : "none";

        var solidTop = "var(--mud-palette-background)";
        var solidLeft = "var(--mud-palette-text-secondary)";
        var solidRight = "var(--mud-palette-text-tertiary)";
        var solidStroke = "var(--mud-palette-lines-default)";

        string body = modeKey switch
        {
            "solid" => $"""
                <polygon points="50,44 14,28 50,12 86,28" fill="{solidTop}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="{solidLeft}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="{solidRight}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                """,

            "wireframe" => $"""
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                """,

            "transparent" => $"""
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{backC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="rgba(var(--mud-palette-primary-rgb), 0.22)" stroke="none"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="rgba(var(--mud-palette-primary-rgb), 0.22)" stroke="none"/>
                <polygon points="50,44 14,28 50,12 86,28" fill="rgba(var(--mud-palette-primary-rgb), 0.22)" stroke="none"/>
                """,

            "edges" => $"""
                <polygon points="50,44 14,28 50,12 86,28" fill="{solidTop}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                <polygon points="50,86 14,70 14,28 50,44" fill="{solidLeft}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,44" fill="{solidRight}" stroke="{solidStroke}" stroke-width="1" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                """,

            "bounds" => $"""
                <circle cx="50" cy="49" r="22" fill="rgba(var(--mud-palette-primary-rgb), 0.75)"/>
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" stroke="{edgeC}" stroke-width="2" stroke-dasharray="4 4" fill="none" stroke-linecap="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" stroke="{edgeC}" stroke-width="2" stroke-dasharray="4 4" fill="none" stroke-linecap="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" stroke="{edgeC}" stroke-width="2" stroke-dasharray="4 4" fill="none" stroke-linecap="round"/>
                """,

            "grid" => $"""
                <path d="M16 72H84M24 60H76M32 48H68M40 36H60M26 24 12 76M42 24 34 76M58 24 66 76M74 24 88 76" stroke="{edgeC}" stroke-width="3" stroke-linecap="round"/>
                <path d="M16 72H84M24 60H76M32 48H68M40 36H60" stroke="{backC}" stroke-width="1.5" stroke-linecap="round"/>
                """,

            "ortho" => $"""
                <path d="M50,54 L14,70 M50,54 L86,70 M50,54 L50,12" fill="none" stroke="{backC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,86 86,70 86,28 50,12 14,28 14,70" fill="{activeHighlight}" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,44 L50,86 M50,44 L14,28 M50,44 L86,28" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                """,

            "perspective" => $"""
                <path d="M50,58 L20,69 M50,58 L80,69 M50,58 L50,31" fill="none" stroke="{backC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <polygon points="50,90 80,69 80,34 50,31 20,34 20,69" fill="{activeHighlight}" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M50,40 L50,90 M50,40 L20,34 M50,40 L80,34" fill="none" stroke="{edgeC}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                """,

            _ => ""
        };

        return new MarkupString($"""
            <svg viewBox="0 0 100 100" width="22" height="22" style="display:block;" aria-hidden="true">
              {body}
            </svg>
            """);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Logger.LogDebug("OnAfterRenderAsync: ViewerUrl='{ViewerUrl}', _lastViewerUrl='{LastViewerUrl}'", ViewerUrl, _lastViewerUrl);
        var turningAxisKey = GetTurningAxisKey();
        if (!string.IsNullOrEmpty(ViewerUrl) && StripQueryString(ViewerUrl) != StripQueryString(_lastViewerUrl ?? ""))
        {
            string? previousUrl = _lastViewerUrl;
            _lastViewerUrl = ViewerUrl;
            try
            {
                _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(identifier: "import", args: "./js/part-viewer.js");
                if (previousUrl != null)
                    await _module.InvokeVoidAsync("dispose", _canvasId);

                // Pass known bounding-box dimensions (mm) so the viewer can correct the glTF meter scale.
                // Prefer Model properties, fall back to KnownDimensions parameter.
                object? dims = null;
                if (Model?.BoundingBoxX > 0 && Model.BoundingBoxY > 0 && Model.BoundingBoxZ > 0)
                    dims = new { x = Model.BoundingBoxX, y = Model.BoundingBoxY, z = Model.BoundingBoxZ };
                else if (KnownDimensions?.X > 0 && KnownDimensions.Y > 0 && KnownDimensions.Z > 0)
                    dims = new { x = KnownDimensions.X, y = KnownDimensions.Y, z = KnownDimensions.Z };

                var settings = CaptureViewerSettings();
                Logger.LogDebug("Calling JS initialize with URL: {ViewerUrl}", ViewerUrl);
                await _module.InvokeVoidAsync("initialize",
                    _canvasId,
                    ViewerUrl,
                    FileExtension ?? string.Empty,
                    LayoutService.IsDarkMode,
                    dims,
                    _dotNetRef,
                    settings);
                await ApplyTurningAxisAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error initializing BabylonJS viewer");
            }
        }
        else if (_module != null && _lastTurningAxisKey != turningAxisKey)
        {
            await ApplyTurningAxisAsync();
        }
    }

    private string GetTurningAxisKey()
    {
        if (TurningAxis is not { AxisVector.Count: >= 3, AxisPoint.Count: >= 3 } axis)
            return string.Empty;

        var values = axis.AxisVector
            .Take(3)
            .Select(value => value.ToString("G17", CultureInfo.InvariantCulture));
        var pointValues = axis.AxisPoint
            .Take(3)
            .Select(value => value.ToString("G17", CultureInfo.InvariantCulture));
        return $"{axis.PrimaryAxis}:{string.Join(",", values)}:{string.Join(",", pointValues)}";
    }

    private async Task ApplyTurningAxisAsync()
    {
        if (_module == null)
            return;

        try
        {
            if (TurningAxis is { AxisVector.Count: >= 3, AxisPoint.Count: >= 3 } axis && !string.IsNullOrWhiteSpace(axis.PrimaryAxis))
            {
                await _module.InvokeVoidAsync("setTurningAxis", _canvasId, axis.PrimaryAxis, axis.AxisVector.Take(3).ToArray(), axis.AxisPoint.Take(3).ToArray());
            }
            else
            {
                await _module.InvokeVoidAsync("clearTurningAxis", _canvasId);
            }

            _lastTurningAxisKey = GetTurningAxisKey();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] turning axis error: {ex.Message}");
        }
    }

    private async Task SetCameraPreset(string preset)
    {
        _cameraPreset = preset;
        if (_module != null)
