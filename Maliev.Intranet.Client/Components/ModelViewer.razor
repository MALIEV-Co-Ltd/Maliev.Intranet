@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Services
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject LayoutService LayoutService

<div class="model-viewer-container" style="position: relative; width: 100%; height: 100%; min-height: 200px; border-radius: 8px; overflow: hidden; background-color: var(--mud-palette-surface); contain: layout style;">
    <canvas id="@_canvasId" style="width: 100%; height: 100%; touch-action: none; outline: none; display: block;"></canvas>

    @if (Model != null)
    {
        <div class="overlay-info" style="position: absolute; top: 12px; left: 12px; background: var(--mud-palette-overlay-dark); color: var(--mud-palette-white); padding: 12px; border-radius: 8px; backdrop-filter: blur(4px); pointer-events: none;">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Model.FileName</MudText>
            @if (Model.GeometryAnalyzed)
            {
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Volume: @(Model.VolumeCm3?.ToString("F2") ?? "-") cm³</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Surface Area: @(Model.SurfaceAreaCm2?.ToString("F2") ?? "-") cm²</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Triangles: @(Model.TriangleCount?.ToString("N0") ?? "-")</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Manifold: @(Model.IsManifold == true ? "Yes" : "No")</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2" Style="display: block; font-style: italic;">Geometry Analysis Pending...</MudText>
            }
        </div>
    }

    <div class="viewport-toolbar" style="position: absolute; bottom: 0; left: 0; right: 0;">
        <button class="vp-btn @(_cameraPreset == "front" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("front"))'>Front</button>
        <button class="vp-btn @(_cameraPreset == "back" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("back"))'>Back</button>
        <button class="vp-btn @(_cameraPreset == "left" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("left"))'>Left</button>
        <button class="vp-btn @(_cameraPreset == "right" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("right"))'>Right</button>
        <button class="vp-btn @(_cameraPreset == "top" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("top"))'>Top</button>
        <button class="vp-btn @(_cameraPreset == "bottom" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("bottom"))'>Bottom</button>
        <button class="vp-btn @(_cameraPreset == "iso" ? "vp-active" : "")" @onclick='@(() => SetCameraPreset("iso"))'>Iso</button>
        <span class="vp-sep">|</span>
        <button class="vp-btn @(_renderMode == "solid" ? "vp-active" : "")" @onclick='@(() => SetRenderModeAsync("solid"))'>Solid</button>
        <button class="vp-btn @(_renderMode == "wireframe" ? "vp-active" : "")" @onclick='@(() => SetRenderModeAsync("wireframe"))'>Wireframe</button>
        <button class="vp-btn @(_renderMode == "transparent" ? "vp-active" : "")" @onclick='@(() => SetRenderModeAsync("transparent"))'>Transparent</button>
        <button class="vp-btn @(_edgesEnabled ? "vp-active" : "")" @onclick="ToggleEdgesAsync">Edges</button>
        <button class="vp-btn @(_bboxEnabled ? "vp-active" : "")" @onclick="ToggleBoundingBoxAsync">Bbox</button>
        <span class="vp-sep">|</span>
        <button class="vp-btn" @onclick="ResetCamera">Reset</button>
    </div>

</div>

@code {
    [Parameter]
    public Model3DDto? Model { get; set; }

    [Parameter]
    public string? ViewerUrl { get; set; }

    [Parameter]
    public string? FileExtension { get; set; }



    private string _canvasId = $"babylon-canvas-{Guid.NewGuid()}";
    private IJSObjectReference? _module;
    private string _renderMode = "solid";
    private string _cameraPreset = "iso";
    private bool _edgesEnabled;
    private bool _bboxEnabled;

    private string? _lastViewerUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrEmpty(ViewerUrl) && ViewerUrl != _lastViewerUrl)
        {
            var previousUrl = _lastViewerUrl;
            _lastViewerUrl = ViewerUrl;
            try
            {
                _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/babylon-viewer.js");
                if (previousUrl != null)
                    await _module.InvokeVoidAsync("dispose", _canvasId);
                _renderMode = "solid";
                _edgesEnabled = false;
                _bboxEnabled = false;
                await _module.InvokeVoidAsync("initialize", _canvasId, ViewerUrl, FileExtension ?? string.Empty, LayoutService.IsDarkMode);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing BabylonJS viewer: {ex.Message}");
            }
        }
    }

    private async Task SetCameraPreset(string preset)
    {
        _cameraPreset = preset;
        if (_module != null)
            await _module.InvokeVoidAsync("setCameraPreset", _canvasId, preset);
    }

    private async Task SetRenderModeAsync(string mode)
    {
        var targetMode = _renderMode == mode ? "solid" : mode;
        _renderMode = targetMode;
        if (_module != null)
            await _module.InvokeVoidAsync("setRenderMode", _canvasId, targetMode);
    }

    private async Task ResetCamera()
    {
        _cameraPreset = "iso";
        if (_module != null)
            await _module.InvokeVoidAsync("resetCamera", _canvasId);
    }

    private async Task ToggleEdgesAsync()
    {
        _edgesEnabled = !_edgesEnabled;
        if (_module != null)
            await _module.InvokeVoidAsync("toggleEdges", _canvasId, _edgesEnabled);
    }

    private async Task ToggleBoundingBoxAsync()
    {
        _bboxEnabled = !_bboxEnabled;
        if (_module != null)
            await _module.InvokeVoidAsync("toggleBoundingBox", _canvasId, _bboxEnabled);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvasId);
                await _module.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors on teardown
            }
        }
    }
}

