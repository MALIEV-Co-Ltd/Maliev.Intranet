        }
    }

    /// <summary>Shows a grid floor at the model base (Z=0) for overhang visualisation.</summary>
    public async Task ShowGridAsync()
    {
        _gridEnabled = true;
        await ApplyGridVisibilityAsync(notifySettingsChanged: true);
    }

    /// <summary>Hides the grid floor.</summary>
    public async Task HideGridAsync()
    {
        _gridEnabled = false;
        await ApplyGridVisibilityAsync(notifySettingsChanged: true);
    }

    /// <summary>Requests temporary grid visibility without changing persisted settings.</summary>
    public async Task SetTemporaryGridVisibilityAsync(string ownerKey, bool visible)
    {
        if (string.IsNullOrWhiteSpace(ownerKey))
            return;

        var changed = visible
            ? _temporaryGridOwners.Add(ownerKey)
            : _temporaryGridOwners.Remove(ownerKey);

        if (changed)
            await ApplyGridVisibilityAsync(notifySettingsChanged: false);
    }

    /// <summary>Clears all temporary grid visibility requests.</summary>
    public async Task ClearTemporaryGridOwnersAsync()
    {
        if (_temporaryGridOwners.Count == 0)
            return;

        _temporaryGridOwners.Clear();
        await ApplyGridVisibilityAsync(notifySettingsChanged: false);
    }

    private async Task ApplyGridVisibilityAsync(bool notifySettingsChanged)
    {
        var shouldShowGrid = ShouldShowGrid;

        try
        {
            if (_module != null && _lastAppliedGridVisible != shouldShowGrid)
            {
                await _module.InvokeVoidAsync(
                    shouldShowGrid ? "showGrid" : "hideGrid",
                    _canvasId);
                _lastAppliedGridVisible = shouldShowGrid;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] grid visibility error: {ex.Message}");
        }

        if (notifySettingsChanged)
            await NotifyViewerSettingsChangedAsync();
    }

    /// <summary>Notifies the viewer it has become visible after being hidden. Triggers engine resize.</summary>
    public async Task NotifyVisibleAsync()
    {
        if (_module == null) return;
        try { await _module.InvokeVoidAsync("notifyViewerVisible", _canvasId); }
        catch { /* best-effort */ }
    }

    /// <summary>Removes all DFM overlay meshes for the given part from the 3D scene.</summary>
    public async Task ClearDfmOverlaysAsync(string? partKey = null)
    {
        if (_module == null) return;
        try
        {
            await _module.InvokeVoidAsync("clearDfmOverlays", _canvasId, partKey ?? string.Empty);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] clearDfmOverlays error: {ex.Message}");
        }
    }

    /// <summary>Assigns colors to multiple bodies in a multi-body CAD file.</summary>
    public async Task SetBodiesAsync(List<BodyViewModel> bodies)
    {
        if (_module == null) return;
        try
        {
            var bodyData = bodies.Select(b => new { index = b.Index, name = b.Name }).ToArray();
            await _module.InvokeVoidAsync("setBodies", _canvasId, bodyData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] setBodies error: {ex.Message}");
        }
    }

    /// <summary>Selects a body by index and highlights it with x-ray mode.</summary>
    public async Task SelectBodyAsync(int? bodyIndex)
    {
        if (_module == null) return;
        try
        {
            // When a body is selected, reset toolbar transparent/realistic mode to avoid conflicts
            if (bodyIndex.HasValue && (_renderMode == "transparent" || _renderMode == "realistic"))
            {
                _renderMode = "solid";
                await _module.InvokeVoidAsync("setRenderMode", _canvasId, "solid");
                await NotifyViewerSettingsChangedAsync();
            }

            if (bodyIndex.HasValue)
                await _module.InvokeVoidAsync("selectBody", _canvasId, bodyIndex.Value);
            else
                await _module.InvokeVoidAsync("clearBodySelection", _canvasId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] selectBody error: {ex.Message}");
        }
    }

    /// <summary>Enables click-to-select functionality for multi-body picking.</summary>
    public async Task EnableBodyPickingAsync()
    {
        if (_module == null) return;
        try
        {
            await _module.InvokeVoidAsync("enableBodyPicking", _canvasId, _dotNetRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ModelViewer] enableBodyPicking error: {ex.Message}");
        }
    }

    /// <summary>JSInvokable callback when a body is clicked in the 3D viewer.</summary>
    [JSInvokable]
    public async Task NotifyBodyPicked(int? bodyIndex)
    {
        if (OnBodyPicked.HasDelegate)
            await OnBodyPicked.InvokeAsync(bodyIndex);
    }

    /// <summary>JSInvokable callback when a measurement is completed.</summary>
    [JSInvokable]
    public async Task NotifyMeasureResult(string distanceMm, string angleDegrees)
    {
        _lastMeasurement = $"Distance: {distanceMm} mm | Angle: {angleDegrees}°";
        await InvokeAsync(StateHasChanged);
        Logger.LogDebug("Measurement result: Distance={Distance}mm, Angle={Angle}°", distanceMm, angleDegrees);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvasId);
                await _module.DisposeAsync();
            }
            catch { }
        }
    }
}
