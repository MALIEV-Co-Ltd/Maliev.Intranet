@using Maliev.Intranet.Shared.Dtos
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="model-viewer-container" style="position: relative; width: 100%; height: 600px; border-radius: 8px; overflow: hidden; background-color: #f5f5f5;">
    <canvas id="@_canvasId" style="width: 100%; height: 100%; touch-action: none; outline: none;"></canvas>
    
    @if (Model != null)
    {
        <div class="overlay-info" style="position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.6); color: white; padding: 12px; border-radius: 8px; backdrop-filter: blur(4px); pointer-events: none;">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@Model.FileName</MudText>
            @if (Model.GeometryAnalyzed)
            {
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Volume: @(Model.VolumeCm3?.ToString("F2") ?? "-") cm³</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Surface Area: @(Model.SurfaceAreaCm2?.ToString("F2") ?? "-") cm²</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Triangles: @(Model.TriangleCount?.ToString("N0") ?? "-")</MudText>
                    <MudText Typo="Typo.caption" Style="display: block; opacity: 0.9;">Manifold: @(Model.IsManifold == true ? "Yes" : "No")</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mt-2" Style="display: block; font-style: italic;">Geometry Analysis Pending...</MudText>
            }
        </div>
    }

    <div class="viewer-controls" style="position: absolute; bottom: 12px; left: 12px; right: 12px; display: flex; justify-content: center; pointer-events: none;">
        <MudPaper Elevation="4" Class="pa-1 rounded-pill" Style="background: rgba(255,255,255,0.8); backdrop-filter: blur(8px); pointer-events: auto; display: flex; gap: 4px;">
            <MudToggleGroup T="string" Value="@_currentRenderMode" ValueChanged="OnRenderModeChanged" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" Delimiters="false">
                <MudToggleItem Value="@("solid")" UnselectedIcon="@Icons.Material.Outlined.Square" SelectedIcon="@Icons.Material.Filled.Square">Solid</MudToggleItem>
                <MudToggleItem Value="@("wireframe")" UnselectedIcon="@Icons.Material.Outlined.Grid4x4" SelectedIcon="@Icons.Material.Filled.Grid4x4">Wireframe</MudToggleItem>
                <MudToggleItem Value="@("xray")" UnselectedIcon="@Icons.Material.Outlined.FilterCenterFocus" SelectedIcon="@Icons.Material.Filled.FilterCenterFocus">X-Ray</MudToggleItem>
            </MudToggleGroup>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            
            <MudTooltip Text="Reset Camera">
                <MudIconButton Icon="@Icons.Material.Outlined.CenterFocusStrong" OnClick="ResetCamera" Color="Color.Default" />
            </MudTooltip>
            
            <MudTooltip Text="Fullscreen">
                <MudIconButton Icon="@Icons.Material.Outlined.Fullscreen" OnClick="ToggleFullscreen" Color="Color.Default" />
            </MudTooltip>
        </MudPaper>
    </div>
</div>

@code {
    [Parameter]
    public Model3DDto? Model { get; set; }

    [Parameter]
    public string? ViewerUrl { get; set; }

    private string _canvasId = $"babylon-canvas-{Guid.NewGuid()}";
    private IJSObjectReference? _module;
    private string _currentRenderMode = "solid";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(ViewerUrl))
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/babylon-viewer.js");
                await _module.InvokeVoidAsync("initialize", _canvasId, ViewerUrl);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing BabylonJS viewer: {ex.Message}");
            }
        }
    }

    private async Task OnRenderModeChanged(string mode)
    {
        _currentRenderMode = mode;
        if (_module != null)
        {
            await _module.InvokeVoidAsync("setRenderMode", _canvasId, mode);
        }
    }

    private async Task ResetCamera()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("resetCamera", _canvasId);
        }
    }

    private async Task ToggleFullscreen()
    {
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{_canvasId}').requestFullscreen()");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvasId);
                await _module.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors on teardown
            }
        }
    }
}
