    private async Task SetRenderModeAsync(string mode)
    {
        var target = _renderMode == mode ? "solid" : mode;
        _renderMode = target;
        // Wireframe is incompatible with edge rendering — clear the edge button state.
        if (target == "wireframe") _edgesEnabled = false;

        // Clear active analysis tools when changing render mode
        if (_activeAnalysisTool != null)
        {
            _activeAnalysisTool = null;
            _lastMeasurement = null;
            await ClearAnalysisToolsAsync();
        }

        if (_module != null)
        {
            await _module.InvokeVoidAsync("setRenderMode", _canvasId, target);
            if (target == "wireframe")
                await _module.InvokeVoidAsync("toggleEdges", _canvasId, false);
            // Note: setMaterialType is intentionally NOT called here. setRenderMode already applies
            // materialTypes[canvasId] (kept in sync by configureMaterialFromConfigurator). Calling
            // setMaterialType would clear customAlbedoColors, wiping any configurator colour.
        }

        await NotifyViewerSettingsChangedAsync();
    }

