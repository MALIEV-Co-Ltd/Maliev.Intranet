    private async Task SetAnalysisTool(string tool)
    {
        // If clicking the same tool, toggle it off
        if (_activeAnalysisTool == tool)
        {
            _activeAnalysisTool = null;
            _lastMeasurement = null;
            if (_module != null)
                await ClearAnalysisToolsAsync();
        }
        else
        {
            _activeAnalysisTool = tool;
            _lastMeasurement = null;  // Clear when switching tools
            if (_module != null)
                await EnableAnalysisToolAsync(tool);
        }
    }

    private async Task ClearAnalysisTool()
    {
        _activeAnalysisTool = null;
        _lastMeasurement = null;
        if (_module != null)
            await ClearAnalysisToolsAsync();
    }

    private async Task EnableAnalysisToolAsync(string tool)
    {
        if (_module == null) return;
        // Will be implemented in Phase 2-4
        switch (tool)
        {
            case "flippedTriangles":
                await _module.InvokeVoidAsync("enableFlippedTriangleView", _canvasId, true);
                break;
            case "measure":
                await _module.InvokeVoidAsync("enableMeasureTool", _canvasId, _dotNetRef);
                break;
            case "thickness":
                await _module.InvokeVoidAsync("enableThicknessAnalysis", _canvasId);
                break;
        }
    }

    private async Task ClearAnalysisToolsAsync()
    {
        if (_module == null) return;
        await _module.InvokeVoidAsync("enableFlippedTriangleView", _canvasId, false);
        await _module.InvokeVoidAsync("disableMeasureTool", _canvasId);
        await _module.InvokeVoidAsync("disableThicknessAnalysis", _canvasId);
    }

