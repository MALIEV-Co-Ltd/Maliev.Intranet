@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Split Invoice @InvoiceNumber</MudText>
        <MudText Typo="Typo.body2">Total Amount: @TotalAmount.ToString("N2")</MudText>
        
        <MudStack Class="mt-4">
            <MudRadioGroup T="string" @bind-Value="SplitType">
                <MudRadio Value="@("50/50")">50/50 Deposit</MudRadio>
                <MudRadio Value="@("Custom")">Custom Split</MudRadio>
            </MudRadioGroup>
            
            <MudTable Items="@_rules" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Percentage</MudTh>
                    <MudTh>Amount</MudTh>
                    <MudTh>Notes</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudNumericField @bind-Value="context.Percentage" Min="0" Max="100" Step="1" Format="F2" Immediate="true" />
                    </MudTd>
                    <MudTd>
                        @((TotalAmount * context.Percentage / 100m).ToString("N2"))
                    </MudTd>
                    <MudTd>
                        <MudTextField @bind-Value="context.Notes" Placeholder="e.g. Deposit" />
                    </MudTd>
                    <MudTd>
                        @if (_splitType == "Custom" && _rules.Count > 2)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => RemoveRule(context))" Size="Size.Small" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
            
            @if (_splitType == "Custom")
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule">Add Split</MudButton>
            }
            
            <MudText Color="@(TotalPercentage == 100 ? Color.Success : Color.Error)">Total: @TotalPercentage%</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(TotalPercentage != 100)">Split Invoice</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public Guid InvoiceId { get; set; }
    [Parameter] public string InvoiceNumber { get; set; } = string.Empty;
    [Parameter] public decimal TotalAmount { get; set; }

    private string _splitType = "50/50";
    
    private string SplitType
    {
        get => _splitType;
        set
        {
            if (_splitType != value)
            {
                _splitType = value;
                ResetRules();
            }
        }
    }

    private List<InvoiceSplitDetail> _rules = new();

    protected override void OnInitialized()
    {
        ResetRules();
    }

    private void ResetRules()
    {
        _rules.Clear();
        if (_splitType == "50/50")
        {
            _rules.Add(new InvoiceSplitDetail { Percentage = 50, Notes = "Deposit" });
            _rules.Add(new InvoiceSplitDetail { Percentage = 50, Notes = "Balance" });
        }
        else
        {
            _rules.Add(new InvoiceSplitDetail { Percentage = 50 });
            _rules.Add(new InvoiceSplitDetail { Percentage = 50 });
        }
    }

    private void OnSplitTypeChanged(string value)
    {
        _splitType = value;
        ResetRules();
    }

    private void AddRule()
    {
        _rules.Add(new InvoiceSplitDetail { Percentage = 0 });
    }

    private void RemoveRule(InvoiceSplitDetail rule)
    {
        _rules.Remove(rule);
    }

    private decimal TotalPercentage => _rules.Sum(r => r.Percentage);

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (Math.Abs(TotalPercentage - 100) > 0.01m)
        {
            Snackbar.Add("Total percentage must be 100%", Severity.Error);
            return;
        }

        // Calculate amounts and due dates (default to today+30 for now if not set)
        foreach (var rule in _rules)
        {
            rule.Amount = TotalAmount * rule.Percentage / 100m;
            if (rule.DueDate == default)
            {
                rule.DueDate = DateTime.Today.AddDays(30); 
            }
        }

        var request = new SplitInvoiceRequest
        {
            Splits = _rules,
            Reason = "User initiated split"
        };

        try
        {
            // Use the client/controller endpoint if wired via HttpClient directly or inject service client
            // Wiring via HttpClient as per component
            var response = await Http.PostAsJsonAsync($"api/invoices/{InvoiceId}/split", request);
            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error splitting invoice: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
