@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUri) ? "/" : $"/{relativeUri}";
        var loginUrl = $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

        if (!returnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(loginUrl, forceLoad: true);
        }
    }
}
