<style>
    .logout-nav-link {
        background-color: var(--mud-palette-error) !important;
        color: white !important;
    }

    .logout-nav-link:hover {
        background-color: var(--mud-palette-error-darken) !important;
    }

    .logout-nav-link .mud-nav-link-text {
        font-weight: 500;
    }

    .sticky-bottom-logout {
        background-color: var(--mud-palette-drawer-background);
        z-index: 10;
    }

    /* Fix NavLink width issue caused by Tooltip wrapping */
    .mud-tooltip-root {
        width: 100%;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--mud-palette-divider);
        border-radius: 4px;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    private System.Security.Claims.ClaimsPrincipal _user = new();

    /// <summary>
    /// Loads the authenticated user's claims on component initialization.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _user = authState.User;
    }

    /// <summary>
    /// Checks whether the current user has the specified permission, mirroring the server-side
    /// PermissionMatcher logic: platform owner bypass, wildcard support, and exact match fallback.
    /// </summary>
    /// <param name="permission">The GCP-style permission string to check.</param>
    /// <returns>True if the user holds the permission; otherwise false.</returns>
    private bool HasPermission(string permission)
    {
        if (_user is null) return false;

        var userPermissions = _user.Claims
            .Where(c => c.Type is "permissions" or "permission")
            .Select(c => c.Value)
            .ToList();

        if (userPermissions.Count == 0) return false;

        // Platform owner bypass — mirrors PermissionMatcher.Match()
        if (userPermissions.Any(p => string.Equals(p, "roles.platform.owner", StringComparison.OrdinalIgnoreCase)))
            return true;

        // Also check role claims for platform owner
        if (_user.Claims.Any(c =>
                c.Type is "roles" or System.Security.Claims.ClaimTypes.Role &&
                string.Equals(c.Value, "roles.platform.owner", StringComparison.OrdinalIgnoreCase)))
            return true;

        // Wildcard "*" grants everything
        if (userPermissions.Any(p => p == "*"))
            return true;

        // Wildcard suffix match (e.g. "customer.*" matches "customer.customers.read")
        // and exact match — mirrors PermissionMatcher.IsMatch()
        return userPermissions.Any(p => IsPermissionMatch(permission, p));
    }

    /// <summary>
    /// Mirrors PermissionMatcher.IsMatch() — supports exact and wildcard-suffix matching.
    /// </summary>
    private static bool IsPermissionMatch(string required, string claim)
    {
        if (string.IsNullOrWhiteSpace(required) || string.IsNullOrWhiteSpace(claim)) return false;

        // Exact match (case-insensitive)
        if (string.Equals(required, claim, StringComparison.OrdinalIgnoreCase)) return true;

        var requiredParts = required.Split('.');
        var claimParts = claim.Split('.');

        // Single "*" was already handled above
        for (int i = 0; i < claimParts.Length; i++)
        {
            if (claimParts[i] == "*")
            {
                // Wildcard must be the last segment
                return i == claimParts.Length - 1;
            }

            if (i >= requiredParts.Length) return false;

            if (!string.Equals(requiredParts[i], claimParts[i], StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return claimParts.Length == requiredParts.Length;
    }

    /// <summary>
    /// Returns the tooltip text for a nav item — the label when permitted, a friendly
    /// human-readable message when access is denied.
    /// </summary>
    private string NavTooltip(string permission, string label, string deniedMessage)
        => HasPermission(permission) ? label : deniedMessage;

    /// <summary>
    /// Returns the inline style that visually disables a nav link when the user lacks the permission.
    /// </summary>
    private string NavStyle(string permission)
        => HasPermission(permission) ? "" : "opacity: 0.4; pointer-events: none;";

    private void HandleLogout()
    {
        Navigation.NavigateTo("/api/auth/logout", forceLoad: true);
    }
}
