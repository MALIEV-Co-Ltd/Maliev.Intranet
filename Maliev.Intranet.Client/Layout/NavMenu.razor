@using MudBlazor
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject LayoutService LayoutService

<div class="nav-sidebar d-flex flex-column" style="height: 100%; overflow: hidden;">
    <!-- Logo -->
    <div class="d-flex align-center px-4 py-3" style="min-height: 56px; flex-shrink: 0;">
        <button type="button"
                class="nav-logo-button"
                title="Dashboard"
                aria-label="Go to dashboard"
                @onclick="@(() => Navigation.NavigateTo("/"))">
            <MudImage Src="@LogoUrl" Alt="Maliev Logo" Height="22" />
        </button>
    </div>

    <!-- Search -->
    <div class="px-3 pb-2" style="flex-shrink: 0;">
        <GlobalSearchBox Class="sidebar-global-search" Placeholder="Search..." Limit="6" />
    </div>

    <MudDivider />

    <!-- Nav Items (scrollable) -->
    <div class="flex-grow-1 custom-scrollbar" style="overflow-y: auto; overflow-x: hidden; display: block; height: 100%;">
        <MudNavMenu Class="mud-width-full">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>

            <!-- Sales & CRM -->
            <MudNavGroup Title="Sales & CRM" Icon="@Icons.Material.Outlined.Business" Expanded="false">
                <MudNavLink Href="customers" Icon="@Icons.Material.Outlined.People"
                            Style="@NavStyle(MalievPermissions.Customer.Read)">Customers</MudNavLink>
                <MudNavLink Href="sales/projects" Icon="@Icons.Material.Outlined.FolderSpecial"
                            Style="@NavStyle(MalievPermissions.Project.Read)">Projects</MudNavLink>
                <MudNavLink Href="commerce/catalog" Icon="@Icons.Material.Outlined.Storefront"
                            Style="@NavStyle(MalievPermissions.Commerce.ProductsRead)">Commerce Catalog</MudNavLink>
            </MudNavGroup>

            <!-- Manufacturing -->
            <MudNavGroup Title="Manufacturing" Icon="@Icons.Material.Outlined.PrecisionManufacturing" Expanded="false">
                <MudNavLink Href="mfg/materials" Icon="@Icons.Material.Outlined.Inventory"
                            Style="@NavStyle(MalievPermissions.Material.Read)">Materials</MudNavLink>
                <MudNavLink Href="mfg/equipment" Icon="@Icons.Material.Outlined.PrecisionManufacturing"
                            Style="@NavStyle(MalievPermissions.Facility.Read)">Equipment</MudNavLink>
                <MudNavLink Href="mfg/production-schedule" Icon="@Icons.Material.Outlined.Event"
                            Style="@NavStyle(MalievPermissions.Job.Read)">Production Schedule</MudNavLink>
                <MudNavLink Href="purchasing" Icon="@Icons.Material.Outlined.ShoppingBag"
                            Style="@NavStyle(MalievPermissions.PurchaseOrder.Read)">Procurement</MudNavLink>
            </MudNavGroup>

            <!-- Purchasing -->
            <MudNavGroup Title="Purchasing" Icon="@Icons.Material.Outlined.ShoppingBag" Expanded="false">
                <MudNavLink Href="purchasing" Icon="@Icons.Material.Outlined.ShoppingBag"
                            Style="@NavStyle(MalievPermissions.PurchaseOrder.Read)">Purchase Orders</MudNavLink>
                <MudNavLink Href="purchasing/new" Icon="@Icons.Material.Outlined.Inventory2"
                            Style="@NavStyle(MalievPermissions.PurchaseOrder.Write)">New PO</MudNavLink>
                <MudNavLink Href="purchasing/suppliers" Icon="@Icons.Material.Outlined.AddBusiness"
                            Style="@NavStyle(MalievPermissions.Supplier.Read)">Suppliers</MudNavLink>
            </MudNavGroup>

            <!-- Finance -->
            <MudNavGroup Title="Finance" Icon="@Icons.Material.Outlined.AccountBalanceWallet" Expanded="false">
                <MudNavLink Href="accounting" Icon="@Icons.Material.Outlined.Receipt"
                            Style="@NavStyle(MalievPermissions.Invoice.Read)">Invoices</MudNavLink>
                <MudNavLink Href="accounting" Icon="@Icons.Material.Outlined.AccountBalance"
                            Style="@NavStyle(MalievPermissions.Accounting.Read)">Accounting</MudNavLink>
                <MudNavLink Href="finance/delivery-notes" Icon="@Icons.Material.Outlined.LocalShipping"
                            Style="@NavStyle(MalievPermissions.Delivery.Read)">Delivery Notes</MudNavLink>
            </MudNavGroup>

            <!-- HR & People -->
            <MudNavGroup Title="HR & People" Icon="@Icons.Material.Outlined.Groups" Expanded="false">
                <MudNavLink Href="hr/profile" Icon="@Icons.Material.Outlined.AccountCircle"
                            Style="@NavStyle(MalievPermissions.Employee.Read)">My Profile</MudNavLink>
                <MudNavLink Href="hr/leave" Icon="@Icons.Material.Outlined.EventAvailable"
                            Style="@NavStyle(MalievPermissions.Leave.Read)">Leave</MudNavLink>
            </MudNavGroup>

            <!-- Operations -->
            <MudNavGroup Title="Operations" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false">
                <MudNavLink Href="iam" Icon="@Icons.Material.Outlined.Security"
                            Style="@NavStyle(MalievPermissions.Iam.Manage)">IAM Console</MudNavLink>
                <MudNavLink Href="admin/system-health" Icon="@Icons.Material.Outlined.HealthAndSafety"
                            Style="@NavStyle(MalievPermissions.System.HealthRead)">System Health</MudNavLink>
                <MudNavLink Href="admin/reference-data" Icon="@Icons.Material.Outlined.TravelExplore"
                            Style="@NavStyle(MalievPermissions.Registry.LocationsRead)">Reference Data</MudNavLink>
                <MudNavLink Href="admin" Icon="@Icons.Material.Outlined.Settings"
                            Style="@NavStyle(MalievPermissions.Iam.Manage)">Admin</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </div>

    <!-- Bottom Actions -->
    <div style="flex-shrink: 0;">
        <MudDivider />
        <MudNavMenu Class="mud-width-full pa-2">
            <!-- Notifications -->
            <MudBadge Visible="@HasUnreadNotifications" Dot="true" Color="Color.Error" Overlap="true" Bordered="true" Class="mud-width-full">
                <MudNavLink Icon="@Icons.Material.Outlined.Notifications" OnClick="@OnClearNotifications">
                    Notifications
                </MudNavLink>
            </MudBadge>

            <!-- AI Assistant -->
            <MudNavLink Icon="@Icons.Material.Outlined.Chat"
                        IconColor="@(ChatDrawerOpen ? Color.Primary : Color.Default)"
                        OnClick="@ToggleChat">
                AI Assistant
            </MudNavLink>

            <!-- Theme Toggle -->
            <MudNavLink Icon="@ThemeIcon"
                        IconColor="Color.Default"
                        Style="@ThemeIconStyle"
                        Class="@ThemeIconClass"
                        OnClick="@OnToggleTheme">
                @GetThemeLabel()
            </MudNavLink>
        </MudNavMenu>

        <MudDivider />

        <!-- User Profile -->
        <AuthorizeView Context="auth">
            <Authorized>
                <MudMenu AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" LockScroll="true" Class="mud-width-full">
                    <ActivatorContent>
                        <div class="d-flex align-center px-4 py-2 cursor-pointer" style="gap: 10px;">
                            <MudAvatar Style="height: 36px; width: 36px; font-size: 1rem; flex-shrink: 0;">
                                @if (!string.IsNullOrEmpty(auth.User.FindFirst("picture")?.Value))
                                {
                                    <MudImage Src="@auth.User.FindFirst("picture")?.Value" Alt="User Avatar" />
                                }
                                else
                                {
                                    @(auth.User.Identity?.Name?[0] ?? 'U')
                                }
                            </MudAvatar>
                            <div style="min-width: 0; overflow: hidden;">
                                <MudText Typo="Typo.body2" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@auth.User.Identity?.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(auth.User.FindFirst("job_title")?.Value ?? auth.User.FindFirst("title")?.Value ?? auth.User.FindFirst("position")?.Value ?? "Employee")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Color="Color.Default" Class="ml-auto" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Outlined.AccountCircle" Href="/hr/profile">My Profile</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Tune" Href="/hr/profile?tab=preferences">Preferences</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="@HandleLogout">Sign out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </div>
</div>


<!-- SVG Gradient for AutoMode icon -->
<svg width="0" height="0" style="position: absolute;">
    <defs>
        <linearGradient id="auto-mode-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#2196F3;stop-opacity:1" />
        </linearGradient>
    </defs>
</svg>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    [Parameter] public bool ChatDrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> ChatDrawerOpenChanged { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }
    [Parameter] public EventCallback OnClearNotifications { get; set; }
    [Parameter] public bool HasUnreadNotifications { get; set; }
    [Parameter] public string ThemeIcon { get; set; } = "";
    [Parameter] public string ThemeIconStyle { get; set; } = "";
    [Parameter] public string ThemeIconClass { get; set; } = "";

    private System.Security.Claims.ClaimsPrincipal _user = new();
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _user = authState.User;
    }

    private string LogoUrl => LayoutService.IsDarkMode
        ? "images/logo-white.svg"
        : "images/logo.svg";

    private string GetThemeLabel() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Dark Theme",
        ThemeMode.Light => "Light Theme",
        _ => "Auto Theme"
    };

    private async Task ToggleChat()
    {
        await ChatDrawerOpenChanged.InvokeAsync(!ChatDrawerOpen);
    }

    private bool HasPermission(string permission)
    {
        if (_user is null) return false;

        var userPermissions = _user.Claims
            .Where(c => c.Type is "permissions" or "permission")
            .Select(c => c.Value)
            .ToList();

        if (userPermissions.Count == 0) return false;

        if (userPermissions.Any(p => string.Equals(p, "platform.owner", StringComparison.OrdinalIgnoreCase)))
            return true;

        if (_user.Claims.Any(c =>
                c.Type is "roles" or System.Security.Claims.ClaimTypes.Role &&
                string.Equals(c.Value, "platform.owner", StringComparison.OrdinalIgnoreCase)))
            return true;

        if (userPermissions.Any(p => p == "*"))
            return true;

        return userPermissions.Any(p => IsPermissionMatch(permission, p));
    }

    private static bool IsPermissionMatch(string required, string claim)
    {
        if (string.IsNullOrWhiteSpace(required) || string.IsNullOrWhiteSpace(claim)) return false;

        if (string.Equals(required, claim, StringComparison.OrdinalIgnoreCase)) return true;

        var requiredParts = required.Split('.');
        var claimParts = claim.Split('.');

        for (int i = 0; i < claimParts.Length; i++)
        {
            if (claimParts[i] == "*")
                return i == claimParts.Length - 1;

            if (i >= requiredParts.Length) return false;

            if (!string.Equals(requiredParts[i], claimParts[i], StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return claimParts.Length == requiredParts.Length;
    }

    private string NavStyle(string permission)
        => HasPermission(permission) ? "" : "opacity: 0.4; pointer-events: none;";

    private void HandleLogout()
    {
        Navigation.NavigateTo("/api/v1/auth/logout", forceLoad: true);
    }
}
