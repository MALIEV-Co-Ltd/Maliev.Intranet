@using MudBlazor
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared
@inject NavigationManager Navigation

<MudNavMenu Class="mud-width-full d-flex flex-column" Style="height: 100%; overflow: hidden;">
    <div class="flex-grow-1 custom-scrollbar" style="overflow-y: auto;">
        <MudTooltip Text="Dashboard" Placement="Placement.Right" Delay="300" Inline="false">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>
        </MudTooltip>

        <!-- Sales & CRM -->
        <MudNavGroup Title="Sales & CRM" Icon="@Icons.Material.Outlined.Business" Expanded="false">
            <MudTooltip Text="Customers" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="sales/customers" Icon="@Icons.Material.Outlined.People">Customers</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Companies" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="sales/companies" Icon="@Icons.Material.Outlined.Business">Companies</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Quotations" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="sales/quotations" Icon="@Icons.Material.Outlined.Description">Quotations</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Orders" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="sales/orders" Icon="@Icons.Material.Outlined.ShoppingCart">Orders</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Pricing Calculator" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="sales/pricing-ai" Icon="@Icons.Material.Outlined.AutoGraph">Pricing Calculator</MudNavLink>
            </MudTooltip>
        </MudNavGroup>

        <!-- Manufacturing -->
        <MudNavGroup Title="Manufacturing" Icon="@Icons.Material.Outlined.PrecisionManufacturing" Expanded="false">
            <MudTooltip Text="3D Models" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/models" Icon="@Icons.Material.Outlined.ViewInAr">3D Models</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Materials" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/materials" Icon="@Icons.Material.Outlined.Inventory2">Materials</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Inventory [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/inventory" Icon="@Icons.Material.Outlined.Warehouse">Inventory [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Production Queue [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/production-queue" Icon="@Icons.Material.Outlined.PrecisionManufacturing">Prod. Queue [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Procurement" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/procurement" Icon="@Icons.Material.Outlined.ShoppingBag">Procurement</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Suppliers" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="mfg/suppliers" Icon="@Icons.Material.Outlined.LocalShipping">Suppliers</MudNavLink>
            </MudTooltip>
        </MudNavGroup>

        <!-- Finance -->
        <MudNavGroup Title="Finance" Icon="@Icons.Material.Outlined.AccountBalanceWallet" Expanded="false">
            <MudTooltip Text="Invoices" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/invoices" Icon="@Icons.Material.Outlined.Receipt">Invoices</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Payments" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/payments" Icon="@Icons.Material.Outlined.Payments">Payments</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Receipts" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/receipts" Icon="@Icons.Material.Outlined.RequestQuote">Receipts</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Delivery Notes" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/delivery-notes" Icon="@Icons.Material.Outlined.LocalShipping">Delivery Notes</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="General Ledger" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/ledger" Icon="@Icons.Material.Outlined.AccountBalance">General Ledger</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Financial Reports" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/reports" Icon="@Icons.Material.Outlined.Assessment">Financial Reports</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Budget Planning [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/budget" Icon="@Icons.Material.Outlined.AttachMoney">Budget [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Report Builder [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="finance/report-builder" Icon="@Icons.Material.Outlined.Build">Rep. Builder [PL]</MudNavLink>
            </MudTooltip>
        </MudNavGroup>

        <!-- HR & People -->
        <MudNavGroup Title="HR & People" Icon="@Icons.Material.Outlined.Groups" Expanded="false">
            <MudTooltip Text="People Directory" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/directory" Icon="@Icons.Material.Outlined.ContactPage">People Directory</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Employee Management" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/employees" Icon="@Icons.Material.Outlined.Badge">Employee Management</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Recruitment" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/recruitment" Icon="@Icons.Material.Outlined.WorkOutline">Recruitment</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Onboarding" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/onboarding" Icon="@Icons.Material.Outlined.AssignmentInd">Onboarding</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Time & Leave" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/time-off" Icon="@Icons.Material.Outlined.EventBusy">Time & Leave</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Training [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/training" Icon="@Icons.Material.Outlined.School">Training [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Performance" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/performance" Icon="@Icons.Material.Outlined.Speed">Performance</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Compensation" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/compensation" Icon="@Icons.Material.Outlined.MonetizationOn">Compensation</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Compliance" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/compliance" Icon="@Icons.Material.Outlined.FactCheck">Compliance</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="HR Analytics" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="hr/analytics" Icon="@Icons.Material.Outlined.Analytics">HR Analytics</MudNavLink>
            </MudTooltip>
        </MudNavGroup>

        <!-- Operations -->
        <MudNavGroup Title="Operations" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false">
            <MudTooltip Text="IAM Console" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/iam" Icon="@Icons.Material.Outlined.Security">IAM Console</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Notifications" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/notifications" Icon="@Icons.Material.Outlined.Notifications">Notifications</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Content Management [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/content" Icon="@Icons.Material.Outlined.Article">Content [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Workflow Automation [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/workflows" Icon="@Icons.Material.Outlined.Schema">Workflows [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Audit Dashboard [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/audit" Icon="@Icons.Material.Outlined.History">Audit [PL]</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="System Health" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/system-health" Icon="@Icons.Material.Outlined.HealthAndSafety">System Health</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Reference Data" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/reference-data" Icon="@Icons.Material.Outlined.SettingsSuggest">Reference Data</MudNavLink>
            </MudTooltip>
            <MudTooltip Text="Portal Config [PLACEHOLDER]" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink Href="admin/portal-config" Icon="@Icons.Material.Outlined.Web">Portal Config [PL]</MudNavLink>
            </MudTooltip>
        </MudNavGroup>
    </div>

    <div class="mt-auto sticky-bottom-logout">
        <MudDivider />
        <div class="pa-2">
            <MudTooltip Text="Logout" Placement="Placement.Right" Delay="300" Inline="false">
                <MudNavLink OnClick="@HandleLogout" 
                            Icon="@Icons.Material.Outlined.DoorBack" 
                            IconColor="Color.Inherit"
                            Class="rounded-lg logout-nav-link">
                    Logout
                </MudNavLink>
            </MudTooltip>
        </div>
    </div>
</MudNavMenu>

<style>
    .logout-nav-link {
        background-color: var(--mud-palette-error) !important;
        color: white !important;
    }
    
    .logout-nav-link:hover {
        background-color: var(--mud-palette-error-darken) !important;
    }

    .logout-nav-link .mud-nav-link-text {
        font-weight: 500;
    }

    .sticky-bottom-logout {
        background-color: var(--mud-palette-drawer-background);
        z-index: 10;
    }

    /* Fix NavLink width issue caused by Tooltip wrapping */
    .mud-tooltip-root {
        width: 100%;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--mud-palette-divider);
        border-radius: 4px;
    }
</style>

@code {
    private void HandleLogout()
    {
        Navigation.NavigateTo("/api/auth/logout", forceLoad: true);
    }
}
