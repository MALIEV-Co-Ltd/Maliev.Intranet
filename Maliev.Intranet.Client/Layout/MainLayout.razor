@inherits LayoutComponentBase
@using Microsoft.AspNetCore.SignalR.Client
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Client.Components
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject LayoutService LayoutService
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

<MudThemeProvider @ref="@_mudThemeProvider" 
                  Theme="ThemeConfiguration.MalievTheme"
                  IsDarkMode="LayoutService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="border-b border-solid mud-border-lines-default px-2 px-sm-3 px-md-4" Fixed="true" Style="height: 64px;">
        <!-- Logo Area - Left aligned -->
        <MudImage Src="@LogoUrl" Alt="Maliev Logo" Height="20" Class="mr-2 mr-sm-3" />
        
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.False" OnClick="@((e) => DrawerToggle())" Class="mr-2" />

        <!-- Search Bar - Hidden on mobile -->
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Variant="Variant.Outlined" 
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" 
                      Class="rounded-lg d-none d-md-flex" Style="max-width: 300px; background-color: var(--mud-palette-surface);" Margin="Margin.Dense" />

        <MudSpacer />
        
        <!-- Right Side Actions -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <!-- Date - Hidden on mobile/tablet -->
            <MudText Typo="Typo.body2" Class="mr-2 d-none d-lg-flex" Color="Color.Secondary">@DateTime.Now.ToString("dddd dd, MMMM yyyy")</MudText>
            
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2 d-none d-lg-flex" />

            <!-- Chat Toggle -->
            <MudTooltip Text="AI Assistant">
                <MudIconButton Icon="@Icons.Material.Outlined.Chat" 
                               Color="@(_chatDrawerOpen ? Color.Primary : Color.Inherit)" 
                               OnClick="@(() => _chatDrawerOpen = !_chatDrawerOpen)" 
                               Size="Size.Medium" />
            </MudTooltip>

            <!-- Notification -->
            <MudTooltip Text="Notifications">
                <MudBadge Dot="true" Color="Color.Error" Overlap="true" Bordered="true">
                    <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" Size="Size.Medium" />
                </MudBadge>
            </MudTooltip>

             <!-- Theme Toggle -->
            <MudTooltip Text="@GetThemeTooltip()">
                <MudIconButton Icon="@GetThemeIcon()" Color="@GetThemeColor()" OnClick="@ToggleThemeAsync" Size="Size.Medium" />
            </MudTooltip>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-2 d-none d-sm-flex" />

            <!-- User Profile -->
            <AuthorizeView Context="auth">
                <Authorized>
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" LockScroll="true">
                        <ActivatorContent>
                             <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="cursor-pointer">
                                <MudAvatar Size="Size.Small">
                                    @if (!string.IsNullOrEmpty(auth.User.FindFirst("picture")?.Value))
                                    {
                                        <MudImage Src="@auth.User.FindFirst("picture")?.Value" Alt="User Avatar" />
                                    }
                                    else
                                    {
                                        @(auth.User.Identity?.Name?[0] ?? 'U')
                                    }
                                </MudAvatar>
                                <MudStack Spacing="0" AlignItems="AlignItems.End" Class="d-none d-md-flex">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@auth.User.Identity?.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Managing Director</MudText>
                                </MudStack>
                                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Color="Color.Secondary" Class="d-none d-md-flex" />
                            </MudStack>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Href="/hr/profile">My Profile</MudMenuItem>
                            <MudMenuItem Href="/api/auth/logout">Logout</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
            </AuthorizeView>
        </MudStack>
    </MudAppBar>

    <!-- Sidebar -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" 
               Variant="@(_isMobile ? DrawerVariant.Temporary : DrawerVariant.Persistent)" 
               Breakpoint="Breakpoint.Md"
               Class="border-r border-solid mud-border-lines-default pt-4">
        <NavMenu />
    </MudDrawer>

    <!-- Chatbot Right Drawer -->
    <MudDrawer @bind-Open="_chatDrawerOpen" Anchor="Anchor.End" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="@DrawerVariant.Persistent" Width="350px">
        <ChatDrawer Context="@Navigation.Uri" />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-2 px-sm-4 px-md-6">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4 mt-md-6 mb-8 mb-md-12">
            <!-- Breadcrumbs -->
            <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-4" Separator=">">
                 <ItemTemplate Context="item">
                    <MudLink Href="@item.Href" Typo="Typo.body2" Color="Color.Secondary" Underline="Underline.None">@item.Text</MudLink>
                </ItemTemplate>
            </MudBreadcrumbs>
            
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isMobile = false;
    private bool _chatDrawerOpen = false;
    private HubConnection? _hubConnection;
    private MudThemeProvider _mudThemeProvider = null!;
    private string _searchString = "";
    private List<BreadcrumbItem> _breadcrumbs = new();

    private void UpdateBreadcrumbs()
    {
        _breadcrumbs.Clear();
        _breadcrumbs.Add(new BreadcrumbItem("Dashboard", href: "/"));

        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(uri))
        {
            return;
        }

        var segments = uri.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var currentHref = "";

        foreach (var segment in segments)
        {
            currentHref += $"/{segment}";
            
            // Skip GUIDs (IDs) in breadcrumbs for cleaner look, or display them generically
            if (Guid.TryParse(segment, out _))
            {
                _breadcrumbs.Add(new BreadcrumbItem("Details", href: null, disabled: true));
                continue;
            }

            var title = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(segment.Replace("-", " "));
            
            // Special mappings
            if (segment.Equals("mfg", StringComparison.OrdinalIgnoreCase)) title = "Manufacturing";
            if (segment.Equals("hr", StringComparison.OrdinalIgnoreCase)) title = "HR";
            if (segment.Equals("iam", StringComparison.OrdinalIgnoreCase)) title = "IAM";

            var isLast = segment == segments.Last();
            _breadcrumbs.Add(new BreadcrumbItem(title, href: isLast ? null : currentHref, disabled: isLast));
        }
    }

    // Theme-aware logo URLs
    private string LogoUrl => LayoutService.IsDarkMode
        ? "https://storage.googleapis.com/maliev.com/web-contents/images/logo-white-20px.png"
        : "https://storage.googleapis.com/maliev.com/web-contents/images/logo-black-20px.png";

    protected override void OnInitialized()
    {
        LayoutService.MajorUpdateOccurred += OnLayoutUpdate;
        Navigation.LocationChanged += OnLocationChanged;
        UpdateBreadcrumbs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutService.InitializeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/notifications"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<string>("ReceiveNotification", (message) =>
            {
                Snackbar.Add(message, Severity.Info, config =>
                {
                    config.VisibleStateDuration = 10000;
                    config.HideTransitionDuration = 500;
                    config.ShowTransitionDuration = 500;
                });
            });

            await _hubConnection.StartAsync();
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Force refresh of chat context when navigating
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private Task OnSystemPreferenceChanged(bool isSystemDark)
    {
        LayoutService.UpdateSystemPreference(isSystemDark);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await LayoutService.ToggleModeAsync();
    }

    private string GetThemeIcon() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        _ => Icons.Material.Filled.BrightnessAuto
    };

    private Color GetThemeColor() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Color.Primary,
        ThemeMode.Light => Color.Warning,
        _ => Color.Inherit
    };

    private string GetThemeTooltip() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Dark Mode",
        ThemeMode.Light => "Light Mode",
        _ => "Auto Mode"
    };

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnLayoutUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        LayoutService.MajorUpdateOccurred -= OnLayoutUpdate;
        Navigation.LocationChanged -= OnLocationChanged;
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
