@inherits LayoutComponentBase
@using System
@using Microsoft.AspNetCore.SignalR.Client
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Client.Components

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject LayoutService LayoutService
@inject CurrencyService CurrencyService
@inject ChatService ChatService
@inject BreadcrumbService BreadcrumbService
@inject CookieProvider CookieProvider
@inject IJSRuntime JSRuntime
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable

<MudThemeProvider @ref="@_mudThemeProvider" Theme="ThemeConfiguration.MalievTheme"
                  IsDarkMode="LayoutService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<div class="app-shell">
    @* ── Top Bar ── *@
    <TopBar ChatDrawerOpen="@_chatDrawerOpen"
            ChatDrawerOpenChanged="SetChatDrawerOpenAsync"
            OnToggleTheme="ToggleThemeAsync" />

    @* ── Chat Drawer (right side) ── *@
    <MudDrawer Open="@_chatDrawerOpen"
               OpenChanged="SetChatDrawerOpenAsync"
               Anchor="Anchor.End"
               ClipMode="DrawerClipMode.Never"
               Elevation="0"
               Variant="DrawerVariant.Temporary"
               Width="@ChatDrawerWidth"
               Class="@ChatDrawerClass">
        <ChatDrawer IsExpanded="@_chatDrawerExpanded"
                    IsExpandedChanged="SetChatDrawerExpandedAsync"
                    OnClose="CloseChatDrawerAsync" />
    </MudDrawer>

    @* ── Body ── *@
    <div class="body-area">
        @Body
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    private bool _chatDrawerOpen = false;
    private bool _chatDrawerExpanded = false;
    private HubConnection? _hubConnection;
    private MudThemeProvider _mudThemeProvider = null!;
    private string ChatDrawerWidth => _chatDrawerExpanded
        ? "min(1180px, calc(100vw - 32px))"
        : "min(640px, calc(100vw - 16px))";
    private string ChatDrawerClass => _chatDrawerExpanded
        ? "sidekick-chat-drawer sidekick-chat-drawer-expanded"
        : "sidekick-chat-drawer";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutService.InitializeAsync();
            await CurrencyService.InitializeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
            await SyncThemeAsync();
            StateHasChanged();

            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    _hubConnection = new HubConnectionBuilder()
                        .WithUrlAndCookies(Navigation.ToAbsoluteUri("/hubs/notifications").ToString(), CookieProvider.CookieHeader)
                        .WithAutomaticReconnect()
                        .Build();

                    _hubConnection.On<string>("ReceiveNotification", (message) =>
                    {
                        Snackbar.Add(message, Severity.Info, config =>
                        {
                            config.VisibleStateDuration = 5000;
                            config.HideTransitionDuration = 120;
                            config.ShowTransitionDuration = 120;
                        });
                        InvokeAsync(StateHasChanged);
                    });

                    await _hubConnection.StartAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error starting SignalR notification hub connection");
                }
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ChatService.CurrentContext = Navigation.Uri;
        StateHasChanged();
    }

    private async Task OnSystemPreferenceChanged(bool isSystemDark)
    {
        LayoutService.UpdateSystemPreference(isSystemDark);
        await SyncThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await LayoutService.ToggleModeAsync();
        await SyncThemeAsync();
    }

    private Task SetChatDrawerOpenAsync(bool open)
    {
        _chatDrawerOpen = open;
        if (!open)
        {
            _chatDrawerExpanded = false;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SetChatDrawerExpandedAsync(bool expanded)
    {
        _chatDrawerExpanded = expanded;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task CloseChatDrawerAsync() => SetChatDrawerOpenAsync(false);

    private async Task SyncThemeAsync()
    {
        var theme = LayoutService.IsDarkMode ? "dark" : "light";
        await JSRuntime.InvokeVoidAsync("eval",
            $"document.documentElement.setAttribute('data-maliev-theme','{theme}');");
    }

    private void OnLayoutUpdate(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}
