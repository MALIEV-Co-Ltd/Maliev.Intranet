@using MudBlazor
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject LayoutService LayoutService
@inject CurrencyService CurrencyService
@inject HttpClient Http
@implements IDisposable

<header class="topbar-root">
    @* ── Left: Logo ── *@
    <div class="topbar-left">
        <a href="/"
           class="topbar-logo-button"
           aria-label="Go to application home"
           @onclick="CloseTopbarMenus">
            <MudImage Src="@LogoUrl" Alt="MALIEV" Height="22" />
        </a>

    </div>

    @* ── Divider ── *@
    <div class="topbar-logo-divider" />

    @* ── Center: Navigation ── *@
    <nav class="topbar-nav" aria-label="Primary navigation">
        <MudNavLink Href="@_quoteNavItem.Href" Match="@_quoteNavItem.Match" Class="@_quoteNavItem.Class">@_quoteNavItem.Label</MudNavLink>

        @foreach (var group in _desktopNavGroups)
        {
            <MudMenu AnchorOrigin="Origin.BottomLeft"
                     TransformOrigin="Origin.TopLeft"
                     Dense="true"
                     Class="topbar-nav-menu"
                     PopoverClass="topbar-nav-popover">
                <ActivatorContent>
                    <button type="button"
                            class="@GetDesktopNavGroupClass(group)"
                            aria-label="@($"{group.Label} navigation")"
                            @onclick="context.ToggleAsync">
                        <MudIcon Icon="@group.Icon" Size="Size.Small" />
                        <span>@group.Label</span>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var item in group.Items)
                    {
                        <MudMenuItem Href="@item.Href"
                                     Icon="@item.Icon"
                                     Class="@GetDesktopMenuItemClass(item)">
                            <div class="topbar-nav-menu-copy">
                                <span>@item.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <small>@item.Description</small>
                                }
                            </div>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }

        <MudMenu AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Dense="true"
                 Class="topbar-nav-menu topbar-nav-more-menu"
                 PopoverClass="topbar-nav-popover topbar-nav-more-popover">
            <ActivatorContent>
                <button type="button"
                        class="@GetDesktopOverflowClass()"
                        aria-label="More navigation"
                        @onclick="context.ToggleAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Apps" Size="Size.Small" />
                    <span>More</span>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                </button>
            </ActivatorContent>
            <ChildContent>
                @foreach (var group in _desktopOverflowNavGroups)
                {
                    <div class="topbar-nav-more-section" role="presentation">
                        <div class="topbar-nav-more-section-title">
                            <MudIcon Icon="@group.Icon" Size="Size.Small" />
                            <span>@group.Label</span>
                        </div>

                        @foreach (var item in group.Items)
                        {
                            <MudMenuItem Href="@item.Href"
                                         Icon="@item.Icon"
                                         Class="@GetDesktopMenuItemClass(item)">
                                <div class="topbar-nav-menu-copy">
                                    <span>@item.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small>@item.Description</small>
                                    }
                                </div>
                            </MudMenuItem>
                        }
                    </div>
                }
            </ChildContent>
        </MudMenu>
    </nav>

    @if (_mobileNavOpen)
    {
        <div class="topbar-mobile-drawer-backdrop" aria-hidden="true" @onclick="CloseMobileNav"></div>
        <aside id="topbar-mobile-nav" class="topbar-mobile-nav-drawer" role="dialog" aria-modal="true" aria-label="Primary navigation">
            <div class="topbar-mobile-drawer-head">
                <span>Navigation</span>
                <button type="button"
                        class="topbar-mobile-drawer-close"
                        aria-label="Close navigation menu"
                        @onclick="CloseMobileNav">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </div>
            <nav class="topbar-mobile-nav-list" aria-label="Primary navigation links">
                <NavLink href="@_quoteNavItem.Href"
                         Match="@_quoteNavItem.Match"
                         class="@GetMobileNavClass(_quoteNavItem)"
                         @onclick="CloseMobileNav">
                    <MudIcon Icon="@_quoteNavItem.Icon" Size="Size.Small" />
                    <span>@_quoteNavItem.Label</span>
                </NavLink>

                @foreach (var group in _navGroups)
                {
                    <section class="topbar-mobile-nav-group" aria-label="@($"{group.Label} navigation")">
                        <div class="topbar-mobile-nav-group-title">
                            <MudIcon Icon="@group.Icon" Size="Size.Small" />
                            <span>@group.Label</span>
                        </div>

                        @foreach (var item in group.Items)
                        {
                            <NavLink href="@item.Href"
                                     Match="@item.Match"
                                     class="@GetMobileNavClass(item)"
                                     @onclick="CloseMobileNav">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                <span>@item.Label</span>
                            </NavLink>
                        }
                    </section>
                }
            </nav>
        </aside>
    }

    <div class="topbar-spacer" />

    @* Search *@
    <div class="topbar-search">
        <GlobalSearchBox Class="topbar-global-search"
                         Placeholder="Search..."
                         Limit="8" />
    </div>

    @* ── Right: Actions ── *@
    <div class="topbar-right">
        @* Currency selector *@
        <MudAutocomplete T="CurrencyDto"
                         Value="@_selectedCurrency"
                         ValueChanged="@SetCurrencyAsync"
                         SearchFunc="@SearchCurrenciesAsync"
                         ToStringFunc="@(c => c is null ? "" : $"{c.Code} {c.Symbol}")"
                         Variant="Variant.Text"
                         Margin="Margin.None"
                         Dense="true"
                         Immediate="true"
                         CoerceText="false"
                         ResetValueOnEmptyText="false"
                         ShowProgressIndicator="false"
                         Disabled="@(CurrencyService.Currencies.Count == 0)"
                         Placeholder="@(CurrencyService.Currencies.Count == 0 ? "…" : CurrencyService.Code)"
                         Class="topbar-currency-autocomplete"
                         Style="width: fit-content; min-width: max-content; max-width: max-content; flex: 0 0 auto;"
                         PopoverClass="topbar-currency-popover"
                         AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         Adornment="Adornment.End"
                         AdornmentColor="Color.Default">
            <ItemTemplate Context="c">
                <div class="topbar-currency-item">
                    <span class="maliev-mono topbar-currency-code" style="font-weight:@(c.Code == CurrencyService.Code ? "700" : "400")">@c.Code @c.Symbol</span>
                    <span class="topbar-currency-name">@c.Name</span>
                </div>
            </ItemTemplate>
        </MudAutocomplete>

        @* Theme toggle *@
        <MudTooltip Text="@GetThemeLabel()" Placement="Placement.Bottom">
            <MudIconButton Icon="@GetThemeIcon()"
                           Class="topbar-theme-toggle"
                           Size="Size.Medium"
                           OnClick="@OnToggleTheme"
                           Color="Color.Default" />
        </MudTooltip>

        @* AI Assistant *@
        <MudTooltip Text="AI Assistant" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Chat"
                           Class="topbar-chat-toggle"
                           Size="Size.Medium"
                           OnClick="@ToggleChat"
                           Color="@(ChatDrawerOpen ? Color.Primary : Color.Default)" />
        </MudTooltip>

        <div class="topbar-divider" />

        @* Profile ── *@
        <AuthorizeView Context="auth">
            <Authorized>
                <div class="topbar-profile-menu">
                    <button type="button"
                            class="topbar-profile"
                            aria-haspopup="menu"
                            aria-expanded="@_profileMenuOpen.ToString().ToLowerInvariant()"
                            aria-label="Employee menu"
                            @onclick="ToggleProfileMenu">
                        <span class="topbar-avatar">
                            @if (!string.IsNullOrEmpty(auth.User.FindFirst("picture")?.Value))
                            {
                                <MudImage Src="@auth.User.FindFirst("picture")?.Value" Alt="Avatar" />
                            }
                            else
                            {
                                @GetInitials(auth.User.Identity?.Name)
                            }
                        </span>
                        <span class="topbar-profile-info">
                            <span class="topbar-profile-name">@(auth.User.Identity?.Name ?? "User")</span>
                            <span class="topbar-profile-role">@(GetProfileSubtitle(auth.User))</span>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Color="Color.Default" Class="topbar-profile-chevron" />
                    </button>

                    @if (_profileMenuOpen)
                    {
                        <div class="topbar-profile-popover" role="menu">
                            <a class="topbar-profile-action" role="menuitem" href="/hr/profile" @onclick="CloseProfileMenu">
                                <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                                <span>My Profile</span>
                            </a>
                            <a class="topbar-profile-action" role="menuitem" href="/hr/profile?tab=preferences" @onclick="CloseProfileMenu">
                                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                                <span>Preferences</span>
                            </a>
                            <div class="topbar-profile-menu-divider" />
                            <button type="button" class="topbar-profile-action" role="menuitem" @onclick="HandleLogout">
                                <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                                <span>Sign out</span>
                            </button>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <button type="button"
                class="topbar-mobile-menu-button"
                aria-label="@MobileNavButtonLabel"
                aria-haspopup="menu"
                aria-expanded="@_mobileNavOpen.ToString().ToLowerInvariant()"
                aria-controls="topbar-mobile-nav"
                @onclick="ToggleMobileNav">
            <MudIcon Icon="@(_mobileNavOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" Size="Size.Small" />
        </button>
    </div>
</header>


@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    [Parameter] public bool ChatDrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> ChatDrawerOpenChanged { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private bool _profileMenuOpen;
    private bool _mobileNavOpen;
    private string? _profileJobTitle;

    private readonly AppNavItem _quoteNavItem = AppNavigation.Quote;
    private readonly IReadOnlyList<AppNavGroup> _navGroups = AppNavigation.PrimaryGroups;
    private readonly IReadOnlyList<AppNavGroup> _desktopNavGroups = AppNavigation.DesktopGroups;
    private readonly IReadOnlyList<AppNavGroup> _desktopOverflowNavGroups = AppNavigation.DesktopOverflowGroups;

    private string LogoUrl => LayoutService.IsDarkMode
        ? "images/logo-white.svg"
        : "images/logo.svg";

    private string MobileNavButtonLabel => _mobileNavOpen ? "Close navigation menu" : "Open navigation menu";

    private string GetThemeIcon() => LayoutService.IsDarkMode
        ? Icons.Material.Outlined.DarkMode
        : Icons.Material.Outlined.LightMode;

    private string GetThemeLabel() => LayoutService.IsDarkMode
        ? "Dark Theme"
        : "Light Theme";

    private CurrencyDto? _selectedCurrency;

    private static readonly string[] PriorityCodes = ["THB", "USD", "EUR", "GBP", "JPY"];

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        LayoutService.MajorUpdateOccurred += OnLayoutUpdate;
        CurrencyService.Changed += OnCurrencyChanged;
        await LoadProfileSummaryAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        LayoutService.MajorUpdateOccurred -= OnLayoutUpdate;
        CurrencyService.Changed -= OnCurrencyChanged;
    }

    private void OnLayoutUpdate(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnCurrencyChanged(object? sender, EventArgs e)
    {
        _selectedCurrency = CurrencyService.Currencies.FirstOrDefault(c => c.Code == CurrencyService.Code);
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (_selectedCurrency == null && CurrencyService.Currencies.Count > 0)
            _selectedCurrency = CurrencyService.Currencies.FirstOrDefault(c => c.Code == CurrencyService.Code);
    }

    private Task<IEnumerable<CurrencyDto>> SearchCurrenciesAsync(string? query, CancellationToken _)
    {
        var active = CurrencyService.Currencies.Where(c => c.IsActive).ToList();
        var currentDisplay = _selectedCurrency != null ? $"{_selectedCurrency.Code} {_selectedCurrency.Symbol}" : null;
        // When the dropdown opens, MudAutocomplete sends the current display text as the query.
        // Treat that as empty so the full prioritised list is shown rather than just the selected item.
        var isShowAll = string.IsNullOrWhiteSpace(query) ||
            (currentDisplay != null && string.Equals(query!.Trim(), currentDisplay.Trim(), StringComparison.OrdinalIgnoreCase));
        if (isShowAll)
        {
            var priority = PriorityCodes
                .Select(code => active.FirstOrDefault(c => c.Code == code))
                .Where(c => c != null)
                .Cast<CurrencyDto>();
            var rest = active.Where(c => !PriorityCodes.Contains(c.Code));
            return Task.FromResult(priority.Concat(rest));
        }
        var q = query!.Trim();
        var matches = active.Where(c =>
            c.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Symbol.Contains(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches);
    }

    private async Task SetCurrencyAsync(CurrencyDto? c)
    {
        if (c == null) return;
        _selectedCurrency = c;
        await CurrencyService.SetCurrencyAsync(c);
    }

    private async Task ToggleChat() => await ChatDrawerOpenChanged.InvokeAsync(!ChatDrawerOpen);

    private async Task LoadProfileSummaryAsync()
    {
        try
        {
            var profile = await Http.GetFromJsonAsync<EmployeeDetailDto>("api/v1/employees/me");
            _profileJobTitle = FirstNonBlank(profile?.Title);
        }
        catch
        {
            _profileJobTitle = null;
        }
    }

    private void CloseTopbarMenus()
    {
        _mobileNavOpen = false;
        _profileMenuOpen = false;
    }

    private void ToggleMobileNav()
    {
        _profileMenuOpen = false;
        _mobileNavOpen = !_mobileNavOpen;
    }

    private void CloseMobileNav() => _mobileNavOpen = false;

    private string GetDesktopNavGroupClass(AppNavGroup group) =>
        IsNavGroupActive(group) ? "topbar-nav-menu-trigger active" : "topbar-nav-menu-trigger";

    private string GetDesktopOverflowClass() =>
        _desktopOverflowNavGroups.Any(IsNavGroupActive) ? "topbar-nav-menu-trigger topbar-nav-more-trigger active" : "topbar-nav-menu-trigger topbar-nav-more-trigger";

    private string GetDesktopMenuItemClass(AppNavItem item) =>
        IsNavItemActive(item) ? "topbar-nav-menu-item active" : "topbar-nav-menu-item";

    private bool IsNavGroupActive(AppNavGroup group) => group.Items.Any(IsNavItemActive);

    private bool IsNavItemActive(AppNavItem item)
    {
        var currentRelative = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('#')[0]
            .Trim('/');
        var itemRelative = item.Href
            .TrimStart('/')
            .Split('#')[0]
            .Trim('/');

        if (itemRelative.Contains('?'))
        {
            return string.Equals(currentRelative, itemRelative, StringComparison.OrdinalIgnoreCase);
        }

        var currentPath = currentRelative.Split('?', '#')[0].Trim('/');
        var itemPath = itemRelative.Split('?', '#')[0].Trim('/');
        return item.Match == NavLinkMatch.All
            ? string.Equals(currentPath, itemPath, StringComparison.OrdinalIgnoreCase)
            : string.Equals(currentPath, itemPath, StringComparison.OrdinalIgnoreCase) ||
                currentPath.StartsWith($"{itemPath}/", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetMobileNavClass(AppNavItem item) =>
        string.IsNullOrWhiteSpace(item.Class) ? "topbar-mobile-nav-link" : $"topbar-mobile-nav-link {item.Class}";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileNavOpen = false;
        _profileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleProfileMenu()
    {
        _mobileNavOpen = false;
        _profileMenuOpen = !_profileMenuOpen;
    }

    private void CloseProfileMenu() => _profileMenuOpen = false;

    private void HandleLogout()
    {
        _mobileNavOpen = false;
        _profileMenuOpen = false;
        Navigation.NavigateTo("/api/v1/auth/logout", forceLoad: true);
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return parts[0].Length >= 2
            ? $"{parts[0][0]}{parts[0][1]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }

    private string GetProfileSubtitle(System.Security.Claims.ClaimsPrincipal user)
    {
        return FirstNonBlank(_profileJobTitle, GetJobTitle(user), "Employee");
    }

    private static string GetJobTitle(System.Security.Claims.ClaimsPrincipal user)
    {
        return FirstNonBlank(
            user.FindFirst("job_title")?.Value,
            user.FindFirst("title")?.Value,
            user.FindFirst("position")?.Value);
    }

    private static string FirstNonBlank(params string?[] values)
    {
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
    }
}
