@using MudBlazor
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject LayoutService LayoutService
@inject CurrencyService CurrencyService
@implements IDisposable

<header class="topbar-root">
    @* ── Left: Logo ── *@
    <div class="topbar-left">
        <button type="button"
                class="topbar-logo-button"
                title="Dashboard"
                aria-label="Go to dashboard"
                @onclick="@(() => Navigation.NavigateTo("/"))">
            <MudImage Src="@LogoUrl" Alt="MALIEV" Height="22" />
        </button>
    </div>

    @* ── Divider ── *@
    <div class="topbar-logo-divider" />

    @* ── Center: Navigation ── *@
    <nav class="topbar-nav">
        @foreach (var item in _navItems)
        {
            <MudNavLink Href="@item.Href" Match="@item.Match" Class="@item.Class">@item.Label</MudNavLink>
        }
    </nav>

    @* ── Search ── *@
    <div class="topbar-search">
        <div class="topbar-search-wrap">
            <svg class="topbar-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="topbar-search-input"
                   placeholder="Search customers, invoices, POs..."
                   value="@_searchString"
                   @oninput="@(e => _searchString = e.Value?.ToString() ?? "")"
                   @onkeydown="@OnSearchKeyDown" />
        </div>
    </div>

    <div style="flex: 1;" />

    @* ── Right: Actions ── *@
    <div class="topbar-right">
        @* Currency selector *@
        <MudAutocomplete T="CurrencyDto"
                         Value="@_selectedCurrency"
                         ValueChanged="@SetCurrencyAsync"
                         SearchFunc="@SearchCurrenciesAsync"
                         ToStringFunc="@(c => c is null ? "" : $"{c.Code} {c.Symbol}")"
                         Variant="Variant.Text"
                         Margin="Margin.None"
                         Dense="true"
                         CoerceText="false"
                         ResetValueOnEmptyText="false"
                         ShowProgressIndicator="false"
                         Disabled="@(CurrencyService.Currencies.Count == 0)"
                         Placeholder="@(CurrencyService.Currencies.Count == 0 ? "…" : CurrencyService.Code)"
                         Class="topbar-currency-autocomplete"
                         PopoverClass="topbar-currency-popover"
                         AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown"
                         Adornment="Adornment.End"
                         AdornmentColor="Color.Default">
            <ItemTemplate Context="c">
                <div class="topbar-currency-item">
                    <span class="maliev-mono topbar-currency-code" style="font-weight:@(c.Code == CurrencyService.Code ? "700" : "400")">@c.Code @c.Symbol</span>
                    <span class="topbar-currency-name">@c.Name</span>
                </div>
            </ItemTemplate>
        </MudAutocomplete>

        @* Theme toggle *@
        <MudTooltip Text="@GetThemeLabel()" Placement="Placement.Bottom">
            <MudIconButton Icon="@GetThemeIcon()"
                           Size="Size.Medium"
                           OnClick="@OnToggleTheme"
                           Color="Color.Default" />
        </MudTooltip>

        @* AI Assistant *@
        <MudTooltip Text="AI Assistant" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Chat"
                           Size="Size.Medium"
                           OnClick="@ToggleChat"
                           Color="@(ChatDrawerOpen ? Color.Primary : Color.Default)" />
        </MudTooltip>

        <div class="topbar-divider" />

        @* Profile ── *@
        <AuthorizeView Context="auth">
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" LockScroll="true">
                    <ActivatorContent>
                        <div class="topbar-profile">
                            <div class="topbar-avatar">
                                @if (!string.IsNullOrEmpty(auth.User.FindFirst("picture")?.Value))
                                {
                                    <MudImage Src="@auth.User.FindFirst("picture")?.Value" Alt="Avatar" />
                                }
                                else
                                {
                                    @GetInitials(auth.User.Identity?.Name)
                                }
                            </div>
                            <div class="topbar-profile-info">
                                <span class="topbar-profile-name">@(auth.User.Identity?.Name ?? "User")</span>
                                <span class="topbar-profile-role">@(GetJobTitle(auth.User))</span>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Color="Color.Default" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@HandleLogout">Logout</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </div>
</header>


@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    [Parameter] public bool ChatDrawerOpen { get; set; }
    [Parameter] public EventCallback<bool> ChatDrawerOpenChanged { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private string _searchString = "";

    private record NavItem(string Label, string Href, NavLinkMatch Match = NavLinkMatch.Prefix, string? Class = null);

    private readonly List<NavItem> _navItems =
    [
        new("Quote", "sales/projects/new", NavLinkMatch.Prefix, "topbar-nav-quote"),
        new("Dashboard", "", NavLinkMatch.All),
        new("Customers", "customers"),
        new("Accounting", "accounting"),
        new("Purchasing", "purchasing"),
        new("Admin", "admin"),
        new("IAM", "iam"),
    ];

    private string LogoUrl => LayoutService.IsDarkMode
        ? "images/logo-white.svg"
        : "images/logo.svg";

    private string GetThemeIcon() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Icons.Material.Outlined.DarkMode,
        ThemeMode.Light => Icons.Material.Outlined.LightMode,
        _ => Icons.Material.Filled.AutoMode
    };

    private string GetThemeLabel() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Dark Theme",
        ThemeMode.Light => "Light Theme",
        _ => "Auto Theme"
    };

    private CurrencyDto? _selectedCurrency;

    private static readonly string[] PriorityCodes = ["THB", "USD", "EUR", "GBP", "JPY"];

    protected override void OnInitialized()
    {
        LayoutService.MajorUpdateOccurred += OnLayoutUpdate;
        CurrencyService.Changed += OnCurrencyChanged;
    }

    public void Dispose()
    {
        LayoutService.MajorUpdateOccurred -= OnLayoutUpdate;
        CurrencyService.Changed -= OnCurrencyChanged;
    }

    private void OnLayoutUpdate(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnCurrencyChanged(object? sender, EventArgs e)
    {
        _selectedCurrency = CurrencyService.Currencies.FirstOrDefault(c => c.Code == CurrencyService.Code);
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (_selectedCurrency == null && CurrencyService.Currencies.Count > 0)
            _selectedCurrency = CurrencyService.Currencies.FirstOrDefault(c => c.Code == CurrencyService.Code);
    }

    private Task<IEnumerable<CurrencyDto>> SearchCurrenciesAsync(string? query, CancellationToken _)
    {
        var active = CurrencyService.Currencies.Where(c => c.IsActive).ToList();
        var currentDisplay = _selectedCurrency != null ? $"{_selectedCurrency.Code} {_selectedCurrency.Symbol}" : null;
        // When the dropdown opens, MudAutocomplete sends the current display text as the query.
        // Treat that as empty so the full prioritised list is shown rather than just the selected item.
        var isShowAll = string.IsNullOrWhiteSpace(query) ||
            (currentDisplay != null && string.Equals(query!.Trim(), currentDisplay.Trim(), StringComparison.OrdinalIgnoreCase));
        if (isShowAll)
        {
            var priority = PriorityCodes
                .Select(code => active.FirstOrDefault(c => c.Code == code))
                .Where(c => c != null)
                .Cast<CurrencyDto>();
            var rest = active.Where(c => !PriorityCodes.Contains(c.Code));
            return Task.FromResult(priority.Concat(rest));
        }
        var q = query!.Trim();
        var matches = active.Where(c =>
            c.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Symbol.Contains(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches);
    }

    private async Task SetCurrencyAsync(CurrencyDto? c)
    {
        if (c == null) return;
        _selectedCurrency = c;
        await CurrencyService.SetCurrencyAsync(c);
    }

    private void ExecuteSearch()
    {
        if (!string.IsNullOrWhiteSpace(_searchString))
            Navigation.NavigateTo($"/customers?search={Uri.EscapeDataString(_searchString)}");
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ExecuteSearch();
    }

    private async Task ToggleChat() => await ChatDrawerOpenChanged.InvokeAsync(!ChatDrawerOpen);

    private void HandleLogout() => Navigation.NavigateTo("/api/v1/auth/logout", forceLoad: true);

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return parts[0].Length >= 2
            ? $"{parts[0][0]}{parts[0][1]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }

    private static string GetJobTitle(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.FindFirst("job_title")?.Value
            ?? user.FindFirst("title")?.Value
            ?? user.FindFirst("position")?.Value
            ?? "Employee";
    }
}
