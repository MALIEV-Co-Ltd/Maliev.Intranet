@page "/sales/companies"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Companies - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 600;" Class="mb-4">Companies</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search companies..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      OnDebounceIntervalElapsed="OnSearch"
                      DebounceInterval="300"
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                    OnClick="@OpenCreateCompanyDialog">
            New Company
        </MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg" />
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="CompanySummaryDto" Items="@_companies" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Company Name" />
                <PropertyColumn Property="x => x.RegistrationNumber" Title="Reg #" />
                <PropertyColumn Property="x => x.VatNumber" Title="VAT #" />
                <PropertyColumn Property="x => x.ContactEmail" Title="Email" />
                <PropertyColumn Property="x => x.Segment" Title="Segment" />
                <TemplateColumn Title="Tier">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetTierColor(context.Item.Tier)">@context.Item.Tier</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{context.Item.Id}"))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Default">No companies found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
        
        <div class="d-flex justify-center pa-4">
            <MudPagination Color="Color.Primary" Count="@_totalPages" Selected="@_currentPage" SelectedChanged="OnPageChanged" />
        </div>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<CompanySummaryDto> _companies = new();
    private int _currentPage = 1;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var url = $"api/companies?page={_currentPage}";
            if (!string.IsNullOrEmpty(_searchString)) url += $"&query={Uri.EscapeDataString(_searchString)}";
            
            var response = await Http.GetFromJsonAsync<PagedResponse<CompanySummaryDto>>(url);
            if (response != null)
            {
                _companies = response.Data.ToList();
                _totalPages = response.Meta.TotalPages;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading companies: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearch(string value)
    {
        _searchString = value;
        _currentPage = 1;
        await LoadData();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private async Task OpenCreateCompanyDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateCompanyDialog>("Create Company", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
            Snackbar.Add("Company created successfully", Severity.Success);
        }
    }

    private Color GetTierColor(string tier) => tier switch
    {
        "Tier1" => Color.Success,
        "Tier2" => Color.Info,
        "Tier3" => Color.Default,
        _ => Color.Default
    };
}
