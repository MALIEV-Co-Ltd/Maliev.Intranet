    private static bool CanExtractAccountingEntry(QuickJournalForm form) =>
        !string.IsNullOrWhiteSpace(form.ExtractionText) || form.ExtractionFiles.Count > 0;

    private void OnAccountingExtractionFilesSelected(IReadOnlyList<IBrowserFile> files, QuickJournalForm form)
    {
        form.ExtractionFiles.Clear();
        form.ExtractionFiles.AddRange(files.Take(5));
        form.LastExtraction = null;
        ResetQuickJournalMessages(form);
    }

    private static void RemoveAccountingExtractionFile(QuickJournalForm form, IBrowserFile file)
    {
        form.ExtractionFiles.Remove(file);
        form.LastExtraction = null;
        ResetQuickJournalMessages(form);
    }

    private async Task ExtractAccountingEntryAsync(QuickJournalForm form, string entryType)
    {
        if (form.IsExtracting || !CanExtractAccountingEntry(form))
        {
            return;
        }

        ResetQuickJournalMessages(form);
        form.LastExtraction = null;

        var oversizedFile = form.ExtractionFiles.FirstOrDefault(file => file.Size > MaxAccountingDocumentBytes);
        if (oversizedFile is not null)
        {
            SetQuickJournalError(form, $"{oversizedFile.Name} exceeds the {MaxAccountingDocumentBytes / 1024 / 1024} MB extraction limit.");
            return;
        }

        form.IsExtracting = true;
        form.StatusMessage = "Extracting accounting data with AI...";
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(entryType), "entryType");
            if (!string.IsNullOrWhiteSpace(form.ExtractionText))
            {
                content.Add(new StringContent(form.ExtractionText), "rawText");
            }

            foreach (var file in form.ExtractionFiles)
            {
                var stream = file.OpenReadStream(MaxAccountingDocumentBytes);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }

            using var response = await Http.PostAsync("api/v1/aiprocessing/extract-accounting-entry", content);
            if (!response.IsSuccessStatusCode)
            {
                SetQuickJournalError(form, await ReadFailureMessageAsync(response, "Accounting data could not be extracted."));
                return;
            }

            var extracted = await response.Content.ReadFromJsonAsync<ExtractedAccountingEntryResponse>();
            if (extracted is null)
            {
                SetQuickJournalError(form, "Accounting extraction returned no usable data.");
                return;
            }

            await ApplyAccountingExtractionAsync(form, extracted, entryType);
            form.LastExtraction = extracted;
            form.StatusMessage = "AI filled the draft. Review the entry before creating the journal.";
        }
        catch (Exception ex)
        {
            SetQuickJournalError(form, $"Accounting data could not be extracted: {ex.Message}");
        }
        finally
        {
            form.IsExtracting = false;
        }
    }

    private async Task ApplyAccountingExtractionAsync(QuickJournalForm form, ExtractedAccountingEntryResponse extracted, string entryType)
    {
        if (extracted.Date is { } date)
        {
            form.Date = date;
        }

        SetIfPresent(value => form.Description = value, extracted.Description);
        SetIfPresent(value => form.Reference = value, extracted.Reference);

        if (extracted.Amount is > 0)
        {
            form.Amount = extracted.Amount.Value;
        }

        if (!string.IsNullOrWhiteSpace(extracted.CurrencyCode))
        {
            form.CurrencyCode = NormalizeCurrencyCode(extracted.CurrencyCode);
            if (extracted.ExchangeRateToBase is > 0)
            {
                form.ExchangeRateToBase = extracted.ExchangeRateToBase.Value;
                form.CurrencyMessage = null;
            }
            else
            {
                await OnCurrencyChangedAsync(form, form.CurrencyCode);
            }
        }

        ApplyAccountHint(entryType, isDebit: true, extracted.DebitAccountHint);
        ApplyAccountHint(entryType, isDebit: false, extracted.CreditAccountHint);
    }

    private void ApplyAccountHint(string entryType, bool isDebit, string? accountHint)
    {
        var accountId = FindAccountIdByHint(accountHint);
        if (string.IsNullOrWhiteSpace(accountId))
        {
            return;
        }

        if (string.Equals(entryType, "Income", StringComparison.OrdinalIgnoreCase))
        {
            if (isDebit)
            {
                _incomeDebitAccountId = accountId;
            }
            else
            {
                _incomeCreditAccountId = accountId;
            }
        }
        else if (isDebit)
        {
            _expenseDebitAccountId = accountId;
        }
        else
        {
            _expenseCreditAccountId = accountId;
        }
    }

    private async Task CreateJournalAsync(QuickJournalForm form, string successMessage)
    {
        if (form.IsSubmitting)
        {
            return;
        }

        if (form.Amount <= 0 || form.DebitAccountId == Guid.Empty || form.CreditAccountId == Guid.Empty)
        {
            SetQuickJournalError(form, "Enter debit account, credit account, and amount.");
            return;
        }

        if (form.ExchangeRateToBase <= 0m)
        {
            SetQuickJournalError(form, "Enter a valid exchange rate for the selected currency.");
            return;
        }

        form.IsSubmitting = true;
        form.StatusMessage = form.Document is null ? "Creating journal entry..." : "Uploading document evidence...";
        try
        {
            var hadDocument = form.Document is not null;
            var documentReference = await UploadJournalEvidenceAsync(form);
            if (hadDocument && string.IsNullOrWhiteSpace(documentReference))
            {
                return;
            }

            form.StatusMessage = "Creating journal entry...";
            var reference = CombineReference(form.Reference, documentReference);
            var currencyCode = NormalizeCurrencyCode(form.CurrencyCode);
            var bookAmount = ToBaseAmount(form.Amount, form.ExchangeRateToBase);
            var request = new CreateJournalEntryRequest
            {
                Date = form.Date,
                Description = form.Description,
                Reference = reference,
                CurrencyCode = currencyCode,
                ExchangeRateToBase = form.ExchangeRateToBase,
                Lines =
            [
                new JournalEntryLineDto { AccountId = form.DebitAccountId, Debit = bookAmount, TransactionDebit = form.Amount, Description = form.Description, Reference = reference },
                new JournalEntryLineDto { AccountId = form.CreditAccountId, Credit = bookAmount, TransactionCredit = form.Amount, Description = form.Description, Reference = reference }
            ]
            };

            using var response = await Http.PostAsJsonAsync("api/v1/accounting/journal-entries", request);
            if (!response.IsSuccessStatusCode)
            {
                SetQuickJournalError(form, await ReadFailureMessageAsync(response, "Journal entry could not be created."));
                return;
            }

            form.Reference = string.Empty;
            form.Document = null;
            form.ExtractionText = string.Empty;
            form.ExtractionFiles.Clear();
            form.LastExtraction = null;
            form.StatusMessage = successMessage;
            _journalPage = 1;
            await LoadJournalEntriesAsync();
        }
        catch (Exception ex)
        {
            SetQuickJournalError(form, $"Journal entry could not be created: {ex.Message}");
        }
        finally
        {
            form.IsSubmitting = false;
        }
    }

    private async Task OnCurrencyChangedAsync(QuickJournalForm form, string? currencyCode)
    {
        form.CurrencyCode = NormalizeCurrencyCode(currencyCode);
        form.CurrencyMessage = null;

        if (string.Equals(form.CurrencyCode, _baseCurrencyCode, StringComparison.OrdinalIgnoreCase))
        {
            form.ExchangeRateToBase = 1m;
            return;
        }

        try
        {
            var rate = await Http.GetFromJsonAsync<ExchangeRateResponse>(
                $"api/v1/referenceData/currencies/rate?from={Uri.EscapeDataString(form.CurrencyCode)}&to={Uri.EscapeDataString(_baseCurrencyCode)}");
            if (rate?.Rate > 0m)
            {
                form.ExchangeRateToBase = rate.Rate;
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        form.CurrencyMessage = $"No live rate found. Enter the {form.CurrencyCode} to {_baseCurrencyCode} rate manually.";
    }

    private async Task<string?> UploadJournalEvidenceAsync(QuickJournalForm form)
    {
        if (form.Document is null)
        {
            return null;
        }

        if (form.Document.Size > MaxAccountingDocumentBytes)
        {
            SetQuickJournalError(form, $"Document exceeds the {MaxAccountingDocumentBytes / 1024 / 1024} MB limit.");
            return null;
        }

        try
        {
            await using var stream = form.Document.OpenReadStream(MaxAccountingDocumentBytes);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            if (!string.IsNullOrWhiteSpace(form.Document.ContentType))
            {
                fileContent.Headers.ContentType = MediaTypeHeaderValue.Parse(form.Document.ContentType);
            }

            content.Add(fileContent, "file", form.Document.Name);
            var category = _tab == "Income Entry" ? "IncomeEvidence" : "ExpenseEvidence";
            using var response = await Http.PostAsync($"api/v1/accounting/documents?category={Uri.EscapeDataString(category)}", content);
            if (!response.IsSuccessStatusCode)
            {
                SetQuickJournalError(form, await ReadFailureMessageAsync(response, "Document could not be uploaded."));
                return null;
            }

            var upload = await response.Content.ReadFromJsonAsync<BffUploadResponse>();
            return string.IsNullOrWhiteSpace(upload?.UploadId) ? upload?.StoragePath : $"doc:{upload.UploadId}";
        }
        catch (Exception ex)
        {
            form.Document = null;
            SetQuickJournalError(form, $"The selected document could not be read. Choose it again before posting: {ex.Message}");
            return null;
        }
    }

    private static string? CombineReference(string? reference, string? documentReference)
    {
        var combined = string.Join(
            " | ",
            new[] { reference?.Trim(), documentReference?.Trim() }.Where(value => !string.IsNullOrWhiteSpace(value)));

        return string.IsNullOrWhiteSpace(combined)
            ? null
            : combined.Length <= 100 ? combined : combined[..100];
    }

    private static async Task<string> ReadFailureMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var details = (await response.Content.ReadAsStringAsync()).Trim();
            if (details.Length > 240)
            {
                details = $"{details[..240]}...";
            }

            return string.IsNullOrWhiteSpace(details)
                ? $"{fallback} ({(int)response.StatusCode})"
                : $"{fallback} ({(int)response.StatusCode}: {details})";
        }
        catch
        {
            return fallback;
        }
    }

