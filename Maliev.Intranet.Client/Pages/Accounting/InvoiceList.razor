@page "/accounting"
@page "/finance/invoices"
@using System.Net.Http.Headers
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Accounting | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="Accounting" Subtitle="Invoices, journal entries, reporting, periods, reconciliation, and payroll journal impact.">
        @if (IsQuickEntryTab)
        {
            <PrimaryButton Icon="@Icons.Material.Outlined.PostAdd" Busy="@IsCurrentQuickEntrySubmitting" BusyLabel="Posting..." OnClick="@CreateCurrentQuickEntryAsync">Post Entry</PrimaryButton>
        }
    </ModuleHeader>

    <PageBody Class="mlv-data-page-body">
        @if (_loading)
        {
            <ProgressiveSkeleton Layout="table" Rows="6" Columns="6" ShowFilters="false" Class="mb-3" Label="Loading invoices" />
        }

        <StatBar Class="mb-4">
            <StatTile Label="Invoice total" Value="@_invoices.Sum(i => i.Total).ToString("N2")" />
            <StatTile Label="Outstanding" Value="@_invoices.Sum(i => i.Balance).ToString("N2")" Trend="@(_invoices.Sum(i => i.Balance) <= 0)" />
            <StatTile Label="Journal debit" Value="@_journalEntries.Sum(j => j.TotalDebit).ToString("N2")" />
            <StatTile Label="Open periods" Value="@_periods.Count(p => string.Equals(p.Status, "Open", StringComparison.OrdinalIgnoreCase)).ToString("N0")" />
        </StatBar>

        <div class="mlv-toolbar">
            <div class="mlv-segmented">
                @foreach (var tab in _tabs)
                {
                    <button type="button" class="@(_tab == tab ? "active" : "")" @onclick="@(() => SetTab(tab))">@tab</button>
                }
            </div>
            <SecondaryButton Icon="@Icons.Material.Outlined.Refresh" OnClick="@ReloadAsync">Refresh</SecondaryButton>
        </div>

        @if (_tab == "Invoices")
        {
            <PanelCard Class="mlv-data-results-panel">
                @if (_invoices.Count > 0)
                {
                    <table class="mlv-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Balance</th>
                                <th>Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in _invoices)
                            {
                                <tr @onclick="@(() => Navigation.NavigateTo($"/accounting/{invoice.Id}"))">
                                    <td class="mlv-mono">@invoice.InvoiceNumber</td>
                                    <td>@invoice.CustomerName</td>
                                    <td><StatusBadge Status="@invoice.Status" /></td>
                                    <td class="mlv-mono">@invoice.Total.ToString("N2")</td>
                                    <td class="mlv-mono">@invoice.Balance.ToString("N2")</td>
                                    <td>@invoice.DueDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No invoices found.</div>
                }
            </PanelCard>
            <PaginationFooter Meta="@_invoiceMeta" CurrentPage="@_invoicePage" PageSize="@_pageSize" PageChanged="OnInvoicePageChanged" PageSizeChanged="OnPageSizeChanged" Disabled="@_loading" />
        }
        else if (_tab == "Journal Entries")
        {
            <PanelCard Class="mlv-data-results-panel">
                @if (_journalEntries.Count > 0)
                {
                    <table class="mlv-table">
                        <thead>
                            <tr>
                                <th>Entry</th>
                                <th>Status</th>
                                <th>Description</th>
                                <th>Currency</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _journalEntries)
                            {
                                <tr>
                                    <td class="mlv-mono">@entry.EntryNumber</td>
                                    <td><StatusBadge Status="@entry.Status" /></td>
                                    <td>@Display(entry.Description)</td>
                                    <td class="mlv-mono">@DisplayEntryCurrency(entry)</td>
                                    <td class="mlv-mono">@DisplayEntryAmount(entry, entry.TotalDebit, entry.TransactionTotalDebit)</td>
                                    <td class="mlv-mono">@DisplayEntryAmount(entry, entry.TotalCredit, entry.TransactionTotalCredit)</td>
                                    <td>@entry.Date.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <SecondaryButton Icon="@Icons.Material.Outlined.DoneAll" Disabled="@(!string.Equals(entry.Status, "Draft", StringComparison.OrdinalIgnoreCase))" OnClick="@(_ => PostJournalEntryAsync(entry.Id))">Post</SecondaryButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No journal entries found.</div>
                }
            </PanelCard>
            <PaginationFooter Meta="@_journalMeta" CurrentPage="@_journalPage" PageSize="@_pageSize" PageChanged="OnJournalPageChanged" PageSizeChanged="OnPageSizeChanged" Disabled="@_loading" />
        }
        else if (_tab == "Income Entry")
        {
            <PanelCard Title="Income entry">
                @AccountingAiPanel(_incomeForm, "Income")
                <FormGrid>
                    <FormField Label="Date"><input type="date" class="mlv-form-input" @bind="_incomeForm.Date" @bind:format="yyyy-MM-dd" /></FormField>
                    <FormField Label="Description"><input class="mlv-form-input" @bind="_incomeForm.Description" @bind:event="oninput" /></FormField>
                    <FormField Label="Reference"><input class="mlv-form-input" @bind="_incomeForm.Reference" @bind:event="oninput" /></FormField>
                    <FormField Label="Debit account">
                        <select class="mlv-form-input" @bind="_incomeDebitAccountId">@AccountOptions()</select>
                    </FormField>
                    <FormField Label="Credit account">
                        <select class="mlv-form-input" @bind="_incomeCreditAccountId">@AccountOptions()</select>
                    </FormField>
                    <FormField Label="Currency">
                        <select class="mlv-form-input" value="@_incomeForm.CurrencyCode" @onchange="@(args => OnCurrencyChangedAsync(_incomeForm, args.Value?.ToString()))">
                            @CurrencyOptions()
                        </select>
                    </FormField>
                    <FormField Label="Amount"><input type="number" step="0.01" class="mlv-form-input" @bind="_incomeForm.Amount" @bind:event="oninput" /></FormField>
                    <FormField Label="@($"Rate to {_baseCurrencyCode}")"><input type="number" step="0.000001" class="mlv-form-input" @bind="_incomeForm.ExchangeRateToBase" @bind:event="oninput" /></FormField>
                    <FormField Label="@($"Book amount ({_baseCurrencyCode})")">
                        <input class="mlv-form-input" value="@FormatBaseAmount(_incomeForm)" readonly />
                        @if (!string.IsNullOrWhiteSpace(_incomeForm.CurrencyMessage))
                        {
                            <div class="mlv-form-hint">@_incomeForm.CurrencyMessage</div>
                        }
                    </FormField>
                    <FormField Label="Transfer slip or receipt">
                        <InputFile class="mlv-form-input" OnChange="@(args => OnDocumentSelected(args, _incomeForm))" />
                        @if (_incomeForm.Document is not null)
                        {
                            <div class="mlv-form-hint">@_incomeForm.Document.Name</div>
                        }
                    </FormField>
                </FormGrid>
                @if (!string.IsNullOrWhiteSpace(_incomeForm.ErrorMessage))
                {
                    <div class="mlv-error mt-4" role="alert">@_incomeForm.ErrorMessage</div>
                }
                else if (!string.IsNullOrWhiteSpace(_incomeForm.StatusMessage))
                {
                    <div class="mlv-status mt-4" role="status">@_incomeForm.StatusMessage</div>
                }
                <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                    <PrimaryButton Icon="@Icons.Material.Outlined.PostAdd" Busy="@_incomeForm.IsSubmitting" BusyLabel="Creating..." OnClick="@(_ => CreateIncomeAsync())">Create income journal</PrimaryButton>
                </div>
            </PanelCard>
        }
        else if (_tab == "Expense Entry")
        {
            <PanelCard Title="Expense entry">
                @AccountingAiPanel(_expenseForm, "Expense")
                <FormGrid>
                    <FormField Label="Date"><input type="date" class="mlv-form-input" @bind="_expenseForm.Date" @bind:format="yyyy-MM-dd" /></FormField>
                    <FormField Label="Description"><input class="mlv-form-input" @bind="_expenseForm.Description" @bind:event="oninput" /></FormField>
                    <FormField Label="Reference"><input class="mlv-form-input" @bind="_expenseForm.Reference" @bind:event="oninput" /></FormField>
                    <FormField Label="Debit account">
                        <select class="mlv-form-input" @bind="_expenseDebitAccountId">@AccountOptions()</select>
                    </FormField>
                    <FormField Label="Credit account">
                        <select class="mlv-form-input" @bind="_expenseCreditAccountId">@AccountOptions()</select>
                    </FormField>
                    <FormField Label="Currency">
                        <select class="mlv-form-input" value="@_expenseForm.CurrencyCode" @onchange="@(args => OnCurrencyChangedAsync(_expenseForm, args.Value?.ToString()))">
                            @CurrencyOptions()
                        </select>
                    </FormField>
                    <FormField Label="Amount"><input type="number" step="0.01" class="mlv-form-input" @bind="_expenseForm.Amount" @bind:event="oninput" /></FormField>
                    <FormField Label="@($"Rate to {_baseCurrencyCode}")"><input type="number" step="0.000001" class="mlv-form-input" @bind="_expenseForm.ExchangeRateToBase" @bind:event="oninput" /></FormField>
                    <FormField Label="@($"Book amount ({_baseCurrencyCode})")">
                        <input class="mlv-form-input" value="@FormatBaseAmount(_expenseForm)" readonly />
                        @if (!string.IsNullOrWhiteSpace(_expenseForm.CurrencyMessage))
                        {
                            <div class="mlv-form-hint">@_expenseForm.CurrencyMessage</div>
                        }
                    </FormField>
                    <FormField Label="Receipt or supplier document">
                        <InputFile class="mlv-form-input" OnChange="@(args => OnDocumentSelected(args, _expenseForm))" />
                        @if (_expenseForm.Document is not null)
                        {
                            <div class="mlv-form-hint">@_expenseForm.Document.Name</div>
                        }
                    </FormField>
                </FormGrid>
                @if (!string.IsNullOrWhiteSpace(_expenseForm.ErrorMessage))
                {
                    <div class="mlv-error mt-4" role="alert">@_expenseForm.ErrorMessage</div>
                }
                else if (!string.IsNullOrWhiteSpace(_expenseForm.StatusMessage))
                {
                    <div class="mlv-status mt-4" role="status">@_expenseForm.StatusMessage</div>
                }
                <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                    <PrimaryButton Icon="@Icons.Material.Outlined.PostAdd" Busy="@_expenseForm.IsSubmitting" BusyLabel="Creating..." OnClick="@(_ => CreateExpenseAsync())">Create expense journal</PrimaryButton>
                </div>
            </PanelCard>
        }
        else if (_tab == "Payroll Journals")
        {
            <PanelCard Title="Payroll journal impact">
                @{
                    var payrollEntries = PayrollJournalEntries().ToList();
                }
                @if (payrollEntries.Count > 0)
                {
                    <table class="mlv-table">
                        <thead>
                            <tr>
                                <th>Entry</th>
                                <th>Status</th>
                                <th>Description</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in payrollEntries)
                            {
                                <tr>
                                    <td class="mlv-mono">@entry.EntryNumber</td>
                                    <td><StatusBadge Status="@entry.Status" /></td>
                                    <td>@Display(entry.Description)</td>
                                    <td class="mlv-mono">@entry.TotalDebit.ToString("N2")</td>
                                    <td class="mlv-mono">@entry.TotalCredit.ToString("N2")</td>
                                    <td>@entry.Date.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">Payroll journals are produced by CompensationService payroll runs. No payroll journal impact is present in the loaded journal page.</div>
                }
            </PanelCard>
        }
        else if (_tab == "Reports")
        {
            <PanelCard Title="Reports" Class="accounting-report-panel">
                <div class="accounting-report-toolbar">
                    <div class="accounting-report-filters">
                        <label class="mlv-filter-field accounting-report-field accounting-report-type-field">
                            <span>Report</span>
                            <select class="mlv-form-select" @bind="_reportType">
                                <option value="income-statement">Income statement</option>
                                <option value="balance-sheet">Balance sheet</option>
                                <option value="trial-balance">Trial balance</option>
                            </select>
                        </label>
                        <label class="mlv-filter-field accounting-report-field">
                            <span>Start</span>
                            <input type="date" class="mlv-form-input" @bind="_reportStart" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label class="mlv-filter-field accounting-report-field">
                            <span>End</span>
                            <input type="date" class="mlv-form-input" @bind="_reportEnd" @bind:format="yyyy-MM-dd" />
                        </label>
                    </div>
                    <div class="accounting-report-actions">
                        <SecondaryButton Class="accounting-report-pdf-button"
                                         Icon="@Icons.Material.Outlined.PictureAsPdf"
                                         Href="@ReportPdfDownloadUrl"
                                         Download="@ReportPdfDownloadName"
                                         AriaLabel="Download accounting report as PDF">Download PDF</SecondaryButton>
                        <PrimaryButton Class="accounting-report-run-button" Icon="@Icons.Material.Outlined.Assessment" OnClick="@LoadReportAsync">Run Report</PrimaryButton>
                    </div>
                </div>
                @if (_report is null)
                {
                    <div class="mlv-empty accounting-report-empty">Run a report to view accounting totals.</div>
                }
                else
                {
                    <div class="accounting-report-statement">
                        <div class="accounting-report-header">
                            <div>
                                <div class="accounting-report-title">@_report.ReportName</div>
                                <div class="accounting-report-period">@ReportPeriodLabel()</div>
                            </div>
                        </div>
                        @foreach (var reportSection in _report.Sections)
                        {
                            <section class="accounting-report-section">
                                <h4 class="accounting-report-section-title">@reportSection.Title</h4>
                                <table class="mlv-table accounting-report-table">
                                    <thead><tr><th>Account</th><th>Amount</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in reportSection.Rows)
                                        {
                                            <tr><td>@row.Label</td><td class="mlv-mono">@row.Amount.ToString("N2")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </section>
                        }
                    </div>
                }
            </PanelCard>
        }
        else if (_tab == "Periods")
        {
            <PanelCard Title="Periods and reconciliation">
                <div class="mlv-toolbar mb-3">
                    <div class="mlv-toolbar-left">
                        <label class="mlv-filter-field">
                            <span>Open date</span>
                            <input type="date" class="mlv-form-input" @bind="_periodOpenDate" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label class="mlv-filter-field accounting-reconciliation-source-field">
                            <span>Source ledger</span>
                            <select class="mlv-form-select accounting-reconciliation-source-select" @bind="_reconciliationSource">
                                @foreach (var source in _reconciliationSources)
                                {
                                    <option value="@source.Value">@source.Label</option>
                                }
                            </select>
                            <span class="mlv-form-hint accounting-reconciliation-source-hint">@SelectedReconciliationSourceDescription</span>
                        </label>
                    </div>
                    <PrimaryButton Icon="@Icons.Material.Outlined.LockOpen" OnClick="@OpenPeriodAsync">Open Period</PrimaryButton>
                </div>
                @if (_periods.Count > 0)
                {
                    <table class="mlv-table">
                        <thead><tr><th>Period</th><th>Status</th><th>Dates</th><th>Fiscal year</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var period in _periods)
                            {
                                <tr>
                                    <td>@period.Name</td>
                                    <td><StatusBadge Status="@period.Status" /></td>
                                    <td>@period.StartDate.ToString("dd MMM yyyy") - @period.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>@period.FiscalYear</td>
                                    <td>
                                        <SecondaryButton Icon="@Icons.Material.Outlined.Sync" OnClick="@(_ => RunReconciliationAsync(period.Id))">Reconcile</SecondaryButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No periods loaded.</div>
                }
                @if (_reconciliation is not null)
                {
                    <div class="mlv-error mt-3">@_reconciliation.SourceSystem reconciliation: @_reconciliation.Status, @_reconciliation.DifferenceCount differences, @_reconciliation.DifferenceAmount.ToString("N2") net difference.</div>
                }
            </PanelCard>
        }
    </PageBody>
</div>

@code {
    private const long MaxAccountingDocumentBytes = 25 * 1024 * 1024;

    private readonly string[] _tabs = ["Invoices", "Journal Entries", "Income Entry", "Expense Entry", "Reports", "Periods", "Payroll Journals"];
    private readonly ReconciliationSourceOption[] _reconciliationSources =
    [
        new("Sales", "Sales", "Invoices, receipts, and customer receivables"),
        new("Procurement", "Procurement", "Supplier invoices and purchasing payables"),
        new("Inventory", "Inventory", "Stock movements and inventory valuation"),
        new("Payroll", "Payroll", "CompensationService payroll journal impact"),
        new("System", "System imports", "Opening balances and administrative imports")
    ];
    private string _tab = "Invoices";
    private List<InvoiceSummaryDto> _invoices = [];
    private List<JournalEntryDto> _journalEntries = [];
    private List<AccountingPeriodDto> _periods = [];
    private List<ChartOfAccountDto> _accounts = [];
    private List<CurrencyDto> _currencies = [];
    private PaymentStatsDto? _paymentStats;
    private FinancialReportDto? _report;
    private ReconciliationResultDto? _reconciliation;
    private PaginationMeta _invoiceMeta = new();
    private PaginationMeta _journalMeta = new();
    private bool _loading = true;
    private int _invoicePage = 1;
    private int _journalPage = 1;
    private int _pageSize = 20;
    private string _reportType = "income-statement";
    private DateTime _reportStart = DateTime.Today.AddDays(-30);
    private DateTime _reportEnd = DateTime.Today;
    private DateTime _periodOpenDate = DateTime.Today;
    private string _reconciliationSource = "Sales";
    private QuickJournalForm _incomeForm = new() { Description = "Income receipt", Amount = 0 };
    private QuickJournalForm _expenseForm = new() { Description = "Expense payment", Amount = 0 };
    private string _incomeDebitAccountId = string.Empty;
    private string _incomeCreditAccountId = string.Empty;
    private string _expenseDebitAccountId = string.Empty;
    private string _expenseCreditAccountId = string.Empty;
    private string _baseCurrencyCode = "THB";

    private bool IsQuickEntryTab => _tab is "Income Entry" or "Expense Entry";

    private bool IsCurrentQuickEntrySubmitting =>
        _tab == "Income Entry"
            ? _incomeForm.IsSubmitting
            : _tab == "Expense Entry" && _expenseForm.IsSubmitting;

    private RenderFragment AccountingAiPanel(QuickJournalForm form, string entryType) => @<section class="accounting-ai-panel" aria-label="@($"{entryType} AI accounting extraction")">
        <div class="accounting-ai-panel-head">
            <span class="accounting-ai-icon">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
            </span>
            <span>
                <strong>AI-assisted data entry</strong>
                <small>Drag and drop receipts, transfer slips, invoices, or screenshots</small>
            </span>
        </div>

        <div class="accounting-ai-grid">
            <label class="accounting-ai-text-field">
                <span>Paste evidence text</span>
                <textarea class="mlv-form-textarea accounting-ai-textarea"
                          maxlength="4000"
                          @bind="form.ExtractionText"
                          @bind:event="oninput"
                          placeholder="Paste bank slip text, invoice lines, email payment details, or OCR text..."></textarea>
                <small>@form.ExtractionText.Length / 4,000 characters</small>
            </label>

            <div class="accounting-ai-file-panel">
                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                               FilesChanged="@(files => OnAccountingExtractionFilesSelected(files, form))"
                               Accept=".pdf,.jpg,.jpeg,.png,.webp,.txt,.csv"
                               Hidden="true"
                               MaximumFileCount="5">
                    <CustomContent Context="uploadContext">
                        <button type="button" class="accounting-ai-dropzone" @onclick="@uploadContext.OpenFilePickerAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" />
                            <span>
                                <strong>Drop accounting evidence</strong>
                                <small>PDF, image, text, or CSV - max 25 MB each</small>
                            </span>
                        </button>
                    </CustomContent>
                </MudFileUpload>

                @if (form.ExtractionFiles.Count > 0)
                {
                    <div class="accounting-ai-files" aria-label="Selected accounting extraction files">
                        @foreach (var file in form.ExtractionFiles)
                        {
                            <div class="accounting-ai-file">
                                <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                                <span>
                                    <strong>@file.Name</strong>
                                    <small>@FormatFileSize(file.Size)</small>
                                </span>
                                <button type="button" aria-label="@($"Remove {file.Name}")" @onclick="@(() => RemoveAccountingExtractionFile(form, file))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="accounting-ai-actions">
            <SecondaryButton Icon="@Icons.Material.Outlined.AutoFixHigh"
                             Disabled="@(form.IsExtracting || !CanExtractAccountingEntry(form))"
                             OnClick="@(_ => ExtractAccountingEntryAsync(form, entryType))">
                @(form.IsExtracting ? "Extracting..." : "Extract and autofill")
            </SecondaryButton>
        </div>

        @if (form.IsExtracting)
        {
            <div class="accounting-ai-processing" role="status" aria-live="polite">
                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                <span>Reading evidence with AI...</span>
            </div>
        }
        else if (form.LastExtraction is not null)
        {
            <div class="accounting-ai-summary" role="status" aria-live="polite">
                <div>
                    <strong>AI draft @($"{form.LastExtraction.Confidence:P0}")</strong>
                    <span>@GetAccountingExtractionSummary(form)</span>
                </div>
                @if (form.LastExtraction.MissingFields.Count > 0)
                {
                    <small>Needs review: @string.Join(", ", form.LastExtraction.MissingFields)</small>
                }
            </div>
        }
    </section>;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void SetTab(string tab) => _tab = tab;

    private async Task ReloadAsync(MouseEventArgs _) => await LoadAsync();

    private async Task OnInvoicePageChanged(int page)
    {
        _invoicePage = page;
        await LoadInvoicesAsync();
    }

    private async Task OnJournalPageChanged(int page)
    {
        _journalPage = page;
        await LoadJournalEntriesAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _invoicePage = 1;
        _journalPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await Task.WhenAll(LoadInvoicesAsync(), LoadJournalEntriesAsync(), LoadPeriodsAsync(), LoadPaymentStatsAsync(), LoadAccountsAsync(), LoadCurrenciesAsync());
            ApplyAccountDefaults();
            ApplyCurrencyDefaults();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Accounting data could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInvoicesAsync()
    {
        var response = await Http.GetFromJsonAsync<PagedResponse<InvoiceSummaryDto>>($"api/v1/invoices?page={_invoicePage}&pageSize={_pageSize}");
        _invoices = response?.Data.ToList() ?? [];
        _invoiceMeta = response?.Meta ?? new();
        _invoiceMeta.CurrentPage = _invoiceMeta.CurrentPage == 0 ? _invoicePage : _invoiceMeta.CurrentPage;
        _invoiceMeta.PageSize = _invoiceMeta.PageSize == 0 ? _pageSize : _invoiceMeta.PageSize;
    }

    private async Task LoadJournalEntriesAsync()
    {
        var response = await Http.GetFromJsonAsync<PagedResponse<JournalEntryDto>>($"api/v1/accounting/journal-entries?page={_journalPage}&pageSize={_pageSize}");
        _journalEntries = response?.Data.ToList() ?? [];
        _journalMeta = response?.Meta ?? new();
        _journalMeta.CurrentPage = _journalMeta.CurrentPage == 0 ? _journalPage : _journalMeta.CurrentPage;
        _journalMeta.PageSize = _journalMeta.PageSize == 0 ? _pageSize : _journalMeta.PageSize;
    }

    private async Task LoadPeriodsAsync()
    {
        _periods = await Http.GetFromJsonAsync<List<AccountingPeriodDto>>("api/v1/accounting/periods") ?? [];
    }

    private async Task LoadPaymentStatsAsync()
    {
