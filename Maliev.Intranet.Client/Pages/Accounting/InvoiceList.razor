    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string DisplayEntryCurrency(JournalEntryDto entry) =>
        string.IsNullOrWhiteSpace(entry.CurrencyCode) ? _baseCurrencyCode : entry.CurrencyCode;

    private string DisplayEntryAmount(JournalEntryDto entry, decimal baseAmount, decimal transactionAmount)
    {
        var currencyCode = DisplayEntryCurrency(entry);
        var sourceAmount = transactionAmount != 0m || baseAmount == 0m ? transactionAmount : baseAmount;
        if (string.Equals(currencyCode, _baseCurrencyCode, StringComparison.OrdinalIgnoreCase))
        {
            return $"{_baseCurrencyCode} {baseAmount:N2}";
        }

        return $"{currencyCode} {sourceAmount:N2} / {_baseCurrencyCode} {baseAmount:N2}";
    }

    private static decimal ToBaseAmount(decimal amount, decimal exchangeRateToBase) =>
        decimal.Round(amount * exchangeRateToBase, 2, MidpointRounding.AwayFromZero);

    private string FormatBaseAmount(QuickJournalForm form) =>
        $"{ToBaseAmount(form.Amount, form.ExchangeRateToBase):N2}";

    private static string NormalizeCurrencyCode(string? currencyCode) =>
        string.IsNullOrWhiteSpace(currencyCode) ? "THB" : currencyCode.Trim().ToUpperInvariant();

    private bool PrepareAccounts(QuickJournalForm form, string debitAccountId, string creditAccountId)
    {
        if (!Guid.TryParse(debitAccountId, out var debitId) || !Guid.TryParse(creditAccountId, out var creditId))
        {
            SetQuickJournalError(form, "Select valid debit and credit accounts.");
            return false;
        }

        form.DebitAccountId = debitId;
        form.CreditAccountId = creditId;
        return true;
    }

    private static void ResetQuickJournalMessages(QuickJournalForm form)
    {
        form.ErrorMessage = null;
        form.StatusMessage = null;
    }

    private static void SetQuickJournalError(QuickJournalForm form, string message)
    {
        form.StatusMessage = null;
        form.ErrorMessage = message;
    }

    private void ApplyAccountDefaults()
    {
        _incomeDebitAccountId = DefaultAccount("Asset") ?? _incomeDebitAccountId;
        _incomeCreditAccountId = DefaultAccount("Revenue", "Income") ?? _incomeCreditAccountId;
        _expenseDebitAccountId = DefaultAccount("Expense") ?? _expenseDebitAccountId;
        _expenseCreditAccountId = DefaultAccount("Asset", "Liability") ?? _expenseCreditAccountId;
    }

    private void ApplyCurrencyDefaults()
    {
        ApplyCurrencyDefault(_incomeForm);
        ApplyCurrencyDefault(_expenseForm);
    }

    private void ApplyCurrencyDefault(QuickJournalForm form)
    {
        form.CurrencyCode = string.IsNullOrWhiteSpace(form.CurrencyCode) ? _baseCurrencyCode : NormalizeCurrencyCode(form.CurrencyCode);
        if (string.Equals(form.CurrencyCode, _baseCurrencyCode, StringComparison.OrdinalIgnoreCase) && form.ExchangeRateToBase <= 0m)
        {
            form.ExchangeRateToBase = 1m;
        }
    }

    private IEnumerable<JournalEntryDto> PayrollJournalEntries() =>
        _journalEntries.Where(entry =>
            (entry.Description?.Contains("payroll", StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Reference?.Contains("payroll", StringComparison.OrdinalIgnoreCase) ?? false) ||
            entry.Lines.Any(line => line.Description.Contains("payroll", StringComparison.OrdinalIgnoreCase) ||
                                    (line.Reference?.Contains("payroll", StringComparison.OrdinalIgnoreCase) ?? false)));

    private string? DefaultAccount(params string[] typeHints)
    {
        return _accounts.FirstOrDefault(account =>
            typeHints.Any(hint =>
                account.Type.Contains(hint, StringComparison.OrdinalIgnoreCase) ||
                (account.Category?.Contains(hint, StringComparison.OrdinalIgnoreCase) ?? false) ||
                account.Name.Contains(hint, StringComparison.OrdinalIgnoreCase)))?.Id.ToString();
    }

    private string? FindAccountIdByHint(string? accountHint)
    {
        if (string.IsNullOrWhiteSpace(accountHint))
        {
            return null;
        }

        var hint = accountHint.Trim();
        return _accounts.FirstOrDefault(account =>
            string.Equals(account.AccountNumber, hint, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(account.Code, hint, StringComparison.OrdinalIgnoreCase) ||
            account.Name.Contains(hint, StringComparison.OrdinalIgnoreCase) ||
            hint.Contains(account.Name, StringComparison.OrdinalIgnoreCase) ||
            account.Type.Contains(hint, StringComparison.OrdinalIgnoreCase) ||
            (account.Category?.Contains(hint, StringComparison.OrdinalIgnoreCase) ?? false))?.Id.ToString();
    }

    private static void SetIfPresent(Action<string> setter, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            setter(value.Trim());
        }
    }

    private static string GetAccountingExtractionSummary(QuickJournalForm form)
    {
        var extraction = form.LastExtraction;
        if (extraction is null)
        {
            return string.Empty;
        }

        var extractedCount = extraction.ExtractedFields.Count;
        var missingCount = extraction.MissingFields.Count;
        return missingCount == 0
            ? $"{extractedCount} fields filled. Nothing obvious is missing."
            : $"{extractedCount} fields filled. {missingCount} field(s) need manual input.";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes / 1024d / 1024d:0.#} MB";
    }

    private static IEnumerable<ChartOfAccountDto> FlattenAccounts(IEnumerable<ChartOfAccountDto> accounts)
    {
        foreach (var account in accounts)
        {
            yield return account;

            foreach (var child in FlattenAccounts(account.Children))
            {
                yield return child;
            }
        }
    }

    private RenderFragment AccountOptions() => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", string.Empty);
        builder.AddContent(sequence++, "Select account");
        builder.CloseElement();

        foreach (var account in _accounts)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", account.Id.ToString());
            builder.AddContent(sequence++, $"{account.AccountNumber} - {account.Name}");
            builder.CloseElement();
        }
    };

    private RenderFragment CurrencyOptions() => builder =>
    {
        var sequence = 0;
        var currencies = _currencies.Count > 0
            ? _currencies
            : [new CurrencyDto { Code = "THB", Name = "Thai Baht", Symbol = "฿", DecimalPlaces = 2, IsActive = true, IsPrimary = true }];

        foreach (var currency in currencies)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", currency.Code);
            builder.AddContent(sequence++, $"{currency.Code} - {currency.Name}");
            builder.CloseElement();
        }
    };

    private sealed record ReconciliationSourceOption(string Value, string Label, string Description);

    private sealed class QuickJournalForm
    {
        public DateTime Date { get; set; } = DateTime.Today;

        public string Description { get; set; } = string.Empty;

        public string? Reference { get; set; }

        public Guid DebitAccountId { get; set; }

        public Guid CreditAccountId { get; set; }

        public decimal Amount { get; set; }

        public string CurrencyCode { get; set; } = "THB";

        public decimal ExchangeRateToBase { get; set; } = 1m;

        public string? CurrencyMessage { get; set; }

        public IBrowserFile? Document { get; set; }

        public string ExtractionText { get; set; } = string.Empty;

        public List<IBrowserFile> ExtractionFiles { get; } = [];

        public ExtractedAccountingEntryResponse? LastExtraction { get; set; }

        public bool IsExtracting { get; set; }

        public bool IsSubmitting { get; set; }

        public string? StatusMessage { get; set; }

        public string? ErrorMessage { get; set; }
    }

