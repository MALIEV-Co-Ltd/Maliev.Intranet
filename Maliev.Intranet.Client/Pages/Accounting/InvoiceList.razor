    private async Task LoadAccountsAsync()
    {
        var accounts = await Http.GetFromJsonAsync<List<ChartOfAccountDto>>("api/v1/accounting/accounts-tree") ?? [];
        _accounts = FlattenAccounts(accounts).Where(account => account.IsActive).ToList();
    }

    private async Task LoadCurrenciesAsync()
    {
        try
        {
            var currencies = await Http.GetFromJsonAsync<List<CurrencyDto>>("api/v1/referenceData/currencies") ?? [];
            _currencies = currencies
                .Where(currency => currency.IsActive)
                .OrderByDescending(currency => currency.IsPrimary)
                .ThenBy(currency => currency.Code)
                .ToList();
            _baseCurrencyCode = NormalizeCurrencyCode(
                _currencies.FirstOrDefault(currency => currency.IsPrimary)?.Code ?? "THB");
        }
        catch (Exception ex)
        {
            _currencies = [];
            _baseCurrencyCode = "THB";
            Console.WriteLine(ex.Message);
        }
    }

