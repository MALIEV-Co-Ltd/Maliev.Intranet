@page "/finance/delivery-notes/new"
@using Maliev.Intranet.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ShippingService ShippingService

<PageTitle>New Delivery Note | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="New Delivery Note" Subtitle="Create shipment documentation from a customer order or purchase-order context.">
        <SecondaryButton Icon="@Icons.Material.Outlined.ArrowBack" Href="/finance/delivery-notes">Back to Delivery Notes</SecondaryButton>
    </ModuleHeader>

    <PageBody>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }

        <PanelCard Title="Shipment identity">
            <FormGrid>
                <FormField Label="Source order ID"><input class="mlv-form-input" @bind="_request.OrderId" @bind:event="oninput" /></FormField>
                <FormField Label="Purchase order ID"><input type="number" class="mlv-form-input" @bind="_purchaseOrderIdText" @bind:event="oninput" /></FormField>
                <FormField Label="Customer ID"><input class="mlv-form-input" @bind="_customerIdText" @bind:event="oninput" /></FormField>
                <FormField Label="Customer name"><input class="mlv-form-input" @bind="_request.CustomerName" @bind:event="oninput" /></FormField>
                <FormField Label="Delivery date"><input type="date" class="mlv-form-input" @bind="_request.DeliveryDate" @bind:format="yyyy-MM-dd" /></FormField>
                <FormField Label="Carrier">
                    <select class="mlv-form-input" @bind="_selectedCourierCode">
                        <option value="">Any available courier</option>
                        @foreach (var courier in _couriers)
                        {
                            <option value="@courier.CourierCode">@CourierOptionLabel(courier)</option>
                        }
                    </select>
                </FormField>
                <FormField Label="Tracking number"><input class="mlv-form-input" @bind="_request.TrackingNumber" @bind:event="oninput" /></FormField>
                <FormField Label="Shipping cost"><input type="number" step="0.01" class="mlv-form-input" @bind="_request.ShippingCost" @bind:event="oninput" /></FormField>
                <FormField Label="Shipping currency">
                    <select class="mlv-form-input" @bind="_request.ShippingCostCurrency">
                        @foreach (var currency in CurrencyOptions())
                        {
                            <option value="@currency.Code">@CurrencyOptionLabel(currency)</option>
                        }
                    </select>
                </FormField>
                <FormField Label="Parcel weight (g)"><input type="number" step="1" min="1" class="mlv-form-input" @bind="_parcelWeightGrams" @bind:event="oninput" /></FormField>
                <FormField Label="Parcel length (cm)"><input type="number" step="0.1" min="0.1" class="mlv-form-input" @bind="_parcelLengthCm" @bind:event="oninput" /></FormField>
                <FormField Label="Parcel width (cm)"><input type="number" step="0.1" min="0.1" class="mlv-form-input" @bind="_parcelWidthCm" @bind:event="oninput" /></FormField>
                <FormField Label="Parcel height (cm)"><input type="number" step="0.1" min="0.1" class="mlv-form-input" @bind="_parcelHeightCm" @bind:event="oninput" /></FormField>
            </FormGrid>
            <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                <SecondaryButton Icon="@Icons.Material.Outlined.LocalShipping" Disabled="@_fetchingRates" OnClick="@FetchRatesAsync">
                    @(_fetchingRates ? "Checking rates..." : "Get Courier Rates")
                </SecondaryButton>
            </div>
            @if (_rateOptions.Count > 0)
            {
                <div class="mlv-list mt-4">
                    @foreach (var rate in _rateOptions)
                    {
                        <button type="button" class="mlv-list-row" @onclick="@(() => SelectRate(rate))">
                            <span>@RateOptionLabel(rate)</span>
                            <strong>@rate.TotalPrice.ToString("N2") @rate.CurrencyCode</strong>
                        </button>
                    }
                </div>
            }
        </PanelCard>

        <PanelCard Title="Destination">
            <FormGrid>
                <FormField Label="Address line 1"><input class="mlv-form-input" @bind="_request.ShippingAddressLine1" @bind:event="oninput" /></FormField>
                <FormField Label="Address line 2"><input class="mlv-form-input" @bind="_request.ShippingAddressLine2" @bind:event="oninput" /></FormField>
                <FormField Label="City"><input class="mlv-form-input" @bind="_request.ShippingCity" @bind:event="oninput" /></FormField>
                <FormField Label="Province"><input class="mlv-form-input" @bind="_request.ShippingProvince" @bind:event="oninput" /></FormField>
                <FormField Label="Postal code"><input class="mlv-form-input" @bind="_request.ShippingPostalCode" @bind:event="oninput" /></FormField>
                <FormField Label="Country">
                    <select class="mlv-form-input" @bind="_request.ShippingCountry">
                        @foreach (var country in CountryOptions())
                        {
                            <option value="@country.Name">@CountryOptionLabel(country)</option>
                        }
                    </select>
                </FormField>
                <FormField Label="Contact name"><input class="mlv-form-input" @bind="_request.DeliveryContactName" @bind:event="oninput" /></FormField>
                <FormField Label="Contact phone"><input class="mlv-form-input" @bind="_request.DeliveryContactPhone" @bind:event="oninput" /></FormField>
                <FormField Label="Contact email"><input type="email" class="mlv-form-input" @bind="_request.DeliveryContactEmail" @bind:event="oninput" /></FormField>
                <FormField Label="Delivery instructions"><textarea class="mlv-form-input" rows="3" @bind="_request.DeliveryInstructions" @bind:event="oninput"></textarea></FormField>
            </FormGrid>
        </PanelCard>

        <PanelCard Title="Delivery item">
            <FormGrid>
                <FormField Label="Product code"><input class="mlv-form-input" @bind="_item.ProductCode" @bind:event="oninput" /></FormField>
                <FormField Label="Product name"><input class="mlv-form-input" @bind="_item.ProductName" @bind:event="oninput" /></FormField>
                <FormField Label="Description"><input class="mlv-form-input" @bind="_item.ProductDescription" @bind:event="oninput" /></FormField>
                <FormField Label="Ordered quantity"><input type="number" step="0.01" class="mlv-form-input" @bind="_item.QuantityOrdered" @bind:event="oninput" /></FormField>
                <FormField Label="Manufactured quantity"><input type="number" step="0.01" class="mlv-form-input" @bind="_item.QuantityManufactured" @bind:event="oninput" /></FormField>
                <FormField Label="Delivered quantity"><input type="number" step="0.01" class="mlv-form-input" @bind="_item.QuantityDelivered" @bind:event="oninput" /></FormField>
                <FormField Label="Unit"><input class="mlv-form-input" @bind="_item.UnitOfMeasure" @bind:event="oninput" /></FormField>
                <FormField Label="Item notes"><input class="mlv-form-input" @bind="_item.ItemNotes" @bind:event="oninput" /></FormField>
            </FormGrid>

            <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                <PrimaryButton Icon="@Icons.Material.Outlined.LocalShipping" Disabled="@_saving" OnClick="@CreateAsync">Create Delivery Note</PrimaryButton>
            </div>
        </PanelCard>
    </PageBody>
</div>

@code {
    private CreateDeliveryNoteRequest _request = new()
    {
        DeliveryDate = DateTime.Today.AddDays(1),
        ShippingCountry = "Thailand",
        ShippingCostCurrency = "THB"
    };
    private readonly List<CountryDto> _countries = [];
    private readonly List<CurrencyDto> _currencies = [];
    private readonly List<ShippingCourierDto> _couriers = [];
    private readonly List<ShippingRateOptionDto> _rateOptions = [];
    private CreateDeliveryNoteItemRequest _item = new()
    {
        UnitOfMeasure = "pcs",
        QuantityOrdered = 1,
        QuantityManufactured = 1,
        QuantityDelivered = 1
    };
    private string _customerIdText = string.Empty;
    private string _purchaseOrderIdText = string.Empty;
    private string? _error;
    private bool _saving;
    private bool _fetchingRates;
    private string _selectedCourierCode = "";
    private decimal _parcelWeightGrams = 1000m;
    private decimal _parcelLengthCm = 20m;
    private decimal _parcelWidthCm = 15m;
    private decimal _parcelHeightCm = 10m;

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            var currenciesTask = Http.GetFromJsonAsync<List<CurrencyDto>>("api/v1/referenceData/currencies");
            var countriesTask = Http.GetFromJsonAsync<List<CountryDto>>("api/v1/referenceData/countries");
            var couriersTask = ShippingService.GetCouriersAsync();
            await Task.WhenAll(currenciesTask, countriesTask, couriersTask);

            _currencies.Clear();
            _currencies.AddRange(currenciesTask.Result ?? []);
            _countries.Clear();
            _countries.AddRange(countriesTask.Result ?? []);
            _couriers.Clear();
            _couriers.AddRange(couriersTask.Result ?? []);

            _request.ShippingCostCurrency = NormalizeCurrencyCode(_request.ShippingCostCurrency);
            _request.ShippingCountry = NormalizeCountryName(_request.ShippingCountry);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load reference data: {ex.Message}", Severity.Warning);
        }
    }

    private async Task FetchRatesAsync(MouseEventArgs _)
    {
        _error = ValidateShippingQuoteInputs();
        if (_error is not null)
        {
            Snackbar.Add(_error, Severity.Warning);
            return;
        }

        _fetchingRates = true;
        _rateOptions.Clear();
        try
        {
            var result = await ShippingService.GetRatesAsync(BuildShippingRateRequest());
            if (result?.Rates is { Count: > 0 })
            {
                _rateOptions.AddRange(result.Rates);
            }
            else
            {
                Snackbar.Add("No courier rates returned for this shipment.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to fetch courier rates: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _fetchingRates = false;
        }
    }

    private void SelectRate(ShippingRateOptionDto rate)
    {
        _request.CarrierName = rate.ProductName;
        _request.ShippingCost = rate.TotalPrice;
        _request.ShippingCostCurrency = NormalizeCurrencyCode(rate.CurrencyCode);
        _selectedCourierCode = rate.CourierCode;
        _rateOptions.Clear();
    }

    private ShippingRateRequestDto BuildShippingRateRequest()
    {
        return new ShippingRateRequestDto
        {
            From = new ShippingAddressDto
            {
                Name = "MALIEV",
                Address = "MALIEV",
                District = "Pathum Wan",
                State = "Pathum Wan",
                Province = "Bangkok",
                Postcode = "10400",
                Tel = "020000000"
            },
            To = new ShippingAddressDto
            {
                Name = FirstNonEmpty(_request.DeliveryContactName, _request.CustomerName, "Customer"),
                Address = FirstNonEmpty(_request.ShippingAddressLine1),
                District = FirstNonEmpty(_request.ShippingCity),
                State = FirstNonEmpty(_request.ShippingCity),
                Province = FirstNonEmpty(_request.ShippingProvince),
                Postcode = FirstNonEmpty(_request.ShippingPostalCode),
                Tel = FirstNonEmpty(_request.DeliveryContactPhone),
                Email = string.IsNullOrWhiteSpace(_request.DeliveryContactEmail) ? null : _request.DeliveryContactEmail
            },
            Parcel = new ShippingParcelDto
            {
                Name = FirstNonEmpty(_item.ProductName, "MALIEV shipment"),
                Weight = Math.Max(1m, _parcelWeightGrams),
                Length = Math.Max(0.1m, _parcelLengthCm),
                Width = Math.Max(0.1m, _parcelWidthCm),
                Height = Math.Max(0.1m, _parcelHeightCm)
            },
            CourierCodes = string.IsNullOrWhiteSpace(_selectedCourierCode) ? [] : [_selectedCourierCode]
        };
    }

    private string? ValidateShippingQuoteInputs()
    {
        if (string.IsNullOrWhiteSpace(_request.ShippingAddressLine1) ||
            string.IsNullOrWhiteSpace(_request.ShippingCity) ||
            string.IsNullOrWhiteSpace(_request.ShippingProvince) ||
            string.IsNullOrWhiteSpace(_request.ShippingPostalCode) ||
            string.IsNullOrWhiteSpace(_request.DeliveryContactPhone))
        {
            return "Enter destination address, city, province, postal code, and contact phone before checking courier rates.";
        }

        if (_parcelWeightGrams <= 0 || _parcelLengthCm <= 0 || _parcelWidthCm <= 0 || _parcelHeightCm <= 0)
        {
            return "Enter positive parcel weight and dimensions before checking courier rates.";
        }

        return null;
    }

    private async Task CreateAsync(MouseEventArgs _)
    {
        _error = ValidateAndPrepare();
        if (_error is not null)
        {
            Snackbar.Add(_error, Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _request.Items = [_item];
            var response = await Http.PostAsJsonAsync("api/v1/deliverynotes", _request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = $"Delivery note could not be created. HTTP {(int)response.StatusCode}: {body}";
                Snackbar.Add("Delivery note could not be created.", Severity.Warning);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<DeliveryNoteDetailDto>();
            if (created is null || string.IsNullOrWhiteSpace(created.DeliveryNoteId))
            {
                _error = "DeliveryService did not return a delivery note identifier.";
                Snackbar.Add(_error, Severity.Warning);
                return;
            }

            Snackbar.Add("Delivery note created.", Severity.Success);
            Navigation.NavigateTo($"/finance/delivery-notes/{created.DeliveryNoteId}");
        }
        finally
        {
            _saving = false;
        }
    }

    private string? ValidateAndPrepare()
    {
        if (string.IsNullOrWhiteSpace(_request.OrderId) && string.IsNullOrWhiteSpace(_purchaseOrderIdText))
        {
            return "Enter an order ID or purchase order ID.";
        }

        if (!string.IsNullOrWhiteSpace(_purchaseOrderIdText) && int.TryParse(_purchaseOrderIdText, out var purchaseOrderId))
        {
            _request.PurchaseOrderId = purchaseOrderId;
        }
        else if (!string.IsNullOrWhiteSpace(_purchaseOrderIdText))
        {
            return "Enter a valid purchase order ID.";
        }

        if (!Guid.TryParse(_customerIdText, out var customerId))
        {
            return "Enter a valid customer ID.";
        }

        _request.CustomerId = customerId;
        _request.ShippingCostCurrency = NormalizeCurrencyCode(_request.ShippingCostCurrency);
        _request.ShippingCountry = NormalizeCountryName(_request.ShippingCountry);

        if (string.IsNullOrWhiteSpace(_request.CustomerName))
        {
            return "Enter the customer name.";
        }

        if (string.IsNullOrWhiteSpace(_item.ProductCode) || string.IsNullOrWhiteSpace(_item.ProductName))
        {
            return "Enter the product code and product name.";
        }

        if (_item.QuantityDelivered <= 0 || _item.QuantityDelivered > _item.QuantityManufactured || _item.QuantityDelivered > _item.QuantityOrdered)
        {
            return "Delivered quantity must be positive and cannot exceed manufactured or ordered quantity.";
        }

        _item.OrderId = _request.OrderId;
        return null;
    }

    private IReadOnlyList<CurrencyDto> CurrencyOptions()
    {
        return _currencies
            .Where(currency => currency.IsActive && !string.IsNullOrWhiteSpace(currency.Code))
            .OrderByDescending(currency => currency.IsPrimary)
            .ThenBy(currency => currency.Code, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private IReadOnlyList<CountryDto> CountryOptions()
    {
        return _countries
            .Where(country => country.IsActive && !string.IsNullOrWhiteSpace(country.Name))
            .OrderBy(country => string.Equals(country.Code, "TH", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(country => country.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string NormalizeCurrencyCode(string? currencyCode)
    {
        var options = CurrencyOptions();
        var normalized = currencyCode?.Trim();
        if (options.Count == 0)
        {
            return string.IsNullOrWhiteSpace(normalized) ? "THB" : normalized.ToUpperInvariant();
        }

        return options.FirstOrDefault(currency => string.Equals(currency.Code, normalized, StringComparison.OrdinalIgnoreCase))?.Code
            ?? options.FirstOrDefault(currency => currency.IsPrimary)?.Code
            ?? options.FirstOrDefault(currency => string.Equals(currency.Code, "THB", StringComparison.OrdinalIgnoreCase))?.Code
            ?? options[0].Code;
    }

    private string NormalizeCountryName(string? countryName)
    {
        var options = CountryOptions();
        var normalized = countryName?.Trim();
        if (options.Count == 0)
        {
            return string.IsNullOrWhiteSpace(normalized) ? "Thailand" : normalized;
        }

        return options.FirstOrDefault(country => IsCountryMatch(country, normalized))?.Name
            ?? options.FirstOrDefault(country => string.Equals(country.Code, "TH", StringComparison.OrdinalIgnoreCase))?.Name
            ?? options[0].Name;
    }

    private static bool IsCountryMatch(CountryDto country, string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && (string.Equals(country.Name, value, StringComparison.OrdinalIgnoreCase)
                || string.Equals(country.Code, value, StringComparison.OrdinalIgnoreCase)
                || string.Equals(country.Iso3, value, StringComparison.OrdinalIgnoreCase));
    }

    private static string CurrencyOptionLabel(CurrencyDto currency)
    {
        return string.IsNullOrWhiteSpace(currency.Symbol)
            ? currency.Code
            : $"{currency.Code} {currency.Symbol}";
    }

    private static string CountryOptionLabel(CountryDto country)
    {
        return string.IsNullOrWhiteSpace(country.Code)
            ? country.Name
            : $"{country.Name} ({country.Code})";
    }

    private static string CourierOptionLabel(ShippingCourierDto courier)
    {
        var label = string.IsNullOrWhiteSpace(courier.Note)
            ? $"{courier.CourierName} ({courier.CourierCode})"
            : $"{courier.CourierName} ({courier.CourierCode}) - {courier.Note}";

        return AppendProviderLabel(label, courier.Provider);
    }

    private static string RateOptionLabel(ShippingRateOptionDto rate)
    {
        var label = string.IsNullOrWhiteSpace(rate.ProductName) ? rate.CourierCode : rate.ProductName;
        return AppendProviderLabel(label, rate.Provider);
    }

    private static string AppendProviderLabel(string label, string? provider)
    {
        return string.IsNullOrWhiteSpace(provider) ? label : $"{label} via {provider.Trim()}";
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?.Trim() ?? string.Empty;
}
