@page "/mfg/materials"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Materials - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Materials Catalog</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search materials..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudStack Row="true" Spacing="2">
            <MudSelect @bind-Value="_filterCategory" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
                <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                <MudSelectItem Value="@("Plastics")">Plastics</MudSelectItem>
                <MudSelectItem Value="@("Metals")">Metals</MudSelectItem>
                <MudSelectItem Value="@("Composites")">Composites</MudSelectItem>
            </MudSelect>
            
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Add Material
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <div class="pa-4">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="70px" Class="mb-2 rounded" />
        }
    </div>
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="MaterialSummaryDto" 
                     Items="@_materials" 
                     Dense="true" 
                     Hover="true"
                     RowsPerPage="10"
                     Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Material Name" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <TemplateColumn Title="Stock Level">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.body2">@context.Item.QuantityOnHand @context.Item.Unit</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.UnitPrice" Title="Unit Price" Format="C2" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" 
                                           Size="Size.Small" 
                                           Color="Color.Default" 
                                           Href="@($"/mfg/materials/{context.Item.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" 
                                           Size="Size.Small" 
                                           Color="Color.Primary" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" 
                                           Size="Size.Small" 
                                           Color="Color.Error" 
                                           OnClick="@(() => DeleteMaterial(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private string _filterCategory = "All";
    private List<MaterialSummaryDto> _materials = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>("api/materials");
            if (response?.Data != null)
            {
                _materials = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading materials: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateMaterialDialog>("Create Material", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task DeleteMaterial(MaterialSummaryDto material)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Delete Material", 
            $"Are you sure you want to delete {material.Name}?", 
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/materials/{material.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Material deleted", Severity.Success);
                await OnInitializedAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete material", Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Low Stock" => Color.Warning,
        "Out of Stock" => Color.Error,
        _ => Color.Default
    };
}
