@page "/mfg/production-queue"

<PageTitle>Production Queue - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Elevation="0" Class="pa-12 border mud-border-lines-default rounded-lg d-flex flex-column align-center justify-center" Style="min-height: 400px;">
        <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing" Size="Size.Large" Color="Color.Secondary" Style="font-size: 80px;" Class="mb-4" />
        <MudText Typo="Typo.h4" Align="Align.Center">Production Queue</MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Align="Align.Center" Class="mt-2">Coming Soon</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mt-4" Style="max-width: 600px;">
            The production queue will allow you to manage and schedule manufacturing jobs across all machines and processes.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-8" Href="/">Back to Dashboard</MudButton>
    </MudPaper>
</MudContainer>
