@page "/mfg/production-queue"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Services
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ProductionHubService Hub
@implements IAsyncDisposable

<PageTitle>Production Queue - Maliev Intranet</PageTitle>

@* ── Page header ──────────────────────────────────────────────────────────────*@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">Production Queue</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">
            Job scheduling, machine allocation and production status tracking
            @if (_hubConnected)
            {
                <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Size="Size.Small"
                         Color="Color.Success" Style="vertical-align: middle; margin-left: 6px;" />
                <span style="font-size: 11px; color: var(--mud-palette-success);">Live</span>
            }
        </MudText>
    </div>

    @* Filters *@
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudSelect T="string" Value="@_filterProcess" ValueChanged="OnFilterChanged"
                   Label="Process" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 130px;" Clearable="true">
            @foreach (var p in _processTypes)
            {
                <MudSelectItem Value="@p">@p</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Value="@_filterPriority" ValueChanged="OnPriorityChanged"
                   Label="Priority" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 120px;" Clearable="true">
            <MudSelectItem Value="@("Urgent")">Urgent</MudSelectItem>
            <MudSelectItem Value="@("High")">High</MudSelectItem>
            <MudSelectItem Value="@("Normal")">Normal</MudSelectItem>
            <MudSelectItem Value="@("Low")">Low</MudSelectItem>
        </MudSelect>
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                           OnClick="RefreshAsync"
                           Color="Color.Default" />
        </MudTooltip>
    </MudStack>
</MudStack>

@* ── Stats row ────────────────────────────────────────────────────────────────*@
<MudGrid Class="mb-5" Spacing="3">
    @foreach (var stat in _stats)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Default">@stat.Label</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:600;" Color="@stat.Color">
                            @(_statsDto != null ? stat.ValueSelector(_statsDto).ToString() : "—")
                        </MudText>
                    </div>
                    <MudIcon Icon="@stat.Icon" Size="Size.Large" Color="@stat.Color" Style="opacity:0.25;" />
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@* ── Kanban board ─────────────────────────────────────────────────────────────*@
@if (_loading)
{
    <MudGrid Spacing="3">
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded-lg" Style="min-height:300px;">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Class="mb-3" />
                    @for (int j = 0; j < 2; j++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-2 rounded" />
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudDropContainer T="JobSummaryDto"
                      Items="@_jobs"
                      ItemsSelector="@((item, col) => item.Status == col)"
                      ItemDropped="OnJobDropped"
                      Class="d-flex flex-wrap flex-grow-1 gap-3">
        <ChildContent>
            @foreach (var col in _columns)
            {
                <MudPaper Elevation="0"
                          Class="pa-3 border mud-border-lines-default rounded-lg flex-grow-1"
                          Style="min-width: 200px; min-height: 400px; background: var(--mud-palette-background-grey)">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@col.Icon" Size="Size.Small" Color="@col.Color" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@col.Title</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="@col.Color">
                            @_jobs.Count(j => j.Status == col.Id)
                        </MudChip>
                    </MudStack>
                    <MudDropZone T="JobSummaryDto" Identifier="@col.Id" Class="flex-grow-1" />
                </MudPaper>
            }
        </ChildContent>

        <ItemRenderer>
            @{
                var job = context;
                var priorityColor = GetPriorityColor(job.Priority);
                var cardClass = "mb-2 rounded-lg job-card" + (job.IsOverdue ? " overdue" : "");
            }
            <MudCard Elevation="1"
                     Class="@cardClass"
                     @attributes="@(new Dictionary<string, object> { ["style"] = $"border-left: 3px solid {GetPriorityHex(job.Priority)}; cursor: grab;" })">
                <MudCardContent Class="pa-2">
                    @* Header: job number + priority chip *@
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudLink Href="@($"/mfg/jobs/{job.Id}")" Typo="Typo.caption" Style="font-weight:700;">
                            @job.JobNumber
                        </MudLink>
                        <MudChip T="string" Size="Size.Small" Color="@priorityColor" Variant="Variant.Text">
                            @job.Priority
                        </MudChip>
                    </MudStack>

                    @* Part description *@
                    <MudText Typo="Typo.body2" Style="font-size:12px; font-weight:600;" Class="mb-1"
                             title="@job.PartDescription">
                        @Truncate(job.PartDescription, 40)
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@job.CustomerName</MudText>

                    @* Process + material chips *@
                    <MudStack Row="true" Spacing="1" Class="mt-1 mb-2" Style="flex-wrap:wrap;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@GetProcessIcon(job.ProcessType)">
                            @job.ProcessType
                        </MudChip>
                        @if (!string.IsNullOrEmpty(job.Material))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@job.Material</MudChip>
                        }
                    </MudStack>

                    @* Progress bar *@
                    @if (job.ProgressPercent > 0)
                    {
                        <MudProgressLinear Value="@job.ProgressPercent" Color="Color.Primary" Rounded="true" Class="mb-1" />
                        <MudText Typo="Typo.caption" Color="Color.Default" Style="font-size:10px;">
                            @job.ProgressPercent% complete
                        </MudText>
                    }

                    @* Machine + ETA *@
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                        @if (!string.IsNullOrEmpty(job.MachineName))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing"
                                         Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.caption" Color="Color.Default" Style="font-size:10px;">
                                    @job.MachineName
                                </MudText>
                            </MudStack>
                        }
                        @if (job.EstimatedCompletionAt.HasValue)
                        {
                            <MudText Typo="Typo.caption"
                                     Color="@(job.IsOverdue ? Color.Error : Color.Default)"
                                     Style="font-size:10px;">
                                @(job.IsOverdue ? "OVERDUE" : job.EstimatedCompletionAt.Value.ToString("dd MMM HH:mm"))
                            </MudText>
                        }
                    </MudStack>

                    @* Actions *@
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-1">
                        <MudTooltip Text="Print Job Ticket">
                            <MudIconButton Icon="@Icons.Material.Outlined.QrCode2"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenJobTicket(job))" />
                        </MudTooltip>
                        <MudTooltip Text="View Details">
                            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew"
                                           Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/mfg/jobs/{job.Id}"))" />
                        </MudTooltip>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </ItemRenderer>
    </MudDropContainer>
}

<style>
    .job-card { transition: box-shadow 0.15s ease, transform 0.12s ease; }
    .job-card:hover { box-shadow: var(--mud-elevation-4); transform: translateY(-1px); }
    .job-card.overdue { animation: overdue-pulse 2s ease-in-out infinite; }
    @@keyframes overdue-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.75; }
    }
</style>

@code {
    // ── Column definitions ────────────────────────────────────────────────────
    private record KanbanColumn(string Id, string Title, string Icon, Color Color);
    private readonly KanbanColumn[] _columns =
    [
        new("Queued",        "Queued",         Icons.Material.Outlined.Schedule,             Color.Default),
        new("Preparing",     "Preparing",      Icons.Material.Outlined.Build,                Color.Info),
        new("InProgress",    "In Progress",    Icons.Material.Outlined.PlayCircle,           Color.Primary),
        new("QualityCheck",  "Quality Check",  Icons.Material.Outlined.FactCheck,            Color.Warning),
        new("Packaging",     "Packaging",      Icons.Material.Outlined.Inventory2,           Color.Default),
        new("Complete",      "Complete",       Icons.Material.Outlined.CheckCircle,          Color.Success),
    ];

    // ── Stats row definitions ─────────────────────────────────────────────────
    private record StatCard(string Label, string Icon, Color Color, Func<JobStatsDto, int> ValueSelector);
    private readonly StatCard[] _stats =
    [
        new("Queued Jobs",      Icons.Material.Outlined.Queue,        Color.Default, s => s.QueuedCount),
        new("In Progress",      Icons.Material.Outlined.PlayCircle,   Color.Primary, s => s.InProgressCount),
        new("Completed Today",  Icons.Material.Outlined.CheckCircle,  Color.Success, s => s.CompletedTodayCount),
        new("Overdue",          Icons.Material.Outlined.Warning,      Color.Error,   s => s.OverdueCount),
    ];

    // ── Filter options ────────────────────────────────────────────────────────
    private readonly string[] _processTypes = ["FDM", "SLA", "SLS", "CNC", "Laser", "Other"];

    // ── State ─────────────────────────────────────────────────────────────────
    private bool _loading = true;
    private bool _hubConnected;
    private string _filterProcess = string.Empty;
    private string _filterPriority = string.Empty;
    private List<JobSummaryDto> _jobs = new();
    private JobStatsDto _statsDto = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadQueueAsync(), ConnectHubAsync());
    }

    public async ValueTask DisposeAsync()
    {
        Hub.JobStatusChanged -= OnJobStatusChanged;
        Hub.JobAssigned      -= OnJobAssigned;
        Hub.ProductionStatsUpdated -= OnStatsUpdated;
        await Hub.StopAsync();
    }

    // ── Data loading ──────────────────────────────────────────────────────────
    private async Task LoadQueueAsync()
    {
        _loading = true;
        try
        {
            var url = "api/jobs/queue";
            var qs = BuildQueryString();
            if (!string.IsNullOrEmpty(qs)) url += "?" + qs;

            var result = await Http.GetFromJsonAsync<ProductionQueueDto>(url);
            _jobs    = result?.Jobs.ToList() ?? new();
            _statsDto = result?.Stats ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading production queue: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private string BuildQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_filterProcess))  parts.Add($"processType={Uri.EscapeDataString(_filterProcess)}");
        if (!string.IsNullOrEmpty(_filterPriority)) parts.Add($"priority={Uri.EscapeDataString(_filterPriority)}");
        return string.Join("&", parts);
    }

    // ── SignalR ───────────────────────────────────────────────────────────────
    private async Task ConnectHubAsync()
    {
        try
        {
            Hub.JobStatusChanged      += OnJobStatusChanged;
            Hub.JobAssigned           += OnJobAssigned;
            Hub.ProductionStatsUpdated += OnStatsUpdated;
            await Hub.StartAsync();
            _hubConnected = true;
        }
        catch { _hubConnected = false; }
    }

    private void OnJobStatusChanged(Guid jobId, string newStatus)
    {
        var job = _jobs.FirstOrDefault(j => j.Id == jobId);
        if (job != null) job.Status = newStatus;
        InvokeAsync(StateHasChanged);
    }

    private void OnJobAssigned(Guid jobId, Guid machineId)
    {
        // Refresh the specific job from API to get updated MachineName
        InvokeAsync(async () =>
        {
            try
            {
                var updated = await Http.GetFromJsonAsync<JobDetailDto>($"api/jobs/{jobId}");
                if (updated != null)
                {
                    var idx = _jobs.FindIndex(j => j.Id == jobId);
                    if (idx >= 0)
                    {
                        // Copy only base JobSummaryDto-level fields to keep list type uniform
                        _jobs[idx].MachineName = updated.MachineName;
                        _jobs[idx].MachineId   = updated.MachineId;
                    }
                }
            }
            catch { /* best-effort */ }
            StateHasChanged();
        });
    }

    private void OnStatsUpdated() =>
        InvokeAsync(async () =>
        {
            try 
            {
                var stats = await Http.GetFromJsonAsync<JobStatsDto>("api/jobs/stats");
                if (stats != null) _statsDto = stats;
            }
            catch { /* best-effort */ }
            StateHasChanged();
        });

    // ── Filters ───────────────────────────────────────────────────────────────
    private async Task OnFilterChanged(string value)
    {
        _filterProcess = value ?? string.Empty;
        await LoadQueueAsync();
    }

    private async Task OnPriorityChanged(string value)
    {
        _filterPriority = value ?? string.Empty;
        await LoadQueueAsync();
    }

    private async Task RefreshAsync() => await LoadQueueAsync();

    // ── Drag-and-drop ─────────────────────────────────────────────────────────
    private async Task OnJobDropped(MudItemDropInfo<JobSummaryDto> dropInfo)
    {
        if (dropInfo.Item is null) return;

        var old = dropInfo.Item.Status;
        var newStatus = dropInfo.DropzoneIdentifier;
        if (old == newStatus) return;

        // Optimistic update
        dropInfo.Item.Status = newStatus;

        var confirmed = await ConfirmStatusChangeAsync(dropInfo.Item, old, newStatus);
        if (!confirmed)
        {
            dropInfo.Item.Status = old;
            return;
        }

        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/jobs/{dropInfo.Item.Id}/status",
                new UpdateJobStatusRequest { Status = newStatus });

            if (!response.IsSuccessStatusCode)
            {
                dropInfo.Item.Status = old;
                Snackbar.Add("Failed to update job status.", Severity.Error);
            }
        }
        catch
        {
            dropInfo.Item.Status = old;
            Snackbar.Add("Failed to update job status.", Severity.Error);
        }
    }

    private async Task<bool> ConfirmStatusChangeAsync(JobSummaryDto job, string from, string to)
    {
        // Only confirm moving to Complete or backwards (quality gate)
        if (to is not "Complete" && !IsBackward(from, to)) return true;

        var result = await DialogService.ShowMessageBoxAsync(
            "Confirm Status Change",
            $"Move \"{job.JobNumber}\" from {from} → {to}?",
            yesText: "Confirm", cancelText: "Cancel");

        return result == true;
    }

    private bool IsBackward(string from, string to)
    {
        var order = _columns.Select(c => c.Id).ToList();
        return order.IndexOf(to) < order.IndexOf(from);
    }

    // ── Job ticket dialog ─────────────────────────────────────────────────────
    private async Task OpenJobTicket(JobSummaryDto job)
    {
        var parameters = new DialogParameters<JobTicketDialog>
        {
            { x => x.JobId, job.Id }
        };
        await DialogService.ShowAsync<JobTicketDialog>($"Job Ticket — {job.JobNumber}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static Color GetPriorityColor(string priority) => priority switch
    {
        "Urgent" => Color.Error,
        "High"   => Color.Warning,
        "Normal" => Color.Primary,
        _        => Color.Default
    };

    private static string GetPriorityHex(string priority) => priority switch
    {
        "Urgent" => "#f44336",
        "High"   => "#ff9800",
        "Normal" => "#2196f3",
        _        => "#9e9e9e"
    };

    private static string GetProcessIcon(string processType) => processType switch
    {
        "FDM"   => Icons.Material.Outlined.Print,
        "SLA"   => Icons.Material.Outlined.Layers,
        "SLS"   => Icons.Material.Outlined.Grain,
        "CNC"   => Icons.Material.Outlined.PrecisionManufacturing,
        "Laser" => Icons.Material.Outlined.FlashOn,
        _       => Icons.Material.Outlined.Build
    };

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";
}
