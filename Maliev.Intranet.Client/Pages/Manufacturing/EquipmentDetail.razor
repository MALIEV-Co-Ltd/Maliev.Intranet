@page "/mfg/equipment/{Id:guid}"
@using System.Net.Http.Headers
@using System.Text.Json.Serialization
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Equipment | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="@(_equipment?.Name ?? "Equipment")" Subtitle="@_equipment?.AssetCode" BackHref="/mfg/equipment">
        @if (_equipment is not null)
        {
            <StatusBadge Status="@_equipment.Status" />
        }
    </PageHeader>

    <PageBody>
        @if (_loading)
        {
            <ProgressiveSkeleton Layout="detail" Rows="6" ShowFilters="false" Label="Loading equipment detail" />
        }
        else if (_equipment is null)
        {
            <div class="mlv-empty">Equipment record was not found.</div>
        }
        else
        {
            <StatBar Class="mb-4">
                <StatTile Label="Category" Value="@_equipment.Category" />
                <StatTile Label="Brand" Value="@(_equipment.Brand ?? "-")" />
                <StatTile Label="Model" Value="@(_equipment.ModelName ?? "-")" />
                <StatTile Label="Service due" Value="@(_equipment.NextServiceDueDate?.ToString("dd MMM yyyy") ?? "-")" />
            </StatBar>

            <div class="mlv-two-column-grid">
                <PanelCard Title="Equipment">
                    <dl class="mlv-detail-list">
                        <dt>Asset code</dt><dd class="mlv-mono">@_equipment.AssetCode</dd>
                        <dt>Serial number</dt><dd>@Display(_equipment.ManufacturerSerialNumber)</dd>
                        <dt>Sub-category</dt><dd>@Display(_equipment.SubCategory)</dd>
                        <dt>Purchase</dt><dd>@(_equipment.PurchaseDate?.ToString("dd MMM yyyy") ?? "-")</dd>
                        <dt>Warranty</dt><dd>@(_equipment.WarrantyExpiryDate?.ToString("dd MMM yyyy") ?? "-")</dd>
                        <dt>Updated</dt><dd>@_equipment.UpdatedAt.ToString("dd MMM yyyy")</dd>
                    </dl>
                </PanelCard>

                <PanelCard Title="Notes">
                    <div class="equipment-note-composer">
                        <textarea class="mlv-form-textarea" @bind="_newNote" @bind:event="oninput" placeholder="Maintenance observation, operating issue, or asset note"></textarea>
                        <div class="mlv-toolbar" style="justify-content:flex-end">
                            <PrimaryButton Icon="@Icons.Material.Outlined.NoteAdd" OnClick="@AddNoteAsync">Add Note</PrimaryButton>
                        </div>
                    </div>
                    @if (_notes.Count > 0)
                    {
                        <div class="mlv-list equipment-notes-list">
                            @foreach (var note in _notes)
                            {
                                <div class="mlv-list-row">
                                    <div>@note.Content</div>
                                    <div class="mlv-row-sub">@note.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mlv-empty equipment-note-empty">No notes.</div>
                    }
                </PanelCard>
            </div>

            <div class="mlv-two-column-grid mt-4">
                <PanelCard Title="Status transition" Class="equipment-status-transition-card">
                    <div class="equipment-status-summary">
                        <div>
                            <span>Current status</span>
                            <strong>@FormatStatus(_equipment.Status)</strong>
                        </div>
                        <div>
                            <span>Available transitions</span>
                            <strong>@GetStatusTransitionOptions(_equipment.Status).Count</strong>
                        </div>
                    </div>
                    @if (GetStatusTransitionOptions(_equipment.Status).Count == 0)
                    {
                        <div class="mlv-empty equipment-status-empty">No further status transitions are available for this equipment.</div>
                    }
                    else
                    {
                        <FormGrid>
                            <FormField Label="Move to">
                                <select class="mlv-form-select" @bind="_statusTarget" disabled="@_statusSaving">
                                    @foreach (var status in GetStatusTransitionOptions(_equipment.Status))
                                    {
                                        <option value="@status">@FormatStatus(status)</option>
                                    }
                                </select>
                            </FormField>
                            <FormField Label="Reason" Class="mlv-span-6">
                                <ImmediateInputTextArea class="mlv-form-textarea equipment-status-reason" @bind-Value="_statusReason" />
                            </FormField>
                        </FormGrid>
                        <div class="equipment-status-actions">
                            <PrimaryButton Icon="@Icons.Material.Outlined.SyncAlt" Disabled="@_statusSaving" OnClick="@ChangeStatusAsync">
                                @(_statusSaving ? "Updating..." : "Update status")
                            </PrimaryButton>
                        </div>
                    }
                </PanelCard>

                <PanelCard Title="Equipment documents" Class="equipment-document-card">
                    <FormGrid>
                        <FormField Label="Document type">
                            <select class="mlv-form-select" @bind="_documentType" disabled="@_documentSaving">
                                @foreach (var type in DocumentTypeOptions)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </FormField>
                        <FormField Label="Description" Class="mlv-span-6">
                            <ImmediateInputTextArea class="mlv-form-textarea equipment-document-description" @bind-Value="_documentDescription" />
                        </FormField>
                        <label class="mlv-form-field mlv-span-6 equipment-document-file-input">
                            <span>Files</span>
                            <InputFile OnChange="OnDocumentFilesSelected" multiple />
                            <small>Attach purchase records, warranty documents, manuals, certificates, or safety sheets up to 10 MB each.</small>
                            @if (_documentFiles.Count > 0)
                            {
                                <div class="maintenance-selected-files">
                                    @foreach (var file in _documentFiles)
                                    {
                                        <span>
                                            <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                                            @file.Name
                                            <em>@FormatFileSize(file.Size)</em>
                                        </span>
                                    }
                                </div>
                            }
                        </label>
                    </FormGrid>
                    @if (!string.IsNullOrWhiteSpace(_documentError))
                    {
                        <div class="maintenance-error">@_documentError</div>
                    }
                    <div class="equipment-document-actions">
                        <PrimaryButton Icon="@Icons.Material.Outlined.UploadFile" Disabled="@_documentSaving" OnClick="@AddEquipmentDocumentAsync">
                            @(_documentSaving ? "Uploading..." : "Add document")
                        </PrimaryButton>
                    </div>
                    @if (EquipmentDocuments.Count > 0)
                    {
                        <div class="equipment-document-grid">
                            @foreach (var document in EquipmentDocuments)
                            {
                                <button type="button" class="equipment-document-row" @onclick="() => OpenMaintenanceDocumentAsync(document.Document)">
                                    <MudIcon Icon="@GetDocumentIcon(document.Document.ContentType)" Size="Size.Small" />
                                    <span>
                                        <strong>@document.Document.FileName</strong>
                                        <small>@document.TypeLabel - @document.OccurredAt.ToString("dd MMM yyyy")</small>
                                    </span>
                                    <em>@FormatFileSize(document.Document.FileSizeBytes)</em>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mlv-empty equipment-document-empty">No equipment documents yet.</div>
                    }
                </PanelCard>
            </div>

            <PanelCard Title="Maintenance" Class="mt-4">
                <FormGrid>
                    <FormField Label="Type"><ImmediateInputText class="mlv-form-input" @bind-Value="_maintenance.Type" /></FormField>
                    <FormField Label="Occurred"><InputDate class="mlv-form-input" @bind-Value="_maintenanceDate" /></FormField>
                    <FormField Label="Vendor"><ImmediateInputText class="mlv-form-input" @bind-Value="_maintenance.VendorName" /></FormField>
                    <FormField Label="Cost THB"><ImmediateInputNumber class="mlv-form-input" @bind-Value="_maintenance.CostTHB" /></FormField>
                    <FormField Label="Description" Class="mlv-span-6"><ImmediateInputTextArea class="mlv-form-textarea" @bind-Value="_maintenance.Description" /></FormField>
                    <label class="mlv-form-field mlv-span-6 maintenance-file-input">
                        <span>Files</span>
                        <InputFile OnChange="OnMaintenanceFilesSelected" multiple />
                        <small>Attach maintenance reports, findings, service photos, receipts, or vendor documents up to 10 MB each.</small>
                        @if (_maintenanceFiles.Count > 0)
                        {
                            <div class="maintenance-selected-files">
                                @foreach (var file in _maintenanceFiles)
                                {
                                    <span>
                                        <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                                        @file.Name
                                        <em>@FormatFileSize(file.Size)</em>
                                    </span>
                                }
                            </div>
                        }
                    </label>
                </FormGrid>
                @if (!string.IsNullOrWhiteSpace(_maintenanceError))
                {
                    <div class="maintenance-error">@_maintenanceError</div>
                }
                <div class="mlv-toolbar mt-3" style="justify-content:flex-end">
                    <PrimaryButton Icon="@Icons.Material.Outlined.Build" Disabled="@_maintenanceSaving" OnClick="@AddMaintenanceAsync">
                        @(_maintenanceSaving ? "Adding..." : "Add Maintenance")
                    </PrimaryButton>
                </div>
                @if (_maintenanceLogs.Count > 0)
                {
                    <table class="mlv-table mt-4">
                        <thead><tr><th>Type</th><th>Description</th><th>Vendor</th><th>Cost</th><th>Date</th><th>Files</th></tr></thead>
                        <tbody>
                            @foreach (var log in _maintenanceLogs)
                            {
                                <tr>
                                    <td>@log.Type</td>
                                    <td>@log.Description</td>
                                    <td>@Display(log.VendorName)</td>
                                    <td class="mlv-mono">@((log.CostTHB ?? 0).ToString("N2"))</td>
                                    <td>@log.OccurredAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (log.Documents.Count == 0)
                                        {
                                            <span class="mlv-row-sub">-</span>
                                        }
                                        else
                                        {
                                            <div class="maintenance-document-list">
                                                @foreach (var document in log.Documents)
                                                {
                                                    <button type="button" class="maintenance-document-button" @onclick="() => OpenMaintenanceDocumentAsync(document)">
                                                        <MudIcon Icon="@GetDocumentIcon(document.ContentType)" Size="Size.Small" />
                                                        <span>@document.FileName</span>
                                                        <em>@FormatFileSize(document.FileSizeBytes)</em>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty mt-4">No maintenance logs.</div>
                }
            </PanelCard>

            <div class="mlv-two-column-grid mt-4">
                <PanelCard Title="Loans">
                    @if (_loans.Count > 0)
                    {
                        <table class="mlv-table">
                            <thead><tr><th>Borrower</th><th>Status</th><th>Dates</th></tr></thead>
                            <tbody>
                                @foreach (var loan in _loans)
                                {
                                    <tr>
                                        <td class="mlv-mono">@loan.BorrowerId</td>
                                        <td><StatusBadge Status="@loan.LoanStatus" /></td>
                                        <td>@loan.LoanStartDate.ToString("dd MMM") - @loan.ExpectedReturnDate.ToString("dd MMM")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="mlv-empty">No loans.</div>
                    }
                </PanelCard>

                <PanelCard Title="Attachments">
                    @if (_attachments.Count > 0)
                    {
                        <table class="mlv-table">
                            <thead><tr><th>Name</th><th>Type</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var attachment in _attachments)
                                {
                                    <tr>
                                        <td>@attachment.Name</td>
                                        <td>@attachment.AttachmentType</td>
                                        <td>@(attachment.IsActive ? "Active" : "Inactive")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="mlv-empty">No attachments.</div>
                    }
                </PanelCard>
            </div>

        }
    </PageBody>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private EquipmentDetailDto? _equipment;
    private List<EquipmentNoteDto> _notes = [];
    private List<MaintenanceLogDto> _maintenanceLogs = [];
    private List<EquipmentLoanDto> _loans = [];
    private List<EquipmentAttachmentDto> _attachments = [];
    private List<IBrowserFile> _maintenanceFiles = [];
    private List<IBrowserFile> _documentFiles = [];
    private bool _loading = true;
    private bool _maintenanceSaving;
    private bool _statusSaving;
    private bool _documentSaving;
    private string _newNote = string.Empty;
    private string? _statusTarget;
    private string _statusReason = string.Empty;
    private string _documentType = "Instruction manual";
    private string _documentDescription = string.Empty;
    private string? _maintenanceError;
    private string? _documentError;
    private DateTime _maintenanceDate = DateTime.Today;
    private AddMaintenanceLogRequest _maintenance = new() { Type = "Preventive", Description = string.Empty, OccurredAt = DateTime.UtcNow };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var equipmentTask = Http.GetFromJsonAsync<EquipmentDetailDto>($"api/v1/equipments/{Id}");
            var notesTask = Http.GetFromJsonAsync<IReadOnlyList<EquipmentNoteDto>>($"api/v1/equipments/{Id}/notes");
            var maintenanceTask = Http.GetFromJsonAsync<IReadOnlyList<MaintenanceLogDto>>($"api/v1/equipments/{Id}/maintenance");
            var loansTask = Http.GetFromJsonAsync<IReadOnlyList<EquipmentLoanDto>>($"api/v1/equipments/{Id}/loans");
            var attachmentsTask = Http.GetFromJsonAsync<IReadOnlyList<EquipmentAttachmentDto>>($"api/v1/equipments/{Id}/attachments");
            await Task.WhenAll(equipmentTask, notesTask, maintenanceTask, loansTask, attachmentsTask);

            _equipment = await equipmentTask;
            _notes = (await notesTask)?.ToList() ?? [];
            _maintenanceLogs = (await maintenanceTask)?.ToList() ?? [];
            _loans = (await loansTask)?.ToList() ?? [];
            _attachments = (await attachmentsTask)?.ToList() ?? [];
            SyncStatusTarget();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Equipment record could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddNoteAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_newNote))
        {
            Snackbar.Add("Enter a note.", Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/v1/equipments/{Id}/notes", new AddEquipmentNoteRequest { Content = _newNote });
        Snackbar.Add(response.IsSuccessStatusCode ? "Note added." : "Note could not be added.", response.IsSuccessStatusCode ? Severity.Success : Severity.Warning);
        if (response.IsSuccessStatusCode)
        {
            _newNote = string.Empty;
            await LoadAsync();
        }
    }

    private async Task ChangeStatusAsync(MouseEventArgs _)
    {
        if (_equipment is null || string.IsNullOrWhiteSpace(_statusTarget))
        {
            return;
        }

        if (string.Equals(_statusTarget, _equipment.Status, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Choose a different equipment status.", Severity.Warning);
            return;
        }

        _statusSaving = true;
        try
        {
            var request = new ChangeEquipmentStatusRequest
            {
                NewStatus = _statusTarget,
                Reason = string.IsNullOrWhiteSpace(_statusReason) ? null : _statusReason.Trim(),
                RowVersion = _equipment.RowVersion
            };

            var response = await Http.PatchAsJsonAsync($"api/v1/equipments/{Id}/status", request);
            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(message) ? "Equipment status could not be updated." : message,
                    Severity.Warning);
                return;
            }

            _statusReason = string.Empty;
            Snackbar.Add("Equipment status updated.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Equipment status could not be updated: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _statusSaving = false;
        }
    }

    private async Task AddMaintenanceAsync(MouseEventArgs _)
    {
        _maintenanceError = null;
        if (string.IsNullOrWhiteSpace(_maintenance.Description))
        {
            _maintenanceError = "Enter maintenance description.";
            return;
        }

        _maintenanceSaving = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(string.IsNullOrWhiteSpace(_maintenance.Type) ? "Preventive" : _maintenance.Type.Trim()), "type");
            content.Add(new StringContent(_maintenance.Description.Trim()), "description");
            content.Add(new StringContent(DateTime.SpecifyKind(_maintenanceDate, DateTimeKind.Local).ToUniversalTime().ToString("O")), "occurredAt");

            if (!string.IsNullOrWhiteSpace(_maintenance.VendorName))
            {
                content.Add(new StringContent(_maintenance.VendorName.Trim()), "vendorName");
            }

            if (_maintenance.CostTHB.HasValue)
            {
                content.Add(new StringContent(_maintenance.CostTHB.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)), "costTHB");
            }

            if (_maintenance.NextServiceDueDate.HasValue)
            {
                content.Add(new StringContent(_maintenance.NextServiceDueDate.Value.ToString("yyyy-MM-dd")), "nextServiceDueDate");
            }

            foreach (var file in _maintenanceFiles)
            {
                var stream = file.OpenReadStream(MaxMaintenanceDocumentBytes);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }

            var response = await Http.PostAsync($"api/v1/equipments/{Id}/maintenance", content);
            if (!response.IsSuccessStatusCode)
            {
                _maintenanceError = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_maintenanceError))
                {
                    _maintenanceError = "Maintenance log could not be added.";
                }

                return;
            }

            _maintenance = new AddMaintenanceLogRequest { Type = "Preventive", Description = string.Empty, OccurredAt = DateTime.UtcNow };
            _maintenanceFiles = [];
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _maintenanceError = $"Maintenance log could not be added: {ex.Message}";
        }
        finally
        {
            _maintenanceSaving = false;
        }
    }

    private async Task AddEquipmentDocumentAsync(MouseEventArgs _)
    {
        _documentError = null;
        if (_documentFiles.Count == 0)
        {
            _documentError = "Select at least one equipment document.";
            return;
        }

        _documentSaving = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent($"Document:{_documentType}"), "type");
            content.Add(new StringContent(BuildEquipmentDocumentDescription()), "description");
            content.Add(new StringContent(DateTime.UtcNow.ToString("O")), "occurredAt");

            foreach (var file in _documentFiles)
            {
                var stream = file.OpenReadStream(MaxMaintenanceDocumentBytes);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }

            var response = await Http.PostAsync($"api/v1/equipments/{Id}/maintenance", content);
            if (!response.IsSuccessStatusCode)
            {
                _documentError = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_documentError))
                {
                    _documentError = "Equipment document could not be added.";
                }

                return;
            }

            _documentFiles = [];
            _documentDescription = string.Empty;
            Snackbar.Add("Equipment document added.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _documentError = $"Equipment document could not be added: {ex.Message}";
        }
        finally
        {
            _documentSaving = false;
        }
    }

    private void OnMaintenanceFilesSelected(InputFileChangeEventArgs args)
    {
        _maintenanceError = null;
        var files = args.GetMultipleFiles(8);
        var oversizedFile = files.FirstOrDefault(file => file.Size > MaxMaintenanceDocumentBytes);
        if (oversizedFile is not null)
        {
            _maintenanceError = $"Maintenance document '{oversizedFile.Name}' exceeds the 10 MB limit.";
            _maintenanceFiles = [];
            return;
        }

        _maintenanceFiles = files.ToList();
    }

    private void OnDocumentFilesSelected(InputFileChangeEventArgs args)
    {
        _documentError = null;
        var files = args.GetMultipleFiles(8);
        var oversizedFile = files.FirstOrDefault(file => file.Size > MaxMaintenanceDocumentBytes);
        if (oversizedFile is not null)
        {
            _documentError = $"Equipment document '{oversizedFile.Name}' exceeds the 10 MB limit.";
            _documentFiles = [];
            return;
        }

        _documentFiles = files.ToList();
    }

    private async Task OpenMaintenanceDocumentAsync(MaintenanceLogDocumentDto document)
    {
        if (string.IsNullOrWhiteSpace(document.StoragePath))
        {
            return;
        }

        var response = await Http.GetFromJsonAsync<DownloadUrlResponse>(
            $"api/v1/equipments/{Id}/maintenance/download-url?fileReference={Uri.EscapeDataString(document.StoragePath)}");
        if (!string.IsNullOrWhiteSpace(response?.Url))
        {
            await JS.InvokeVoidAsync("open", response.Url, "_blank");
        }
    }

    private IReadOnlyList<EquipmentDocumentView> EquipmentDocuments =>
        _maintenanceLogs
            .SelectMany(log => log.Documents.Select(document =>
                new EquipmentDocumentView(DocumentTypeLabel(log.Type), log.OccurredAt, document)))
            .ToList();

    private void SyncStatusTarget()
    {
        if (_equipment is null)
        {
            _statusTarget = null;
            return;
        }

        var options = GetStatusTransitionOptions(_equipment.Status);
        if (options.Count == 0)
        {
            _statusTarget = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_statusTarget)
            || !options.Contains(_statusTarget, StringComparer.OrdinalIgnoreCase))
        {
            _statusTarget = options[0];
        }
    }

    private string BuildEquipmentDocumentDescription()
    {
        if (!string.IsNullOrWhiteSpace(_documentDescription))
        {
            return _documentDescription.Trim();
        }

        return $"{_documentType} attached to {_equipment?.AssetCode ?? "equipment"}.";
    }

    private static IReadOnlyList<string> GetStatusTransitionOptions(string? status) => status?.Trim() switch
    {
        "Active" => ["UnderMaintenance", "OnLoan", "Lost", "Decommissioned"],
        "UnderMaintenance" => ["Active", "Decommissioned"],
        "OnLoan" => ["Active", "Lost", "Decommissioned"],
        "Lost" => ["Active", "Decommissioned"],
        _ => []
    };

    private static string FormatStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "-";
        }

        return string.Concat(status.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
    }

    private static string DocumentTypeLabel(string type)
    {
        const string prefix = "Document:";
        if (type.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            var label = type[prefix.Length..].Trim();
            return string.IsNullOrWhiteSpace(label) ? "Equipment document" : label;
        }

        return "Maintenance record";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes / 1024d / 1024d:0.#} MB";
    }

    private static string GetDocumentIcon(string? contentType) => contentType?.ToLowerInvariant() switch
    {
        string value when value.Contains("pdf", StringComparison.Ordinal) => Icons.Material.Outlined.PictureAsPdf,
        string value when value.StartsWith("image/", StringComparison.Ordinal) => Icons.Material.Outlined.Image,
        string value when value.Contains("spreadsheet", StringComparison.Ordinal) || value.Contains("excel", StringComparison.Ordinal) => Icons.Material.Outlined.TableChart,
        string value when value.Contains("word", StringComparison.Ordinal) || value.Contains("document", StringComparison.Ordinal) => Icons.Material.Outlined.Article,
        _ => Icons.Material.Outlined.Description
    };

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private const long MaxMaintenanceDocumentBytes = 10 * 1024 * 1024;
    private static readonly string[] DocumentTypeOptions =
    [
        "Purchase document",
        "Warranty document",
        "Instruction manual",
        "Safety sheet",
        "Calibration certificate",
        "Vendor receipt",
        "Other"
    ];

    private sealed record EquipmentDocumentView(
        string TypeLabel,
        DateTime OccurredAt,
        MaintenanceLogDocumentDto Document);

    private sealed class DownloadUrlResponse
    {
        [JsonPropertyName("url")]
        public string? Url { get; set; }
    }
}
