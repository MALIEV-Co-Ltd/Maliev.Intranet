@page "/mfg/equipment/new"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Register Equipment - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudTooltip Text="Back">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/mfg/equipment" />
    </MudTooltip>
    <MudText Typo="Typo.h5">Register Equipment</MudText>
</MudStack>

<MudStepper Vertical NonLinear="false" @bind-ActiveIndex="_currentStep">

    <!-- Step 1: Category Selection -->
    <MudStep Title="Select Category">
        <MudText Typo="Typo.subtitle2" Class="mb-3 mud-text-secondary">
            Choose the equipment category. This determines which specification fields are available.
        </MudText>
        <MudGrid Spacing="2">
            @foreach (var cat in _categories)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="@(_request.Category == cat.Value ? 4 : 1)"
                              Class="@($"pa-3 rounded cursor-pointer {(_request.Category == cat.Value ? "border mud-border-primary" : "")}")"
                              @onclick="@(() => _request.Category = cat.Value)">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@cat.Icon"
                                     Color="@(_request.Category == cat.Value ? Color.Primary : Color.Default)"
                                     Size="Size.Large" />
                            <MudText Typo="Typo.body2" Align="Align.Center">@cat.Label</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        @if (_step1Attempted && string.IsNullOrEmpty(_request.Category))
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-2">Please select a category.</MudText>
        }
    </MudStep>

    <!-- Step 2: Base Information -->
    <MudStep Title="Equipment Details">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.Name"
                              Label="Equipment Name"
                              Required="true"
                              Variant="Variant.Outlined"
                              HelperText="A descriptive display name (e.g., 'Bambu Lab P1S #1')" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.Brand"
                              Label="Brand / Manufacturer"
                              Variant="Variant.Outlined"
                              HelperText="e.g., 'Bambu Lab', 'HAAS', 'Creality'" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.ModelName"
                              Label="Model Name"
                              Variant="Variant.Outlined"
                              HelperText="e.g., 'P1S', 'VF-2', 'Raptor X'" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.ManufacturerSerialNumber"
                              Label="Serial Number"
                              Variant="Variant.Outlined"
                              HelperText="Manufacturer's serial number (optional)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_request.SubCategory"
                              Label="Sub-Category"
                              Variant="Variant.Outlined"
                              HelperText="Optional further classification" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_request.PurchasePriceTHB"
                                 Label="Purchase Price (THB)"
                                 Variant="Variant.Outlined"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="฿" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_purchaseDateNullable"
                               Label="Purchase Date"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_warrantyExpiryNullable"
                               Label="Warranty Expiry"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_nextServiceNullable"
                               Label="Next Service Due"
                               Variant="Variant.Outlined"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
        </MudGrid>
    </MudStep>

    <!-- Step 3: Specifications (manufacturing equipment only) -->
    <MudStep Title="Specifications">
        @if (IsGeneralEquipment(_request.Category))
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                General equipment categories do not require specification data. You may proceed to register.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-3 mud-text-secondary">
                Enter the technical specifications for this @FormatCategory(_request.Category).
                All spec fields are optional and can be updated later.
            </MudText>
            <MudGrid Spacing="3">
                @foreach (var field in GetSpecFields(_request.Category))
                {
                    <MudItem xs="12" md="6">
                        <MudTextField Value="@GetSpecValue(field.Key)"
                                      ValueChanged="@((string? v) => SetSpecValue(field.Key, v))"
                                      Label="@field.Label"
                                      Variant="Variant.Outlined"
                                      HelperText="@field.Hint" />
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStep>

</MudStepper>

<MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
    <MudButton Variant="Variant.Outlined"
               OnClick="PreviousStep"
               Disabled="@(_currentStep == 0)">
        Back
    </MudButton>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Text" Href="/mfg/equipment">Cancel</MudButton>
        @if (_currentStep < 2)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="NextStep">
                Next
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Submit"
                       Disabled="@_isSaving">
                @(_isSaving ? "Registering..." : "Register Equipment")
            </MudButton>
        }
    </MudStack>
</MudStack>

@code {
    private int _currentStep;
    private bool _step1Attempted;
    private bool _isSaving;

    private readonly RegisterEquipmentRequest _request = new();

    // Date picker bridging (MudDatePicker works with DateTime?)
    private DateTime? _purchaseDateNullable
    {
        get => _request.PurchaseDate?.ToDateTime(TimeOnly.MinValue);
        set => _request.PurchaseDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private DateTime? _warrantyExpiryNullable
    {
        get => _request.WarrantyExpiryDate?.ToDateTime(TimeOnly.MinValue);
        set => _request.WarrantyExpiryDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private DateTime? _nextServiceNullable
    {
        get => _request.NextServiceDueDate?.ToDateTime(TimeOnly.MinValue);
        set => _request.NextServiceDueDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private void NextStep()
    {
        if (_currentStep == 0)
        {
            _step1Attempted = true;
            if (string.IsNullOrEmpty(_request.Category)) return;
        }
        _currentStep++;
    }

    private void PreviousStep()
    {
        if (_currentStep > 0)
            _currentStep--;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_request.Name)) return;

        _isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/equipments", _request);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<EquipmentDetailDto>();
                Snackbar.Add("Equipment registered successfully.", Severity.Success);
                Navigation.NavigateTo(created is not null
                    ? $"/mfg/equipment/{created.Id}"
                    : "/mfg/equipment");
            }
            else
            {
                Snackbar.Add("Failed to register equipment. Please check the form and try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string? GetSpecValue(string key) =>
        _request.Spec is not null && _request.Spec.TryGetValue(key, out var v) ? v?.ToString() : null;

    private void SetSpecValue(string key, string? value)
    {
        _request.Spec ??= new Dictionary<string, object?>();
        if (string.IsNullOrWhiteSpace(value))
            _request.Spec.Remove(key);
        else
            _request.Spec[key] = value;
    }

    private static bool IsGeneralEquipment(string category) => category switch
    {
        "OfficeEquipment" or "ITEquipment" or "MeasuringEquipment" or "HandTool" or "Other" => true,
        _ => false
    };

    private static string FormatCategory(string category) => category switch
    {
        "FdmPrinter" => "FDM Printer",
        "SlaPrinter" => "SLA/DLP Printer",
        "CncMachine" => "CNC Machine",
        "Scanner3D" => "3D Scanner",
        "InjectionMolding" => "Injection Molding",
        "OfficeEquipment" => "Office Equipment",
        "MeasuringEquipment" => "Measuring Equipment",
        "ITEquipment" => "IT Equipment",
        "HandTool" => "Hand Tool",
        _ => category
    };

    private static IReadOnlyList<SpecFieldDef> GetSpecFields(string category) => category switch
    {
        "FdmPrinter" =>
        [
            new("BuildVolumeX", "Build Volume X (mm)", "e.g., 256"),
            new("BuildVolumeY", "Build Volume Y (mm)", "e.g., 256"),
            new("BuildVolumeZ", "Build Volume Z (mm)", "e.g., 256"),
            new("NozzleDiameterMm", "Nozzle Diameter (mm)", "e.g., 0.4"),
            new("MaxNozzleTempC", "Max Nozzle Temp (°C)", "e.g., 300"),
            new("NumberOfExtruders", "Number of Extruders", "e.g., 1"),
            new("MinLayerHeightMm", "Min Layer Height (mm)", "e.g., 0.05"),
            new("MaxLayerHeightMm", "Max Layer Height (mm)", "e.g., 0.35"),
        ],
        "SlaPrinter" =>
        [
            new("BuildVolumeX", "Build Volume X (mm)", "e.g., 192"),
            new("BuildVolumeY", "Build Volume Y (mm)", "e.g., 120"),
            new("BuildVolumeZ", "Build Volume Z (mm)", "e.g., 245"),
            new("XyResolutionMm", "XY Resolution (mm)", "e.g., 0.048"),
            new("LightSourceType", "Light Source Type", "e.g., Laser, LED, LCD"),
            new("WavelengthNm", "Wavelength (nm)", "e.g., 405"),
        ],
        "CncMachine" =>
        [
            new("TravelX", "X Travel (mm)", "e.g., 762"),
            new("TravelY", "Y Travel (mm)", "e.g., 406"),
            new("TravelZ", "Z Travel (mm)", "e.g., 508"),
            new("MaxSpindleSpeedRpm", "Max Spindle Speed (RPM)", "e.g., 8100"),
            new("MaxSpindlePowerKw", "Max Spindle Power (kW)", "e.g., 22.4"),
            new("NumberOfAxes", "Number of Axes", "e.g., 3"),
            new("ToolInterface", "Tool Interface", "e.g., Iso, BT, HSK, CAT"),
            new("ControllerBrand", "Controller Brand", "e.g., Fanuc, Siemens"),
        ],
        "Scanner3D" =>
        [
            new("MaxScanVolumeM3", "Max Scan Volume (m³)", "e.g., 0.5"),
            new("AccuracyMm", "Accuracy (mm)", "e.g., 0.05"),
            new("ScannerTechnology", "Scanner Technology", "e.g., Laser, StructuredLight, Contact"),
        ],
        "InjectionMolding" =>
        [
            new("MaxMoldX", "Max Mold X (mm)", ""),
            new("MaxMoldY", "Max Mold Y (mm)", ""),
            new("MaxShotSizeG", "Max Shot Size (g)", ""),
            new("MaxTempC", "Max Temperature (°C)", ""),
            new("MaxInjectionPressureBar", "Max Injection Pressure (bar)", ""),
        ],
        _ => []
    };

    private sealed record SpecFieldDef(string Key, string Label, string Hint);

    private static readonly CategoryItem[] _categories =
    [
        new("FDM Printer", "FdmPrinter", Icons.Material.Outlined.Print),
        new("SLA/DLP Printer", "SlaPrinter", Icons.Material.Outlined.Layers),
        new("CNC Machine", "CncMachine", Icons.Material.Outlined.PrecisionManufacturing),
        new("3D Scanner", "Scanner3D", Icons.Material.Outlined.Scanner),
        new("Injection Molding", "InjectionMolding", Icons.Material.Outlined.BlurCircular),
        new("Office Equipment", "OfficeEquipment", Icons.Material.Outlined.BusinessCenter),
        new("Measuring Equipment", "MeasuringEquipment", Icons.Material.Outlined.Straighten),
        new("IT Equipment", "ITEquipment", Icons.Material.Outlined.Computer),
        new("Hand Tool", "HandTool", Icons.Material.Outlined.Construction),
        new("Other", "Other", Icons.Material.Outlined.Category),
    ];

    private sealed record CategoryItem(string Label, string Value, string Icon);
}
