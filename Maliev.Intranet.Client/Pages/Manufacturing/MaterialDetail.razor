    private void ToggleColorSelection(Guid colorId, object? value)
    {
        if (_editModel is null)
        {
            return;
        }

        var selected = value is bool boolValue && boolValue;
        if (selected && !_editModel.SelectedColorIds.Contains(colorId))
        {
            _editModel.SelectedColorIds.Add(colorId);
        }
        else if (!selected)
        {
            _editModel.SelectedColorIds.Remove(colorId);
        }
    }

