        ? "Not configured"
        : $"{_material.ReorderLevel:N0} {_material.Unit}";

    private string InventoryTrackingShortCode => _material is null
        ? string.Empty
        : $"MAT-{_material.Id:N}".ToUpperInvariant()[..12];

    private string MaterialRecordHref => _material is null
        ? $"/mfg/materials/{Id}"
        : $"/mfg/materials/{_material.Id}";

    private string MaterialQrPayload => _material is null
        ? MaterialRecordHref
        : $"/mfg/materials/{_material.Id}";

    private MarkupString MaterialQrSvg => new(BuildQrSvg(MaterialQrPayload));

    private MarkupString CreatedItemQrSvg => new(BuildQrSvg(_createdItem?.QrPayload ?? string.Empty));

    private IReadOnlyList<MaterialColorDto> EditableColorOptions
    {
        get
        {
            var options = new List<MaterialColorDto>();
            var seen = new HashSet<Guid>();
            foreach (var color in _colorOptions.Concat(_material?.Colors ?? []))
            {
                if (seen.Add(color.Id))
                {
                    options.Add(color);
                }
            }

            return options;
        }
    }

    private IReadOnlyList<MaterialColorDto> ReceiveColorOptions
    {
        get
        {
            var source = _material is { Colors.Count: > 0 } material
                ? material.Colors
                : _colorOptions;
            var options = new List<MaterialColorDto>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var color in source)
            {
                var value = GetReceiveColorValue(color);
                if (!string.IsNullOrWhiteSpace(value) && seen.Add(value))
                {
                    options.Add(color);
                }
            }

            return options;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canUpdateMaterial = HasPermission(authState.User, MalievPermissions.Material.Update);
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _material = await Http.GetFromJsonAsync<MaterialDetailDto>($"api/v1/materials/{Id}");
            ResetReceiveItemForm();
            await LoadColorOptionsAsync();
            await LoadInventoryStatusAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartEditAsync()
    {
        if (_material is null)
        {
            return;
        }

        _editModel = new MaterialEditModel
        {
            Name = _material.Name,
            SKU = _material.SKU,
            Description = _material.Description,
            UnitPrice = _material.UnitPrice,
            QuantityOnHand = _material.QuantityOnHand,
            SelectedColorIds = _material.Colors.Select(color => color.Id).ToList()
        };
        _editContext = new EditContext(_editModel);
        _editing = true;
        await LoadColorOptionsAsync();
    }

    private Task CancelEditAsync()
    {
        _editing = false;
        _editModel = null;
        _editContext = null;
        return Task.CompletedTask;
    }

    private void CreatePurchaseOrder()
    {
        if (_material is null)
        {
            return;
        }

        var query = $"materialId={Uri.EscapeDataString(_material.Id.ToString())}&materialName={Uri.EscapeDataString(_material.Name)}";
        Navigation.NavigateTo($"/purchasing/new?{query}");
    }

    private async Task LoadInventoryStatusAsync()
    {
        _inventoryStatus = null;
        _inventoryItems = [];
        if (_material is null)
        {
            return;
        }

        _loadingInventory = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<MaterialInventoryStatusDto>>(
                $"api/v1/inventory/batches/status?materialId={Uri.EscapeDataString(_material.Id.ToString())}&status=Active");
            _inventoryStatus = response?.FirstOrDefault(status => status.MaterialId == _material.Id);

            _inventoryItems = await Http.GetFromJsonAsync<List<InventoryItemDto>>(
                $"api/v1/inventory/items?materialId={Uri.EscapeDataString(_material.Id.ToString())}&status=Active") ?? [];
        }
        catch (Exception ex)
        {
            _inventoryError = $"Unable to load inventory items: {ex.Message}";
        }
        finally
        {
            _loadingInventory = false;
        }
    }

    private async Task ReceiveItemAsync(MouseEventArgs _)
    {
        if (_material is null)
        {
            return;
        }

        _inventoryError = null;
        if (_receiveItem.InitialQuantity <= 0)
        {
            _inventoryError = "Quantity received must be greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_receiveItem.Location))
        {
            _inventoryError = "Storage location is required.";
            return;
        }

        _receivingItem = true;
        try
        {
            var request = new CreateInventoryItemRequest
            {
                MaterialId = _material.Id,
                InitialQuantity = _receiveItem.InitialQuantity,
                QuantityUnit = _receiveItem.QuantityUnit,
                Location = _receiveItem.Location.Trim(),
                FormFactor = _receiveItem.FormFactor,
                LowStockThresholdQuantity = _receiveItem.LowStockThresholdQuantity > 0 ? _receiveItem.LowStockThresholdQuantity : null,
                SupplierId = _receiveItem.SupplierId,
                LotNumber = TrimOrNull(_receiveItem.LotNumber),
                ManufacturerSku = TrimOrNull(_receiveItem.ManufacturerSku),
                Color = NormalizeReceiveColor(_receiveItem.Color),
                MaterialGrade = TrimOrNull(_receiveItem.MaterialGrade),
                LengthMm = PositiveOrNull(_receiveItem.LengthMm),
                WidthMm = PositiveOrNull(_receiveItem.WidthMm),
                HeightMm = PositiveOrNull(_receiveItem.HeightMm),
                DiameterMm = PositiveOrNull(_receiveItem.DiameterMm),
                ThicknessMm = PositiveOrNull(_receiveItem.ThicknessMm)
            };

            var response = await Http.PostAsJsonAsync("api/v1/inventory/items", request);
            if (!response.IsSuccessStatusCode)
            {
                _inventoryError = "Unable to receive material item.";
                return;
            }

            _createdItem = await response.Content.ReadFromJsonAsync<InventoryItemDto>();
            ResetReceiveItemForm();
            await LoadInventoryStatusAsync();
            Snackbar.Add("Material item received. Apply the QR label to the exact stock item.", Severity.Success);
        }
        catch (Exception ex)
        {
            _inventoryError = $"Unable to receive material item: {ex.Message}";
        }
        finally
        {
            _receivingItem = false;
        }
    }

    private void ResetReceiveItemForm()
    {
        _receiveItem = new ReceiveItemModel
        {
            Location = _receiveItem.Location,
            FormFactor = _receiveItem.FormFactor,
            QuantityUnit = _receiveItem.QuantityUnit,
            Color = _receiveItem.Color
        };
    }

    private async Task SaveMaterialAsync()
    {
        if (_material is null || _editModel is null || _editContext is null || !_editContext.Validate())
        {
            return;
        }

        _saving = true;
        try
        {
            var request = new UpdateMaterialRequest
            {
                Name = _editModel.Name.Trim(),
                SKU = _editModel.SKU.Trim(),
                Description = _editModel.Description?.Trim(),
                UnitPrice = _editModel.UnitPrice,
                QuantityOnHand = _editModel.QuantityOnHand,
                ColorIds = _editModel.SelectedColorIds.ToList()
            };

            var response = await Http.PutAsJsonAsync($"api/v1/materials/{Id}", request);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Unable to update material.", Severity.Error);
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<MaterialDetailDto>();
            if (updated is not null)
            {
                _material = updated;
            }

            await CancelEditAsync();
            Snackbar.Add("Material updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to update material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

