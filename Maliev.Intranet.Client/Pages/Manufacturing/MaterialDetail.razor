    private static bool IsHexColor(string? value)
        => NormalizeHexColor(value) is not null;

    private static string? NormalizeHexColor(string? value)
    {
        var trimmed = value?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return null;
        }

        var digits = trimmed.StartsWith("#", StringComparison.Ordinal)
            ? trimmed[1..]
            : trimmed;

        if (digits.Length != 6 || !digits.All(Uri.IsHexDigit))
        {
            return null;
        }

        return $"#{digits.ToUpperInvariant()}";
    }

    private static string? NormalizeReceiveColor(string? value)
    {
        var hex = NormalizeHexColor(value);
        return hex ?? TrimOrNull(value);
    }

    private static IReadOnlyList<string> SplitDisplayList(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private static string DisplayText(string value)
        => string.IsNullOrWhiteSpace(value)
            ? "-"
            : string.Join(" ", value.Split(['-', '_', ' '], StringSplitOptions.RemoveEmptyEntries)
                .Select(part => char.ToUpperInvariant(part[0]) + part[1..].ToLowerInvariant()));

    private static string DisplaySupplierLocation(SupplierSummaryDto supplier)
    {
        var parts = new[] { supplier.City, supplier.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToList();

        return parts.Count == 0 ? "Location not set" : string.Join(", ", parts);
    }

    private static string FormatQuantity(int quantity)
        => quantity > 0 ? $"+{quantity:N0}" : quantity.ToString("N0");

    private static string FormatGrams(decimal grams)
        => $"{grams.ToString("N0", CultureInfo.InvariantCulture)} g";

    private static string FormatItemQuantity(decimal quantity, string unit)
        => $"{quantity.ToString("N2", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.')} {unit}";

    private static string FormatItemDimensions(InventoryItemDto item)
    {
        var dimensions = new List<string>();
        if (item.LengthMm is > 0)
        {
            dimensions.Add($"L {item.LengthMm.Value.ToString("N0", CultureInfo.InvariantCulture)}");
        }

        if (item.WidthMm is > 0)
        {
            dimensions.Add($"W {item.WidthMm.Value.ToString("N0", CultureInfo.InvariantCulture)}");
        }

        if (item.HeightMm is > 0)
        {
            dimensions.Add($"H {item.HeightMm.Value.ToString("N0", CultureInfo.InvariantCulture)}");
        }

        if (item.DiameterMm is > 0)
        {
            dimensions.Add($"Dia {item.DiameterMm.Value.ToString("N2", CultureInfo.InvariantCulture)}");
        }

        return dimensions.Count == 0 ? "Dimensions not set" : string.Join(" x ", dimensions) + " mm";
    }

