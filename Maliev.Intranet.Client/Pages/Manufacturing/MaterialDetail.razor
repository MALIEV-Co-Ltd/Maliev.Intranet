@page "/mfg/materials/{Id:guid}"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Material | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="@(_material?.Name ?? "Material")" Subtitle="@_material?.SKU" BackHref="/mfg/materials">
        @if (_material is not null)
        {
            <StatusBadge Status="@_material.Status" />
        }
    </PageHeader>

    @if (_loading)
    {
        <div class="mlv-empty">Loading material...</div>
    }
    else if (_material is null)
    {
        <div class="mlv-empty">Material not found.</div>
    }
    else
    {
        <section class="mlv-stats-grid">
            <StatTile Label="Stock" Value="@($"{_material.QuantityOnHand:N0} {_material.Unit}")" />
            <StatTile Label="Unit price" Value="@_material.UnitPrice.ToString("N2")" />
            <StatTile Label="Category" Value="@(string.IsNullOrWhiteSpace(_material.Category) ? "-" : _material.Category)" />
            <StatTile Label="Updated" Value="@_material.UpdatedAt.ToString("dd MMM yyyy")" />
        </section>

        <section class="mlv-panel-grid">
            <div class="mlv-panel">
                <h2>Profile</h2>
                <div class="mlv-list">
                    <div class="mlv-list-row"><span>Code</span><strong class="mlv-mono">@_material.SKU</strong></div>
                    <div class="mlv-list-row"><span>Status</span><strong>@_material.Status</strong></div>
                    <div class="mlv-list-row"><span>Color</span><strong>@(string.IsNullOrWhiteSpace(_material.Color) ? "-" : _material.Color)</strong></div>
                    <div class="mlv-list-row"><span>Description</span><strong>@(string.IsNullOrWhiteSpace(_material.Description) ? "-" : _material.Description)</strong></div>
                </div>
            </div>

            <div class="mlv-panel">
                <h2>Properties</h2>
                @if (_material.Properties.Count == 0)
                {
                    <div class="mlv-empty">No technical properties.</div>
                }
                else
                {
                    <div class="mlv-list">
                        @foreach (var property in _material.Properties)
                        {
                            <div class="mlv-list-row">
                                <span>@property.Key</span>
                                <strong>@property.Value @property.Unit</strong>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private MaterialDetailDto? _material;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _material = await Http.GetFromJsonAsync<MaterialDetailDto>($"api/v1/materials/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
