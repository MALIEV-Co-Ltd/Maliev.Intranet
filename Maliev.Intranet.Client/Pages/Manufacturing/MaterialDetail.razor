@page "/mfg/materials/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using Maliev.Intranet.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using QRCoder
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime Js

<PageTitle>Material | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="@(_material?.Name ?? "Material")" Subtitle="@_material?.SKU" BackHref="/mfg/materials">
        @if (_material is not null)
        {
            <StatusBadge Status="@_material.Status" />
            @if (_canUpdateMaterial)
            {
                @if (_editing)
                {
                    <SecondaryButton Icon="@Icons.Material.Outlined.Close" Disabled="@_saving" OnClick="@CancelEditAsync">Cancel</SecondaryButton>
                    <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@_saving" OnClick="@SaveMaterialAsync">Save</PrimaryButton>
                }
                else
                {
                    <SecondaryButton Icon="@Icons.Material.Outlined.Edit" OnClick="@StartEditAsync">Edit</SecondaryButton>
                }
            }
        }
    </PageHeader>

    <PageBody>
        @if (_loading)
        {
            <ProgressiveSkeleton Layout="detail" Rows="6" ShowFilters="false" Label="Loading material" />
        }
        else if (_material is null)
        {
            <div class="mlv-empty">Material not found.</div>
        }
        else
        {
            <StatBar Class="mb-4">
                <StatTile Label="Stock" Value="@($"{_material.QuantityOnHand:N0} {_material.Unit}")" Color="@StockHealthColor" Subtext="@StockHealthText" />
                <StatTile Label="Unit price" Value="@_material.UnitPrice.ToString("N2")" />
                <StatTile Label="Processes" Value="">
                    @if (MaterialProcesses.Count == 0)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        <div class="material-process-list" aria-label="Supported manufacturing processes">
                            @foreach (var process in MaterialProcesses)
                            {
                                <span class="material-process-chip">@process</span>
                            }
                        </div>
                    }
                </StatTile>
                <StatTile Label="Updated" Value="@_material.UpdatedAt.ToString("dd MMM yyyy")" />
            </StatBar>

            @if (_editing && _editContext is not null)
            {
                <EditForm EditContext="@_editContext" FormName="MaterialEditForm">
                    <DataAnnotationsValidator />
                    @MaterialContent
                </EditForm>
            }
            else
            {
                @MaterialContent
            }
        }
    </PageBody>
</div>

@code {
    private RenderFragment MaterialContent => @<div class="material-detail-layout">
        <div class="material-detail-main">
            <PanelCard Title="Inventory control">
                @if (_material is not null)
                {
                    <div class="material-inventory-status @InventoryStatusClass" role="status" aria-label="@StockHealthText">
                        <div>
                            <span class="material-section-eyebrow">Current stock</span>
                            <strong>@_material.QuantityOnHand.ToString("N0") @_material.Unit</strong>
                        </div>
                        <span class="material-inventory-badge">@StockHealthLabel</span>
                    </div>
                    <div class="material-stock-grid">
                        <div class="material-stock-metric">
                            <span>Reorder point</span>
                            <strong>@ReorderPointText</strong>
                        </div>
                        <div class="material-stock-metric">
                            <span>Inventory value</span>
                            <strong>@InventoryValue.ToString("N2")</strong>
                        </div>
                        <div class="material-stock-metric">
                            <span>Supplier links</span>
                            <strong>@_material.Suppliers.Count.ToString("N0")</strong>
                        </div>
                    </div>
                    <div class="material-action-strip" aria-label="Inventory actions">
                        @if (_canUpdateMaterial)
                        {
                            <SecondaryButton Icon="@Icons.Material.Outlined.Inventory" Disabled="@_editing" OnClick="@StartEditAsync">Update stock</SecondaryButton>
                        }
                        <PrimaryButton Icon="@Icons.Material.Outlined.AddShoppingCart" OnClick="@CreatePurchaseOrder">Order more</PrimaryButton>
                        <SecondaryButton Icon="@Icons.Material.Outlined.Handshake" Href="/purchasing/suppliers">Supplier Profiles</SecondaryButton>
                    </div>
                    <div class="material-batch-summary" aria-label="Traceable batch inventory">
                        @if (_loadingInventory)
                        {
                            <MudSkeleton Height="16px" Width="75%" />
                            <MudSkeleton Height="16px" Width="45%" />
                        }
                        else if (_inventoryStatus is not null)
                        {
                            <div>
                                <span>Active batches</span>
                                <strong>@_inventoryStatus.ActiveBatches.ToString("N0")</strong>
                            </div>
                            <div>
                                <span>Remaining stock</span>
                                <strong>@FormatGrams(_inventoryStatus.TotalRemainingGrams)</strong>
                            </div>
                            <div>
                                <span>Lowest batch</span>
                                <strong>@FormatGrams(_inventoryStatus.LowestBatchGrams)</strong>
                            </div>
                            <StatusBadge Status="@(_inventoryStatus.HasLowStockAlert ? "Low stock" : "Traceable")" />
                        }
                        else
                        {
                            <div class="material-empty-state material-batch-empty">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                                <div>
                                    <strong>No active traceable items</strong>
                                    <span>Receive raw stock to create QR labels for each physical spool, block, sheet, or piece.</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </PanelCard>

            <div class="mlv-two-column-grid">
                <PanelCard Title="Profile">
                    @if (_editing && _editModel is not null)
                    {
                        <div class="material-edit-grid">
                            <label class="material-edit-field">
                                <span>Name</span>
                                <input class="material-input" @bind="_editModel.Name" @bind:event="oninput" />
                                <ValidationMessage For="@(() => _editModel!.Name)" />
                            </label>
                            <label class="material-edit-field">
                                <span>Code</span>
                                <input class="material-input mlv-mono" @bind="_editModel.SKU" @bind:event="oninput" />
                                <ValidationMessage For="@(() => _editModel!.SKU)" />
                            </label>
                            <label class="material-edit-field">
                                <span>Unit price</span>
                                <input class="material-input" type="number" step="0.01" min="0" @bind="_editModel.UnitPrice" @bind:event="oninput" />
                                <ValidationMessage For="@(() => _editModel!.UnitPrice)" />
                            </label>
                            <label class="material-edit-field">
                                <span>Stock</span>
                                <input class="material-input" type="number" step="1" min="0" @bind="_editModel.QuantityOnHand" @bind:event="oninput" />
                                <ValidationMessage For="@(() => _editModel!.QuantityOnHand)" />
                            </label>
                            <label class="material-edit-field material-edit-field-wide">
                                <span>Description</span>
                                <textarea class="material-input material-textarea" rows="4" @bind="_editModel.Description" @bind:event="oninput"></textarea>
                                <ValidationMessage For="@(() => _editModel!.Description)" />
                            </label>
                            <div class="material-edit-field material-edit-field-wide">
                                <span>Color options</span>
                                @if (_colorsLoading)
                                {
                                    <div class="material-color-loading">
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="38px" Animation="Animation.Wave" />
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="38px" Animation="Animation.Wave" />
                                    </div>
                                }
                                else if (EditableColorOptions.Count == 0)
                                {
                                    <div class="material-empty-state material-color-empty">
                                        <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
                                        <div>
                                            <strong>No color options configured</strong>
                                            <span>Add colors in the material reference catalog before assigning them here.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="material-color-picker" role="group" aria-label="Available color options">
                                        @foreach (var color in EditableColorOptions)
                                        {
                                            <label class="@GetColorOptionClass(color)">
                                                <input type="checkbox"
                                                       checked="@IsColorSelected(color.Id)"
                                                       @onchange="@((ChangeEventArgs eventArgs) => ToggleColorSelection(color.Id, eventArgs.Value))" />
                                                <span class="material-color-dot" style="@ColorSwatchStyle(color)"></span>
                                                <span>@color.Name</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (_material is not null)
                    {
                        <dl class="mlv-detail-list">
                            <dt>Code</dt><dd class="mlv-mono">@_material.SKU</dd>
                            <dt>Status</dt><dd>@_material.Status</dd>
                            <dt>Color</dt>
                            <dd>
                                @if (_material.Colors.Count == 0)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div class="material-color-list" aria-label="Available colors">
                                        @foreach (var color in _material.Colors)
                                        {
                                            <span class="material-color-chip" title="@color.Name">
                                                <span class="material-color-dot" style="@ColorSwatchStyle(color)"></span>
                                                <span>@color.Name</span>
                                            </span>
                                        }
                                    </div>
                                }
                            </dd>
                            <dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(_material.Description) ? "-" : _material.Description)</dd>
                        </dl>
                    }
                </PanelCard>

                <PanelCard Title="Properties">
                    @if (_material?.Properties.Count == 0)
                    {
                        <div class="mlv-empty">No technical properties.</div>
                    }
                    else if (_material is not null)
                    {
                        <dl class="mlv-detail-list">
                            @foreach (var property in _material.Properties)
                            {
                                <dt>@property.Key</dt><dd>@property.Value @property.Unit</dd>
                            }
                        </dl>
                    }
                </PanelCard>
            </div>

            <PanelCard Title="Stock audit">
                @if (_material?.RecentTransactions.Count > 0)
                {
                    <div class="material-audit-list">
                        @foreach (var transaction in _material.RecentTransactions.OrderByDescending(transaction => transaction.Timestamp).Take(8))
                        {
                            <div class="material-audit-entry">
                                <div class="material-audit-icon">
                                    <MudIcon Icon="@GetTransactionIcon(transaction.Type)" Size="Size.Small" />
                                </div>
                                <div class="material-audit-body">
                                    <div class="material-audit-title">
                                        <strong>@DisplayText(transaction.Type)</strong>
                                        <span class="@GetTransactionQuantityClass(transaction.Quantity)">@FormatQuantity(transaction.Quantity) @_material.Unit</span>
                                    </div>
                                    <div class="material-audit-meta">
                                        <span>@transaction.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                        @if (!string.IsNullOrWhiteSpace(transaction.PerformedBy))
                                        {
                                            <span>@transaction.PerformedBy</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(transaction.Reference))
                                        {
                                            <span>@transaction.Reference</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="material-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" />
                        <div>
                            <strong>No stock movements recorded</strong>
                            <span>No count or adjustment history has been returned for this material yet.</span>
                        </div>
                    </div>
                }
            </PanelCard>
        </div>

        <aside class="material-detail-side" aria-label="Material inventory operations">
            <PanelCard Title="Receive material item">
                @if (_material is not null)
                {
                    <div class="material-receive-form">
                        <label class="material-edit-field material-edit-field-wide">
                            <span>Form factor</span>
                            <select class="material-input"
                                    @bind="_receiveItem.FormFactor"
                                    disabled="@(!_canUpdateMaterial || _receivingItem)">
                                @foreach (var option in MaterialFormFactors)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                        <div class="material-inline-grid">
                            <label class="material-edit-field">
                                <span>Quantity</span>
                                <input class="material-input"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       @bind="_receiveItem.InitialQuantity"
                                       @bind:event="oninput"
                                       disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <label class="material-edit-field">
                                <span>Unit</span>
                                <select class="material-input"
                                        @bind="_receiveItem.QuantityUnit"
                                        disabled="@(!_canUpdateMaterial || _receivingItem)">
                                    @foreach (var unit in MaterialQuantityUnits)
                                    {
                                        <option value="@unit">@unit</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <label class="material-edit-field">
                            <span>Storage location</span>
                            <input class="material-input"
                                   @bind="_receiveItem.Location"
                                   @bind:event="oninput"
                                   placeholder="Rack A / Bin 03"
                                   disabled="@(!_canUpdateMaterial || _receivingItem)" />
                        </label>
                        @if (_material.Suppliers.Count > 0)
                        {
                            <label class="material-edit-field">
                                <span>Supplier</span>
                                <select class="material-input"
                                        @bind="_receiveItem.SupplierId"
                                        disabled="@(!_canUpdateMaterial || _receivingItem)">
                                    <option value="">Unassigned</option>
                                    @foreach (var supplier in _material.Suppliers)
                                    {
                                        <option value="@supplier.Id">@supplier.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        <div class="material-inline-grid">
                            <label class="material-edit-field">
                                <span>Lot</span>
                                <input class="material-input"
                                       @bind="_receiveItem.LotNumber"
                                       @bind:event="oninput"
                                       disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <label class="material-edit-field">
                                <span>SKU</span>
                                <input class="material-input"
                                       @bind="_receiveItem.ManufacturerSku"
                                       @bind:event="oninput"
                                       disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                        </div>
                        <div class="material-inline-grid">
                            <label class="material-edit-field">
                                <span>Grade</span>
                                <input class="material-input"
                                       @bind="_receiveItem.MaterialGrade"
                                       @bind:event="oninput"
                                       placeholder="POM-C, PLA+, 6061-T6"
                                       disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <div class="material-edit-field material-receive-color-field">
                                <span>Color</span>
                                @if (_colorsLoading)
                                {
                                    <span class="material-input material-input-muted">Loading colors...</span>
                                }
                                else if (ReceiveColorOptions.Count == 0)
                                {
                                    <span class="material-input material-input-muted">No color options configured</span>
                                }
                                else
                                {
                                    <div class="material-receive-color-picker" role="radiogroup" aria-label="Color">
                                        @foreach (var color in ReceiveColorOptions)
                                        {
                                            <label class="@GetReceiveColorOptionClass(color)">
                                                <input type="radio"
                                                       name="receive-material-color"
                                                       value="@GetReceiveColorValue(color)"
                                                       checked="@IsReceiveColorSelected(color)"
                                                       disabled="@(!_canUpdateMaterial || _receivingItem)"
                                                       @onchange="@(() => SelectReceiveColor(color))" />
                                                <span class="material-color-dot" style="@ColorSwatchStyle(color)"></span>
                                                <span class="material-receive-color-name">@color.Name</span>
                                                <code>@GetReceiveColorValue(color)</code>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="material-dimension-grid" aria-label="Physical dimensions">
                            <label class="material-edit-field">
                                <span>L mm</span>
                                <input class="material-input" type="number" min="0" step="0.01" @bind="_receiveItem.LengthMm" @bind:event="oninput" disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <label class="material-edit-field">
                                <span>W mm</span>
                                <input class="material-input" type="number" min="0" step="0.01" @bind="_receiveItem.WidthMm" @bind:event="oninput" disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <label class="material-edit-field">
                                <span>H mm</span>
                                <input class="material-input" type="number" min="0" step="0.01" @bind="_receiveItem.HeightMm" @bind:event="oninput" disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                            <label class="material-edit-field">
                                <span>Dia mm</span>
                                <input class="material-input" type="number" min="0" step="0.01" @bind="_receiveItem.DiameterMm" @bind:event="oninput" disabled="@(!_canUpdateMaterial || _receivingItem)" />
                            </label>
                        </div>
                        <label class="material-edit-field">
                            <span>Low-stock threshold</span>
                            <input class="material-input"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   @bind="_receiveItem.LowStockThresholdQuantity"
                                   @bind:event="oninput"
                                   disabled="@(!_canUpdateMaterial || _receivingItem)" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(_inventoryError))
                        {
                            <div class="material-inventory-error" role="alert">@_inventoryError</div>
                        }
                        <PrimaryButton Icon="@Icons.Material.Outlined.QrCode2" Disabled="@(!_canUpdateMaterial || _receivingItem)" OnClick="@ReceiveItemAsync">
                            @(_receivingItem ? "Receiving..." : "Receive item")
                        </PrimaryButton>
                    </div>
                }
            </PanelCard>

            <PanelCard Title="Inventory label">
                @if (_material is not null)
                {
                    <div class="material-label-panel material-print-label">
                        <div class="material-label-heading">
                            <span>Material record</span>
                            <strong>@_material.Name</strong>
                        </div>
                        <div class="material-qr-label-body">
                            <div class="material-qr-shell" aria-label="@($"QR code for {InventoryTrackingShortCode}")">
                                @MaterialQrSvg
                            </div>
                            <div class="material-label-copy">
                                <span class="material-label-copy-caption">Scan QR</span>
                                <code class="material-tracking-code">@InventoryTrackingShortCode</code>
                                <span>@_material.SKU</span>
                            </div>
                        </div>
                        <div class="material-label-actions">
                            <SecondaryButton Icon="@Icons.Material.Outlined.Print" OnClick="@PrintLabelsAsync">Print label</SecondaryButton>
                            <SecondaryButton Icon="@Icons.Material.Outlined.OpenInNew" Href="@MaterialRecordHref">Open material</SecondaryButton>
                        </div>
                    </div>
                }
            </PanelCard>

            @if (_createdItem is not null)
            {
                <PanelCard Title="Latest item label">
                    <div class="material-label-panel material-print-label">
                        <div class="material-label-heading">
                            <span>Apply to raw stock</span>
                            <strong>@_createdItem.Location</strong>
                        </div>
                        <div class="material-qr-label-body">
                            <div class="material-qr-shell" aria-label="@($"QR code for {_createdItem.TrackingCode}")">
                                @CreatedItemQrSvg
                            </div>
                            <div class="material-label-copy">
                                <code class="material-tracking-code">@_createdItem.TrackingCode</code>
                                <span>@_createdItem.FormFactor</span>
                                <span>@FormatItemQuantity(_createdItem.RemainingQuantity, _createdItem.QuantityUnit)</span>
                            </div>
                        </div>
                        <dl class="mlv-detail-list material-batch-detail-list">
                            <dt>Lot</dt><dd>@DisplayNullable(_createdItem.LotNumber)</dd>
                            <dt>Grade</dt><dd>@DisplayNullable(_createdItem.MaterialGrade)</dd>
                            <dt>Received</dt><dd>@_createdItem.ReceivedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd>
                        </dl>
                        <SecondaryButton Icon="@Icons.Material.Outlined.Print" OnClick="@PrintLabelsAsync">Print label</SecondaryButton>
                    </div>
                </PanelCard>
            }

            <PanelCard Title="Physical stock items">
                @if (_loadingInventory)
                {
                    <MudSkeleton Height="54px" />
                    <MudSkeleton Height="54px" />
                }
                else if (_inventoryItems.Count > 0)
                {
                    <div class="material-item-list">
                        @foreach (var item in _inventoryItems)
                        {
                            <div class="material-item-entry">
                                <div>
                                    <strong>@item.TrackingCode</strong>
                                    <span>@item.FormFactor · @FormatItemQuantity(item.RemainingQuantity, item.QuantityUnit) · @item.Location</span>
                                    <small>@FormatItemDimensions(item)</small>
                                </div>
                                <StatusBadge Status="@item.Status" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="material-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.QrCode2" Size="Size.Small" />
                        <div>
                            <strong>No item labels yet</strong>
                            <span>Receive each spool, block, sheet, or piece to make it individually traceable.</span>
                        </div>
                    </div>
                }
            </PanelCard>

            <PanelCard Title="Suppliers">
                @if (_material?.Suppliers.Count > 0)
                {
                    <div class="material-supplier-list">
                        @foreach (var supplier in _material.Suppliers)
                        {
                            <div class="material-supplier-entry">
                                <div>
                                    <strong>@supplier.Name</strong>
                                    <span>@DisplaySupplierLocation(supplier)</span>
                                    @if (!string.IsNullOrWhiteSpace(supplier.MatchReason))
                                    {
                                        <small>@supplier.MatchReason</small>
                                    }
                                </div>
                                <StatusBadge Status="@supplier.Status" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="material-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                        <div>
                            <strong>No supplier candidates</strong>
                            <span>Add supplier capabilities that match this material or manufacturing process.</span>
                        </div>
                    </div>
                }
                <div class="material-side-actions">
                    <SecondaryButton Icon="@Icons.Material.Outlined.Handshake" Href="/purchasing/suppliers">Manage suppliers</SecondaryButton>
                </div>
            </PanelCard>
        </aside>
    </div>;

    [Parameter]
    public Guid Id { get; set; }

    private MaterialDetailDto? _material;
    private MaterialEditModel? _editModel;
    private EditContext? _editContext;
    private MaterialInventoryStatusDto? _inventoryStatus;
    private List<InventoryItemDto> _inventoryItems = [];
    private InventoryItemDto? _createdItem;
    private ReceiveItemModel _receiveItem = new();
    private bool _loading = true;
    private bool _loadingInventory;
    private bool _saving;
    private bool _editing;
    private bool _receivingItem;
    private bool _canUpdateMaterial;
    private bool _colorsLoading;
    private string? _inventoryError;
    private List<MaterialColorDto> _colorOptions = [];

    private static readonly IReadOnlyList<string> MaterialFormFactors =
    [
        "Spool",
        "Block",
        "Sheet",
        "Bar",
        "Rod",
        "Bottle",
        "Bag",
        "Piece"
    ];

    private static readonly IReadOnlyList<string> MaterialQuantityUnits =
    [
        "g",
        "kg",
        "m",
        "pcs",
        "spool",
        "block"
    ];

    private IReadOnlyList<string> MaterialProcesses =>
        _material?.ManufacturingProcesses.Count > 0
            ? _material.ManufacturingProcesses
            : SplitDisplayList(_material?.Category);

    private bool IsActiveMaterial => _material is not null && string.Equals(_material.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private bool IsOutOfStock => _material is { QuantityOnHand: <= 0 } && IsActiveMaterial;

    private bool IsLowStock => _material is not null
        && IsActiveMaterial
        && _material.ReorderLevel > 0
        && _material.QuantityOnHand > 0
        && _material.QuantityOnHand <= _material.ReorderLevel;

    private decimal InventoryValue => (_material?.QuantityOnHand ?? 0) * (_material?.UnitPrice ?? 0);

    private string StockHealthLabel => _material switch
    {
        null => "Unknown",
        _ when !IsActiveMaterial => "Inactive",
        _ when IsOutOfStock => "Out of stock",
        _ when IsLowStock => "Low stock",
        _ => "Stock ready"
    };

    private string StockHealthText => _material switch
    {
        null => "No material loaded",
        _ when !IsActiveMaterial => "Inactive material",
        _ when IsOutOfStock => "No stock available",
        _ when IsLowStock => $"Low stock. Reorder at {_material.ReorderLevel:N0} {_material.Unit}",
        _ when _material.ReorderLevel > 0 => $"Healthy. Reorder at {_material.ReorderLevel:N0} {_material.Unit}",
        _ => "Reorder point not configured"
    };

    private string StockHealthColor => _material switch
    {
        null => "var(--mud-palette-text-secondary)",
        _ when IsOutOfStock => "var(--mud-palette-error)",
        _ when IsLowStock => "var(--mud-palette-warning)",
        _ when !IsActiveMaterial => "var(--mud-palette-text-secondary)",
        _ => "var(--mud-palette-success)"
    };

    private string InventoryStatusClass => _material switch
    {
        null => "is-muted",
        _ when IsOutOfStock => "is-critical",
        _ when IsLowStock => "is-warning",
        _ when !IsActiveMaterial => "is-muted",
        _ => "is-ready"
    };

