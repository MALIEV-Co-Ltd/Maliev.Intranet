@page "/mfg/materials"
@using System.Globalization
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Materials | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Materials" Subtitle="Catalog materials and stock levels" BackHref="/mfg">
        <PrimaryButton Icon="@Icons.Material.Outlined.Add" OnClick="@ShowCreateAsync">Add Material</PrimaryButton>
    </PageHeader>

    <PageBody Class="mlv-data-page-body">
        <StatBar Class="mb-4">
            <StatTile Label="Materials" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="On page" Value="@_materials.Count.ToString("N0")" />
            <StatTile Label="Active" Value="@_materials.Count(IsActive).ToString("N0")" />
            <StatTile Label="Stock alerts" Value="@StockAlertCount.ToString("N0")" Color="@StockAlertColor" Subtext="@StockAlertSubtext" />
            <StatTile Label="Stock value" Value="@_materials.Sum(m => m.UnitPrice * m.QuantityOnHand).ToString("N2")" />
        </StatBar>

        @if (_showCreate)
        {
            <PanelCard Title="Create material" Class="mb-4">
                <FormGrid>
                    <FormField Label="Name"><ImmediateInputText class="mlv-form-input" @bind-Value="_newMaterial.Name" /></FormField>
                    <FormField Label="Code"><ImmediateInputText class="mlv-form-input mlv-mono" @bind-Value="_newMaterial.SKU" /></FormField>
                    <FormField Label="Unit price"><ImmediateInputNumber class="mlv-form-input" @bind-Value="_newMaterial.UnitPrice" /></FormField>
                    <FormField Label="Stock"><ImmediateInputNumber class="mlv-form-input" @bind-Value="_newMaterial.QuantityOnHand" /></FormField>
                    <FormField Label="Unit"><ImmediateInputText class="mlv-form-input" @bind-Value="_newMaterial.Unit" /></FormField>
                    <FormField Label="Description" Class="mlv-span-6"><ImmediateInputTextArea class="mlv-form-textarea" @bind-Value="_newMaterial.Description" /></FormField>
                </FormGrid>
                <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                    <SecondaryButton OnClick="@HideCreateAsync">Cancel</SecondaryButton>
                    <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@_saving" OnClick="@CreateMaterialAsync">Create Material</PrimaryButton>
                </div>
            </PanelCard>
        }

        <PanelCard Class="material-filter-panel mb-4">
            <div class="material-filter-grid">
                <label class="material-filter-field material-filter-search">
                    <span>Search</span>
                    <input class="mlv-form-input material-search-input"
                           placeholder="Name, code, description..."
                           value="@_search"
                           @oninput="@((ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty)"
                           @onkeydown="OnSearchKeyDown" />
                </label>
                <label class="material-filter-field">
                    <span>Process</span>
                    <select class="mlv-form-input material-process-filter" @bind="_manufacturingProcessFilter">
                        <option value="">All processes</option>
                        @foreach (var process in _processOptions.OrderBy(process => process.SortOrder).ThenBy(process => process.Name))
                        {
                            <option value="@process.Name">@process.Name</option>
                        }
                    </select>
                </label>
                <label class="material-filter-field">
                    <span>Color</span>
                    <select class="mlv-form-input material-color-filter" @bind="_colorFilter">
                        <option value="">All colors</option>
                        @foreach (var color in _colorOptions.OrderBy(color => color.Name))
                        {
                            <option value="@color.Name">@color.Name</option>
                        }
                    </select>
                </label>
                <label class="material-filter-field">
                    <span>Min price</span>
                    <input class="mlv-form-input"
                           inputmode="decimal"
                           value="@_minPriceText"
                           @oninput="@((ChangeEventArgs args) => _minPriceText = args.Value?.ToString() ?? string.Empty)" />
                </label>
                <label class="material-filter-field">
                    <span>Max price</span>
                    <input class="mlv-form-input"
                           inputmode="decimal"
                           value="@_maxPriceText"
                           @oninput="@((ChangeEventArgs args) => _maxPriceText = args.Value?.ToString() ?? string.Empty)" />
                </label>
                <label class="material-filter-field">
                    <span>Sort</span>
                    <select class="mlv-form-input material-sort-select" @bind="_sortBy">
                        <option value="name">Name</option>
                        <option value="price">Unit price</option>
                        <option value="stock">Stock</option>
                        <option value="createdAt">Newest</option>
                    </select>
                </label>
                <label class="material-filter-toggle">
                    <input type="checkbox" @bind="_sortDesc" />
                    <span>Descending</span>
                </label>
                <div class="material-filter-actions">
                    <PrimaryButton Icon="@Icons.Material.Outlined.Search" Disabled="@_loading" OnClick="@ApplyFiltersAsync">Search</PrimaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.FilterAltOff" Disabled="@(!HasActiveFilters || _loading)" OnClick="@ClearFiltersAsync">Clear</SecondaryButton>
                </div>
            </div>
        </PanelCard>

        <PanelCard Class="mlv-data-results-panel">
            @if (_loading)
            {
                <ProgressiveSkeleton Layout="table" Rows="7" Columns="6" ShowFilters="false" Label="Loading materials" />
            }
            else if (_materials.Count == 0)
            {
                <div class="mlv-empty">No materials found.</div>
            }
            else
            {
                <table class="mlv-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Stock</th>
                            <th>Unit price</th>
                            <th class="material-actions-header">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in _materials)
                        {
                            <tr class="@GetStockRowClass(material)" @onclick="@(() => OpenMaterial(material))">
                                <td>@material.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(material.Category) ? "-" : material.Category)</td>
                                <td><StatusBadge Status="@material.Status" /></td>
                                <td>
                                    <div class="@GetStockIndicatorClass(material)" aria-label="@GetStockAccessibilityLabel(material)">
                                        <span class="material-stock-icon" aria-hidden="true">
                                            <MudIcon Icon="@GetStockIcon(material)" Size="Size.Small" />
                                        </span>
                                        <span class="material-stock-copy">
                                            <span class="material-stock-quantity">@material.QuantityOnHand.ToString("N0") @material.Unit</span>
                                            <span class="material-stock-label">@GetStockLabel(material)</span>
                                        </span>
                                    </div>
                                </td>
                                <td class="mlv-mono">@material.UnitPrice.ToString("N2")</td>
                                <td class="material-actions-cell">
                                    <div class="material-row-actions">
                                        @if (NeedsStockAction(material))
                                        {
                                            <button type="button" class="material-action-button material-action-button--restock" @onclick:stopPropagation="true" @onclick="@(() => CreateRestockOrder(material))">
                                                <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Small" />
                                                <span>Order more</span>
                                            </button>
                                        }
                                        <button type="button" class="material-action-button" @onclick:stopPropagation="true" @onclick="@(() => OpenMaterial(material))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                            <span>Update stock</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </PanelCard>

        <PaginationFooter Meta="@_meta"
                          CurrentPage="@_page"
                          PageSize="@_pageSize"
                          PageChanged="OnPageChanged"
                          PageSizeChanged="OnPageSizeChanged"
                          Disabled="@_loading" />
    </PageBody>
</div>

@code {
    private readonly List<MaterialSummaryDto> _materials = [];
    private PaginationMeta _meta = new();
    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private int _page = 1;
    private int _pageSize = 20;
    private CreateMaterialRequest _newMaterial = new() { Unit = "pcs" };
    private string _search = string.Empty;
    private string _manufacturingProcessFilter = string.Empty;
    private string _colorFilter = string.Empty;
    private string _minPriceText = string.Empty;
    private string _maxPriceText = string.Empty;
    private string _sortBy = "name";
    private bool _sortDesc;
    private readonly List<ProcessDto> _processOptions = [];
    private readonly List<MaterialColorDto> _colorOptions = [];
    private int StockAlertCount => _materials.Count(NeedsStockAction);
    private string StockAlertColor => StockAlertCount > 0 ? "var(--maliev-danger)" : "var(--maliev-ok)";
    private string StockAlertSubtext => StockAlertCount > 0 ? "Needs restock or stock update" : "No active alerts";
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrWhiteSpace(_manufacturingProcessFilter)
        || !string.IsNullOrWhiteSpace(_colorFilter)
        || !string.IsNullOrWhiteSpace(_minPriceText)
        || !string.IsNullOrWhiteSpace(_maxPriceText)
        || !string.Equals(_sortBy, "name", StringComparison.OrdinalIgnoreCase)
        || _sortDesc;

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptionsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (!TryReadPriceFilters(out var minPrice, out var maxPrice))
            {
                return;
            }

            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>(BuildMaterialsRequestUri(minPrice, maxPrice));
            _materials.Clear();
            _materials.AddRange(response?.Data ?? []);
            _meta = response?.Meta ?? new PaginationMeta();
            _meta.CurrentPage = _meta.CurrentPage == 0 ? _page : _meta.CurrentPage;
            _meta.PageSize = _meta.PageSize == 0 ? _pageSize : _meta.PageSize;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load materials: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadFilterOptionsAsync()
    {
        try
        {
            var processesTask = Http.GetFromJsonAsync<List<ProcessDto>>("api/v1/catalog/processes");
            var colorsTask = Http.GetFromJsonAsync<List<MaterialColorDto>>("api/v1/materials/reference/colors");
            await Task.WhenAll(processesTask, colorsTask);

            _processOptions.Clear();
            _processOptions.AddRange(processesTask.Result ?? []);
            _colorOptions.Clear();
            _colorOptions.AddRange(colorsTask.Result ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load material filters: {ex.Message}", Severity.Warning);
        }
    }

    private string BuildMaterialsRequestUri(decimal? minPrice, decimal? maxPrice)
    {
        var query = new List<string>
        {
            $"page={_page.ToString(CultureInfo.InvariantCulture)}",
            $"pageSize={_pageSize.ToString(CultureInfo.InvariantCulture)}"
        };

        AddQueryParameter(query, "search", _search);
        AddQueryParameter(query, "manufacturingProcess", _manufacturingProcessFilter);
        AddQueryParameter(query, "color", _colorFilter);
        AddQueryParameter(query, "sortBy", _sortBy);
        if (_sortDesc)
        {
            AddQueryParameter(query, "sortDesc", "true");
        }

        if (minPrice.HasValue)
        {
            AddQueryParameter(query, "minPrice", minPrice.Value.ToString(CultureInfo.InvariantCulture));
        }

        if (maxPrice.HasValue)
        {
            AddQueryParameter(query, "maxPrice", maxPrice.Value.ToString(CultureInfo.InvariantCulture));
        }

        return $"api/v1/materials?{string.Join("&", query)}";
    }

    private static void AddQueryParameter(List<string> query, string name, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        query.Add($"{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value.Trim())}");
    }

    private bool TryReadPriceFilters(out decimal? minPrice, out decimal? maxPrice)
    {
        minPrice = null;
        maxPrice = null;

        if (!TryReadDecimalFilter(_minPriceText, "minimum price", out minPrice) ||
            !TryReadDecimalFilter(_maxPriceText, "maximum price", out maxPrice))
        {
            return false;
        }

        if (minPrice.HasValue && maxPrice.HasValue && minPrice.Value > maxPrice.Value)
        {
            Snackbar.Add("Minimum price must be less than or equal to maximum price.", Severity.Warning);
            return false;
        }

        return true;
    }

    private bool TryReadDecimalFilter(string value, string label, out decimal? result)
    {
        result = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0)
        {
            result = parsed;
            return true;
        }

        Snackbar.Add($"Enter a valid {label}.", Severity.Warning);
        return false;
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync(MouseEventArgs _)
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync(MouseEventArgs _)
    {
        _search = string.Empty;
        _manufacturingProcessFilter = string.Empty;
        _colorFilter = string.Empty;
        _minPriceText = string.Empty;
        _maxPriceText = string.Empty;
        _sortBy = "name";
        _sortDesc = false;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _page = 1;
            await LoadAsync();
        }
    }

    private Task ShowCreateAsync(MouseEventArgs _)
    {
        _showCreate = true;
        return Task.CompletedTask;
    }

    private Task HideCreateAsync(MouseEventArgs _)
    {
        _showCreate = false;
        return Task.CompletedTask;
    }

    private async Task CreateMaterialAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_newMaterial.Name) ||
            string.IsNullOrWhiteSpace(_newMaterial.SKU) ||
            _newMaterial.UnitPrice <= 0)
        {
            Snackbar.Add("Enter material name, code, and a positive unit price.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var request = _newMaterial with
            {
                Name = _newMaterial.Name.Trim(),
                SKU = _newMaterial.SKU.Trim(),
                Unit = string.IsNullOrWhiteSpace(_newMaterial.Unit) ? "pcs" : _newMaterial.Unit.Trim(),
                Description = _newMaterial.Description?.Trim() ?? string.Empty
            };

            var response = await Http.PostAsJsonAsync("api/v1/materials", request);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Material could not be created.", Severity.Warning);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<MaterialSummaryDto>();
            Snackbar.Add("Material created.", Severity.Success);
            _newMaterial = new CreateMaterialRequest { Unit = "pcs" };
            _showCreate = false;

            if (created is not null)
            {
                Navigation.NavigateTo($"/mfg/materials/{created.Id}");
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to create material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsActive(MaterialSummaryDto material)
    {
        return string.Equals(material.Status, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsOutOfStock(MaterialSummaryDto material)
    {
        return IsActive(material) && material.QuantityOnHand <= 0;
    }

    private static bool IsLowStock(MaterialSummaryDto material)
    {
        return IsActive(material) && material.ReorderLevel > 0 && material.QuantityOnHand > 0 && material.QuantityOnHand <= material.ReorderLevel;
    }

    private static bool NeedsStockAction(MaterialSummaryDto material)
    {
        return IsOutOfStock(material) || IsLowStock(material);
    }

    private static string GetStockRowClass(MaterialSummaryDto material)
    {
        return IsOutOfStock(material)
            ? "material-stock-row material-stock-row--critical"
            : IsLowStock(material)
                ? "material-stock-row material-stock-row--warning"
                : "material-stock-row";
    }

    private static string GetStockIndicatorClass(MaterialSummaryDto material)
    {
        return IsOutOfStock(material)
            ? "material-stock-alert material-stock-alert--critical"
            : IsLowStock(material)
                ? "material-stock-alert material-stock-alert--warning"
                : "material-stock-alert material-stock-alert--ok";
    }

    private static string GetStockIcon(MaterialSummaryDto material)
    {
        return NeedsStockAction(material) ? Icons.Material.Filled.WarningAmber : Icons.Material.Outlined.Inventory2;
    }

    private static string GetStockLabel(MaterialSummaryDto material)
    {
        if (IsOutOfStock(material))
        {
            return "Out of stock";
        }

        if (IsLowStock(material))
        {
            return $"Low stock. Reorder at {material.ReorderLevel:N0} {material.Unit}";
        }

        return material.ReorderLevel > 0
            ? $"Healthy. Reorder at {material.ReorderLevel:N0} {material.Unit}"
            : "Available";
    }

    private static string GetStockAccessibilityLabel(MaterialSummaryDto material)
    {
        return $"{material.Name} stock: {material.QuantityOnHand:N0} {material.Unit}. {GetStockLabel(material)}";
    }

    private void OpenMaterial(MaterialSummaryDto material)
    {
        Navigation.NavigateTo($"/mfg/materials/{material.Id}");
    }

    private void CreateRestockOrder(MaterialSummaryDto material)
    {
        var query = $"materialId={Uri.EscapeDataString(material.Id.ToString())}&materialName={Uri.EscapeDataString(material.Name)}";
        Navigation.NavigateTo($"/purchasing/new?{query}");
    }
}
