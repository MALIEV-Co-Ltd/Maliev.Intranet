@page "/mfg/materials"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Materials | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Materials" Subtitle="Catalog materials and stock levels" BackHref="/mfg">
        <PrimaryButton Icon="@Icons.Material.Outlined.Add" OnClick="@ShowCreateAsync">Add Material</PrimaryButton>
    </PageHeader>

    <PageBody>
        <StatBar Class="mb-4">
            <StatTile Label="Materials" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="On page" Value="@_materials.Count.ToString("N0")" />
            <StatTile Label="Active" Value="@_materials.Count(IsActive).ToString("N0")" />
            <StatTile Label="Stock value" Value="@_materials.Sum(m => m.UnitPrice * m.QuantityOnHand).ToString("N2")" />
        </StatBar>

        @if (_showCreate)
        {
            <PanelCard Title="Create material" Class="mb-4">
                <FormGrid>
                    <FormField Label="Name"><ImmediateInputText class="mlv-form-input" @bind-Value="_newMaterial.Name" /></FormField>
                    <FormField Label="Code"><ImmediateInputText class="mlv-form-input mlv-mono" @bind-Value="_newMaterial.SKU" /></FormField>
                    <FormField Label="Unit price"><ImmediateInputNumber class="mlv-form-input" @bind-Value="_newMaterial.UnitPrice" /></FormField>
                    <FormField Label="Stock"><ImmediateInputNumber class="mlv-form-input" @bind-Value="_newMaterial.QuantityOnHand" /></FormField>
                    <FormField Label="Unit"><ImmediateInputText class="mlv-form-input" @bind-Value="_newMaterial.Unit" /></FormField>
                    <FormField Label="Description" Class="mlv-span-6"><ImmediateInputTextArea class="mlv-form-textarea" @bind-Value="_newMaterial.Description" /></FormField>
                </FormGrid>
                <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                    <SecondaryButton OnClick="@HideCreateAsync">Cancel</SecondaryButton>
                    <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@_saving" OnClick="@CreateMaterialAsync">Create Material</PrimaryButton>
                </div>
            </PanelCard>
        }

        <PanelCard>
            @if (_loading)
            {
                <div class="mlv-empty">Loading materials...</div>
            }
            else if (_materials.Count == 0)
            {
                <div class="mlv-empty">No materials found.</div>
            }
            else
            {
                <table class="mlv-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Stock</th>
                            <th>Unit price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in _materials)
                        {
                            <tr @onclick="@(() => Navigation.NavigateTo($"/mfg/materials/{material.Id}"))">
                                <td>@material.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(material.Category) ? "-" : material.Category)</td>
                                <td><StatusBadge Status="@material.Status" /></td>
                                <td class="mlv-mono">@material.QuantityOnHand.ToString("N0") @material.Unit</td>
                                <td class="mlv-mono">@material.UnitPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </PanelCard>

        <PaginationFooter Meta="@_meta"
                          CurrentPage="@_page"
                          PageSize="@_pageSize"
                          PageChanged="OnPageChanged"
                          PageSizeChanged="OnPageSizeChanged"
                          Disabled="@_loading" />
    </PageBody>
</div>

@code {
    private readonly List<MaterialSummaryDto> _materials = [];
    private PaginationMeta _meta = new();
    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private int _page = 1;
    private int _pageSize = 20;
    private CreateMaterialRequest _newMaterial = new() { Unit = "pcs" };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>($"api/v1/materials?page={_page}&pageSize={_pageSize}");
            _materials.Clear();
            _materials.AddRange(response?.Data ?? []);
            _meta = response?.Meta ?? new PaginationMeta();
            _meta.CurrentPage = _meta.CurrentPage == 0 ? _page : _meta.CurrentPage;
            _meta.PageSize = _meta.PageSize == 0 ? _pageSize : _meta.PageSize;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load materials: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await LoadAsync();
    }

    private Task ShowCreateAsync(MouseEventArgs _)
    {
        _showCreate = true;
        return Task.CompletedTask;
    }

    private Task HideCreateAsync(MouseEventArgs _)
    {
        _showCreate = false;
        return Task.CompletedTask;
    }

    private async Task CreateMaterialAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_newMaterial.Name) ||
            string.IsNullOrWhiteSpace(_newMaterial.SKU) ||
            _newMaterial.UnitPrice <= 0)
        {
            Snackbar.Add("Enter material name, code, and a positive unit price.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var request = _newMaterial with
            {
                Name = _newMaterial.Name.Trim(),
                SKU = _newMaterial.SKU.Trim(),
                Unit = string.IsNullOrWhiteSpace(_newMaterial.Unit) ? "pcs" : _newMaterial.Unit.Trim(),
                Description = _newMaterial.Description?.Trim() ?? string.Empty
            };

            var response = await Http.PostAsJsonAsync("api/v1/materials", request);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Material could not be created.", Severity.Warning);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<MaterialSummaryDto>();
            Snackbar.Add("Material created.", Severity.Success);
            _newMaterial = new CreateMaterialRequest { Unit = "pcs" };
            _showCreate = false;

            if (created is not null)
            {
                Navigation.NavigateTo($"/mfg/materials/{created.Id}");
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to create material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsActive(MaterialSummaryDto material)
    {
        return string.Equals(material.Status, "Active", StringComparison.OrdinalIgnoreCase);
    }
}
