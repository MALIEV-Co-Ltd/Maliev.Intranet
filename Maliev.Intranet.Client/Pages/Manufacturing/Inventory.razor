@page "/mfg/inventory"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Inventory - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Inventory Management</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Real-time stock levels, reorder alerts, and material availability
</MudText>

<!-- Stats Row -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total SKUs</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;">@_materials.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Low Stock Alerts</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Warning">@_materials.Count(m => m.Status == "Low Stock")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Out of Stock</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Error">@_materials.Count(m => m.Status == "Out of Stock")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Active Materials</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Success">@_materials.Count(m => m.Status == "Active")</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Filters & Actions -->
<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search materials..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Style="min-width: 250px;" />
            <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;">
                <MudSelectItem Value="@("")">All Statuses</MudSelectItem>
                <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                <MudSelectItem Value="@("Low Stock")">Low Stock</MudSelectItem>
                <MudSelectItem Value="@("Out of Stock")">Out of Stock</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_categoryFilter" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;">
                <MudSelectItem Value="@("")">All Categories</MudSelectItem>
                <MudSelectItem Value="@("Filament")">Filament</MudSelectItem>
                <MudSelectItem Value="@("Resin")">Resin</MudSelectItem>
                <MudSelectItem Value="@("Metal")">Metal</MudSelectItem>
                <MudSelectItem Value="@("Polymer")">Polymer</MudSelectItem>
            </MudSelect>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportInventory">Export</MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    @for (int i = 0; i < 6; i++)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
    }
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="MaterialSummaryDto" Items="@FilteredMaterials" Dense="true" Hover="true" Elevation="0" SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn Property="x => x.SKU" Title="SKU" />
                <PropertyColumn Property="x => x.Name" Title="Material Name" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <TemplateColumn Title="Stock Level">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.body2" Style="min-width:80px;">@context.Item.QuantityOnHand @context.Item.Unit</MudText>
                            <MudProgressLinear Color="@GetStockColor(context.Item)" Value="@GetStockPercent(context.Item)" Style="min-width:80px;" Size="Size.Small" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ReorderLevel" Title="Reorder At" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.UnitPrice" Title="Unit Price" Format="C2" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" Href="@($"/mfg/materials/{context.Item.Id}")" />
                            @if (context.Item.Status == "Low Stock" || context.Item.Status == "Out of Stock")
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.ShoppingCart" Size="Size.Small" Color="Color.Warning" OnClick="@(() => Snackbar.Add($"Create PO for {context.Item.Name}", Severity.Info))" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Color="Color.Secondary" Style="font-size:60px;" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No inventory data</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Add materials to see inventory levels here</MudText>
                </MudStack>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private string _statusFilter = "";
    private string _categoryFilter = "";
    private List<MaterialSummaryDto> _materials = new();

    private IEnumerable<MaterialSummaryDto> FilteredMaterials => _materials
        .Where(m => (string.IsNullOrEmpty(_searchString) || m.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || m.SKU.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                 && (string.IsNullOrEmpty(_statusFilter) || m.Status == _statusFilter)
                 && (string.IsNullOrEmpty(_categoryFilter) || m.Category == _categoryFilter));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>("api/materials?pageSize=200");
            _materials = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading inventory: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private double GetStockPercent(MaterialSummaryDto m)
    {
        if (m.ReorderLevel <= 0) return 100;
        var max = m.ReorderLevel * 3;
        return Math.Min(100, m.QuantityOnHand / (double)max * 100);
    }

    private Color GetStockColor(MaterialSummaryDto m) => m.Status switch
    {
        "Out of Stock" => Color.Error,
        "Low Stock" => Color.Warning,
        _ => Color.Success
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Low Stock" => Color.Warning,
        "Out of Stock" => Color.Error,
        "Discontinued" => Color.Dark,
        _ => Color.Default
    };

    private void ExportInventory()
    {
        Snackbar.Add("Inventory export started...", Severity.Info);
    }
}
