    private async Task ScanJobTicketAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_jobTicketScanCode))
        {
            _jobTicketScanError = "Scan the job ticket QR code or paste the job id.";
            return;
        }

        _scanningJobTicket = true;
        _jobTicketScanError = null;
        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/v1/jobs/ticket-scan",
                new JobTicketScanRequest { Code = _jobTicketScanCode.Trim() });

            if (!response.IsSuccessStatusCode)
            {
                _jobTicketScanError = await ReadScheduleErrorAsync(response);
                return;
            }

            var job = await response.Content.ReadFromJsonAsync<JobDetailDto>();
            if (job is null)
            {
                _jobTicketScanError = "No job matched that ticket.";
                return;
            }

            CloseMovePanel();
            _selectedSlot = FindScheduleSlotForJob(job.Id) ?? BuildScannedJobSlot(job);
            _selectedJobDetail = job;
            _jobEditModel = null;
            _jobCustomer = null;
            _jobInventoryStatus = null;
            _jobInventoryItems = [];
            _selectedInventoryItem = null;
            _materialScanCode = string.Empty;
            _materialConsumeQuantity = null;
            _slotDetailsError = null;
            _jobDetailsEditError = null;
            _materialTraceError = null;
            InitializeJobEditor(job);
            await LoadJobReferenceDataAsync(job);
        }
        catch (Exception ex)
        {
            _jobTicketScanError = $"Job ticket could not be resolved: {ex.Message}";
        }
        finally
        {
            _scanningJobTicket = false;
        }
    }

