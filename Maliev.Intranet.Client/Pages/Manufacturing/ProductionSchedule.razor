    private static string FormatInventoryAvailability(MaterialInventoryStatusDto? status)
    {
        if (status is null)
            return "No active stock batch reported for this material.";

        var remaining = status.TotalRemainingGrams.ToString("N0", CultureInfo.InvariantCulture);
        var lowest = status.LowestBatchGrams.ToString("N0", CultureInfo.InvariantCulture);
        var alert = status.HasLowStockAlert ? " Low-stock alert active." : string.Empty;
        return $"{status.ActiveBatches:N0} active batch(es), {remaining} g remaining. Lowest batch {lowest} g.{alert}";
    }

