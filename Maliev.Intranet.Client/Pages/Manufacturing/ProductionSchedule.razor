@page "/mfg/production-schedule"
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Production schedule | MALIEV Intranet</PageTitle>

<div class="production-schedule-page mlv-module-shell">
    <ModuleHeader Title="Production schedule" Subtitle="Reserved machine slots across queued jobs and active planning holds.">
        <SecondaryButton Icon="@Icons.Material.Outlined.Refresh" Disabled="@_loading" OnClick="@ReloadClickedAsync">Refresh</SecondaryButton>
    </ModuleHeader>

    <PageBody Class="production-schedule-body">
        <PanelCard Class="production-schedule-card">
            @if (_loading)
            {
                <ProgressiveSkeleton Layout="table" Rows="6" Columns="6" ShowFilters="false" Class="mb-3" Label="Loading production schedule" />
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="production-schedule-error">@_error</div>
            }

            <div class="production-job-ticket-scan" aria-label="Job ticket scan">
                <div>
                    <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" Size="Size.Small" />
                    <span>Job ticket</span>
                </div>
                <label>
                    <span>Scan QR / job id</span>
                    <input value="@_jobTicketScanCode"
                           @oninput="OnJobTicketScanChanged"
                           placeholder="Scan job QR or paste job id"
                           disabled="@_scanningJobTicket" />
                </label>
                <SecondaryButton Icon="@Icons.Material.Outlined.QrCodeScanner"
                                 Disabled="@(_scanningJobTicket || string.IsNullOrWhiteSpace(_jobTicketScanCode))"
                                 OnClick="@ScanJobTicketAsync">
                    @(_scanningJobTicket ? "Scanning..." : "Scan job")
                </SecondaryButton>
            </div>

            @if (!string.IsNullOrWhiteSpace(_jobTicketScanError))
            {
                <div class="production-schedule-error" role="alert">@_jobTicketScanError</div>
            }

            <ProductionScheduleBoard Board="_board"
                                     Title="Scheduled work centers"
                                     Eyebrow="Machine queue"
                                     OnRefresh="@LoadBoardAsync"
                                     RangeStartChanged="@OnRangeStartChangedAsync"
                                     MoveRequested="@OpenMovePanelAsync"
                                     SlotSelected="@SelectSlotAsync" />
        </PanelCard>

        @if (_moveSlot is not null)
        {
            <section class="production-move-panel" aria-label="Reschedule selected slot">
                <header>
                    <span>Reschedule slot</span>
                    <strong>@SlotTitle(_moveSlot)</strong>
                    <button type="button" aria-label="Close reschedule panel" @onclick="CloseMovePanel">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>

                <div class="production-move-grid">
                    <label>
                        <span>Machine</span>
                        <select value="@_moveMachineId" disabled aria-describedby="production-move-machine-lock">
                            @foreach (var machine in MoveMachines)
                            {
                                <option value="@machine.MachineId">@machine.MachineName</option>
                            }
                        </select>
                        <small id="production-move-machine-lock">Locked to the selected slot.</small>
                    </label>

                    <label>
                        <span>Start</span>
                        <input type="datetime-local" value="@FormatDateTimeLocal(_moveStartLocal)" @onchange="OnMoveStartChanged" />
                    </label>

                    <label>
                        <span>End</span>
                        <input type="datetime-local" value="@FormatDateTimeLocal(_moveEndLocal)" @onchange="OnMoveEndChanged" />
                    </label>

                    <label>
                        <span>Queue position</span>
                        <input type="number" min="0" value="@FormatQueuePosition()" @oninput="OnMoveQueuePositionChanged" />
                    </label>
                </div>

                <label class="production-move-checkbox">
                    <input type="checkbox" checked="@_moveCascade" @onchange="OnMoveCascadeChanged" />
                    <span>Cascade following queued jobs</span>
                </label>

                @if (!string.IsNullOrWhiteSpace(CurrentMoveMessage))
                {
                    <div class="production-move-error" role="alert">@CurrentMoveMessage</div>
                }

                <footer>
                    <SecondaryButton OnClick="@CancelMoveClickedAsync">Cancel</SecondaryButton>
                    <PrimaryButton Class="production-move-save" Icon="@Icons.Material.Outlined.Save" Disabled="@(!CanSaveMove)" OnClick="@SaveMoveClickedAsync">
                        @(_savingMove ? "Saving..." : "Save schedule")
                    </PrimaryButton>
                </footer>
            </section>
        }

        @if (_selectedSlot is { } selectedSlot)
        {
            <section class="production-slot-panel" aria-label="Planned slot details">
                <header>
                    <span>@SlotKind(selectedSlot)</span>
                    <strong>@SlotTitle(selectedSlot)</strong>
                    <button type="button" aria-label="Close slot details" @onclick="CloseSlotDetails">
                        <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                    </button>
                </header>

                <div class="production-slot-overview">
                    <div>
                        <span>Machine</span>
                        <strong>@FirstNonEmpty(selectedSlot.MachineName, selectedSlot.MachineId)</strong>
                    </div>
                    <div>
                        <span>Scheduled</span>
                        <strong>@FormatScheduleWindow(selectedSlot)</strong>
                    </div>
                    <div>
                        <span>Process</span>
                        <strong>@FormatTechnology(selectedSlot.Technology)</strong>
                    </div>
                    <div>
                        <span>Queue</span>
                        <strong>@FormatQueue(selectedSlot.QueuePosition)</strong>
                    </div>
                </div>

                @if (_loadingSlotDetails)
                {
                    <div class="production-slot-loading" aria-label="Loading job details">
                        <MudSkeleton Height="16px" Width="65%" />
                        <MudSkeleton Height="16px" Width="45%" />
                        <MudSkeleton Height="16px" Width="80%" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_slotDetailsError))
                {
                    <div class="production-slot-error">@_slotDetailsError</div>
                }

                @if (_selectedJobDetail is { } job)
                {
                    <div class="production-slot-section">
                        <div class="production-slot-section-title">
                            <MudIcon Icon="@Icons.Material.Outlined.Assignment" Size="Size.Small" />
                            <span>Job information</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_jobDetailsEditError))
                        {
                            <div class="production-slot-error" role="alert">@_jobDetailsEditError</div>
                        }

                        <dl class="production-slot-facts">
                            <div>
                                <dt>Order</dt>
                                <dd>@FormatOrder(job)</dd>
                            </div>
                            <div>
                                <dt>Part</dt>
                                <dd>@FirstNonEmpty(job.PartDescription, selectedSlot.FileName, "Not described")</dd>
                            </div>
                            <div>
                                <dt>Quantity</dt>
                                <dd>@FormatQuantity(job.Quantity)</dd>
                            </div>
                            <div>
                                <dt>Process</dt>
                                <dd>@FormatTechnology(job.ProcessType)</dd>
                            </div>
                        </dl>

                        @if (TryGetNextStageAction(job.Status, out var nextStatus, out var actionLabel))
                        {
                            <div class="production-job-stage-actions" aria-label="Job stage actions">
                                <div>
                                    <span>Current stage</span>
                                    <strong>@FormatStatus(job.Status)</strong>
                                </div>
                                <PrimaryButton Icon="@Icons.Material.Outlined.PlayArrow"
                                               Disabled="@_savingJobStage"
                                               OnClick="@(args => ApplyJobStageAsync(nextStatus, args))">
                                    @(_savingJobStage ? "Saving..." : actionLabel)
                                </PrimaryButton>
                            </div>
                        }
                        else if (CanReleaseOrderForShipping(job))
                        {
                            <div class="production-order-release-actions" aria-label="QC release actions">
                                <div>
                                    <span>Order handoff</span>
                                    <strong>@FirstNonEmpty(job.OrderNumber, "Linked order")</strong>
                                </div>
                                <PrimaryButton Icon="@Icons.Material.Outlined.LocalShipping"
                                               Disabled="@_releasingOrderForShipping"
                                               OnClick="@ReleaseOrderForShippingAsync">
                                    @(_releasingOrderForShipping ? "Releasing..." : "Release to shipping")
                                </PrimaryButton>
                            </div>
                        }

                        <div class="production-job-editor" aria-label="Editable job production details">
                            <label class="production-job-field production-job-field-wide">
                                <span>Customer</span>
                                <CustomerPicker SelectedCustomer="@_jobCustomer"
                                                SearchCustomers="@SearchCustomersAsync"
                                                OnCustomerSelected="@OnJobCustomerSelectedAsync"
                                                OpenBelow="true" />
                            </label>

                            <label class="production-job-field">
                                <span>Priority</span>
                                <select value="@(_jobEditModel?.PriorityValue.ToString(CultureInfo.InvariantCulture) ?? "3")"
                                        @onchange="OnJobPriorityChanged"
                                        disabled="@(_savingJobDetails || _jobEditModel is null)">
                                    <option value="1">Urgent</option>
                                    <option value="2">High</option>
                                    <option value="3">Normal</option>
                                    <option value="4">Low</option>
                                </select>
                            </label>

                            <label class="production-job-field">
                                <span>Queue status</span>
                                <select value="@(_jobEditModel?.Status ?? job.Status)"
                                        @onchange="OnJobStatusChanged"
                                        disabled="@(_savingJobDetails || _jobEditModel is null)">
                                    @foreach (var status in JobStatusOptions(job.Status))
                                    {
                                        <option value="@status">@FormatStatus(status)</option>
                                    }
                                </select>
                            </label>

                            <label class="production-job-field">
                                <span>Material</span>
                                <select value="@FormatGuidValue(_jobEditModel?.MaterialId)"
                                        @onchange="OnJobMaterialChanged"
                                        disabled="@(_savingJobDetails || _loadingJobReferences || _jobEditModel is null)">
                                    <option value="">Not set</option>
                                    @foreach (var material in _materialOptions)
                                    {
                                        <option value="@material.Id.ToString()">@MaterialOptionLabel(material)</option>
                                    }
                                </select>
                            </label>

                            <label class="production-job-field">
                                <span>Operator</span>
                                <select value="@(_jobEditModel?.Operator ?? string.Empty)"
                                        @onchange="OnJobOperatorChanged"
                                        disabled="@(_savingJobDetails || _loadingJobReferences || _jobEditModel is null)">
                                    <option value="">Unassigned</option>
                                    @foreach (var employee in _employeeOptions)
                                    {
                                        var label = EmployeeOptionLabel(employee);
                                        <option value="@label">@label</option>
                                    }
                                </select>
                            </label>
                        </div>

                        <div class="production-material-trace" aria-label="Material traceability">
                            <div>
                                <span>Material traceability</span>
                                <strong>@SelectedMaterialLabel(job)</strong>
                                <small>@FormatInventoryAvailability(_jobInventoryStatus)</small>
                            </div>
                            @if (_jobEditModel?.MaterialId is Guid materialId)
                            {
                                <SecondaryButton Icon="@Icons.Material.Outlined.OpenInNew" Href="@MaterialHref(materialId)">Open material</SecondaryButton>
                            }
                        </div>

                        <div class="production-material-item-workflow" aria-label="Exact material item traceability">
                            <div class="production-slot-section-title">
                                <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" Size="Size.Small" />
                                <span>Exact stock item</span>
                            </div>

                            <div class="production-material-scan-row">
                                <label class="production-job-field">
                                    <span>Scan QR / tracking code</span>
                                    <input value="@_materialScanCode"
                                           @oninput="OnMaterialScanChanged"
                                           placeholder="Scan item QR or paste tracking code"
                                           disabled="@(_scanningMaterialItem || _recordingMaterialUse)" />
                                </label>
                                <SecondaryButton Icon="@Icons.Material.Outlined.QrCodeScanner"
                                                 Disabled="@(_scanningMaterialItem || string.IsNullOrWhiteSpace(_materialScanCode))"
                                                 OnClick="@ScanMaterialItemAsync">
                                    @(_scanningMaterialItem ? "Scanning..." : "Scan item")
                                </SecondaryButton>
                            </div>

                            <label class="production-job-field">
                                <span>Active item</span>
                                <select value="@SelectedInventoryItemValue"
                                        @onchange="OnJobInventoryItemChanged"
                                        disabled="@(_recordingMaterialUse || _jobInventoryItems.Count == 0)">
                                    <option value="">Select stock item</option>
                                    @foreach (var inventoryItem in _jobInventoryItems)
                                    {
                                        <option value="@inventoryItem.TrackingCode">@InventoryItemOptionLabel(inventoryItem)</option>
                                    }
                                </select>
                            </label>

                            @if (!string.IsNullOrWhiteSpace(_materialTraceError))
                            {
                                <div class="production-slot-error" role="alert">@_materialTraceError</div>
                            }

                            @if (_selectedInventoryItem is { } selectedItem)
                            {
                                <div class="production-material-item-card">
                                    <div>
                                        <span>Tracking code</span>
                                        <strong>@selectedItem.TrackingCode</strong>
                                        <small>@FormatInventoryItemSummary(selectedItem)</small>
                                    </div>
                                    <dl class="production-slot-facts">
                                        <div>
                                            <dt>Remaining</dt>
                                            <dd>@FormatInventoryQuantity(selectedItem.RemainingQuantity, selectedItem.QuantityUnit)</dd>
                                        </div>
                                        <div>
                                            <dt>Location</dt>
                                            <dd>@FirstNonEmpty(selectedItem.Location, "Not stored")</dd>
                                        </div>
                                        <div>
                                            <dt>Lot</dt>
                                            <dd>@FirstNonEmpty(selectedItem.LotNumber, "Not recorded")</dd>
                                        </div>
                                        <div>
                                            <dt>Dimensions</dt>
                                            <dd>@FormatInventoryDimensions(selectedItem)</dd>
                                        </div>
                                    </dl>
                                </div>

                                <div class="production-material-use-row">
                                    <label class="production-job-field">
                                        <span>Quantity used (@selectedItem.QuantityUnit)</span>
                                        <input type="number"
                                               min="0.01"
                                               step="0.01"
                                               value="@FormatDecimalInput(_materialConsumeQuantity)"
                                               @oninput="OnMaterialConsumeQuantityChanged"
                                               disabled="@_recordingMaterialUse" />
                                    </label>
                                    <PrimaryButton Icon="@Icons.Material.Outlined.Inventory2"
                                                   Busy="@_recordingMaterialUse"
                                                   BusyLabel="Recording..."
                                                   Disabled="@(!CanRecordMaterialUse)"
                                                   OnClick="@RecordMaterialUseAsync">
                                        Record material use
                                    </PrimaryButton>
                                </div>
                            }
                            else if (_jobEditModel?.MaterialId is not null)
                            {
                                <div class="production-material-item-empty">
                                    No active QR-labeled stock item is selected for this job material.
                                </div>
                            }
                        </div>

                        <div class="production-job-actions">
                            <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@(!CanSaveJobDetails)" OnClick="@SaveJobDetailsAsync">
                                @(_savingJobDetails ? "Saving..." : "Save job details")
                            </PrimaryButton>
                        </div>
                    </div>
                }
                else if (!_loadingSlotDetails && selectedSlot.IsHold)
                {
                    <div class="production-slot-section">
                        <div class="production-slot-section-title">
                            <MudIcon Icon="@Icons.Material.Outlined.PendingActions" Size="Size.Small" />
                            <span>Planning hold</span>
                        </div>
                        <dl class="production-slot-facts">
                            <div>
                                <dt>Queued work</dt>
                                <dd>@FirstNonEmpty(selectedSlot.FileName, "Project part pending")</dd>
                            </div>
                            <div>
                                <dt>Project</dt>
                                <dd>@FormatShortId(selectedSlot.ProjectId)</dd>
                            </div>
                            <div>
                                <dt>Part</dt>
                                <dd>@FormatShortId(selectedSlot.ProjectPartId)</dd>
                            </div>
                            <div>
                                <dt>Expires</dt>
                                <dd>@FormatOptionalDateTime(selectedSlot.ExpiresAt)</dd>
                            </div>
                        </dl>
                    </div>
                }
                else if (!_loadingSlotDetails && selectedSlot.IsMaintenance)
                {
                    <div class="production-slot-section">
                        <div class="production-slot-section-title">
                            <MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" />
                            <span>Maintenance block</span>
                        </div>
                        <dl class="production-slot-facts">
                            <div>
                                <dt>Asset</dt>
                                <dd>@FirstNonEmpty(selectedSlot.MachineName, selectedSlot.MachineId)</dd>
                            </div>
                            <div>
                                <dt>Status</dt>
                                <dd>@FirstNonEmpty(selectedSlot.Status, "Maintenance")</dd>
                            </div>
                            <div>
                                <dt>Window</dt>
                                <dd>@FormatScheduleWindow(selectedSlot)</dd>
                            </div>
                            <div>
                                <dt>Work type</dt>
                                <dd>Planned equipment maintenance</dd>
                            </div>
                        </dl>
                    </div>
                }

                <dl class="production-slot-facts production-slot-capacity">
                    <div>
                        <dt>Setup</dt>
                        <dd>@FormatMinutes(selectedSlot.SetupMinutes)</dd>
                    </div>
                    <div>
                        <dt>Production</dt>
                        <dd>@FormatMinutes(selectedSlot.ProductionMinutes)</dd>
                    </div>
                    <div>
                        <dt>Total</dt>
                        <dd>@FormatMinutes(selectedSlot.SetupMinutes + selectedSlot.ProductionMinutes)</dd>
                    </div>
                    <div>
                        <dt>Expected finish</dt>
                        <dd>@FormatExpectedFinish(selectedSlot, _selectedJobDetail)</dd>
                    </div>
                    <div>
                        <dt>File</dt>
                        <dd>@FirstNonEmpty(selectedSlot.FileName, "Not attached")</dd>
                    </div>
                </dl>

                <footer>
                    @if (selectedSlot.ProjectId.HasValue)
                    {
                        <SecondaryButton Icon="@Icons.Material.Outlined.OpenInNew" Href="@ProjectHref(selectedSlot.ProjectId.Value)">View project</SecondaryButton>
                    }
                    @if (CanMove(selectedSlot))
                    {
                        <PrimaryButton Icon="@Icons.Material.Outlined.EditCalendar" OnClick="@((MouseEventArgs _) => OpenMovePanelAsync(selectedSlot))">Move slot</PrimaryButton>
                    }
                </footer>
            </section>
        }
    </PageBody>
</div>

@code {
    private ProductionScheduleBoardDto? _board;
    private ProductionScheduleSlotDto? _moveSlot;
    private ProductionScheduleSlotDto? _selectedSlot;
    private JobDetailDto? _selectedJobDetail;
    private JobDetailEditModel? _jobEditModel;
    private CustomerSummaryDto? _jobCustomer;
    private List<MaterialSummaryDto> _materialOptions = [];
    private List<EmployeeSummaryDto> _employeeOptions = [];
    private List<InventoryItemDto> _jobInventoryItems = [];
    private MaterialInventoryStatusDto? _jobInventoryStatus;
    private InventoryItemDto? _selectedInventoryItem;
    private string _moveMachineId = string.Empty;
    private string _jobTicketScanCode = string.Empty;
    private string _materialScanCode = string.Empty;
    private DateTime _moveStartLocal;
    private DateTime _moveEndLocal;
    private int? _moveQueuePosition;
    private decimal? _materialConsumeQuantity;
    private bool _moveCascade = true;
    private bool _loading = true;
    private bool _loadingSlotDetails;
    private bool _loadingJobReferences;
    private bool _savingMove;
    private bool _savingJobDetails;
    private bool _savingJobStage;
    private bool _releasingOrderForShipping;
    private bool _scanningJobTicket;
    private bool _scanningMaterialItem;
    private bool _recordingMaterialUse;
    private string? _error;
    private string? _jobTicketScanError;
    private string? _slotDetailsError;
    private string? _jobDetailsEditError;
    private string? _materialTraceError;
    private string? _moveError;
    private DateTime _rangeStartUtc = DateTime.UtcNow.Date;

    private IEnumerable<ProductionScheduleMachineDto> MoveMachines => (_board?.Machines ?? Enumerable.Empty<ProductionScheduleMachineDto>())
        .OrderBy(machine => machine.MachineName, StringComparer.OrdinalIgnoreCase);

    private string? MoveValidationMessage
    {
        get
        {
            if (_moveSlot is null)
                return null;

            var startUtc = LocalToUtc(_moveStartLocal);
            var endUtc = LocalToUtc(_moveEndLocal);
            if (endUtc <= startUtc)
                return "Schedule end must be after start.";

            if (startUtc <= DateTime.UtcNow)
                return "Choose a future start time before saving this schedule.";

            if (IsMoveUnchanged(startUtc, endUtc))
                return "Adjust the start, end, or queue position to save changes.";

            return null;
        }
    }

    private string? CurrentMoveMessage => _moveError ?? MoveValidationMessage;

    private bool CanSaveMove => _moveSlot is not null
        && !_savingMove
        && string.IsNullOrWhiteSpace(MoveValidationMessage);

    private bool CanSaveJobDetails => _selectedJobDetail is not null
        && _jobEditModel is not null
        && !_savingJobDetails
        && !_loadingJobReferences;

    private bool CanRecordMaterialUse => _selectedJobDetail is not null
        && _selectedInventoryItem is not null
        && !_recordingMaterialUse
        && _materialConsumeQuantity is > 0
        && _materialConsumeQuantity <= _selectedInventoryItem.RemainingQuantity;

    private string SelectedInventoryItemValue => _selectedInventoryItem?.TrackingCode ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
    }

    private async Task LoadBoardAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var rangeEndUtc = _rangeStartUtc.AddDays(7);
            var url = $"api/v1/jobs/schedule?from={Uri.EscapeDataString(_rangeStartUtc.ToString("O", CultureInfo.InvariantCulture))}&to={Uri.EscapeDataString(rangeEndUtc.ToString("O", CultureInfo.InvariantCulture))}";
            _board = await Http.GetFromJsonAsync<ProductionScheduleBoardDto>(url);
        }
        catch (Exception ex)
        {
            _board = null;
            _error = $"Production schedule could not be loaded: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadClickedAsync(MouseEventArgs _)
    {
        await LoadBoardAsync();
    }

    private async Task OnRangeStartChangedAsync(DateTime rangeStart)
    {
        _rangeStartUtc = NormalizeUtc(rangeStart).Date;
        await LoadBoardAsync();
    }

    private async Task SelectSlotAsync(ProductionScheduleSlotDto slot)
    {
        CloseMovePanel();
        _selectedSlot = slot;
        _selectedJobDetail = null;
        _jobEditModel = null;
        _jobCustomer = null;
        _jobInventoryStatus = null;
        _jobInventoryItems = [];
        _selectedInventoryItem = null;
        _materialScanCode = string.Empty;
        _materialConsumeQuantity = null;
        _slotDetailsError = null;
        _jobDetailsEditError = null;
        _materialTraceError = null;

        if (slot.JobId is not Guid jobId)
            return;

        _loadingSlotDetails = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var job = await Http.GetFromJsonAsync<JobDetailDto>($"api/v1/jobs/{jobId}");
            if (_selectedSlot?.SlotId == slot.SlotId)
            {
                _selectedJobDetail = job;
                InitializeJobEditor(job);
                await LoadJobReferenceDataAsync(job);
            }
        }
        catch (Exception ex)
        {
            if (_selectedSlot?.SlotId == slot.SlotId)
                _slotDetailsError = $"Job details could not be loaded: {ex.Message}";
        }
        finally
        {
            if (_selectedSlot?.SlotId == slot.SlotId)
                _loadingSlotDetails = false;
        }
    }

    private Task OpenMovePanelAsync(ProductionScheduleSlotDto slot)
    {
        CloseSlotDetails();
        _moveSlot = slot;
        _moveMachineId = slot.MachineId;
        _moveStartLocal = NormalizeUtc(slot.ScheduledStart).ToLocalTime();
        _moveEndLocal = NormalizeUtc(slot.ScheduledEnd).ToLocalTime();
        _moveQueuePosition = slot.QueuePosition > 0 ? slot.QueuePosition : null;
        _moveCascade = true;
        _moveError = null;
        return Task.CompletedTask;
    }

    private void CloseMovePanel()
    {
        _moveSlot = null;
        _savingMove = false;
        _moveError = null;
    }

    private void CloseSlotDetails()
    {
        _selectedSlot = null;
        _selectedJobDetail = null;
        _jobEditModel = null;
        _jobCustomer = null;
        _jobInventoryStatus = null;
        _jobInventoryItems = [];
        _selectedInventoryItem = null;
        _jobTicketScanError = null;
        _materialScanCode = string.Empty;
        _materialConsumeQuantity = null;
        _jobDetailsEditError = null;
        _materialTraceError = null;
        _slotDetailsError = null;
        _loadingSlotDetails = false;
        _loadingJobReferences = false;
        _scanningJobTicket = false;
        _scanningMaterialItem = false;
        _recordingMaterialUse = false;
    }

    private async Task CancelMoveClickedAsync(MouseEventArgs _)
    {
        CloseMovePanel();
        await Task.CompletedTask;
    }

    private async Task SaveMoveClickedAsync(MouseEventArgs _)
    {
        await SaveMoveAsync();
    }

    private async Task SaveMoveAsync()
    {
        if (_moveSlot is null)
            return;

        var startUtc = LocalToUtc(_moveStartLocal);
        var endUtc = LocalToUtc(_moveEndLocal);
        _moveError = null;

        if (IsMoveUnchanged(startUtc, endUtc))
        {
            CloseMovePanel();
            return;
        }

        if (endUtc <= startUtc)
        {
            _moveError = "Schedule end must be after start.";
            return;
        }

        if (startUtc <= DateTime.UtcNow)
        {
            _moveError = "Choose a future start time before saving this schedule.";
            return;
        }

        _savingMove = true;
        try
        {
            var machineName = MoveMachines.FirstOrDefault(machine =>
                string.Equals(machine.MachineId, _moveMachineId, StringComparison.OrdinalIgnoreCase))?.MachineName;

            HttpResponseMessage response;
            if (_moveSlot.JobId is Guid jobId)
            {
                response = await Http.PatchAsJsonAsync(
                    $"api/v1/jobs/{jobId}/schedule",
                    new RescheduleJobRequest
                    {
                        MachineId = _moveMachineId,
                        ScheduledStartTime = startUtc,
                        ScheduledEndTime = endUtc,
                        QueuePosition = _moveQueuePosition,
                        CascadeFollowingJobs = _moveCascade
                    });
            }
            else if (_moveSlot.HoldId is Guid holdId)
            {
                response = await Http.PatchAsJsonAsync(
                    $"api/v1/jobs/planning-holds/{holdId}",
                    new UpdateProductionPlanningHoldRequest
                    {
                        MachineId = _moveMachineId,
                        MachineName = machineName,
                        QueuePosition = _moveQueuePosition ?? _moveSlot.QueuePosition,
                        ScheduledStartTime = startUtc,
                        ScheduledEndTime = endUtc,
                        SetupTimeMinutes = _moveSlot.SetupMinutes,
                        ProductionTimeMinutes = _moveSlot.ProductionMinutes,
                        Notes = "Rescheduled from production schedule.",
                        ExpiresAt = _moveSlot.ExpiresAt ?? DateTime.UtcNow.AddHours(72)
                    });
            }
            else
            {
                Snackbar.Add("Only queued jobs and active planning holds can be moved.", Severity.Info);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _moveError = await ReadScheduleErrorAsync(response);
                return;
            }

            Snackbar.Add("Schedule updated.", Severity.Success);
            CloseMovePanel();
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _moveError = $"Schedule update error: {ex.Message}";
        }
        finally
        {
            _savingMove = false;
        }
    }

    private void InitializeJobEditor(JobDetailDto? job)
    {
        if (job is null)
        {
            _jobEditModel = null;
            _jobCustomer = null;
            _jobInventoryStatus = null;
            _jobInventoryItems = [];
            _selectedInventoryItem = null;
            _materialScanCode = string.Empty;
            _materialConsumeQuantity = null;
            _materialTraceError = null;
            return;
        }

        var materialId = job.MaterialId;
        if (!materialId.HasValue && Guid.TryParse(job.Material, out var parsedMaterialId))
        {
            materialId = parsedMaterialId;
        }

        _jobEditModel = new JobDetailEditModel
        {
            CustomerId = string.IsNullOrWhiteSpace(job.CustomerId) ? null : job.CustomerId,
            CustomerName = string.IsNullOrWhiteSpace(job.CustomerName) ? null : job.CustomerName,
            MaterialId = materialId,
            Operator = string.IsNullOrWhiteSpace(job.AssignedTo) ? null : job.AssignedTo,
            PriorityValue = PriorityToValue(job.Priority),
            Status = FirstNonEmpty(job.Status, "Queued")
        };

        _jobCustomer = string.IsNullOrWhiteSpace(job.CustomerName)
            ? null
            : new CustomerSummaryDto
            {
                Id = Guid.TryParse(job.CustomerId, out var customerId) ? customerId : Guid.Empty,
                Name = job.CustomerName,
                Email = string.Empty,
                ProfileImageUrl = job.CustomerProfileImageUrl
            };
    }

    private async Task LoadJobReferenceDataAsync(JobDetailDto? job)
    {
        _loadingJobReferences = true;
        try
        {
            var materialTask = Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>("api/v1/materials?page=1&pageSize=100");
            var employeeTask = Http.GetFromJsonAsync<PagedResponse<EmployeeSummaryDto>>("api/v1/employees?page=1&pageSize=100");

            await Task.WhenAll(materialTask, employeeTask);

            _materialOptions = (materialTask.Result?.Data ?? Enumerable.Empty<MaterialSummaryDto>())
                .OrderBy(material => material.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _employeeOptions = (employeeTask.Result?.Data ?? Enumerable.Empty<EmployeeSummaryDto>())
                .OrderBy(employee => employee.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            await LoadJobMaterialInventoryAsync(_jobEditModel?.MaterialId ?? job?.MaterialId);
        }
        catch (Exception ex)
        {
            _jobDetailsEditError = $"Job reference data could not be loaded: {ex.Message}";
        }
        finally
        {
            _loadingJobReferences = false;
        }
    }

    private async Task LoadJobMaterialInventoryAsync(Guid? materialId)
    {
        _jobInventoryStatus = null;
        _jobInventoryItems = [];
        if (materialId is not { } value)
        {
            _selectedInventoryItem = null;
            return;
        }

        try
        {
            var encodedMaterialId = Uri.EscapeDataString(value.ToString());
            var statusTask = Http.GetFromJsonAsync<List<MaterialInventoryStatusDto>>(
                $"api/v1/inventory/batches/status?materialId={encodedMaterialId}&status=Active");
            var itemsTask = Http.GetFromJsonAsync<List<InventoryItemDto>>(
                $"api/v1/inventory/items?materialId={encodedMaterialId}&status=Active");

            await Task.WhenAll(statusTask, itemsTask);

            _jobInventoryStatus = statusTask.Result?.FirstOrDefault(status => status.MaterialId == value);
            _jobInventoryItems = (itemsTask.Result ?? [])
                .OrderBy(item => item.Location, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => item.TrackingCode, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (_selectedInventoryItem is { } selected)
            {
                _selectedInventoryItem = _jobInventoryItems.FirstOrDefault(item =>
                    string.Equals(item.TrackingCode, selected.TrackingCode, StringComparison.OrdinalIgnoreCase));
                if (_selectedInventoryItem is null)
                {
                    _materialScanCode = string.Empty;
                    _materialConsumeQuantity = null;
                }
            }
        }
        catch
        {
            _jobInventoryStatus = null;
            _jobInventoryItems = [];
        }
    }

