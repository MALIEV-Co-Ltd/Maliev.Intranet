    private static IReadOnlyList<string> JobStatusOptions(string? currentStatus)
    {
        var current = NormalizeStatus(currentStatus);
        var options = new List<string> { current };

        switch (current)
        {
            case "Pending":
                options.AddRange(["Queued", "Cancelled"]);
                break;
            case "Queued":
                options.AddRange(["InProgress", "Cancelled"]);
                break;
            case "InProgress":
            case "InProduction":
                options.AddRange(["Finishing", "Cancelled"]);
                break;
            case "Finishing":
            case "QualityCheck":
            case "Packaging":
                options.AddRange(["Completed", "Cancelled"]);
                break;
        }

        return options
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string NormalizeStatus(string? status) =>
        status?.Trim() switch
        {
            null or "" => "Pending",
            "In Production" => "InProduction",
            "In progress" => "InProgress",
            "Complete" => "Completed",
            "Canceled" => "Cancelled",
            var value => value
        };

    private static string FormatStatus(string status) => status switch
    {
        "InProgress" or "InProduction" => "In progress",
        "QualityCheck" => "Quality check",
        _ => string.Join(" ", status.Split(['-', '_', ' '], StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..].ToLowerInvariant()))
    };

    private static int PriorityToValue(string? priority)
    {
        return priority?.Trim().ToLowerInvariant() switch
        {
            "urgent" => 1,
            "high" => 2,
            "low" => 4,
            _ => 3
        };
    }

    private static string FormatTechnology(string? technology)
    {
        if (string.IsNullOrWhiteSpace(technology))
            return "Unmapped";

        return technology.Trim().ToUpperInvariant() switch
        {
            "FDM" => "3D Printing (FDM)",
            "SLA" or "SLA_DLP" => "SLA printing",
            "CNC_MILL" => "CNC milling",
            "CNC_TURN" => "CNC turning",
            _ => technology.Replace('_', ' ').Trim()
        };
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string FormatShortId(Guid? id) =>
        id is { } value ? value.ToString("N")[..8].ToUpperInvariant() : "Not linked";

    private static bool TryGetNextStageAction(string? currentStatus, out string nextStatus, out string actionLabel)
    {
        nextStatus = string.Empty;
        actionLabel = string.Empty;

        switch (NormalizeStatus(currentStatus))
        {
            case "Queued":
                nextStatus = "InProgress";
                actionLabel = "Start job";
                return true;
            case "InProgress":
            case "InProduction":
                nextStatus = "Finishing";
                actionLabel = "Finish job";
                return true;
            case "Finishing":
            case "QualityCheck":
            case "Packaging":
                nextStatus = "Completed";
                actionLabel = "Complete job";
                return true;
            default:
                return false;
        }
    }

    private static bool CanReleaseOrderForShipping(JobDetailDto job) =>
        string.Equals(NormalizeStatus(job.Status), "Completed", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(job.OrderNumber);

    private bool IsMoveUnchanged(DateTime startUtc, DateTime endUtc)
    {
        if (_moveSlot is null)
            return true;

        var originalQueuePosition = _moveSlot.QueuePosition > 0 ? _moveSlot.QueuePosition : (int?)null;
        return string.Equals(_moveMachineId, _moveSlot.MachineId, StringComparison.OrdinalIgnoreCase)
            && SameScheduleInstant(startUtc, _moveSlot.ScheduledStart)
            && SameScheduleInstant(endUtc, _moveSlot.ScheduledEnd)
            && _moveQueuePosition == originalQueuePosition;
    }

    private static bool SameScheduleInstant(DateTime left, DateTime right) =>
        Math.Abs((NormalizeUtc(left) - NormalizeUtc(right)).TotalSeconds) < 60;

    private ProductionScheduleSlotDto? FindScheduleSlotForJob(Guid jobId) =>
        _board?.Machines
            .SelectMany(machine => machine.Slots)
            .FirstOrDefault(slot => slot.JobId == jobId);

    private static ProductionScheduleSlotDto BuildScannedJobSlot(JobDetailDto job)
    {
        var start = job.ScheduledStartTime ?? job.CreatedAt;
        var end = job.ScheduledEndTime ?? job.EstimatedCompletionAt ?? start;
        return new ProductionScheduleSlotDto
        {
            SlotId = job.Id,
            JobId = job.Id,
            MachineId = FirstNonEmpty(job.MachineName, "Unassigned"),
            MachineName = FirstNonEmpty(job.MachineName, "Unassigned"),
            Technology = job.ProcessType,
            ScheduledStart = NormalizeUtc(start),
            ScheduledEnd = NormalizeUtc(end),
            QueuePosition = job.QueuePosition,
            Status = job.Status,
            Label = FirstNonEmpty(job.JobNumber, job.Id.ToString("N")[..8].ToUpperInvariant()),
            CanMove = false
        };
    }

    private static async Task<string> ReadScheduleErrorAsync(HttpResponseMessage response)
    {
        var content = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(content))
            return "Schedule could not be updated.";

        try
        {
            using var json = JsonDocument.Parse(content);
            var root = json.RootElement;
            if (root.TryGetProperty("error", out var error) && error.ValueKind == JsonValueKind.String)
                return error.GetString() ?? "Schedule could not be updated.";
            if (root.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String)
                return detail.GetString() ?? "Schedule could not be updated.";
            if (root.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
                return title.GetString() ?? "Schedule could not be updated.";
        }
        catch (JsonException)
        {
            // Fall through to a bounded plain-text response.
        }

        return content.Length <= 240
            ? content
            : string.Concat(content.AsSpan(0, 237), "...");
    }

    private static string FormatDateTimeLocal(DateTime value) =>
        value.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

    private static bool TryParseLocalDateTime(string? value, out DateTime result)
    {
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed))
        {
            result = parsed.Kind == DateTimeKind.Unspecified
                ? DateTime.SpecifyKind(parsed, DateTimeKind.Local)
                : parsed;
            return true;
        }

        result = default;
        return false;
    }

    private static DateTime LocalToUtc(DateTime value)
    {
        if (value.Kind == DateTimeKind.Utc)
            return value;

        if (value.Kind == DateTimeKind.Unspecified)
            value = DateTime.SpecifyKind(value, DateTimeKind.Local);

        return value.ToUniversalTime();
    }

    private static DateTime NormalizeUtc(DateTime value)
    {
        if (value.Kind == DateTimeKind.Utc)
            return value;

        if (value.Kind == DateTimeKind.Local)
            return value.ToUniversalTime();

        return DateTime.SpecifyKind(value, DateTimeKind.Utc);
    }

