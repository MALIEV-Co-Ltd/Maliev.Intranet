        $"{quantity.ToString("N2", CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.')} {FirstNonEmpty(unit, "unit")}";

    private static string FormatInventoryDimensions(InventoryItemDto item)
    {
        var dimensions = new List<string>();
        if (item.LengthMm is { } length) dimensions.Add($"{FormatDimension(length)} L");
        if (item.WidthMm is { } width) dimensions.Add($"{FormatDimension(width)} W");
        if (item.HeightMm is { } height) dimensions.Add($"{FormatDimension(height)} H");
        if (item.DiameterMm is { } diameter) dimensions.Add($"Dia {FormatDimension(diameter)}");
        if (item.ThicknessMm is { } thickness) dimensions.Add($"{FormatDimension(thickness)} thick");

        return dimensions.Count == 0 ? "Not specified" : string.Join(" x ", dimensions);
    }

