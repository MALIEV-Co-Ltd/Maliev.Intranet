    private async Task AcceptInventoryItemAsync(InventoryItemDto item, bool loadMaterialInventory)
    {
        if (_jobEditModel is not null)
        {
            if (_jobEditModel.MaterialId is { } selectedMaterialId && selectedMaterialId != item.MaterialId)
            {
                _materialTraceError = "The scanned item belongs to a different material. Change the job material before recording usage.";
                return;
            }

            if (_jobEditModel.MaterialId is null)
            {
                _jobEditModel.MaterialId = item.MaterialId;
                loadMaterialInventory = true;
            }
        }

        if (loadMaterialInventory)
        {
            await LoadJobMaterialInventoryAsync(item.MaterialId);
        }

        _selectedInventoryItem = _jobInventoryItems.FirstOrDefault(candidate =>
                string.Equals(candidate.TrackingCode, item.TrackingCode, StringComparison.OrdinalIgnoreCase))
            ?? item;
        _materialScanCode = item.TrackingCode;
        _materialConsumeQuantity = null;
        _materialTraceError = null;
    }

    private async Task RecordMaterialUseAsync(MouseEventArgs _)
    {
        if (_selectedJobDetail is null || _selectedInventoryItem is null || _materialConsumeQuantity is not > 0)
        {
            _materialTraceError = "Select a material item and enter the quantity used.";
            return;
        }

        if (_materialConsumeQuantity > _selectedInventoryItem.RemainingQuantity)
        {
            _materialTraceError = "Quantity used cannot exceed the selected item's remaining stock.";
            return;
        }

        _recordingMaterialUse = true;
        _materialTraceError = null;
        try
        {
            var trackingCode = Uri.EscapeDataString(_selectedInventoryItem.TrackingCode);
            var response = await Http.PostAsJsonAsync(
                $"api/v1/inventory/items/{trackingCode}/consume",
                new ConsumeInventoryItemRequest
                {
                    JobId = _selectedJobDetail.Id,
                    OperatorId = _jobEditModel?.Operator,
                    MachineId = _selectedSlot?.MachineId,
                    QuantityConsumed = _materialConsumeQuantity.Value,
                    Notes = $"Consumed for job {FirstNonEmpty(_selectedJobDetail.JobNumber, _selectedJobDetail.Id.ToString("N")[..8].ToUpperInvariant())}."
                });

            if (!response.IsSuccessStatusCode)
            {
                _materialTraceError = await ReadScheduleErrorAsync(response);
                return;
            }

            var updatedItem = await response.Content.ReadFromJsonAsync<InventoryItemDto>();
            if (updatedItem is not null)
            {
                _selectedInventoryItem = updatedItem;
                _materialScanCode = updatedItem.TrackingCode;
                await LoadJobMaterialInventoryAsync(updatedItem.MaterialId);
                _selectedInventoryItem = _jobInventoryItems.FirstOrDefault(item =>
                        string.Equals(item.TrackingCode, updatedItem.TrackingCode, StringComparison.OrdinalIgnoreCase))
                    ?? updatedItem;
            }

            _materialConsumeQuantity = null;
            Snackbar.Add("Material use recorded for this job.", Severity.Success);
        }
        catch (Exception ex)
        {
            _materialTraceError = $"Material use could not be recorded: {ex.Message}";
        }
        finally
        {
            _recordingMaterialUse = false;
        }
    }

    private async Task SaveJobDetailsAsync(MouseEventArgs _)
    {
        if (_selectedJobDetail is null || _jobEditModel is null || _selectedSlot is null)
        {
            return;
        }

        _savingJobDetails = true;
        _jobDetailsEditError = null;
        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/v1/jobs/{_selectedJobDetail.Id}/details",
                new UpdateJobDetailsRequest
                {
                    CustomerId = _jobEditModel.CustomerId,
                    CustomerName = _jobEditModel.CustomerName,
                    MaterialId = _jobEditModel.MaterialId,
                    AssignedOperator = _jobEditModel.Operator,
                    Priority = _jobEditModel.PriorityValue
                });

            if (!response.IsSuccessStatusCode)
            {
                _jobDetailsEditError = await ReadScheduleErrorAsync(response);
                return;
            }

            if (!string.Equals(_jobEditModel.Status, _selectedJobDetail.Status, StringComparison.OrdinalIgnoreCase))
            {
                var statusResponse = await Http.PatchAsJsonAsync(
                    $"api/v1/jobs/{_selectedJobDetail.Id}/status",
                    new UpdateJobStatusRequest
                    {
                        Status = _jobEditModel.Status,
                        MachineId = _selectedSlot.MachineId
                    });

                if (!statusResponse.IsSuccessStatusCode)
                {
                    _jobDetailsEditError = await ReadScheduleErrorAsync(statusResponse);
                    return;
                }
            }

            Snackbar.Add("Job details updated.", Severity.Success);
            await ReloadSelectedJobAsync(_selectedJobDetail.Id, _selectedSlot);
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _jobDetailsEditError = $"Job details could not be updated: {ex.Message}";
        }
        finally
        {
            _savingJobDetails = false;
        }
    }

