@page "/mfg/materials/{Id:guid}"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Material Details - Maliev Intranet</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_material == null)
{
    <MudAlert Severity="Severity.Error">Material not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/mfg/materials"))">
        Back to List
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.h5">@_material.Name</MudText>
                <MudChip T="string" Size="Size.Medium" Color="@GetStatusColor(_material.Status)">
                    @_material.Status
                </MudChip>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">@_material.SKU</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Outlined.Edit"
                           OnClick="@OpenEditDialog">
                    Edit Material
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Default" 
                           StartIcon="@Icons.Material.Outlined.History"
                           OnClick="@(() => Snackbar.Add("Full history coming soon", Severity.Info))">
                    View History
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Properties" Icon="@Icons.Material.Outlined.Settings">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Material Specifications</MudText>
                        
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudList T="string">
                                    <MudListItem Text="Category" SecondaryText="@_material.Category" Icon="@Icons.Material.Outlined.Category" />
                                    <MudListItem Text="Material Type" SecondaryText="@(_material.MaterialType ?? "N/A")" Icon="@Icons.Material.Outlined.Architecture" />
                                    <MudListItem Text="Brand" SecondaryText="@(_material.Brand ?? "N/A")" Icon="@Icons.Material.Outlined.Business" />
                                    <MudListItem Text="Color" SecondaryText="@(_material.Color ?? "N/A")" Icon="@Icons.Material.Outlined.Palette" />
                                </MudList>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudList T="string">
                                    <MudListItem Text="Unit Price" SecondaryText="@_material.UnitPrice.ToString("C2")" Icon="@Icons.Material.Outlined.AttachMoney" />
                                    <MudListItem Text="Base Unit" SecondaryText="@_material.Unit" Icon="@Icons.Material.Outlined.Scale" />
                                    <MudListItem Text="Weight" SecondaryText="@(_material.Weight?.ToString("N2") ?? "N/A")" Icon="@Icons.Material.Outlined.FitnessCenter" />
                                </MudList>
                            </MudItem>
                        </MudGrid>

                        @if (_material.Properties.Any())
                        {
                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Additional Properties</MudText>
                            <MudTable Items="@_material.Properties" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Property</MudTh>
                                    <MudTh>Value</MudTh>
                                    <MudTh>Unit</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Property">@context.Key</MudTd>
                                    <MudTd DataLabel="Value">@context.Value</MudTd>
                                    <MudTd DataLabel="Unit">@context.Unit</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }

                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Description</MudText>
                        <MudText Typo="Typo.body2">@(_material.Description ?? "No description provided.")</MudText>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Stock Level" Icon="@Icons.Material.Outlined.Inventory2">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.h6">Inventory Tracking</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Current availability in warehouse</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Outlined.SwapVert" Size="Size.Small">Adjust Stock</MudButton>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default text-center">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Quantity on Hand</MudText>
                                    <MudText Typo="Typo.h4" Color="@(GetStockColor())">@_material.QuantityOnHand @_material.Unit</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default text-center">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Reorder Level</MudText>
                                    <MudText Typo="Typo.h4">@_material.ReorderLevel @_material.Unit</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default text-center">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Status</MudText>
                                    <MudText Typo="Typo.h4" Color="@GetStatusColor(_material.Status)">@_material.Status</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.h6" Class="mt-6 mb-3">Recent Transactions</MudText>
                        @if (_material.RecentTransactions.Any())
                        {
                            <MudTable Items="@_material.RecentTransactions" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh Style="text-align: right;">Quantity</MudTh>
                                    <MudTh>Reference</MudTh>
                                    <MudTh>By</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">@context.Timestamp.ToString("dd MMM yyyy HH:mm")</MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudChip T="string" Size="Size.Small" Color="@GetTransactionTypeColor(context.Type)">@context.Type</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Quantity" Style="text-align: right;">
                                        <MudText Color="@(context.Quantity >= 0 ? Color.Success : Color.Error)">
                                            @(context.Quantity > 0 ? "+" : "")@context.Quantity
                                        </MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Reference">@context.Reference</MudTd>
                                    <MudTd DataLabel="By">@context.PerformedBy</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No recent transactions.</MudText>
                        }
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Suppliers" Icon="@Icons.Material.Outlined.Business">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.h6">Approved Suppliers</MudText>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">Link Supplier</MudButton>
                        </MudStack>

                        @if (_material.Suppliers.Any())
                        {
                            <MudTable Items="@_material.Suppliers" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Supplier Name</MudTh>
                                    <MudTh>Email</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Rating</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Name">@context.Name</MudTd>
                                    <MudTd DataLabel="Email">@context.Email</MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Size="Size.Small" Color="@(context.Status == "Active" ? Color.Success : Color.Default)">@context.Status</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Rating">
                                        <MudRating ReadOnly="true" SelectedValue="@((int)context.Rating)" Size="Size.Small" />
                                    </MudTd>
                                    <MudTd Style="text-align: right;">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Href="@($"/mfg/suppliers/{context.Id}")" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No suppliers linked to this material.</MudText>
                        }
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Usage History" Icon="@Icons.Material.Outlined.Timeline">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Production Usage History</MudText>
                        @if (_material.RecentTransactions.Any(t => t.Type == "Issue"))
                        {
                            <MudTable Items="@_material.RecentTransactions.Where(t => t.Type == "Issue").OrderByDescending(t => t.Timestamp)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Reference</MudTh>
                                    <MudTh Style="text-align: right;">Quantity Used</MudTh>
                                    <MudTh>Issued By</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Date">@context.Timestamp.ToString("dd MMM yyyy HH:mm")</MudTd>
                                    <MudTd DataLabel="Reference">@context.Reference</MudTd>
                                    <MudTd DataLabel="Quantity Used" Style="text-align: right;">@Math.Abs(context.Quantity) @_material.Unit</MudTd>
                                    <MudTd DataLabel="Issued By">@context.PerformedBy</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No usage history recorded.</MudText>
                        }
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Outlined.ShoppingCart">Create Purchase Order</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" StartIcon="@Icons.Material.Outlined.History">Stock Adjustment</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" StartIcon="@Icons.Material.Outlined.Print">Print Label</MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Metadata</MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Created:</MudText>
                            <MudText Typo="Typo.body2">@_material.CreatedAt.ToString("dd MMM yyyy")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Last Updated:</MudText>
                            <MudText Typo="Typo.body2">@_material.UpdatedAt.ToString("dd MMM yyyy HH:mm")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">ID:</MudText>
                            <MudText Typo="Typo.body2" Style="font-size: 0.7rem;">@_material.Id</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private MaterialDetailDto? _material;
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadMaterial();

        _breadcrumbs = 
        [
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Manufacturing", href: null, disabled: true),
            new BreadcrumbItem("Materials", href: "/mfg/materials"),
            new BreadcrumbItem(_material?.Name ?? "Detail", href: null, disabled: true)
        ];
    }

    private async Task LoadMaterial()
    {
        try
        {
            _isLoading = true;
            _material = await Http.GetFromJsonAsync<MaterialDetailDto>($"api/materials/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading material: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditDialog()
    {
        if (_material == null) return;

        var parameters = new DialogParameters<EditMaterialDialog>
        {
            { x => x.MaterialId, Id },
            { x => x.Material, _material }
        };
        var dialog = await DialogService.ShowAsync<EditMaterialDialog>("Edit Material", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadMaterial();
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Low Stock" => Color.Warning,
        "Out of Stock" => Color.Error,
        "Discontinued" => Color.Dark,
        _ => Color.Default
    };

    private Color GetStockColor()
    {
        if (_material == null) return Color.Default;
        if (_material.QuantityOnHand <= 0) return Color.Error;
        if (_material.QuantityOnHand <= _material.ReorderLevel) return Color.Warning;
        return Color.Success;
    }

    private Color GetTransactionTypeColor(string type) => type switch
    {
        "Receipt" => Color.Success,
        "Issue" => Color.Info,
        "Adjustment" => Color.Warning,
        "Transfer" => Color.Default,
        _ => Color.Default
    };
}
