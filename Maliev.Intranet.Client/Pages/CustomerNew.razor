@page "/sales/customers/new"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components

<PageTitle>Create New Customer | Intranet Gateway</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <!-- Header -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-8">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h3" Style="font-weight: 700;">Create New Customer</MudText>
            <MudText Typo="Typo.body1" Color="Color.Default">Add a new client profile to your database.</MudText>
        </MudStack>
        
        <MudStack Row="true" Spacing="2">
            <MudTooltip Text="AI Data Extraction">
                <MudIconButton Color="Color.Primary" 
                               Icon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="OpenExtractionDialog"
                               Disabled="@(!_chatbotServiceAvailable)" />
            </MudTooltip>
            <MudTooltip Text="Import from LINE chat (Coming soon)">
                <MudIconButton Color="Color.Success"
                               Icon="@Icons.Material.Filled.Chat"
                               Disabled="true" />
            </MudTooltip>
        </MudStack>
    </MudStack>

    <MudForm @ref="_form" ValidationDelay="0">
        <MudGrid Spacing="6">
            
            <!-- Left Column: Main Info -->
            <MudItem xs="12" lg="8">
                <MudStack Spacing="6">
                    
                    <!-- Personal Information Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">Personal Information</MudText>
                        </MudStack>
                        
                        <MudGrid Spacing="4">
                             <MudItem xs="12" sm="6">
                                 <MudTextField T="string" Label="First Name" @bind-Value="_customerData.Customer.FirstName" Variant="Variant.Outlined" Required="true" RequiredError="First name is required" Placeholder="e.g. Jane" />
                             </MudItem>
                             <MudItem xs="12" sm="6">
                                 <MudTextField T="string" Label="Last Name" @bind-Value="_customerData.Customer.LastName" Variant="Variant.Outlined" Required="true" RequiredError="Last name is required" Placeholder="e.g. Cooper" />
                             </MudItem>
                             <MudItem xs="12">
                                 <MudTextField T="string" Label="Email Address" @bind-Value="_customerData.Customer.Email" 
                                               Variant="Variant.Outlined" Required="true" RequiredError="Email is required" 
                                               Validation="@(new Func<string, Task<string?>>(ValidateEmailAsync))" 
                                               InputType="InputType.Email" DebounceInterval="500" 
                                               Placeholder="jane.cooper@company.com" Adornment="Adornment.Start" 
                                               AdornmentIcon="@Icons.Material.Filled.Email" Immediate="true" />
                             </MudItem>
                              <MudItem xs="12" sm="6">
                                  <MudTextField T="string" Label="Mobile Number" @bind-Value="_customerData.Customer.Mobile" Variant="Variant.Outlined" Placeholder="+66 81 234-5678" Immediate="true" />
                              </MudItem>
                              <MudItem xs="12" sm="6">
                                  <MudTextField T="string" Label="Landline" @bind-Value="_customerData.Customer.Landline" Variant="Variant.Outlined" Placeholder="+66 2 123-4567" Immediate="true" />
                              </MudItem>
                             <MudItem xs="12" sm="6">
                                 <MudSelect T="string" Label="Segment" @bind-Value="_customerData.Customer.Segment" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                     <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                     <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                     <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                     <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                 </MudSelect>
                             </MudItem>
                             <MudItem xs="12" sm="6">
                                  <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-1 d-block">Tier Level</MudText>
                                  <MudToggleGroup T="string" @bind-Value="_customerData.Customer.Tier" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" FixedContent="true" Class="w-100">
                                      <MudToggleItem Value="@("Bronze")" Text="Bronze" />
                                      <MudToggleItem Value="@("Silver")" Text="Silver" />
                                      <MudToggleItem Value="@("Gold")" Text="Gold" />
                                      <MudToggleItem Value="@("Platinum")" Text="Platinum" />
                                  </MudToggleGroup>
                             </MudItem>
                        </MudGrid>
                    </MudCard>

                    <!-- Company Details Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                         <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                             <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                 <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
                                 <MudText Typo="Typo.h6" Style="font-weight: 700;">Company Information</MudText>
                             </MudStack>
                             <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                  @if (_newCompany.IsVerifiedFromBdex)
                                  {
                                      <MudChip T="string" Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Small">Verified from Registry</MudChip>
                                  }
                                 else if (_companyIsManualEntry)
                                 {
                                     <MudChip T="string" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small">Manual Entry</MudChip>
                                 }
                                 <MudTooltip Text="Remove company">
                                     <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="RemoveCompany" Size="Size.Small" />
                                 </MudTooltip>
                             </MudStack>
                         </MudStack>

                        @if (!string.IsNullOrWhiteSpace(_newCompany.VatNumber) || _showCompanyFields)
                        {
                            <MudGrid Spacing="4">
                                <!-- Company Search (Tax ID or Name) -->
                                <MudItem xs="12">
                                    <MudAutocomplete T="RegistryCompanyProfile"
                                                    Value="_selectedCompany"
                                                    ValueChanged="OnCompanySelected"
                                                    Label="Search company by Tax ID or name"
                                                    Placeholder="Enter 13-digit Tax ID or company name (min 2 characters)"
                                                    SearchFunc="SearchCompaniesAsync"
                                                    Variant="Variant.Outlined"
                                                    Adornment="Adornment.Start"
                                                    AdornmentIcon="@Icons.Material.Filled.Search"
                                                    Clearable="true"
                                                    DebounceInterval="300"
                                                    MinCharacters="2"
                                                    MaxItems="10"
                                                    ToStringFunc="c => c?.CompanyNameTh ?? c?.TaxId ?? string.Empty"
                                                    Disabled="@_newCompany.IsVerifiedFromBdex"
                                                    HelperText="@(_newCompany.IsVerifiedFromBdex ? "" : "Enter 13-digit Tax ID or company name to search")">
                                        <NoItemsTemplate>
                                            <MudText>No companies found. You can enter details manually below.</MudText>
                                        </NoItemsTemplate>
                                    </MudAutocomplete>
                                    
                                    @if (_newCompany.IsVerifiedFromBdex)
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   OnClick="ResetCompanyVerification"
                                                   StartIcon="@Icons.Material.Filled.Refresh"
                                                   Class="mt-2">
                                            Search again
                                        </MudButton>
                                    }
                                </MudItem>

                                <!-- Warning for manual entry -->
                                @if (_companyIsManualEntry && !_newCompany.IsVerifiedFromBdex)
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-2">
                                            <MudText Typo="Typo.body2">
                                                <strong>Manual Entry Mode:</strong> We recommend using the search field above to automatically retrieve accurate company data from the registry.
                                            </MudText>
                                        </MudAlert>
                                    </MudItem>
                                }

                                <!-- Company Name (Thai) -->
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  Label="@(_newCompany.IsVerifiedFromBdex ? "Company Name (Thai) - Verified" : "Company Name *")"
                                                  @bind-Value="_newCompany.Name"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  RequiredError="Company name is required"
                                                  Placeholder="e.g. บริษัท มาลีฟ จำกัด"
                                                  ReadOnly="@_newCompany.IsVerifiedFromBdex"
                                                  Adornment="@(_newCompany.IsVerifiedFromBdex ? Adornment.End : Adornment.None)"
                                                  AdornmentIcon="@(_newCompany.IsVerifiedFromBdex ? Icons.Material.Filled.Lock : "")"
                                                  AdornmentColor="Color.Success" />
                                </MudItem>

                                <!-- Full Name (Thai) - Only show if verified -->
                                @if (_newCompany.IsVerifiedFromBdex && !string.IsNullOrWhiteSpace(_newCompany.FullNameTh))
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string"
                                                      Label="Full Legal Name (Thai)"
                                                      Value="@_newCompany.FullNameTh"
                                                      Variant="Variant.Outlined"
                                                      ReadOnly="true"
                                                      Adornment="Adornment.End"
                                                      AdornmentIcon="@Icons.Material.Filled.Lock"
                                                      AdornmentColor="Color.Success" />
                                    </MudItem>
                                }
                                else
                                {
                                    <!-- Company Phone when not verified, or next to Full Name when verified -->
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="Company Phone" @bind-Value="_newCompany.ContactPhone" Variant="Variant.Outlined" Placeholder="+66 2 123-4567" />
                                    </MudItem>
                                }

                                <!-- Verified Company Details -->
                                @if (_newCompany.IsVerifiedFromBdex)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string"
                                                      Label="Registration Date"
                                                      Value="@(_newCompany.RegistrationDate?.ToString("MMMM dd, yyyy"))"
                                                      Variant="Variant.Outlined"
                                                      ReadOnly="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string"
                                                      Label="Company Status"
                                                      Value="@_newCompany.CompanyStatusNameTh"
                                                      Variant="Variant.Outlined"
                                                      ReadOnly="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.CheckCircle"
                                                      AdornmentColor="@(_newCompany.CompanyStatus == "1" ? Color.Success : Color.Default)" />
                                    </MudItem>

                                    @if (!string.IsNullOrWhiteSpace(_newCompany.BusinessObjectives))
                                    {
                                        <MudItem xs="12">
                                            <MudTextField T="string"
                                                          Label="Business Objectives"
                                                          Value="@(TruncateText(_newCompany.BusinessObjectives, 200))"
                                                          Variant="Variant.Outlined"
                                                          ReadOnly="true"
                                                          Lines="3"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.BusinessCenter" />
                                        </MudItem>
                                    }

                                    <!-- Editable fields even when verified -->
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="Company Phone" @bind-Value="_newCompany.ContactPhone" Variant="Variant.Outlined" Placeholder="+66 2 123-4567" />
                                    </MudItem>
                                }

                                <!-- Office Type & Extension -->
                                <MudItem xs="12" sm="6">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                         <MudRadioGroup T="string" @bind-Value="_companyOfficeType" Class="d-flex">
                                             <MudRadio T="string" Value="@("head")" Color="Color.Primary" Dense="true">Head Office</MudRadio>
                                             <MudRadio T="string" Value="@("branch")" Color="Color.Primary" Dense="true">Branch</MudRadio>
                                         </MudRadioGroup>
                                         @if (_companyOfficeType == "branch")
                                         {
                                             <MudTextField T="string" Label="Branch #" @bind-Value="_branchNumber" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="00001" />
                                         }
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" Label="Extension" @bind-Value="_customerData.Customer.Extension" Variant="Variant.Outlined" Placeholder="101" />
                                </MudItem>

                                <!-- Segment & Tier (Always editable) -->
                                <MudItem xs="12" sm="6">
                                     <MudSelect T="string" Label="Industry Segment" @bind-Value="_newCompany.Segment" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                         <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                         <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                         <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                         <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                     </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                     <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-1 d-block">Company Tier</MudText>
                                      <MudToggleGroup T="string" @bind-Value="_newCompany.Tier" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" FixedContent="true" Class="w-100">
                                          <MudToggleItem Value="@("Bronze")" Text="Bronze" />
                                          <MudToggleItem Value="@("Silver")" Text="Silver" />
                                          <MudToggleItem Value="@("Gold")" Text="Gold" />
                                          <MudToggleItem Value="@("Platinum")" Text="Platinum" />
                                      </MudToggleGroup>
                                </MudItem>
                            </MudGrid>
                        }
                        else
                        {
                            <!-- Empty state -->
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-6">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                                <MudText Typo="Typo.body1" Color="Color.Default" Class="mb-3">No company information provided</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default" Align="Align.Center" Class="mb-4" Style="max-width: 400px;">
                                    To link this customer to a company, enter the company's 13-digit Thai Tax ID above. We'll help you verify the details from the DBD registry.
                                </MudText>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           OnClick="@(() => _showCompanyFields = true)"
                                           StartIcon="@Icons.Material.Filled.Add">
                                    Add Company Information
                                </MudButton>
                            </MudStack>
                        }
                    </MudCard>

                    <!-- Address Details Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">Address Details</MudText>
                            </MudStack>
                            <MudLink OnClick="AddAddress" Underline="Underline.None" Color="Color.Primary" Style="font-weight: 600; cursor: pointer;">
                                + Add Another
                            </MudLink>
                        </MudStack>
                        
                        <MudGrid Spacing="4">
                            @if (!_customerData.Addresses.Any())
                            {
                                <MudItem xs="12">
                                    <MudPaper Class="pa-8 d-flex flex-column align-center justify-center border-dashed border-2 mud-border-primary" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                                        <MudIcon Icon="@Icons.Material.Filled.AddLocationAlt" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                                        <MudText Typo="Typo.body1" Color="Color.Default">No addresses added yet.</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddAddress">Add Address</MudButton>
                                    </MudPaper>
                                </MudItem>
                            }
                            else
                            {
                                @foreach (var (address, index) in _customerData.Addresses.Select((a, i) => (a, i)))
                                {
                                    <MudItem xs="12" sm="6">
                                        <AddressCard Address="address"
                                                     Index="index"
                                                     HasCompany="@(!string.IsNullOrWhiteSpace(_newCompany.VatNumber))"
                                                     CompanyName="@_newCompany.Name"
                                                     CustomerName="@($"{_customerData.Customer.FirstName} {_customerData.Customer.LastName}")"
                                                     CustomerMobile="@_customerData.Customer.Mobile"
                                                     OnTypeChanged="OnAddressTypeChanged"
                                                     OnDefaultChanged="OnDefaultChanged"
                                                     OnLocationSelected="OnThaiLocationSelected"
                                                     OnCountrySelected="OnCountrySelected"
                                                     OnRemove="RemoveAddress"
                                                     SearchLocations="SearchThaiLocations"
                                                     SearchCountries="SearchCountries"
                                                     SelectedCountry="_selectedCountries.GetValueOrDefault(index)"
                                                     SelectedLocation="_selectedLocations.GetValueOrDefault(index)" />
                                    </MudItem>
                                }
                            }
                        </MudGrid>
                    </MudCard>
                    
                    <!-- Action Buttons (Bottom of Form Flow) -->
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" Size="Size.Large" OnClick="Cancel" Disabled="@_isSubmitting" Class="px-8 rounded-lg">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" OnClick="Submit" Disabled="@(_isSubmitting || !IsFormValid())" Class="px-8 rounded-lg">
                            @if (_isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Customer</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudItem>

            <!-- Right Column: Sidebar -->
            <MudItem xs="12" lg="4">
                <MudStack Spacing="6">
                    
                    <!-- Preferences Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                         <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Preferences</MudText>
                         
                         <MudStack Spacing="4">
                             <MudSelect T="string" Label="Language" @bind-Value="_customerData.Customer.PreferredLanguage" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                 <MudSelectItem Value="@("en")">English (US)</MudSelectItem>
                                 <MudSelectItem Value="@("th")">Thai (ไทย)</MudSelectItem>
                             </MudSelect>
                             
                             <MudSelect T="string" Label="Timezone" @bind-Value="_customerData.Customer.Timezone" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                 <MudSelectItem Value="@("Asia/Bangkok")">(GMT+07:00) Bangkok</MudSelectItem>
                                 <MudSelectItem Value="@("UTC")">(UTC) Coordinated Universal Time</MudSelectItem>
                                 <MudSelectItem Value="@("Asia/Singapore")">(GMT+08:00) Singapore</MudSelectItem>
                             </MudSelect>
                             
                             <div>
                                 <MudText Typo="Typo.body2" Style="font-weight: 600;" Class="mb-2">Communication</MudText>
                                 <MudStack Row="true" Spacing="4">
                                     <MudCheckBox T="bool" @bind-Value="_emailOptIn" Color="Color.Primary" Label="Email" Dense="true" Size="Size.Small" />
                                     <MudCheckBox T="bool" @bind-Value="_smsOptIn" Color="Color.Primary" Label="SMS" Dense="true" Size="Size.Small" />
                                     <MudCheckBox T="bool" @bind-Value="_marketingOptIn" Color="Color.Primary" Label="Phone" Dense="true" Size="Size.Small" />
                                 </MudStack>
                             </div>
                         </MudStack>
                    </MudCard>

                    <!-- Documents Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                         <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Documents</MudText>
                         
                         <MudStack Spacing="4">
                             <!-- NDA Toggle -->
                             <MudSwitch T="bool" @bind-Value="_includeNda" Color="Color.Primary" Label="Require NDA" />
                             
                              @if (_includeNda)
                              {
                                  <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnNdaFilesSelected" Accept=".pdf,.doc,.docx" MaximumFileCount="100">
                                      <CustomContent>
                                          <MudPaper Outlined="true" Class="pa-6 d-flex flex-column align-center justify-center cursor-pointer border-dashed border-2 mud-border-primary" Elevation="0" Style="background-color: var(--mud-palette-background-grey); min-height: 120px;"
                                                    @onclick="@context.OpenFilePickerAsync">
                                               <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Medium" Color="Color.Primary" Class="mb-2" />
                                               <MudText Typo="Typo.body2" Align="Align.Center" Style="font-weight: 600;">Click to upload NDA</MudText>
                                               <MudText Typo="Typo.caption" Color="Color.Default" Align="Align.Center">or drag and drop files here</MudText>
                                          </MudPaper>
                                      </CustomContent>
                                  </MudFileUpload>
                                  
                                  @if (_ndaFiles.Any())
                                  {
                                      <div class="mt-2">
                                          <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-bold">Files to Upload:</MudText>
                                          <MudList T="IBrowserFile" Dense="true">
                                              @foreach (var file in _ndaFiles.ToList())
                                              {
                                                  <MudListItem Icon="@Icons.Material.Filled.AttachFile" IconColor="Color.Info" Dense="true">
                                                      <div class="d-flex justify-space-between align-center w-100">
                                                          <MudText Typo="Typo.body2">@file.Name</MudText>
                                                          <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => _ndaFiles.Remove(file))" />
                                                      </div>
                                                  </MudListItem>
                                              }
                                          </MudList>
                                          <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="UploadNdaFiles" Disabled="@_isUploadingNda" StartIcon="@Icons.Material.Filled.FileUpload">
                                              @(_isUploadingNda ? "Uploading..." : "Upload NDA Files")
                                          </MudButton>
                                      </div>
                                  }

                                  @if (_uploadedNdaDocs.Any())
                                  {
                                      <div class="mt-4">
                                          <MudText Typo="Typo.caption" Color="Color.Success" Class="font-bold">Uploaded NDA Documents:</MudText>
                                          <MudList T="CreateDocumentRequest" Dense="true">
                                              @foreach (var doc in _uploadedNdaDocs.ToList())
                                              {
                                                  <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" Dense="true">
                                                      <div class="d-flex justify-space-between align-center w-100">
                                                          <MudText Typo="Typo.body2">@doc.FileName</MudText>
                                                          <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Warning" Size="Size.Small" OnClick="@(() => RemoveUploadedDoc(doc, true))" />
                                                      </div>
                                                  </MudListItem>
                                              }
                                          </MudList>
                                      </div>
                                  }
                              }
                              
                              <MudDivider Class="my-2" />
                              
                              <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-1">Other Documents</MudText>
                              <MudTextField T="string" Label="Category" @bind-Value="_customerDocCategory" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. Business Card" />
                              
                              <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnCustomerDocsSelected" Accept=".pdf,.jpg,.png,.doc" MaximumFileCount="100">
                                  <CustomContent>
                                      <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" OnClick="@context.OpenFilePickerAsync">Select Files</MudButton>
                                  </CustomContent>
                              </MudFileUpload>

                              @if (_customerDocFiles.Any())
                              {
                                  <div class="mt-2">
                                      <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-bold">Files to Upload:</MudText>
                                      <MudList T="IBrowserFile" Dense="true">
                                          @foreach (var file in _customerDocFiles.ToList())
                                          {
                                              <MudListItem Icon="@Icons.Material.Filled.AttachFile" IconColor="Color.Info" Dense="true">
                                                  <div class="d-flex justify-space-between align-center w-100">
                                                      <MudText Typo="Typo.body2">@file.Name</MudText>
                                                      <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => _customerDocFiles.Remove(file))" />
                                                  </div>
                                              </MudListItem>
                                          }
                                      </MudList>
                                      <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="UploadCustomerDocuments" Disabled="@_isUploadingCustomerDocs" StartIcon="@Icons.Material.Filled.FileUpload">
                                          @(_isUploadingCustomerDocs ? "Uploading..." : "Upload Selected Files")
                                      </MudButton>
                                  </div>
                              }

                              @if (_uploadedCustomerDocs.Any())
                              {
                                  <div class="mt-4">
                                      <MudText Typo="Typo.caption" Color="Color.Success" Class="font-bold">Uploaded Documents:</MudText>
                                      <MudList T="CreateDocumentRequest" Dense="true">
                                          @foreach (var doc in _uploadedCustomerDocs.ToList())
                                          {
                                              <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" Dense="true">
                                                  <div class="d-flex justify-space-between align-center w-100">
                                                      <MudText Typo="Typo.body2">@doc.FileName (@doc.DocumentCategory)</MudText>
                                                      <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Warning" Size="Size.Small" OnClick="@(() => RemoveUploadedDoc(doc, false))" />
                                                  </div>
                                              </MudListItem>
                                          }
                                      </MudList>
                                  </div>
                              }
                         </MudStack>
                    </MudCard>

                    <!-- Internal Notes Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-l border-solid border-x1 mud-border-lines-default">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">Internal Notes</MudText>
                        </MudStack>
                        <NoteEditor @bind-Value="_customerData.InternalNote"
                                    StartInEditMode="true"
                                    Compact="true"
                                    ShowActivityTab="false" />
                    </MudCard>
                    
                </MudStack>
            </MudItem>
            
        </MudGrid>
    </MudForm>
</MudContainer>



