@page "/hr/recruitment"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Recruitment - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Recruitment & Job Postings</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Job Postings</MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Small" 
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    New Job
                </MudButton>
            </MudStack>
            @if (!_isLoading)
            {
                <MudList T="JobPostingSummaryDto" Dense="true">
                    @if (_jobPostings.Any())
                    {
                        @foreach (var job in _jobPostings)
                        {
                            <MudListItem T="JobPostingSummaryDto" Text="@job.Title" SecondaryText="@($"{job.Department} • {job.ApplicantCount} applicants")" Icon="@GetJobIcon(job.Department ?? "")" />
                            <MudDivider />
                        }
                    }
                    else
                    {
                        <MudText Class="pa-4 text-center" Color="Color.Secondary">No active job postings</MudText>
                    }
                </MudList>
            }
            else
            {
                <div class="pa-2">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2 rounded" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2 rounded" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2 rounded" />
                </div>
            }
        </MudPaper>
    </MudItem>
    
    <MudItem xs="12" md="7">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-3">Application Pipeline</MudText>
            @if (_isLoading)
            {
                <MudGrid>
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="rounded" />
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Applied</MudText>
                            <MudText Typo="Typo.subtitle1">@_stats.Applied</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Screening</MudText>
                            <MudText Typo="Typo.subtitle1">@_stats.Screening</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Interview</MudText>
                            <MudText Typo="Typo.subtitle1">@_stats.Interview</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="0" Class="pa-3 border mud-border-lines-default rounded">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Offer</MudText>
                            <MudText Typo="Typo.subtitle1">@_stats.Offer</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _isLoading = true;
    private List<JobPostingSummaryDto> _jobPostings = new();
    private RecruitmentStatsDto _stats = new();

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var jobsTask = Http.GetFromJsonAsync<List<JobPostingSummaryDto>>("api/recruitment/jobs");
            var statsTask = Http.GetFromJsonAsync<RecruitmentStatsDto>("api/recruitment/stats");

            await Task.WhenAll(jobsTask, statsTask);

            _jobPostings = await jobsTask ?? new();
            _stats = await statsTask ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recruitment data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateJobPostingDialog>("New Job Posting", options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private string GetJobIcon(string department) => department switch
    {
        "Engineering" => Icons.Material.Outlined.Code,
        "Sales" => Icons.Material.Outlined.Handshake,
        "Operations" => Icons.Material.Outlined.Engineering,
        _ => Icons.Material.Outlined.WorkOutline
    };
}

