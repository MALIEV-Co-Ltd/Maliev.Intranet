@page "/sales/quotations/{Id:guid}"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Quotation Details - Maliev Intranet</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_quotation == null)
{
    <MudAlert Severity="Severity.Error">Quotation not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/sales/quotations"))">
        Back to List
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.h5">Quotation @_quotation.QuotationNumber</MudText>
                <MudChip T="string" Size="Size.Medium" Color="@GetStatusColor(_quotation.Status)">
                    @_quotation.Status
                </MudChip>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">v@_quotation.CurrentVersionNumber</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                @if (_quotation.Status == "Draft")
                {
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Outlined.Send"
                               OnClick="@SendQuotation">
                        Send to Customer
                    </MudButton>
                }
                <MudMenu Label="Actions" 
                         Variant="Variant.Outlined" 
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                         AnchorOrigin="Origin.BottomRight" 
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="@OpenEditDialog">Edit Details</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.ContentCopy" OnClick="@CreateNewVersion">Create New Version</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.PictureAsPdf" OnClick="@GeneratePdf">Download PDF</MudMenuItem>
                    @if (_quotation.Status == "Accepted")
                    {
                        <MudMenuItem Icon="@Icons.Material.Outlined.ShoppingCart" OnClick="@ConvertToOrder">Convert to Order</MudMenuItem>
                    }
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="@DeleteQuotation">Delete</MudMenuItem>
                </MudMenu>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Current Version" Icon="@Icons.Material.Outlined.ReceiptLong">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Line Items (v@_quotation.CurrentVersionNumber)</MudText>
                        
                        @{
                            var currentVersion = _quotation.Versions.FirstOrDefault(v => v.VersionNumber == _quotation.CurrentVersionNumber);
                        }

                        @if (currentVersion != null)
                        {
                            <MudTable Items="@currentVersion.LineItems" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Description</MudTh>
                                    <MudTh Style="text-align: right;">Quantity</MudTh>
                                    <MudTh Style="text-align: right;">Unit Price</MudTh>
                                    <MudTh Style="text-align: right;">Total</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Description">@context.Description</MudTd>
                                    <MudTd DataLabel="Quantity" Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
                                    <MudTd DataLabel="Unit Price" Style="text-align: right;">@context.UnitPrice.ToString("C2")</MudTd>
                                    <MudTd DataLabel="Total" Style="text-align: right;">@((context.Quantity * context.UnitPrice).ToString("C2"))</MudTd>
                                </RowTemplate>
                                <FooterContent>
                                    <MudTFootRow>
                                        <MudTd colspan="3" Style="text-align: right;"><strong>Subtotal</strong></MudTd>
                                        <MudTd Style="text-align: right;">@_quotation.SubTotal.ToString("C2")</MudTd>
                                    </MudTFootRow>
                                    <MudTFootRow>
                                        <MudTd colspan="3" Style="text-align: right;"><strong>VAT (7%)</strong></MudTd>
                                        <MudTd Style="text-align: right;">@_quotation.Tax.ToString("C2")</MudTd>
                                    </MudTFootRow>
                                    <MudTFootRow>
                                        <MudTd colspan="3" Style="text-align: right;"><strong>Grand Total</strong></MudTd>
                                        <MudTd Style="text-align: right;"><strong>@_quotation.Total.ToString("C2")</strong></MudTd>
                                    </MudTFootRow>
                                </FooterContent>
                            </MudTable>

                            @if (!string.IsNullOrEmpty(currentVersion.DeliveryExpectations))
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-4">Delivery Expectations:</MudText>
                                <MudText Typo="Typo.body2">@currentVersion.DeliveryExpectations</MudText>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning">No line items found for the current version.</MudAlert>
                        }
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Version History" Icon="@Icons.Material.Outlined.History">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudTable Items="@_quotation.Versions.OrderByDescending(v => v.VersionNumber)" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Version</MudTh>
                                <MudTh>Date</MudTh>
                                <MudTh>Created By</MudTh>
                                <MudTh Style="text-align: right;">Total</MudTh>
                                <MudTh>Summary</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Version">v@context.VersionNumber</MudTd>
                                <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudTd>
                                <MudTd DataLabel="Created By">@context.CreatedBy</MudTd>
                                <MudTd DataLabel="Total" Style="text-align: right;">@context.TotalPrice.ToString("C2")</MudTd>
                                <MudTd DataLabel="Summary">@context.ChangeSummary</MudTd>
                                <MudTd Style="text-align: right;">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">View</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Files" Icon="@Icons.Material.Outlined.AttachFile">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.h6">Attachments</MudText>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Size="Size.Small">Upload File</MudButton>
                        </MudStack>

                        @if (_quotation.Attachments.Any())
                        {
                            <MudList T="FileAttachmentDto">
                                @foreach (var file in _quotation.Attachments)
                                {
                                    <MudListItem Icon="@Icons.Material.Outlined.InsertDriveFile">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <div>
                                                <MudText Typo="Typo.body1">@file.FileName</MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@((file.FileSize / 1024.0).ToString("N1")) KB • @file.CreatedAt.ToString("dd MMM yyyy")</MudText>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No files attached.</MudText>
                        }
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Customer Info</MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Name:</MudText>
                            <MudLink Href="@($"/sales/customers/{_quotation.CustomerId}")" Typo="Typo.body2" Color="Color.Primary">@_quotation.CustomerName</MudLink>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Valid From:</MudText>
                            <MudText Typo="Typo.body2">@_quotation.ValidityPeriodStart.ToString("dd MMM yyyy")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Valid Until:</MudText>
                            <MudText Typo="Typo.body2">@_quotation.ValidityPeriodEnd.ToString("dd MMM yyyy")</MudText>
                        </MudStack>
                        @if (_quotation.SourceRfqId.HasValue)
                        {
                            <MudDivider Class="my-2" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Source RFQ:</MudText>
                                <MudLink Typo="Typo.body2" Color="Color.Primary">@(_quotation.SourceRfqNumber ?? _quotation.SourceRfqId.Value.ToString().Substring(0, 8))</MudLink>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Internal Notes</MudText>
                    
                    <MudStack Spacing="3">
                        @foreach (var note in _quotation.InternalNotes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="note-item">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small" Color="Color.Default">@note.Author[0]</MudAvatar>
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@note.Author</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@note.CreatedAt.ToString("dd MMM HH:mm")</MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="mt-1 pl-8">@note.Content</MudText>
                            </div>
                        }

                        <MudTextField @bind-Value="_newNoteContent" 
                                      Placeholder="Add an internal note..." 
                                      Lines="3" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Default" 
                                   Size="Size.Small" 
                                   OnClick="@AddNote"
                                   Disabled="@string.IsNullOrWhiteSpace(_newNoteContent)">
                            Add Note
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private QuotationDetailDto? _quotation;
    private string _newNoteContent = "";
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadQuotation();

        _breadcrumbs = 
        [
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Sales", href: null, disabled: true),
            new BreadcrumbItem("Quotations", href: "/sales/quotations"),
            new BreadcrumbItem(_quotation?.QuotationNumber ?? "Detail", href: null, disabled: true)
        ];
    }

    private async Task LoadQuotation()
    {
        try
        {
            _isLoading = true;
            _quotation = await Http.GetFromJsonAsync<QuotationDetailDto>($"api/quotations/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading quotation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SendQuotation()
    {
        try
        {
            var response = await Http.PatchAsync($"api/quotations/{Id}/status", JsonContent.Create("Sent"));
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Quotation sent to customer", Severity.Success);
                await LoadQuotation();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateNewVersion()
    {
        if (_quotation == null) return;
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Create New Version",
            "This will create a new version of the quotation based on the current one. Continue?",
            yesText: "Create", cancelText: "Cancel");
        if (confirm != true) return;

        Snackbar.Add("New version feature requires backend endpoint - contact IT team", Severity.Info);
    }

    private async Task ConvertToOrder()
    {
        if (_quotation == null) return;
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Convert to Order",
            $"Convert quotation {_quotation.QuotationNumber} to an order?",
            yesText: "Convert", cancelText: "Cancel");
        if (confirm != true) return;

        Snackbar.Add("Convert to order requires backend endpoint - contact IT team", Severity.Info);
    }

    private async Task GeneratePdf()
    {
        if (_quotation == null) return;
        
        try
        {
            Snackbar.Add($"Generating PDF for quotation {_quotation.QuotationNumber}...", Severity.Info);
            
            var response = await Http.PostAsync($"api/quotations/{Id}/pdf", null);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("storageUrl", out var urlElement))
                {
                    var pdfUrl = urlElement.GetString();
                    if (!string.IsNullOrEmpty(pdfUrl))
                    {
                        await JS.InvokeVoidAsync("open", pdfUrl, "_blank");
                        Snackbar.Add("PDF generated successfully", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("PDF generated but URL is empty", Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add("Invalid response from server", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Failed to generate PDF", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating PDF: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditDialog()
    {
        if (_quotation == null) return;

        var parameters = new DialogParameters<EditQuotationDialog>
        {
            { x => x.QuotationId, Id },
            { x => x.Quotation, _quotation }
        };
        var dialog = await DialogService.ShowAsync<EditQuotationDialog>("Edit Quotation", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQuotation();
        }
    }

    private async Task DeleteQuotation()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Quotation", 
            "Are you sure you want to delete this quotation? This action cannot be undone.", 
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/quotations/{Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Quotation deleted", Severity.Success);
                Navigation.NavigateTo("/sales/quotations");
            }
        }
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(_newNoteContent)) return;

        try
        {
            var request = new AddQuotationNoteRequest { Content = _newNoteContent };
            var response = await Http.PostAsJsonAsync($"api/quotations/{Id}/notes", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Note added", Severity.Success);
                _newNoteContent = "";
                await LoadQuotation();
            }
            else
            {
                Snackbar.Add("Failed to add note", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding note: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Sent" => Color.Info,
        "Accepted" => Color.Success,
        "Rejected" => Color.Error,
        "Expired" => Color.Dark,
        _ => Color.Default
    };
}
