@page "/finance/invoices"
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Invoices - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Invoices</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search invoices..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Create Invoice
        </MudButton>
    </MudStack>
</MudPaper>

    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
    <MudTabs Elevation="0" Rounded="false" TabPanelsClass="pa-0" Class="border-b mud-border-lines-default">
        <MudTabPanel Text="All" Icon="@Icons.Material.Outlined.List" />
        <MudTabPanel Text="Draft" Icon="@Icons.Material.Outlined.Edit" />
        <MudTabPanel Text="Sent" Icon="@Icons.Material.Outlined.Send" />
        <MudTabPanel Text="Overdue" Icon="@Icons.Material.Outlined.Warning" />
        <MudTabPanel Text="Paid" Icon="@Icons.Material.Outlined.CheckCircle" />
    </MudTabs>

    @if (_isLoading)
    {
        <div class="pa-4">
            @for (int i = 0; i < 6; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
            }
        </div>
    }
    else
    {
        <MudDataGrid T="InvoiceSummaryDto" Items="@_invoices" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.IssueDate" Title="Issue Date" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.DueDate" Title="Due Date" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.Total" Title="Amount" Format="C2" />
                <PropertyColumn Property="x => x.Balance" Title="Balance" Format="C2" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Color="Color.Error" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Send" Size="Size.Small" Color="Color.Primary" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Payment" Size="Size.Small" Color="Color.Success" />
                            @if (context.Item.Status == "Draft" || context.Item.Status == "Sent")
                            {
                                <MudTooltip Text="Split Invoice">
                                    <MudIconButton Icon="@Icons.Material.Outlined.CallSplit" 
                                                   Size="Size.Small" 
                                                   Color="Color.Secondary" 
                                                   OnClick="@(() => OpenSplitDialog(context.Item))" />
                                </MudTooltip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<InvoiceSummaryDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<InvoiceSummaryDto>>("api/invoices");
            if (response?.Data != null)
            {
                _invoices = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading invoices: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<CreateInvoiceDialog>("Create Invoice", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task OpenSplitDialog(InvoiceSummaryDto invoice)
    {
        var parameters = new DialogParameters<InvoiceSplitDialog>
        {
            { x => x.InvoiceId, invoice.Id },
            { x => x.InvoiceNumber, invoice.InvoiceNumber },
            { x => x.TotalAmount, invoice.Total }
        };

        var dialog = await DialogService.ShowAsync<InvoiceSplitDialog>("Split Invoice", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Sent" => Color.Primary,
        "Overdue" => Color.Error,
        "Paid" => Color.Success,
        "Partial" => Color.Warning,
        _ => Color.Default
    };
}
