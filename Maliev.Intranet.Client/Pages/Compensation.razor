@using Maliev.Intranet.Client.Helpers
@page "/hr/compensation"
@using Maliev.Intranet.Shared
@inject HttpClient Http

<PageTitle>Compensation - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Compensation & Benefits</MudText>

<MudGrid Class="mb-4">
    @if (_isLoading)
    {
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded-lg" />
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Base Salary</MudText>
                <MudText Typo="Typo.h5" Class="mt-2">@ThaiCurrency.Format(_compensation.BaseSalary, 2)</MudText>
                <MudText Typo="Typo.caption" Color="@(_compensation.PercentageChange >= 0 ? Color.Success : Color.Error)">
                    @(_compensation.PercentageChange >= 0 ? "+" : "")@(_compensation.PercentageChange.ToString("P0")) from last year
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Annual Bonus</MudText>
                <MudText Typo="Typo.h5" Class="mt-2">@ThaiCurrency.Format(_compensation.AnnualBonus, 2)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Last payout</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Compensation</MudText>
                <MudText Typo="Typo.h5" Class="mt-2">@ThaiCurrency.Format(_compensation.TotalCompensation, 2)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Current Year</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg mb-4">
    <MudTabs Elevation="0" Rounded="false" PanelClass="pa-4">
        <MudTabPanel Text="Benefits" Icon="@Icons.Material.Outlined.HealthAndSafety">
            @if (_isLoading)
            {
                <div class="pa-2">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2 rounded" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2 rounded" />
                </div>
            }
            else
            {
                <MudList T="BenefitDto" Dense="true">
                    @if (_benefits.Any())
                    {
                        @foreach (var benefit in _benefits)
                        {
                            <MudListItem T="BenefitDto" Icon="@benefit.Icon">
                                <MudText Typo="Typo.subtitle2">@benefit.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@benefit.Description</MudText>
                            </MudListItem>
                            <MudDivider />
                        }
                    }
                    else
                    {
                        <MudText Class="pa-4 text-center" Color="Color.Secondary">No active benefits enrolled</MudText>
                    }
                </MudList>
            }
        </MudTabPanel>
        
        <MudTabPanel Text="Salary History" Icon="@Icons.Material.Outlined.Timeline">
            <MudText Typo="Typo.caption" Color="Color.Secondary">This information is confidential and will be available once the history service is integrated.</MudText>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private bool _isLoading = true;
    private CompensationSummaryDto _compensation = new();
    private List<BenefitDto> _benefits = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var compTask = Http.GetFromJsonAsync<CompensationSummaryDto>("api/compensation/summary");
            var benefitsTask = Http.GetFromJsonAsync<List<BenefitDto>>("api/compensation/benefits");

            await Task.WhenAll(compTask, benefitsTask);

            _compensation = await compTask ?? new();
            _benefits = await benefitsTask ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading compensation data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}

