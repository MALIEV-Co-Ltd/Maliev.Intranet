@page "/admin/notifications"
<PageTitle>Notification Templates | Intranet Gateway</PageTitle>
@inject NavigationManager Navigation

@code {
    /// <summary>Redirects legacy /admin/notifications route to the consolidated Settings page (Notifications tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/settings?tab=notifications", replace: true);
    }
}
