@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - MALIEV Intranet</PageTitle>

<div class="not-found-page">
    <div class="not-found-eyes" role="img" aria-label="Animated eyes looking around"></div>
    <MudText Typo="Typo.h5" Class="not-found-title">Page Not Found</MudText>
    <MudText Typo="Typo.body2" Color="Color.Default" Class="not-found-message">
        The content you are looking for does not exist.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="not-found-action">Go to Dashboard</MudButton>
</div>
