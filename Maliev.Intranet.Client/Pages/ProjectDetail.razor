    private async Task OpenPartThumbnailPreviewAsync(ProjectPartDto part)
    {
        _thumbnailPreviewPart = part;
        _thumbnailPreviewUrl = FirstNonEmpty(part.ThumbnailUrl);
        _thumbnailPreviewError = null;
        _thumbnailPreviewLoading = false;

        if (_largeThumbnailUrls.TryGetValue(part.Id, out var cachedLargeUrl))
        {
            _thumbnailPreviewUrl = cachedLargeUrl;
            return;
        }

        if (string.IsNullOrWhiteSpace(part.ThumbnailLargeGcsPath))
        {
            _thumbnailPreviewError = string.IsNullOrWhiteSpace(part.ThumbnailUrl)
                ? "Large thumbnail is not available for this part."
                : "Large thumbnail is not available; showing the table thumbnail.";
            return;
        }

        _thumbnailPreviewLoading = true;
        StateHasChanged();
        try
        {
            var response = await Http.GetFromJsonAsync<ThumbnailPreviewUrlResponse>($"api/v1/projects/{Id}/parts/{part.Id}/thumbnail-large-url");
            if (!string.IsNullOrWhiteSpace(response?.Url))
            {
                _thumbnailPreviewUrl = response.Url;
                _largeThumbnailUrls[part.Id] = response.Url;
            }
            else
            {
                _thumbnailPreviewError = "Large thumbnail could not be loaded; showing the table thumbnail.";
            }
        }
        catch
        {
            _thumbnailPreviewError = "Large thumbnail could not be loaded; showing the table thumbnail.";
        }
        finally
        {
            _thumbnailPreviewLoading = false;
        }
    }

    private void ClosePartThumbnailPreview()
    {
        _thumbnailPreviewPart = null;
        _thumbnailPreviewUrl = null;
        _thumbnailPreviewError = null;
        _thumbnailPreviewLoading = false;
    }

