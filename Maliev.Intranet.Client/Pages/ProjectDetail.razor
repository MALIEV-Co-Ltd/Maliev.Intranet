@page "/sales/projects/{Id:guid}"
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Rendering
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@ProjectTitle | MALIEV Intranet</PageTitle>

<div class="project-record-shell">
    @if (_loading)
    {
        <PageHeader Title="Project" Subtitle="Loading project record" BackLabel="Projects" BackHref="/sales/projects" />
        <PageBody Class="project-record-body">
            <div class="project-loading-grid">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="92px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="92px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
            </div>
        </PageBody>
    }
    else if (_project is null)
    {
        <PageHeader Title="Project not found" Subtitle="The project may have been deleted or moved" BackLabel="Projects" BackHref="/sales/projects" />
        <PageBody Class="project-record-body">
            <PanelCard Class="project-empty-panel">
                <MudIcon Icon="@Icons.Material.Outlined.FolderOff" Size="Size.Large" />
                <p>Project not found.</p>
                <SecondaryButton Href="/sales/projects" Icon="@Icons.Material.Outlined.ArrowBack">
                    Back to projects
                </SecondaryButton>
            </PanelCard>
        </PageBody>
    }
    else
    {
        <PageHeader Title="@ProjectTitle" Subtitle="@ProjectSubtitle" BackLabel="Projects" BackHref="/sales/projects" Class="project-detail-header">
            <HeaderMeta>
                <span class="project-header-subtitle">@ProjectSubtitle</span>
                <StatusBadge Status="@FormatStatus(_project?.Status)" />
            </HeaderMeta>
            <ChildContent>
                <MudTooltip Text="Edit project">
                    <MudIconButton Class="project-action-edit project-header-icon-action"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   aria-label="Edit project"
                                   OnClick="@(_ => EditProject())" />
                </MudTooltip>
                <MudTooltip Text="@(_pdfLoading ? "Generating PDF" : "Generate PDF")">
                    <MudIconButton Class="project-action-download project-header-icon-action"
                                   Icon="@Icons.Material.Sharp.PictureAsPdf"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Disabled="@(!HasQuotation || _pdfLoading)"
                                   aria-label="Generate PDF"
                                   OnClick="@DownloadQuoteAsync" />
                </MudTooltip>
                <PrimaryButton Class="project-action-accept" Icon="@Icons.Material.Outlined.Check" Disabled="@(!CanAcceptQuote || _accepting)" OnClick="@(_ => OpenAcceptQuoteConfirmation())">
                    @AcceptQuoteButtonLabel
                </PrimaryButton>
            </ChildContent>
        </PageHeader>

        <nav class="project-record-tabs" aria-label="Project detail sections">
            @foreach (var tab in Tabs)
            {
                <button type="button"
                        class="@(IsActive(tab.Key) ? "active" : null)"
                        data-tab="@tab.Key"
                        @onclick="@(() => SetActiveTabAsync(tab.Key))">
                    @tab.Label
                </button>
            }
        </nav>

        <PageBody Class="project-record-body">
            @if (_activeTab == "overview")
            {
                @RenderOverview()
            }
            else if (_activeTab == "quote")
            {
                @RenderQuote()
            }
            else if (_activeTab == "parts")
            {
                @RenderParts()
            }
            else if (_activeTab == "planning")
            {
                @RenderProductionPlanning()
            }
            else if (_activeTab == "timeline")
            {
                @RenderTimelinePanel(full: true)
            }
            else if (_activeTab == "notes")
            {
                @RenderNotes()
            }
        </PageBody>
    }
</div>

<ConfirmModal Open="@_acceptConfirmOpen" Title="Accept quote" ConfirmLabel="Accept quote" Class="project-accept-dialog" ConfirmButtonClass="project-accept-confirm" Danger="true" OnCancel="@CloseAcceptQuoteConfirmation" OnConfirm="@ConfirmAcceptQuoteAsync">
    <p>
        Accepting this quote will mark the commercial offer as accepted and move the project into the downstream order workflow.
        Confirm only after the customer has approved the quotation PDF and all DFM issues are acknowledged.
    </p>
</ConfirmModal>

@if (_thumbnailPreviewPart is not null)
{
    var previewPart = _thumbnailPreviewPart;
    <div class="project-thumbnail-popout-backdrop" role="presentation" @onclick="ClosePartThumbnailPreview">
        <section class="project-thumbnail-popout" role="dialog" aria-modal="true" aria-labelledby="project-thumbnail-popout-title" @onclick:stopPropagation="true">
            <button type="button" class="project-thumbnail-popout-close" aria-label="Close thumbnail preview" @onclick="ClosePartThumbnailPreview">
                <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
            </button>
            <header class="project-thumbnail-popout-header">
                <span>Part preview</span>
                <strong id="project-thumbnail-popout-title">@previewPart.FileName</strong>
                <small>@FormatDimensions(previewPart.Dimensions)</small>
            </header>
            <div class="project-thumbnail-popout-frame">
                @if (_thumbnailPreviewLoading)
                {
                    <div class="project-thumbnail-popout-loading">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        <span>Loading large preview</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_thumbnailPreviewUrl))
                {
                    <img src="@_thumbnailPreviewUrl" alt="@($"{previewPart.FileName} large thumbnail")" />
                }
                else
                {
                    <div class="project-thumbnail-popout-loading">
                        <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" Size="Size.Small" />
                        <span>@FirstNonEmpty(_thumbnailPreviewError, "Preview unavailable")</span>
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_thumbnailPreviewError))
            {
                <p class="project-thumbnail-popout-note">@_thumbnailPreviewError</p>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter]
    public string? Tab { get; set; }

    private ProjectDetailDto? _project;
    private QuotationDetailDto? _quotation;
    private ProjectProductionPlanDto? _productionPlan;
    private bool _loading = true;
    private bool _planningLoading;
    private bool _pdfLoading;
    private bool _accepting;
    private bool _acceptConfirmOpen;
    private bool _quoteAccepted;
    private bool _addingNote;
    private bool _noteSaved;
    private string? _quotePdfUrl;
    private string _newNoteContent = string.Empty;
    private string _activeTab = "overview";
    private readonly HashSet<Guid> _holdSavingPartIds = [];
    private readonly HashSet<Guid> _acknowledgingDfmPartIds = [];
    private readonly Dictionary<Guid, string> _largeThumbnailUrls = [];
    private ProjectPartDto? _thumbnailPreviewPart;
    private string? _thumbnailPreviewUrl;
    private string? _thumbnailPreviewError;
    private bool _thumbnailPreviewLoading;

    private IReadOnlyList<(string Key, string Label)> Tabs =>
    [
        ("overview", "Overview"),
        ("quote", "Quote"),
        ("parts", $"Parts ({_project?.Parts.Count ?? 0})"),
        ("planning", "Planning"),
        ("timeline", "Timeline"),
        ("notes", $"Notes ({_project?.Notes?.Count ?? 0})")
    ];

    private string ProjectTitle => _project is null
        ? "Project"
        : string.IsNullOrWhiteSpace(_project.ProjectNumber) ? _project.Title : _project.ProjectNumber;

    private string ProjectSubtitle => _project is null
        ? "Loading project record"
        : string.IsNullOrWhiteSpace(_project.Title)
            ? $"{_project.CustomerName} • Last updated on {FormatLocalDateTime(_project.UpdatedAt ?? _project.CreatedAt)}"
            : $"{_project.Title} - {_project.CustomerName} • Last updated on {FormatLocalDateTime(_project.UpdatedAt ?? _project.CreatedAt)}";

    private string ProjectCurrency => string.IsNullOrWhiteSpace(_project?.Currency) ? "THB" : _project.Currency;

    private bool HasQuotation => _project?.QuotationId is not null;

    private bool CanAcceptQuote => HasQuotation && IsAcceptableQuoteStatus(_project?.Status);

    private string AcceptQuoteButtonLabel => _accepting
        ? "Accepting..."
        : _quoteAccepted ? "Accepted" : "Accept quote";

    private decimal PartsSubtotal => _project?.Parts.Sum(part => GetPartLineTotal(part)) ?? 0m;
    private decimal QuoteDiscount => Math.Max(0m, PartsSubtotal - (_project?.TotalPrice ?? PartsSubtotal));
    private string QuoteLeadTime => ResolveQuoteLeadTime();

    protected override async Task OnParametersSetAsync()
    {
        ApplyRequestedTab();
        _loading = true;
        try
        {
            _project = await Http.GetFromJsonAsync<ProjectDetailDto>($"api/v1/projects/{Id}");
            await LoadQuotationAsync();
            if (_activeTab == "planning")
                await LoadProductionPlanAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load project: {ex.Message}", Severity.Error);
            _project = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadQuotationAsync()
    {
        _quotation = null;
        if (_project?.QuotationId is not Guid quotationId)
            return;

        try
        {
            _quotation = await Http.GetFromJsonAsync<QuotationDetailDto>($"api/v1/quotations/{quotationId}");
        }
        catch
        {
            _quotation = null;
        }
    }

    private async Task SetActiveTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab == "planning" && _productionPlan is null && !_planningLoading)
            await LoadProductionPlanAsync();
    }

    private async Task LoadProductionPlanAsync()
    {
        _planningLoading = true;
        try
        {
            _productionPlan = await Http.GetFromJsonAsync<ProjectProductionPlanDto>($"api/v1/projects/{Id}/production-plan");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Production plan could not be loaded: {ex.Message}", Severity.Error);
            _productionPlan = null;
        }
        finally
        {
            _planningLoading = false;
        }
    }

    private void ApplyRequestedTab()
    {
        var requestedTab = string.IsNullOrWhiteSpace(Tab) ? null : Tab.Trim().ToLowerInvariant();
        if (requestedTab is not null && Tabs.Any(tab => tab.Key == requestedTab))
        {
            _activeTab = requestedTab;
        }
    }

    private RenderFragment RenderOverview() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "project-record-grid");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "project-record-main project-record-main-manufacturing");
        builder.AddContent(4, RenderManufacturingSummary());
        builder.CloseElement();

        builder.OpenElement(6, "aside");
        builder.AddAttribute(7, "class", "project-record-sidebar project-overview-sidebar");
        builder.AddContent(8, RenderProjectInformation());
        builder.AddContent(9, RenderCustomerPanel());
        builder.AddContent(10, RenderTimelinePanel(full: false));
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment RenderProjectInformation() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Quote terms");
        builder.AddAttribute(2, "Class", "project-information-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(4, "div");
            content.AddAttribute(5, "class", "project-quote-terms");
            AddSnapshot(content, 6, "Valid until", FormatDate(_project?.ValidUntil));
            AddSnapshot(content, 10, "Currency", ProjectCurrency);
            AddSnapshot(content, 14, "Lead time", QuoteLeadTime);
            AddSnapshot(content, 18, "Subtotal", FormatMoney(PartsSubtotal));
            AddSnapshot(content, 22, "Discount", QuoteDiscount > 0m ? $"-{FormatMoney(QuoteDiscount)}" : FormatMoney(0m));
            AddSnapshot(content, 26, "Total", FormatMoney(_project?.TotalPrice ?? 0m));
            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderManufacturingSummary() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Manufacturing summary");
        builder.AddAttribute(2, "Class", "project-manufacturing-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(4, "div");
            content.AddAttribute(5, "class", "project-metric-row");
            content.OpenComponent<StatTile>(6);
            content.AddAttribute(7, "Label", "Parts");
            content.AddAttribute(8, "Value", (_project?.Parts.Count ?? 0).ToString());
            content.AddAttribute(9, "Subtext", "configured line items");
            content.CloseComponent();
            content.OpenComponent<StatTile>(10);
            content.AddAttribute(11, "Label", "Confirmed total");
            content.AddAttribute(12, "Value", FormatMoney(_project?.TotalPrice ?? 0m));
            content.AddAttribute(13, "Subtext", ProjectCurrency);
            content.CloseComponent();
            content.OpenComponent<StatTile>(14);
            content.AddAttribute(15, "Label", "Quotation");
            content.AddAttribute(16, "Value", QuotationLabel);
            content.AddAttribute(17, "Subtext", FormatStatus(_project?.QuotationStatus));
            content.CloseComponent();
            content.CloseElement();

            content.AddContent(18, RenderPartsTable(compact: true));
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderQuoteSnapshot() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Quote snapshot");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            AddQuoteSnapshotContent(content, 3, "project-snapshot");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderCustomerPanel() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Customer");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(3, "div");
            content.AddAttribute(4, "class", "project-customer-panel");

            content.OpenElement(5, "div");
            content.AddAttribute(6, "class", "project-customer-heading");
            content.OpenElement(7, "strong");
            content.AddContent(8, _project?.CustomerName ?? "Unknown customer");
            content.CloseElement();
            content.OpenElement(9, "span");
            content.AddAttribute(10, "class", "project-customer-id");
            content.AddContent(11, $"Customer ID {_project?.CustomerId.ToString("N")[..8].ToUpperInvariant()}");
            content.CloseElement();
            content.CloseElement();

            content.OpenElement(12, "dl");
            content.AddAttribute(13, "class", "project-customer-detail-grid");
            AddCustomerDetail(content, 14, "Company", _project?.CustomerCompanyName);
            AddCustomerDetail(content, 18, "Email", _project?.CustomerEmail);
            AddCustomerDetail(content, 22, "Phone", _project?.CustomerPhone);
            AddCustomerDetail(content, 26, "Status", FormatStatus(_project?.CustomerStatus));
            AddCustomerDetail(content, 30, "Segment", _project?.CustomerSegment);
            AddCustomerDetail(content, 34, "Tier", _project?.CustomerTier);
            AddCustomerDetail(content, 38, "Language", _project?.CustomerPreferredLanguage?.ToUpperInvariant());
            AddCustomerDetail(content, 42, "Timezone", _project?.CustomerTimezone);
            content.CloseElement();

            content.OpenElement(46, "div");
            content.AddAttribute(47, "class", "project-customer-address-block");
            content.OpenElement(48, "span");
            content.AddContent(49, "Shipping");
            content.CloseElement();
            content.OpenElement(50, "strong");
            content.AddContent(51, _project?.ShippingRecipientName ?? "-");
            content.CloseElement();
            content.OpenElement(52, "p");
            content.AddContent(53, _project?.ShippingAddressLine ?? "-");
            content.CloseElement();
            if (!string.IsNullOrWhiteSpace(_project?.ShippingRecipientPhone))
            {
                content.OpenElement(54, "small");
                content.AddContent(55, _project.ShippingRecipientPhone);
                content.CloseElement();
            }
            content.CloseElement();

            if (!string.IsNullOrWhiteSpace(_project?.BillingAddressLine))
            {
                content.OpenElement(56, "div");
                content.AddAttribute(57, "class", "project-customer-address-block");
                content.OpenElement(58, "span");
                content.AddContent(59, "Billing");
                content.CloseElement();
                content.OpenElement(60, "strong");
                content.AddContent(61, FirstNonEmpty(_project.CustomerCompanyName, _project.CustomerName, "-"));
                content.CloseElement();
                content.OpenElement(62, "p");
                content.AddContent(63, _project.BillingAddressLine);
                content.CloseElement();
                content.CloseElement();
            }

            content.OpenElement(64, "a");
            content.AddAttribute(65, "href", $"/customers/{_project?.CustomerId}");
            content.AddContent(66, "Open customer record");
            content.CloseElement();
            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderQuote() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "project-quote-workspace");
        builder.AddContent(2, RenderQuoteDocumentPanel());
        builder.AddContent(3, RenderCommercialBreakdownPanel());
        builder.CloseElement();
    };

    private RenderFragment RenderQuoteDocumentPanel() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Quote document");
        builder.AddAttribute(2, "Class", "project-quote-document-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(4, "div");
            content.AddAttribute(5, "class", "project-quote-document");

            content.OpenElement(6, "div");
            content.AddAttribute(7, "class", "project-document-hero");
            content.OpenElement(8, "span");
            content.AddAttribute(9, "class", "project-document-icon");
            content.OpenComponent<MudIcon>(10);
            content.AddAttribute(11, "Icon", Icons.Material.Sharp.PictureAsPdf);
            content.AddAttribute(12, "Size", Size.Medium);
            content.CloseComponent();
            content.CloseElement();
            content.OpenElement(13, "div");
            content.OpenElement(14, "strong");
            content.AddContent(15, QuotationLabel);
            content.CloseElement();
            content.OpenElement(16, "span");
            content.AddContent(17, $"{FormatStatus(_project?.QuotationStatus)} / Valid until {FormatDate(_project?.ValidUntil)}");
            content.CloseElement();
            content.CloseElement();
            content.CloseElement();

            content.OpenElement(18, "dl");
            content.AddAttribute(19, "class", "project-document-meta");
            AddSnapshot(content, 20, "Customer", _project?.CustomerName ?? "-");
            AddSnapshot(content, 24, "Company", _project?.CustomerCompanyName ?? "-");
            AddSnapshot(content, 28, "Currency", ProjectCurrency);
            AddSnapshot(content, 32, "Shipping", ShippingSummary);
            content.CloseElement();

            content.OpenElement(36, "div");
            content.AddAttribute(37, "class", "project-panel-actions");
            content.OpenComponent<SecondaryButton>(38);
            content.AddAttribute(39, "Icon", Icons.Material.Sharp.PictureAsPdf);
            content.AddAttribute(40, "Disabled", !HasQuotation || _pdfLoading);
            content.AddAttribute(41, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, DownloadQuoteAsync));
            content.AddContent(42, _pdfLoading ? "Generating PDF" : "Generate PDF");
            content.CloseComponent();
            if (!string.IsNullOrWhiteSpace(_quotePdfUrl))
            {
                content.OpenComponent<SecondaryButton>(43);
                content.AddAttribute(44, "Icon", Icons.Material.Outlined.OpenInNew);
                content.AddAttribute(45, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, OpenGeneratedPdfAsync));
                content.AddContent(46, "Open PDF");
                content.CloseComponent();
            }
            content.CloseElement();

            content.OpenElement(47, "div");
            content.AddAttribute(48, "class", string.IsNullOrWhiteSpace(_quotePdfUrl) ? "project-document-preview empty" : "project-document-preview");
            if (string.IsNullOrWhiteSpace(_quotePdfUrl))
            {
                content.OpenComponent<MudIcon>(49);
                content.AddAttribute(50, "Icon", Icons.Material.Outlined.Description);
                content.AddAttribute(51, "Size", Size.Large);
                content.CloseComponent();
                content.OpenElement(52, "strong");
                content.AddContent(53, HasQuotation ? "No PDF generated in this session" : "Quotation not generated yet");
                content.CloseElement();
                content.OpenElement(54, "span");
                content.AddContent(55, HasQuotation ? "Generate the PDF to preview or open the latest signed document URL." : "Create the quote from the project editor after pricing is confirmed.");
                content.CloseElement();
            }
            else
            {
                content.OpenElement(56, "iframe");
                content.AddAttribute(57, "title", "Quote PDF preview");
                content.AddAttribute(58, "src", _quotePdfUrl);
                content.CloseElement();
            }
            content.CloseElement();

            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderCommercialBreakdownPanel() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Commercial breakdown");
        builder.AddAttribute(2, "Class", "project-commercial-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(4, "div");
            content.AddAttribute(5, "class", "project-commercial-breakdown");

            content.OpenElement(6, "div");
            content.AddAttribute(7, "class", "project-commercial-summary");
            content.OpenComponent<StatTile>(8);
            content.AddAttribute(9, "Label", "Line subtotal");
            content.AddAttribute(10, "Value", FormatMoney(PartsSubtotal));
            content.AddAttribute(11, "Subtext", ProjectCurrency);
            content.CloseComponent();
            content.OpenComponent<StatTile>(12);
            content.AddAttribute(13, "Label", "Adjustments");
            content.AddAttribute(14, "Value", QuoteDiscount > 0m ? $"-{FormatMoney(QuoteDiscount)}" : FormatMoney(0m));
            content.AddAttribute(15, "Subtext", "Discount");
            content.CloseComponent();
            content.OpenComponent<StatTile>(16);
            content.AddAttribute(17, "Label", "Quote total");
            content.AddAttribute(18, "Value", FormatMoney(_project?.TotalPrice ?? 0m));
            content.AddAttribute(19, "Subtext", ProjectCurrency);
            content.CloseComponent();
            content.CloseElement();

            content.OpenElement(20, "div");
            content.AddAttribute(21, "class", "project-commercial-lines");
            content.OpenElement(22, "table");
            content.OpenElement(23, "thead");
            content.OpenElement(24, "tr");
            var headerSequence = 25;
            AddHeader(content, ref headerSequence, "Part");
            AddHeader(content, ref headerSequence, "Qty", "numeric");
            AddHeader(content, ref headerSequence, "Unit", "numeric");
            AddHeader(content, ref headerSequence, "Line total", "numeric");
            content.CloseElement();
            content.CloseElement();
            content.OpenElement(headerSequence++, "tbody");
            var sequence = headerSequence;
            foreach (var part in _project?.Parts ?? [])
            {
                content.OpenElement(sequence++, "tr");
                content.OpenElement(sequence++, "td");
                content.OpenElement(sequence++, "strong");
                content.AddContent(sequence++, part.FileName);
                content.CloseElement();
                content.OpenElement(sequence++, "span");
                content.AddContent(sequence++, $"{FormatProcess(part.ProcessType)} / {FirstNonEmpty(part.MaterialName, part.MaterialCode, "-")}");
                content.CloseElement();
                content.CloseElement();
                AddCell(content, ref sequence, part.Quantity.ToString(), "numeric");
                AddCell(content, ref sequence, FormatMoney(GetPartUnitPrice(part)), "numeric");
                AddCell(content, ref sequence, FormatMoney(GetPartLineTotal(part)), "numeric");
                content.CloseElement();
            }
            content.CloseElement();
            content.CloseElement();
            content.CloseElement();

            content.OpenElement(sequence++, "dl");
            content.AddAttribute(sequence++, "class", "project-commercial-totals");
            AddCommercialTotal(content, sequence, "Parts subtotal", FormatMoney(PartsSubtotal));
            AddCommercialTotal(content, sequence + 8, "Shipping", "Not quoted separately");
            AddCommercialTotal(content, sequence + 16, "Tax / VAT", "Not quoted separately");
            AddCommercialTotal(content, sequence + 24, "Discount", QuoteDiscount > 0m ? $"-{FormatMoney(QuoteDiscount)}" : FormatMoney(0m));
            AddCommercialTotal(content, sequence + 32, "Total", FormatMoney(_project?.TotalPrice ?? 0m), emphasized: true);
            content.CloseElement();

            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderParts() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", $"Parts ({_project?.Parts.Count ?? 0})");
        builder.AddAttribute(2, "Class", "project-parts-panel");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content => content.AddContent(4, RenderPartsTable(compact: false))));
        builder.CloseComponent();
    };

    private RenderFragment RenderProductionPlanning() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Production planning");
        builder.AddAttribute(2, "Class", "project-planning-panel");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            if (_planningLoading)
            {
                content.OpenElement(4, "div");
                content.AddAttribute(5, "class", "project-muted-box compact");
                content.AddContent(6, "Loading production plan...");
                content.CloseElement();
                return;
            }

            if (_productionPlan is null)
            {
                content.OpenElement(7, "div");
                content.AddAttribute(8, "class", "project-muted-box");
                content.OpenElement(9, "p");
                content.AddContent(10, "Production planning data is not available.");
                content.CloseElement();
                content.OpenComponent<SecondaryButton>(11);
