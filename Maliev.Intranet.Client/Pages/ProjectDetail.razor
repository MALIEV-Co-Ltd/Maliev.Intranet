    private async Task DownloadQuoteAsync()
    {
        if (_project?.QuotationId is null)
            return;

        _pdfLoading = true;
        try
        {
            var response = await Http.PostAsync($"api/v1/quotations/{_project.QuotationId}/pdf", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to generate quotation PDF.", Severity.Error);
                return;
            }

            var url = await ReadPdfUrlAsync(response);
            if (!string.IsNullOrWhiteSpace(url))
            {
                _quotePdfUrl = url;
                await JS.InvokeVoidAsync("window.open", url, "_blank");
            }
            else
            {
                Snackbar.Add("Quotation PDF was generated but no document URL was returned.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Quotation PDF error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _pdfLoading = false;
        }
    }

    private static async Task<string?> ReadPdfUrlAsync(HttpResponseMessage response)
    {
        var raw = (await response.Content.ReadAsStringAsync()).Trim();
        if (string.IsNullOrWhiteSpace(raw))
            return null;

        if (Uri.TryCreate(raw.Trim('"'), UriKind.Absolute, out _))
            return raw.Trim('"');

        try
        {
            using var document = JsonDocument.Parse(raw);
            var root = document.RootElement;
            if (root.ValueKind == JsonValueKind.String)
                return root.GetString();

            if (root.ValueKind == JsonValueKind.Object)
            {
                foreach (var propertyName in new[] { "storageUrl", "pdfUrl", "url" })
                {
                    if (root.TryGetProperty(propertyName, out var value) && value.ValueKind == JsonValueKind.String)
                        return value.GetString();
                }
            }
        }
        catch (JsonException)
        {
            return null;
        }

        return null;
    }

