@page "/sales/projects/{Id:guid}"
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Rendering
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@ProjectTitle | MALIEV Intranet</PageTitle>

<div class="project-record-shell">
    @if (_loading)
    {
        <PageHeader Title="Project" Subtitle="Loading project record" BackLabel="Projects" BackHref="/sales/projects" />
        <PageBody Class="project-record-body">
            <div class="project-loading-grid">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="92px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="92px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
            </div>
        </PageBody>
    }
    else if (_project is null)
    {
        <PageHeader Title="Project not found" Subtitle="The project may have been deleted or moved" BackLabel="Projects" BackHref="/sales/projects" />
        <PageBody Class="project-record-body">
            <PanelCard Class="project-empty-panel">
                <MudIcon Icon="@Icons.Material.Outlined.FolderOff" Size="Size.Large" />
                <p>Project not found.</p>
                <SecondaryButton Href="/sales/projects" Icon="@Icons.Material.Outlined.ArrowBack">
                    Back to projects
                </SecondaryButton>
            </PanelCard>
        </PageBody>
    }
    else
    {
        <PageHeader Title="@ProjectTitle" Subtitle="@ProjectSubtitle" BackLabel="Projects" BackHref="/sales/projects">
            <SecondaryButton Class="project-action-edit" Icon="@Icons.Material.Outlined.Edit" OnClick="@(_ => EditProject())">
                Edit project
            </SecondaryButton>
            <SecondaryButton Class="project-action-download" Icon="@Icons.Material.Outlined.Download" Disabled="@(!HasQuotation || _pdfLoading)" OnClick="@DownloadQuoteAsync">
                @(_pdfLoading ? "Preparing" : "Download quote")
            </SecondaryButton>
            <PrimaryButton Class="project-action-accept" Icon="@Icons.Material.Outlined.Check" Disabled="@(!CanAcceptQuote || _accepting)" OnClick="@(_ => OpenAcceptQuoteConfirmation())">
                @AcceptQuoteButtonLabel
            </PrimaryButton>
        </PageHeader>

        <nav class="project-record-tabs" aria-label="Project detail sections">
            @foreach (var tab in Tabs)
            {
                <button type="button"
                        class="@(IsActive(tab.Key) ? "active" : null)"
                        data-tab="@tab.Key"
                        @onclick="@(() => _activeTab = tab.Key)">
                    @tab.Label
                </button>
            }
        </nav>

        <PageBody Class="project-record-body">
            @if (_activeTab == "overview")
            {
                @RenderOverview()
            }
            else if (_activeTab == "quote")
            {
                @RenderQuote()
            }
            else if (_activeTab == "parts")
            {
                @RenderParts()
            }
            else if (_activeTab == "timeline")
            {
                @RenderTimelinePanel(full: true)
            }
            else if (_activeTab == "notes")
            {
                @RenderNotes()
            }
        </PageBody>
    }
</div>

<ConfirmModal Open="@_acceptConfirmOpen" Title="Accept quote" ConfirmLabel="Accept quote" Class="project-accept-dialog" ConfirmButtonClass="project-accept-confirm" Danger="true" OnCancel="@CloseAcceptQuoteConfirmation" OnConfirm="@ConfirmAcceptQuoteAsync">
    <p>
        Accepting this quote will mark the commercial offer as accepted and move the project into the downstream order workflow.
        Confirm only after the customer has approved the quotation PDF and all DFM issues are acknowledged.
    </p>
</ConfirmModal>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDetailDto? _project;
    private bool _loading = true;
    private bool _pdfLoading;
    private bool _accepting;
    private bool _acceptConfirmOpen;
    private bool _quoteAccepted;
    private bool _addingNote;
    private bool _noteSaved;
    private string _newNoteContent = string.Empty;
    private string _activeTab = "overview";

    private IReadOnlyList<(string Key, string Label)> Tabs =>
    [
        ("overview", "Overview"),
        ("quote", "Quote"),
        ("parts", $"Parts ({_project?.Parts.Count ?? 0})"),
        ("timeline", "Timeline"),
        ("notes", $"Notes ({_project?.Notes?.Count ?? 0})")
    ];

    private string ProjectTitle => _project is null
        ? "Project"
        : string.IsNullOrWhiteSpace(_project.ProjectNumber) ? _project.Title : _project.ProjectNumber;

    private string ProjectSubtitle => _project is null
        ? "Loading project record"
        : string.IsNullOrWhiteSpace(_project.Title)
            ? _project.CustomerName
            : $"{_project.Title} - {_project.CustomerName}";

    private string ProjectCurrency => string.IsNullOrWhiteSpace(_project?.Currency) ? "THB" : _project.Currency;

    private bool HasQuotation => _project?.QuotationId is not null;

    private bool CanAcceptQuote => HasQuotation && IsAcceptableQuoteStatus(_project?.Status);

    private string AcceptQuoteButtonLabel => _accepting
        ? "Accepting..."
        : _quoteAccepted ? "Accepted" : "Accept quote";

    private decimal PartsSubtotal => _project?.Parts.Sum(part => GetPartLineTotal(part)) ?? 0m;
    private decimal QuoteDiscount => Math.Max(0m, PartsSubtotal - (_project?.TotalPrice ?? PartsSubtotal));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _project = await Http.GetFromJsonAsync<ProjectDetailDto>($"api/v1/projects/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load project: {ex.Message}", Severity.Error);
            _project = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment RenderOverview() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "project-record-grid");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "project-record-main project-record-main-manufacturing");
        builder.AddContent(4, RenderManufacturingSummary());
        builder.CloseElement();

        builder.OpenElement(6, "aside");
        builder.AddAttribute(7, "class", "project-record-sidebar project-overview-sidebar");
        builder.AddContent(8, RenderProjectInformation());
        builder.AddContent(9, RenderCustomerPanel());
        builder.AddContent(10, RenderTimelinePanel(full: false));
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment RenderProjectInformation() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Project information");
        builder.AddAttribute(2, "Class", "project-information-card");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(4, "div");
            content.AddAttribute(5, "class", "project-field-grid project-field-grid-compact");
            AddReadOnlyField(content, 6, "Project #", ProjectTitle);
            AddReadOnlyField(content, 14, "Title", _project?.Title);
            AddReadOnlyField(content, 22, "Status", FormatStatus(_project?.Status));
            AddReadOnlyField(content, 30, "Created", FormatDateTime(_project?.CreatedAt));
            AddReadOnlyField(content, 38, "Updated", FormatDateTime(_project?.UpdatedAt));
            content.CloseElement();

            content.OpenElement(46, "div");
            content.AddAttribute(47, "class", "project-info-section-title");
            content.AddContent(48, "Quote snapshot");
            content.CloseElement();

            AddQuoteSnapshotContent(content, 49, "project-snapshot project-snapshot-compact");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderManufacturingSummary() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Manufacturing summary");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(3, "div");
            content.AddAttribute(4, "class", "project-metric-row");
            content.OpenComponent<StatTile>(5);
            content.AddAttribute(6, "Label", "Parts");
            content.AddAttribute(7, "Value", (_project?.Parts.Count ?? 0).ToString());
            content.AddAttribute(8, "Subtext", "configured line items");
            content.CloseComponent();
            content.OpenComponent<StatTile>(9);
            content.AddAttribute(10, "Label", "Confirmed total");
            content.AddAttribute(11, "Value", FormatMoney(_project?.TotalPrice ?? 0m));
            content.AddAttribute(12, "Subtext", ProjectCurrency);
            content.CloseComponent();
            content.OpenComponent<StatTile>(13);
            content.AddAttribute(14, "Label", "Quotation");
            content.AddAttribute(15, "Value", QuotationLabel);
            content.AddAttribute(16, "Subtext", FormatStatus(_project?.QuotationStatus));
            content.CloseComponent();
            content.CloseElement();

            content.AddContent(17, RenderPartsTable(compact: true));
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderQuoteSnapshot() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Quote snapshot");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            AddQuoteSnapshotContent(content, 3, "project-snapshot");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderCustomerPanel() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", "Customer");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(3, "div");
            content.AddAttribute(4, "class", "project-customer-panel");
            content.OpenElement(5, "strong");
            content.AddContent(6, _project?.CustomerName ?? "Unknown customer");
            content.CloseElement();

            content.OpenElement(7, "dl");
            content.AddAttribute(8, "class", "project-customer-detail-grid");
            AddCustomerDetail(content, 9, "Company", _project?.CustomerCompanyName);
            AddCustomerDetail(content, 13, "Email", _project?.CustomerEmail);
            AddCustomerDetail(content, 17, "Phone", _project?.CustomerPhone);
            AddCustomerDetail(content, 21, "Status", FormatStatus(_project?.CustomerStatus));
            AddCustomerDetail(content, 25, "Segment", _project?.CustomerSegment);
            AddCustomerDetail(content, 29, "Tier", _project?.CustomerTier);
            AddCustomerDetail(content, 33, "Language", _project?.CustomerPreferredLanguage?.ToUpperInvariant());
            AddCustomerDetail(content, 37, "Timezone", _project?.CustomerTimezone);
            content.CloseElement();

            content.OpenElement(41, "div");
            content.AddAttribute(42, "class", "project-customer-address-block");
            content.OpenElement(43, "span");
            content.AddContent(44, "Shipping");
            content.CloseElement();
            content.OpenElement(45, "strong");
            content.AddContent(46, _project?.ShippingRecipientName ?? "-");
            content.CloseElement();
            content.OpenElement(47, "p");
            content.AddContent(48, _project?.ShippingAddressLine ?? "-");
            content.CloseElement();
            if (!string.IsNullOrWhiteSpace(_project?.ShippingRecipientPhone))
            {
                content.OpenElement(49, "small");
                content.AddContent(50, _project.ShippingRecipientPhone);
                content.CloseElement();
            }
            content.CloseElement();

            if (!string.IsNullOrWhiteSpace(_project?.BillingAddressLine))
            {
                content.OpenElement(51, "div");
                content.AddAttribute(52, "class", "project-customer-address-block");
                content.OpenElement(53, "span");
                content.AddContent(54, "Billing");
                content.CloseElement();
                content.OpenElement(55, "p");
                content.AddContent(56, _project.BillingAddressLine);
                content.CloseElement();
                content.CloseElement();
            }

            content.OpenElement(57, "span");
            content.AddAttribute(58, "class", "project-customer-id");
            content.AddContent(59, $"Customer ID {_project?.CustomerId.ToString("N")[..8].ToUpperInvariant()}");
            content.CloseElement();
            content.OpenElement(60, "a");
            content.AddAttribute(61, "href", $"/customers/{_project?.CustomerId}");
            content.AddContent(62, "Open customer record");
            content.CloseElement();
            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderQuote() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "project-quote-layout");
        builder.AddContent(2, RenderQuoteSnapshot());
        builder.OpenComponent<PanelCard>(3);
        builder.AddAttribute(4, "Title", "Commercial controls");
        builder.AddAttribute(5, "ChildContent", (RenderFragment)(content =>
        {
            content.OpenElement(6, "div");
            content.AddAttribute(7, "class", "project-action-panel");
            content.OpenElement(8, "p");
            content.AddContent(9, HasQuotation
                ? "The generated quotation is available for customer follow-up. Reopen the project when line items need revision."
                : "Generate a quote from the editor once all parts have confirmed pricing.");
            content.CloseElement();
            content.OpenElement(10, "div");
            content.AddAttribute(11, "class", "project-panel-actions");
            content.OpenComponent<SecondaryButton>(12);
            content.AddAttribute(13, "Icon", Icons.Material.Outlined.Edit);
            content.AddAttribute(14, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, EditProject));
            content.AddContent(15, "Edit project");
            content.CloseComponent();
            content.OpenComponent<SecondaryButton>(16);
            content.AddAttribute(17, "Icon", Icons.Material.Outlined.Download);
            content.AddAttribute(18, "Disabled", !HasQuotation || _pdfLoading);
            content.AddAttribute(19, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, DownloadQuoteAsync));
            content.AddContent(20, _pdfLoading ? "Preparing" : "Download quote");
            content.CloseComponent();
            content.OpenComponent<PrimaryButton>(21);
            content.AddAttribute(22, "Icon", Icons.Material.Outlined.Check);
            content.AddAttribute(23, "Disabled", !CanAcceptQuote || _accepting);
            content.AddAttribute(24, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, _ => OpenAcceptQuoteConfirmation()));
            content.AddContent(25, AcceptQuoteButtonLabel);
            content.CloseComponent();
            content.CloseElement();
            content.CloseElement();
        }));
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment RenderParts() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", $"Parts ({_project?.Parts.Count ?? 0})");
        builder.AddAttribute(2, "Class", "project-parts-panel");
        builder.AddAttribute(3, "ChildContent", (RenderFragment)(content => content.AddContent(4, RenderPartsTable(compact: false))));
        builder.CloseComponent();
    };

    private RenderFragment RenderPartsTable(bool compact) => builder =>
    {
        var parts = _project?.Parts ?? [];
        if (parts.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "project-muted-box");
            builder.AddContent(2, "No parts have been attached to this project.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", compact ? "project-table-wrap compact" : "project-table-wrap");
        builder.OpenElement(5, "table");
        builder.AddAttribute(6, "class", "project-parts-table");
        builder.OpenElement(7, "thead");
        builder.OpenElement(8, "tr");
        foreach (var heading in new[] { "Part", "Process", "Material", "Configuration", "DFM", "Qty", "Unit", "Total", "Status" })
        {
            builder.OpenElement(9, "th");
            builder.AddContent(10, heading);
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(11, "tbody");
        var sequence = 12;
        foreach (var part in parts)
        {
            builder.OpenElement(sequence++, "tr");
            AddPartCell(builder, ref sequence, part);
            AddCell(builder, ref sequence, FormatProcess(part.ProcessType));
            AddCell(builder, ref sequence, part.MaterialName ?? "-");
            AddConfigurationCell(builder, ref sequence, part);
            AddDfmCell(builder, ref sequence, part);
            AddCell(builder, ref sequence, part.Quantity.ToString(), "numeric");
            AddCell(builder, ref sequence, FormatMoney(GetPartUnitPrice(part)), "numeric");
            AddCell(builder, ref sequence, FormatMoney(GetPartLineTotal(part)), "numeric");
            builder.OpenElement(sequence++, "td");
            builder.OpenComponent<StatusBadge>(sequence++);
            builder.AddAttribute(sequence++, "Status", FormatStatus(part.Status));
            builder.CloseComponent();
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderTimelinePanel(bool full) => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", full ? "Timeline" : "Recent activity");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            var events = GetTimelineEvents().ToList();
            if (events.Count == 0)
            {
                content.OpenElement(3, "div");
                content.AddAttribute(4, "class", "project-muted-box compact");
                content.AddContent(5, "No timeline events yet.");
                content.CloseElement();
                return;
            }

            content.OpenElement(6, "div");
            content.AddAttribute(7, "class", full ? "project-timeline full" : "project-timeline");
            var sequence = 8;
            foreach (var item in events)
            {
                content.OpenElement(sequence++, "div");
                content.AddAttribute(sequence++, "class", item.Completed ? "project-timeline-item completed" : "project-timeline-item");
                content.OpenElement(sequence++, "span");
                content.AddAttribute(sequence++, "class", "project-timeline-dot");
                content.CloseElement();
                content.OpenElement(sequence++, "div");
                content.OpenElement(sequence++, "strong");
                content.AddContent(sequence++, item.Label);
                content.CloseElement();
                content.OpenElement(sequence++, "span");
                content.AddContent(sequence++, FormatDateTime(item.Timestamp));
                content.CloseElement();
                content.CloseElement();
                content.CloseElement();
            }
            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderNotes() => builder =>
    {
        builder.OpenComponent<PanelCard>(0);
        builder.AddAttribute(1, "Title", $"Internal notes ({_project?.Notes?.Count ?? 0})");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            var notes = _project?.Notes?.OrderByDescending(note => note.CreatedAt).ToList() ?? [];

            content.OpenElement(3, "div");
            content.AddAttribute(4, "class", "project-notes-grid");

            content.OpenElement(5, "section");
            content.AddAttribute(6, "class", "project-note-list-column");
            if (notes.Count == 0)
            {
                content.OpenElement(7, "div");
                content.AddAttribute(8, "class", "project-muted-box");
                content.AddContent(9, "No internal notes have been added.");
                content.CloseElement();
            }
            else
            {
                content.OpenElement(10, "div");
                content.AddAttribute(11, "class", "project-note-list");
                var sequence = 12;
                foreach (var note in notes)
                {
                    content.OpenElement(sequence++, "article");
                    content.AddAttribute(sequence++, "class", "project-note-card");
                    content.OpenElement(sequence++, "div");
                    content.AddAttribute(sequence++, "class", "project-note-audit");
                    content.OpenElement(sequence++, "strong");
                    content.AddContent(sequence++, $"Created by {FormatNoteActor(note)}");
                    content.CloseElement();
                    content.OpenElement(sequence++, "span");
                    content.AddContent(sequence++, FormatLocalDateTime(note.CreatedAt));
                    content.CloseElement();
                    content.CloseElement();
                    content.OpenElement(sequence++, "p");
                    content.AddContent(sequence++, note.Content);
                    content.CloseElement();
                    content.CloseElement();
                }
                content.CloseElement();
            }
            content.CloseElement();

            content.OpenElement(40, "aside");
            content.AddAttribute(41, "class", "project-note-compose-column");
            content.OpenElement(42, "div");
            content.AddAttribute(43, "class", "project-note-compose");
            content.OpenElement(44, "textarea");
            content.AddAttribute(45, "class", "project-note-input");
            content.AddAttribute(46, "placeholder", "Add an internal note for production, commercial follow-up, or customer context.");
            content.AddAttribute(47, "value", BindConverter.FormatValue(_newNoteContent));
            content.AddAttribute(48, "oninput", EventCallback.Factory.CreateBinder<string>(this, UpdateNoteDraft, _newNoteContent));
            content.CloseElement();
            content.OpenElement(49, "div");
            content.AddAttribute(50, "class", "project-note-compose-actions");
            content.OpenComponent<PrimaryButton>(51);
            content.AddAttribute(52, "Class", "project-note-add");
            content.AddAttribute(53, "Icon", Icons.Material.Outlined.Add);
            content.AddAttribute(54, "Disabled", _addingNote || string.IsNullOrWhiteSpace(_newNoteContent));
            content.AddAttribute(55, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, AddNoteAsync));
            content.AddContent(56, _addingNote ? "Saving..." : _noteSaved ? "Saved" : "Add note");
            content.CloseComponent();
            if (_noteSaved)
            {
                content.OpenElement(57, "span");
                content.AddAttribute(58, "class", "project-note-status");
                content.AddContent(59, "Saved");
                content.CloseElement();
            }
            content.CloseElement();
            content.CloseElement();
            content.CloseElement();

            content.CloseElement();
        }));
        builder.CloseComponent();
    };

    private string QuotationLabel => _project?.QuotationNumber
        ?? (_project?.QuotationId is null ? "Not generated" : _project.QuotationId.Value.ToString("N")[..8].ToUpperInvariant());

    private string ShippingSummary => FirstNonEmpty(
        _project?.ShippingAddressLine,
        _project?.ShippingRecipientName,
        _project?.BillingAddressLine) ?? "-";

    private bool IsActive(string tab) => string.Equals(_activeTab, tab, StringComparison.Ordinal);

    private void EditProject() => Navigation.NavigateTo($"/sales/projects/new?resume={Id}");

    private async Task DownloadQuoteAsync()
    {
        if (_project?.QuotationId is null)
            return;

        _pdfLoading = true;
        try
        {
            var response = await Http.PostAsync($"api/v1/quotations/{_project.QuotationId}/pdf", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to generate quotation PDF.", Severity.Error);
                return;
            }

            var url = await response.Content.ReadFromJsonAsync<string>();
            if (!string.IsNullOrWhiteSpace(url))
                await JS.InvokeVoidAsync("window.open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Quotation PDF error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _pdfLoading = false;
        }
    }

    private Task OpenAcceptQuoteConfirmation()
    {
        if (CanAcceptQuote)
            _acceptConfirmOpen = true;

        return Task.CompletedTask;
    }

    private Task OpenAcceptQuoteConfirmation(MouseEventArgs _) => OpenAcceptQuoteConfirmation();

    private Task CloseAcceptQuoteConfirmation()
    {
        _acceptConfirmOpen = false;
        return Task.CompletedTask;
    }

    private async Task ConfirmAcceptQuoteAsync()
    {
        if (!CanAcceptQuote)
            return;

        _accepting = true;
        try
        {
            var response = await Http.PostAsync($"api/v1/projects/{Id}/accept-quotation", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to accept quotation.", Severity.Error);
                return;
            }

            _quoteAccepted = true;
            _acceptConfirmOpen = false;
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Accept quote error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _accepting = false;
        }
    }

    private async Task AddNoteAsync(MouseEventArgs _)
    {
        var content = _newNoteContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
            return;

        _addingNote = true;
        _noteSaved = false;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/projects/{Id}/notes", new AddProjectNoteRequest { Content = content });
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Internal note could not be saved.", Severity.Error);
                return;
            }

            _newNoteContent = string.Empty;
            _noteSaved = true;
            _activeTab = "notes";
            await OnParametersSetAsync();
            _activeTab = "notes";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Internal note error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _addingNote = false;
        }
    }

    private void UpdateNoteDraft(string value)
    {
        _newNoteContent = value;
        _noteSaved = false;
    }

    private static void AddReadOnlyField(RenderTreeBuilder builder, int sequence, string label, string? value)
    {
        builder.OpenElement(sequence, "label");
        builder.AddAttribute(sequence + 1, "class", "project-field");
        builder.OpenElement(sequence + 2, "span");
        builder.AddContent(sequence + 3, label);
        builder.CloseElement();
        builder.OpenElement(sequence + 4, "input");
        builder.AddAttribute(sequence + 5, "class", "project-input");
        builder.AddAttribute(sequence + 6, "readonly", "readonly");
        builder.AddAttribute(sequence + 7, "value", string.IsNullOrWhiteSpace(value) ? "-" : value);
        builder.CloseElement();
        builder.CloseElement();
    }

    private void AddQuoteSnapshotContent(RenderTreeBuilder content, int sequence, string cssClass)
    {
        content.OpenElement(sequence, "dl");
        content.AddAttribute(sequence + 1, "class", cssClass);
        AddSnapshot(content, sequence + 2, "Project status", builder =>
        {
            builder.OpenComponent<StatusBadge>(sequence + 3);
            builder.AddAttribute(sequence + 4, "Status", FormatStatus(_project?.Status));
            builder.CloseComponent();
        });
        AddSnapshot(content, sequence + 6, "Quote #", QuotationLabel);
        AddSnapshot(content, sequence + 10, "Quote status", FormatStatus(_project?.QuotationStatus));
        AddSnapshot(content, sequence + 14, "Valid until", FormatDate(_project?.ValidUntil));
        AddSnapshot(content, sequence + 18, "Shipping", ShippingSummary);
        AddSnapshot(content, sequence + 22, "Subtotal", FormatMoney(PartsSubtotal));
        AddSnapshot(content, sequence + 26, "Discount", QuoteDiscount > 0m ? $"-{FormatMoney(QuoteDiscount)}" : FormatMoney(0m));
        AddSnapshot(content, sequence + 30, "Total", FormatMoney(_project?.TotalPrice ?? 0m));
        content.CloseElement();
    }

    private static void AddSnapshot(RenderTreeBuilder builder, int sequence, string label, string value)
    {
        AddSnapshot(builder, sequence, label, content => content.AddContent(sequence + 1, value));
    }

    private static void AddSnapshot(RenderTreeBuilder builder, int sequence, string label, RenderFragment value)
    {
        builder.OpenElement(sequence, "div");
        builder.OpenElement(sequence + 1, "dt");
        builder.AddContent(sequence + 2, label);
        builder.CloseElement();
        builder.OpenElement(sequence + 3, "dd");
        builder.AddContent(sequence + 4, value);
        builder.CloseElement();
        builder.CloseElement();
    }

    private static void AddCell(RenderTreeBuilder builder, ref int sequence, string value, string? @class = null)
    {
        builder.OpenElement(sequence++, "td");
        if (!string.IsNullOrWhiteSpace(@class))
            builder.AddAttribute(sequence++, "class", @class);
        builder.AddContent(sequence++, value);
        builder.CloseElement();
    }

    private static void AddCustomerDetail(RenderTreeBuilder builder, int sequence, string label, string? value)
    {
        builder.OpenElement(sequence, "div");
        builder.OpenElement(sequence + 1, "dt");
        builder.AddContent(sequence + 2, label);
        builder.CloseElement();
        builder.OpenElement(sequence + 3, "dd");
        builder.AddContent(sequence + 4, string.IsNullOrWhiteSpace(value) ? "-" : value);
        builder.CloseElement();
        builder.CloseElement();
    }

    private static void AddConfigurationCell(RenderTreeBuilder builder, ref int sequence, ProjectPartDto part)
    {
        var configuration = ResolvePartConfiguration(part);

        builder.OpenElement(sequence++, "td");
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "project-config-stack");

        if (configuration is null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "project-config-empty");
            builder.AddContent(sequence++, "-");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "strong");
            builder.AddAttribute(sequence++, "class", "project-config-primary");
            builder.AddContent(sequence++, configuration.Primary);
            builder.CloseElement();

            if (!string.IsNullOrWhiteSpace(configuration.Subtitle))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "project-config-subtitle");
                builder.AddContent(sequence++, configuration.Subtitle);
                builder.CloseElement();
            }
        }

        builder.CloseElement();
        builder.CloseElement();
    }

    private static void AddPartCell(RenderTreeBuilder builder, ref int sequence, ProjectPartDto part)
    {
        builder.OpenElement(sequence++, "td");
        builder.AddAttribute(sequence++, "class", "project-part-cell");
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "project-part-summary");

        if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
        {
            builder.OpenElement(sequence++, "img");
            builder.AddAttribute(sequence++, "class", "project-part-thumb");
            builder.AddAttribute(sequence++, "src", part.ThumbnailUrl);
            builder.AddAttribute(sequence++, "alt", $"{part.FileName} thumbnail");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "project-part-thumb placeholder");
            builder.OpenComponent<MudIcon>(sequence++);
            builder.AddAttribute(sequence++, "Icon", Icons.Material.Outlined.ViewInAr);
            builder.AddAttribute(sequence++, "Size", Size.Small);
            builder.CloseComponent();
            builder.CloseElement();
        }

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "project-part-meta");
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, part.FileName);
        builder.CloseElement();

        var dimensions = FormatDimensions(part.Dimensions);
        if (!string.IsNullOrWhiteSpace(dimensions))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, dimensions);
            builder.CloseElement();
        }

        AddAttachmentLinks(builder, ref sequence, "Drawings", part.DrawingFiles);
        AddAttachmentLinks(builder, ref sequence, "Documents", part.SupplementaryFiles);

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    }

    private static void AddAttachmentLinks(
        RenderTreeBuilder builder,
        ref int sequence,
        string label,
        IReadOnlyCollection<ProjectPartAttachmentDto> attachments)
    {
        if (attachments.Count == 0)
            return;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "project-part-attachments");
        builder.OpenElement(sequence++, "span");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        foreach (var attachment in attachments)
        {
            var href = string.IsNullOrWhiteSpace(attachment.SignedUrl) ? attachment.StoragePath : attachment.SignedUrl;
            if (string.IsNullOrWhiteSpace(href))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, attachment.FileName);
                builder.CloseElement();
                continue;
            }

            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", href);
            builder.AddAttribute(sequence++, "target", "_blank");
            builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
            builder.AddContent(sequence++, attachment.FileName);
            builder.CloseElement();
        }

        builder.CloseElement();
    }

