    private static bool IsAcceptableQuoteStatus(string? status) =>
        NormalizeStatus(status) is "quoted" or "quotationgenerated" or "quotationsent";

    private static string NormalizeStatus(string? status) =>
        string.IsNullOrWhiteSpace(status)
            ? string.Empty
            : status.Replace(" ", string.Empty, StringComparison.Ordinal).Replace("_", string.Empty, StringComparison.Ordinal).ToLowerInvariant();

