@page "/sales/projects/{Id:guid}"
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Project | Intranet Gateway</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                           Color="Color.Default"
                           OnClick="@(() => Navigation.NavigateTo("/sales/projects"))" />
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">@ProjectTitle</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">@ProjectSubtitle</MudText>
            </div>
        </MudStack>

        @if (_project is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_project.Status)">
                @_project.Status
            </MudChip>
        }
    </MudStack>

    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="96px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" />
    }
    else if (_project is null)
    {
        <MudAlert Severity="Severity.Error">Project not found.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2">Customer</MudText>
                        <MudText Typo="Typo.body1">@_project.CustomerName</MudText>
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Quotation</MudText>
                        <MudText Typo="Typo.body1">@QuotationLabel</MudText>
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Total</MudText>
                        <MudText Typo="Typo.h6">@CurrencyFormatter.Format(_project.TotalPrice, ProjectCurrency, 2)</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="pa-4 rounded-lg">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2">Parts</MudText>
                        <MudTable Items="@_project.Parts" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>File</MudTh>
                                <MudTh>Process</MudTh>
                                <MudTh>Material</MudTh>
                                <MudTh Style="text-align: right;">Qty</MudTh>
                                <MudTh Style="text-align: right;">Unit</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="File">@context.FileName</MudTd>
                                <MudTd DataLabel="Process">@(context.ProcessType ?? "-")</MudTd>
                                <MudTd DataLabel="Material">@(context.MaterialName ?? "-")</MudTd>
                                <MudTd DataLabel="Qty" Style="text-align: right;">@context.Quantity</MudTd>
                                <MudTd DataLabel="Unit" Style="text-align: right;">
                                    @CurrencyFormatter.Format(context.ConfirmedPrice ?? context.EstimatedPrice ?? 0, ProjectCurrency, 2)
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Color="Color.Default">No parts found.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDetailDto? _project;
    private bool _loading = true;

    private string ProjectTitle => _project is null
        ? "Project"
        : string.IsNullOrWhiteSpace(_project.ProjectNumber) ? _project.Title : _project.ProjectNumber;

    private string ProjectSubtitle => _project is null
        ? "Loading"
        : string.IsNullOrWhiteSpace(_project.Title) ? _project.CreatedAt.ToString("dd MMM yyyy") : _project.Title;

    private string ProjectCurrency => string.IsNullOrWhiteSpace(_project?.Currency) ? "THB" : _project.Currency;

    private string QuotationLabel => _project?.QuotationNumber
        ?? (_project?.QuotationId is null ? "Not generated" : _project.QuotationId.Value.ToString("N"));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _project = await Http.GetFromJsonAsync<ProjectDetailDto>($"api/v1/projects/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load project: {ex.Message}", Severity.Error);
            _project = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Configuring" => Color.Warning,
        "Priced" => Color.Info,
        "Quoted" => Color.Primary,
        "In Production" => Color.Default,
        "Completed" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
