    private async Task AcknowledgeDfmAsync(ProjectPartDto part)
    {
        if (!part.HasDfmWarnings || part.DfmAcknowledged || !_acknowledgingDfmPartIds.Add(part.Id))
            return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/projects/{Id}/parts/{part.Id}", BuildDfmAcknowledgeRequest(part));
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "DFM acknowledgement could not be saved." : error, Severity.Error);
                return;
            }

            part.DfmAcknowledged = true;
            Snackbar.Add("DFM warnings acknowledged.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DFM acknowledgement error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _acknowledgingDfmPartIds.Remove(part.Id);
