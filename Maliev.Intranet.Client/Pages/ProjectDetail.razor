    private async Task CreatePlanningHoldAsync(ProjectProductionPartPlanDto plan)
    {
        if (plan.Routing is null || !plan.CanCreateHold)
            return;

        await SavePlanningHoldAsync(plan, update: false);
    }

    private async Task UpdatePlanningHoldAsync(ProjectProductionPartPlanDto plan)
    {
        if (plan.Routing is null || plan.ActiveHold is null)
            return;

        await SavePlanningHoldAsync(plan, update: true);
    }

    private async Task SavePlanningHoldAsync(ProjectProductionPartPlanDto plan, bool update)
    {
        _holdSavingPartIds.Add(plan.PartId);
        try
        {
            var createRequest = BuildPlanningHoldRequest(plan);
            HttpResponseMessage response;
            if (update && plan.ActiveHold is not null)
            {
                var updateRequest = new UpdateProductionPlanningHoldRequest
                {
                    MachineId = createRequest.MachineId,
                    MachineName = createRequest.MachineName,
                    QueuePosition = createRequest.QueuePosition,
                    ScheduledStartTime = createRequest.ScheduledStartTime,
                    ScheduledEndTime = createRequest.ScheduledEndTime,
                    SetupTimeMinutes = createRequest.SetupTimeMinutes,
                    ProductionTimeMinutes = createRequest.ProductionTimeMinutes,
                    Notes = createRequest.Notes,
                    ExpiresAt = createRequest.ExpiresAt
                };
                response = await Http.PatchAsJsonAsync($"api/v1/projects/{Id}/planning-holds/{plan.ActiveHold.Id}", updateRequest);
            }
            else
            {
                response = await Http.PostAsJsonAsync($"api/v1/projects/{Id}/parts/{plan.PartId}/planning-hold", createRequest);
            }

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Planning hold could not be saved." : error, Severity.Error);
                return;
            }

            Snackbar.Add(update ? "Planning hold updated." : "Planning hold created.", Severity.Success);
            await LoadProductionPlanAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Planning hold error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _holdSavingPartIds.Remove(plan.PartId);
        }
    }

    private async Task CancelPlanningHoldAsync(ProjectProductionPartPlanDto plan)
    {
        if (plan.ActiveHold is null)
            return;

        _holdSavingPartIds.Add(plan.PartId);
        try
        {
            var response = await Http.DeleteAsync($"api/v1/projects/{Id}/planning-holds/{plan.ActiveHold.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Planning hold could not be cancelled.", Severity.Error);
                return;
            }

            Snackbar.Add("Planning hold cancelled.", Severity.Success);
            await LoadProductionPlanAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Planning hold error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _holdSavingPartIds.Remove(plan.PartId);
        }
    }

    private CreateProductionPlanningHoldRequest BuildPlanningHoldRequest(ProjectProductionPartPlanDto plan)
    {
        var routing = plan.Routing!;
        var start = routing.ProposedSlotStart?.UtcDateTime
            ?? routing.EstimatedStartDate.UtcDateTime;
        if (start <= DateTime.UtcNow)
            start = DateTime.UtcNow.AddHours(1);

        var setupMinutes = DefaultSetupMinutes(plan.ProcessType);
        var productionMinutes = Math.Max(30, plan.Quantity * 30);
        return new CreateProductionPlanningHoldRequest
        {
            ProjectId = Id,
            ProjectPartId = plan.PartId,
            Technology = plan.ProcessType ?? string.Empty,
            MachineId = FirstNonEmpty(routing.MachineCode, routing.MachineId == Guid.Empty ? null : routing.MachineId.ToString()),
            MachineName = routing.MachineName,
            QueuePosition = 0,
            ScheduledStartTime = start,
            ScheduledEndTime = routing.ProposedSlotEnd?.UtcDateTime ?? start.AddMinutes(setupMinutes + productionMinutes),
            SetupTimeMinutes = setupMinutes,
            ProductionTimeMinutes = productionMinutes,
            Quantity = Math.Max(1, plan.Quantity),
            Notes = $"Planned from project {ProjectTitle} / {plan.FileName}",
            ExpiresAt = ResolveClientHoldExpiration()
        };
    }

