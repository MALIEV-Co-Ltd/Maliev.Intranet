    };

    private DateTime ResolveClientHoldExpiration()
    {
        var expires = DateTime.UtcNow.AddHours(72);
        if (_project?.ValidUntil is DateTime validUntil)
        {
            var quoteExpiry = ToUtc(validUntil);
            if (quoteExpiry > DateTime.UtcNow && quoteExpiry < expires)
                expires = quoteExpiry;
        }

        return expires;
    }

