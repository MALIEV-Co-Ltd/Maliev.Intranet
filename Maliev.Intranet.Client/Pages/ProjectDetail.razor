@page "/sales/projects/{Id:guid}"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers

<PageTitle>@(_project?.Title ?? "Project") | Intranet Gateway</PageTitle>

<style>
    .part-card { border: 1px solid var(--mud-palette-lines-default); border-radius: 10px; transition: box-shadow 0.15s ease; }
    .part-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
    .breakdown-row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .breakdown-row:last-child { border-bottom: none; font-weight: 600; }
    .timeline-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .timeline-dot.done { background: var(--mud-palette-success); }
    .timeline-dot.pending { background: var(--mud-palette-lines-default); }
    .progress-bar-wrap { height: 6px; border-radius: 3px; background: var(--mud-palette-lines-default); overflow: hidden; }
    .progress-bar-fill { height: 100%; border-radius: 3px; background: var(--mud-palette-primary); transition: width 0.4s ease; }
</style>

@if (_loading)
{
    <MudGrid>
        <MudItem xs="12"><MudSkeleton Height="60px" Class="rounded-lg" /></MudItem>
        <MudItem xs="12" md="8"><MudSkeleton Height="400px" Class="rounded-lg" /></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="400px" Class="rounded-lg" /></MudItem>
    </MudGrid>
}
else if (_project == null)
{
    <MudAlert Severity="Severity.Error">Project not found or you do not have access.</MudAlert>
    <MudButton Class="mt-3" OnClick="@(() => Navigation.NavigateTo("/sales/projects"))">Back to Projects</MudButton>
}
else
{
    @* ── Page Header ───────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
        <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("/sales/projects"))" />
        <div style="flex: 1;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h5" Style="font-weight: 700;">@_project.ProjectNumber</MudText>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_project.Status)">@_project.Status</MudChip>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Default">
                @_project.Title &nbsp;·&nbsp; @_project.CustomerName
            </MudText>
        </div>
    </MudStack>

    <MudGrid Spacing="3">

        @* ── LEFT 8 cols: Parts ──────────────────────────────────────── *@
        <MudItem xs="12" md="8">

            @* Parts list *@
            @if (!_project.Parts.Any())
            {
                <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center rounded-lg"
                          Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Style="font-size: 56px;" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Color="Color.Default" Class="mt-2">No parts yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">Upload 3D files to add parts to this project.</MudText>
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var part in _project.Parts)
                    {
                        <MudPaper Elevation="0" Class="pa-4 part-card">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                @if (!string.IsNullOrEmpty(part.ModelPreviewUrl))
                                {
                                    <img src="@part.ModelPreviewUrl"
                                         alt="@part.FileName"
                                         style="width:40px;height:40px;object-fit:cover;border-radius:6px;flex-shrink:0;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Color="Color.Primary" />
                                }
                                <MudText Typo="Typo.subtitle2" Style="flex: 1; font-weight: 600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@part.FileName</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetPartStatusColor(part.Status)">@part.Status</MudChip>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeletePartAsync(part.Id))"
                                               Disabled="@IsProjectLocked()" />
                            </MudStack>

                            @* Dimensions *@
                            @if (part.Dimensions != null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-2">
                                    @part.Dimensions.X.ToString("N1") × @part.Dimensions.Y.ToString("N1") × @part.Dimensions.Z.ToString("N1") mm
                                </MudText>
                            }

                            @* Configuration grid *@
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string"
                                               @bind-Value="part.ProcessType"
                                               Label="Process"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true">
                                        <MudSelectItem Value="@("FDM")">FDM</MudSelectItem>
                                        <MudSelectItem Value="@("SLA")">SLA</MudSelectItem>
                                        <MudSelectItem Value="@("SLS")">SLS</MudSelectItem>
                                        <MudSelectItem Value="@("CNC")">CNC Machining</MudSelectItem>
                                        <MudSelectItem Value="@("MJF")">MJF</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="part.Finish"
                                                  Label="Finish"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int"
                                                     @bind-Value="part.Quantity"
                                                     Label="Qty"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Min="1" />
                                </MudItem>
                            </MudGrid>

                            @* Save config + pricing buttons *@
                            <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Outlined.Save"
                                           OnClick="@(() => SavePartConfigAsync(part))">
                                    Save Config
                                </MudButton>

                                @if (part.Status == "Configuring" || part.EstimatedPrice == null)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Outlined.AutoAwesome"
                                               OnClick="@(() => GetAiPriceAsync(part))">
                                        Get AI Price
                                    </MudButton>
                                }

                                @if (part.EstimatedPrice.HasValue && part.Status == "Priced")
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Outlined.CheckCircle"
                                               OnClick="@(() => ConfirmPriceAsync(part, part.EstimatedPrice!.Value))">
                                        Confirm @CurrencyFormatter.Format(part.EstimatedPrice.Value, "THB", 2)
                                    </MudButton>
                                }
                            </MudStack>

                            @* Price breakdown *@
                            @if (part.PriceBreakdown != null)
                            {
                                <MudExpansionPanels Elevation="0" Class="mt-3">
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <MudText Typo="Typo.caption" Color="Color.Default">
                                                <MudIcon Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                                Price Breakdown
                                            </MudText>
                                        </TitleContent>
                                        <ChildContent>
                                            <div class="mt-2" style="font-size: var(--mud-typography-default-size);">
                                                <div class="breakdown-row"><span>Material cost</span><span>@CurrencyFormatter.Format(part.PriceBreakdown.MaterialCost, "THB", 2)</span></div>
                                                <div class="breakdown-row"><span>Machine time (@part.PriceBreakdown.MachineTimeMinutes.ToString("N0") min)</span><span>@CurrencyFormatter.Format(part.PriceBreakdown.MachineTimeCost, "THB", 2)</span></div>
                                                <div class="breakdown-row"><span>Setup / operator</span><span>@CurrencyFormatter.Format(part.PriceBreakdown.SetupCost, "THB", 2)</span></div>
                                                <div class="breakdown-row"><span>Complexity</span><span>@CurrencyFormatter.Format(part.PriceBreakdown.ComplexitySurcharge, "THB", 2)</span></div>
                                                <div class="breakdown-row"><span>Margin</span><span>@CurrencyFormatter.Format(part.PriceBreakdown.MarginAmount, "THB", 2)</span></div>
                                                <div class="breakdown-row"><span><strong>Total per unit</strong></span><span><strong>@CurrencyFormatter.Format(part.PriceBreakdown.TotalPerUnit, "THB", 2)</strong></span></div>
                                            </div>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }

                            @* Production progress (WP-UIX-4.7) *@
                            @if (part.JobId.HasValue)
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing" Size="Size.Small" Color="Color.Default" />
                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                        @part.MachineName &middot; @part.JobStatus
                                    </MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.caption">@(part.JobProgressPercent ?? 0)%</MudText>
                                </MudStack>
                                <div class="progress-bar-wrap mt-1">
                                    <div class="progress-bar-fill" style="width: @(part.JobProgressPercent ?? 0)%;"></div>
                                </div>
                            }
                        </MudPaper>
                    }
                </MudStack>
            }

            @* Notes section *@
            <MudPaper Elevation="0" Class="pa-4 mt-3 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Internal Notes</MudText>
                <MudTextField @bind-Value="_notes"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Placeholder="Add internal notes about this project..." />
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                           OnClick="SaveNotesAsync">Save Notes</MudButton>
            </MudPaper>
        </MudItem>

        @* ── RIGHT 4 cols: Summary + Actions + Timeline ──────────────── *@
        <MudItem xs="12" md="4">
            <MudStack Spacing="3">

                @* Project Summary card *@
                <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight: 600;">Summary</MudText>
                    <MudStack Spacing="1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Default">Parts</MudText>
                            <MudText Typo="Typo.body2">@_project.Parts.Count</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Default">All Confirmed</MudText>
                            <MudText Typo="Typo.body2" Color="@(AllPartsConfirmed ? Color.Success : Color.Warning)">
                                @(AllPartsConfirmed ? "Yes" : "No")
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Default">Total Price</MudText>
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                @CurrencyFormatter.Format(TotalConfirmedPrice, "THB", 2)
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Color="Color.Default">Currency</MudText>
                            <MudText Typo="Typo.body2">@_project.Currency</MudText>
                        </MudStack>
                        @if (_project.ValidUntil.HasValue)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Default">Valid Until</MudText>
                                <MudText Typo="Typo.body2">@_project.ValidUntil.Value.ToString("dd MMM yyyy")</MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

                @* Actions card *@
                <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight: 600;">Actions</MudText>
                    <MudStack Spacing="2">
                        @if (_project.Status is "Configuring" or "Priced")
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Outlined.RequestQuote"
                                       Disabled="@(!AllPartsConfirmed || _actioning)"
                                       OnClick="GenerateQuotationAsync">
                                Generate Quotation
                            </MudButton>
                            @if (!AllPartsConfirmed)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="text-center">
                                    Confirm all part prices first
                                </MudText>
                            }
                        }
                        @if (_project.QuotationId.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Outlined.OpenInNew"
                                       OnClick="@(() => Navigation.NavigateTo($"/sales/quotations/{_project.QuotationId}"))">
                                View Quotation
                            </MudButton>
                        }
                        @if (_project.Status == "Quoted")
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Outlined.ThumbUp"
                                       Disabled="@_actioning"
                                       OnClick="AcceptQuotationAsync">
                                Mark as Accepted
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>

                @* Customer info card *@
                <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Customer</MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew"
                                       Size="Size.Small"
                                       OnClick="@(() => Navigation.NavigateTo($"/sales/customers/{_project.CustomerId}"))" />
                    </MudStack>
                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@_project.CustomerName</MudText>
                    @if (_customer != null)
                    {
                        @if (!string.IsNullOrEmpty(_customer.Email))
                        {
                            <MudLink Href="@($"mailto:{_customer.Email}")" Underline="Underline.None" Color="Color.Default" Class="d-flex align-items-center gap-1 mt-1" Style="font-size: 0.8rem;">
                                <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" />
                                @_customer.Email
                            </MudLink>
                        }
                        @if (!string.IsNullOrEmpty(_customer.Mobile))
                        {
                            <MudLink Href="@($"tel:{_customer.Mobile}")" Underline="Underline.None" Color="Color.Default" Class="d-flex align-items-center gap-1 mt-1" Style="font-size: 0.8rem;">
                                <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" />
                                @_customer.Mobile @if (!string.IsNullOrEmpty(_customer.Extension)) { <text>ext. @_customer.Extension</text> }
                            </MudLink>
                        }
                        @if (!string.IsNullOrEmpty(_customer.CompanyName))
                        {
                            <MudLink Href="@($"tel:{_customer.CompanyPhone}")" Underline="Underline.None" Color="Color.Default" Class="d-flex align-items-center gap-1 mt-1" Style="font-size: 0.8rem;">
                                <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" />
                                @_customer.CompanyName @if (!string.IsNullOrEmpty(_customer.CompanyPhone)) { <text>· @_customer.CompanyPhone</text> }
                            </MudLink>
                        }
                        @if (!string.IsNullOrEmpty(_customer.Landline))
                        {
                            <MudLink Href="@($"tel:{_customer.Landline}")" Underline="Underline.None" Color="Color.Default" Class="d-flex align-items-center gap-1 mt-1" Style="font-size: 0.8rem;">
                                <MudIcon Icon="@Icons.Material.Outlined.PhoneCallback" Size="Size.Small" />
                                @_customer.Landline
                            </MudLink>
                        }
                    }
                </MudPaper>

                @* Status timeline card *@
                @if (_project.Timeline.Any())
                {
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-3">Timeline</MudText>
                        @foreach (var evt in _project.Timeline)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                <div class="timeline-dot @(evt.Completed ? "done" : "pending")"></div>
                                <MudIcon Icon="@evt.Icon" Size="Size.Small"
                                         Color="@(evt.Completed ? Color.Success : Color.Default)" />
                                <div>
                                    <MudText Typo="Typo.caption" Style="@(evt.Completed ? "" : "opacity: 0.5;")">@evt.Label</MudText>
                                    @if (evt.Completed)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Default">@evt.Timestamp.ToString("dd MMM yyyy")</MudText>
                                    }
                                </div>
                            </MudStack>
                        }
                    </MudPaper>
                }

                @* Aggregate production progress (WP-UIX-4.7) *@
                @if (_project.Parts.Any(p => p.JobId.HasValue))
                {
                    var avgProgress = (int)_project.Parts
                        .Where(p => p.JobProgressPercent.HasValue)
                        .Select(p => (double)p.JobProgressPercent!.Value)
                        .DefaultIfEmpty(0)
                        .Average();
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-2">Production Progress</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <div class="progress-bar-wrap" style="flex: 1;">
                                <div class="progress-bar-fill" style="width: @avgProgress%;"></div>
                            </div>
                            <MudText Typo="Typo.caption">@avgProgress%</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-1">
                            Average across @_project.Parts.Count(p => p.JobId.HasValue) part(s) in production
                        </MudText>
                    </MudPaper>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}



