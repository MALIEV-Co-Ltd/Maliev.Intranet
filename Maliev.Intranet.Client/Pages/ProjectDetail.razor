    private static List<DfmIssueSummary> ResolveDfmIssueSummary(ProjectPartDto part, DfmDisplayStatus status)
    {
        if (!part.HasDfmWarnings)
        {
            return
            [
                new("Status", status.Label),
                new("Result", status.Subtext)
            ];
        }

        var items = new List<DfmIssueSummary>
        {
            new("Status", status.Label),
            new("Action", part.DfmAcknowledged ? "Warnings reviewed and acknowledged." : "Review and acknowledge before quote acceptance.")
        };

        var issueCategories = part.OverlayPaths.Keys
            .Where(key => !string.Equals(key, "preview", StringComparison.OrdinalIgnoreCase))
            .Select(HumanizeToken)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (issueCategories.Count > 0)
        {
            items.Add(new("Detected checks", string.Join(", ", issueCategories)));
        }

        if (part.IsManifold == false)
        {
            items.Add(new("Geometry", "Non-manifold geometry reported."));
        }

        if (part.BodyCount > 1 && part.SelectedBodyIndex is null)
        {
            items.Add(new("Body selection", $"{part.BodyCount} bodies detected; select the manufacturing body before release."));
        }

        if (items.Count == 2)
        {
            items.Add(new("Detected warnings", "Review the process-specific DFM checks for this part."));
        }

        return items;
    }

    private static DfmDisplayStatus ResolveDfmStatus(ProjectPartDto part)
    {
        if (!part.HasDfmWarnings)
            return new("DFM passed", "No reported issues", "dfm-ok");

        return part.DfmAcknowledged
            ? new("DFM acknowledged", "Warnings reviewed", "dfm-ack")
            : new("DFM warnings", "Requires acknowledgement", "dfm-warning");
    }

