        part.ConfirmedPrice ?? part.ConfirmedUnitPrice ?? part.EstimatedPrice ?? part.AiSuggestedPrice ?? 0m;

    private static decimal GetPartLineTotal(ProjectPartDto part) => GetPartUnitPrice(part) * Math.Max(part.Quantity, 0);

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("MMM d, yyyy") : "-";

    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToString("MMM d, yyyy HH:mm") : "-";

    private static string FormatLocalDateTime(DateTime? value)
    {
        if (!value.HasValue)
            return "-";

        var utcValue = value.Value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)
            : value.Value.ToUniversalTime();

        return utcValue.ToLocalTime().ToString("MMM d, yyyy HH:mm");
    }

    private static DateTime ToUtc(DateTime value)
    {
        return value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value, DateTimeKind.Utc)
            : value.ToUniversalTime();
    }

    private string ResolveQuoteLeadTime()
    {
        var currentVersion = _quotation?.Versions?
            .OrderByDescending(version => version.VersionNumber == _quotation.CurrentVersionNumber)
            .ThenByDescending(version => version.VersionNumber)
            .FirstOrDefault();

        return FirstNonEmpty(_quotation?.DeliveryExpectations, currentVersion?.DeliveryExpectations, "Not specified");
    }

    private static int DefaultSetupMinutes(string? processType)
    {
        var normalized = processType?.Trim().ToUpperInvariant() ?? string.Empty;
        if (normalized.StartsWith("CNC", StringComparison.OrdinalIgnoreCase))
            return 60;

        return normalized is "SLA" or "SLA_DLP" ? 30 : 15;
    }

    private static string FormatScheduleWindow(DateTime? start, DateTime? end)
    {
        if (!start.HasValue)
            return "Slot not estimated";

        return end.HasValue
            ? $"{start.Value:MMM d HH:mm} - {end.Value:HH:mm}"
            : $"{start.Value:MMM d HH:mm}";
    }

    private static string FormatNoteActor(ProjectNoteDto note)
    {
        var actor = FirstNonEmpty(note.AuthorName, note.AuthorId, "System");
        return actor;
    }

    private static string FormatStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "-";

        return NormalizeStatus(status) switch
        {
            "quotationgenerated" => "Quotation Generated",
            "quotationsent" => "Quotation Sent",
            "quotationaccepted" => "Quotation Accepted",
            "quoted" => "Quoted",
            "configuring" => "Configuring",
            "confirmed" => "Confirmed",
            "generated" => "Generated",
            "accepted" => "Accepted",
            _ => HumanizeToken(status)
        };
    }

    private static string FormatProcess(string? process)
    {
        if (string.IsNullOrWhiteSpace(process))
            return "-";

        var normalized = process.Trim()
            .Replace("-", "_", StringComparison.Ordinal)
            .Replace(" ", "_", StringComparison.Ordinal)
            .ToUpperInvariant();

        return normalized switch
        {
            "FDM" => "3D Printing (FDM)",
            "SLA" or "DLP" or "SLA_DLP" => "Resin Printing (SLA/DLP)",
            "SLS" => "Powder Bed Fusion (SLS)",
            "MJF" => "Multi Jet Fusion (MJF)",
            "CNC" or "CNC_MILL" or "CNC_MILLING" => "CNC Milling",
            "CNC_TURN" or "CNC_TURNING" => "CNC Turning",
            "CNC_5AXIS" or "CNC_5_AXIS" => "5-Axis CNC Machining",
            "SHEET_METAL" => "Sheet Metal",
            "INJECTION" or "INJECTION_MOLDING" => "Injection Molding",
            _ => HumanizeToken(process)
        };
    }

    private static PartConfigurationDisplay? ResolvePartConfiguration(ProjectPartDto part)
    {
        var values = new[] { part.Finish, ResolveMaterialColor(part.Color) is null ? part.Color : null, part.Tolerance }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(FormatConfigValue)
            .Where(value => !string.IsNullOrWhiteSpace(value) && !string.Equals(value, "-", StringComparison.Ordinal));
        var formattedValues = values.ToArray();

        return formattedValues.Length switch
        {
            0 => null,
            1 => new PartConfigurationDisplay(formattedValues[0], null),
            _ => new PartConfigurationDisplay(formattedValues[0], string.Join(" ", formattedValues[1..]))
        };
    }

    private static string FormatConfigValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        var tolerance = FormatIsoTolerance(value);
        if (!string.IsNullOrWhiteSpace(tolerance))
            return tolerance;

        var normalized = value.Trim()
            .Replace("-", "_", StringComparison.Ordinal)
            .Replace(" ", "_", StringComparison.Ordinal)
            .ToUpperInvariant();

        return normalized switch
        {
            "AS_PRINTED" => "As printed",
            "FDM_STD" => "Standard FDM settings",
            "STANDARD" => "Standard",
            "NONE" => "None",
            _ => HumanizeToken(value)
        };
    }

    private static string? FormatIsoTolerance(string value)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            value.Trim(),
            @"^ISO[\s_-]*2768\s*[-_ ]?\s*([A-Za-z]{1,2})$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
        if (!match.Success)
            return null;

        var toleranceClass = match.Groups[1].Value;
        var formattedClass = toleranceClass.Length == 1
            ? toleranceClass.ToLowerInvariant()
            : $"{char.ToLowerInvariant(toleranceClass[0])}{toleranceClass[1..].ToUpperInvariant()}";

        return $"ISO 2768-{formattedClass}";
    }

    private sealed record PartConfigurationDisplay(string Primary, string? Subtitle);

    private static MaterialColorDisplay? ResolveMaterialColor(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        if (TryNormalizeHexColor(trimmed, out var hexColor))
            return new(trimmed.StartsWith("#", StringComparison.Ordinal) ? trimmed.ToUpperInvariant() : $"#{trimmed.ToUpperInvariant()}", hexColor);

        var normalized = trimmed
            .Replace("-", "_", StringComparison.Ordinal)
            .Replace(" ", "_", StringComparison.Ordinal)
            .ToUpperInvariant();

        if (normalized.StartsWith("RAL_", StringComparison.Ordinal) || normalized.StartsWith("RAL", StringComparison.Ordinal))
            return new(trimmed.ToUpperInvariant(), "#111827");

        return normalized switch
        {
            "BLACK" => new("Black", "#111827"),
            "WHITE" => new("White", "#f8fafc"),
            "NATURAL" => new("Natural", "#e7dcc7"),
            "CLEAR" or "TRANSPARENT" => new(HumanizeToken(trimmed), "#dbeafe"),
            "GRAY" or "GREY" => new(HumanizeToken(trimmed), "#94a3b8"),
            "LIGHT_GRAY" or "LIGHT_GREY" => new(HumanizeToken(trimmed), "#cbd5e1"),
            "DARK_GRAY" or "DARK_GREY" => new(HumanizeToken(trimmed), "#475569"),
            "RED" => new("Red", "#dc2626"),
            "BLUE" => new("Blue", "#2563eb"),
            "GREEN" => new("Green", "#16a34a"),
            "YELLOW" => new("Yellow", "#facc15"),
            "ORANGE" => new("Orange", "#f97316"),
            "PURPLE" or "VIOLET" => new(HumanizeToken(trimmed), "#7c3aed"),
            "BROWN" => new("Brown", "#92400e"),
            "SILVER" => new("Silver", "#cbd5e1"),
            "GOLD" => new("Gold", "#d97706"),
            _ => null
        };
    }

    private static bool TryNormalizeHexColor(string value, out string hexColor)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            value.Trim(),
            "^#?(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
            System.Text.RegularExpressions.RegexOptions.CultureInvariant);
        if (!match.Success)
        {
            hexColor = string.Empty;
            return false;
        }

        var digits = value.TrimStart('#');
        if (digits.Length == 3)
        {
            digits = string.Concat(digits.Select(character => $"{character}{character}"));
        }

        hexColor = $"#{digits.ToUpperInvariant()}";
        return true;
    }

    private sealed record MaterialColorDisplay(string Label, string Swatch);

    private static string HumanizeToken(string value)
    {
        var spaced = value.Trim()
            .Replace("_", " ", StringComparison.Ordinal)
            .Replace("-", " ", StringComparison.Ordinal);
        spaced = System.Text.RegularExpressions.Regex.Replace(spaced, "([a-z])([A-Z])", "$1 $2");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(spaced.ToLowerInvariant());
    }

    private static string FormatDimensions(ModelDimensionsDto? dimensions)
    {
        if (dimensions is null)
            return string.Empty;

        return $"{dimensions.X:0.#} x {dimensions.Y:0.#} x {dimensions.Z:0.#} mm";
    }

    private IEnumerable<ProjectTimelineEventDto> GetTimelineEvents()
    {
        var events = _project?.Timeline ?? [];
        var notes = _project?.Notes ?? [];

        return events
            .Concat(notes.Select(note => new ProjectTimelineEventDto
            {
                Label = $"Internal note added by {FirstNonEmpty(note.AuthorName, "System")}",
                Timestamp = note.CreatedAt,
                Completed = true
            }))
            .OrderByDescending(item => item.Timestamp);
    }

    private static string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
}
