@page "/finance/receipts"
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Receipts - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Payment Receipts</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search receipts..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Create Receipt
        </MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <div class="pa-4">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
        }
    </div>
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="ReceiptDto" Items="@FilteredReceipts" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.ReceiptNumber" Title="Receipt #" />
                <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" />
                <PropertyColumn Property="x => x.PaymentMethod" Title="Method" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Date" Title="Date" Format="dd MMM yyyy" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Color="Color.Error" OnClick="@(() => DownloadPdf(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Color="Color.Default" OnClick="@(() => PrintReceipt(context.Item))" />
                            @if (context.Item.Status != "Voided")
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Error" OnClick="@(() => VoidReceipt(context.Item))" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Secondary">No receipts found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<ReceiptDto> _receipts = new();

    private IEnumerable<ReceiptDto> FilteredReceipts => string.IsNullOrEmpty(_searchString)
        ? _receipts
        : _receipts.Where(r => r.ReceiptNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || r.CustomerName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || (r.InvoiceNumber?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadReceipts();
    }

    private async Task LoadReceipts()
    {
        try
        {
            _isLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<ReceiptDto>>("api/receipts");
            _receipts = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading receipts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<CreateReceiptDialog>("Create Receipt", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadReceipts();
            Snackbar.Add("Receipt created successfully", Severity.Success);
        }
    }

    private async Task VoidReceipt(ReceiptDto receipt)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Void Receipt",
            $"Are you sure you want to void receipt {receipt.ReceiptNumber}? This cannot be undone.",
            yesText: "Void", noText: "Cancel");
        if (confirm != true) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/receipts/{receipt.Id}/void", new { Reason = "Manual void" });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Receipt {receipt.ReceiptNumber} voided", Severity.Success);
                await LoadReceipts();
            }
            else
            {
                Snackbar.Add("Failed to void receipt", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void DownloadPdf(ReceiptDto receipt)
    {
        Snackbar.Add($"Preparing PDF for receipt {receipt.ReceiptNumber}...", Severity.Info);
    }

    private void PrintReceipt(ReceiptDto receipt)
    {
        Snackbar.Add($"Printing receipt {receipt.ReceiptNumber}...", Severity.Info);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Voided" => Color.Error,
        _ => Color.Default
    };
}
