@page "/finance/receipts"
@inject NavigationManager Navigation

@code {
    /// <summary>
    /// Redirects legacy /finance/receipts URL to the consolidated Payments &amp; Receipts page on the Receipts tab.
    /// </summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/finance/payments?tab=receipts", replace: true);
    }
}
