@page "/commerce/catalog"
@attribute [RequirePermission(MalievPermissions.Commerce.ProductsRead)]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Commerce Catalog | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Commerce Catalog"
                Subtitle="Employee-managed storefront products, collections, variants, and media"
                BackHref="/" />

    <PageBody>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Starter draft listings for the 30g and 50g pneumatic injection molding machines are seeded by CommerceService. Use this page to review, complete, and publish product listings.
        </MudAlert>

        <StatBar Class="mb-4">
            <StatTile Label="Products" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="Collections" Value="@_collections.Count.ToString("N0")" />
            <StatTile Label="Published" Value="@_products.Count(IsPublished).ToString("N0")" />
            <StatTile Label="Drafts" Value="@_products.Count(IsDraft).ToString("N0")" />
        </StatBar>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <PanelCard Class="mb-4">
                    <div class="catalog-product-toolbar mb-4">
                        <MudTextField @bind-Value="_query"
                                      Label="Search products"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      DebounceInterval="300"
                                      OnDebounceIntervalElapsed="LoadProductsAfterSearch"
                                      Class="catalog-product-search" />
                        <MudSelect T="string" @bind-Value="_collectionFilter" Label="Collection" Variant="Variant.Outlined" Margin="Margin.Dense" Class="catalog-product-filter">
                            <MudSelectItem Value="@string.Empty">All collections</MudSelectItem>
                            @foreach (var collection in _collections)
                            {
                                <MudSelectItem Value="@collection.Handle">@collection.Title</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadProductsAsync" Disabled="@_loadingProducts">Apply</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="StartNewProduct">New listing</MudButton>
                    </div>

                    @if (_loadingProducts)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
                        <div class="mlv-empty">Loading commerce products...</div>
                    }
                    else if (_products.Count == 0)
                    {
                        <div class="mlv-empty">No Commerce products found.</div>
                    }
                    else
                    {
                        <table class="mlv-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Price</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in _products)
                                {
                                    <tr class="catalog-product-row" @onclick="@(() => OpenProduct(product))">
                                        <td>
                                            <div class="d-flex align-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(product.ThumbnailUrl))
                                                {
                                                    <MudImage Src="@product.ThumbnailUrl" Alt="@product.Title" ObjectFit="ObjectFit.Cover" Width="56" Height="42" Class="rounded" />
                                                }
                                                else
                                                {
                                                    <div class="mlv-thumb-placeholder">IMG</div>
                                                }
                                                <div>
                                                    <div class="fw-semibold">@product.Title</div>
                                                    <div class="text-muted small">@product.Handle</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@product.ProductType</td>
                                        <td><StatusBadge Status="@product.Status" /></td>
                                        <td class="mlv-mono">@product.StartingPrice.ToString("N2") @product.Currency</td>
                                        <td>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Outlined.ArrowForward">
                                                Manage
                                            </MudButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <PaginationFooter Meta="@_meta"
                                      CurrentPage="@_page"
                                      PageSize="@_pageSize"
                                      PageChanged="OnPageChanged"
                                      PageSizeChanged="OnPageSizeChanged"
                                      Disabled="@_loadingProducts" />
                </PanelCard>

            </MudItem>

            <MudItem xs="12" lg="4">
                <PanelCard>
                    <MudText Typo="Typo.h6" Class="mb-3">Collections</MudText>
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_collectionForm.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_collectionForm.Handle" Label="Handle" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_collectionForm.Description" Label="Description" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudSwitch @bind-Value="_collectionForm.IsPublished" Color="Color.Primary" Label="Published" />
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveCollectionAsync">Save collection</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="StartNewCollection">New</MudButton>
                        </div>
                    </MudStack>

                    <MudDivider Class="my-4" />
                    @foreach (var collection in _collections)
                    {
                        <div class="d-flex align-center justify-space-between gap-2 py-2 border-bottom">
                            <button type="button" class="mlv-link-button" @onclick="@(() => SelectCollection(collection))">
                                <span class="fw-semibold">@collection.Title</span>
                                <span class="text-muted small">@collection.Handle</span>
                            </button>
                            <StatusBadge Status="@(collection.IsPublished ? "Published" : "Draft")" />
                        </div>
                    }
                </PanelCard>
            </MudItem>
        </MudGrid>
    </PageBody>
</div>

@code {
    private readonly List<CommerceProductSummaryDto> _products = [];
    private readonly List<CommerceCollectionDto> _collections = [];
    private PaginationMeta _meta = new();
    private CommerceCollectionMutationRequest _collectionForm = new();
    private Guid? _editingCollectionId;
    private string? _query;
    private string _collectionFilter = string.Empty;
    private bool _loadingProducts = true;
    private int _page = 1;
    private int _pageSize = 24;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionsAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAfterSearch(string _)
    {
        _page = 1;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loadingProducts = true;
        try
        {
            var url = $"api/v1/commerce/products?query={Uri.EscapeDataString(_query ?? string.Empty)}&collection={Uri.EscapeDataString(_collectionFilter)}&page={_page}&pageSize={_pageSize}";
            var response = await Http.GetFromJsonAsync<PagedResponse<CommerceProductSummaryDto>>(url);
            _products.Clear();
            _products.AddRange(response?.Data ?? []);
            _meta = response?.Meta ?? new PaginationMeta();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load Commerce products: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingProducts = false;
        }
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<CommerceCollectionDto>>("api/v1/commerce/collections");
            _collections.Clear();
            _collections.AddRange(response ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load Commerce collections: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveCollectionAsync()
    {
        try
        {
            HttpResponseMessage response;
            if (_editingCollectionId.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/v1/commerce/collections/{_editingCollectionId.Value}", _collectionForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/v1/commerce/collections", _collectionForm);
            }

            response.EnsureSuccessStatusCode();
            Snackbar.Add("Collection saved.", Severity.Success);
            StartNewCollection();
            await LoadCollectionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to save collection: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadProductsAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await LoadProductsAsync();
    }

    private void StartNewProduct()
    {
        Navigation.NavigateTo("/commerce/catalog/new");
    }

    private void OpenProduct(CommerceProductSummaryDto product)
    {
        Navigation.NavigateTo($"/commerce/catalog/{Uri.EscapeDataString(product.Handle)}");
    }

    private void StartNewCollection()
    {
        _editingCollectionId = null;
        _collectionForm = new CommerceCollectionMutationRequest();
    }

    private void SelectCollection(CommerceCollectionDto collection)
    {
        _editingCollectionId = collection.Id;
        _collectionForm = new CommerceCollectionMutationRequest
        {
            Handle = collection.Handle,
            Title = collection.Title,
            Description = collection.Description,
            IsPublished = collection.IsPublished
        };
    }

    private static bool IsPublished(CommerceProductSummaryDto product)
    {
        return string.Equals(product.Status, "Published", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDraft(CommerceProductSummaryDto product)
    {
        return string.Equals(product.Status, "Draft", StringComparison.OrdinalIgnoreCase);
    }
}
