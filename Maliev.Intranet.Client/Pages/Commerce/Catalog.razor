@page "/commerce/catalog"
@attribute [RequirePermission(MalievPermissions.Commerce.ProductsRead)]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Commerce Catalog | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Commerce Catalog"
                Subtitle="Employee-managed storefront products, collections, variants, media, and Shopify imports"
                BackHref="/" />

    <PageBody>
        <StatBar Class="mb-4">
            <StatTile Label="Products" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="Collections" Value="@_collections.Count.ToString("N0")" />
            <StatTile Label="Published" Value="@_products.Count(IsPublished).ToString("N0")" />
            <StatTile Label="Drafts" Value="@_products.Count(IsDraft).ToString("N0")" />
        </StatBar>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <PanelCard Class="mb-4">
                    <div class="d-flex flex-wrap align-center gap-3 mb-4">
                        <MudTextField @bind-Value="_query"
                                      Label="Search products"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      DebounceInterval="300"
                                      OnDebounceIntervalElapsed="LoadProductsAfterSearch"
                                      Style="min-width: 260px; flex: 1 1 260px;" />
                        <MudSelect T="string" @bind-Value="_collectionFilter" Label="Collection" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 220px;">
                            <MudSelectItem Value="@string.Empty">All collections</MudSelectItem>
                            @foreach (var collection in _collections)
                            {
                                <MudSelectItem Value="@collection.Handle">@collection.Title</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" OnClick="LoadProductsAsync" Disabled="@_loadingProducts">Apply</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="StartNewProduct">New listing</MudButton>
                    </div>

                    @if (_loadingProducts)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
                        <div class="mlv-empty">Loading commerce products...</div>
                    }
                    else if (_products.Count == 0)
                    {
                        <div class="mlv-empty">No Commerce products found.</div>
                    }
                    else
                    {
                        <table class="mlv-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in _products)
                                {
                                    <tr class="@SelectedProductRowClass(product)" @onclick="@(() => SelectProductAsync(product))">
                                        <td>
                                            <div class="d-flex align-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(product.ThumbnailUrl))
                                                {
                                                    <MudImage Src="@product.ThumbnailUrl" Alt="@product.Title" ObjectFit="ObjectFit.Cover" Width="56" Height="42" Class="rounded" />
                                                }
                                                else
                                                {
                                                    <div class="mlv-thumb-placeholder">IMG</div>
                                                }
                                                <div>
                                                    <div class="fw-semibold">@product.Title</div>
                                                    <div class="text-muted small">@product.Handle</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@product.ProductType</td>
                                        <td><StatusBadge Status="@product.Status" /></td>
                                        <td class="mlv-mono">@product.StartingPrice.ToString("N2") @product.Currency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <PaginationFooter Meta="@_meta"
                                      CurrentPage="@_page"
                                      PageSize="@_pageSize"
                                      PageChanged="OnPageChanged"
                                      PageSizeChanged="OnPageSizeChanged"
                                      Disabled="@_loadingProducts" />
                </PanelCard>

                <PanelCard>
                    <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
                        <div>
                            <MudText Typo="Typo.h6">Shopify machine import</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Pulls only the pneumatic injection molding machine listing into the Commerce catalog.</MudText>
                        </div>
                        <div class="d-flex align-center gap-3">
                            <MudSwitch @bind-Value="_importDryRun" Color="Color.Primary" Label="Dry run" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.CloudDownload" OnClick="ImportInjectionMachineAsync" Disabled="@_importing">
                                Import machine
                            </MudButton>
                        </div>
                    </div>

                    @if (_lastImport is not null)
                    {
                        <MudAlert Severity="@(_lastImport.DryRun ? Severity.Info : Severity.Success)" Dense="true">
                            Read @_lastImport.ProductsRead, created @_lastImport.ProductsCreated, updated @_lastImport.ProductsUpdated, skipped @_lastImport.ProductsSkipped, collections created @_lastImport.CollectionsCreated.
                        </MudAlert>
                    }
                </PanelCard>
            </MudItem>

            <MudItem xs="12" lg="4">
                <PanelCard Class="mb-4">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.h6">@(_editingProductId.HasValue ? "Edit listing" : "New listing")</MudText>
                        @if (_editingProductId.HasValue)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Archive" OnClick="ArchiveSelectedProductAsync">Archive</MudButton>
                        }
                    </div>

                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_productForm.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_productForm.Handle" Label="Handle" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_productForm.Brand" Label="Brand" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_productForm.ProductType" Label="Product type" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudSelect T="string" @bind-Value="_productForm.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                            <MudSelectItem Value="@("Published")">Published</MudSelectItem>
                            <MudSelectItem Value="@("Archived")">Archived</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_productForm.Summary" Label="Summary" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_productForm.Description" Label="Description / HTML" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                    </MudStack>

                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Collections</MudText>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var collection in _collections)
                        {
                            <label class="mlv-chip-check">
                                <input type="checkbox" checked="@IsCollectionSelected(collection.Handle)" @onchange="@(() => ToggleCollection(collection.Handle))" />
                                <span>@collection.Title</span>
                            </label>
                        }
                    </div>

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Variants</MudText>
                    @foreach (var variant in _productForm.Variants)
                    {
                        <div class="mlv-form-row mb-2">
                            <MudTextField @bind-Value="variant.Sku" Label="SKU" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="variant.Title" Label="Variant" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudNumericField @bind-Value="variant.PriceAmount" Label="Price" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudNumericField @bind-Value="variant.InventoryQuantity" Label="Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => RemoveVariant(variant))" />
                        </div>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddVariant">Add variant</MudButton>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Images</MudText>
                    @foreach (var media in _productForm.Media)
                    {
                        <div class="mlv-form-row mb-2">
                            <MudTextField @bind-Value="media.Url" Label="Image URL" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="media.AltText" Label="Alt text" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudNumericField @bind-Value="media.SortOrder" Label="Order" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => RemoveMedia(media))" />
                        </div>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddPhotoAlternate" OnClick="AddMedia">Add image</MudButton>

                    <div class="d-flex gap-2 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveProductAsync" Disabled="@_savingProduct">Save listing</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="StartNewProduct">Reset</MudButton>
                    </div>
                </PanelCard>

                <PanelCard>
                    <MudText Typo="Typo.h6" Class="mb-3">Collections</MudText>
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_collectionForm.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_collectionForm.Handle" Label="Handle" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_collectionForm.Description" Label="Description" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudSwitch @bind-Value="_collectionForm.IsPublished" Color="Color.Primary" Label="Published" />
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveCollectionAsync">Save collection</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="StartNewCollection">New</MudButton>
                        </div>
                    </MudStack>

                    <MudDivider Class="my-4" />
                    @foreach (var collection in _collections)
                    {
                        <div class="d-flex align-center justify-space-between gap-2 py-2 border-bottom">
                            <button type="button" class="mlv-link-button" @onclick="@(() => SelectCollection(collection))">
                                <span class="fw-semibold">@collection.Title</span>
                                <span class="text-muted small">@collection.Handle</span>
                            </button>
                            <StatusBadge Status="@(collection.IsPublished ? "Published" : "Draft")" />
                        </div>
                    }
                </PanelCard>
            </MudItem>
        </MudGrid>
    </PageBody>
</div>

@code {
    private readonly List<CommerceProductSummaryDto> _products = [];
    private readonly List<CommerceCollectionDto> _collections = [];
    private PaginationMeta _meta = new();
    private CommerceProductMutationRequest _productForm = NewProductForm();
    private CommerceCollectionMutationRequest _collectionForm = new();
    private CommerceShopifyImportResult? _lastImport;
    private Guid? _editingProductId;
    private Guid? _editingCollectionId;
    private string? _query;
    private string _collectionFilter = string.Empty;
    private bool _loadingProducts = true;
    private bool _savingProduct;
    private bool _importing;
    private bool _importDryRun = true;
    private int _page = 1;
    private int _pageSize = 24;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionsAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAfterSearch(string _)
    {
        _page = 1;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loadingProducts = true;
        try
        {
            var url = $"api/v1/commerce/products?query={Uri.EscapeDataString(_query ?? string.Empty)}&collection={Uri.EscapeDataString(_collectionFilter)}&page={_page}&pageSize={_pageSize}";
            var response = await Http.GetFromJsonAsync<PagedResponse<CommerceProductSummaryDto>>(url);
            _products.Clear();
            _products.AddRange(response?.Data ?? []);
            _meta = response?.Meta ?? new PaginationMeta();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load Commerce products: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingProducts = false;
        }
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<CommerceCollectionDto>>("api/v1/commerce/collections");
            _collections.Clear();
            _collections.AddRange(response ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load Commerce collections: {ex.Message}", Severity.Error);
        }
    }

    private async Task SelectProductAsync(CommerceProductSummaryDto product)
    {
        try
        {
            var detail = await Http.GetFromJsonAsync<CommerceProductDto>($"api/v1/commerce/products/{Uri.EscapeDataString(product.Handle)}");
            if (detail is null)
            {
                return;
            }

            _editingProductId = detail.Id;
            _productForm = new CommerceProductMutationRequest
            {
                Handle = detail.Handle,
                Title = detail.Title,
                Brand = detail.Brand,
                Summary = detail.Summary,
                Description = detail.Description,
                ProductType = detail.ProductType,
                Status = detail.Status,
                Variants = detail.Variants.Select(variant => new CommerceProductVariantMutationRequest
                {
                    Sku = variant.Sku,
                    Title = variant.Title,
                    PriceAmount = variant.PriceAmount,
                    Currency = variant.Currency,
                    InventoryQuantity = variant.InventoryQuantity,
                    OptionValuesJson = variant.OptionValuesJson
                }).ToList(),
                Media = detail.Media.Select(media => new CommerceProductMediaMutationRequest
                {
                    Url = media.Url,
                    AltText = media.AltText,
                    SortOrder = media.SortOrder
                }).ToList(),
                CollectionHandles = detail.Collections.Select(collection => collection.Handle).ToList()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load listing: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveProductAsync()
    {
        _savingProduct = true;
        try
        {
            HttpResponseMessage response;
            if (_editingProductId.HasValue)
            {
                response = await Http.PatchAsJsonAsync($"api/v1/commerce/products/{_editingProductId.Value}", _productForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/v1/commerce/products", _productForm);
            }

            response.EnsureSuccessStatusCode();
            var saved = await response.Content.ReadFromJsonAsync<CommerceProductDto>();
            _editingProductId = saved?.Id;
            Snackbar.Add("Commerce listing saved.", Severity.Success);
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to save listing: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingProduct = false;
        }
    }

    private async Task ArchiveSelectedProductAsync()
    {
        if (!_editingProductId.HasValue)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/v1/commerce/products/{_editingProductId.Value}");
            response.EnsureSuccessStatusCode();
            Snackbar.Add("Commerce listing archived.", Severity.Success);
            StartNewProduct();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to archive listing: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveCollectionAsync()
    {
        try
        {
            HttpResponseMessage response;
            if (_editingCollectionId.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/v1/commerce/collections/{_editingCollectionId.Value}", _collectionForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/v1/commerce/collections", _collectionForm);
            }

            response.EnsureSuccessStatusCode();
            Snackbar.Add("Collection saved.", Severity.Success);
            StartNewCollection();
            await LoadCollectionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to save collection: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportInjectionMachineAsync()
    {
        _importing = true;
        try
        {
            var request = new CommerceShopifyImportRequest
            {
                DryRun = _importDryRun,
                PageSize = 20
            };
            var response = await Http.PostAsJsonAsync("api/v1/commerce/imports/shopify/injection-molding-machine", request);
            response.EnsureSuccessStatusCode();
            _lastImport = await response.Content.ReadFromJsonAsync<CommerceShopifyImportResult>();
            Snackbar.Add(_importDryRun ? "Shopify dry run completed." : "Shopify machine import completed.", Severity.Success);
            await LoadCollectionsAsync();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to import Shopify listing: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadProductsAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await LoadProductsAsync();
    }

    private void StartNewProduct()
    {
        _editingProductId = null;
        _productForm = NewProductForm();
    }

    private void StartNewCollection()
    {
        _editingCollectionId = null;
        _collectionForm = new CommerceCollectionMutationRequest();
    }

    private void SelectCollection(CommerceCollectionDto collection)
    {
        _editingCollectionId = collection.Id;
        _collectionForm = new CommerceCollectionMutationRequest
        {
            Handle = collection.Handle,
            Title = collection.Title,
            Description = collection.Description,
            IsPublished = collection.IsPublished
        };
    }

    private void AddVariant()
    {
        _productForm.Variants.Add(new CommerceProductVariantMutationRequest { Title = "Default", Currency = "THB", InventoryQuantity = 1 });
    }

    private void RemoveVariant(CommerceProductVariantMutationRequest variant)
    {
        _productForm.Variants.Remove(variant);
    }

    private void AddMedia()
    {
        _productForm.Media.Add(new CommerceProductMediaMutationRequest { SortOrder = _productForm.Media.Count });
    }

    private void RemoveMedia(CommerceProductMediaMutationRequest media)
    {
        _productForm.Media.Remove(media);
    }

    private bool IsCollectionSelected(string handle)
    {
        return _productForm.CollectionHandles.Any(selected => string.Equals(selected, handle, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleCollection(string handle)
    {
        if (IsCollectionSelected(handle))
        {
            _productForm.CollectionHandles.RemoveAll(selected => string.Equals(selected, handle, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            _productForm.CollectionHandles.Add(handle);
        }
    }

    private string SelectedProductRowClass(CommerceProductSummaryDto product)
    {
        return _editingProductId == product.Id ? "mlv-row-selected" : string.Empty;
    }

    private static bool IsPublished(CommerceProductSummaryDto product)
    {
        return string.Equals(product.Status, "Published", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsDraft(CommerceProductSummaryDto product)
    {
        return string.Equals(product.Status, "Draft", StringComparison.OrdinalIgnoreCase);
    }

    private static CommerceProductMutationRequest NewProductForm()
    {
        return new CommerceProductMutationRequest
        {
            ProductType = "Product",
            Status = "Draft",
            Variants =
            [
                new CommerceProductVariantMutationRequest { Title = "Default", Currency = "THB", InventoryQuantity = 1 }
            ]
        };
    }
}
