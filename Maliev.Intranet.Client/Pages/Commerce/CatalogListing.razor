    private async Task UploadMediaFilesAsync(IReadOnlyList<IBrowserFile> files)
    {
        var acceptedFiles = files
            .Where(IsAcceptedCommerceMediaFile)
            .Take(12)
            .ToList();

        if (acceptedFiles.Count == 0)
        {
            Snackbar.Add("Select JPG, PNG, or WEBP images up to 10 MB each.", Severity.Warning);
            return;
        }

        _mediaUploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in acceptedFiles)
            {
                var stream = file.OpenReadStream(MaxCommerceMediaFileSize);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(GetCommerceMediaContentType(file));
                content.Add(fileContent, "files", file.Name);
            }

            var handle = string.IsNullOrWhiteSpace(_productForm.Handle) ? "draft" : _productForm.Handle;
            var response = await Http.PostAsync($"api/v1/commerce/products/media?handle={Uri.EscapeDataString(handle)}", content);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Image upload failed.", Severity.Warning);
                return;
            }

            var uploads = await response.Content.ReadFromJsonAsync<List<BffUploadResponse>>() ?? [];
            foreach (var upload in uploads)
            {
                var url = FirstNonEmpty(upload.FileReference, upload.SignedUrl, upload.StoragePath);
                if (string.IsNullOrWhiteSpace(url))
                {
                    continue;
                }

                _productForm.Media.Add(new CommerceProductMediaMutationRequest
                {
                    Url = url,
                    AltText = BuildDefaultMediaAltText(upload.FileName),
                    SortOrder = _productForm.Media.Count
                });
            }

            NormalizeMediaSortOrders();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Image upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mediaUploading = false;
        }
    }

    private bool IsBomImageUploading(CommerceProductBomItemMutationRequest item) => _bomImageUploadingItems.Contains(item);
    private bool IsBomDrawingUploading(CommerceProductBomItemMutationRequest item) => _bomDrawingUploadingItems.Contains(item);

    private async Task UploadBomImageAsync(CommerceProductBomItemMutationRequest item, IBrowserFile? file)
    {
        if (file is null) return;
        if (file.Size is <= 0 or > MaxCommerceMediaFileSize || !AllowedCommerceMediaExtensions.Contains(Path.GetExtension(file.Name)))
        {
            Snackbar.Add("Select a JPG, PNG, or WEBP image up to 10 MB.", Severity.Warning);
            return;
        }

        _bomImageUploadingItems.Add(item);
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(MaxCommerceMediaFileSize);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(GetCommerceMediaContentType(file));
            content.Add(fileContent, "file", file.Name);

            var handle = string.IsNullOrWhiteSpace(_productForm.Handle) ? "draft" : _productForm.Handle;
            var response = await Http.PostAsync($"api/v1/commerce/products/media?handle={Uri.EscapeDataString(handle)}", content);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Image upload failed.", Severity.Warning);
                return;
            }

            var uploads = await response.Content.ReadFromJsonAsync<List<BffUploadResponse>>() ?? [];
            var upload = uploads.FirstOrDefault();
            var url = FirstNonEmpty(upload?.FileReference, upload?.SignedUrl, upload?.StoragePath);
            if (!string.IsNullOrWhiteSpace(url))
            {
                item.ImageUrl = url;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Image upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _bomImageUploadingItems.Remove(item);
        }
    }

