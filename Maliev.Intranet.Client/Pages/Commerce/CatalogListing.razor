    private static int CalculateBomItemSourcingDays(CommerceProductBomItemMutationRequest item)
    {
        return Math.Max(0, item.LeadTimeDays.GetValueOrDefault()) + Math.Max(0, item.SourcingTimeDays.GetValueOrDefault());
    }

    private static string BomItemSourcingLabel(CommerceProductBomItemMutationRequest item)
    {
        var days = CalculateBomItemSourcingDays(item);
        return days == 0 ? "Not set" : $"{days:N0} days";
    }

    private IReadOnlyList<BomIssueSummary> BomIssueItems()
    {
        return _productForm.BomItems
            .OrderBy(item => item.SortOrder)
            .Select(item => new BomIssueSummary(BomItemDisplayName(item), BuildBomIssues(item)))
            .Where(summary => summary.Issues.Count > 0)
            .ToList();
    }

    private static IReadOnlyList<string> BuildBomIssues(CommerceProductBomItemMutationRequest item)
    {
        var issues = new List<string>();
        if (string.IsNullOrWhiteSpace(item.ItemName))
        {
            issues.Add("Missing item name.");
        }

        if (string.IsNullOrWhiteSpace(item.PartNumber))
        {
            issues.Add("Missing part number.");
        }

        if (string.IsNullOrWhiteSpace(item.Specification))
        {
            issues.Add("Missing part description or specification.");
        }

        if (string.IsNullOrWhiteSpace(item.ImageUrl))
        {
            issues.Add("Missing part image.");
        }

        if (string.IsNullOrWhiteSpace(item.DrawingUrl))
        {
            issues.Add("No drawing or technical document linked.");
        }

        if (string.IsNullOrWhiteSpace(item.SupplierName))
        {
            issues.Add("Missing supplier.");
        }

        if (string.IsNullOrWhiteSpace(item.SupplierUrl))
        {
            issues.Add("Missing part URL.");
        }

        if (item.Quantity <= 0)
        {
            issues.Add("Quantity must be greater than zero.");
        }

        if (item.UnitCost <= 0)
        {
            issues.Add("Unit cost is not set.");
        }

        if (CalculateBomItemSourcingDays(item) == 0)
        {
            issues.Add("Lead time or sourcing time is not set.");
        }

        return issues;
    }

    private IReadOnlyList<CommerceProductBomItemMutationRequest> BomBottleneckItems()
    {
        var sourcedItems = _productForm.BomItems
            .Where(item => CalculateBomItemSourcingDays(item) > 0)
            .ToList();

        if (sourcedItems.Count == 0)
        {
            return [];
        }

        var maxSourcingDays = sourcedItems.Max(CalculateBomItemSourcingDays);
        return sourcedItems
            .Where(item => CalculateBomItemSourcingDays(item) == maxSourcingDays)
            .OrderBy(item => item.SortOrder)
            .ToList();
    }

    private static string BomInventoryReadinessLabel(CommerceProductBomItemMutationRequest item)
    {
        if (item.Quantity <= 0)
        {
            return "Quantity missing";
        }

        if (CalculateBomItemSourcingDays(item) == 0)
        {
            return "Timing missing";
        }

        return "Ready for inventory link";
    }

