@page "/commerce/catalog/new"
@page "/commerce/catalog/{Handle}"
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@using Maliev.Intranet.Client.Components.Shared
@using Maliev.Intranet.Client.Services
@using Maliev.Intranet.Shared.Dtos
@attribute [RequirePermission(MalievPermissions.Commerce.ProductsRead)]
@inject HttpClient Http
@inject CurrencyService CurrencyService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@PageTitleText | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell commerce-listing-shell">
    <PageHeader Title="@PageTitleText"
                Subtitle="Manage storefront product content, variants, media, collections, and bill of materials"
                BackHref="/commerce/catalog" />

    <PageBody>
        @if (_loading)
        {
            <PanelCard>
                <ProgressiveSkeleton Layout="detail" Rows="6" ShowFilters="false" Label="Loading listing" />
            </PanelCard>
        }
        else
        {
            <StatBar Class="mb-4">
                <StatTile Label="Variants" Value="@_productForm.Variants.Count.ToString("N0")" />
                <StatTile Label="BOM Items" Value="@_productForm.BomItems.Count.ToString("N0")" />
                <StatTile Label="BOM Cost" Value="@($"{BomCurrency} {BomTotal:N2}")" />
                <StatTile Label="Sourcing Time" Value="@BomSourcingLabel" />
                <StatTile Label="Status" Value="@_productForm.Status" />
            </StatBar>

            <div class="commerce-listing-actions mb-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Outlined.ArrowBack" OnClick="BackToCatalog">
                    Catalog
                </MudButton>
                @if (_editingProductId.HasValue)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Archive" OnClick="ArchiveListingAsync">
                        Archive
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.PictureAsPdf"
                           Href="@BomPdfHref"
                           Target="_blank"
                           Disabled="@(!CanExportBom)">
                    Export BOM PDF
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveListingAsync" Disabled="@_saving">
                    Save listing
                </MudButton>
            </div>

            <MudTabs Class="commerce-listing-tabs">
                <MudTabPanel Text="Listing">
                    <MudGrid Spacing="3">
                <MudItem xs="12" lg="7">
                    <PanelCard Class="mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Listing details</MudText>
                        <div class="commerce-listing-grid">
                            <MudTextField @bind-Value="_productForm.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="_productForm.Handle" Label="Handle" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="_productForm.Brand" Label="Brand" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudTextField @bind-Value="_productForm.ProductType" Label="Product type" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudSelect T="string" @bind-Value="_productForm.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                                <MudSelectItem Value="@("Published")">Published</MudSelectItem>
                                <MudSelectItem Value="@("Archived")">Archived</MudSelectItem>
                            </MudSelect>
                        </div>
                        <MudTextField @bind-Value="_productForm.Summary" Label="Summary" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mt-3" />
                        <MudTextField @bind-Value="_productForm.Description" Label="Description / HTML" Lines="8" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mt-3" />
                    </PanelCard>
                </MudItem>

                <MudItem xs="12" lg="5">
                    <PanelCard Class="mb-4">
                        <div class="commerce-section-heading">
                            <MudText Typo="Typo.h6">Collections</MudText>
                            <MudText Typo="Typo.caption">@_productForm.CollectionHandles.Count selected</MudText>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var collection in _collections)
                            {
                                <label class="commerce-chip-check">
                                    <input type="checkbox" checked="@IsCollectionSelected(collection.Handle)" @onchange="@(() => ToggleCollection(collection.Handle))" />
                                    <span>@collection.Title</span>
                                </label>
                            }
                        </div>
                    </PanelCard>

                    <PanelCard Class="mb-4">
                        <div class="commerce-section-heading">
                            <MudText Typo="Typo.h6">Variants</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddVariant">Add variant</MudButton>
                        </div>
                        @foreach (var variant in _productForm.Variants)
                        {
                            <div class="commerce-variant-row">
                                <MudTextField @bind-Value="variant.Sku" Label="SKU" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                <MudTextField @bind-Value="variant.Title" Label="Variant" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                <MudNumericField @bind-Value="variant.PriceAmount" Label="Price" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                <MudSelect T="string" @bind-Value="variant.Currency" Label="Currency" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var currency in CatalogCurrencyOptions())
                                    {
                                        <MudSelectItem Value="@currency.Code">@CurrencyOptionLabel(currency)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudNumericField @bind-Value="variant.InventoryQuantity" Label="Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => RemoveVariant(variant))" />
                            </div>
                        }
                    </PanelCard>

                    <PanelCard>
                        <div class="commerce-section-heading">
                            <div>
                                <MudText Typo="Typo.h6">Media</MudText>
                                <MudText Typo="Typo.caption">Primary image is shown first in the storefront.</MudText>
                            </div>
                            <MudText Typo="Typo.caption">@_productForm.Media.Count.ToString("N0") image(s)</MudText>
                        </div>
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       FilesChanged="UploadMediaFilesAsync"
                                       Accept=".jpg,.jpeg,.png,.webp"
                                       MaximumFileCount="12"
                                       Class="commerce-media-upload">
                            <CustomContent Context="uploadContext">
                                <div class="commerce-media-dropzone">
                                    <FileUploadDropzone Variant="FileUploadDropzone.DropzoneVariant.Compact"
                                                        Icon="@Icons.Material.Outlined.AddPhotoAlternate"
                                                        Label="Drop images here or click to upload"
                                                        SubLabel="JPG, PNG, WEBP"
                                                        MaxFileSizeLabel="max 10 MB each"
                                                        OnClick="@uploadContext.OpenFilePickerAsync"
                                                        OnFilesDropped="@uploadContext.OpenFilePickerAsync" />
                                </div>
                            </CustomContent>
                        </MudFileUpload>
                        @if (_mediaUploading)
                        {
                            <div class="commerce-media-uploading">
                                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                                <span>Uploading image media...</span>
                            </div>
                        }
                        @if (_productForm.Media.Count == 0)
                        {
                            <div class="commerce-bom-empty">No listing media configured.</div>
                        }
                        <div class="commerce-media-list">
                        @foreach (var media in OrderedMedia())
                        {
                            <div class="@GetMediaCardClass(media)"
                                 draggable="true"
                                 @ondragstart="@(() => OnMediaDragStart(media))"
                                 @ondragend="ClearMediaDrag"
                                 @ondragover:preventDefault="true"
                                 @ondrop="@(() => OnMediaDrop(media))">
                                <div class="commerce-media-thumb">
                                    @if (!string.IsNullOrWhiteSpace(media.Url))
                                    {
                                        <img src="@media.Url" alt="@BuildMediaAlt(media)" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                    }
                                    @if (IsPrimaryMedia(media))
                                    {
                                        <span class="commerce-media-primary">Primary image</span>
                                    }
                                </div>
                                <div class="commerce-media-fields">
                                    <MudTextField @bind-Value="media.AltText" Label="Alt text" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                    <span class="commerce-media-url" title="@media.Url">@media.Url</span>
                                </div>
                                <div class="commerce-media-actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   Disabled="@IsPrimaryMedia(media)"
                                                   OnClick="@(() => MoveMedia(media, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   Disabled="@IsLastMedia(media)"
                                                   OnClick="@(() => MoveMedia(media, 1))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Star"
                                                   Color="@(IsPrimaryMedia(media) ? Color.Primary : Color.Default)"
                                                   Size="Size.Small"
                                                   Disabled="@IsPrimaryMedia(media)"
                                                   OnClick="@(() => SetPrimaryMedia(media))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveMedia(media))" />
                                </div>
                            </div>
                        }
                        </div>
                    </PanelCard>
                </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="BOM">
                    <PanelCard Class="mb-4">
                        <div class="commerce-section-heading">
                            <div>
                                <MudText Typo="Typo.h6">BOM management</MudText>
                                <MudText Typo="Typo.caption">Track BOM document issues, sourcing bottlenecks, suppliers, inventory readiness, and order history links.</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddBomItem">Add item</MudButton>
                        </div>

                        <div class="commerce-bom-command-grid">
                            <div>
                                <span>Total BOM value</span>
                                <strong>@BomCurrency @BomTotal.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>Sourcing time</span>
                                <strong>@BomSourcingLabel</strong>
                            </div>
                            <div>
                                <span>Supplier coverage</span>
                                <strong>@BomSupplierCount.ToString("N0") supplier(s)</strong>
                            </div>
                            <div>
                                <span>BOM document issues</span>
                                <strong>@(BomIssueItems().Sum(issueItem => issueItem.Issues.Count).ToString("N0")) issue(s)</strong>
                            </div>
                            <div>
                                <span>Drawings</span>
                                <strong>@BomDrawingCount.ToString("N0") linked</strong>
                            </div>
                        </div>
                    </PanelCard>

                    <div class="commerce-bom-management-grid">
                        <PanelCard Class="mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">BOM document issues</MudText>
                            @if (BomIssueItems().Count == 0)
                            {
                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No blocking BOM document issues detected.</MudAlert>
                            }
                            else
                            {
                                <div class="commerce-bom-issue-list">
                                    @foreach (var issueItem in BomIssueItems())
                                    {
                                        <div class="commerce-bom-issue-item">
                                            <strong>@issueItem.ItemName</strong>
                                            <ul>
                                                @foreach (var issue in issueItem.Issues)
                                                {
                                                    <li>@issue</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </PanelCard>

                        <PanelCard Class="mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Sourcing bottleneck</MudText>
                            @if (BomBottleneckItems().Count == 0)
                            {
                                <div class="commerce-bom-empty">No lead time or sourcing time is set yet.</div>
                            }
                            else
                            {
                                <div class="commerce-bom-bottleneck-list">
                                    @foreach (var item in BomBottleneckItems())
                                    {
                                        <div class="commerce-bom-bottleneck-item">
                                            <div>
                                                <strong>@BomItemDisplayName(item)</strong>
                                                <span>@(string.IsNullOrWhiteSpace(item.SupplierName) ? "Supplier not set" : item.SupplierName)</span>
                                            </div>
                                            <strong>@BomItemSourcingLabel(item)</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </PanelCard>
                    </div>

                    <PanelCard>
                        <div class="commerce-section-heading">
                            <div>
                                <MudText Typo="Typo.h6">Bill of materials</MudText>
                                <MudText Typo="Typo.caption">Manage part images, descriptions, URLs, suppliers, inventory tracking, order history, and source timing.</MudText>
                            </div>
                            <MudText Typo="Typo.caption">@_productForm.BomItems.Count.ToString("N0") item(s)</MudText>
                        </div>

                        <div class="commerce-bom-list">
                            @if (_productForm.BomItems.Count == 0)
                            {
                                <div class="commerce-bom-empty">No BOM items yet. Add materials, components, packaging, or consumables used by this listing.</div>
                            }
                            else
                            {
                                @foreach (var item in _productForm.BomItems.OrderBy(item => item.SortOrder).ToList())
                                {
                                    <div class="commerce-bom-card">
                                        <div class="commerce-bom-card-main">
                                            <div class="commerce-bom-image">
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@BuildBomImageAlt(item)" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                                }
                                            </div>
                                            <div class="commerce-bom-fields">
                                                <div class="commerce-bom-name-row">
                                                    <MudTextField @bind-Value="item.ItemName" Label="Item" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                    <MudTextField @bind-Value="item.PartNumber" Label="Part no" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                </div>
                                                <MudTextField @bind-Value="item.Specification" Label="Part description / specification" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Lines="2" />
                                                <div class="commerce-bom-assembly-grid">
                                                    <MudTextField @bind-Value="item.AssemblyName" Label="Assembly" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                    <MudTextField @bind-Value="item.SubassemblyName" Label="Subassembly" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                    <MudAutocomplete T="SupplierSummaryDto"
                                                                     Label="Supplier"
                                                                     Value="@GetBomSupplierValue(item)"
                                                                     ValueChanged="@(s => SetBomSupplierValue(item, s))"
                                                                     SearchFunc="SearchSuppliersAsync"
                                                                     ToStringFunc="@(s => s?.Name ?? string.Empty)"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     MinCharacters="2"
                                                                     DebounceInterval="300"
                                                                     CoerceText="true"
                                                                     Immediate="true"
                                                                     ResetValueOnEmptyText="false" />
                                                    <MudTextField @bind-Value="item.SupplierUrl" Label="Supplier URL" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                    <MudTextField @bind-Value="item.DrawingUrl" Label="Drawing URL" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                                </div>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => RemoveBomItem(item))" />
                                        </div>

                                        <div class="commerce-bom-detail-grid">
                                            <MudNumericField @bind-Value="item.Quantity" Label="Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                            <MudTextField @bind-Value="item.Unit" Label="Unit" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                            <MudNumericField @bind-Value="item.UnitCost" Label="Unit cost" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                            <MudSelect T="string" @bind-Value="item.Currency" Label="Currency" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var currency in CatalogCurrencyOptions())
                                                {
                                                    <MudSelectItem Value="@currency.Code">@CurrencyOptionLabel(currency)</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudNumericField T="int?" @bind-Value="item.LeadTimeDays" Label="Lead time" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Min="0" />
                                            <MudNumericField T="int?" @bind-Value="item.SourcingTimeDays" Label="Sourcing time" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Min="0" />
                                            <div class="commerce-bom-upload-cell">
                                                <span class="commerce-bom-upload-label">Part image</span>
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <span class="commerce-bom-upload-set">Image linked</span>
                                                }
                                                <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadBomImageAsync(item, f))" Accept=".jpg,.jpeg,.png,.webp" Disabled="@IsBomImageUploading(item)">
                                                    <CustomContent Context="ctx">
                                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Upload" OnClick="@ctx.OpenFilePickerAsync" Disabled="@IsBomImageUploading(item)">
                                                            @(IsBomImageUploading(item) ? "Uploading…" : "Upload image")
                                                        </MudButton>
                                                    </CustomContent>
                                                </MudFileUpload>
                                            </div>
                                            <div class="commerce-bom-upload-cell">
                                                <span class="commerce-bom-upload-label">Drawing / document</span>
                                                @if (!string.IsNullOrWhiteSpace(item.DrawingUrl))
                                                {
                                                    <span class="commerce-bom-upload-set">Document linked</span>
                                                }
                                                <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadBomDrawingAsync(item, f))" Accept=".pdf,.jpg,.jpeg,.png,.webp" Disabled="@IsBomDrawingUploading(item)">
                                                    <CustomContent Context="ctx">
                                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Upload" OnClick="@ctx.OpenFilePickerAsync" Disabled="@IsBomDrawingUploading(item)">
                                                            @(IsBomDrawingUploading(item) ? "Uploading…" : "Upload drawing")
                                                        </MudButton>
                                                    </CustomContent>
                                                </MudFileUpload>
                                            </div>
                                        </div>

                                        <div class="commerce-bom-card-footer">
                                            <div>
                                                <span>Line total</span>
                                                <strong>@item.Currency @BomLineTotal(item).ToString("N2")</strong>
                                            </div>
                                            <div>
                                                <span>Sourcing</span>
                                                <strong>@BomItemSourcingLabel(item)</strong>
                                            </div>
                                            <div class="commerce-bom-links">
                                                @if (!string.IsNullOrWhiteSpace(item.SupplierUrl))
                                                {
                                                    <MudButton Class="commerce-bom-part-link" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.OpenInNew" Href="@item.SupplierUrl" Target="_blank">Part URL</MudButton>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.DrawingUrl))
                                                {
                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Description" Href="@item.DrawingUrl" Target="_blank">Drawing</MudButton>
                                                }
                                            </div>
                                        </div>

                                        <div class="commerce-bom-tracking-grid">
                                            <div>
                                                <span>Inventory tracking</span>
                                                <strong>@BomInventoryReadinessLabel(item)</strong>
                                                <p>No linked inventory movements yet.</p>
                                            </div>
                                            <div>
                                                <span>Order history</span>
                                                <strong>Awaiting purchase link</strong>
                                                <p>No purchase/order history linked yet.</p>
                                            </div>
                                        </div>

                                        <MudTextField @bind-Value="item.Notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" MaxLength="1000" Counter="1000" />

                                        <div class="commerce-bom-item-actions">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveListingAsync" Disabled="@_saving">Save item</MudButton>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </PanelCard>
                </MudTabPanel>
            </MudTabs>
        }
    </PageBody>
</div>

@code {
    /// <summary>Gets or sets the product handle route value.</summary>
    [Parameter]
    public string? Handle { get; set; }

    private readonly List<CommerceCollectionDto> _collections = [];
    private CommerceProductMutationRequest _productForm = NewProductForm();
    private Guid? _editingProductId;
    private string? _loadedHandle;
    private bool _loading = true;
    private bool _saving;

    private bool IsNewListing => string.IsNullOrWhiteSpace(Handle) || string.Equals(Handle, "new", StringComparison.OrdinalIgnoreCase);

    private string PageTitleText => IsNewListing ? "New Commerce Listing" : _productForm.Title;

    private bool CanExportBom => _editingProductId.HasValue && _productForm.BomItems.Count > 0 && !string.IsNullOrWhiteSpace(_loadedHandle);

    private string BomPdfHref => CanExportBom
        ? $"api/v1/commerce/products/{Uri.EscapeDataString(_loadedHandle!)}/bom/pdf"
        : "#";

    private string BomCurrency => _productForm.BomItems.FirstOrDefault()?.Currency ?? _productForm.Variants.FirstOrDefault()?.Currency ?? "THB";

    private decimal BomTotal => _productForm.BomItems.Sum(BomLineTotal);

    private bool _mediaUploading;
    private CommerceProductMediaMutationRequest? _draggedMedia;
    private const long MaxCommerceMediaFileSize = 10 * 1024 * 1024;
    private const long MaxBomDocumentFileSize = 20 * 1024 * 1024;
    private static readonly HashSet<string> AllowedCommerceMediaExtensions = new(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png", ".webp" };
    private static readonly HashSet<string> AllowedBomDocumentExtensions = new(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png", ".webp", ".pdf" };
    private readonly HashSet<CommerceProductBomItemMutationRequest> _bomImageUploadingItems = new(ReferenceEqualityComparer.Instance);
    private readonly HashSet<CommerceProductBomItemMutationRequest> _bomDrawingUploadingItems = new(ReferenceEqualityComparer.Instance);

    private int BomDrawingCount => _productForm.BomItems.Count(item => !string.IsNullOrWhiteSpace(item.DrawingUrl));

    private int BomSourcingDays => _productForm.BomItems.Select(CalculateBomItemSourcingDays).DefaultIfEmpty(0).Max();

    private string BomSourcingLabel => BomSourcingDays == 0 ? "Not set" : $"{BomSourcingDays:N0} days";

    private int BomSupplierCount => _productForm.BomItems
        .Select(item => item.SupplierName?.Trim())
        .Where(supplier => !string.IsNullOrWhiteSpace(supplier))
        .Select(supplier => supplier!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            await CurrencyService.InitializeAsync();

            if (_collections.Count == 0)
            {
                await LoadCollectionsAsync();
            }

            if (IsNewListing)
            {
                _editingProductId = null;
                _loadedHandle = null;
                _productForm = NewProductForm();
                NormalizeFormCurrencies();
                return;
            }

            await LoadProductAsync(Handle!);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<CommerceCollectionDto>>("api/v1/commerce/collections");
            _collections.Clear();
            _collections.AddRange(response ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load Commerce collections: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadProductAsync(string handle)
    {
        try
        {
            var detail = await Http.GetFromJsonAsync<CommerceProductDto>($"api/v1/commerce/products/{Uri.EscapeDataString(handle)}");
            if (detail is null)
            {
                Snackbar.Add("Commerce listing was not found.", Severity.Warning);
                Navigation.NavigateTo("/commerce/catalog");
                return;
            }

            _editingProductId = detail.Id;
            _loadedHandle = detail.Handle;
            _productForm = MapProduct(detail);
            NormalizeFormCurrencies();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load listing: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveListingAsync()
    {
        if (string.IsNullOrWhiteSpace(_productForm.Title) || string.IsNullOrWhiteSpace(_productForm.Handle))
        {
            Snackbar.Add("Title and handle are required before saving.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            NormalizeBomSortOrders();
            NormalizeMediaSortOrders();

            HttpResponseMessage response;
            if (_editingProductId.HasValue)
            {
                response = await Http.PatchAsJsonAsync($"api/v1/commerce/products/{_editingProductId.Value}", _productForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/v1/commerce/products", _productForm);
            }

            response.EnsureSuccessStatusCode();
            var saved = await response.Content.ReadFromJsonAsync<CommerceProductDto>();
            if (saved is null)
            {
                return;
            }

            _editingProductId = saved.Id;
            _loadedHandle = saved.Handle;
            _productForm = MapProduct(saved);
            Snackbar.Add("Commerce listing saved.", Severity.Success);

            if (!string.Equals(Handle, saved.Handle, StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo($"/commerce/catalog/{Uri.EscapeDataString(saved.Handle)}", replace: true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to save listing: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void BackToCatalog()
    {
        Navigation.NavigateTo("/commerce/catalog");
    }

    private async Task ArchiveListingAsync()
    {
        if (!_editingProductId.HasValue)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/v1/commerce/products/{_editingProductId.Value}");
            response.EnsureSuccessStatusCode();
            Snackbar.Add("Commerce listing archived.", Severity.Success);
            Navigation.NavigateTo("/commerce/catalog");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to archive listing: {ex.Message}", Severity.Error);
        }
    }

