        foreach (var item in _productForm.BomItems)
        {
            item.Currency = NormalizeCurrencyCode(item.Currency);
        }
    }

    private IReadOnlyList<CurrencyDto> CatalogCurrencyOptions()
    {
        return CurrencyService.Currencies
            .Where(currency => currency.IsActive && !string.IsNullOrWhiteSpace(currency.Code))
            .OrderByDescending(currency => currency.IsPrimary)
            .ThenBy(currency => currency.Code, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string DefaultCatalogCurrencyCode()
    {
        var options = CatalogCurrencyOptions();
        return options.FirstOrDefault(currency => currency.IsPrimary)?.Code
            ?? options.FirstOrDefault(currency => string.Equals(currency.Code, "THB", StringComparison.OrdinalIgnoreCase))?.Code
            ?? options.FirstOrDefault()?.Code
            ?? "THB";
    }

    private string NormalizeCurrencyCode(string? currencyCode)
    {
        var normalized = currencyCode?.Trim();
        var options = CatalogCurrencyOptions();
        if (options.Count == 0)
        {
            return string.IsNullOrWhiteSpace(normalized) ? "THB" : normalized.ToUpperInvariant();
        }

        return options.FirstOrDefault(currency => string.Equals(currency.Code, normalized, StringComparison.OrdinalIgnoreCase))?.Code
            ?? DefaultCatalogCurrencyCode();
    }

