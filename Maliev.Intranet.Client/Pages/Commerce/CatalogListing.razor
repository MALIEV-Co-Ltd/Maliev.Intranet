    private IReadOnlyList<CommerceProductMediaMutationRequest> OrderedMedia()
    {
        return _productForm.Media.OrderBy(media => media.SortOrder).ToList();
    }

    private bool IsPrimaryMedia(CommerceProductMediaMutationRequest media)
    {
        return ReferenceEquals(OrderedMedia().FirstOrDefault(), media);
    }

    private bool IsLastMedia(CommerceProductMediaMutationRequest media)
    {
        return ReferenceEquals(OrderedMedia().LastOrDefault(), media);
    }

    private void SetPrimaryMedia(CommerceProductMediaMutationRequest media)
    {
        var ordered = OrderedMedia().Where(item => !ReferenceEquals(item, media)).ToList();
        ordered.Insert(0, media);
        ApplyMediaOrder(ordered);
    }

    private void MoveMedia(CommerceProductMediaMutationRequest media, int direction)
    {
        var ordered = OrderedMedia().ToList();
        var index = ordered.FindIndex(item => ReferenceEquals(item, media));
        var newIndex = index + direction;
        if (index < 0 || newIndex < 0 || newIndex >= ordered.Count)
        {
            return;
        }

        ordered.RemoveAt(index);
        ordered.Insert(newIndex, media);
        ApplyMediaOrder(ordered);
    }

    private void OnMediaDragStart(CommerceProductMediaMutationRequest media)
    {
        _draggedMedia = media;
    }

    private void OnMediaDrop(CommerceProductMediaMutationRequest media)
    {
        if (_draggedMedia is null || ReferenceEquals(_draggedMedia, media))
        {
            _draggedMedia = null;
            return;
        }

        var ordered = OrderedMedia().ToList();
        var dragged = _draggedMedia;
        ordered.RemoveAll(item => ReferenceEquals(item, dragged));
        var targetIndex = ordered.FindIndex(item => ReferenceEquals(item, media));
        if (targetIndex < 0)
        {
            targetIndex = ordered.Count;
        }

        ordered.Insert(targetIndex, dragged);
        ApplyMediaOrder(ordered);
        _draggedMedia = null;
    }

    private void ClearMediaDrag()
    {
        _draggedMedia = null;
    }

    private void ApplyMediaOrder(IReadOnlyList<CommerceProductMediaMutationRequest> ordered)
    {
        for (var index = 0; index < ordered.Count; index++)
        {
            ordered[index].SortOrder = index;
        }
    }

