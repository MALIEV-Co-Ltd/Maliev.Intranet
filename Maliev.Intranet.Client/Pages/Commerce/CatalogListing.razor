    private async Task<IEnumerable<SupplierSummaryDto>> SearchSuppliersAsync(string search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search) || search.Trim().Length < 2)
        {
            return [];
        }

        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<SupplierSummaryDto>>(
                $"api/v1/suppliers?search={Uri.EscapeDataString(search.Trim())}&status=Active&pageSize=10", ct);
            return response?.Data ?? [];
        }
        catch
        {
            return [];
        }
    }

    private static string GetBomDocumentContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType) &&
            (file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
             file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase)))
        {
            return file.ContentType;
        }

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".pdf" => "application/pdf",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".webp" => "image/webp",
            _ => "application/octet-stream"
        };
    }

