@page "/commerce/collections"
@using System.Net.Http.Headers
@attribute [RequirePermission(MalievPermissions.Commerce.CollectionsRead)]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Commerce Collections | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell commerce-collections-shell">
    <PageHeader Title="Commerce Collections"
                Subtitle="Storefront collection groups and publishing state"
                BackHref="/commerce/catalog">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Outlined.Storefront"
                   OnClick="BackToCatalog">
            Catalog
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="StartNewCollection">
            New collection
        </MudButton>
    </PageHeader>

    <PageBody>
        <StatBar Class="mb-4">
            <StatTile Label="Collections" Value="@_collections.Count.ToString("N0")" />
            <StatTile Label="Published" Value="@PublishedCount.ToString("N0")" />
            <StatTile Label="Drafts" Value="@DraftCount.ToString("N0")" />
            <StatTile Label="Selected" Value="@SelectedCollectionLabel" />
        </StatBar>

        <div class="@CollectionsLayoutClass">
            <div class="commerce-collections-list-pane">
                <PanelCard Class="commerce-collections-list-panel">
                    <div class="commerce-collections-list-head">
                        <div>
                            <MudText Typo="Typo.h6">Product collections</MudText>
                            <MudText Typo="Typo.caption">URL slugs, descriptions, and publishing state</MudText>
                        </div>
                        <StatusBadge Status="@($"{_collections.Count:N0} total")" />
                    </div>

                    @if (_loadingCollections)
                    {
                        <div class="commerce-collection-skeletons">
                            <MudSkeleton Height="64px" Animation="Animation.Wave" />
                            <MudSkeleton Height="64px" Animation="Animation.Wave" />
                            <MudSkeleton Height="64px" Animation="Animation.Wave" />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_collectionsLoadError))
                    {
                        <div class="commerce-collections-load-error" role="alert">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Medium" />
                            <div>
                                <MudText Typo="Typo.body1">@_collectionsLoadError</MudText>
                                <MudText Typo="Typo.caption">Check CommerceService status or retry loading the collection list.</MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Refresh"
                                       OnClick="LoadCollectionsAsync">
                                Retry
                            </MudButton>
                        </div>
                    }
                    else if (_collections.Count == 0)
                    {
                        <div class="commerce-collections-empty">
                            <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Large" />
                            <MudText Typo="Typo.body1">No product collections yet.</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="StartNewCollection">
                                Create the first collection
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <div class="commerce-collection-list" role="list">
                            @foreach (var collection in _collections.OrderBy(collection => collection.Title))
                            {
                                <div class="@CollectionRowClass(collection)" role="listitem">
                                    <span class="commerce-collection-thumb">
                                        @if (!string.IsNullOrWhiteSpace(collection.ImageUrl))
                                        {
                                            <img src="@collection.ImageUrl" alt="@CollectionImageAlt(collection)" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                        }
                                    </span>
                                    <button type="button" class="commerce-collection-main" @onclick="@(() => SelectCollection(collection))">
                                        <span class="commerce-collection-title-row">
                                            <span class="commerce-collection-title">@collection.Title</span>
                                            <StatusBadge Status="@CollectionStatus(collection)" />
                                        </span>
                                        <span class="commerce-collection-handle">@collection.Handle</span>
                                        <span class="commerce-collection-description">@CollectionDescription(collection)</span>
                                    </button>
                                    <div class="commerce-collection-row-actions">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => SelectCollection(collection))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Unpublished"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       Disabled="@(!collection.IsPublished || _saving)"
                                                       OnClick="@(() => UnpublishCollectionAsync(collection.Id))" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </PanelCard>
            </div>

            @if (IsCollectionEditorOpen)
            {
                <div class="commerce-collection-editor-pane">
                    <PanelCard Class="commerce-collection-editor">
                        <div class="commerce-collection-editor-head">
                            <div>
                                <MudText Typo="Typo.h6">@EditorTitle</MudText>
                                <MudText Typo="Typo.caption">@EditorSubtitle</MudText>
                            </div>
                            <div class="commerce-collection-editor-head-actions">
                                @if (_editingCollectionId.HasValue)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="StartNewCollection">
                                        Clear
                                    </MudButton>
                                }
                                <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="CloseCollectionEditor"
                                               aria-label="Close collection editor" />
                            </div>
                        </div>

                        <div class="commerce-collection-form-grid">
                            <MudTextField T="string"
                                          Value="_collectionForm.Title"
                                          ValueChanged="@OnCollectionTitleChanged"
                                          Label="Title"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          Immediate="true" />
                        </div>

                        <div class="commerce-collection-url-group">
                            <MudText Typo="Typo.caption">Storefront URL</MudText>
                            <div class="commerce-collection-url-field">
                                <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" />
                                <span class="commerce-collection-url-prefix">/shop?collection=</span>
                                <input class="commerce-collection-url-input"
                                       value="@_collectionForm.Handle"
                                       @oninput="OnCollectionStorefrontSlugInput"
                                       placeholder="collection-url-slug"
                                       required
                                       aria-label="Storefront collection slug" />
                            </div>
                        </div>

                        @if (HandleChangedForPublishedCollection)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="commerce-collection-handle-warning">
                                Changing this slug changes Web collection links and filters. Existing links using the old slug may stop matching this collection.
                            </MudAlert>
                        }

                        <div class="commerce-collection-image-uploader">
                            <div class="commerce-collection-image-heading">
                                <div>
                                    <MudText Typo="Typo.subtitle2">Collection image</MudText>
                                    <MudText Typo="Typo.caption">Shown on the Web collection section.</MudText>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_collectionForm.ImageUrl))
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Outlined.Delete"
                                               OnClick="RemoveCollectionImage">
                                        Remove
                                    </MudButton>
                                }
                            </div>

                            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                           FilesChanged="UploadCollectionImageFilesAsync"
                                           Accept=".jpg,.jpeg,.png,.webp"
                                           MaximumFileCount="1"
                                           Disabled="@_collectionImageUploading"
                                           Class="commerce-collection-image-upload">
                                <CustomContent Context="uploadContext">
                                    <div class="commerce-collection-image-dropzone">
                                        <FileUploadDropzone Variant="FileUploadDropzone.DropzoneVariant.Compact"
                                                            Icon="@Icons.Material.Outlined.AddPhotoAlternate"
                                                            Label="Drop collection image here or click to upload"
                                                            SubLabel="JPG, PNG, WEBP"
                                                            MaxFileSizeLabel="max 10 MB"
                                                            OnClick="@uploadContext.OpenFilePickerAsync"
                                                            OnFilesDropped="@uploadContext.OpenFilePickerAsync" />
                                    </div>
                                </CustomContent>
                            </MudFileUpload>

                            @if (_collectionImageUploading)
                            {
                                <div class="commerce-collection-image-uploading">
                                    <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                                    <span>Uploading collection image...</span>
                                </div>
                            }

                            <div class="commerce-collection-image-preview">
                                <div class="commerce-collection-image-frame">
                                    @if (!string.IsNullOrWhiteSpace(_collectionForm.ImageUrl))
                                    {
                                        <img src="@_collectionForm.ImageUrl" alt="@CollectionImagePreviewAlt" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.Image" />
                                    }
                                </div>
                                <div class="commerce-collection-image-fields">
                                    <MudTextField @bind-Value="_collectionForm.ImageAltText"
                                                  Label="Image alt text"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                    @if (!string.IsNullOrWhiteSpace(_collectionForm.ImageUrl))
                                    {
                                        <span class="commerce-collection-image-url" title="@_collectionForm.ImageUrl">@_collectionForm.ImageUrl</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <MudTextField @bind-Value="_collectionForm.Description"
                                      Label="Description"
                                      Lines="4"
                                      MaxLines="8"
                                      Counter="500"
                                      MaxLength="500"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="mt-3" />

                        <div class="commerce-collection-publish-row">
                            <MudSwitch @bind-Value="_collectionForm.IsPublished"
                                       Color="Color.Primary"
                                       Label="@PublishLabel" />
                            <MudText Typo="Typo.caption">
                                Storefront visibility state
                            </MudText>
                        </div>

                        <div class="commerce-collection-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Save"
                                       OnClick="SaveCollectionAsync"
                                       Disabled="@(!CanSaveCollection)">
                                Save collection
                            </MudButton>
                            @if (_editingCollectionId.HasValue)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Outlined.Unpublished"
                                           OnClick="@(() => UnpublishCollectionAsync(_editingCollectionId.Value))"
                                           Disabled="@(_saving || !_collectionForm.IsPublished)">
                                    Unpublish
                                </MudButton>
                            }
                        </div>
                    </PanelCard>
                </div>
            }
        </div>
    </PageBody>
</div>

@code {
    private static readonly TimeSpan CollectionsLoadTimeout = TimeSpan.FromSeconds(15);
    private const long MaxCollectionImageFileSize = 10 * 1024 * 1024;

    private readonly List<CommerceCollectionDto> _collections = [];
    private CommerceCollectionMutationRequest _collectionForm = new();
    private Guid? _editingCollectionId;
    private string? _originalCollectionHandle;
    private string? _collectionsLoadError;
    private bool _loadingCollections = true;
    private bool _saving;
    private bool _collectionImageUploading;
    private bool _handleManuallyEdited;
    private bool _collectionEditorOpen;

    private int PublishedCount => _collections.Count(collection => collection.IsPublished);

    private int DraftCount => _collections.Count - PublishedCount;

    private bool IsCollectionEditorOpen => _collectionEditorOpen;

    private string CollectionsLayoutClass => IsCollectionEditorOpen
        ? "commerce-collections-layout editor-open"
        : "commerce-collections-layout";

    private string SelectedCollectionLabel => IsCollectionEditorOpen
        ? (_editingCollectionId.HasValue ? "Editing" : "New")
        : "None";

    private string EditorTitle => _editingCollectionId.HasValue ? "Edit collection" : "New collection";

    private string EditorSubtitle => _editingCollectionId.HasValue
        ? "Title, URL slug, description, and publishing state."
        : "Collection identity and publishing state.";

    private string PublishLabel => _collectionForm.IsPublished ? "Published" : "Draft";

    private string CollectionImagePreviewAlt => string.IsNullOrWhiteSpace(_collectionForm.ImageAltText)
        ? _collectionForm.Title
        : _collectionForm.ImageAltText;

    private bool ShowCollectionHandleError => !string.IsNullOrWhiteSpace(_collectionForm.Handle)
        && !string.Equals(_collectionForm.Handle, BuildCollectionHandle(_collectionForm.Handle), StringComparison.Ordinal);

    private bool HandleChangedForPublishedCollection => _editingCollectionId.HasValue
        && _collectionForm.IsPublished
        && !string.IsNullOrWhiteSpace(_originalCollectionHandle)
        && !string.Equals(_originalCollectionHandle, _collectionForm.Handle, StringComparison.OrdinalIgnoreCase);

    private bool CanSaveCollection => !_saving
        && !string.IsNullOrWhiteSpace(_collectionForm.Title)
        && !string.IsNullOrWhiteSpace(_collectionForm.Handle)
        && !ShowCollectionHandleError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionsAsync();
    }

    private async Task LoadCollectionsAsync()
    {
        _loadingCollections = true;
        _collectionsLoadError = null;
        using var timeout = new CancellationTokenSource(CollectionsLoadTimeout);

        try
        {
            var response = await Http.GetFromJsonAsync<List<CommerceCollectionDto>>("api/v1/commerce/collections", timeout.Token);
            _collections.Clear();
            _collections.AddRange(response ?? []);
        }
        catch (OperationCanceledException) when (timeout.IsCancellationRequested)
        {
            _collectionsLoadError = "Product collections are taking too long to load.";
        }
        catch (Exception)
        {
            _collectionsLoadError = "Product collections could not be loaded.";
        }
        finally
        {
            _loadingCollections = false;
        }
    }

    private async Task SaveCollectionAsync()
    {
        EnsureCollectionHandle();
        if (!CanSaveCollection)
        {
            return;
        }

        _saving = true;
        try
        {
            HttpResponseMessage response;
            if (_editingCollectionId.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/v1/commerce/collections/{_editingCollectionId.Value}", _collectionForm);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/v1/commerce/collections", _collectionForm);
            }

            response.EnsureSuccessStatusCode();
            var savedCollection = await response.Content.ReadFromJsonAsync<CommerceCollectionDto>();
            Snackbar.Add("Collection saved.", Severity.Success);
            await LoadCollectionsAsync();

            if (savedCollection is not null)
            {
                SelectCollection(savedCollection);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to save collection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UnpublishCollectionAsync(Guid collectionId)
    {
        _saving = true;
        try
        {
            using var response = await Http.DeleteAsync($"api/v1/commerce/collections/{collectionId}");
            response.EnsureSuccessStatusCode();
            Snackbar.Add("Collection unpublished.", Severity.Success);
            await LoadCollectionsAsync();

            if (_editingCollectionId == collectionId)
            {
                _collectionForm.IsPublished = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to unpublish collection: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadCollectionImageFilesAsync(IReadOnlyList<IBrowserFile> files)
    {
        var file = files.FirstOrDefault(IsAcceptedCollectionImageFile);
        if (file is null)
        {
            Snackbar.Add("Select a JPG, PNG, or WEBP image up to 10 MB.", Severity.Warning);
            return;
        }

        _collectionImageUploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(MaxCollectionImageFileSize);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(GetCollectionImageContentType(file));
            content.Add(fileContent, "files", file.Name);

            EnsureCollectionHandle();
            var handle = string.IsNullOrWhiteSpace(_collectionForm.Handle) ? "draft" : _collectionForm.Handle;
            var response = await Http.PostAsync($"api/v1/commerce/collections/media?handle={Uri.EscapeDataString(handle)}", content);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Collection image upload failed.", Severity.Warning);
                return;
            }

            var uploads = await response.Content.ReadFromJsonAsync<List<BffUploadResponse>>() ?? [];
            var upload = uploads.FirstOrDefault();
            var imageUrl = FirstNonEmpty(upload?.FileReference, upload?.SignedUrl, upload?.StoragePath);
            if (string.IsNullOrWhiteSpace(imageUrl))
            {
                Snackbar.Add("Collection image upload returned no image reference.", Severity.Warning);
                return;
            }

            _collectionForm.ImageUrl = imageUrl;
            if (string.IsNullOrWhiteSpace(_collectionForm.ImageAltText))
            {
                _collectionForm.ImageAltText = BuildDefaultCollectionImageAltText(upload?.FileName);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Collection image upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _collectionImageUploading = false;
        }
    }

    private void RemoveCollectionImage()
    {
        _collectionForm.ImageUrl = null;
        _collectionForm.ImageAltText = null;
    }

    private void StartNewCollection()
    {
        _collectionEditorOpen = true;
        _editingCollectionId = null;
        _originalCollectionHandle = null;
        _handleManuallyEdited = false;
        _collectionForm = new CommerceCollectionMutationRequest();
    }

    private void SelectCollection(CommerceCollectionDto collection)
    {
        _collectionEditorOpen = true;
        _editingCollectionId = collection.Id;
        _originalCollectionHandle = collection.Handle;
        _handleManuallyEdited = true;
        _collectionForm = new CommerceCollectionMutationRequest
        {
            Handle = collection.Handle,
            Title = collection.Title,
            Description = collection.Description,
            ImageUrl = collection.ImageUrl,
            ImageAltText = collection.ImageAltText,
            IsPublished = collection.IsPublished
        };
    }

    private void CloseCollectionEditor()
    {
        _collectionEditorOpen = false;
        _editingCollectionId = null;
        _originalCollectionHandle = null;
        _handleManuallyEdited = false;
        _collectionForm = new CommerceCollectionMutationRequest();
    }

    private void OnCollectionTitleChanged(string title)
    {
        _collectionForm.Title = title ?? string.Empty;
        if ((!_editingCollectionId.HasValue && !_handleManuallyEdited) || string.IsNullOrWhiteSpace(_collectionForm.Handle))
        {
            _collectionForm.Handle = BuildCollectionHandle(_collectionForm.Title);
        }
    }

    private void OnCollectionHandleChanged(string handle)
    {
        OnCollectionStorefrontSlugChanged(handle);
    }

    private void OnCollectionStorefrontSlugInput(ChangeEventArgs args)
    {
        OnCollectionStorefrontSlugChanged(args.Value?.ToString() ?? string.Empty);
    }

    private void OnCollectionStorefrontSlugChanged(string handle)
    {
        _handleManuallyEdited = true;
        _collectionForm.Handle = BuildCollectionHandle(ExtractCollectionSlugInput(handle));
    }

    private void EnsureCollectionHandle()
    {
        var normalized = BuildCollectionHandle(_collectionForm.Handle);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            normalized = BuildCollectionHandle(_collectionForm.Title);
        }

        _collectionForm.Handle = normalized;
    }

    private static string BuildCollectionHandle(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var builder = new System.Text.StringBuilder();
        var lastWasHyphen = false;
        foreach (var character in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                lastWasHyphen = false;
                continue;
            }

            if ((char.IsWhiteSpace(character) || character is '-' or '_') && !lastWasHyphen && builder.Length > 0)
            {
                builder.Append('-');
                lastWasHyphen = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private static string ExtractCollectionSlugInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        const string collectionQueryKey = "collection=";
        var queryIndex = trimmed.IndexOf(collectionQueryKey, StringComparison.OrdinalIgnoreCase);
        if (queryIndex >= 0)
        {
            trimmed = trimmed[(queryIndex + collectionQueryKey.Length)..];
        }

        var queryEnd = trimmed.IndexOfAny(['&', '#', '?']);
        return queryEnd >= 0 ? trimmed[..queryEnd] : trimmed;
    }

    private static bool IsAcceptedCollectionImageFile(IBrowserFile file)
    {
        if (file.Size is <= 0 or > MaxCollectionImageFileSize)
        {
            return false;
        }

        var extension = Path.GetExtension(file.Name);
        return extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".png", StringComparison.OrdinalIgnoreCase)
            || extension.Equals(".webp", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetCollectionImageContentType(IBrowserFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType)
            && file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return file.ContentType;
        }

        return Path.GetExtension(file.Name).ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".webp" => "image/webp",
            _ => "application/octet-stream"
        };
    }

    private string BuildDefaultCollectionImageAltText(string? fileName)
    {
        if (!string.IsNullOrWhiteSpace(_collectionForm.Title))
        {
            return $"{_collectionForm.Title} collection image";
        }

        var name = Path.GetFileNameWithoutExtension(fileName);
        return string.IsNullOrWhiteSpace(name)
            ? "Collection image"
            : $"{name.Replace('-', ' ').Replace('_', ' ')} image";
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    }

    private void BackToCatalog()
    {
        Navigation.NavigateTo("/commerce/catalog");
    }

    private string CollectionRowClass(CommerceCollectionDto collection)
    {
        return _editingCollectionId == collection.Id
            ? "commerce-collection-row selected"
            : "commerce-collection-row";
    }

    private static string CollectionStatus(CommerceCollectionDto collection)
    {
        return collection.IsPublished ? "Published" : "Draft";
    }

    private static string CollectionDescription(CommerceCollectionDto collection)
    {
        return string.IsNullOrWhiteSpace(collection.Description)
            ? "No description set."
            : collection.Description;
    }

    private static string CollectionImageAlt(CommerceCollectionDto collection)
    {
        return string.IsNullOrWhiteSpace(collection.ImageAltText)
            ? collection.Title
            : collection.ImageAltText;
    }
}
