@page "/hr/time-off"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Time Off - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Time Off Management</MudText>

<MudGrid Class="mb-4">
    @if (_isLoading)
    {
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded-lg" />
            </MudItem>
        }
    }
    else
    {
        @foreach (var balance in _balances)
        {
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@balance.LeaveType</MudText>
                            <MudText Typo="Typo.h5" Class="mt-2" Color="Color.Primary" Style="font-weight: 700;">@balance.Available days</MudText>
                        </div>
                        <MudIcon Icon="@GetLeaveIcon(balance.LeaveType)" Size="Size.Large" Color="Color.Default" Style="opacity: 0.3;" />
                    </MudStack>
                    <MudProgressLinear Color="Color.Primary" Value="@((double)(balance.Used / balance.Entitlement * 100))" Class="mt-3" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@balance.Used of @balance.Entitlement used</MudText>
                </MudPaper>
            </MudItem>
        }
    }
</MudGrid>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">My Leave Requests</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@OpenRequestDialog">Request Leave</MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="LeaveRequestSummaryDto" Items="@_requests" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.LeaveType" Title="Type" />
                <PropertyColumn Property="x => x.StartDate" Title="Start" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.EndDate" Title="End" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.Days" Title="Days" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ApproverName" Title="Approver" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Status == "Pending")
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" Color="Color.Error" OnClick="@(() => CancelRequest(context.Item))" />
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Secondary">No leave requests found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private List<LeaveRequestSummaryDto> _requests = new();
    private List<LeaveBalanceDto> _balances = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var balancesTask = Http.GetFromJsonAsync<List<LeaveBalanceDto>>("api/timeoff/balances");
            var requestsTask = Http.GetFromJsonAsync<List<LeaveRequestSummaryDto>>("api/timeoff/requests");

            await Task.WhenAll(balancesTask, requestsTask);

            _balances = await balancesTask ?? new();
            _requests = await requestsTask ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading time off data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenRequestDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LeaveRequestDialog>("Request Leave", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
            Snackbar.Add("Leave request submitted successfully", Severity.Success);
        }
    }

    private async Task CancelRequest(LeaveRequestSummaryDto request)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Cancel Leave Request",
            $"Are you sure you want to cancel your {request.LeaveType} leave request?",
            yesText: "Yes, Cancel", noText: "Keep");
        
        if (confirm != true) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/timeoff/requests/{request.Id}/cancel", new { });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Leave request cancelled", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Failed to cancel request", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "Cancelled" => Color.Default,
        _ => Color.Default
    };

    private string GetLeaveIcon(string type) => type switch
    {
        "Annual" => Icons.Material.Outlined.BeachAccess,
        "Sick" => Icons.Material.Outlined.Sick,
        "Personal" => Icons.Material.Outlined.Person,
        _ => Icons.Material.Outlined.EventAvailable
    };
}


