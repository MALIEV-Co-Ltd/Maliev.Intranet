@page "/hr/employees/{Id:guid}"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Employee Details - Maliev Intranet</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_employee == null)
{
    <MudAlert Severity="Severity.Error">Employee not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/hr/employees"))">
        Back to Directory
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudAvatar Size="Size.Large" Color="Color.Primary">@_employee.FirstName[0]</MudAvatar>
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.h5">@_employee.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_employee.Status)">
                            @_employee.Status
                        </MudChip>
                    </MudStack>
                    <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">@_employee.Title • @_employee.Department</MudText>
                </div>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Outlined.Edit"
                           OnClick="@OpenEditDialog">
                    Edit Profile
                </MudButton>
                @if (_employee.Status == "Active")
                {
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Error" 
                               StartIcon="@Icons.Material.Outlined.PersonOff"
                               OnClick="@TerminateEmployee">
                        Terminate
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mt-4">
        <MudTabPanel Text="Personal Info" Icon="@Icons.Material.Outlined.Person">
            <MudGrid Class="pa-4">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Employment Details</MudText>
                        <MudList T="string">
                            <MudListItem Text="Employee ID" SecondaryText="@_employee.Id.ToString()" Icon="@Icons.Material.Outlined.Badge" />
                            <MudListItem Text="Hire Date" SecondaryText="@(_employee.HireDate?.ToString("dd MMM yyyy") ?? "N/A")" Icon="@Icons.Material.Outlined.Event" />
                            <MudListItem Text="Manager" SecondaryText="@(_employee.ManagerName ?? "N/A")" Icon="@Icons.Material.Outlined.AccountTree" />
                            <MudListItem Text="Location" SecondaryText="@(_employee.WorkLocation ?? "N/A")" Icon="@Icons.Material.Outlined.LocationOn" />
                            <MudListItem Text="Type" SecondaryText="@(_employee.EmployeeType ?? "N/A")" Icon="@Icons.Material.Outlined.WorkOutline" />
                        </MudList>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Contact Information</MudText>
                        <MudList T="string">
                            <MudListItem Text="Email" SecondaryText="@_employee.Email" Icon="@Icons.Material.Outlined.Email" />
                            <MudListItem Text="Phone" SecondaryText="@(_employee.Phone ?? "N/A")" Icon="@Icons.Material.Outlined.Phone" />
                        </MudList>
                        
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Emergency Contacts</MudText>
                        @if (_employee.EmergencyContacts.Any())
                        {
                            @foreach (var contact in _employee.EmergencyContacts)
                            {
                                <MudStack Spacing="1" Class="mb-2 pa-2 border rounded-lg mud-border-lines-default">
                                    <MudText Typo="Typo.body2"><strong>@contact.Name</strong> (@contact.Relationship)</MudText>
                                    <MudText Typo="Typo.caption"><MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" /> @contact.Phone</MudText>
                                </MudStack>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">No emergency contacts listed.</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Teams" Icon="@Icons.Material.Outlined.Groups">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Team Assignments</MudText>
                @if (_employee.Teams.Any())
                {
                    <MudTable Items="@_employee.Teams" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Team Name</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Is Lead</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Team Name">@context.Name</MudTd>
                            <MudTd DataLabel="Role">@context.Role</MudTd>
                            <MudTd DataLabel="Is Lead">
                                @if (context.IsLead)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                }
                            </MudTd>
                            <MudTd Style="text-align: right;">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Details</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">This employee is not currently assigned to any teams.</MudText>
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Notes" Icon="@Icons.Material.Outlined.StickyNote2">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Internal HR Notes</MudText>

                <MudStack Spacing="3">
                    @foreach (var note in _employee.Notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <div class="note-item pa-3 border rounded-lg mud-border-lines-default">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small" Color="Color.Default">@note.Author[0]</MudAvatar>
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@note.Author</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@note.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2" Class="mt-2">@note.Content</MudText>
                        </div>
                    }

                    <div class="mt-4">
                        <MudTextField @bind-Value="_newNoteContent"
                                      Placeholder="Add a sensitive HR note..."
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="mt-2"
                                   OnClick="@AddNote"
                                   Disabled="@string.IsNullOrWhiteSpace(_newNoteContent)">
                            Save Note
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Employment History" Icon="@Icons.Material.Outlined.WorkHistory">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Role History</MudText>
                @if (_employee.EmploymentHistory.Any())
                {
                    <MudTimeline TimelinePosition="TimelinePosition.Left">
                        @foreach (var history in _employee.EmploymentHistory.OrderByDescending(h => h.StartDate))
                        {
                            <MudTimelineItem Color="@(history.EndDate == null ? Color.Primary : Color.Default)"
                                            Icon="@Icons.Material.Outlined.Work"
                                            Size="Size.Small">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@history.Position</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@history.Department</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @history.StartDate.ToString("MMM yyyy") —
                                        @(history.EndDate.HasValue ? history.EndDate.Value.ToString("MMM yyyy") : "Present")
                                    </MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
                else
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No employment history recorded.</MudText>
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Documents" Icon="@Icons.Material.Outlined.FolderOpen">
            <MudPaper Elevation="0" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.h6">Employee Documents</MudText>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Size="Size.Small">Upload Document</MudButton>
                </MudStack>

                @if (_employee.Documents.Any())
                {
                    <MudTable Items="@_employee.Documents" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>File Name</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Uploaded</MudTh>
                            <MudTh>Uploaded By</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="File Name">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@context.FileName</MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Size="Size.Small">@context.DocumentType</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Uploaded">@context.UploadedAt.ToString("dd MMM yyyy")</MudTd>
                            <MudTd DataLabel="Uploaded By">@context.UploadedBy</MudTd>
                            <MudTd Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-4 mud-text-secondary">No documents uploaded.</MudText>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private EmployeeDetailDto? _employee;
    private string _newNoteContent = "";
    private List<BreadcrumbItem> _breadcrumbs = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployee();

        _breadcrumbs = 
        [
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("HR", href: null, disabled: true),
            new BreadcrumbItem("Employees", href: "/hr/employees"),
            new BreadcrumbItem(_employee?.Name ?? "Detail", href: null, disabled: true)
        ];
    }

    private async Task LoadEmployee()
    {
        try
        {
            _isLoading = true;
            _employee = await Http.GetFromJsonAsync<EmployeeDetailDto>($"api/employees/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading employee: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditDialog()
    {
        if (_employee == null) return;

        var parameters = new DialogParameters<EditEmployeeDialog>
        {
            { x => x.EmployeeId, Id },
            { x => x.Employee, _employee }
        };
        var dialog = await DialogService.ShowAsync<EditEmployeeDialog>("Edit Employee Profile", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadEmployee();
        }
    }

    private async Task TerminateEmployee()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Terminate Employment",
            $"Are you sure you want to terminate the employment of {_employee?.Name}?",
            yesText: "Terminate", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var request = new TerminateEmployeeRequest { Reason = "User request" };
                var response = await Http.PostAsJsonAsync($"api/employees/{Id}/terminate", request);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Employment terminated", Severity.Warning);
                    await LoadEmployee();
                }
                else
                {
                    Snackbar.Add("Failed to terminate employment", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task AddNote()
    {
        if (string.IsNullOrWhiteSpace(_newNoteContent)) return;

        try
        {
            var request = new AddEmployeeNoteRequest { Content = _newNoteContent };
            var response = await Http.PostAsJsonAsync($"api/employees/{Id}/notes", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Note saved", Severity.Success);
                _newNoteContent = "";
                await LoadEmployee();
            }
            else
            {
                Snackbar.Add("Failed to save note", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving note: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "OnLeave" => Color.Warning,
        "Terminated" => Color.Error,
        "Probation" => Color.Info,
        _ => Color.Default
    };
}
