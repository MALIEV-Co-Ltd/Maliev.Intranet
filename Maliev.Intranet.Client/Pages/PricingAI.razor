@page "/sales/pricing-ai"
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Shared.Constants
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Pricing AI | Intranet Gateway</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 600;" Class="mb-2">Pricing AI</MudText>
<MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
    AI-powered pricing predictions based on material, process, and historical data
</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6 rounded-lg" Icon="@Icons.Material.Outlined.AutoAwesome">
    <MudText Typo="Typo.body2">
        <strong>AI-Powered Estimates:</strong> Prices are calculated using machine learning models trained on historical job data,
        material costs, and process parameters. Results are indicative and should be reviewed by a sales engineer
        before sending to customers. Confidence scores below 60% indicate limited historical data for this configuration.
    </MudText>
</MudAlert>

<MudGrid>
    <!-- Input Form (Left Panel) -->
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-4">Input Parameters</MudText>
            
            <MudStack Spacing="3">
                <MudAutocomplete T="MaterialSummaryDto" 
                                 Label="Material" 
                                 @bind-Value="_selectedMaterial" 
                                 SearchFunc="@SearchMaterials"
                                 ToStringFunc="@(m => m?.Name ?? "")"
                                 Variant="Variant.Outlined" 
                                 Margin="Margin.Dense"
                                 Required="true"
                                 DebounceInterval="300"
                                 Placeholder="Search materials..." />

                <MudSelect T="Guid" @bind-Value="_selectedProcessId" Label="Manufacturing Process" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    <MudSelectItem Value="@ManufacturingProcesses.Fdm3DPrinting">3D Printing (FDM)</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.Sla3DPrinting">3D Printing (SLA)</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.CncMachining">CNC Machining</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.SheetMetal">Sheet Metal Fabrication</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.InjectionMolding">Injection Molding</MudSelectItem>
                </MudSelect>

                <MudText Typo="Typo.subtitle2" Class="mt-2">Dimensions (mm)</MudText>
                <MudNumericField T="decimal" @bind-Value="_length" Label="Length (X)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />
                <MudNumericField T="decimal" @bind-Value="_width" Label="Width (Y)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />
                <MudNumericField T="decimal" @bind-Value="_height" Label="Height (Z)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />

                <MudNumericField T="int" @bind-Value="_quantity" Label="Quantity" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Analytics"
                           OnClick="@CalculatePricing"
                           Disabled="@(_isCalculating || _selectedMaterial == null || _selectedProcessId == Guid.Empty)"
                           Class="mt-4">
                    @if (_isCalculating)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Calculating...</span>
                    }
                    else
                    {
                        <span>Calculate Pricing</span>
                    }
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Results (Right Panel) -->
    <MudItem xs="12" md="7">
        @if (_isCalculating)
        {
            <MudStack Spacing="3">
                <!-- Skeleton: Predicted Price Card -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Predicted Price</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <MudSkeleton Width="180px" Height="52px" Animation="Animation.Wave" />
                        <MudSkeleton Width="80px" Height="24px" Animation="Animation.Wave" Class="mb-2" />
                    </MudStack>
                    <MudSkeleton Width="200px" Height="20px" Animation="Animation.Wave" Class="mt-3" />
                </MudPaper>

                <!-- Skeleton: Confidence Meter -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Confidence Level</MudText>
                    <MudSkeleton Height="16px" Animation="Animation.Wave" Class="mb-2" />
                    <MudSkeleton Width="280px" Height="16px" Animation="Animation.Wave" />
                </MudPaper>

                <!-- Skeleton: Cost Breakdown -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Cost Breakdown</MudText>
                    <MudStack Spacing="2">
                        @for (int i = 0; i < 7; i++)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudSkeleton Width="120px" Height="20px" Animation="Animation.Wave" />
                                <MudSkeleton Width="80px" Height="20px" Animation="Animation.Wave" />
                            </MudStack>
                        }
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudSkeleton Width="100px" Height="20px" Animation="Animation.Wave" />
                            <MudSkeleton Width="100px" Height="20px" Animation="Animation.Wave" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudStack>
        }
        else if (!_hasResults)
        {
            <MudPaper Elevation="0" Class="pa-12 border mud-border-lines-default rounded-lg d-flex flex-column align-center justify-center" Style="min-height: 500px;">
                <MudIcon Icon="@Icons.Material.Outlined.AutoGraph" Size="Size.Large" Color="Color.Default" Class="mb-4" Style="font-size: 80px;" />
                <MudText Typo="Typo.h6" Color="Color.Default" Align="Align.Center">Enter parameters and click Calculate</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center" Class="mt-2">
                    AI will analyze historical data and provide pricing recommendations
                </MudText>
            </MudPaper>
        }
        else if (_pricingResult != null)
        {
            <MudStack Spacing="3">
                <!-- Predicted Price Card -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Predicted Price</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <MudText Typo="Typo.h3" Color="Color.Primary" Style="font-weight: 700;">@CurrencyFormatter.Format(_pricingResult.TotalUnitPrice, "THB", 2)</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Default" Class="pb-1">THB per unit</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" /> 
                        Valid until @_pricingResult.ValidUntil.ToString("dd MMM yyyy")
                    </MudText>
                </MudPaper>

                <!-- Confidence Meter -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Confidence Level</MudText>
                    <MudProgressLinear Color="@GetConfidenceColor(_pricingResult.ConfidenceLevel)" Size="Size.Large" Value="@((double)_pricingResult.ConfidenceLevel * 100)" Class="mb-2" />
                    <MudText Typo="Typo.body2" Color="Color.Default">@(_pricingResult.ConfidenceLevel * 100)% confidence based on historical data and @_pricingResult.Strategy strategy</MudText>
                </MudPaper>

                <!-- Price Breakdown -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Cost Breakdown</MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Material Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@CurrencyFormatter.Format(_pricingResult.MaterialCost, "THB", 2)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Support Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@CurrencyFormatter.Format(_pricingResult.SupportMaterialCost, "THB", 2)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Machine Time Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@CurrencyFormatter.Format(_pricingResult.MachineTimeCost, "THB", 2)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Setup Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@CurrencyFormatter.Format(_pricingResult.SetupCost, "THB", 2)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Complexity Surcharge</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@CurrencyFormatter.Format(_pricingResult.ComplexitySurcharge, "THB", 2)</MudText>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Subtotal</MudText>
                            <MudText Typo="Typo.body2">@CurrencyFormatter.Format(_pricingResult.SubtotalBeforeMargin, "THB", 2)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Margin</MudText>
                            <MudText Typo="Typo.body2">@CurrencyFormatter.Format(_pricingResult.MarginAmount, "THB", 2)</MudText>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Total (Qty: @_quantity)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">@CurrencyFormatter.Format(_pricingResult.TotalPrice, "THB", 2)</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <!-- Actions -->
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="SaveSnapshot">
                        Save Snapshot
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAnalysis">
                        Export Analysis
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    </MudItem>
</MudGrid>

@code {
    private MaterialSummaryDto? _selectedMaterial;
    private Guid _selectedProcessId = ManufacturingProcesses.Fdm3DPrinting;
    private decimal _length = 100;
    private decimal _width = 50;
    private decimal _height = 30;
    private int _quantity = 1;
    
    private bool _isCalculating = false;
    private bool _hasResults = false;
    private PricingResultDto? _pricingResult;

    private async Task<IEnumerable<MaterialSummaryDto>> SearchMaterials(string value, CancellationToken token)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>("api/materials?pageSize=100");
            if (response?.Data == null) return [];
            
            if (string.IsNullOrEmpty(value))
                return response.Data;
                
            return response.Data.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }
        catch
        {
            return [];
        }
    }

    private async Task CalculatePricing()
    {
        if (_selectedMaterial == null || _selectedProcessId == Guid.Empty) return;

        _isCalculating = true;
        _hasResults = false;
        StateHasChanged();

        try
        {
            // Estimating volume from dimensions for the AI calculator
            decimal volume = _length * _width * _height / 1000m; // simple cubic volume cm3
            
            var request = new PricingRequestDto
            {
                FileId = Guid.Empty, // Ad-hoc calculation
                CustomerId = Guid.Empty, // Anonymous calculation
                MaterialId = _selectedMaterial.Id,
                MaterialCode = _selectedMaterial.SKU,
                ManufacturingProcessId = _selectedProcessId,
                ManufacturingProcessName = ManufacturingProcesses.GetName(_selectedProcessId),
                Quantity = _quantity,
                Geometry = new GeometryMetricsDto
                {
                    VolumeCm3 = volume,
                    SupportVolumeCm3 = volume * 0.15m, // 15% support estimate
                    SurfaceAreaCm2 = (_length * _width + _width * _height + _height * _length) * 2 / 100m,
                    BoundingBoxX = _length,
                    BoundingBoxY = _width,
                    BoundingBoxZ = _height,
                    IsManifold = true,
                    TriangleCount = 5000
                }
            };

            var response = await Http.PostAsJsonAsync("api/pricing/calculate", request);
            if (response.IsSuccessStatusCode)
            {
                _pricingResult = await response.Content.ReadFromJsonAsync<PricingResultDto>();
                _hasResults = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Calculation failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCalculating = false;
        }
    }

    private async Task ExportAnalysis()
    {
        if (_pricingResult == null || _selectedMaterial == null) return;

        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Maliev Pricing Analysis Export");
            sb.AppendLine($"Generated: {DateTime.Now:yyyy-MM-dd HH:mm}");
            sb.AppendLine();
            sb.AppendLine("INPUT PARAMETERS");
            sb.AppendLine($"Material: {_selectedMaterial.Name} ({_selectedMaterial.SKU})");
            sb.AppendLine($"Process: {ManufacturingProcesses.GetName(_selectedProcessId)}");
            sb.AppendLine($"Dimensions: {_length} x {_width} x {_height} mm");
            sb.AppendLine($"Quantity: {_quantity}");
            sb.AppendLine();
            sb.AppendLine("COST BREAKDOWN");
            sb.AppendLine($"Material Cost: {_pricingResult.MaterialCost:N2} THB");
            sb.AppendLine($"Support Cost: {_pricingResult.SupportMaterialCost:N2} THB");
            sb.AppendLine($"Machine Time Cost: {_pricingResult.MachineTimeCost:N2} THB");
            sb.AppendLine($"Setup Cost: {_pricingResult.SetupCost:N2} THB");
            sb.AppendLine($"Complexity Surcharge: {_pricingResult.ComplexitySurcharge:N2} THB");
            sb.AppendLine($"Subtotal: {_pricingResult.SubtotalBeforeMargin:N2} THB");
            sb.AppendLine($"Margin: {_pricingResult.MarginAmount:N2} THB");
            sb.AppendLine();
            sb.AppendLine("SUMMARY");
            sb.AppendLine($"Unit Price: {_pricingResult.TotalUnitPrice:N2} THB");
            sb.AppendLine($"Total Price (Qty {_quantity}): {_pricingResult.TotalPrice:N2} THB");
            sb.AppendLine($"Confidence: {_pricingResult.ConfidenceLevel * 100:N0}%");
            sb.AppendLine($"Strategy: {_pricingResult.Strategy}");
            sb.AppendLine($"Valid Until: {_pricingResult.ValidUntil:dd MMM yyyy}");

            var csv = sb.ToString();
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"pricing-analysis-{DateTime.Now:yyyyMMdd-HHmm}.txt";

            await JSRuntime.InvokeVoidAsync("eval", $@"
                const link = document.createElement('a');
                link.href = 'data:text/plain;base64,{base64}';
                link.download = '{fileName}';
                link.click();
            ");
            Snackbar.Add("Analysis exported successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveSnapshot()
    {
        if (_pricingResult == null || _selectedMaterial == null) return;

        try
        {
            var request = new CreatePricingSnapshotRequest
            {
                OrderId = "Ad-Hoc",
                Technology = ManufacturingProcesses.GetName(_selectedProcessId),
                MaterialCode = _selectedMaterial.SKU,
                CalculatedPrice = _pricingResult.TotalUnitPrice,
                Status = "Draft"
            };

            var response = await Http.PostAsJsonAsync("api/pricing/snapshots", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Pricing snapshot saved", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to save snapshot", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving snapshot: {ex.Message}", Severity.Error);
        }
    }

    private Color GetConfidenceColor(decimal confidence)
    {
        if (confidence >= 0.8m) return Color.Success;
        if (confidence >= 0.5m) return Color.Warning;
        return Color.Error;
    }
}
