@page "/sales/pricing-ai"
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Shared.Constants
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Pricing AI - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Pricing AI</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    AI-powered pricing predictions based on material, process, and historical data
</MudText>

<MudGrid>
    <!-- Input Form (Left Panel) -->
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-4">Input Parameters</MudText>
            
            <MudStack Spacing="3">
                <MudAutocomplete T="MaterialSummaryDto" 
                                 Label="Material" 
                                 @bind-Value="_selectedMaterial" 
                                 SearchFunc="@SearchMaterials"
                                 ToStringFunc="@(m => m?.Name ?? "")"
                                 Variant="Variant.Outlined" 
                                 Margin="Margin.Dense"
                                 Required="true"
                                 Placeholder="Search materials..." />

                <MudSelect T="Guid" @bind-Value="_selectedProcessId" Label="Manufacturing Process" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    <MudSelectItem Value="@ManufacturingProcesses.Fdm3DPrinting">3D Printing (FDM)</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.Sla3DPrinting">3D Printing (SLA)</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.CncMachining">CNC Machining</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.SheetMetal">Sheet Metal Fabrication</MudSelectItem>
                    <MudSelectItem Value="@ManufacturingProcesses.InjectionMolding">Injection Molding</MudSelectItem>
                </MudSelect>

                <MudText Typo="Typo.subtitle2" Class="mt-2">Dimensions (mm)</MudText>
                <MudNumericField T="decimal" @bind-Value="_length" Label="Length (X)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />
                <MudNumericField T="decimal" @bind-Value="_width" Label="Width (Y)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />
                <MudNumericField T="decimal" @bind-Value="_height" Label="Height (Z)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1m" Step="0.1m" />

                <MudNumericField T="int" @bind-Value="_quantity" Label="Quantity" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Analytics"
                           OnClick="@CalculatePricing"
                           Disabled="@(_isCalculating || _selectedMaterial == null || _selectedProcessId == Guid.Empty)"
                           Class="mt-4">
                    @if (_isCalculating)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Calculating...</span>
                    }
                    else
                    {
                        <span>Calculate Pricing</span>
                    }
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Results (Right Panel) -->
    <MudItem xs="12" md="7">
        @if (!_hasResults)
        {
            <MudPaper Elevation="0" Class="pa-12 border mud-border-lines-default rounded-lg d-flex flex-column align-center justify-center" Style="min-height: 500px;">
                <MudIcon Icon="@Icons.Material.Outlined.AutoGraph" Size="Size.Large" Color="Color.Secondary" Class="mb-4" Style="font-size: 80px;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Align="Align.Center">Enter parameters and click Calculate</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                    AI will analyze historical data and provide pricing recommendations
                </MudText>
            </MudPaper>
        }
        else if (_pricingResult != null)
        {
            <MudStack Spacing="3">
                <!-- Predicted Price Card -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Predicted Price</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <MudText Typo="Typo.h3" Color="Color.Primary" Style="font-weight: 700;">฿@_pricingResult.TotalUnitPrice.ToString("N2")</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="pb-1">THB per unit</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Info" Class="mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" /> 
                        Valid until @_pricingResult.ValidUntil.ToString("dd MMM yyyy")
                    </MudText>
                </MudPaper>

                <!-- Confidence Meter -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Confidence Level</MudText>
                    <MudProgressLinear Color="@GetConfidenceColor(_pricingResult.ConfidenceLevel)" Size="Size.Large" Value="@((double)_pricingResult.ConfidenceLevel * 100)" Class="mb-2" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(_pricingResult.ConfidenceLevel * 100)% confidence based on historical data and @_pricingResult.Strategy strategy</MudText>
                </MudPaper>

                <!-- Price Breakdown -->
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Cost Breakdown</MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Material Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">฿@_pricingResult.MaterialCost.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Support Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">฿@_pricingResult.SupportMaterialCost.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Machine Time Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">฿@_pricingResult.MachineTimeCost.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Setup Cost</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">฿@_pricingResult.SetupCost.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Complexity Surcharge</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">฿@_pricingResult.ComplexitySurcharge.ToString("N2")</MudText>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Subtotal</MudText>
                            <MudText Typo="Typo.body2">฿@_pricingResult.SubtotalBeforeMargin.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">Margin</MudText>
                            <MudText Typo="Typo.body2">฿@_pricingResult.MarginAmount.ToString("N2")</MudText>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Total (Qty: @_quantity)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight: 700;">฿@_pricingResult.TotalPrice.ToString("N2")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <!-- Actions -->
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="SaveSnapshot">
                        Save Snapshot
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download">
                        Export Analysis
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    </MudItem>
</MudGrid>

@code {
    private MaterialSummaryDto? _selectedMaterial;
    private Guid _selectedProcessId = ManufacturingProcesses.Fdm3DPrinting;
    private decimal _length = 100;
    private decimal _width = 50;
    private decimal _height = 30;
    private int _quantity = 1;
    
    private bool _isCalculating = false;
    private bool _hasResults = false;
    private PricingResultDto? _pricingResult;

    private async Task<IEnumerable<MaterialSummaryDto>> SearchMaterials(string value, CancellationToken token)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<MaterialSummaryDto>>("api/materials?pageSize=100");
            if (response?.Data == null) return [];
            
            if (string.IsNullOrEmpty(value))
                return response.Data;
                
            return response.Data.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }
        catch
        {
            return [];
        }
    }

    private async Task CalculatePricing()
    {
        if (_selectedMaterial == null || _selectedProcessId == Guid.Empty) return;

        _isCalculating = true;
        _hasResults = false;
        StateHasChanged();

        try
        {
            // Estimating volume from dimensions for the AI calculator
            decimal volume = _length * _width * _height / 1000m; // simple cubic volume cm3
            
            var request = new PricingRequestDto
            {
                FileId = Guid.Empty, // Ad-hoc calculation
                CustomerId = Guid.Empty, // Anonymous calculation
                MaterialId = _selectedMaterial.Id,
                MaterialCode = _selectedMaterial.Code,
                ManufacturingProcessId = _selectedProcessId,
                ManufacturingProcessName = ManufacturingProcesses.GetName(_selectedProcessId),
                Quantity = _quantity,
                Geometry = new GeometryMetricsDto
                {
                    VolumeCm3 = volume,
                    SupportVolumeCm3 = volume * 0.15m, // 15% support estimate
                    SurfaceAreaCm2 = (_length * _width + _width * _height + _height * _length) * 2 / 100m,
                    BoundingBoxX = _length,
                    BoundingBoxY = _width,
                    BoundingBoxZ = _height,
                    IsManifold = true,
                    TriangleCount = 5000
                }
            };

            var response = await Http.PostAsJsonAsync("api/pricing/calculate", request);
            if (response.IsSuccessStatusCode)
            {
                _pricingResult = await response.Content.ReadFromJsonAsync<PricingResultDto>();
                _hasResults = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Calculation failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCalculating = false;
        }
    }

    private async Task SaveSnapshot()
    {
        if (_pricingResult == null || _selectedMaterial == null) return;

        try
        {
            var request = new CreatePricingSnapshotRequest
            {
                OrderId = "Ad-Hoc",
                Technology = ManufacturingProcesses.GetName(_selectedProcessId),
                MaterialCode = _selectedMaterial.Code,
                CalculatedPrice = _pricingResult.TotalUnitPrice,
                Status = "Draft"
            };

            var response = await Http.PostAsJsonAsync("api/pricing/snapshots", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Pricing snapshot saved", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to save snapshot", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving snapshot: {ex.Message}", Severity.Error);
        }
    }

    private Color GetConfidenceColor(decimal confidence)
    {
        if (confidence >= 0.8m) return Color.Success;
        if (confidence >= 0.5m) return Color.Warning;
        return Color.Error;
    }
}
