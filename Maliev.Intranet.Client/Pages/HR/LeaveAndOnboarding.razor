@page "/hr/leave"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Leave & Onboarding | Intranet Gateway</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 600;">Leave &amp; Onboarding</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Time off requests, balances, and employee onboarding</MudText>
    </div>
</MudStack>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: Time Off -->
    <MudTabPanel Text="Time Off" Icon="@Icons.Material.Outlined.EventBusy">
        <MudGrid Class="mb-4">
            @if (_timeOffLoading)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded-lg" />
                    </MudItem>
                }
            }
            else
            {
                @foreach (var balance in _balances)
                {
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Default">@balance.LeaveType</MudText>
                                    <MudText Typo="Typo.h5" Class="mt-2" Color="Color.Primary" Style="font-weight: 700;">@balance.Available days</MudText>
                                </div>
                                <MudIcon Icon="@GetLeaveIcon(balance.LeaveType)" Size="Size.Large" Color="Color.Default" Style="opacity: 0.3;" />
                            </MudStack>
                            <MudProgressLinear Color="Color.Primary" Value="@((double)(balance.Used / balance.Entitlement * 100))" Class="mt-3" />
                            <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-1">@balance.Used of @balance.Entitlement used</MudText>
                        </MudPaper>
                    </MudItem>
                }
            }
        </MudGrid>

        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">My Leave Requests</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@OpenRequestDialog">Request Leave</MudButton>
            </MudStack>
        </MudPaper>

        @if (_timeOffLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="LeaveRequestSummaryDto" Items="@_leaveRequests" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.LeaveType" Title="Type" />
                        <PropertyColumn Property="x => x.StartDate" Title="Start" Format="dd MMM yyyy" />
                        <PropertyColumn Property="x => x.EndDate" Title="End" Format="dd MMM yyyy" />
                        <PropertyColumn Property="x => x.Days" Title="Days" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@GetLeaveStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.ApproverName" Title="Approver" />
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                @if (context.Item.Status == "Pending")
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" Color="Color.Error" OnClick="@(() => CancelLeaveRequest(context.Item))" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No leave requests found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- TAB 1: Onboarding -->
    <MudTabPanel Text="Onboarding" Icon="@Icons.Material.Outlined.PersonAdd">
        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_onboardingSearch" Placeholder="Search employees..." Variant="Variant.Outlined"
                              Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 300px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@StartNewOnboarding">New Onboarding</MudButton>
            </MudStack>
        </MudPaper>

        @if (_onboardingLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg" />
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="OnboardingSummaryDto" Items="@_onboardings" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.EmployeeName" Title="Employee" />
                        <PropertyColumn Property="x => x.Department" Title="Department" />
                        <PropertyColumn Property="x => x.StartDate" Title="Start Date" Format="dd MMM yyyy" />
                        <TemplateColumn Title="Progress">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudProgressLinear Color="Color.Primary" Value="@context.Item.Progress" Size="Size.Small" Style="min-width: 100px;" />
                                    <MudText Typo="Typo.caption">@context.Item.Progress%</MudText>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Buddy" Title="Buddy" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip Size="Size.Small" Color="@GetOnboardingStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => ViewChecklist(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No onboarding records found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // Time Off state
    private bool _timeOffLoading = true;
    private List<LeaveRequestSummaryDto> _leaveRequests = new();
    private List<LeaveBalanceDto> _balances = new();

    // Onboarding state
    private bool _onboardingLoading = true;
    private string _onboardingSearch = "";
    private List<OnboardingSummaryDto> _onboardings = new();

    /// <summary>
    /// Initializes the Leave and Onboarding page, loading data for both tabs in parallel.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["tab"] == "timeoff") _activeTab = 0;
        else if (query["tab"] == "onboarding") _activeTab = 1;

        await Task.WhenAll(LoadTimeOffData(), LoadOnboardingData());
    }

    private async Task LoadTimeOffData()
    {
        try
        {
            _timeOffLoading = true;
            var balancesTask = Http.GetFromJsonAsync<List<LeaveBalanceDto>>("api/timeoff/balances");
            var requestsTask = Http.GetFromJsonAsync<List<LeaveRequestSummaryDto>>("api/timeoff/requests");
            await Task.WhenAll(balancesTask, requestsTask);
            _balances = await balancesTask ?? new();
            _leaveRequests = await requestsTask ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Error loading time off data: {ex.Message}", Severity.Error); }
        finally { _timeOffLoading = false; }
    }

    private async Task LoadOnboardingData()
    {
        try
        {
            _onboardingLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<OnboardingSummaryDto>>("api/onboarding");
            _onboardings = response?.Data.ToList() ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Error loading onboarding data: {ex.Message}", Severity.Error); }
        finally { _onboardingLoading = false; }
    }

    private async Task OpenRequestDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LeaveRequestDialog>("Request Leave", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await LoadTimeOffData(); Snackbar.Add("Leave request submitted successfully", Severity.Success); }
    }

    private async Task CancelLeaveRequest(LeaveRequestSummaryDto request)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Leave Request",
            $"Are you sure you want to cancel your {request.LeaveType} leave request?",
            yesText: "Yes, Cancel", noText: "Keep");
        if (confirm != true) return;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/timeoff/requests/{request.Id}/cancel", new { });
            if (response.IsSuccessStatusCode) { Snackbar.Add("Leave request cancelled", Severity.Success); await LoadTimeOffData(); }
            else { Snackbar.Add("Failed to cancel request", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private async Task ViewChecklist(OnboardingSummaryDto onboarding)
    {
        try
        {
            var checklist = await Http.GetFromJsonAsync<OnboardingChecklistDto>($"api/onboarding/{onboarding.EmployeeId}/checklist");
            if (checklist == null) { Snackbar.Add("No checklist found", Severity.Warning); return; }
            var parameters = new DialogParameters<OnboardingChecklistDialog>
            {
                { x => x.Checklist, checklist },
                { x => x.EmployeeName, onboarding.EmployeeName }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            await DialogService.ShowAsync<OnboardingChecklistDialog>($"{onboarding.EmployeeName} - Onboarding Checklist", parameters, options);
        }
        catch (Exception ex) { Snackbar.Add($"Error loading checklist: {ex.Message}", Severity.Error); }
    }

    private async Task StartNewOnboarding()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<StartOnboardingDialog>("Start New Onboarding", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await LoadOnboardingData(); Snackbar.Add("Onboarding started successfully", Severity.Success); }
    }

    private Color GetLeaveStatusColor(string status) => status switch
    {
        "Pending" => Color.Warning, "Approved" => Color.Success, "Rejected" => Color.Error, "Cancelled" => Color.Default, _ => Color.Default
    };

    private Color GetOnboardingStatusColor(string status) => status switch
    {
        "Pre-Start" => Color.Info, "In Progress" => Color.Primary, "Complete" => Color.Success, "Delayed" => Color.Error, _ => Color.Default
    };

    private string GetLeaveIcon(string type) => type switch
    {
        "Annual" => Icons.Material.Outlined.BeachAccess,
        "Sick" => Icons.Material.Outlined.Sick,
        "Personal" => Icons.Material.Outlined.Person,
        _ => Icons.Material.Outlined.EventAvailable
    };
}
