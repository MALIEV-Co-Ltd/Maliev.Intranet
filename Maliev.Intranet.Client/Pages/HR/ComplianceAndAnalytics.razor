@page "/hr/compliance"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Compliance & Analytics - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 600;">Compliance &amp; Analytics</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Work authorizations, document compliance, and HR analytics</MudText>
    </div>
</MudStack>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: Compliance -->
    <MudTabPanel Text="Compliance" Icon="@Icons.Material.Outlined.VerifiedUser">
        <MudGrid Class="mb-4">
            @if (_complianceLoading)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded-lg" />
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-4 border border-error rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Error">Expiring in 30 days</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Error" Class="mt-2">@_complianceStats.Expiring30Days</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-4 border border-warning rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Warning">Expiring in 60 days</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Warning" Class="mt-2">@_complianceStats.Expiring60Days</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Default">Total Active</MudText>
                        <MudText Typo="Typo.h5" Class="mt-2">@_complianceStats.TotalActive</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (_complianceLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg" />
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="ComplianceRecordDto" Items="@_complianceRecords" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.EmployeeId" Title="Employee ID" />
                        <PropertyColumn Property="x => x.Type" Title="Document Type" />
                        <PropertyColumn Property="x => x.Date" Title="Issue Date" Format="dd MMM yyyy" />
                        <PropertyColumn Property="x => x.ExpiryDate" Title="Expiry Date" Format="dd MMM yyyy" />
                        <TemplateColumn Title="Days Remaining">
                            <CellTemplate>
                                @{ var days = context.Item.ExpiryDate.HasValue ? (context.Item.ExpiryDate.Value - DateTime.Today).Days : 0; }
                                <MudText Typo="Typo.body2" Color="@GetDaysColor(days)">
                                    @(context.Item.ExpiryDate.HasValue ? $"{days} days" : "N/A")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@GetComplianceStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No compliance records found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- TAB 1: Analytics -->
    <MudTabPanel Text="Analytics" Icon="@Icons.Material.Outlined.Analytics">
        @if (_analyticsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_analytics == null)
        {
            <MudAlert Severity="Severity.Error">Failed to load HR analytics.</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Default">Total Headcount</MudText>
                        <MudText Typo="Typo.h4" Class="mt-2">@_analytics.TotalHeadcount</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Default">Active Employees</MudText>
                        <MudText Typo="Typo.h4" Class="mt-2" Color="Color.Success">@_analytics.ActiveEmployees</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Default">In Onboarding</MudText>
                        <MudText Typo="Typo.h4" Class="mt-2" Color="Color.Info">@_analytics.OnboardingCount</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.caption" Color="Color.Default">Turnover Rate</MudText>
                        <MudText Typo="Typo.h4" Class="mt-2" Color="Color.Warning">@_analytics.TurnoverRate.ToString("P1")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg" Style="height: 400px;">
                        <MudText Typo="Typo.h6" Class="mb-4">Department Distribution</MudText>
                        <MudChart T="double" ChartType="ChartType.Donut"
                                  ChartSeries="@(_analytics.DepartmentDistribution.Select(d => new ChartSeries<double> { Name = d.Department, Data = new double[] { (double)d.Count } }).ToList())"
                                  ChartLabels="@(_analytics.DepartmentDistribution.Select(d => d.Department).ToArray())"
                                  Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg" Style="height: 400px;">
                        <MudText Typo="Typo.h6" Class="mb-4">Hiring Trend (Last 6 Months)</MudText>
                        <MudChart T="double" ChartType="ChartType.Line"
                                  ChartSeries="@_analyticsSeries"
                                  ChartLabels="@(_analytics.HireTrend.Select(t => t.Month).ToArray())"
                                  Width="100%" Height="300px" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // Compliance state
    private bool _complianceLoading = true;
    private List<ComplianceRecordDto> _complianceRecords = new();
    private ComplianceStatsDto _complianceStats = new();

    // Analytics state
    private bool _analyticsLoading = true;
    private HrAnalyticsDto? _analytics;
    private List<ChartSeries<double>> _analyticsSeries = [];

    /// <summary>
    /// Initializes the Compliance and Analytics page, loading data for both tabs in parallel.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["tab"] == "compliance") _activeTab = 0;
        else if (query["tab"] == "analytics") _activeTab = 1;

        await Task.WhenAll(LoadComplianceData(), LoadAnalyticsData());
    }

    private async Task LoadComplianceData()
    {
        try
        {
            _complianceLoading = true;
            var statsTask = Http.GetFromJsonAsync<ComplianceStatsDto>("api/compliance/stats");
            var authTask = Http.GetFromJsonAsync<PagedResponse<ComplianceRecordDto>>("api/compliance");
            await Task.WhenAll(statsTask, authTask);
            _complianceStats = await statsTask ?? new();
            var response = await authTask;
            _complianceRecords = response?.Data.ToList() ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Error loading compliance data: {ex.Message}"); }
        finally { _complianceLoading = false; }
    }

    private async Task LoadAnalyticsData()
    {
        try
        {
            _analyticsLoading = true;
            _analytics = await Http.GetFromJsonAsync<HrAnalyticsDto>("api/employees/analytics");
            if (_analytics != null)
            {
                _analyticsSeries = [new ChartSeries<double> { Name = "New Hires", Data = _analytics.HireTrend.Select(t => (double)t.Count).ToArray() }];
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error loading analytics: {ex.Message}", Severity.Error); }
        finally { _analyticsLoading = false; }
    }

    private Color GetDaysColor(int days)
    {
        if (days < 30) return Color.Error;
        if (days < 60) return Color.Warning;
        return Color.Success;
    }

    private Color GetComplianceStatusColor(string status) => status switch
    {
        "Active" => Color.Success, "Expiring Soon" => Color.Warning, "Expired" => Color.Error, _ => Color.Default
    };
}
