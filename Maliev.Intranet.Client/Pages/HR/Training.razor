@page "/hr/training"
@using Maliev.Intranet.Shared
@inject ISnackbar Snackbar

<PageTitle>Training - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Training & Development</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Course catalog, enrollments, and completion tracking</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Snackbar.Add("Add course coming soon", Severity.Info))">
        Add Course
    </MudButton>
</MudStack>

<!-- Stats -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Courses</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;">0</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Active Enrollments</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Primary">0</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Completed This Month</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Success">0</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Avg. Completion Rate</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;">0%</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Course Catalog" Icon="@Icons.Material.Outlined.MenuBook">
        <MudPaper Elevation="0" Class="pa-4">
            <MudTextField T="string" Placeholder="Search courses..." Variant="Variant.Outlined" Margin="Margin.Dense" 
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:300px;" Class="mb-4" />
            <MudGrid>
                @foreach (var category in _courseCategories)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg h-100">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudIcon Icon="@category.Icon" Color="@category.Color" />
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.subtitle2">@category.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">0 courses available</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardActions>
                                <MudButton Size="Size.Small" OnClick="@(() => Snackbar.Add($"Browse {category.Name} courses coming soon", Severity.Info))">Browse</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="My Enrollments" Icon="@Icons.Material.Outlined.School">
        <MudPaper Elevation="0" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.School" Size="Size.Large" Color="Color.Secondary" Style="font-size:60px;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No active enrollments</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Browse the course catalog to enroll in training programs</MudText>
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="Completion History" Icon="@Icons.Material.Outlined.EmojiEvents">
        <MudPaper Elevation="0" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" Size="Size.Large" Color="Color.Secondary" Style="font-size:60px;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No completed courses yet</MudText>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private record CourseCategory(string Name, string Icon, Color Color);

    private readonly List<CourseCategory> _courseCategories = new()
    {
        new("Safety & Compliance", Icons.Material.Outlined.Security, Color.Error),
        new("Technical Skills", Icons.Material.Outlined.Build, Color.Primary),
        new("Leadership", Icons.Material.Outlined.Groups, Color.Info),
        new("Software & Tools", Icons.Material.Outlined.Computer, Color.Success),
        new("Quality Management", Icons.Material.Outlined.VerifiedUser, Color.Warning),
        new("Customer Service", Icons.Material.Outlined.SupportAgent, Color.Secondary)
    };
}
