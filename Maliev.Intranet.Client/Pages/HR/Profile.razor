@page "/hr/profile"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>My Profile | Intranet Gateway</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 600;" Class="mb-4">My Profile</MudText>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_profile == null)
{
    <MudAlert Severity="Severity.Warning">
        Employee profile not found. Your account may not be linked to an employee record yet.
    </MudAlert>
}
else
{
    <MudGrid>
        <!-- Personal Information -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudText Typo="Typo.h6" Class="mb-3">Personal Information</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">Full Name</MudText>
                        <MudText Typo="Typo.body1">@_profile.Name</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">Work Email</MudText>
                        <MudText Typo="Typo.body1">@_profile.Email</MudText>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_profile.Phone))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Default">Phone</MudText>
                            <MudText Typo="Typo.body1">@_profile.Phone</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Employment Information -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudText Typo="Typo.h6" Class="mb-3">Employment</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">Title</MudText>
                        <MudText Typo="Typo.body1">@(_profile.Title.Length > 0 ? _profile.Title : "—")</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">Department</MudText>
                        <MudText Typo="Typo.body1">@(_profile.Department.Length > 0 ? _profile.Department : "—")</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">Status</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(_profile.Status == "Active" ? Color.Success : Color.Default)">@_profile.Status</MudChip>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_profile.ManagerName))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Default">Manager</MudText>
                            <MudText Typo="Typo.body1">@_profile.ManagerName</MudText>
                        </MudItem>
                    }
                    @if (_profile.HireDate.HasValue)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Default">Start Date</MudText>
                            <MudText Typo="Typo.body1">@_profile.HireDate.Value.ToString("d MMM yyyy")</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Emergency Contacts -->
        @if (_profile.EmergencyContacts.Count > 0)
        {
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Emergency Contacts</MudText>
                    <MudSimpleTable Hover="true" Dense="true">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Relationship</th>
                                <th>Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in _profile.EmergencyContacts)
                            {
                                <tr>
                                    <td>@contact.Name</td>
                                    <td>@contact.Relationship</td>
                                    <td>@contact.Phone</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
        }

        <!-- Dashboard Preferences -->
        <MudItem xs="12" id="dashboard-preferences">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <div class="d-flex align-items-center justify-space-between mb-3">
                    <MudText Typo="Typo.h6">Dashboard Preferences</MudText>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Disabled="@(_isSaving || !_hasChanged)"
                               OnClick="@SavePreferencesAsync">
                        @if (_isSaving)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Inherit" Class="mr-2" Style="width: 60px;" />
                        }
                        Save Preferences
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Select which widgets to display on your dashboard.
                </MudText>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var widget in _availableWidgets)
                    {
                        var isSelected = _selectedWidgets.Contains(widget.Key);
                        <MudChip T="string"
                                 Color="@(isSelected ? Color.Primary : Color.Default)"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => ToggleWidget(widget.Key))"
                                 Class="pref-chip">
                            @widget.Value
                        </MudChip>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly Dictionary<string, string> _availableWidgets = new()
    {
        { "Revenue",       "Revenue" },
        { "ActiveOrders", "Active Orders" },
        { "PendingQuotes","Pending Quotes" },
        { "Headcount",    "Headcount" },
        { "OrderTrend",   "Order Trend" },
    };

    private bool _isLoading = true;
    private EmployeeDetailDto? _profile;

    // Dashboard preferences state
    private bool _isSaving;
    private List<string> _selectedWidgets = [];
    private List<string> _savedWidgets = [];
    private bool _hasChanged => !_selectedWidgets.SequenceEqual(_savedWidgets);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Http.GetFromJsonAsync<EmployeeDetailDto>("api/employees/me");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _profile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load profile.", Severity.Error);
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }

        // Load dashboard widget preferences
        try
        {
            var pref = await Http.GetFromJsonAsync<UserPreferenceDto>("api/preferences/dashboard");
            if (pref?.PreferenceData != null && pref.PreferenceData.TryGetValue("Widgets", out var widgetsObj) && widgetsObj is System.Text.Json.JsonElement widgetsElement)
            {
                _selectedWidgets = System.Text.Json.JsonSerializer.Deserialize<List<string>>(widgetsElement) ?? _availableWidgets.Keys.ToList();
            }
            else
            {
                _selectedWidgets = _availableWidgets.Keys.ToList();
            }
        }
        catch
        {
            _selectedWidgets = _availableWidgets.Keys.ToList();
        }
        _savedWidgets = new List<string>(_selectedWidgets);
    }

    private void ToggleWidget(string widgetKey)
    {
        if (_selectedWidgets.Contains(widgetKey))
            _selectedWidgets.Remove(widgetKey);
        else
            _selectedWidgets.Add(widgetKey);
    }

    private async Task SavePreferencesAsync()
    {
        _isSaving = true;
        try
        {
            var request = new UpsertPreferenceRequest
            {
                Scope = "dashboard",
                PreferenceData = new Dictionary<string, object>
                {
                    { "Widgets", JsonSerializer.SerializeToElement(_selectedWidgets) }
                }
            };
            var result = await Http.PutAsJsonAsync("api/preferences/dashboard", request);
            if (result.IsSuccessStatusCode)
            {
                _savedWidgets = new List<string>(_selectedWidgets);
                Snackbar.Add("Dashboard preferences saved.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to save preferences.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to save preferences.", Severity.Error);
            Console.WriteLine($"Error saving preferences: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
