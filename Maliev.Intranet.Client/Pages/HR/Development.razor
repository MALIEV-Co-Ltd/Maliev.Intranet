@page "/hr/training"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Training & Performance - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 600;">Training &amp; Performance</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Course catalog, enrollments, performance reviews, and goal tracking</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Snackbar.Add("Add course coming soon", Severity.Info))">
        Add Course
    </MudButton>
</MudStack>

<!-- Stats -->
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Default">Total Courses</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;">0</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Default">Active Enrollments</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Primary">0</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Default">Reviews This Cycle</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Warning">@_reviews.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg text-center">
            <MudText Typo="Typo.caption" Color="Color.Default">Goals In Progress</MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Success">@_goals.Count</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: Training -->
    <MudTabPanel Text="Training" Icon="@Icons.Material.Outlined.School">
        <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Course Catalog" Icon="@Icons.Material.Outlined.MenuBook">
                <MudPaper Elevation="0" Class="pa-4">
                    <MudTextField T="string" Placeholder="Search courses..." Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:300px;" Class="mb-4" />
                    <MudGrid>
                        @foreach (var category in _courseCategories)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg h-100">
                                    <MudCardHeader>
                                        <CardHeaderAvatar>
                                            <MudIcon Icon="@category.Icon" Color="@category.Color" />
                                        </CardHeaderAvatar>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.subtitle2">@category.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Default">0 courses available</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardActions>
                                        <MudButton Size="Size.Small" OnClick="@(() => Snackbar.Add($"Browse {category.Name} courses coming soon", Severity.Info))">Browse</MudButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="My Enrollments" Icon="@Icons.Material.Outlined.Assignment">
                <MudPaper Elevation="0" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Outlined.School" Size="Size.Large" Color="Color.Default" Style="font-size:60px;" />
                    <MudText Typo="Typo.h6" Color="Color.Default" Class="mt-2">No active enrollments</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">Browse the course catalog to enroll in training programs</MudText>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Completion History" Icon="@Icons.Material.Outlined.EmojiEvents">
                <MudPaper Elevation="0" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Outlined.EmojiEvents" Size="Size.Large" Color="Color.Default" Style="font-size:60px;" />
                    <MudText Typo="Typo.h6" Color="Color.Default" Class="mt-2">No completed courses yet</MudText>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </MudTabPanel>

    <!-- TAB 1: Performance -->
    <MudTabPanel Text="Performance" Icon="@Icons.Material.Outlined.Star">
        <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
            <MudTabs Elevation="0" Rounded="false" TabPanelsClass="pa-4">
                <MudTabPanel Text="My Reviews" Icon="@Icons.Material.Outlined.Star">
                    @if (_perfLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded" />
                    }
                    else
                    {
                        <MudDataGrid T="PerformanceReviewDto" Items="@_reviews" Dense="true" Hover="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.Cycle" Title="Review Period" />
                                <PropertyColumn Property="x => x.ReviewerName" Title="Reviewer" />
                                <TemplateColumn Title="Rating">
                                    <CellTemplate>
                                        <MudRating SelectedValue="@context.Item.Rating" Size="Size.Small" ReadOnly="true" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Status">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Color="@GetPerfStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.CompletedDate" Title="Completed" Format="dd MMM yyyy" />
                            </Columns>
                            <NoRecordsContent>
                                <MudText Class="pa-4 text-center" Color="Color.Default">No performance reviews found</MudText>
                            </NoRecordsContent>
                        </MudDataGrid>
                    }
                </MudTabPanel>
                <MudTabPanel Text="Goals" Icon="@Icons.Material.Outlined.TrackChanges">
                    <MudText Typo="Typo.h6" Class="mb-3">My Goals</MudText>
                    @if (_perfLoading)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded mb-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="rounded" />
                    }
                    else
                    {
                        <MudStack Spacing="3">
                            @if (_goals.Any())
                            {
                                @foreach (var goal in _goals)
                                {
                                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded">
                                        <MudText Typo="Typo.subtitle2">@goal.Title</MudText>
                                        <MudProgressLinear Color="@(goal.Progress >= 100 ? Color.Success : Color.Primary)" Value="@goal.Progress" Size="Size.Small" Class="my-2" />
                                        <MudText Typo="Typo.caption" Color="Color.Default">@goal.Progress% complete</MudText>
                                    </MudPaper>
                                }
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No performance goals set for the current period.</MudAlert>
                            }
                        </MudStack>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // Training state
    private record CourseCategory(string Name, string Icon, Color Color);

    private readonly List<CourseCategory> _courseCategories = new()
    {
        new("Safety & Compliance", Icons.Material.Outlined.Security, Color.Error),
        new("Technical Skills", Icons.Material.Outlined.Build, Color.Primary),
        new("Leadership", Icons.Material.Outlined.Groups, Color.Info),
        new("Software & Tools", Icons.Material.Outlined.Computer, Color.Success),
        new("Quality Management", Icons.Material.Outlined.VerifiedUser, Color.Warning),
        new("Customer Service", Icons.Material.Outlined.SupportAgent, Color.Default)
    };

    // Performance state
    private bool _perfLoading = true;
    private List<PerformanceReviewDto> _reviews = new();
    private List<GoalDto> _goals = new();

    /// <summary>
    /// Initializes the Training and Performance page, loading performance data in parallel.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["tab"] == "training") _activeTab = 0;
        else if (query["tab"] == "performance") _activeTab = 1;

        try
        {
            _perfLoading = true;
            var reviewsTask = Http.GetFromJsonAsync<List<PerformanceReviewDto>>("api/performance/reviews");
            var goalsTask = Http.GetFromJsonAsync<List<GoalDto>>("api/performance/goals");
            await Task.WhenAll(reviewsTask, goalsTask);
            _reviews = await reviewsTask ?? new();
            _goals = await goalsTask ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Error loading performance data: {ex.Message}"); }
        finally { _perfLoading = false; }
    }

    private Color GetPerfStatusColor(string status) => status switch
    {
        "Pending" => Color.Warning, "In Progress" => Color.Primary, "Complete" => Color.Success, _ => Color.Default
    };
}
