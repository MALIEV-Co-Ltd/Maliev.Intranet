@page "/hr/directory"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>People Directory - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4">People Directory</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Organizational structure and employee management</MudText>
    </div>
</MudStack>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: Directory (Org Chart) -->
    <MudTabPanel Text="Directory" Icon="@Icons.Material.Outlined.AccountTree">
        <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
            @if (_orgLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="500px" Class="rounded" />
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-4">Organizational Structure</MudText>
                <MudStack Spacing="4">
                    @if (_rootNodes != null && _rootNodes.Any())
                    {
                        @foreach (var node in _rootNodes)
                        {
                            <OrgChartNode Node="node" IsRoot="true" />
                        }
                    }
                    else
                    {
                        <div class="pa-12 d-flex flex-column align-center justify-center">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Large" Color="Color.Secondary" Style="font-size: 64px;" Class="mb-4" />
                            <MudText Typo="Typo.body1" Color="Color.Secondary">No organizational data found in the database.</MudText>
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 1: Employee Management -->
    <MudTabPanel Text="Employee Management" Icon="@Icons.Material.Outlined.Badge">
        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_employeeSearch"
                              Placeholder="Search employees..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="max-width: 300px;" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect @bind-Value="_filterDepartment" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 130px;">
                        <MudSelectItem Value="@("All")">All Departments</MudSelectItem>
                        <MudSelectItem Value="@("Engineering")">Engineering</MudSelectItem>
                        <MudSelectItem Value="@("Sales")">Sales</MudSelectItem>
                        <MudSelectItem Value="@("Operations")">Operations</MudSelectItem>
                    </MudSelect>
                    <MudToggleIconButton @bind-Toggled="@_employeeViewMode"
                                         Icon="@Icons.Material.Outlined.GridView"
                                         ToggledIcon="@Icons.Material.Outlined.TableChart"
                                         Color="Color.Primary" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                        Add Employee
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_employeesLoading)
        {
            <MudGrid>
                @for (int i = 0; i < 8; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg" />
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_employeeViewMode)
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="EmployeeSummaryDto" Items="@_employees" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                    <Columns>
                        <TemplateColumn Title="Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="Size.Small" Color="Color.Primary">@context.Item.Name[0]</MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Item.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Title</MudText>
                                    </div>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Department" Title="Department" />
                        <PropertyColumn Property="x => x.Manager" Title="Manager" />
                        <PropertyColumn Property="x => x.HireDate" Title="Hire Date" Format="dd MMM yyyy" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip Size="Size.Small" Color="Color.Success">@context.Item.Status</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default"
                                               Href="@($"/hr/employees/{context.Item.Id}")" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudPaper>
        }
        else
        {
            <MudGrid>
                @foreach (var employee in _employees)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Class="border mud-border-lines-default">
                            <MudCardContent Class="pa-4 d-flex flex-column align-center">
                                <MudAvatar Size="Size.Large" Color="Color.Primary" Class="mb-3">@employee.Name[0]</MudAvatar>
                                <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="font-weight: 600;">@employee.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@employee.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-2">@employee.Department</MudChip>
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@employee.Email</MudText>
                            </MudCardContent>
                            <MudCardActions Class="pa-2">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="@($"/hr/employees/{employee.Id}")">View Profile</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // Org Chart state
    private bool _orgLoading = true;
    private List<OrgNodeDto> _rootNodes = new();

    // Employees state
    private bool _employeesLoading = true;
    private string _employeeSearch = "";
    private string _filterDepartment = "All";
    private bool _employeeViewMode = false;
    private List<EmployeeSummaryDto> _employees = new();

    /// <summary>
    /// Initializes the People Directory page, loading org chart and employee data in parallel.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["tab"] == "directory") _activeTab = 0;
        else if (query["tab"] == "management") _activeTab = 1;

        await Task.WhenAll(LoadOrgChart(), LoadEmployees());
    }

    private async Task LoadOrgChart()
    {
        try
        {
            _orgLoading = true;
            _rootNodes = await Http.GetFromJsonAsync<List<OrgNodeDto>>("api/employees/org-chart") ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Error loading org chart: {ex.Message}"); }
        finally { _orgLoading = false; }
    }

    private async Task LoadEmployees()
    {
        try
        {
            _employeesLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<EmployeeSummaryDto>>("api/employees");
            _employees = response?.Data.ToList() ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Error loading employees: {ex.Message}", Severity.Error); }
        finally { _employeesLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateEmployeeDialog>("Create Employee", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadEmployees();
    }
}
