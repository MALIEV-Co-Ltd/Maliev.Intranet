@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Layout
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LayoutService LayoutService
@inject ILogger<Login> Logger
@inject IJSRuntime JSRuntime

<PageTitle>MALIEV - Customer Management Portal</PageTitle>

<style>
    .login-container {
        min-height: 100vh;
        width: 100vw;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--mud-palette-background-grey);
    }

    #login-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    /* Glassmorphism Card */
    .login-card {
        z-index: 10;
        width: 100%;
        max-width: 600px;
        padding: 3rem;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        transition: box-shadow 0.3s ease;
    }

    .login-card:hover {
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }
    
    /* Light mode specific overrides */
    :root[data-theme="light"] #login-canvas {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    }

    :root[data-theme="light"] .login-card {
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.5);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
    }

    .premium-input .mud-input-slot {
        background-color: transparent !important;
    }

    .company-link {
        color: var(--mud-palette-text-secondary);
        transition: color 0.2s;
    }
    
    .company-link:hover {
        color: var(--mud-palette-primary);
    }
    
    @@media (max-width: 600px) {
        .login-card {
            padding: 1.5rem !important;
            margin: 1rem;
            max-width: 100% !important;
        }
        
        .login-container {
            align-items: flex-start;
            padding-top: 2rem;
        }
    }
</style>

<div class="login-container">
    @if (_isCheckingAuth)
    {
        <!-- Show nothing while checking authentication -->
    }
    else
    {
        <canvas id="login-canvas"></canvas>

        <div class="login-card animated fadeIn">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6 w-100">
                <MudImage Src="@LogoUrl"
                          Alt="MALIEV"
                          Style="height: 20px;"
                          Class="hover-scale" />
                <MudTooltip Text="@GetThemeTooltip()">
                    <MudIconButton Icon="@GetThemeIcon()"
                                   Color="Color.Inherit"
                                   OnClick="@ToggleThemeAsync" />
                </MudTooltip>
            </MudStack>

            <div class="d-flex flex-column align-start mb-8">
                <MudText Typo="Typo.h5" Style="font-weight: 700; letter-spacing: -0.5px;">Welcome Back</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Sign in to access your workspace</MudText>
            </div>

            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <MudStack Spacing="4">
                    <MudTextField T="string"
                                  Label="Username"
                                  Value="@_usernameInput"
                                  ValueChanged="@((string value) => OnUsernameChanged(value))"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentText="@("@maliev.com")"
                                  Placeholder="john.doe"
                                  Immediate="true"
                                  Class="premium-input"
                                  Error="@_usernameError"
                                  ErrorText="@_usernameErrorText"
                                  UserAttributes="@(new Dictionary<string, object> { {"autocomplete", "username"}, {"data-lpignore", "true"} })" />

                    <MudTextField T="string"
                                  Label="Password"
                                  @bind-Value="_loginModel.Password"
                                  InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Class="premium-input"
                                  UserAttributes="@(new Dictionary<string, object> { {"autocomplete", "current-password"} })" />

                    <div class="d-flex justify-end mt-n2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">Forgot Password? Contact IT support.</MudText>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2 rounded-lg" Dense="true">@_errorMessage</MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@_isProcessing"
                               Class="py-3 rounded-lg elevation-4 mt-2 hover-lift"
                               Style="font-weight: 700; letter-spacing: 0.5px; text-transform: none;">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Signing In...</MudText>
                        }
                        else
                        {
                            <MudText>Sign In</MudText>
                        }
                    </MudButton>
                    
                    <div class="d-flex align-center my-4 w-100 gap-3">
                        <div style="flex: 1; height: 1px; background-color: var(--mud-palette-lines-inputs);"></div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">OR</MudText>
                        <div style="flex: 1; height: 1px; background-color: var(--mud-palette-lines-inputs);"></div>
                    </div>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Inherit"
                               Size="Size.Large"
                               FullWidth="true"
                               Href="/api/auth/login"
                               StartIcon="@Icons.Custom.Brands.Google"
                               Class="py-3 rounded-lg"
                               Style="font-weight: 600; text-transform: none; border-color: inherit; opacity: 0.8;">
                        Sign in with Google
                    </MudButton>

                </MudStack>
            </EditForm>
            
            <div class="mt-8 text-center">
                 <MudText Typo="Typo.caption" Class="mud-text-secondary">
                     Not an employee? Visit <a href="https://www.maliev.com" target="_blank" class="company-link" style="font-weight: 600; text-decoration: none;">maliev.com</a>
                 </MudText>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private InternalLoginModel _loginModel = new();
    private bool _isProcessing;
    private bool _passwordVisible;
    private string? _errorMessage;
    private string _usernameInput = string.Empty;
    private bool _usernameError = false;
    private string _usernameErrorText = string.Empty;
    private bool _isCheckingAuth = true;
    private IJSObjectReference? _module;

    // Theme-aware logo URLs
    private string LogoUrl => LayoutService.IsDarkMode
        ? "https://storage.googleapis.com/maliev.com/web-contents/images/logo-white-20px.png"
        : "https://storage.googleapis.com/maliev.com/web-contents/images/logo-black-20px.png";

    protected override async Task OnInitializedAsync()
    {
        ReturnUrl ??= "/";
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", replace: true);
                return;
            }
        }
        catch { }
        _isCheckingAuth = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(Error))
            {
                _errorMessage = Error;
                StateHasChanged();
            }
            
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/login-bg.js?v=4");
                await _module.InvokeVoidAsync("initLoginBg");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize login background animation");
            }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private void OnUsernameChanged(string value)
    {
        _usernameError = false;
        _usernameErrorText = string.Empty;
        
        if (string.IsNullOrWhiteSpace(value))
        {
            _usernameInput = string.Empty;
            _loginModel.Username = string.Empty;
            return;
        }

        var cleanValue = value.Trim();
        bool hadDomain = false;

        if (cleanValue.Contains("@"))
        {
            var parts = cleanValue.Split('@');
            var usernamePart = parts[0].Trim();
            if (parts.Length > 1 && !string.IsNullOrWhiteSpace(parts[1])) hadDomain = true;
            _usernameInput = usernamePart;
            cleanValue = usernamePart;
        }
        else
        {
            _usernameInput = cleanValue;
        }

        if (!string.IsNullOrEmpty(cleanValue) && !System.Text.RegularExpressions.Regex.IsMatch(cleanValue, @"^[a-zA-Z0-9._-]+$"))
        {
            _usernameError = true;
            _usernameErrorText = "Only letters, numbers, dots, hyphens, and underscores allowed.";
        }
        else if (hadDomain)
        {
            _usernameErrorText = "Domain automatically removed";
        }

        _loginModel.Username = cleanValue;
    }

    private async Task ToggleThemeAsync() => await LayoutService.ToggleModeAsync();

    private string GetThemeIcon() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        _ => Icons.Material.Filled.AutoMode
    };

    private string GetThemeTooltip() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Dark Mode",
        ThemeMode.Light => "Light Mode",
        _ => "Auto Mode"
    };

    private void TogglePasswordVisibility() => _passwordVisible = !_passwordVisible;

    private async Task HandleLogin()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_loginModel.Username))
            {
                _usernameError = true;
                _usernameErrorText = "Required";
                _isProcessing = false;
                return;
            }

            if (_usernameError)
            {
               _isProcessing = false;
               return;
            }

            var fullUsername = $"{_loginModel.Username}@maliev.com";

            var response = await Http.PostAsJsonAsync("api/auth/login", new
            {
                Username = fullUsername,
                Password = _loginModel.Password,
                RememberMe = _loginModel.RememberMe
            });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Invalid credentials. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Something went wrong. Please try again.";
            Logger.LogError(ex, "Login failed");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public class InternalLoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
