@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Layout
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@implements IAsyncDisposable

<PageTitle>MALIEV | Intranet Gateway</PageTitle>

<div class="login-page @(_isDarkMode ? "dark-theme" : "")">
    <header class="login-header">
        <div class="login-header-content">
            <div class="header-logo">
                <img src="@LogoUrl" alt="MALIEV Logo" class="header-logo-img" />
            </div>
            <button class="theme-toggle-btn" @onclick="ToggleThemeAsync" title="@GetThemeTooltip()" aria-label="@GetThemeTooltip()">
                @if (_isDarkMode)
                {
                    <svg class="theme-toggle-icon"
                         width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true"
                         focusable="false">
                        <path d="@GetThemeIcon()" />
                    </svg>
                }
                else
                {
                    <MudIcon Icon="@GetThemeIcon()" Size="Size.Small" />
                }
            </button>
        </div>
    </header>

    <main class="login-main">
        @if (_isCheckingAuth)
        {
        }
        else
        {
            <section class="login-gateway-card" aria-labelledby="login-title">
                <div class="login-card-heading">
                    <p class="gateway-kicker">Employee gateway</p>
                    <h1 id="login-title" class="form-title login-title" aria-label="Sign in to MALIEV">
                        <span>Sign in to</span>
                        <img src="@LogoUrl" alt="" aria-hidden="true" class="login-title-logo" />
                    </h1>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-alert">@_errorMessage</div>
                }

                <a href="/api/v1/auth/login?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")" class="btn-google">
                    <svg class="google-logo" viewBox="0 0 24 24">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <div class="divider">
                    <div class="divider-line"></div>
                    <span class="divider-text">or continue with email</span>
                    <div class="divider-line"></div>
                </div>

                @if (IsEmailStep)
                {
                    <form class="email-entry-form" @onsubmit="ContinueWithEmail" @onsubmit:preventDefault>
                        <div class="input-group">
                            <label class="input-label" for="login-email">Email</label>
                            <div class="input-wrapper">
                                <input id="login-email"
                                       type="email"
                                       class="input-field"
                                       placeholder="name@@maliev.com"
                                       pattern="^[^@@\s]+@@maliev\.com$"
                                       aria-describedby="login-email-requirements"
                                       @bind="_usernameInput"
                                       @bind:event="oninput"
                                       autocomplete="username" />
                                <div class="input-underline"></div>
                            </div>
                        </div>

                        <button class="btn-primary" type="submit" disabled="@(!EmailLooksValid)">Continue with email</button>
                    </form>
                }
                else
                {
                    <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm" Class="credential-step">
                        <DataAnnotationsValidator />

                        <div class="credential-email-summary">
                            <span>@_usernameInput</span>
                            <button type="button" class="email-back-button" @onclick="BackToEmailStep">Change</button>
                        </div>

                        <div class="input-group">
                            <label class="input-label" for="login-password">Password</label>
                            <div class="input-wrapper">
                                <input id="login-password"
                                       type="password"
                                       class="input-field"
                                       placeholder="Password"
                                       @bind="_loginModel.Password"
                                       @bind:event="oninput"
                                       autocomplete="current-password" />
                                <div class="input-underline"></div>
                            </div>
                        </div>

                        <button class="btn-primary" type="submit" disabled="@(_isProcessing || !CredentialsReady)">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign in with email</span>
                        }
                        </button>
                    </EditForm>
                }

                <p class="footer-note">
                    Not an employee? Visit our main page at
                    <a href="https://www.maliev.com" target="_blank" class="footer-note-link">www.maliev.com</a>
                </p>
            </section>
        }
    </main>

    <footer class="login-footer">
        <div class="footer-content">
            <span class="footer-copyright">MALIEV CO., LTD.</span>
            <a href="https://www.maliev.com" class="footer-link">www.maliev.com</a>
        </div>
    </footer>
</div>



