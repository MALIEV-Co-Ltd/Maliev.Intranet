@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Layout
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@implements IAsyncDisposable

<PageTitle>MALIEV | Intranet Gateway</PageTitle>

<div class="login-page @(_isDarkMode ? "dark-theme" : "")">
    <!-- Header -->
    <header class="login-header">
        <div class="login-header-content">
            <div class="header-logo">
                <img src="@LogoUrl" alt="MALIEV Logo" class="header-logo-img" />
            </div>
            <nav class="header-nav">
                <span class="header-nav-link">Support</span>
                <span class="header-nav-link">System Status</span>
            </nav>
            <button class="theme-toggle-btn" @onclick="ToggleThemeAsync" title="@GetThemeTooltip()">
                <MudIcon Icon="@GetThemeIcon()" Size="Size.Small" />
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="login-main">
        @if (_isCheckingAuth)
        {
            <!-- Show nothing while checking authentication -->
        }
        else
        {
            <div class="glass-card">

                <!-- Title -->
                <h1 class="form-title">Intranet</h1>
                <p class="form-subtitle">Enter your corporate credentials to continue.</p>

                <!-- Error message -->
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-alert">@_errorMessage</div>
                }

                <!-- Login Form -->
                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                    <DataAnnotationsValidator />

                    <!-- Email field -->
                    <div class="input-group">
                        <label class="input-label">Email Address</label>
                        <div class="input-wrapper">
                            <input type="email" 
                                   class="input-field"
                                   placeholder="name@maliev.com"
                                   @bind="_usernameInput"
                                   @bind:event="oninput"
                                   autocomplete="username" />
                            <div class="input-underline"></div>
                        </div>
                    </div>

                    <!-- Password field -->
                    <div class="input-group">
                        <div class="password-label-row">
                            <label class="input-label">Password</label>
                            <a class="forgot-link">Forgot Password?</a>
                        </div>
                        <div class="input-wrapper">
                            <input type="password"
                                   class="input-field"
                                   placeholder="••••••••"
                                   @bind="_loginModel.Password"
                                   autocomplete="current-password" />
                            <div class="input-underline"></div>
                        </div>
                    </div>

                    <!-- Submit button -->
                    <button class="btn-primary" type="submit" disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                            <span>Signing In...</span>
                        }
                        else
                        {
                            <span>SIGN IN</span>
                        }
                    </button>

                    <!-- Divider -->
                    <div class="divider">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR</span>
                        <div class="divider-line"></div>
                    </div>

                    <!-- Google button -->
                    <a href="/api/v1/auth/login?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")" class="btn-google">
                        <svg class="google-logo" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>Sign in with Google</span>
                    </a>
                </EditForm>

                <!-- Footer note -->
                <div class="footer-note" style="margin-top: 2rem;">
                    Not an employee? Visit our main page at
                    <a href="https://www.maliev.com" target="_blank" style="color: var(--mud-palette-primary); font-weight: 700;">www.maliev.com</a>
                </div>
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="login-footer">
        <div class="footer-content">
            <span class="footer-copyright">© 2024 MALIEV INC. ALL RIGHTS RESERVED.</span>
            <a href="https://www.maliev.com" class="footer-link">www.maliev.com</a>
        </div>
    </footer>
</div>



