@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Layout
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LayoutService LayoutService
@inject ILogger<Login> Logger
@inject IJSRuntime JSRuntime

<PageTitle>MALIEV | Intranet Gateway</PageTitle>

<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: var(--mud-palette-background);
        overflow: hidden;
    }

    /* Header */
    .login-header {
        position: relative;
        z-index: 50;
        padding: 1rem 2rem;
    }

    .login-header-content {
        max-width: 80rem;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .header-logo-img {
        height: auto;
        max-height: 20px;
        width: auto;
        display: block;
    }

    .header-nav {
        display: flex;
        gap: 2rem;
    }

    .header-nav-link {
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        transition: color 0.2s;
    }

    .header-nav-link:hover {
        color: var(--mud-palette-primary);
    }

    /* Main content area */
    .login-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem 6rem;
        position: relative;
        z-index: 10;
    }

    /* Clean white card */
    .glass-card {
        width: 100%;
        max-width: 440px;
        padding: 3rem;
        border-radius: 1rem;
        background: var(--mud-palette-surface);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 24px 48px -12px rgba(0, 0, 0, 0.05);
        position: relative;
        text-align: center;
    }

    .dark-theme .glass-card {
        background: rgba(28, 27, 27, 0.7);
    }

    /* Form title */
    .form-title {
        font-size: var(--mud-typography-h1-size);
        font-weight: var(--mud-typography-h1-weight);
        line-height: var(--mud-typography-h1-lineheight);
        letter-spacing: -0.025em;
        color: var(--mud-palette-text-primary);
        margin-bottom: 0.5rem;
    }

    .form-subtitle {
        font-size: var(--mud-typography-subtitle1-size);
        font-weight: var(--mud-typography-subtitle1-weight);
        line-height: var(--mud-typography-subtitle1-lineheight);
        color: var(--mud-palette-on-surface-variant);
        margin-bottom: 2.5rem;
    }

    /* Input groups */
    .input-group {
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .input-label {
        display: block;
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-on-surface-variant);
        margin-bottom: 0.5rem;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper:focus-within .input-field {
        outline: none;
        border-color: var(--mud-palette-primary);
        background: var(--mud-palette-surface);
    }

    .input-field {
        width: 100%;
        height: 3rem;
        padding: 0 1rem;
        font-family: var(--mud-typography-default-family);
        font-size: var(--mud-typography-body1-size);
        font-weight: var(--mud-typography-body1-weight);
        background: var(--mud-palette-surface);
        border: 2px solid var(--mud-palette-lines-inputs);
        border-radius: 0.5rem;
        color: var(--mud-palette-text-primary);
        transition: all 0.2s;
    }

    .dark-theme .input-field {
        background: rgba(var(--mud-palette-white-rgb), 0.08);
    }

    .input-field::placeholder {
        color: var(--mud-palette-outline);
        opacity: 0.7;
    }

    .input-underline {
        display: none;
    }

    /* Password field */
    .password-label-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 0.5rem;
    }

    .forgot-link {
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-primary);
        cursor: pointer;
        text-decoration: none;
    }

    .forgot-link:hover {
        opacity: 0.8;
    }

    /* Primary button */
    .btn-primary {
        width: 100%;
        height: 3rem;
        background: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        font-family: var(--mud-typography-button-family);
        font-size: var(--mud-typography-button-size);
        font-weight: var(--mud-typography-button-weight);
        letter-spacing: var(--mud-typography-button-letterspacing, 0.05em);
        line-height: var(--mud-typography-button-lineheight);
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .btn-primary:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(var(--mud-palette-primary-rgb), 0.3);
    }

    .btn-primary:active {
        transform: scale(0.98);
    }

    .btn-primary:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    /* Divider */
    .divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: var(--mud-palette-outline-variant);
        opacity: 0.2;
    }

    .divider-text {
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-on-surface-variant);
    }

    /* Google button */
    .btn-google {
        width: 100%;
        height: 3rem;
        background: var(--mud-palette-surface);
        color: var(--mud-palette-on-surface);
        font-family: var(--mud-typography-button-family);
        font-size: var(--mud-typography-button-size);
        font-weight: var(--mud-typography-button-weight);
        letter-spacing: var(--mud-typography-button-letterspacing, 0.025em);
        line-height: var(--mud-typography-button-lineheight);
        border: 1px solid var(--mud-palette-outline-variant);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        text-decoration: none;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .btn-google:hover {
        background: var(--mud-palette-surface-container-low);
        text-decoration: none;
    }

    .btn-google:active {
        transform: scale(0.98);
    }

    .google-logo {
        width: 1.25rem;
        height: 1.25rem;
    }

    /* Footer */
    .login-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 50;
        padding: 1.5rem 2rem;
        border-top: 1px solid rgba(var(--mud-palette-black-rgb), 0.1);
    }

    .dark-theme .login-footer {
        border-top-color: rgba(var(--mud-palette-white-rgb), 0.1);
    }

    .footer-content {
        max-width: 80rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        md: flex-row;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .footer-copyright {
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-on-surface);
        opacity: 0.4;
    }

    .footer-link {
        font-size: var(--mud-typography-overline-size);
        font-weight: var(--mud-typography-overline-weight);
        text-transform: uppercase;
        letter-spacing: var(--mud-typography-overline-letterspacing);
        color: var(--mud-palette-on-surface);
        opacity: 0.4;
        text-decoration: none;
        cursor: pointer;
        transition: opacity 0.2s, color 0.2s;
    }

    .footer-link:hover {
        opacity: 1;
        color: var(--mud-palette-primary);
    }

    /* Footer note */
    .footer-note {
        font-size: var(--mud-typography-caption-size);
        color: var(--mud-palette-on-surface-variant);
        text-align: center;
    }

    /* Error message */
    .error-alert {
        padding: 0.75rem 1rem;
        background: var(--mud-palette-error-container);
        color: var(--mud-palette-on-error-container);
        border-radius: 0.5rem;
        font-size: var(--mud-typography-body2-size);
        margin-bottom: 1rem;
    }

    /* Theme toggle in header */
    .theme-toggle-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.25rem;
        color: var(--mud-palette-on-surface-variant);
        transition: background 0.2s, color 0.2s;
    }

    .theme-toggle-btn:hover {
        background: var(--mud-palette-surface-container-high);
        color: var(--mud-palette-primary);
    }

    /* Responsive */
    @@media (max-width: 640px) {
        .login-header {
            padding: 1rem;
        }

        .header-nav {
            display: none;
        }

        .glass-card {
            padding: 1.5rem;
        }

        .login-main {
            padding: 1rem 1rem 5rem;
        }
    }
</style>

<div class="login-page @(_isDarkMode ? "dark-theme" : "")">
    <!-- Header -->
    <header class="login-header">
        <div class="login-header-content">
            <div class="header-logo">
                <img src="@LogoUrl" alt="MALIEV Logo" class="header-logo-img" />
            </div>
            <nav class="header-nav">
                <span class="header-nav-link">Support</span>
                <span class="header-nav-link">System Status</span>
            </nav>
            <button class="theme-toggle-btn" @onclick="ToggleThemeAsync" title="@GetThemeTooltip()">
                <MudIcon Icon="@GetThemeIcon()" Size="Size.Small" />
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="login-main">
        @if (_isCheckingAuth)
        {
            <!-- Show nothing while checking authentication -->
        }
        else
        {
            <div class="glass-card">

                <!-- Title -->
                <h1 class="form-title">Sign In to Intranet</h1>
                <p class="form-subtitle">Enter your corporate credentials to continue.</p>

                <!-- Error message -->
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-alert">@_errorMessage</div>
                }

                <!-- Login Form -->
                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                    <DataAnnotationsValidator />

                    <!-- Email field -->
                    <div class="input-group">
                        <label class="input-label">Email Address</label>
                        <div class="input-wrapper">
                            <input type="email" 
                                   class="input-field"
                                   placeholder="name@maliev.com"
                                   @bind="_usernameInput"
                                   @bind:event="oninput"
                                   autocomplete="username" />
                            <div class="input-underline"></div>
                        </div>
                    </div>

                    <!-- Password field -->
                    <div class="input-group">
                        <div class="password-label-row">
                            <label class="input-label">Password</label>
                            <a class="forgot-link">Forgot Password?</a>
                        </div>
                        <div class="input-wrapper">
                            <input type="password"
                                   class="input-field"
                                   placeholder="••••••••"
                                   @bind="_loginModel.Password"
                                   autocomplete="current-password" />
                            <div class="input-underline"></div>
                        </div>
                    </div>

                    <!-- Submit button -->
                    <button class="btn-primary" type="submit" disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                            <span>Signing In...</span>
                        }
                        else
                        {
                            <span>SIGN IN</span>
                        }
                    </button>

                    <!-- Divider -->
                    <div class="divider">
                        <div class="divider-line"></div>
                        <span class="divider-text">OR</span>
                        <div class="divider-line"></div>
                    </div>

                    <!-- Google button -->
                    <a href="/api/auth/login?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")" class="btn-google">
                        <svg class="google-logo" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>Sign in with Google</span>
                    </a>
                </EditForm>

                <!-- Footer note -->
                <div class="footer-note" style="margin-top: 2rem;">
                    Not an employee? Visit our main page at
                    <a href="https://www.maliev.com" target="_blank" style="color: var(--mud-palette-primary); font-weight: 700;">www.maliev.com</a>
                </div>
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="login-footer">
        <div class="footer-content">
            <span class="footer-copyright">© 2024 MALIEV INC. ALL RIGHTS RESERVED.</span>
            <a href="https://www.maliev.com" class="footer-link">www.maliev.com</a>
        </div>
    </footer>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private InternalLoginModel _loginModel = new();
    private bool _isProcessing;
    private string? _errorMessage;
    private string _usernameInput = string.Empty;
    private bool _isCheckingAuth = true;
    private bool _isDarkMode;

    // Theme-aware logo URLs
    private string LogoUrl => _isDarkMode
        ? "images/logo-white.svg"
        : "images/logo.svg";

    protected override async Task OnInitializedAsync()
    {
        ReturnUrl ??= "/";
        _isDarkMode = LayoutService.IsDarkMode;
        
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", replace: true);
                return;
            }
        }
        catch { }
        _isCheckingAuth = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(Error))
            {
                _errorMessage = Error;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        await LayoutService.ToggleModeAsync();
        _isDarkMode = LayoutService.IsDarkMode;
        StateHasChanged();
    }

    private string GetThemeIcon() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Icons.Material.Filled.LightMode,
        ThemeMode.Light => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.Brightness4
    };

    private string GetThemeTooltip() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Switch to Light Mode",
        ThemeMode.Light => "Switch to Dark Mode",
        _ => "Toggle Theme"
    };

    private async Task HandleLogin()
    {
        _isProcessing = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_usernameInput))
            {
                _errorMessage = "Email address is required.";
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            if (string.IsNullOrWhiteSpace(_loginModel.Password))
            {
                _errorMessage = "Password is required.";
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            var fullUsername = _usernameInput.Contains("@") 
                ? _usernameInput 
                : $"{_usernameInput}@maliev.com";

            var response = await Http.PostAsJsonAsync("api/auth/login", new
            {
                Username = fullUsername,
                Password = _loginModel.Password,
                RememberMe = _loginModel.RememberMe
            });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Invalid credentials. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Something went wrong. Please try again.";
            Logger.LogError(ex, "Login failed");
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    public class InternalLoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        // No async resources to dispose
        await Task.CompletedTask;
    }
}
