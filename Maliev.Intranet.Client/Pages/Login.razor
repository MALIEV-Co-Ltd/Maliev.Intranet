@page "/login"
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Layout
@using Maliev.Intranet.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LayoutService LayoutService
@inject ILogger<Login> Logger

<PageTitle>Login - MALIEV</PageTitle>

<style>
    .login-page {
        min-height: 100vh;
        background-color: var(--mud-palette-background);
    }

    .login-form-container {
        background-color: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border-right: 1px solid var(--mud-palette-divider);
    }

    .auto-mode-icon i {
        background: linear-gradient(135deg, #FFD700 0%, #2196F3 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

<div class="login-page">
    @if (_isCheckingAuth)
    {
        <!-- Show nothing while checking authentication to prevent flash -->
    }
    else
    {
        <MudGrid Spacing="0" Class="vh-100" Style="height: 100vh; overflow: hidden;">
        <!-- Left Side: Login Form -->
        <MudItem xs="12" md="5" lg="4" Class="d-flex flex-column justify-center px-8 px-md-16 relative login-form-container">

            <!-- Theme Toggle -->
            <div style="position: absolute; top: 1rem; right: 1rem; z-index: 10;">
                <MudTooltip Text="@GetThemeTooltip()">
                    <MudIconButton Icon="@GetThemeIcon()"
                                   Color="@GetThemeColor()"
                                   Style="@(LayoutService.CurrentMode == ThemeMode.Light ? "color: #FFD700;" : "")"
                                   Class="@(LayoutService.CurrentMode == ThemeMode.System ? "auto-mode-icon" : "")"
                                   OnClick="@ToggleThemeAsync" />
                </MudTooltip>
            </div>

        <!-- Logo Area -->
        <div class="mb-12">
             <MudImage Src="@LogoUrl"
                       Alt="MALIEV Logo"
                       Style="height: 30px;" />
        </div>

        <MudText Typo="Typo.h3" GutterBottom="true" Style="font-weight: 500;">Sign In</MudText>
        
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <div class="mt-8">
                <MudTextField T="string"
                              Label="Username"
                              Value="@_usernameInput"
                              ValueChanged="@((string value) => OnUsernameChanged(value))"
                              Variant="Variant.Outlined"
                              Class="mb-6"
                              Immediate="true"
                              Adornment="Adornment.End"
                              AdornmentText="@("@maliev.com")"
                              Error="@_usernameError"
                              ErrorText="@_usernameErrorText"
                              HelperText="Enter username only, domain will be added"
                              UserAttributes="@(new Dictionary<string, object> { {"autocomplete", "username"} })" />

                 <MudTextField T="string"
                              Label="Password"
                              @bind-Value="_loginModel.Password"
                              InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Class="mb-2"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              AdornmentAriaLabel="Show Password"
                              UserAttributes="@(new Dictionary<string, object> { {"autocomplete", "current-password"} })" />
            </div>

            <div class="d-flex justify-space-between align-center mb-8">
                 <MudLink Href="forgot-password" Underline="Underline.None" Typo="Typo.caption" Class="text-uppercase" Color="Color.Inherit" Style="font-weight: 700;">Forgot Password?</MudLink>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">@_errorMessage</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       FullWidth="true" 
                       Disabled="@_isProcessing"
                       Style="height: 50px; border-radius: 8px; font-weight: 600; letter-spacing: 1px;"
                       Class="mb-4">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">SIGNING IN...</MudText>
                }
                else
                {
                    <MudText>SIGN IN</MudText>
                }
            </MudButton>
        </EditForm>
        
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Default" 
                   Size="Size.Large" 
                   FullWidth="true" 
                   Href="/api/auth/login"
                   Style="height: 50px; border-radius: 8px; font-weight: 600; letter-spacing: 1px;"
                   StartIcon="@Icons.Custom.Brands.Google">
            <MudText>SIGN IN WITH GOOGLE</MudText>
        </MudButton>

    </MudItem>

    <!-- Right Side: Image -->
    <MudItem xs="0" md="7" lg="8" Class="d-none d-md-flex relative align-end justify-start pa-16" 
             Style="background-image: url('images/login-bg.png'); background-size: cover; background-position: center;">
        
        <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 60%); pointer-events: none;"></div>

        <div style="z-index: 1; max-width: 600px;">
            <MudText Typo="Typo.h3" Class="mb-4" Style="font-weight: 400; color: white;">
                Your Manufacturing Hub for
            </MudText>
            <MudText Typo="Typo.h3" Class="mb-6" Style="font-weight: 700; color: white;">
                Rapid Prototyping & Custom Parts
            </MudText>
            <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.8); max-width: 500px;">
                From 3D printing to CNC machining, we bring your ideas to life with high-quality manufacturing services.
            </MudText>
        </div>
    </MudItem>
</MudGrid>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private InternalLoginModel _loginModel = new();
    private bool _isProcessing;
    private bool _passwordVisible;
    private string? _errorMessage;
    private string _usernameInput = string.Empty;
    private bool _usernameError = false;
    private string _usernameErrorText = string.Empty;
    private bool _isCheckingAuth = true; // Start with true to prevent flash

    // Computed property for password manager
    private string _fullEmailForPasswordManager =>
        string.IsNullOrWhiteSpace(_loginModel.Username)
            ? string.Empty
            : $"{_loginModel.Username}@maliev.com";

    // Theme-aware logo URLs
    private string LogoUrl => LayoutService.IsDarkMode
        ? "https://storage.googleapis.com/maliev.com/web-contents/images/logo-white-20px.png"
        : "https://storage.googleapis.com/maliev.com/web-contents/images/logo-black-20px.png";

    private void OnUsernameChanged(string value)
    {
        // Reset error state
        _usernameError = false;
        _usernameErrorText = string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            _usernameInput = string.Empty;
            _loginModel.Username = string.Empty;
            return;
        }

        var cleanValue = value.Trim();
        bool hadDomain = false;

        // Check if user entered @ symbol
        if (cleanValue.Contains("@"))
        {
            // Extract the part before @
            var parts = cleanValue.Split('@');
            var usernamePart = parts[0].Trim();

            // If they entered a domain, note it for warning
            if (parts.Length > 1 && !string.IsNullOrWhiteSpace(parts[1]))
            {
                hadDomain = true;
            }

            // Auto-correct by removing the domain part
            _usernameInput = usernamePart;
            cleanValue = usernamePart;
        }
        else
        {
            _usernameInput = cleanValue;
        }

        // Validate username format (only alphanumeric, dots, hyphens, underscores)
        if (!string.IsNullOrEmpty(cleanValue) && !System.Text.RegularExpressions.Regex.IsMatch(cleanValue, @"^[a-zA-Z0-9._-]+$"))
        {
            _usernameError = true;
            _usernameErrorText = "Username can only contain letters, numbers, dots, hyphens, and underscores.";
        }
        else if (hadDomain)
        {
            // Show info message but don't block submission
            _usernameErrorText = "Domain automatically removed - only username needed";
        }

        _loginModel.Username = cleanValue;
    }

    protected override async Task OnInitializedAsync()
    {
        ReturnUrl ??= "/";
        
        // CRITICAL: Check authentication during SSR to prevent flash
        // This runs on both server and client, preventing the login form from rendering at all if authenticated
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // User is already logged in, redirect immediately
                Navigation.NavigateTo(ReturnUrl ?? "/", replace: true);
                return; // Stop further initialization
            }
        }
        catch 
        { 
            // If auth check fails, continue to show login page
        }
        
        // User is NOT authenticated, show the login form
        _isCheckingAuth = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrEmpty(Error))
            {
                _errorMessage = Error;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        await LayoutService.ToggleModeAsync();
    }

    private string GetThemeIcon() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        _ => Icons.Material.Filled.AutoMode
    };

    private Color GetThemeColor() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => Color.Primary,
        ThemeMode.Light => Color.Warning,
        _ => Color.Inherit
    };

    private string GetThemeTooltip() => LayoutService.CurrentMode switch
    {
        ThemeMode.Dark => "Dark theme",
        ThemeMode.Light => "Light theme",
        _ => "Auto"
    };


    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
    }

    private async Task HandleLogin()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            // Validate username is not empty
            if (string.IsNullOrWhiteSpace(_loginModel.Username))
            {
                _usernameError = true;
                _usernameErrorText = "Username is required";
                _isProcessing = false;
                return;
            }

            // Validate username format
            if (_usernameError)
            {
                _errorMessage = "Please fix the errors before submitting.";
                _isProcessing = false;
                return;
            }

            // Build the full username for the API
            var fullUsername = $"{_loginModel.Username}@maliev.com";

            var response = await Http.PostAsJsonAsync("api/auth/login", new
            {
                Username = fullUsername,
                Password = _loginModel.Password,
                RememberMe = _loginModel.RememberMe
            });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Invalid corporate email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again later.";
            Logger.LogError(ex, "Login failed for username {Username}", _loginModel.Username);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public class InternalLoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
