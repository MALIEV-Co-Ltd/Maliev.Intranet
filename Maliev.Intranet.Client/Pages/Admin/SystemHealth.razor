@page "/admin/system-health"
@using Maliev.Intranet.Shared
@implements IAsyncDisposable
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>System Health | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="System Health" Subtitle="Liveness checks for MALIEV HTTP services." BackHref="/admin">
        @if (_health is not null)
        {
            <StatusBadge Status="@_health.OverallStatus" />
        }
    </PageHeader>

    <PageBody>
        <div class="mlv-toolbar">
            <div class="mlv-row-sub">Last checked @(_health?.CheckedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") ?? "-")</div>
            <div class="mlv-row-sub">Auto-refresh every @AutoRefreshInterval.TotalSeconds.ToString("N0")s</div>
            <PrimaryButton Icon="@Icons.Material.Outlined.Refresh" Disabled="@_manualRefreshInProgress" OnClick="@ReloadAsync">Refresh</PrimaryButton>
        </div>

        @if (_manualRefreshInProgress)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_health is null && _history is null)
        {
            <div class="mlv-empty">System health data is not available.</div>
        }
        else
        {
            <StatBar Class="mb-4">
                <StatTile Label="Services" Value="@CurrentServices.Count.ToString("N0")" />
                <StatTile Label="Healthy" Value="@CurrentServices.Count(s => s.Status == "Healthy").ToString("N0")" Trend="true" />
                <StatTile Label="Issues" Value="@CurrentServices.Count(s => s.Status != "Healthy").ToString("N0")" Trend="@(!CurrentServices.Any(s => s.Status != "Healthy"))" />
                <StatTile Label="Critical issues" Value="@CurrentServices.Count(s => s.IsCritical && s.Status != "Healthy").ToString("N0")" />
            </StatBar>

            @if (_history is not null)
            {
                <PanelCard Title="Services">
                    <div class="health-history-list">
                        @foreach (var service in _history.Services.OrderBy(s => s.ServiceName))
                        {
                            var currentProbe = CurrentServices.FirstOrDefault(s => s.ServiceName == service.ServiceName);
                            var currentStatus = currentProbe?.Status ?? service.CurrentStatus;
                            var displayBuckets = GetDisplayBuckets(service, _history.BucketMinutes, currentProbe);
                            <div class="health-history-row">
                                <div class="health-history-header">
                                    <div>
                                        <div class="mlv-row-main">@service.ServiceName</div>
                                        <div class="mlv-row-sub">@service.DomainGroup · @service.RoutePrefix</div>
                                    </div>
                                    <StatusBadge Status="@currentStatus" />
                                </div>
                                <div class="health-strip" aria-label="@($"{service.ServiceName} seven day health history")">
                                    @foreach (var bucket in displayBuckets)
                                    {
                                        <span class="@GetBucketClass(bucket)" title="@GetBucketTitle(bucket)"></span>
                                    }
                                </div>
                                <div class="health-strip-axis">
                                    <span>7 days ago</span>
                                    <span>@service.UptimePercentage.ToString("N2") % uptime</span>
                                    <span>Now</span>
                                </div>
                                @if (currentProbe is not null)
                                {
                                    <div class="system-health-probe-grid">
                                        <div>
                                            <div class="system-health-probe-label">Live</div>
                                            <div class="mlv-mono">@currentProbe.LivenessPath</div>
                                            <div class="mlv-row-sub">@currentProbe.LivenessResponseTimeMs.ToString("N0") ms</div>
                                        </div>
                                        <div>
                                            <div class="system-health-probe-label">Ready</div>
                                            <div class="mlv-mono">@currentProbe.ReadinessPath</div>
                                            <div class="mlv-row-sub">@currentProbe.ReadinessResponseTimeMs.ToString("N0") ms</div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(currentProbe.ErrorMessage))
                                    {
                                        <div class="mlv-row-sub">@currentProbe.ErrorMessage</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(currentProbe.ErrorBody))
                                    {
                                        <pre class="mlv-error mt-2">@currentProbe.ErrorBody</pre>
                                    }
                                }
                            </div>
                        }
                    </div>
                </PanelCard>
            }
        }
    </PageBody>
</div>

@code {
    private SystemHealthDto? _health;
    private SystemHealthHistoryDto? _history;
    private bool _manualRefreshInProgress = true;
    private bool _disposed;
    private CancellationTokenSource? _autoRefreshCts;
    private Task? _autoRefreshTask;
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private const int DisplayBucketMinutes = 240;
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(60);

    private IReadOnlyList<ServiceHealthStatus> CurrentServices => _health?.Services ?? [];

    protected override async Task OnInitializedAsync()
    {
        _autoRefreshCts = new CancellationTokenSource();
        await LoadAsync(showError: true, showProgress: true, _autoRefreshCts.Token);
        _autoRefreshTask = RunAutoRefreshAsync(_autoRefreshCts.Token);
    }

    private async Task ReloadAsync(MouseEventArgs _) => await LoadAsync(showError: true, showProgress: true, CancellationToken.None);

    private async Task LoadAsync(bool showError, bool showProgress, CancellationToken cancellationToken)
    {
        if (!await _loadGate.WaitAsync(0, cancellationToken))
        {
            return;
        }

        try
        {
            if (showProgress)
            {
                _manualRefreshInProgress = true;
                await InvokeAsync(StateHasChanged);
            }

            var liveTask = Http.GetFromJsonAsync<SystemHealthDto>("api/v1/system-health", cancellationToken);
            var historyTask = Http.GetFromJsonAsync<SystemHealthHistoryDto>("api/v1/system-health/history?days=7", cancellationToken);
            await Task.WhenAll(liveTask, historyTask);
            _health = await liveTask;
            _history = await historyTask;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (showError)
            {
                Snackbar.Add("System health could not be loaded.", Severity.Warning);
            }

            Console.WriteLine(ex.Message);
        }
        finally
        {
            if (showProgress)
            {
                _manualRefreshInProgress = false;
            }

            _loadGate.Release();
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RunAutoRefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(AutoRefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadAsync(showError: false, showProgress: false, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private static IReadOnlyList<DisplayHealthBucket> GetDisplayBuckets(
        SystemHealthHistoryServiceDto service,
        int sourceBucketMinutes,
        ServiceHealthStatus? currentProbe)
    {
        if (service.Buckets.Count == 0)
        {
            return [];
        }

        var sourceMinutes = Math.Max(1, sourceBucketMinutes);
        var groupSize = Math.Max(1, DisplayBucketMinutes / sourceMinutes);
        var buckets = new List<DisplayHealthBucket>((int)Math.Ceiling(service.Buckets.Count / (double)groupSize));

        for (var index = 0; index < service.Buckets.Count; index += groupSize)
        {
            var group = service.Buckets.Skip(index).Take(groupSize).ToList();
            buckets.Add(new DisplayHealthBucket(
                group[0].StartedAtUtc,
                group[^1].EndedAtUtc,
                ResolveDisplayStatus(group),
                group.Any(bucket => bucket.HasSample)));
        }

        if (currentProbe is not null && buckets.Count > 0)
        {
            var lastBucket = buckets[^1];
            buckets[^1] = lastBucket with
            {
                Status = currentProbe.Status,
                HasSample = true
            };
        }

        return buckets;
    }

    private static string ResolveDisplayStatus(IReadOnlyList<SystemHealthHistoryBucketDto> buckets)
    {
        var sampled = buckets.Where(bucket => bucket.HasSample).ToList();
        if (sampled.Count == 0)
        {
            return "NoData";
        }

        if (sampled.Any(bucket => bucket.Status == "Unreachable"))
        {
            return "Unreachable";
        }

        if (sampled.Any(bucket => bucket.Status == "Unhealthy"))
        {
            return "Unhealthy";
        }

        return sampled.Any(bucket => bucket.Status == "Healthy")
            ? "Healthy"
            : sampled[^1].Status;
    }

    private static string GetBucketClass(DisplayHealthBucket bucket) =>
        $"health-bucket health-bucket-{bucket.Status.Trim().ToLowerInvariant()}";

    private static string GetBucketTitle(DisplayHealthBucket bucket)
    {
        var time = $"{bucket.StartedAtUtc.ToLocalTime():dd MMM HH:mm} - {bucket.EndedAtUtc.ToLocalTime():HH:mm}";
        return bucket.HasSample
            ? $"{time}: {bucket.Status}"
            : $"{time}: no data";
    }

    private sealed record DisplayHealthBucket(
        DateTime StartedAtUtc,
        DateTime EndedAtUtc,
        string Status,
        bool HasSample);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_autoRefreshCts is not null)
        {
            await _autoRefreshCts.CancelAsync();
        }

        if (_autoRefreshTask is not null)
        {
            try
            {
                await _autoRefreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _autoRefreshCts?.Dispose();
        _loadGate.Dispose();
    }
}
