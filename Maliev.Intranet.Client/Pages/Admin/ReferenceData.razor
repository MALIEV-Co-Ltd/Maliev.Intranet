    private bool ValidateCountry()
    {
        if (string.IsNullOrWhiteSpace(_countryForm.Code) || _countryForm.Code.Trim().Length != 2)
        {
            SetStatus("Country ISO2 code must be exactly two letters.", isError: true);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_countryForm.Iso3) || _countryForm.Iso3.Trim().Length != 3)
        {
            SetStatus("Country ISO3 code must be exactly three letters.", isError: true);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_countryForm.Name))
        {
            SetStatus("Country name is required.", isError: true);
            return false;
        }

        return true;
    }

    private bool ValidateCurrency()
    {
        if (string.IsNullOrWhiteSpace(_currencyForm.Code) || _currencyForm.Code.Trim().Length != 3)
        {
            SetStatus("Currency code must be exactly three letters.", isError: true);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_currencyForm.Name) || string.IsNullOrWhiteSpace(_currencyForm.Symbol))
        {
            SetStatus("Currency name and symbol are required.", isError: true);
            return false;
        }

        if (_currencyForm.DecimalPlaces < 0)
        {
            SetStatus("Currency decimal places cannot be negative.", isError: true);
            return false;
        }

        return true;
    }

    private bool ValidateLocation()
    {
        if (string.IsNullOrWhiteSpace(_locationForm.PostalCode) || _locationForm.PostalCode.Trim().Length != 5)
        {
            SetStatus("Postal code must be exactly five digits.", isError: true);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_locationForm.SubDistrictTh)
            || string.IsNullOrWhiteSpace(_locationForm.DistrictTh)
            || string.IsNullOrWhiteSpace(_locationForm.ProvinceTh)
            || string.IsNullOrWhiteSpace(_locationForm.SubDistrictEn)
            || string.IsNullOrWhiteSpace(_locationForm.DistrictEn)
            || string.IsNullOrWhiteSpace(_locationForm.ProvinceEn))
        {
            SetStatus("Thai and English address components are required.", isError: true);
            return false;
        }

        return true;
    }

    private void SetSection(string section)
    {
        _section = NormalizeSection(section);
        var href = _section == "overview"
            ? "admin/reference-data"
            : $"admin/reference-data?section={Uri.EscapeDataString(_section)}";
        Navigation.NavigateTo(href, replace: true);
    }

    private bool ShouldShow(string section)
    {
        return _section == "overview" || string.Equals(_section, section, StringComparison.OrdinalIgnoreCase);
    }

    private string NormalizeSection(string? section)
    {
        return _sections.Any(candidate => string.Equals(candidate.Key, section, StringComparison.OrdinalIgnoreCase))
            ? section!.ToLowerInvariant()
            : "overview";
    }

    private bool? GetCurrencyActiveFilter() => _currencyStatusFilter switch
    {
        "active" => true,
        "inactive" => false,
        _ => null
    };

    private static string GetCurrencyStatus(CurrencyDto currency)
    {
        if (currency.IsPrimary)
        {
            return "Primary";
        }

        return currency.IsActive ? "Active" : "Inactive";
    }

