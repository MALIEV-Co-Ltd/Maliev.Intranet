@page "/admin/reference-data"
@using Maliev.Intranet.Shared.Services
@attribute [RequirePermission(MalievPermissions.Registry.LocationsRead)]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IReferenceDataService ReferenceDataService

<PageTitle>Reference Data | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Reference Data"
                Subtitle="Countries, currencies, and RegistryService lookup maintenance."
                BackHref="/admin" />

    <PageBody>
        @if (_loading)
        {
            <MudGrid Spacing="3">
                @for (var i = 0; i < 4; i++)
                {
                    <MudItem xs="12" md="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="96px" Animation="Animation.Wave" />
                    </MudItem>
                }
            </MudGrid>

            <PanelCard Class="reference-skeleton-panel mt-4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="36px" Animation="Animation.Wave" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" Animation="Animation.Wave" />
            </PanelCard>
        }
        else
        {
            <StatBar Class="mb-4">
                <StatTile Label="Countries" Value="@CountryTotalDisplay" />
                <StatTile Label="Currencies" Value="@CurrencyTotalDisplay" />
                <StatTile Label="Primary currency" Value="@(_primaryCurrency?.Code ?? "Not set")" />
                <StatTile Label="Registry addresses" Value="@RegistryTotalDisplay" />
            </StatBar>

            <div class="mlv-toolbar mb-4 reference-section-toolbar">
                <div class="mlv-segmented reference-sections" role="tablist" aria-label="Reference data sections">
                    @foreach (var navSection in _sections)
                    {
                        <button type="button"
                                role="tab"
                                aria-selected="@(_section == navSection.Key)"
                                class="@(_section == navSection.Key ? "active" : "")"
                                @onclick="@(() => SetSection(navSection.Key))">
                            @navSection.Label
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <div class="reference-inline-message @(_statusIsError ? "is-error" : "is-success")" role="status">
                    @_statusMessage
                </div>
            }

            <div class="reference-workbench">
                @if (ShouldShow("countries"))
                {
                    <PanelCard Title="Countries" Class="reference-management-panel">
                        <div class="reference-panel-intro">
                            <div>
                                <h3>Country catalog</h3>
                                <p>Manage ISO country records used by customer addresses, supplier profiles, and storefront configuration.</p>
                            </div>
                            <span class="reference-count-chip">@_countryPage.TotalCount.ToString("N0") total</span>
                        </div>

                        <form class="reference-toolbar" @onsubmit="SearchCountriesAsync" @onsubmit:preventDefault>
                            <label class="reference-search-field">
                                <span>Search countries</span>
                                <input class="mlv-form-input"
                                       placeholder="Name, ISO2, ISO3, region"
                                       @bind="_countryQuery"
                                       @bind:event="oninput" />
                            </label>
                            <label class="reference-check">
                                <input type="checkbox" @bind="_includeInactiveCountries" />
                                <span>Include inactive</span>
                            </label>
                            <button type="submit" class="mlv-button secondary" disabled="@_loadingCountries">Search</button>
                            <button type="button" class="mlv-button primary" @onclick="StartNewCountry">New country</button>
                        </form>

                        @if (_countryEditorOpen)
                        {
                            <div class="reference-editor" aria-label="Country editor">
                                <div class="reference-editor-header">
                                    <h3>@(_editingCountryId.HasValue ? "Edit country" : "New country")</h3>
                                    <button type="button" class="reference-link-button" @onclick="CancelCountryEdit">Cancel</button>
                                </div>
                                <div class="reference-form-grid">
                                    <label class="mlv-form-field">
                                        <span>ISO2</span>
                                        <input class="mlv-form-input mlv-mono" maxlength="2" @bind="_countryForm.Code" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>ISO3</span>
                                        <input class="mlv-form-input mlv-mono" maxlength="3" @bind="_countryForm.Iso3" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field reference-span-2">
                                        <span>Name</span>
                                        <input class="mlv-form-input" @bind="_countryForm.Name" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field reference-span-2">
                                        <span>Official name</span>
                                        <input class="mlv-form-input" @bind="_countryForm.OfficialName" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Numeric code</span>
                                        <input class="mlv-form-input mlv-mono" @bind="_countryForm.NumericCode" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Capital</span>
                                        <input class="mlv-form-input" @bind="_countryForm.Capital" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Region</span>
                                        <input class="mlv-form-input" @bind="_countryForm.Region" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Subregion</span>
                                        <input class="mlv-form-input" @bind="_countryForm.Subregion" @bind:event="oninput" />
                                    </label>
                                </div>
                                <div class="reference-editor-actions">
                                    <label class="reference-check">
                                        <input type="checkbox" @bind="_countryForm.IsActive" />
                                        <span>Active country</span>
                                    </label>
                                    <button type="button" class="mlv-button primary" disabled="@_savingCountry" @onclick="SaveCountryAsync">
                                        @(_savingCountry ? "Saving..." : "Save country")
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_loadingCountries)
                        {
                            <ReferenceTableSkeleton />
                        }
                        else
                        {
                            <div class="reference-table-shell">
                                <table class="mlv-table reference-table">
                                    <thead>
                                        <tr>
                                            <th>ISO</th>
                                            <th>Name</th>
                                            <th>Region</th>
                                            <th>Status</th>
                                            <th class="reference-actions-col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var country in _countryPage.Items)
                                        {
                                            <tr>
                                                <td class="mlv-mono">
                                                    <strong>@country.Code</strong>
                                                    @if (!string.IsNullOrWhiteSpace(country.Iso3))
                                                    {
                                                        <span class="reference-muted"> / @country.Iso3</span>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@country.Name</strong>
                                                    @if (!string.IsNullOrWhiteSpace(country.OfficialName))
                                                    {
                                                        <span class="reference-muted">@country.OfficialName</span>
                                                    }
                                                </td>
                                                <td>@DisplayOrDash(country.Region)</td>
                                                <td><StatusBadge Status="@(country.IsActive ? "Active" : "Inactive")" /></td>
                                                <td>
                                                    <div class="reference-row-actions">
                                                        <button type="button" class="reference-link-button" @onclick="@(() => EditCountry(country))">Edit</button>
                                                        @if (country.IsActive)
                                                        {
                                                            <button type="button" class="reference-danger-button" @onclick="@(() => DeleteCountryAsync(country))">Disable</button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="reference-link-button" @onclick="@(() => RestoreCountryAsync(country))">Restore</button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <ReferencePager Page="@_countryPage"
                                            PageSize="@_countryPageSize"
                                            Label="countries"
                                            OnPrevious="PreviousCountryPageAsync"
                                            OnNext="NextCountryPageAsync"
                                            OnPageSizeChanged="ChangeCountryPageSizeAsync" />
                        }
                    </PanelCard>
                }

                @if (ShouldShow("currencies"))
                {
                    <PanelCard Title="Currencies" Class="reference-management-panel">
                        <div class="reference-panel-intro">
                            <div>
                                <h3>Currency catalog</h3>
                                <p>Manage ISO currency records and active availability for accounting, quotes, and supplier costs.</p>
                            </div>
                            <span class="reference-count-chip">@_currencyPage.TotalCount.ToString("N0") total</span>
                        </div>

                        <div class="reference-toolbar">
                            <label class="reference-select-field">
                                <span>Status</span>
                                <select class="mlv-form-input" value="@_currencyStatusFilter" @onchange="ChangeCurrencyStatusFilterAsync">
                                    <option value="all">All currencies</option>
                                    <option value="active">Active only</option>
                                    <option value="inactive">Inactive only</option>
                                </select>
                            </label>
                            <button type="button" class="mlv-button primary" @onclick="StartNewCurrency">New currency</button>
                        </div>

                        @if (_currencyEditorOpen)
                        {
                            <div class="reference-editor" aria-label="Currency editor">
                                <div class="reference-editor-header">
                                    <h3>@(_editingCurrencyId.HasValue ? "Edit currency" : "New currency")</h3>
                                    <button type="button" class="reference-link-button" @onclick="CancelCurrencyEdit">Cancel</button>
                                </div>
                                <div class="reference-form-grid">
                                    <label class="mlv-form-field">
                                        <span>Code</span>
                                        <input class="mlv-form-input mlv-mono"
                                               maxlength="3"
                                               disabled="@_editingCurrencyId.HasValue"
                                               @bind="_currencyForm.Code"
                                               @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Symbol</span>
                                        <input class="mlv-form-input" @bind="_currencyForm.Symbol" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field reference-span-2">
                                        <span>Name</span>
                                        <input class="mlv-form-input" @bind="_currencyForm.Name" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Decimal places</span>
                                        <input class="mlv-form-input" type="number" min="0" max="8" @bind="_currencyForm.DecimalPlaces" />
                                    </label>
                                </div>
                                <div class="reference-editor-actions">
                                    <label class="reference-check">
                                        <input type="checkbox" @bind="_currencyForm.IsActive" />
                                        <span>Active currency</span>
                                    </label>
                                    <button type="button" class="mlv-button primary" disabled="@_savingCurrency" @onclick="SaveCurrencyAsync">
                                        @(_savingCurrency ? "Saving..." : "Save currency")
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_loadingCurrencies)
                        {
                            <ReferenceTableSkeleton />
                        }
                        else
                        {
                            <div class="reference-table-shell">
                                <table class="mlv-table reference-table">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Decimals</th>
                                            <th>Status</th>
                                            <th class="reference-actions-col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var currency in _currencyPage.Items)
                                        {
                                            <tr>
                                                <td class="mlv-mono"><strong>@currency.Code</strong> @currency.Symbol</td>
                                                <td>@currency.Name</td>
                                                <td class="mlv-mono">@currency.DecimalPlaces</td>
                                                <td>
                                                    <StatusBadge Status="@GetCurrencyStatus(currency)" />
                                                </td>
                                                <td>
                                                    <div class="reference-row-actions">
                                                        <button type="button" class="reference-link-button" @onclick="@(() => EditCurrency(currency))">Edit</button>
                                                        <button type="button" class="reference-danger-button" disabled="@currency.IsPrimary" @onclick="@(() => DeleteCurrencyAsync(currency))">Delete</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <ReferencePager Page="@_currencyPage"
                                            PageSize="@_currencyPageSize"
                                            Label="currencies"
                                            OnPrevious="PreviousCurrencyPageAsync"
                                            OnNext="NextCurrencyPageAsync"
                                            OnPageSizeChanged="ChangeCurrencyPageSizeAsync" />
                        }
                    </PanelCard>
                }

                @if (ShouldShow("exchange-rates"))
                {
                    <PanelCard Title="Exchange Rates" Class="reference-management-panel reference-exchange-panel">
                        <div class="reference-panel-intro">
                            <div>
                                <h3>Exchange-rate check</h3>
                                <p>Validate live rate data from CurrencyService before updating finance workflows.</p>
                            </div>
                        </div>

                        <div class="reference-toolbar">
                            <label class="reference-select-field">
                                <span>From</span>
                                <select class="mlv-form-input" @bind="_rateFrom">
                                    @foreach (var currency in _currencies)
                                    {
                                        <option value="@currency.Code">@currency.Code @currency.Symbol</option>
                                    }
                                </select>
                            </label>
                            <label class="reference-select-field">
                                <span>To</span>
                                <select class="mlv-form-input" @bind="_rateTo">
                                    @foreach (var currency in _currencies)
                                    {
                                        <option value="@currency.Code">@currency.Code @currency.Symbol</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="mlv-button primary" disabled="@_loadingRate" @onclick="LoadExchangeRateAsync">
                                @(_loadingRate ? "Checking..." : "Check rate")
                            </button>
                        </div>

                        @if (_loadingRate)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" Animation="Animation.Wave" />
                        }
                        else if (_exchangeRate is not null)
                        {
                            <div class="reference-rate-result">
                                <strong>1 @_exchangeRate.From = @_exchangeRate.Rate.ToString("N6") @_exchangeRate.To</strong>
                                <span>Live rate loaded from CurrencyService.</span>
                            </div>
                        }
                        else
                        {
                            <div class="mlv-empty text-left">Select two currencies to validate CurrencyService exchange-rate data.</div>
                        }
                    </PanelCard>
                }

                @if (ShouldShow("registry"))
                {
                    <PanelCard Title="RegistryService Thai Locations" Class="reference-management-panel reference-registry-card">
                        <div class="reference-panel-intro">
                            <div>
                                <h3>Thai address registry</h3>
                                <p>Manage postcode, subdistrict, district, and province data used by address autocomplete.</p>
                            </div>
                            <span class="reference-count-chip">@_locationPage.TotalCount.ToString("N0") total</span>
                        </div>

                        <form class="reference-toolbar reference-registry-toolbar" @onsubmit="SearchLocationsAsync" @onsubmit:preventDefault>
                            <label class="reference-search-field">
                                <span>Search locations</span>
                                <input class="mlv-form-input"
                                       placeholder="Postcode, district, city, province"
                                       @bind="_locationQuery"
                                       @bind:event="oninput" />
                            </label>
                            <button type="submit" class="mlv-button secondary" disabled="@_loadingLocations">Search</button>
                            <button type="button" class="mlv-button primary" @onclick="StartNewLocation">New location</button>
                        </form>

                        @if (_locationEditorOpen)
                        {
                            <div class="reference-editor" aria-label="Registry location editor">
                                <div class="reference-editor-header">
                                    <h3>@(_editingLocationId.HasValue ? "Edit location" : "New location")</h3>
                                    <button type="button" class="reference-link-button" @onclick="CancelLocationEdit">Cancel</button>
                                </div>
                                <div class="reference-form-grid">
                                    <label class="mlv-form-field">
                                        <span>Postal code</span>
                                        <input class="mlv-form-input mlv-mono" maxlength="5" @bind="_locationForm.PostalCode" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Province TH</span>
                                        <input class="mlv-form-input" @bind="_locationForm.ProvinceTh" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>District TH</span>
                                        <input class="mlv-form-input" @bind="_locationForm.DistrictTh" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Subdistrict TH</span>
                                        <input class="mlv-form-input" @bind="_locationForm.SubDistrictTh" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Province EN</span>
                                        <input class="mlv-form-input" @bind="_locationForm.ProvinceEn" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>District EN</span>
                                        <input class="mlv-form-input" @bind="_locationForm.DistrictEn" @bind:event="oninput" />
                                    </label>
                                    <label class="mlv-form-field">
                                        <span>Subdistrict EN</span>
                                        <input class="mlv-form-input" @bind="_locationForm.SubDistrictEn" @bind:event="oninput" />
                                    </label>
                                </div>
                                <div class="reference-editor-actions">
                                    <button type="button" class="mlv-button primary" disabled="@_savingLocation" @onclick="SaveLocationAsync">
                                        @(_savingLocation ? "Saving..." : "Save location")
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_loadingLocations)
                        {
                            <ReferenceTableSkeleton />
                        }
                        else
                        {
                            <div class="reference-table-shell">
                                <table class="mlv-table reference-table">
                                    <thead>
                                        <tr>
                                            <th>Postal code</th>
                                            <th>Thai address</th>
                                            <th>English address</th>
                                            <th class="reference-actions-col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var location in _locationPage.Items)
                                        {
                                            <tr>
                                                <td class="mlv-mono"><strong>@location.PostalCode</strong></td>
                                                <td>@location.SubDistrictTh, @location.DistrictTh, @location.ProvinceTh</td>
                                                <td>@location.SubDistrictEn, @location.DistrictEn, @location.ProvinceEn</td>
                                                <td>
                                                    <div class="reference-row-actions">
                                                        <button type="button" class="reference-link-button" @onclick="@(() => EditLocation(location))">Edit</button>
                                                        <button type="button" class="reference-danger-button" @onclick="@(() => DeleteLocationAsync(location))">Delete</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <ReferencePager Page="@_locationPage"
                                            PageSize="@_locationPageSize"
                                            Label="locations"
                                            OnPrevious="PreviousLocationPageAsync"
                                            OnNext="NextLocationPageAsync"
                                            OnPageSizeChanged="ChangeLocationPageSizeAsync" />
                        }
                    </PanelCard>
                }
            </div>
        }
    </PageBody>
</div>

@code {
    private List<CountryDto> _countries = [];
    private List<CurrencyDto> _currencies = [];
    private CurrencyDto? _primaryCurrency;

    private ReferenceDataPage<CountryDto> _countryPage = new();
    private ReferenceDataPage<CurrencyDto> _currencyPage = new();
    private ReferenceDataPage<RegistryThaiLocation> _locationPage = new();

    private CountryDto _countryForm = NewCountryForm();
    private CurrencyDto _currencyForm = NewCurrencyForm();
    private RegistryThaiLocation _locationForm = NewLocationForm();

    private Guid? _editingCountryId;
    private Guid? _editingCurrencyId;
    private Guid? _editingLocationId;

    private string _countryQuery = string.Empty;
    private string _currencyStatusFilter = "all";
    private string _locationQuery = string.Empty;
    private string _section = "overview";
    private string _rateFrom = "USD";
    private string _rateTo = "THB";
    private string? _statusMessage;

    private int _countryPageSize = 25;
    private int _currencyPageSize = 25;
    private int _locationPageSize = 25;

    private ExchangeRateResponse? _exchangeRate;

    private bool _includeInactiveCountries = true;
    private bool _loading = true;
    private bool _loadingCountries;
    private bool _loadingCurrencies;
    private bool _loadingLocations;
    private bool _loadingRate;
    private bool _savingCountry;
    private bool _savingCurrency;
    private bool _savingLocation;
    private bool _countryEditorOpen;
    private bool _currencyEditorOpen;
    private bool _locationEditorOpen;
    private bool _statusIsError;

    private readonly ReferenceDataSection[] _sections =
    [
        new("overview", "Overview"),
        new("countries", "Countries"),
        new("currencies", "Currencies"),
        new("exchange-rates", "Exchange rates"),
        new("registry", "Registry locations"),
    ];

    [SupplyParameterFromQuery(Name = "section")]
    private string? RequestedSection { get; set; }

    private string CountryTotalDisplay => (_countryPage.TotalCount > 0 ? _countryPage.TotalCount : _countries.Count).ToString("N0");
    private string CurrencyTotalDisplay => (_currencyPage.TotalCount > 0 ? _currencyPage.TotalCount : _currencies.Count).ToString("N0");
    private string RegistryTotalDisplay => _locationPage.TotalCount.ToString("N0");

    protected override void OnParametersSet()
    {
        _section = NormalizeSection(RequestedSection);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        _loading = true;
        ClearStatus();

        try
        {
            var countriesTask = ReferenceDataService.GetCountriesAsync();
            var currenciesTask = ReferenceDataService.GetCurrenciesAsync();
            var primaryTask = ReferenceDataService.GetPrimaryCurrencyAsync();
            var countryPageTask = ReferenceDataService.GetCountryPageAsync(_countryQuery, _includeInactiveCountries, 1, _countryPageSize);
            var currencyPageTask = ReferenceDataService.GetCurrencyPageAsync(GetCurrencyActiveFilter(), 1, _currencyPageSize);
            var locationPageTask = ReferenceDataService.GetRegistryLocationPageAsync(_locationQuery, 1, _locationPageSize);

            await Task.WhenAll(countriesTask, currenciesTask, primaryTask, countryPageTask, currencyPageTask, locationPageTask);

            _countries = countriesTask.Result
                .OrderBy(country => country.Name)
                .ToList();
            _currencies = currenciesTask.Result
                .OrderByDescending(currency => currency.IsPrimary)
                .ThenByDescending(currency => currency.IsActive)
                .ThenBy(currency => currency.Code)
                .ToList();
            _primaryCurrency = primaryTask.Result;
            _countryPage = countryPageTask.Result;
            _currencyPage = currencyPageTask.Result;
            _locationPage = locationPageTask.Result;
            _rateTo = _primaryCurrency?.Code ?? "THB";
            _rateFrom = _currencies.FirstOrDefault(currency => !string.Equals(currency.Code, _rateTo, StringComparison.OrdinalIgnoreCase))?.Code
                ?? _rateTo;
        }
        catch (Exception ex)
        {
            _countries = [];
            _currencies = [];
            _primaryCurrency = null;
            _countryPage = new();
            _currencyPage = new();
            _locationPage = new();
            SetStatus("Reference data could not be loaded. Check the source services and try again.", isError: true);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchCountriesAsync()
    {
        await LoadCountryPageAsync(1);
    }

    private async Task LoadCountryPageAsync(int pageNumber)
    {
        _loadingCountries = true;
        ClearStatus();

        try
        {
            _countryPage = await ReferenceDataService.GetCountryPageAsync(
                _countryQuery,
                _includeInactiveCountries,
                pageNumber,
                _countryPageSize);
        }
        catch (Exception ex)
        {
            SetStatus("Country records could not be loaded.", isError: true);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loadingCountries = false;
        }
    }

    private async Task SearchLocationsAsync()
    {
        await LoadLocationPageAsync(1);
    }

    private async Task LoadLocationPageAsync(int pageNumber)
    {
        _loadingLocations = true;
        ClearStatus();

        try
        {
            _locationPage = await ReferenceDataService.GetRegistryLocationPageAsync(
                _locationQuery,
                pageNumber,
                _locationPageSize);
        }
        catch (Exception ex)
        {
            SetStatus("Registry locations could not be loaded.", isError: true);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loadingLocations = false;
        }
    }

    private async Task LoadCurrencyPageAsync(int pageNumber)
    {
        _loadingCurrencies = true;
        ClearStatus();

        try
        {
            _currencyPage = await ReferenceDataService.GetCurrencyPageAsync(
                GetCurrencyActiveFilter(),
                pageNumber,
                _currencyPageSize);
        }
        catch (Exception ex)
        {
            SetStatus("Currency records could not be loaded.", isError: true);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loadingCurrencies = false;
        }
    }

    private async Task LoadExchangeRateAsync()
    {
        if (string.IsNullOrWhiteSpace(_rateFrom) || string.IsNullOrWhiteSpace(_rateTo))
        {
            _exchangeRate = null;
            return;
        }

        _loadingRate = true;
        ClearStatus();

        try
        {
            var url = $"api/v1/ReferenceData/currencies/rate?from={Uri.EscapeDataString(_rateFrom)}&to={Uri.EscapeDataString(_rateTo)}";
            _exchangeRate = await Http.GetFromJsonAsync<ExchangeRateResponse>(url);
        }
        catch (Exception ex)
        {
            _exchangeRate = null;
            SetStatus("Exchange rate could not be loaded.", isError: true);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loadingRate = false;
        }
    }

