    private static CountryDto Clone(CountryDto source) => new()
    {
        Id = source.Id,
        Code = source.Code,
        Iso3 = source.Iso3,
        Name = source.Name,
        OfficialName = source.OfficialName,
        NumericCode = source.NumericCode,
        Capital = source.Capital,
        Region = source.Region,
        Subregion = source.Subregion,
        IsActive = source.IsActive,
        ETag = source.ETag,
        LastModifiedUtc = source.LastModifiedUtc
    };

    private static CurrencyDto Clone(CurrencyDto source) => new()
    {
        Id = source.Id,
        Code = source.Code,
        Symbol = source.Symbol,
        Name = source.Name,
        DecimalPlaces = source.DecimalPlaces,
        IsActive = source.IsActive,
        IsPrimary = source.IsPrimary,
        ETag = source.ETag,
        CreatedAt = source.CreatedAt,
        UpdatedAt = source.UpdatedAt
    };

    private static RegistryThaiLocation Clone(RegistryThaiLocation source) => new()
    {
        Id = source.Id,
        PostalCode = source.PostalCode,
        SubDistrictTh = source.SubDistrictTh,
        DistrictTh = source.DistrictTh,
        ProvinceTh = source.ProvinceTh,
        SubDistrictEn = source.SubDistrictEn,
        DistrictEn = source.DistrictEn,
        ProvinceEn = source.ProvinceEn
    };

    private static CountryDto NormalizeCountry(CountryDto source)
    {
        var country = Clone(source);
        country.Code = country.Code.Trim().ToUpperInvariant();
        country.Iso3 = country.Iso3?.Trim().ToUpperInvariant();
        country.Name = country.Name.Trim();
        country.OfficialName = NullIfWhiteSpace(country.OfficialName);
        country.NumericCode = NullIfWhiteSpace(country.NumericCode);
        country.Capital = NullIfWhiteSpace(country.Capital);
        country.Region = NullIfWhiteSpace(country.Region);
        country.Subregion = NullIfWhiteSpace(country.Subregion);
        return country;
    }

    private static CurrencyDto NormalizeCurrency(CurrencyDto source)
    {
        var currency = Clone(source);
        currency.Code = currency.Code.Trim().ToUpperInvariant();
        currency.Symbol = currency.Symbol.Trim();
        currency.Name = currency.Name.Trim();
        return currency;
    }

    private static RegistryThaiLocation NormalizeLocation(RegistryThaiLocation source)
    {
        var location = Clone(source);
        location.PostalCode = location.PostalCode.Trim();
        location.SubDistrictTh = location.SubDistrictTh.Trim();
        location.DistrictTh = location.DistrictTh.Trim();
        location.ProvinceTh = location.ProvinceTh.Trim();
        location.SubDistrictEn = location.SubDistrictEn.Trim();
        location.DistrictEn = location.DistrictEn.Trim();
        location.ProvinceEn = location.ProvinceEn.Trim();
        return location;
    }

    private static string? NullIfWhiteSpace(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void SetStatus(string message, bool isError = false)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

