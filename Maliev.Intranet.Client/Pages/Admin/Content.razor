@page "/admin/content"

<PageTitle>Content Management - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Content Management</MudText>
    
    <MudAlert Severity="Severity.Info" Class="mb-6">This feature is coming soon.</MudAlert>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.RssFeed" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Blog</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">Manage company blog posts and articles.</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.Campaign" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Campaigns</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">Track and manage marketing campaigns.</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Knowledge Base</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">Manage internal and external support articles.</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.Category" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Product Catalog</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">Configure products and services visibility.</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Outlined.Announcement" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Announcements</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">Publish system-wide or targeted announcements.</MudText>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
