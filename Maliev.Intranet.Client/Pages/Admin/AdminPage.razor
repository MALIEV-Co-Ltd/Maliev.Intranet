@page "/admin"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Admin | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="Admin" Subtitle="Business settings, notifications, and platform operations." />

    <PageBody>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }

        <div class="mlv-toolbar">
            <div class="mlv-segmented">
                @foreach (var tab in _tabs)
                {
                    <button type="button" class="@(_tab == tab ? "active" : "")" @onclick="@(() => _tab = tab)">@tab</button>
                }
            </div>
        </div>

        @if (_tab == "Company")
        {
            <div class="mlv-grid">
                <PanelCard Title="Business profile" Class="mlv-span-6">
                    <FormGrid>
                        <FormField Label="Company name"><input class="mlv-form-input" value="MALIEV Precision Manufacturing" readonly /></FormField>
                        <FormField Label="Industry"><input class="mlv-form-input" value="CNC and additive manufacturing" readonly /></FormField>
                        <FormField Label="Website"><input class="mlv-form-input" value="https://maliev.com" readonly /></FormField>
                        <FormField Label="Support email"><input class="mlv-form-input" value="ops@maliev.com" readonly /></FormField>
                    </FormGrid>
                </PanelCard>
                <PanelCard Title="Operations" Class="mlv-span-6">
                    <div class="mlv-list">
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">System health checks</div>
                                <div class="mlv-row-sub">All HTTP service liveness checks and response diagnostics.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.MonitorHeart" Href="/admin/system-health">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Equipment management</div>
                                <div class="mlv-row-sub">Moved to Manufacturing Equipment and backed by FacilityService.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.PrecisionManufacturing" Href="/mfg/equipment">Open</SecondaryButton>
                        </div>
                    </div>
                </PanelCard>
                <PanelCard Title="Health snapshot" Class="mlv-span-12">
                    @if (_health?.Services.Count > 0)
                    {
                        <div class="mlv-list">
                            @foreach (var service in _health.Services.Where(s => s.IsCritical).Take(12))
                            {
                                <div class="mlv-list-row">
                                    <div>
                                        <div class="mlv-row-main">@service.ServiceName</div>
                                        <div class="mlv-row-sub">@service.DomainGroup · @service.ResponseTimeMs.ToString("N0") ms</div>
                                    </div>
                                    <StatusBadge Status="@service.Status" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mlv-empty">Health data is not available.</div>
                    }
                </PanelCard>
            </div>
        }
        else if (_tab == "Notifications")
        {
            <PanelCard>
                @if (_templates.Count > 0)
                {
                    <table class="mlv-table">
                        <thead><tr><th>Template</th><th>Key</th><th>Channel</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var template in _templates)
                            {
                                <tr>
                                    <td>@template.Name</td>
                                    <td class="mlv-mono">@template.TemplateKey</td>
                                    <td>@template.ChannelType</td>
                                    <td><StatusBadge Status="@(template.IsActive ? "Active" : "Inactive")" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No notification templates found.</div>
                }
            </PanelCard>
        }
    </PageBody>
</div>

@code {
    private readonly string[] _tabs = ["Company", "Notifications"];

    private string _tab = "Company";
    private List<NotificationTemplateDto> _templates = [];
    private SystemHealthDto? _health;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var templatesTask = Http.GetFromJsonAsync<PagedResponse<NotificationTemplateDto>>("api/v1/notifications/templates?page=1&pageSize=50");
            var healthTask = Http.GetFromJsonAsync<SystemHealthDto>("api/v1/system-health");
            await Task.WhenAll(templatesTask, healthTask);
            _templates = (await templatesTask)?.Data.ToList() ?? [];
            _health = await healthTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Admin data could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
