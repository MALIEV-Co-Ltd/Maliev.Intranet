@page "/admin"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Admin | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="Admin" Subtitle="Platform operations, service consoles, reference data, and notification configuration." />

    <PageBody>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }

        <div class="mlv-toolbar">
            <div class="mlv-segmented">
                @foreach (var tab in _tabs)
                {
                    <button type="button" class="@(_tab == tab ? "active" : "")" @onclick="@(() => SetTab(tab))">@tab</button>
                }
            </div>
        </div>

        @if (_tab == "Operations")
        {
            <div class="mlv-grid">
                <PanelCard Title="Operations" Class="mlv-span-6">
                    <div class="mlv-list">
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">System health checks</div>
                                <div class="mlv-row-sub">All HTTP service liveness checks and response diagnostics.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.MonitorHeart" Href="/admin/system-health">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Equipment management</div>
                                <div class="mlv-row-sub">Moved to Manufacturing Equipment and backed by FacilityService.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.PrecisionManufacturing" Href="/mfg/equipment">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Material catalog</div>
                                <div class="mlv-row-sub">Maintain materials, processes, colors, and mechanical properties from MaterialService.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.Inventory" Href="/mfg/materials">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Commerce storefront catalog</div>
                                <div class="mlv-row-sub">Manage online storefront products, collections, variants, pricing, and media from CommerceService.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.Storefront" Href="/commerce/catalog">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Website content</div>
                                <div class="mlv-row-sub">Find the Maliev.Web blog, homepage, service content, storefront, and website chatbot management surfaces.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.Article" Href="/admin/web-content">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Reference data</div>
                                <div class="mlv-row-sub">Review CountryService, CurrencyService, and RegistryService lookup data used by customer workflows.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.TravelExplore" Href="/admin/reference-data">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Chatbot instructions</div>
                                <div class="mlv-row-sub">Manage Mali website persona and ChatbotService skill prompts for customer-facing support.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.SupportAgent" Href="/admin/chatbot-instructions">Open</SecondaryButton>
                        </div>
                        <div class="mlv-list-row">
                            <div>
                                <div class="mlv-row-main">Supplier profiles</div>
                                <div class="mlv-row-sub">Manage supplier records used by purchasing and procurement workflows.</div>
                            </div>
                            <SecondaryButton Icon="@Icons.Material.Outlined.AddBusiness" Href="/purchasing/suppliers">Open</SecondaryButton>
                        </div>
                    </div>
                </PanelCard>
            </div>
        }
        else if (_tab == "Notifications")
        {
            <PanelCard>
                <div class="mlv-toolbar mb-3">
                    <div>
                        <div class="mlv-row-main">Notification templates</div>
                        <div class="mlv-row-sub">Email and message templates loaded from NotificationService.</div>
                    </div>
                </div>
                @if (_templates.Count > 0)
                {
                    <table class="mlv-table">
                        <thead><tr><th>Template</th><th>Key</th><th>Channel</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var template in _templates)
                            {
                                <tr>
                                    <td>@template.Name</td>
                                    <td class="mlv-mono">@template.TemplateKey</td>
                                    <td>@template.ChannelType</td>
                                    <td><StatusBadge Status="@(template.IsActive ? "Active" : "Inactive")" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">@_notificationError</div>
                }
            </PanelCard>
        }
    </PageBody>
</div>

@code {
    private readonly string[] _tabs = ["Operations", "Notifications"];

    private string _tab = "Operations";
    private List<NotificationTemplateDto> _templates = [];
    private bool _loading = true;
    private string _notificationError = "No notification templates are registered.";

    [SupplyParameterFromQuery(Name = "tab")]
    private string? RequestedTab { get; set; }

    protected override void OnParametersSet()
    {
        _tab = NormalizeTab(RequestedTab);
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            await LoadNotificationTemplatesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadNotificationTemplatesAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<NotificationTemplateDto>>("api/v1/notifications/templates?page=1&pageSize=50");
            _templates = response?.Data.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _templates = [];
            _notificationError = "Notification templates could not be loaded.";
            Snackbar.Add(_notificationError, Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private void SetTab(string tab)
    {
        _tab = NormalizeTab(tab);
        Navigation.NavigateTo($"admin?tab={Uri.EscapeDataString(_tab)}", replace: true);
    }

    private string NormalizeTab(string? tab)
    {
        return _tabs.FirstOrDefault(candidate => string.Equals(candidate, tab, StringComparison.OrdinalIgnoreCase))
            ?? "Operations";
    }
}
