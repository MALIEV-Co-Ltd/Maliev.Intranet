@page "/admin/workflows"
@inject NavigationManager Navigation

<PageTitle>Workflows | Intranet Gateway</PageTitle>

@code {
    /// <summary>Redirects legacy /admin/workflows route to the consolidated Settings page (Workflows tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/settings?tab=workflows", replace: true);
    }
}
