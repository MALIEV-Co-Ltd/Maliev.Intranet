@page "/admin/portal-config"
@inject NavigationManager Navigation

<PageTitle>Portal Configuration | Intranet Gateway</PageTitle>

@code {
    /// <summary>Redirects legacy /admin/portal-config route to the consolidated Settings page.</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/settings?tab=portal-config", replace: true);
    }
}
