@page "/admin/audit"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Audit Log - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Audit Log</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">System activity log with user actions and entity changes</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportAuditLog">Export Log</MudButton>
</MudStack>

<!-- Filters -->
<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_searchString" Placeholder="Search events, users, entities..." Variant="Variant.Outlined" Margin="Margin.Dense"
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect T="string" @bind-Value="_actionFilter" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("")">All Actions</MudSelectItem>
                <MudSelectItem Value="@("Create")">Create</MudSelectItem>
                <MudSelectItem Value="@("Update")">Update</MudSelectItem>
                <MudSelectItem Value="@("Delete")">Delete</MudSelectItem>
                <MudSelectItem Value="@("Login")">Login</MudSelectItem>
                <MudSelectItem Value="@("Export")">Export</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect T="string" @bind-Value="_entityFilter" Label="Entity" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("")">All Entities</MudSelectItem>
                <MudSelectItem Value="@("Customer")">Customer</MudSelectItem>
                <MudSelectItem Value="@("Invoice")">Invoice</MudSelectItem>
                <MudSelectItem Value="@("Order")">Order</MudSelectItem>
                <MudSelectItem Value="@("Employee")">Employee</MudSelectItem>
                <MudSelectItem Value="@("User")">User</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Audit Table -->
<MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
    <MudDataGrid T="AuditEvent" Items="@FilteredEvents" Dense="true" Hover="true" Elevation="0">
        <Columns>
            <PropertyColumn Property="x => x.Timestamp" Title="Time" Format="dd MMM yyyy HH:mm:ss" />
            <TemplateColumn Title="Action">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetActionColor(context.Item.Action)">@context.Item.Action</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.EntityType" Title="Entity" />
            <PropertyColumn Property="x => x.EntityId" Title="Entity ID" />
            <PropertyColumn Property="x => x.UserName" Title="User" />
            <PropertyColumn Property="x => x.IpAddress" Title="IP Address" />
            <TemplateColumn Title="Details" Sortable="false">
                <CellTemplate>
                    <MudTooltip Text="@context.Item.Details">
                        <MudText Typo="Typo.body2" Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@context.Item.Details</MudText>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Large" Color="Color.Secondary" Style="font-size:60px;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No audit events found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Audit logging will record all system activities</MudText>
            </MudStack>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private string _searchString = "";
    private string _actionFilter = "";
    private string _entityFilter = "";
    private DateRange _dateRange = new DateRange(DateTime.Today.AddDays(-7), DateTime.Today);
    private List<AuditEvent> _events = new();

    private IEnumerable<AuditEvent> FilteredEvents => _events
        .Where(e => (string.IsNullOrEmpty(_searchString) || e.UserName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || e.EntityType.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || e.Details.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                 && (string.IsNullOrEmpty(_actionFilter) || e.Action == _actionFilter)
                 && (string.IsNullOrEmpty(_entityFilter) || e.EntityType == _entityFilter));

    private Color GetActionColor(string action) => action switch
    {
        "Create" => Color.Success,
        "Update" => Color.Info,
        "Delete" => Color.Error,
        "Login" => Color.Default,
        "Export" => Color.Warning,
        _ => Color.Default
    };

    private void ExportAuditLog() => Snackbar.Add("Audit log export coming soon", Severity.Info);

    private class AuditEvent
    {
        public DateTime Timestamp { get; set; }
        public string Action { get; set; } = string.Empty;
        public string EntityType { get; set; } = string.Empty;
        public string EntityId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }
}
