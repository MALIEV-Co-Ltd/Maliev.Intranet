@page "/sales/customers/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_customer?.Name ?? "Customer Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16 pt-8">
    @if (_customer == null && !_loading)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">Customer not found.</MudAlert>
    }
    else if (_loading)
    {
        <MudGrid>
            <MudItem xs="12" lg="8">
                <MudSkeleton Height="60px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="400px" Class="rounded-lg" />
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudSkeleton Height="300px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="200px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else if (_customer != null)
    {
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-8">
            <MudStack Spacing="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h3" Style="font-weight: 700;">@_customer.Name</MudText>
                    <MudChip T="string" Color="@GetStatusColor(_customer.Status)" Size="Size.Small" Variant="Variant.Filled" Class="mt-1">@_customer.Status</MudChip>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Customer ID: @_customer.Id</MudText>
            </MudStack>
            
            <MudStack Row="true" Spacing="2">
                 <MudButton Variant="Variant.Outlined" 
                            Color="Color.Primary" 
                            StartIcon="@Icons.Material.Filled.Edit"
                            OnClick="ToggleEditMode"
                            Class="px-6 rounded-lg">
                     @( _isEditMode ? "Cancel Editing" : "Edit Profile")
                 </MudButton>
                 @if (!_isEditMode)
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Add"
                                Class="px-6 rounded-lg shadow-none">
                         Create Order
                     </MudButton>
                 }
                 else
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveChanges"
                                Disabled="@_isSaving"
                                Class="px-6 rounded-lg shadow-none">
                         @if (_isSaving)
                         {
                             <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                             <span>Saving...</span>
                         }
                         else
                         {
                             <span>Save Changes</span>
                         }
                     </MudButton>
                 }
            </MudStack>
        </MudStack>

        <MudGrid Spacing="6">
            <!-- Left Column: Main Content -->
            <MudItem xs="12" lg="8">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    
                    @if (!_isEditMode)
                    {
                        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
                            <MudGrid Spacing="4">
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Total Spent</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.TotalSpent.ToString("C0", new CultureInfo("th-TH"))</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Active Orders</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.ActiveOrdersCount</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Open Quotations</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.OpenQuotationsCount</MudText>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Recent Activity</MudText>
                                        <MudStack Spacing="4">
                                            <div class="d-flex gap-4">
                                                <MudAvatar Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Style="background-color: var(--mud-palette-primary-hover);"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small"/></MudAvatar>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">Customer profile created</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @_customer.CreatedAt.ToLocalTime().ToString("g") • by 
                                                        @(!string.IsNullOrEmpty(_customer.CreatedByName) ? $"{_customer.CreatedByName} ({_customer.CreatedByEmail})" : (_customer.CreatedBy ?? "System"))
                                                    </MudText>
                                                </MudStack>
                                            </div>
                                            @if (_customer.Notes?.Any() == true)
                                            {
                                                <MudDivider />
                                                var latestNote = _customer.Notes.OrderByDescending(n => n.CreatedAt).First();
                                                <div class="d-flex gap-4">
                                                    <MudAvatar Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Style="background-color: var(--mud-palette-info-hover);"><MudIcon Icon="@Icons.Material.Filled.Note" Size="Size.Small"/></MudAvatar>
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">Internal note added</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @latestNote.CreatedAt.ToLocalTime().ToString("g") • by 
                                                            @(!string.IsNullOrEmpty(latestNote.CreatedByName) ? $"{latestNote.CreatedByName} ({latestNote.CreatedByEmail})" : latestNote.CreatedBy)
                                                        </MudText>
                                                    </MudStack>
                                                </div>
                                            }
                                        </MudStack>
                                    </MudCard>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>
                    }

                    <MudTabPanel Text="Addresses" Icon="@Icons.Material.Filled.LocationOn">
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">Delivery & Billing</MudText>
                                @if (_isEditMode)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddAddress">Add Address</MudButton>
                                }
                            </MudStack>
                            
                            <MudGrid Spacing="4">
                                @if (_customer.Addresses != null && _customer.Addresses.Any())
                                {
                                    @foreach (var (address, index) in _customer.Addresses.Select((a, i) => (a, i)))
                                    {
                                        <MudItem xs="12" sm="6">
                                            @if (_isEditMode)
                                            {
                                                <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default h-100" Style="background-color: var(--mud-palette-background-grey);">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
                                                        <MudSelect T="string" @bind-Value="address.Type" Dense="true" Margin="Margin.Dense" Style="max-width: 120px;">
                                                            <MudSelectItem Value="@("Billing")">Billing</MudSelectItem>
                                                            <MudSelectItem Value="@("Shipping")">Shipping</MudSelectItem>
                                                        </MudSelect>
                                                        <MudStack Row="true">
                                                            <MudCheckBox T="bool" @bind-Value="address.IsDefault" Label="Default" Dense="true" Size="Size.Small" />
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveAddress(address))" />
                                                        </MudStack>
                                                    </MudStack>
                                                    <MudTextField Label="Address Line 1" @bind-Value="address.AddressLine1" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                                                    <MudTextField Label="District" @bind-Value="address.District" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                                                    <MudTextField Label="City" @bind-Value="address.City" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                                                    <MudTextField Label="State / Province" @bind-Value="address.StateProvince" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                                                    <MudTextField Label="Postal Code" @bind-Value="address.PostalCode" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudPaper>
                                            }
                                            else
                                            {
                                                <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default h-100" Style="background-color: var(--mud-palette-background-grey);">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
                                                        <MudChip T="string" Color="@(address.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Filled">@address.Type</MudChip>
                                                        @if (address.IsDefault)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                                        }
                                                    </MudStack>
                                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@address.AddressLine1</MudText>
                                                    @if (!string.IsNullOrEmpty(address.AddressLine2)) { <MudText Typo="Typo.body2">@address.AddressLine2</MudText> }
                                                    @if (!string.IsNullOrEmpty(address.AddressLine3)) { <MudText Typo="Typo.body2">@address.AddressLine3</MudText> }
                                                    <MudText Typo="Typo.body2">@address.District, @address.City</MudText>
                                                    <MudText Typo="Typo.body2">@address.StateProvince @address.PostalCode</MudText>
                                                </MudPaper>
                                            }
                                        </MudItem>
                                    }
                                }
                                else if (_customer.CompanyId.HasValue && _customer.CompanyBillingAddress != null)
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">Using Company billing address. Individual customer addresses not found.</MudAlert>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default h-100" Style="background-color: var(--mud-palette-background-grey);">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Company Billing</MudChip>
                                                <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                        </MudPaper>
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Text">No addresses found for this customer.</MudAlert>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCard>
                    </MudTabPanel>

                    <MudTabPanel Text="Documents" Icon="@Icons.Material.Filled.Attachment">
                         <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Documents & NDA</MudText>
                            <MudGrid Spacing="4">
                                @if (_customer.Nda != null)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudPaper Class="pa-4 d-flex align-center gap-4 rounded-lg border-solid border-1 mud-border-lines-default" Elevation="0">
                                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Primary" Size="Size.Large" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2" Style="font-weight: 700;">NDA Record</MudText>
                                                <MudText Typo="Typo.caption">Status: @_customer.Nda.Status</MudText>
                                                <MudText Typo="Typo.caption">Expires: @(_customer.Nda.ExpiresAt?.ToShortDateString() ?? "N/A")</MudText>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                                
                                @if (_customer.Documents?.Any() == true)
                                {
                                    @foreach (var doc in _customer.Documents)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Class="pa-4 d-flex align-center gap-4 rounded-lg border-solid border-1 mud-border-lines-default" Elevation="0">
                                                <MudIcon Icon="@GetDocumentIcon(doc.MimeType)" Color="@GetDocumentColor(doc.MimeType)" Size="Size.Large" />
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@doc.FileName</MudText>
                                                    <MudText Typo="Typo.caption">@FormatFileSize(doc.FileSize) • @doc.DocumentCategory</MudText>
                                                </MudStack>
                                                <MudSpacer />
                                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                                            </MudPaper>
                                        </MudItem>
                                    }
                                }
                                else if (_customer.Nda == null)
                                {
                                    <MudItem xs="12">
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">No documents found for this customer.</MudAlert>
                                    </MudItem>
                                }
                            </MudGrid>
                         </MudCard>
                    </MudTabPanel>

                    @if (_isEditMode)
                    {
                        <MudTabPanel Text="Edit Form" Icon="@Icons.Material.Filled.FormatAlignLeft">
                            <MudForm @ref="_editForm">
                                <MudStack Spacing="6">
                                    <!-- Personal Info Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Personal Information</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="First Name" @bind-Value="_updateRequest.FirstName" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Last Name" @bind-Value="_updateRequest.LastName" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudTextField T="string" Label="Email" @bind-Value="_updateRequest.Email" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Mobile" @bind-Value="_updateRequest.Mobile" Variant="Variant.Outlined" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Landline" @bind-Value="_updateRequest.Landline" Variant="Variant.Outlined" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>

                                    <!-- Preferences Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Preferences & Classification</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="Segment" @bind-Value="_updateRequest.Segment" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                                    <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                                    <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">Tier Level</MudText>
                                                <MudToggleGroup T="string" @bind-Value="_updateRequest.Tier" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" FixedContent="true" Class="w-100">
                                                    <MudToggleItem Value="@("Bronze")" Text="Bronze" />
                                                    <MudToggleItem Value="@("Silver")" Text="Silver" />
                                                    <MudToggleItem Value="@("Gold")" Text="Gold" />
                                                    <MudToggleItem Value="@("Platinum")" Text="Platinum" />
                                                </MudToggleGroup>
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>
                                </MudStack>
                            </MudForm>
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudItem>

            <!-- Right Column: Sidebar Stats & Info -->
            <MudItem xs="12" lg="4">
                <MudStack Spacing="6">
                    <!-- Profile Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                            <MudAvatar Color="Color.Primary" Style="height:80px; width:80px;" Variant="Variant.Filled">
                                @(_customer.FirstName?[0])@(_customer.LastName?[0])
                            </MudAvatar>
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">@_customer.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_customer.Email</MudText>
                        </MudStack>
                        
                        <MudStack Spacing="3">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Phone</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@(_customer.Mobile ?? "N/A")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Language</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@(_customer.PreferredLanguage == "th" ? "Thai" : "English")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Timezone</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@_customer.Timezone</MudText>
                            </div>
                        </MudStack>

                        <MudDivider Class="my-6" />

                        <MudStack Spacing="3">
                             <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Email" Color="Color.Primary" FullWidth="true" Style="justify-content: flex-start;">Send Email</MudButton>
                             <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Message" Color="Color.Primary" FullWidth="true" Style="justify-content: flex-start;">Internal Chat</MudButton>
                        </MudStack>
                    </MudCard>

                    <!-- Company Info Card -->
                    @if (_customer.CompanyId.HasValue)
                    {
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">Company Details</MudText>
                            </MudStack>
                            
                            <MudStack Spacing="3">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Company Name</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@_customer.CompanyName</MudText>
                                </div>
                                @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tax ID / VAT</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyVatNumber</MudText>
                                    </div>
                                }
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Segment & Tier</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ma-0">@_customer.CompanySegment</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ma-0">@_customer.CompanyTier</MudChip>
                                    </MudStack>
                                </div>
                                @if (_customer.CompanyBillingAddress != null)
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Billing Address</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_customer.CompanyPhone))
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Phone</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyPhone</MudText>
                                    </div>
                                }
                            </MudStack>

                             <MudButton Variant="Variant.Outlined" FullWidth="true" Color="Color.Primary" Size="Size.Small" 
                                        Class="mt-4 rounded-lg" OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{_customer.CompanyId}"))">
                                 View Company Profile
                             </MudButton>
                        </MudCard>
                    }

                    <!-- Internal Notes -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-4">Internal Notes</MudText>
                        @if (_customer.Notes?.Any() == true)
                        {
                            <MudStack Spacing="3">
                                @foreach (var note in _customer.Notes.OrderByDescending(n => n.CreatedAt).Take(2))
                                {
                                    <div>
                                        <MudText Typo="Typo.body2" Class="mb-1">@note.NoteText</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@note.CreatedBy • @note.CreatedAt.ToShortDateString()</MudText>
                                    </div>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No internal notes.</MudText>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Class="mt-4" Size="Size.Small" OnClick="ViewAllNotes">View All Notes</MudButton>
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private CustomerDetailDto? _customer;
    private bool _loading = true;
    private bool _isEditMode = false;
    private bool _isSaving = false;
    
    private MudForm? _editForm;
    private UpdateCustomerRequest _updateRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerData();
    }

    private async Task LoadCustomerData()
    {
        _loading = true;
        try
        {
            _customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{Id}");
            if (_customer != null)
            {
                MapToUpdateRequest();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void MapToUpdateRequest()
    {
        if (_customer == null) return;
        
        _updateRequest = new UpdateCustomerRequest
        {
            FirstName = _customer.FirstName,
            LastName = _customer.LastName,
            Email = _customer.Email,
            Mobile = _customer.Mobile,
            Landline = _customer.Landline,
            Extension = _customer.Extension,
            Segment = _customer.Segment,
            Tier = _customer.Tier,
            PreferredLanguage = _customer.PreferredLanguage,
            Timezone = _customer.Timezone,
            CommunicationPreferences = new Dictionary<string, bool>(_customer.CommunicationPreferences),
            Version = _customer.Version
        };
    }

    private void ToggleEditMode()
    {
        if (_isEditMode)
        {
            // Reset request when canceling
            MapToUpdateRequest();
        }
        _isEditMode = !_isEditMode;
    }

    private async Task SaveChanges()
    {
        if (_editForm != null)
        {
            await _editForm.Validate();
            if (!_editForm.IsValid) return;
        }

        _isSaving = true;
        try
        {
            // Create full onboarding request for update (as we support updating addresses/notes too)
            var onboardingRequest = new CustomerOnboardingRequest
            {
                Customer = new CreateCustomerRequest
                {
                    FirstName = _updateRequest.FirstName,
                    LastName = _updateRequest.LastName,
                    Email = _updateRequest.Email,
                    Mobile = _updateRequest.Mobile,
                    Landline = _updateRequest.Landline,
                    Extension = _updateRequest.Extension,
                    Segment = _updateRequest.Segment,
                    Tier = _updateRequest.Tier,
                    PreferredLanguage = _updateRequest.PreferredLanguage,
                    Timezone = _updateRequest.Timezone,
                    CompanyId = _customer?.CompanyId,
                    CommunicationPreferences = _updateRequest.CommunicationPreferences
                },
                Addresses = _customer?.Addresses.Select(a => new CreateAddressRequest
                {
                    Type = a.Type,
                    IsDefault = a.IsDefault,
                    AddressLine1 = a.AddressLine1,
                    AddressLine2 = a.AddressLine2,
                    AddressLine3 = a.AddressLine3,
                    District = a.District,
                    City = a.City,
                    StateProvince = a.StateProvince,
                    PostalCode = a.PostalCode,
                    CountryId = a.CountryId
                }).ToList() ?? new List<CreateAddressRequest>()
            };

            var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer updated successfully!", Severity.Success);
                _isEditMode = false;
                await LoadCustomerData();
            }
            else
            {
                string errorMessage = "Update failed";
                try
                {
                    var error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                    if (error != null)
                    {
                        errorMessage = !string.IsNullOrEmpty(error.Message) ? error.Message : (!string.IsNullOrEmpty(error.Title) ? error.Title : errorMessage);
                    }
                }
                catch
                {
                    var rawError = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrEmpty(rawError))
                    {
                        errorMessage = rawError.Length < 100 ? rawError : errorMessage;
                    }
                }
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AddAddress()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        // We'll reuse the logic from CustomerNew for address addition, but simplified for a dialog or inline
        // For now, let's just add a blank address and enter edit mode if not already
        if (_customer == null) return;
        
        var newAddress = new AddressResponse
        {
            Type = _customer.Addresses.Count(a => a.Type == "Billing") >= 1 ? "Shipping" : "Billing",
            IsDefault = !_customer.Addresses.Any(a => a.Type == "Billing"),
            AddressLine1 = "New Address"
        };
        
        _customer.Addresses.Add(newAddress);
        _isEditMode = true;
        StateHasChanged();
    }

    private void RemoveAddress(AddressResponse address)
    {
        _customer?.Addresses.Remove(address);
        StateHasChanged();
    }

    private async Task ViewAllNotes()
    {
        if (_customer == null) return;

        var parameters = new DialogParameters<NoteDialog>
        {
            { x => x.Notes, _customer.Notes }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<NoteDialog>("Internal Notes", parameters, options);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Warning,
        "Blocked" => Color.Error,
        _ => Color.Default
    };

    private string GetDocumentIcon(string mimeType) => mimeType switch
    {
        "application/pdf" => Icons.Custom.FileFormats.FilePdf,
        "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Custom.FileFormats.FileDocument,
        "image/jpeg" or "image/png" => Icons.Custom.FileFormats.FileImage,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private Color GetDocumentColor(string mimeType) => mimeType switch
    {
        "application/pdf" => Color.Error,
        "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Color.Info,
        "image/jpeg" or "image/png" => Color.Success,
        _ => Color.Default
    };

    private string FormatFileSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        int unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }
        return $"{size:F1} {units[unitIndex]}";
    }
