                             <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Message" Color="Color.Primary" FullWidth="true" Style="justify-content: flex-start;">Internal Chat</MudButton>
                        </MudStack>
                    </MudCard>

                    <!-- Company Info Card -->
                    @if (_customer.CompanyId.HasValue)
                    {
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
