@page "/sales/customers/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Client.Services
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISignalRCustomerService SignalRService
@implements IAsyncDisposable

<PageTitle>@(_customer?.Name ?? "Customer Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16 pt-8">
    @if (_customer == null && !_loading)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">Customer not found.</MudAlert>
    }
    else if (_loading && _customer == null)
    {
        <MudGrid>
            <MudItem xs="12" lg="8">
                <MudSkeleton Height="60px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="400px" Class="rounded-lg" />
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudSkeleton Height="300px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="200px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else if (_customer != null)
    {
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-8">
            <MudStack Spacing="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h3" Style="font-weight: 700;">@_customer.Name</MudText>
                    <MudChip T="string" Color="@GetStatusColor(_customer.Status)" Size="Size.Small" Variant="Variant.Filled" Class="mt-1">@_customer.Status</MudChip>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Customer ID: @_customer.Id</MudText>
            </MudStack>
            
            <MudStack Row="true" Spacing="2">
                 <MudButton Variant="Variant.Outlined" 
                            Color="Color.Primary" 
                            StartIcon="@(_isEditMode ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)"
                            OnClick="ToggleEditMode"
                            Class="px-6 rounded-lg">
                     @( _isEditMode ? "Cancel Editing" : "Edit Profile")
                 </MudButton>
                 @if (!_isEditMode)
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Add"
                                Class="px-6 rounded-lg shadow-none">
                         Create Order
                     </MudButton>
                 }
                 else
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveChanges"
                                Disabled="@_isSaving"
                                Class="px-6 rounded-lg shadow-none">
                         @if (_isSaving)
                         {
                             <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                             <span>Saving...</span>
                         }
                         else
                         {
                             <span>Save Changes</span>
                         }
                     </MudButton>
                 }
            </MudStack>
        </MudStack>

        <MudGrid Spacing="6">
            <!-- Left Column: Main Content -->
            <MudItem xs="12" lg="8">
                <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    
                    @if (!_isEditMode)
                    {
                        @* View Mode Tabs *@
                        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
                            <MudGrid Spacing="4">
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Total Spent</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.TotalSpent.ToString("C0", new CultureInfo("th-TH"))</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Active Orders</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.ActiveOrdersCount</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Open Quotations</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.OpenQuotationsCount</MudText>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Recent Activity</MudText>
                                        <MudStack Spacing="4">
                                            <div class="d-flex gap-4">
                                                <MudAvatar Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Style="background-color: var(--mud-palette-primary-hover);"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small"/></MudAvatar>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">Customer profile created</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @_customer.CreatedAt.ToLocalTime().ToString("g") • by 
                                                        @(!string.IsNullOrEmpty(_customer.CreatedByName) ? $"{_customer.CreatedByName} ({_customer.CreatedByEmail})" : (_customer.CreatedBy ?? "System"))
                                                    </MudText>
                                                </MudStack>
                                            </div>
                                            @if (_customer.Notes?.Any() == true)
                                            {
                                                <MudDivider />
                                                var latestNote = _customer.Notes.OrderByDescending(n => n.CreatedAt).First();
                                                <div class="d-flex gap-4">
                                                    <MudAvatar Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Style="background-color: var(--mud-palette-info-hover);"><MudIcon Icon="@Icons.Material.Filled.Note" Size="Size.Small"/></MudAvatar>
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">Internal note added</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @latestNote.CreatedAt.ToLocalTime().ToString("g") • by 
                                                            @(!string.IsNullOrEmpty(latestNote.CreatedByName) ? $"{latestNote.CreatedByName} ({latestNote.CreatedByEmail})" : latestNote.CreatedBy)
                                                        </MudText>
                                                    </MudStack>
                                                </div>
                                            }
                                        </MudStack>
                                    </MudCard>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="Addresses" Icon="@Icons.Material.Filled.LocationOn">
                            <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Delivery & Billing</MudText>
                                </MudStack>
                                
                                <MudGrid Spacing="4">
                                    @if (_customer.Addresses != null && _customer.Addresses.Any())
                                    {
                                        @foreach (var (address, index) in _customer.Addresses.Select((a, i) => (a, i)))
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default h-100" Style="background-color: var(--mud-palette-background-grey);">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
                                                        <MudChip T="string" Color="@(address.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Filled">@address.Type</MudChip>
                                                        @if (address.IsDefault)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                                        }
                                                    </MudStack>
                                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@address.AddressLine1</MudText>
                                                    @if (!string.IsNullOrEmpty(address.AddressLine2)) { <MudText Typo="Typo.body2">@address.AddressLine2</MudText> }
                                                    @if (!string.IsNullOrEmpty(address.AddressLine3)) { <MudText Typo="Typo.body2">@address.AddressLine3</MudText> }
                                                    <MudText Typo="Typo.body2">@address.District, @address.City</MudText>
                                                    <MudText Typo="Typo.body2">@address.StateProvince @address.PostalCode</MudText>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    }
                                    else if (_customer.CompanyId.HasValue && _customer.CompanyBillingAddress != null)
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Text">Using Company billing address. Individual customer addresses not found.</MudAlert>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default h-100" Style="background-color: var(--mud-palette-background-grey);">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Company Billing</MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                                </MudStack>
                                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                                <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                                <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Text">No addresses found for this customer.</MudAlert>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>
                        </MudTabPanel>

                        <MudTabPanel Text="Documents" Icon="@Icons.Material.Filled.Attachment">
                             <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Documents & NDA</MudText>
                                </MudStack>
                                <MudGrid Spacing="4">
                                    @if (_customer.Nda != null)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Class="pa-4 d-flex align-center gap-4 rounded-lg border-solid border-1 mud-border-lines-default" Elevation="0">
                                                <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Primary" Size="Size.Large" />
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">NDA Record</MudText>
                                                    <MudText Typo="Typo.caption">Status: @_customer.Nda.Status</MudText>
                                                    <MudText Typo="Typo.caption">Expires: @(_customer.Nda.ExpiresAt?.ToShortDateString() ?? "N/A")</MudText>
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                    
                                    @if (_customer.Documents?.Any() == true)
                                    {
                                        @foreach (var doc in _customer.Documents)
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Class="pa-4 d-flex align-center gap-4 rounded-lg border-solid border-1 mud-border-lines-default" Elevation="0">
                                                    <MudIcon Icon="@GetDocumentIcon(doc.MimeType)" Color="@GetDocumentColor(doc.MimeType)" Size="Size.Large" />
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 700;">@doc.FileName</MudText>
                                                        <MudText Typo="Typo.caption">@FormatFileSize(doc.FileSize) • @doc.DocumentCategory</MudText>
                                                    </MudStack>
                                                    <MudSpacer />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    }
                                    else if (_customer.Nda == null)
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Text">No documents found for this customer.</MudAlert>
                                        </MudItem>
                                    }
                                </MudGrid>
                             </MudCard>
                        </MudTabPanel>
                    }
                    else
                    {
                        @* Edit Mode Tabs *@
                        <MudTabPanel Text="Personal Information" Icon="@Icons.Material.Filled.Person">
                            <MudForm @ref="_editForm">
                                <MudStack Spacing="6">
                                    <!-- Personal Info Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Contact Details</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="First Name" @bind-Value="_updateRequest.FirstName" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Last Name" @bind-Value="_updateRequest.LastName" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudTextField T="string" Label="Email" @bind-Value="_updateRequest.Email" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Mobile" @bind-Value="_updateRequest.Mobile" Variant="Variant.Outlined" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Landline" @bind-Value="_updateRequest.Landline" Variant="Variant.Outlined" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Extension" @bind-Value="_updateRequest.Extension" Variant="Variant.Outlined" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>

                                    <!-- Preferences Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Preferences & Classification</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="Segment" @bind-Value="_updateRequest.Segment" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                                    <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                                    <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">Tier Level</MudText>
                                                <MudToggleGroup T="string" @bind-Value="_updateRequest.Tier" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" FixedContent="true" Class="w-100">
                                                    <MudToggleItem Value="@("Bronze")" Text="Bronze" />
                                                    <MudToggleItem Value="@("Silver")" Text="Silver" />
                                                    <MudToggleItem Value="@("Gold")" Text="Gold" />
                                                    <MudToggleItem Value="@("Platinum")" Text="Platinum" />
                                                </MudToggleGroup>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                 <MudSelect T="string" Label="Language" @bind-Value="_updateRequest.PreferredLanguage" Variant="Variant.Outlined">
                                                     <MudSelectItem Value="@("en")">English</MudSelectItem>
                                                     <MudSelectItem Value="@("th")">Thai</MudSelectItem>
                                                 </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                 <MudSelect T="string" Label="Timezone" @bind-Value="_updateRequest.Timezone" Variant="Variant.Outlined">
                                                     <MudSelectItem Value="@("Asia/Bangkok")">Bangkok (GMT+7)</MudSelectItem>
                                                     <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                                                 </MudSelect>
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>
                                </MudStack>
                            </MudForm>
                        </MudTabPanel>

                        <MudTabPanel Text="Addresses" Icon="@Icons.Material.Filled.LocationOn">
                            <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Manage Addresses</MudText>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddAddress">Add Address</MudButton>
                                </MudStack>
                                
                                <MudGrid Spacing="4">
                                    @foreach (var (address, index) in _editableAddresses.Select((a, i) => (a, i)))
                                    {
                                        <MudItem xs="12" sm="6">
                                            <AddressCard Address="address" 
                                                         Index="index"
                                                         HasCompany="@(_customer.CompanyId.HasValue)"
                                                         CompanyName="@_customer.CompanyName"
                                                         CustomerName="@($"{_updateRequest.FirstName} {_updateRequest.LastName}")"
                                                         CustomerMobile="@_updateRequest.Mobile"
                                                         OnTypeChanged="OnAddressTypeChanged"
                                                         OnDefaultChanged="OnDefaultChanged"
                                                         OnLocationSelected="OnThaiLocationSelected"
                                                         OnCountrySelected="OnCountrySelected"
                                                         OnRemove="RemoveAddress"
                                                         SearchLocations="SearchThaiLocations"
                                                         SearchCountries="SearchCountries"
                                                         SelectedCountry="_addressCountries.GetValueOrDefault(index)"
                                                         SelectedLocation="_addressLocations.GetValueOrDefault(index)" />
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>
                        </MudTabPanel>

                        <MudTabPanel Text="Upload Documents" Icon="@Icons.Material.Filled.UploadFile">
                             <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Upload Files</MudText>
                                <MudGrid Spacing="4">
                                    <MudItem xs="12" sm="6">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Customer Documents</MudText>
                                        <MudStack Spacing="3">
                                            <MudTextField T="string" Label="Category" @bind-Value="_customerDocCategory" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. ID Card, Business Card" />
                                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnCustomerDocsSelected" Accept=".pdf,.jpg,.png,.doc" MaximumFileCount="10">
                                                <ActivatorContent>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.AttachFile">Select Files</MudButton>
                                                </ActivatorContent>
                                            </MudFileUpload>
                                            @if (_customerDocFiles.Any())
                                            {
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="UploadCustomerDocuments" Disabled="@_isUploadingCustomerDocs">
                                                    @(_isUploadingCustomerDocs ? "Uploading..." : $"Upload {_customerDocFiles.Count} File(s)")
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">NDA Document</MudText>
                                        <MudStack Spacing="3">
                                            <MudDatePicker Label="NDA Expiration" @bind-Date="_ndaExpiryDate" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnNdaFilesSelected" Accept=".pdf,.doc,.docx" MaximumFileCount="1">
                                                <ActivatorContent>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.Gavel">Select Signed NDA</MudButton>
                                                </ActivatorContent>
                                            </MudFileUpload>
                                            @if (_ndaFiles.Any())
                                            {
                                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="UploadNdaFiles" Disabled="@_isUploadingNda">
                                                    @(_isUploadingNda ? "Uploading..." : "Upload NDA")
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                             </MudCard>
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudItem>

            <!-- Right Column: Sidebar Stats & Info -->
            <MudItem xs="12" lg="4">
                <MudStack Spacing="6">
                    <!-- Profile Card -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                            <MudAvatar Color="Color.Primary" Style="height:80px; width:80px;" Variant="Variant.Filled">
                                @(_customer.FirstName?[0])@(_customer.LastName?[0])
                            </MudAvatar>
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">@_customer.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_customer.Email</MudText>
                        </MudStack>
                        
                        <MudStack Spacing="3">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Phone</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@(_customer.Mobile ?? "N/A")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Language</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@(_customer.PreferredLanguage == "th" ? "Thai" : "English")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Timezone</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@_customer.Timezone</MudText>
                            </div>
                        </MudStack>

                        <MudDivider Class="my-6" />

                        <MudStack Spacing="3">
                             <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Email" Color="Color.Primary" FullWidth="true" Style="justify-content: flex-start;">Send Email</MudButton>
                             <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Message" Color="Color.Primary" FullWidth="true" Style="justify-content: flex-start;">Internal Chat</MudButton>
                        </MudStack>
                    </MudCard>

                    <!-- Company Info Card -->
                    @if (_customer.CompanyId.HasValue)
                    {
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.h6" Style="font-weight: 700;">Company Details</MudText>
                            </MudStack>
                            
                            <MudStack Spacing="3">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Company Name</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@_customer.CompanyName</MudText>
                                </div>
                                @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tax ID / VAT</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyVatNumber</MudText>
                                    </div>
                                }
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Segment & Tier</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ma-0">@_customer.CompanySegment</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ma-0">@_customer.CompanyTier</MudChip>
                                    </MudStack>
                                </div>
                                @if (_customer.CompanyBillingAddress != null)
                                {
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Billing Address</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                        <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                    </div>
                                }
                            </MudStack>

                             <MudButton Variant="Variant.Outlined" FullWidth="true" Color="Color.Primary" Size="Size.Small" 
                                        Class="mt-4 rounded-lg" OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{_customer.CompanyId}"))">
                                 View Company Profile
                             </MudButton>
                        </MudCard>
                    }

                    <!-- Internal Notes -->
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-4">Internal Notes</MudText>
                        @if (_customer.Notes?.Any() == true)
                        {
                            <MudStack Spacing="3">
                                @foreach (var note in _customer.Notes.OrderByDescending(n => n.CreatedAt).Take(2))
                                {
                                    <div>
                                        <MudText Typo="Typo.body2" Class="mb-1">@note.NoteText</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@note.CreatedByName • @note.CreatedAt.ToShortDateString()</MudText>
                                    </div>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No internal notes.</MudText>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Class="mt-4" Size="Size.Small" OnClick="ViewAllNotes">View All Notes</MudButton>
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private CustomerDetailDto? _customer;
    private bool _loading = true;
    private bool _isEditMode = false;
    private bool _isSaving = false;
    private int _activeTabIndex = 0;
    
    private MudForm? _editForm;
    private UpdateCustomerRequest _updateRequest = new();
    private List<CreateAddressRequest> _editableAddresses = [];
    private Dictionary<int, CountryDto?> _addressCountries = new();
    private Dictionary<int, RegistryThaiLocation?> _addressLocations = new();
    private List<CountryDto> _allCountries = new();

    // File Upload
    private List<IBrowserFile> _ndaFiles = new();
    private List<IBrowserFile> _customerDocFiles = new();
    private string _customerDocCategory = "General";
    private bool _isUploadingNda = false;
    private bool _isUploadingCustomerDocs = false;
    private DateTime? _ndaExpiryDate = DateTime.Now.AddYears(1);

    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
        await LoadCustomerData();
        
        // SignalR Real-time
        await SignalRService.StartAsync();
        SignalRService.OnCustomerChanged += async () => {
            if (!_isEditMode) await LoadCustomerData();
        };
    }

    private async Task LoadCountries()
    {
        try { _allCountries = await Http.GetFromJsonAsync<List<CountryDto>>("api/customers/countries") ?? []; }
        catch { }
    }

    private async Task LoadCustomerData()
    {
        _loading = true;
        try
        {
            _customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{Id}");
            if (_customer != null)
            {
                MapToUpdateRequest();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void MapToUpdateRequest()
    {
        if (_customer == null) return;
        
        _updateRequest = new UpdateCustomerRequest
        {
            FirstName = _customer.FirstName,
            LastName = _customer.LastName,
            Email = _customer.Email,
            Mobile = _customer.Mobile,
            Landline = _customer.Landline,
            Extension = _customer.Extension,
            Segment = _customer.Segment,
            Tier = _customer.Tier,
            PreferredLanguage = _customer.PreferredLanguage,
            Timezone = _customer.Timezone,
            CommunicationPreferences = new Dictionary<string, bool>(_customer.CommunicationPreferences),
            Version = _customer.Version
        };

        // Map existing addresses for editing
        _editableAddresses = _customer.Addresses.Select(a => new CreateAddressRequest
        {
            Type = a.Type,
            IsDefault = a.IsDefault,
            AddressLine1 = a.AddressLine1,
            AddressLine2 = a.AddressLine2,
            AddressLine3 = a.AddressLine3,
            District = a.District,
            City = a.City,
            StateProvince = a.StateProvince,
            PostalCode = a.PostalCode,
            CountryId = a.CountryId
        }).ToList();

        _addressCountries.Clear();
        _addressLocations.Clear();
        for (int i = 0; i < _editableAddresses.Count; i++)
        {
            var addr = _editableAddresses[i];
            _addressCountries[i] = _allCountries.FirstOrDefault(c => c.Id == addr.CountryId);
        }
    }

    private async Task ToggleEditMode()
    {
        if (_isEditMode)
        {
            // Discard changes
            var confirm = await DialogService.ShowMessageBox("Discard Changes", 
                "Are you sure you want to discard your changes?", 
                yesText: "Discard", cancelText: "Keep Editing");
                
            if (confirm == true)
            {
                _isEditMode = false;
                _activeTabIndex = 0; // Back to Overview
                await LoadCustomerData();
            }
        }
        else
        {
            _isEditMode = true;
            _activeTabIndex = 0; // To Personal Info
            MapToUpdateRequest();
        }
    }

    private async Task SaveChanges()
    {
        if (_editForm != null)
        {
            await _editForm.Validate();
            if (!_editForm.IsValid) return;
        }

        _isSaving = true;
        try
        {
            var onboardingRequest = new CustomerOnboardingRequest
            {
                Customer = new CreateCustomerRequest
                {
                    FirstName = _updateRequest.FirstName,
                    LastName = _updateRequest.LastName,
                    Email = _updateRequest.Email,
                    Mobile = _updateRequest.Mobile,
                    Landline = _updateRequest.Landline,
                    Extension = _updateRequest.Extension,
                    Segment = _updateRequest.Segment,
                    Tier = _updateRequest.Tier,
                    PreferredLanguage = _updateRequest.PreferredLanguage,
                    Timezone = _updateRequest.Timezone,
                    CompanyId = _customer?.CompanyId,
                    CommunicationPreferences = _updateRequest.CommunicationPreferences
                },
                Addresses = _editableAddresses
            };

            var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer updated successfully!", Severity.Success);
                _isEditMode = false;
                _activeTabIndex = 0;
                await LoadCustomerData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                Snackbar.Add(error?.Message ?? "Update failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    #region Address Management Logic

    private async Task<IEnumerable<RegistryThaiLocation>> SearchThaiLocations(string? query, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(query) || query.Length < 2) return [];
        try
        {
            return await Http.GetFromJsonAsync<List<RegistryThaiLocation>>($"api/customers/locations/thai?query={Uri.EscapeDataString(query)}&limit=10") ?? [];
        }
        catch { return []; }
    }

    private void OnThaiLocationSelected(int index, RegistryThaiLocation? location)
    {
        if (index >= _editableAddresses.Count || location == null) return;
        var addr = _editableAddresses[index];
        _addressLocations[index] = location;
        addr.District = location.SubDistrictEn;
        addr.City = location.DistrictEn;
        addr.StateProvince = location.ProvinceEn;
        addr.PostalCode = location.PostalCode;
        var thai = _allCountries.FirstOrDefault(c => c.Code == "TH");
        if (thai != null) OnCountrySelected(index, thai);
    }

    private async Task<IEnumerable<CountryDto>> SearchCountries(string? query, CancellationToken ct)
    {
        if (string.IsNullOrEmpty(query)) return _allCountries;
        return _allCountries.Where(c => c.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private void OnCountrySelected(int index, CountryDto? country)
    {
        if (index >= _editableAddresses.Count) return;
        _addressCountries[index] = country;
        if (country != null) _editableAddresses[index].CountryId = country.Id;
    }

    private void OnAddressTypeChanged(int index, string type) => _editableAddresses[index].Type = type;
    private void OnDefaultChanged(int index, bool val)
    {
        foreach (var a in _editableAddresses.Where(x => x.Type == _editableAddresses[index].Type)) a.IsDefault = false;
        _editableAddresses[index].IsDefault = val;
    }

    private void AddAddress()
    {
        var newAddr = new CreateAddressRequest { Type = "Shipping", IsDefault = !_editableAddresses.Any(a => a.Type == "Shipping") };
        var thai = _allCountries.FirstOrDefault(c => c.Code == "TH");
        if (thai != null) newAddr.CountryId = thai.Id;
        _editableAddresses.Add(newAddr);
        _addressCountries[_editableAddresses.Count - 1] = thai;
    }

    private void RemoveAddress(int index) => _editableAddresses.RemoveAt(index);

    #endregion

    #region File Upload Logic

    private void OnNdaFilesSelected(IReadOnlyList<IBrowserFile> files) { _ndaFiles.Clear(); _ndaFiles.AddRange(files); }
    private void OnCustomerDocsSelected(IReadOnlyList<IBrowserFile> files) { _customerDocFiles.Clear(); _customerDocFiles.AddRange(files); }

    private async Task UploadNdaFiles() => await UploadFiles(_ndaFiles, "NDA", true);
    private async Task UploadCustomerDocuments() => await UploadFiles(_customerDocFiles, _customerDocCategory, false);

    private async Task UploadFiles(List<IBrowserFile> files, string category, bool isNda)
    {
        if (isNda) _isUploadingNda = true; else _isUploadingCustomerDocs = true;
        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in files)
            {
                var stream = file.OpenReadStream(10 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }
            var response = await Http.PostAsync($"api/aiprocessing/upload-documents?category={category}", content);
            if (response.IsSuccessStatusCode)
            {
                var results = await response.Content.ReadFromJsonAsync<List<BffUploadResponse>>();
                // In CustomerDetails, we usually want to persist these immediately or wait for Save.
                // For simplicity, we'll reload data to show them in View Mode after Save, 
                // but since these are uploaded to storage, we need to create the DB references.
                // Let's create the references now.
                var docs = results?.Select(r => new CreateDocumentRequest { 
                    DocumentCategory = category, FileReference = r.StoragePath ?? r.FileReference, 
                    FileName = r.FileName, FileSize = r.Size, MimeType = GetMimeType(r.FileName),
                    DocumentSubType = isNda ? "Signed" : null
                }).ToList() ?? [];
                
                // Call BFF to link documents
                await Http.PostAsJsonAsync($"api/aiprocessing/link-documents?ownerType=Customer&ownerId={Id}", docs);
                
                if (isNda && _ndaExpiryDate.HasValue)
                {
                    // Create NDA record
                    await Http.PostAsJsonAsync("api/customers/ndas", new { customerId = Id, expiresAt = _ndaExpiryDate, status = "Signed" });
                }

                Snackbar.Add("Files uploaded and linked successfully", Severity.Success);
                files.Clear();
                await LoadCustomerData();
            }
        }
        catch (Exception ex) { Snackbar.Add($"Upload error: {ex.Message}", Severity.Error); }
        finally { if (isNda) _isUploadingNda = false; else _isUploadingCustomerDocs = false; }
    }

    private static string GetMimeType(string fileName) => Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".pdf" => "application/pdf",
        ".doc" or ".docx" => "application/msword",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        _ => "application/octet-stream"
    };

    #endregion

    private async Task ViewAllNotes()
    {
        if (_customer == null) return;
        var parameters = new DialogParameters<NoteDialog> { { x => x.Notes, _customer.Notes } };
        await DialogService.ShowAsync<NoteDialog>("Internal Notes", parameters, new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private Color GetStatusColor(string status) => status switch { "Active" => Color.Success, "Inactive" => Color.Warning, "Blocked" => Color.Error, _ => Color.Default };
    private string GetDocumentIcon(string mimeType) => mimeType.Contains("pdf") ? Icons.Custom.FileFormats.FilePdf : mimeType.Contains("image") ? Icons.Custom.FileFormats.FileImage : Icons.Custom.FileFormats.FileDocument;
    private Color GetDocumentColor(string mimeType) => mimeType.Contains("pdf") ? Color.Error : mimeType.Contains("image") ? Color.Success : Color.Info;
    private string FormatFileSize(long bytes) => $"{(bytes / 1024.0 / 1024.0):F2} MB";

    public async ValueTask DisposeAsync()
    {
        SignalRService.OnCustomerChanged -= async () => { if (!_isEditMode) await LoadCustomerData(); };
    }
}
