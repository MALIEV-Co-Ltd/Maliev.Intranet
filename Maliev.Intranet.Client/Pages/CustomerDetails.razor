@page "/sales/customers/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Client.Services
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISignalRCustomerService SignalRService
@inject IJSRuntime JSRuntime
@inject LayoutService LayoutService
@implements IAsyncDisposable

<PageTitle>@(_customer?.Name ?? "Customer Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16 pt-8">
    @if (_customer == null && !_loading)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">Customer not found.</MudAlert>
    }
    else if (_loading && _customer == null)
    {
        <MudGrid>
            <MudItem xs="12" lg="8">
                <MudSkeleton Height="60px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="400px" Class="rounded-lg" />
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudSkeleton Height="300px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="200px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else if (_customer != null)
    {
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-8">
            <MudStack Spacing="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h3" Style="font-weight: 700;">@_customer.Name</MudText>
                    <MudChip T="string" Color="@GetStatusColor(_customer.Status)" Size="Size.Small" Variant="Variant.Filled" Class="mt-1">@_customer.Status</MudChip>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Customer ID: @_customer.Id</MudText>
            </MudStack>
            
            <MudStack Row="true" Spacing="2">
                 <MudButton Variant="Variant.Outlined" 
                            Color="Color.Primary" 
                            StartIcon="@(_isEditMode ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)"
                            OnClick="ToggleEditMode"
                            Class="px-6 rounded-lg">
                     @( _isEditMode ? "Cancel Editing" : "Edit Profile")
                 </MudButton>
                 @if (!_isEditMode)
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Add"
                                Class="px-6 rounded-lg shadow-none">
                         Create Order
                     </MudButton>
                 }
                 else
                 {
                     <MudButton Variant="Variant.Filled" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveChanges"
                                Disabled="@_isSaving"
                                Class="px-6 rounded-lg shadow-none">
                         @if (_isSaving)
                         {
                             <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                             <span>Saving...</span>
                         }
                         else
                         {
                             <span>Save Changes</span>
                         }
                     </MudButton>
                 }
            </MudStack>
        </MudStack>

        <MudGrid Spacing="6">
            <!-- Left Column: Main Content -->
            <MudItem xs="12" lg="8">
                <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    
                    @if (!_isEditMode)
                    {
                        @* View Mode Tabs *@
                        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
                            <MudGrid Spacing="4">
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Total Spent</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.TotalSpent.ToString("C0", new CultureInfo("th-TH"))</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Active Orders</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.ActiveOrdersCount</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Open Quotations</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.OpenQuotationsCount</MudText>
                                    </MudPaper>
                                </MudItem>

                                 <MudItem xs="12">
                                     <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                         <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Recent Activity</MudText>
                                         <div style="max-height: 400px; overflow-y: auto;" class="pr-2">
                                             <MudStack Spacing="4">
                                                 @if (_activities != null && _activities.Any())
                                                 {
                                                     @foreach (var activity in _activities.Take(20))
                                                     {
                                                         <div class="d-flex gap-4">
                                                              <MudAvatar Color="@GetActivityColor(activity.Action)" Size="Size.Small" Variant="Variant.Filled" Style="color: white;">
                                                                  <MudIcon Icon="@GetActivityIcon(activity.Action)" Size="Size.Small"/>
                                                              </MudAvatar>

                                                             <MudStack Spacing="0" Class="flex-grow-1">
                                                                 <MudText Typo="Typo.body2" Style="font-weight: 500; white-space: pre-wrap;">@activity.Description</MudText>
                                                                 <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                     @activity.Timestamp.ToLocalTime().ToString("g") • by 
                                                                     @(!string.IsNullOrEmpty(activity.ActorName) ? $"{activity.ActorName} ({activity.ActorEmail})" : activity.ActorId)
                                                                 </MudText>
                                                             </MudStack>
                                                         </div>
                                                         @if (activity != _activities.Take(20).Last()) { <MudDivider /> }
                                                     }
                                                 }
                                                 else
                                                 {
                                                     <MudAlert Severity="Severity.Info" Variant="Variant.Text">No recent activity found.</MudAlert>
                                                 }
                                             </MudStack>
                                         </div>
                                     </MudCard>
                                 </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="Addresses" Icon="@Icons.Material.Filled.LocationOn">
                            <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Delivery & Billing</MudText>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAddressDialog">Add Address</MudButton>
                                </MudStack>
                                
                                <MudGrid Spacing="4">
                                    @if (_customer.Addresses != null && _customer.Addresses.Any())
                                    {
                                        @foreach (var (address, index) in _customer.Addresses.Select((a, i) => (a, i)))
                                        {
                                            <MudItem xs="12" sm="6" Class="d-flex">
                                                <MudPaper Elevation="3" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default flex-grow-1"
                                                          Style="@(LayoutService.IsDarkMode ? "background-color: #27272f;" : "background-color: #ffffff;")">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="@(address.Type == "Billing" ? Icons.Material.Filled.ReceiptLong : Icons.Material.Filled.LocalShipping)" 
                                                                     Color="@(address.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" />
                                                            <MudChip T="string" Color="@(address.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Filled">@address.Type</MudChip>
                                                        </MudStack>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                                            @if (address.IsDefault)
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;" Class="mr-2">DEFAULT</MudText>
                                                            }
                                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAddressDialog(address))" />
                                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAddressToClipboard(address))" />
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAddress(address))" />
                                                        </MudStack>
                                                    </MudStack>

                                                    @if (address.Type == "Billing")
                                                    {
                                                        if (_customer.CompanyId.HasValue)
                                                        {
                                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@_customer.CompanyName</MudText>
                                                            @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                                            {
                                                                <MudText Typo="Typo.caption" Class="d-block mb-2">เลขประจำตัวผู้เสียภาษี @_customer.CompanyVatNumber</MudText>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@_customer.Name</MudText>
                                                            <MudText Typo="Typo.caption" Class="d-block mb-2">@_customer.Mobile</MudText>
                                                        }
                                                    }

                                                    @if (address.Type == "Shipping")
                                                    {
                                                        <MudStack Spacing="0" Class="mb-2">
                                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(string.IsNullOrEmpty(address.RecipientName) ? _customer.Name : address.RecipientName)</MudText>
                                                            <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(address.RecipientPhone) ? _customer.Mobile : address.RecipientPhone)</MudText>
                                                        </MudStack>
                                                    }

                                                    <MudText Typo="Typo.body2">@address.AddressLine1</MudText>
                                                    @if (!string.IsNullOrEmpty(address.AddressLine2)) { <MudText Typo="Typo.body2">@address.AddressLine2</MudText> }
                                                    @if (!string.IsNullOrEmpty(address.AddressLine3)) { <MudText Typo="Typo.body2">@address.AddressLine3</MudText> }
                                                    <MudText Typo="Typo.body2">@address.District, @address.City</MudText>
                                                    <MudText Typo="Typo.body2">@address.StateProvince @address.PostalCode</MudText>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    }
                                    else if (_customer.CompanyId.HasValue && _customer.CompanyBillingAddress != null)
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Text">Using Company billing address. Individual customer addresses not found.</MudAlert>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" Class="d-flex">
                                                <MudPaper Elevation="3" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default flex-grow-1"
                                                          Style="@(LayoutService.IsDarkMode ? "background-color: #27272f;" : "background-color: #ffffff;")">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Small" />
                                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Company Billing</MudChip>
                                                        </MudStack>
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAddressToClipboard(_customer.CompanyBillingAddress))" />
                                                        </MudStack>
                                                    </MudStack>
                                                    
                                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@_customer.CompanyName</MudText>
                                                    @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                                    {
                                                        <MudText Typo="Typo.caption" Class="d-block mb-2">เลขประจำตัวผู้เสียภาษี @_customer.CompanyVatNumber</MudText>
                                                    }

                                                    <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                                    <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                                    <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                                </MudPaper>
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Text">No addresses found for this customer.</MudAlert>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCard>
                        </MudTabPanel>

                        <MudTabPanel Text="Docs" Icon="@Icons.Material.Filled.Attachment">
                             <MudStack Spacing="6">
                                <!-- NDA Section -->
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.h6" Style="font-weight: 700;">NDA Agreement</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Non-Disclosure Agreement for this customer</MudText>
                                        </MudStack>
                                        
                                        <MudStack Row="true">
                                            @if (_customer.Nda != null)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditNdaDialog">Edit NDA</MudButton>
                                            }
                                            else
                                            {
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" OnClick="OpenNdaUpload">Upload Signed NDA</MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    @if (_customer.Nda != null)
                                    {
                                        <MudPaper Class="pa-4 d-flex align-center gap-4 rounded-lg border-solid border-1 mud-border-lines-default" 
                                                  Elevation="0" Style="@(LayoutService.IsDarkMode ? "background-color: #27272f;" : "background-color: #ffffff;")">
                                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="@(_customer.Nda.Status == "Signed" ? Color.Success : Color.Primary)" Size="Size.Large" />
                                            <MudStack Spacing="0" Class="flex-grow-1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">NDA Record</MudText>
                                                    <MudChip T="string" Size="Size.Small" Color="@(_customer.Nda.Status == "Signed" ? Color.Success : Color.Default)" Variant="Variant.Filled">@_customer.Nda.Status</MudChip>
                                                </MudStack>
                                                <MudText Typo="Typo.caption">Expires: @(_customer.Nda.ExpiresAt?.ToShortDateString() ?? "N/A")</MudText>
                                            </MudStack>
                                            <MudStack Row="true">
                                                @if (_customer.Nda.Status == "Draft")
                                                {
                                                    <MudTooltip Text="Mark as Signed">
                                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="MarkNdaAsSigned" />
                                                    </MudTooltip>
                                                }
                                                @if (_customer.Nda.DocumentReferenceId.HasValue)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(_customer.Nda.DocumentReferenceId.Value.ToString()))" />
                                                }
                                            </MudStack>
                                        </MudPaper>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">No NDA recorded for this customer.</MudAlert>
                                    }
                                </MudCard>

                                <!-- Customer Documents Section -->
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.h6" Style="font-weight: 700;">Customer Documents</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Supporting documents and identification</MudText>
                                        </MudStack>
                                        
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Primary" 
                                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                                   OnClick="OpenDocumentUpload">
                                            Upload Documents
                                        </MudButton>
                                    </MudStack>

                                    <DocumentViewer Documents="@(_customer.Documents ?? [])" 
                                                    OnDownload="DownloadDocument" 
                                                    GetPreviewUrlFunc="GetDocumentPreviewUrl" />
                                </MudCard>
                             </MudStack>
                        </MudTabPanel>

                        <MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.Note">
                             <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Internal Notes</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                        <MudTextField @bind-Value="_noteSearchString" Placeholder="Search notes..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddInternalNote">Add Note</MudButton>
                                    </MudStack>
                                </MudStack>

                                @if (_customer.Notes != null && _customer.Notes.Any())
                                {
                                    <MudStack Spacing="4">
                                        @foreach (var note in FilteredNotes)
                                        {
                                            <MudPaper Elevation="1" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default"
                                                      Style="@(LayoutService.IsDarkMode ? "background-color: #27272f;" : "background-color: #ffffff;")">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                        <MudAvatar Color="Color.Primary" Size="Size.Small">
                                                            @((note.CreatedByName ?? note.CreatedBy)?[0])
                                                        </MudAvatar>
                                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">
                                                            @(!string.IsNullOrEmpty(note.CreatedByName) ? note.CreatedByName : note.CreatedBy)
                                                        </MudText>
                                                    </MudStack>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@note.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditInternalNote(note))" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteInternalNote(note))" />
                                                    </MudStack>
                                                </MudStack>
                                                <MudDivider Class="mb-3" />
                                                <div class="note-content">
                                                    @if (!string.IsNullOrEmpty(_noteSearchString))
                                                    {
                                                        <MudHighlighter Text="@note.NoteText" HighlightedText="@_noteSearchString" />
                                                    }
                                                    else
                                                    {
                                                        <MarkdownRenderer Markdown="@note.NoteText" />
                                                    }
                                                </div>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No internal notes for this customer.</MudAlert>
                                }
                             </MudCard>
                        </MudTabPanel>
                    }
                    else
                    {
                        @* Edit Mode Tabs - Only Personal Information *@
                        <MudTabPanel Text="Profile" Icon="@Icons.Material.Filled.Person">
                            <MudForm @ref="_editForm">
                                <MudStack Spacing="6">
                                    <!-- Personal Info Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Contact Details</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="First Name" @bind-Value="_updateRequest.FirstName" Variant="Variant.Outlined" Required="true" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Last Name" @bind-Value="_updateRequest.LastName" Variant="Variant.Outlined" Required="true" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Mobile" @bind-Value="_updateRequest.Mobile" Variant="Variant.Outlined" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Landline" @bind-Value="_updateRequest.Landline" Variant="Variant.Outlined" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField T="string" Label="Extension (Company Landline)" @bind-Value="_updateRequest.Extension" Variant="Variant.Outlined" Immediate="true" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>

                                    <!-- Preferences Edit -->
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-6">Preferences & Classification</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="Segment" @bind-Value="_updateRequest.Segment" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="@("Retail")">Retail</MudSelectItem>
                                                    <MudSelectItem Value="@("Wholesale")">Wholesale</MudSelectItem>
                                                    <MudSelectItem Value="@("Enterprise")">Enterprise</MudSelectItem>
                                                    <MudSelectItem Value="@("Government")">Government</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">Tier Level</MudText>
                                                <MudToggleGroup T="string" @bind-Value="_updateRequest.Tier" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" FixedContent="true" Class="w-100">
                                                    <MudToggleItem Value="@("Bronze")" Text="Bronze" />
                                                    <MudToggleItem Value="@("Silver")" Text="Silver" />
                                                    <MudToggleItem Value="@("Gold")" Text="Gold" />
                                                    <MudToggleItem Value="@("Platinum")" Text="Platinum" />
                                                </MudToggleGroup>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                 <MudSelect T="string" Label="Language" @bind-Value="_updateRequest.PreferredLanguage" Variant="Variant.Outlined">
                                                     <MudSelectItem Value="@("en")">English</MudSelectItem>
                                                     <MudSelectItem Value="@("th")">Thai</MudSelectItem>
                                                 </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                 <MudSelect T="string" Label="Timezone" @bind-Value="_updateRequest.Timezone" Variant="Variant.Outlined">
