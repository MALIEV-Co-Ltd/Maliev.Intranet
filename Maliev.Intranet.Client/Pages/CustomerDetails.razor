@page "/sales/customers/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Client.Services
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISignalRCustomerService SignalRService
@inject IJSRuntime JSRuntime
@inject LayoutService LayoutService
@inject ILogger<CustomerDetails> Logger

<PageTitle>@(_customer?.Name ?? "Customer Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16" Gutters="false">
    @if (_customer == null && !_loading)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">Customer not found.</MudAlert>
    }
    else if (_loading && _customer == null)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudSkeleton Height="60px" Class="mb-4 rounded-lg" />
                <MudSkeleton Height="400px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else if (_customer != null)
    {
        <!-- Header -->
        <!-- Header -->
        <div class="d-flex flex-wrap align-center px-4 px-md-8 mb-4 gap-2">
            @* Item 1: Name *@
            <div class="d-flex align-center order-1 flex-grow-1 flex-md-grow-0" style="min-width: 0;">
                <MudText Typo="Typo.h3" 
                         Style="font-weight: 700; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                         Class="flex-grow-1">
                    @_customer.Name
                </MudText>
            </div>

            @* Item 2: Badges - Goes to new line on mobile (order-3, w-100), stays inline on desktop (order-2, w-auto) *@
            <div class="d-flex align-center order-3 order-md-2 w-100 w-md-auto mt-2 mt-md-0 ms-md-4">
                <MudStack Row="true" Spacing="2">
                    @if (_customer.Nda != null && _customer.Nda.Status == "Signed")
                    {
                        <MudTooltip Text="NDA Protected">
                            <MudChip T="string" Icon="@Icons.Material.Filled.Shield" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">Protected</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="No Signed NDA">
                            <MudChip T="string" Icon="@Icons.Material.Filled.RemoveModerator" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">Unprotected</MudChip>
                        </MudTooltip>
                    }
                    
                    <MudChip T="string" 
                             Color="@GetStatusColor(_customer.Status)" 
                             Size="Size.Small" 
                             Variant="Variant.Filled"
                             Class="ma-0">
                        @_customer.Status
                    </MudChip>
                </MudStack>
            </div>

            @* Spacer for desktop to push buttons to far right *@
            <div class="order-md-2 flex-grow-1 d-none d-md-block"></div>

            @* Item 3: Action Buttons *@
            <div class="d-flex align-center order-2 order-md-3 ms-auto gap-2">
                 <MudButton Variant="Variant.Outlined"
                            Color="Color.Primary"
                            StartIcon="@(_isEditMode ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)"
                            OnClick="ToggleEditMode"
                            Class="px-4 px-md-6 rounded-lg my-1"
                            Style="white-space: nowrap;">
                     @( _isEditMode ? "Cancel Editing" : "Edit Profile")
                 </MudButton>
                 @if (!_isEditMode)
                 {
                     <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Add"
                                Class="px-4 px-md-6 rounded-lg shadow-none my-1"
                                Style="white-space: nowrap;">
                         Create Order
                     </MudButton>
                 }
                 else
                 {
                     <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                StartIcon="@Icons.Material.Filled.Save"
                                OnClick="SaveChanges"
                                Disabled="@_isSaving"
                                Class="px-4 px-md-6 rounded-lg shadow-none my-1"
                                Style="white-space: nowrap;">
                         @if (_isSaving)
                         {
                             <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                             <span>Saving...</span>
                         }
                         else
                         {
                             <span>Save Changes</span>
                         }
                     </MudButton>
                 }
            </div>
        </div>

        <!-- Contact Info Bar -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-8 px-4 px-md-8" Wrap="Wrap.Wrap">
            @if (!string.IsNullOrEmpty(_customer.Email))
            {
                <a href="mailto:@_customer.Email" style="text-decoration: none; display: inline-flex;">
                    <MudChip T="string" Icon="@Icons.Material.Filled.Email" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Style="cursor: pointer;">@_customer.Email</MudChip>
                </a>
            }
            @if (!string.IsNullOrEmpty(_customer.Mobile))
            {
                <a href="tel:@_customer.Mobile" style="text-decoration: none; display: inline-flex;">
                    <MudChip T="string" Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Style="cursor: pointer;">@_customer.Mobile</MudChip>
                </a>
            }
            <MudChip T="string" Icon="@Icons.Material.Filled.Language" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@(_customer.PreferredLanguage == "th" ? "Thai" : "English")</MudChip>
            @if (!string.IsNullOrEmpty(_customer.Timezone))
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@_customer.Timezone</MudChip>
            }
        </MudStack>

        <MudGrid Spacing="6" Class="px-4 px-md-8">
            <!-- Main Content -->
            <MudItem xs="12" lg="12">
                <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    
                    @if (!_isEditMode)
                    {
                        @* View Mode Tabs *@
                        <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
                            <MudGrid Spacing="4">
                                @* Top Metrics *@
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Total Spent</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.TotalSpent.ToString("C0", new CultureInfo("th-TH"))</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Active Orders</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.ActiveOrdersCount</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Open Quotations</MudText>
                                        <MudText Typo="Typo.h4" Style="font-weight: 700;">@_customer.OpenQuotationsCount</MudText>
                                    </MudPaper>
                                </MudItem>

                                @* Main Content Columns *@
                                <MudItem xs="12" lg="6">
                                    <MudStack Spacing="4">
                                        @if (_customer.CompanyId.HasValue)
                                        {
                                            <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
                                                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Company Details</MudText>
                                                    </MudStack>
                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{_customer.CompanyId}"))">View Profile</MudButton>
                                                </MudStack>
                                                
                                                <MudGrid Spacing="4">
                                                    <MudItem xs="12">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Company Name</MudText>
                                                        <MudText Typo="Typo.body1" Style="font-weight: 600;">@_customer.CompanyName</MudText>
                                                    </MudItem>
                                                    @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                                    {
                                                        <MudItem xs="12" sm="6">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tax ID / VAT</MudText>
                                                            <MudText Typo="Typo.body2">@_customer.CompanyVatNumber</MudText>
                                                        </MudItem>
                                                    }
                                                    <MudItem xs="12" sm="6">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Segment & Tier</MudText>
                                                        <MudStack Row="true" Spacing="2">
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ma-0">@_customer.CompanySegment</MudChip>
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ma-0">@_customer.CompanyTier</MudChip>
                                                        </MudStack>
                                                    </MudItem>
                                                    @if (_customer.CompanyBillingAddress != null)
                                                    {
                                                        <MudItem xs="12">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Billing Address</MudText>
                                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City, @_customer.CompanyBillingAddress.PostalCode</MudText>
                                                        </MudItem>
                                                    }
                                                </MudGrid>
                                            </MudCard>
                                        }

                                        @* Placeholder for Related Transactions *@
                                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                            <MudText Typo="Typo.h6" Class="mb-4 font-bold">Related Transactions</MudText>
                                            <MudStack Spacing="2">
                                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                                                    Transaction modules (Orders, Invoices, Quotations) are being integrated.
                                                </MudAlert>
                                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Disabled="true">Recent Orders</MudButton>
                                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RequestPage" Size="Size.Small" Disabled="true">Pending Invoices</MudButton>
                                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.QuestionAnswer" Size="Size.Small" Disabled="true">Open Quotations</MudButton>
                                                </MudStack>
                                            </MudStack>
                                        </MudCard>
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="12" lg="6">
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                        <MudText Typo="Typo.h6" Class="mb-6 font-bold">Recent Activity</MudText>
                                        
                                        <MudTable Items="_activities" 
                                                  Hover="true" 
                                                  Elevation="0" 
                                                  Dense="true"
                                                  Virtualize="true" 
                                                  FixedHeader="true"
                                                  Height="350px"
                                                  Class="mud-width-full"
                                          @ref="_virtualizeComponent">
                                            <HeaderContent>
                                                <MudTh Style="width: 50px"></MudTh>
                                                <MudTh>Activity</MudTh>
                                                <MudTh>Actor</MudTh>
                                                <MudTh Style="width: 150px">Timestamp</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="">
                                                    <MudAvatar Color="GetActivityColor(context.Action)" Size="Size.Small">
                                                        <MudIcon Icon="@GetActivityIcon(context.Action)" Size="Size.Small" />
                                                    </MudAvatar>
                                                </MudTd>
                                                <MudTd DataLabel="Activity" Class="activity-item-content">
                                                    <MarkdownRenderer Markdown="@SanitizeActivityDescription(context.Description)" />
                                                </MudTd>
                                                <MudTd DataLabel="Actor">
                                                    <MudText Typo="Typo.body2">
                                                        @(!string.IsNullOrEmpty(context.ActorName) ? context.ActorName : context.ActorId)
                                                    </MudText>
                                                </MudTd>
                                                <MudTd DataLabel="Timestamp">
                                                    <MudText Typo="Typo.caption">@context.Timestamp.ToLocalTime().ToString("g")</MudText>
                                                </MudTd>
                                            </RowTemplate>
                                            <NoRecordsContent>
                                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No recent activity found.</MudAlert>
                                            </NoRecordsContent>
                                        </MudTable>
                                        
                                        @if (_activityHasNextPage)
                                        {
                                            <div class="d-flex justify-center mt-4">
                                                <MudButton OnClick="LoadMoreActivities" 
                                                           Variant="Variant.Text" 
                                                           Color="Color.Primary" 
                                                           Size="Size.Small"
                                                           Disabled="@_loadingMoreActivities">
                                                    @if (_loadingMoreActivities)
                                                    {
                                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                        <span>Loading...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Load more history</span>
                                                    }
                                                </MudButton>
                                            </div>
                                        }
                                    </MudCard>

                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="Addresses" Icon="@Icons.Material.Filled.LocationOn">
                            <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Delivery & Billing</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Drag and drop to set default addresses</MudText>
                                    </MudStack>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAddressDialog">Add Address</MudButton>
                                </MudStack>
                                
                                <MudDropContainer @ref="_dropContainer" T="AddressResponse" Items="_customer.Addresses" ItemsSelector="@((item, dropzone) => GetAddressZone(item) == dropzone)" ItemDropped="AddressItemDropped" Class="d-flex flex-column gap-6">
                                    <ChildContent>
                                        <div class="d-flex gap-6 mb-6 overflow-hidden" style="min-height: 250px;">
                                            <div class="d-flex flex-column flex-grow-1" style="flex: 1 1 50%; min-width: 0;">
                                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2 ml-1" Style="font-weight: 700;">DEFAULT BILLING</MudText>
                                                <MudDropZone T="AddressResponse" Identifier="billing-default" CanDropClass="mud-border-primary" Class="rounded-xl border-2 border-dashed mud-border-lines-default pa-4 d-flex flex-column gap-4 flex-grow-1" Style="background-color: var(--mud-palette-background-grey);">
                                                </MudDropZone>
                                            </div>
                                            <div class="d-flex flex-column flex-grow-1" style="flex: 1 1 50%; min-width: 0;">
                                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2 ml-1" Style="font-weight: 700;">DEFAULT SHIPPING</MudText>
                                                <MudDropZone T="AddressResponse" Identifier="shipping-default" CanDropClass="mud-border-primary" Class="rounded-xl border-2 border-dashed mud-border-lines-default pa-4 d-flex flex-column gap-4 flex-grow-1" Style="background-color: var(--mud-palette-background-grey);">
                                                </MudDropZone>
                                            </div>
                                        </div>

                                        <MudDivider Class="mb-6" />

                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Default" Class="mb-2 ml-1" Style="font-weight: 700;">OTHER ADDRESSES</MudText>
                                            <MudDropZone T="AddressResponse" Identifier="others" CanDropClass="mud-border-primary" Class="rounded-xl border-2 border-dashed mud-border-lines-default pa-4 d-flex flex-row flex-wrap gap-6" Style="min-height: 200px; background-color: var(--mud-palette-background-grey);">
                                            </MudDropZone>
                                        </div>
                                    </ChildContent>
                                    <ItemRenderer>
                                        <div @key="context.Id" class="d-flex" style="width: 100%;">
                                            <MudPaper Elevation="3" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default flex-grow-1 d-flex flex-column"
                                                      Style="background-color: var(--mud-palette-surface);">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                        <MudIcon Icon="@(context.Type == "Billing" ? Icons.Material.Filled.ReceiptLong : Icons.Material.Filled.LocalShipping)" 
                                                                 Color="@(context.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" />
                                                        <MudChip T="string" Color="@(context.Type == "Billing" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Filled">@context.Type</MudChip>
                                                    </MudStack>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                                        @if (context.IsDefault)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;" Class="mr-2">DEFAULT</MudText>
                                                        }
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAddressDialog(context))" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAddressToClipboard(context))" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAddress(context))" />
                                                    </MudStack>
                                                </MudStack>

                                                <div class="flex-grow-1 overflow-hidden">
                                                    @if (context.Type == "Billing")
                                                    {
                                                        if (_customer.CompanyId.HasValue)
                                                        {
                                                            <MudLink OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{_customer.CompanyId}"))" Underline="Underline.None" Color="Color.Default">
                                                                <MudText Typo="Typo.body2" Style="font-weight: 700;" Class="hover-primary">@_customer.CompanyName</MudText>
                                                            </MudLink>
                                                            @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                                            {
                                                                <MudText Typo="Typo.caption" Class="d-block mb-2">เลขประจำตัวผู้เสียภาษี @_customer.CompanyVatNumber</MudText>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@_customer.Name</MudText>
                                                            <MudText Typo="Typo.caption" Class="d-block mb-2">@_customer.Mobile</MudText>
                                                        }
                                                    }

                                                    @if (context.Type == "Shipping")
                                                    {
                                                        <MudStack Spacing="0" Class="mb-2">
                                                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@(string.IsNullOrEmpty(context.RecipientName) ? _customer.Name : context.RecipientName)</MudText>
                                                            <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(context.RecipientPhone) ? _customer.Mobile : context.RecipientPhone)</MudText>
                                                        </MudStack>
                                                    }

                                                    <MudText Typo="Typo.body2">@context.AddressLine1</MudText>
                                                    @if (!string.IsNullOrEmpty(context.AddressLine2)) { <MudText Typo="Typo.body2">@context.AddressLine2</MudText> }
                                                    @if (!string.IsNullOrEmpty(context.AddressLine3)) { <MudText Typo="Typo.body2">@context.AddressLine3</MudText> }
                                                    <MudText Typo="Typo.body2">@context.District, @context.City</MudText>
                                                    <MudText Typo="Typo.body2">@context.StateProvince @context.PostalCode</MudText>
                                                </div>
                                            </MudPaper>
                                        </div>
                                    </ItemRenderer>
                                </MudDropContainer>

                                @if (!_customer.Addresses.Any() && _customer.CompanyId.HasValue && _customer.CompanyBillingAddress != null)
                                {
                                    <MudDivider Class="my-6" />
                                    <MudText Typo="Typo.subtitle2" Class="mb-4">Company Default Address</MudText>
                                    <div style="width: 100%; max-width: 450px;">
                                        <MudPaper Elevation="3" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default"
                                                  Style="background-color: var(--mud-palette-surface);">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Small" />
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Company Billing</MudChip>
                                                </MudStack>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700;">DEFAULT</MudText>
                                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAddressToClipboard(_customer.CompanyBillingAddress))" />
                                                </MudStack>
                                            </MudStack>
                                            
                                            <MudLink OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{_customer.CompanyId}"))" Underline="Underline.None" Color="Color.Default">
                                                <MudText Typo="Typo.body2" Style="font-weight: 700;" Class="hover-primary">@_customer.CompanyName</MudText>
                                            </MudLink>
                                            @if (!string.IsNullOrEmpty(_customer.CompanyVatNumber))
                                            {
                                                <MudText Typo="Typo.caption" Class="d-block mb-2">เลขประจำตัวผู้เสียภาษี @_customer.CompanyVatNumber</MudText>
                                            }

                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.AddressLine1</MudText>
                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.District, @_customer.CompanyBillingAddress.City</MudText>
                                            <MudText Typo="Typo.body2">@_customer.CompanyBillingAddress.StateProvince @_customer.CompanyBillingAddress.PostalCode</MudText>
                                        </MudPaper>
                                    </div>
                                }
                            </MudCard>
                        </MudTabPanel>

                        <MudTabPanel Text="Docs" Icon="@Icons.Material.Filled.Attachment">
                            <MudGrid Spacing="0" Style="min-height: 800px;">
                                <!-- Left Column: Vertical Navigation -->
                                <MudItem xs="12" md="2" Class="border-solid border-r-1 mud-border-lines-default" Style="background: var(--mud-palette-surface);">
                                    <MudNavMenu Class="docs-vertical-nav" Style="padding: 8px;">
                                        <MudNavLink OnClick="@(() => _activeDocTabIndex = 0)"
                                                    Icon="@Icons.Material.Filled.Gavel"
                                                    IconColor="@(_activeDocTabIndex == 0 ? Color.Primary : Color.Default)"
                                                    Class="@(_activeDocTabIndex == 0 ? "mud-selected-item" : "")"
                                                    Style="border-radius: 8px; margin-bottom: 4px;">
                                            NDA Agreement
                                        </MudNavLink>
                                        <MudNavLink OnClick="@(() => _activeDocTabIndex = 1)"
                                                    Icon="@Icons.Material.Filled.FolderOpen"
                                                    IconColor="@(_activeDocTabIndex == 1 ? Color.Primary : Color.Default)"
                                                    Class="@(_activeDocTabIndex == 1 ? "mud-selected-item" : "")"
                                                    Style="border-radius: 8px; margin-bottom: 4px;">
                                            Customer Documents
                                        </MudNavLink>
                                    </MudNavMenu>
                                </MudItem>

                                <!-- Middle Column: Content Area -->
                                <MudItem xs="12" md="@(_selectedPreviewDoc != null ? 5 : 10)" lg="@(_selectedPreviewDoc != null ? 4 : 10)" Style="overflow-y: auto; padding: 24px;">
                                    @if (_activeDocTabIndex == 0)
                                    {
                                        <!-- NDA Agreement Content -->
                                        <MudStack Spacing="6">
                                            <!-- Title Zone -->
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.h5" Style="font-weight: 700;">NDA Agreement</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Non-Disclosure Agreement for this customer</MudText>
                                            </MudStack>

                                            <!-- NDA Upload Zone and Progress -->
                                            <MudStack Row="true" AlignItems="AlignItems.Stretch" Spacing="4" Wrap="Wrap.Wrap" Style="width: 100%;">
                                                <div style="flex: 1;">
                                                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                                   @ref="_ndaFileUpload"
                                                                   FilesChanged="OnNdaFilesSelected"
                                                                   Accept=".pdf"
                                                                   MaximumFileCount="100"
                                                                   Disabled="@_uploadingNda"
                                                                   Class="nda-upload-zone"
                                                                   Style="width: 100%; min-height: 200px; position: relative;">
                                                        <CustomContent>
                                                            <div class="file-upload-dropzone @(_ndaDragOver ? "drag-over" : "")"
                                                                 style="background-color: rgba(33, 150, 243, 0.05); border: 2px dashed var(--mud-palette-info); position: relative; height: 100%; min-height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; cursor: pointer;"
                                                                 @onclick="@context.OpenFilePickerAsync"
                                                                 @ondragenter="@(() => _ndaDragOver = true)"
                                                                 @ondragleave="@(() => _ndaDragOver = false)"
                                                                 @ondragover:preventDefault
                                                                 @ondrop="@(() => _ndaDragOver = false)">
                                                                <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="font-size: 42px;" Color="Color.Info" Class="mb-2" />
                                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Drag & Drop or Click to Upload</MudText>
                                                                <MudText Typo="Typo.body2" Color="Color.Secondary">PDF files only, up to 10MB each (max 20 files)</MudText>
                                                            </div>
                                                        </CustomContent>
                                                    </MudFileUpload>
                                                </div>

                                                @if (_ndaUploadFiles.Any())
                                                {
                                                    <div style="flex: 1; max-height: 250px; overflow-y: auto;">
                                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="background-color: transparent;">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width: 50%;">File</th>
                                                                    <th style="width: 20%;">Size</th>
                                                                    <th style="width: 30%;">Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var file in _ndaUploadFiles)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <div class="d-flex align-center gap-2">
                                                                                <MudIcon Icon="@Icons.Custom.FileFormats.FilePdf" Color="Color.Info" Size="Size.Small" />
                                                                                <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 150px;">@file.Name</MudText>
                                                                            </div>
                                                                        </td>
                                                                        <td><MudText Typo="Typo.caption">@FormatFileSize(file.Size)</MudText></td>
                                                                        <td>
                                                                            @if (file.IsCompleted)
                                                                            {
                                                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                                            }
                                                                            else if (file.Error != null)
                                                                            {
                                                                                <MudTooltip Text="@file.Error">
                                                                                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                                                                </MudTooltip>
                                                                            }
                                                                            else if (file.IsUploading)
                                                                            {
                                                                                <MudProgressLinear Color="Color.Info" Value="@file.Progress" Class="rounded-pill" />
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </MudSimpleTable>
                                                    </div>
                                                }
                                            </MudStack>

                                            <!-- NDA Management Section -->
                                            @if (_customer.Ndas != null && _customer.Ndas.Any())
                                            {
                                                <MudPaper Elevation="0" Class="pa-4 rounded-lg border-solid border-1 mud-border-lines-default">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">NDA Records</MudText>
                                                        <MudStack Row="true" Spacing="2">
                                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditNdaDialog">Edit</MudButton>
                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNdaUpload">New</MudButton>
                                                        </MudStack>
                                                    </MudStack>
                                                    <MudStack Spacing="2">
                                                        @foreach (var nda in _customer.Ndas.OrderByDescending(n => n.CreatedAt))
                                                        {
                                                            <MudPaper Elevation="0" Class="pa-3 rounded-lg border-solid border-1 mud-border-lines-default d-flex align-center justify-space-between"
                                                                      Style="background-color: var(--mud-palette-background-grey);">
                                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="@(nda.Status == "Signed" ? Color.Success : Color.Default)" />
                                                                    <div class="d-flex flex-column">
                                                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">NDA Record</MudText>
                                                                            <MudChip T="string" Color="@GetNdaColor(nda.Status)" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">@nda.Status</MudChip>
                                                                            @if (nda == _customer.Nda)
                                                                            {
                                                                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Class="ma-0">Current</MudChip>
                                                                            }
                                                                        </MudStack>
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                            Expires: @(nda.ExpiresAt?.ToLocalTime().ToString("d") ?? "Never") • Created: @nda.CreatedAt.ToLocalTime().ToString("g")
                                                                        </MudText>
                                                                    </div>
                                                                </MudStack>
                                                                <MudStack Row="true" Spacing="1">
                                                                    <MudTooltip Text="View History">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="@(() => ViewNdaHistory(nda.Id))" />
                                                                    </MudTooltip>
                                                                    @if (nda.DocumentReferenceId.HasValue)
                                                                    {
                                                                        <MudTooltip Text="View Document">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => ViewNdaDocument(nda.DocumentReferenceId.Value))" />
                                                                        </MudTooltip>
                                                                    }
                                                                    @if (nda.Status == "Draft" || nda.Status == "Signed" || nda.Status == "Expired")
                                                                    {
                                                                        <MudTooltip Text="@(nda.Status == "Draft" ? "Apply Signature" : "Upload New Version")">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenSignedNdaUpload(nda))" />
                                                                        </MudTooltip>
                                                                        @if (nda.Status == "Draft")
                                                                        {
                                                                            <MudTooltip Text="Upload Revised Draft">
                                                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => OpenNdaRevisionUpload(nda))" />
                                                                            </MudTooltip>
                                                                        }
                                                                    }
                                                                    <MudTooltip Text="Delete">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteNda(nda))" />
                                                                    </MudTooltip>
                                                                    @if (nda.Status == "Signed")
                                                                    {
                                                                        <MudTooltip Text="Revoke NDA">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small" OnClick="@(() => RevokeNda(nda))" />
                                                                        </MudTooltip>
                                                                    }
                                                                </MudStack>
                                                            </MudPaper>
                                                        }
                                                    </MudStack>
                                                </MudPaper>
                                            }

                                            <!-- File List Zone -->
                                            @if (GetNdaDocuments().Any())
                                            {
                                                <MudStack Spacing="2">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">NDA Documents (@GetNdaDocuments().Count)</MudText>
                                                    <MudList T="DocumentResponse" Dense="true" Class="pa-0">
                                                        @foreach (var doc in GetNdaDocuments())
                                                        {
                                                            <MudListItem T="DocumentResponse"
                                                                         OnClick="@(() => SelectDocumentForPreview(doc))"
                                                                         Class="@($"rounded-lg mb-1 hover-elevation-1 {(_selectedPreviewDoc?.Id == doc.Id ? "mud-selected-item" : "")}")"
                                                                         Style="border: 1px solid var(--mud-palette-lines-default); cursor: pointer;">
                                                                <div class="d-flex align-center justify-space-between w-100 pa-2">
                                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                                        <MudIcon Icon="@Icons.Custom.FileFormats.FilePdf" Color="Color.Error" />
                                                                        <div class="d-flex flex-column">
                                                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@doc.FileName</MudText>
                                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(doc.FileSize) • @doc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</MudText>
                                                                        </div>
                                                                    </MudStack>
                                                                    <MudStack Row="true" Spacing="0">
                                                                        <div @onclick:stopPropagation="true">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(doc.FileReference))" />
                                                                        </div>
                                                                        <div @onclick:stopPropagation="true">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleDeleteDocument(doc))" />
                                                                        </div>
                                                                    </MudStack>
                                                                </div>
                                                            </MudListItem>
                                                        }
                                                    </MudList>
                                                </MudStack>
                                            }
                                        </MudStack>
                                    }
                                    else if (_activeDocTabIndex == 1)
                                    {
                                        <!-- Customer Documents Content -->

                                        <!-- Customer Documents Content -->
                                        <MudStack Spacing="6">
                                            <!-- Title Zone -->
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.h5" Style="font-weight: 700;">Customer Documents</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Supporting documents and identification</MudText>
                                            </MudStack>

                                            <!-- Upload Zone and Progress -->
                                            <MudStack Row="true" AlignItems="AlignItems.Stretch" Spacing="4" Wrap="Wrap.Wrap" Style="width: 100%;">
                                                <div style="flex: 1;">
                                                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                                   @ref="_customerDocFileUpload"
                                                                   FilesChanged="OnCustomerDocFilesSelected"
                                                                   Accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                                                                   MaximumFileCount="100"
                                                                   Disabled="@_uploadingCustomerDoc"
                                                                   Class="customer-docs-upload-zone"
                                                                   Style="width: 100%; min-height: 200px; position: relative;">
                                                        <CustomContent>
                                                            <div class="file-upload-dropzone @(_customerDocDragOver ? "drag-over" : "")"
                                                                 style="background-color: rgba(76, 175, 80, 0.05); border: 2px dashed var(--mud-palette-success); position: relative; height: 100%; min-height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; cursor: pointer;"
                                                                 @onclick="@context.OpenFilePickerAsync"
                                                                 @ondragenter="@(() => _customerDocDragOver = true)"
                                                                 @ondragleave="@(() => _customerDocDragOver = false)"
                                                                 @ondragover:preventDefault
                                                                 @ondrop="@(() => _customerDocDragOver = false)">
                                                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="font-size: 42px;" Color="Color.Success" Class="mb-2" />
                                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Drag & Drop or Click to Upload</MudText>
                                                                <MudText Typo="Typo.body2" Color="Color.Secondary">PDF, Word, or Image files, up to 10MB each (max 20 files)</MudText>
                                                            </div>
                                                        </CustomContent>
                                                    </MudFileUpload>
                                                </div>

                                                @if (_customerDocUploadFiles.Any())
                                                {
                                                    <div style="flex: 1; max-height: 250px; overflow-y: auto;">
                                                        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="background-color: transparent;">
                                                            <thead>
                                                                <tr>
                                                                    <th style="width: 50%;">File</th>
                                                                    <th style="width: 20%;">Size</th>
                                                                    <th style="width: 30%;">Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var file in _customerDocUploadFiles)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <div class="d-flex align-center gap-2">
                                                                                <MudIcon Icon="@GetDocumentIcon(file.MimeType)" Color="Color.Success" Size="Size.Small" />
                                                                                <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 150px;">@file.Name</MudText>
                                                                            </div>
                                                                        </td>
                                                                        <td><MudText Typo="Typo.caption">@FormatFileSize(file.Size)</MudText></td>
                                                                        <td>
                                                                            @if (file.IsCompleted)
                                                                            {
                                                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                                            }
                                                                            else if (file.Error != null)
                                                                            {
                                                                                <MudTooltip Text="@file.Error">
                                                                                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                                                                                </MudTooltip>
                                                                            }
                                                                            else if (file.IsUploading)
                                                                            {
                                                                                <MudProgressLinear Color="Color.Success" Value="@file.Progress" Class="rounded-pill" />
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </MudSimpleTable>
                                                    </div>
                                                }
                                            </MudStack>

                                            <!-- File List Zone -->
                                            @if (GetNonNdaDocuments().Any())
                                            {
                                                <MudStack Spacing="2">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Documents (@GetNonNdaDocuments().Count)</MudText>
                                                    <div style="max-height: 400px; overflow-y: auto;" class="pr-2">
                                                        <MudList T="DocumentResponse" Dense="true" Class="pa-0">
                                                            @foreach (var doc in GetNonNdaDocuments())
                                                            {
                                                                <MudListItem T="DocumentResponse"
                                                                             OnClick="@(() => SelectDocumentForPreview(doc))"
                                                                             Class="@($"rounded-lg mb-1 hover-elevation-1 {(_selectedPreviewDoc?.Id == doc.Id ? "mud-selected-item" : "")}")"
                                                                             Style="border: 1px solid var(--mud-palette-lines-default); cursor: pointer;">
                                                                    <div class="d-flex align-center justify-space-between w-100 pa-2">
                                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                                            <MudIcon Icon="@GetDocumentIcon(doc.MimeType)" Color="@GetDocumentIconColor(doc.MimeType)" />
                                                                            <div class="d-flex flex-column">
                                                                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@doc.FileName</MudText>
                                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(doc.FileSize) • @doc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</MudText>
                                                                            </div>
                                                                        </MudStack>
                                                                        <MudStack Row="true" Spacing="0">
                                                                            <div @onclick:stopPropagation="true">
                                                                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(doc.FileReference))" />
                                                                            </div>
                                                                            <div @onclick:stopPropagation="true">
                                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleDeleteDocument(doc))" />
                                                                            </div>
                                                                        </MudStack>
                                                                    </div>
                                                                </MudListItem>
                                                            }
                                                        </MudList>
                                                    </div>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No documents uploaded yet. Use the drop zone above to add documents.</MudAlert>
                                            }
                                        </MudStack>
                                    }
                                </MudItem>

                                <!-- Right Column: Preview Pane (Hidden on mobile) -->
                                @if (_selectedPreviewDoc != null)
                                {
                                    <MudItem xs="12" md="5" lg="6" Class="border-solid border-l-1 mud-border-lines-default" Style="background: var(--mud-palette-background-grey);">
                                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                            <MudPaper Elevation="0" Class="pa-4" Style="height: 100%;">
                                            <MudStack Spacing="2" Style="height: 100%;">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                        <MudText Typo="Typo.h6" Style="font-weight: 600;">@_selectedPreviewDoc.FileName</MudText>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _selectedPreviewDoc = null)" />
                                                    </MudStack>

                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="px-1">
                                                        <div style="min-width: 0;">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                @FormatFileSize(_selectedPreviewDoc.FileSize) • @_selectedPreviewDoc.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                                            </MudText>
                                                        </div>
                                                        <MudStack Row="true" Spacing="0">
                                                            <MudTooltip Text="Download">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(_selectedPreviewDoc.FileReference))" />
                                                            </MudTooltip>
                                                            <MudTooltip Text="Delete">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleDeleteDocument(_selectedPreviewDoc))" />
                                                            </MudTooltip>
                                                        </MudStack>
                                                    </MudStack>

                                                    @if (_loadingPreview)
                                                    {
                                                        <div class="d-flex align-center justify-center flex-grow-1">
                                                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(_previewUrl))
                                                    {
                                                        <div class="flex-grow-1" style="overflow: hidden;">
                                                            @if (_selectedPreviewDoc.MimeType?.Contains("pdf") == true)
                                                            {
                                                                <iframe src="@_previewUrl" style="width: 100%; height: 100%; border: none; border-radius: 8px;"></iframe>
                                                            }
                                                            else if (_selectedPreviewDoc.MimeType?.Contains("image") == true)
                                                            {
                                                                <img src="@_previewUrl" alt="@_selectedPreviewDoc.FileName" style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px;" />
                                                            }
                                                            else
                                                            {
                                                                <MudAlert Severity="Severity.Info">Preview not available for this file type. Please download to view.</MudAlert>
                                                            }
                                                        </div>
                                                    }
                                                </MudStack>
                                            </MudPaper>
                                        </MudHidden>
                                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                                            <div class="d-flex align-center justify-center flex-column pa-6">
                                                <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Style="font-size: 48px; opacity: 0.3;" Color="Color.Default" Class="mb-3" />
                                                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">Preview is only available on larger screens</MudText>
                                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadDocument(_selectedPreviewDoc.FileReference))" Class="mt-3">Download Document</MudButton>
                                            </div>
                                        </MudHidden>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.Note">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Internal Notes</MudText>
                                    @if (!string.IsNullOrEmpty(_noteSearchString))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(showing @FilteredNotes.Count() of @(_customer?.Notes?.Count ?? 0) notes)</MudText>
                                    }
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                    <MudTextField @bind-Value="_noteSearchString" Placeholder="Search notes..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" />
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="AddInternalNote">Add Note</MudButton>
                                </MudStack>
                            </MudStack>

                            <div class="d-flex gap-6" style="min-height: 600px;">
                                <!-- Notes list (left side) -->
                                <div class="@(_noteDrawerOpen ? "flex-grow-0" : "flex-grow-1")"
                                     style="@(_noteDrawerOpen ? "flex: 0 0 40%; max-width: 40%;" : "flex: 1 1 100%;") transition: all 0.3s ease; padding: 4px;">
                                    @if (_customer.Notes != null && _customer.Notes.Any())
                                    {
                                        <MudStack Spacing="3">
                                            @foreach (var note in FilteredNotes)
                                            {
                                                <MudPaper Elevation="@(_editingNoteId == note.Id ? 3 : 1)"
                                                          Class="@($"pa-4 rounded-xl border-solid border-1 transition-all hover-elevation-1 {(_editingNoteId == note.Id ? "mud-border-primary" : "mud-border-lines-default")}")"
                                                          Style="cursor: pointer; background-color: var(--mud-palette-surface);"
                                                          @onclick="@(() => EditInternalNote(note))">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudAvatar Color="Color.Primary" Size="Size.Small">
                                                                @((note.CreatedByName ?? note.CreatedBy)?[0])
                                                            </MudAvatar>
                                                            <MudStack Spacing="0">
                                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">
                                                                    @(note.CreatedByName ?? "Unknown User")
                                                                </MudText>
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@note.CreatedAt.ToLocalTime().ToString("g")</MudText>
                                                            </MudStack>
                                                        </MudStack>
                                                        <div @onclick:stopPropagation>
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteInternalNote(note))" />
                                                        </div>
                                                    </MudStack>
                                                    <div class="note-preview-content px-1" style="max-height: 300px; overflow: hidden;">
                                                        @if (!string.IsNullOrEmpty(_noteSearchString))
                                                        {
                                                            <MudHighlighter Text="@note.NoteText" HighlightedText="@_noteSearchString" Style="font-size: 0.875rem; line-height: 1.6;" />
                                                        }
                                                        else
                                                        {
                                                            <MarkdownRenderer Markdown="@note.NoteText" />
                                                        }
                                                    </div>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">No internal notes for this customer.</MudAlert>
                                    }
                                </div>

                                <!-- Right pane editor -->
                                @if (_noteDrawerOpen)
                                {
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100 d-flex flex-column">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                                                <MudText Typo="Typo.h6" Style="font-weight: 700;">
                                                    @(_isNewNote ? "Create Internal Note" : "Internal Note")
                                                </MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseNoteDrawer" />
                                            </MudStack>

                                            <NoteEditor @ref="_noteEditorRef"
                                                        @bind-Value="_editingNoteText"
                                                        StartInEditMode="_isNewNote"
                                                        ShowActivityTab="@(!_isNewNote && _editingNoteId.HasValue)"
                                                        NoteId="_editingNoteId" />

                                            <div class="d-flex justify-end gap-2 mt-4 pt-4 border-t border-solid mud-border-lines-default">
                                                <MudButton OnClick="CloseNoteDrawer" Variant="Variant.Text" Class="rounded-lg">Cancel</MudButton>
                                                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveNote"
                                                           Class="px-8 rounded-lg shadow-none" Style="font-weight: 700;"
                                                           Disabled="@(string.IsNullOrWhiteSpace(_editingNoteText) || (!_isNewNote && _editingNoteText == _originalNoteText))">
                                                    @(_isNewNote ? "Create Note" : "Save Changes")
                                                </MudButton>
                                            </div>
                                        </MudPaper>
                                    </div>
                                }
                            </div>
                        </MudTabPanel>
                    }
                    else
                    {
                        @* Edit Mode Panels *@
                        <MudTabPanel Text="Personal Information" Icon="@Icons.Material.Filled.Person">
                            <MudForm @ref="_editForm" Model="@_updateRequest">
                                <MudStack Spacing="6">
                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.subtitle1" Class="mb-4 font-bold">Identity & Contact</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_updateRequest.FirstName" Label="First Name" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_updateRequest.LastName" Label="Last Name" Variant="Variant.Outlined" Required="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_updateRequest.Email" Label="Email Address" Variant="Variant.Outlined" Required="true" Disabled="@(!_canChangeEmail)" 
                                                              Adornment="Adornment.End" AdornmentIcon="@(_canChangeEmail ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)" 
                                                              OnAdornmentClick="@(() => _canChangeEmail = !_canChangeEmail)" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_updateRequest.Mobile" Label="Mobile Number" Variant="Variant.Outlined" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>

                                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                        <MudText Typo="Typo.subtitle1" Class="mb-4 font-bold">Preferences</MudText>
                                        <MudGrid Spacing="4">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect @bind-Value="_updateRequest.PreferredLanguage" Label="Preferred Language" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="@("en")">English</MudSelectItem>
                                                    <MudSelectItem Value="@("th")">Thai</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudAutocomplete T="string" @bind-Value="_updateRequest.Timezone" Label="Timezone" Variant="Variant.Outlined" 
                                                                 SearchFunc="@((s, ct) => Task.FromResult(TimeZoneInfo.GetSystemTimeZones().Select(z => z.Id).Where(z => string.IsNullOrEmpty(s) || z.Contains(s, StringComparison.OrdinalIgnoreCase))))" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCard>
                                </MudStack>
                            </MudForm>
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudItem>

        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private CustomerDetailDto? _customer;
    private List<CustomerActivityResponse> _activities = [];
    private bool _loading = true;
    private bool _isEditMode = false;
    private bool _isSaving = false;
    private bool _canChangeEmail = false;
    private int _activeTabIndex = 0;
    
    private int _activityPage = 1;
    private bool _activityHasNextPage = false;
    private bool _loadingMoreActivities = false;
    private MudTable<CustomerActivityResponse>? _virtualizeComponent;

    private MudDropContainer<AddressResponse>? _dropContainer;
    private MudForm? _editForm;
    private UpdateCustomerRequest _updateRequest = new();
    private List<CountryDto> _allCountries = new();

    private string _noteSearchString = "";
    private bool _noteDrawerOpen = false;
    private Guid? _editingNoteId;
    private string _editingNoteText = "";
    private string _originalNoteText = "";
    private bool _isNewNote = true;
    private NoteEditor? _noteEditorRef;

    private IEnumerable<InternalNoteResponse> FilteredNotes =>
        (_customer?.Notes ?? [])
        .Where(n => string.IsNullOrEmpty(_noteSearchString) || n.NoteText.Contains(_noteSearchString, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(n => n.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        await LoadCountries();
        await LoadCustomerData();
        await LoadInitialActivities();
        
        await SignalRService.StartAsync();
        SignalRService.OnCustomerChanged += HandleCustomerChanged;
    }

    private async Task HandleCustomerChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!_isEditMode) 
            {
                await LoadCustomerData();
                await LoadInitialActivities();
            }
        });
    }

    private string GetAddressZone(AddressResponse address) => address.IsDefault ? (address.Type == "Billing" ? "billing-default" : "shipping-default") : "others";

    private async Task AddressItemDropped(MudItemDropInfo<AddressResponse> dropInfo)
    {
        if (dropInfo.Item == null || _customer == null) return;
        var address = dropInfo.Item;
        string newType = address.Type;
        bool newIsDefault = address.IsDefault;
        
        if (dropInfo.DropzoneIdentifier == "billing-default") { newType = "Billing"; newIsDefault = true; }
        else if (dropInfo.DropzoneIdentifier == "shipping-default") { newType = "Shipping"; newIsDefault = true; }
        else if (dropInfo.DropzoneIdentifier == "others") { newIsDefault = false; }

        if (newType != address.Type || newIsDefault != address.IsDefault)
        {
            try
            {
                // If we are setting a new default, we should update the entire collection to ensure 
                // other addresses of the same type are no longer marked as default.
                if (newIsDefault)
                {
                    var updatedAddresses = _customer.Addresses.Select(a => {
                        if (a.Id == address.Id) 
                            return new CreateAddressRequest { Id = a.Id, Type = newType, IsDefault = true, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version };
                        
                        if (a.Type == newType)
                            return new CreateAddressRequest { Id = a.Id, Type = a.Type, IsDefault = false, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version };
                        
                        return new CreateAddressRequest { Id = a.Id, Type = a.Type, IsDefault = a.IsDefault, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version };
                    }).ToList();

                    var onboardingRequest = new CustomerOnboardingRequest { Customer = new CreateCustomerRequest { FirstName = _customer.FirstName, LastName = _customer.LastName, Email = _customer.Email, Mobile = _customer.Mobile, Landline = _customer.Landline, Extension = _customer.Extension, Segment = _customer.Segment, Tier = _customer.Tier, PreferredLanguage = _customer.PreferredLanguage, Timezone = _customer.Timezone, CompanyId = _customer.CompanyId, CommunicationPreferences = _customer.CommunicationPreferences }, Addresses = updatedAddresses };
                    var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);

                    if (response.IsSuccessStatusCode)
                    {
                        Snackbar.Add("Address updated successfully", Severity.Success);
                        await LoadCustomerData();
                        await LoadInitialActivities();
                    }
                    else
                    {
                        var errorBody = await response.Content.ReadAsStringAsync();
                        Snackbar.Add($"Failed to update address ({(int)response.StatusCode}): {errorBody}", Severity.Error);
                    }
                }
                else
                {
                    // Just unsetting default or changing type without setting default can be a simple PATCH
                    var updateRequest = new UpdateAddressRequest { Type = newType, IsDefault = newIsDefault, Version = address.Version } ;
                    var response = await Http.PatchAsJsonAsync($"api/customers/addresses/{address.Id}", updateRequest);
                    if (response.IsSuccessStatusCode)
                    {
                        Snackbar.Add("Address updated successfully", Severity.Success);
                        await LoadCustomerData();
                        await LoadInitialActivities();
                    }
                    else Snackbar.Add("Failed to update address", Severity.Error);
                }
            }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
            finally { _dropContainer?.Refresh(); }
        }
    }

    private async Task LoadCountries() { try { _allCountries = await Http.GetFromJsonAsync<List<CountryDto>>("api/customers/countries") ?? []; } catch { } }
    
    private async ValueTask<ItemsProviderResult<CustomerActivityResponse>> LoadActivitiesProvider(ItemsProviderRequest request)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerActivityResponse>>($"api/customers/{Id}/history?skip={request.StartIndex}&take={request.Count}", request.CancellationToken);
            if (response != null)
            {
                return new ItemsProviderResult<CustomerActivityResponse>(response.Data, response.Meta.TotalItems);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading activities");
        }

        return new ItemsProviderResult<CustomerActivityResponse>(Enumerable.Empty<CustomerActivityResponse>(), 0);
    }

    private async Task LoadInitialActivities()
    {
        _activityPage = 1;
        _activities.Clear();
        await LoadActivities();
    }

    private async Task LoadMoreActivities()
    {
        _activityPage++;
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        _loadingMoreActivities = true;
        try
        {
            var take = 10;
            var skip = (_activityPage - 1) * take;
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerActivityResponse>>($"api/customers/{Id}/history?skip={skip}&take={take}");
            
            if (response != null)
            {
                if (_activityPage == 1) _activities = response.Data.ToList();
                else _activities.AddRange(response.Data);
                
                _activityHasNextPage = response.Data.Count() == take; // Simple check, assumption: if full page returned, likely more exists
                // Or better calculate based on total items if available in PagedResponse
                if (response.Meta != null) 
                {
                   _activityHasNextPage = _activities.Count < response.Meta.TotalItems;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading activities");
            Snackbar.Add("Failed to load activities", Severity.Error);
        }
        finally
        {
            _loadingMoreActivities = false;
            StateHasChanged();
        }
    }

    private string GetActivityIcon(string action) => action switch { "Create" => Icons.Material.Filled.AddCircle, "Update" => Icons.Material.Filled.Edit, "SoftDelete" => Icons.Material.Filled.Delete, _ => Icons.Material.Filled.History };
    private Color GetActivityColor(string action) => action switch { "Create" => Color.Success, "Update" => Color.Primary, "SoftDelete" => Color.Error, _ => Color.Default };

    private async Task LoadCustomerData()
    {
        // Don't clear _customer here to avoid "Customer not found" flash
        _loading = _customer == null; 
        try
        {
            var result = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{Id}");
            if (result != null)
            {
                _customer = result;
                MapToUpdateRequest();
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error loading customer: {ex.Message}", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
    }

    private void MapToUpdateRequest()
    {
        if (_customer == null) return;
        _updateRequest = new UpdateCustomerRequest { FirstName = _customer.FirstName, LastName = _customer.LastName, Email = _customer.Email, Mobile = _customer.Mobile, Landline = _customer.Landline, Extension = _customer.Extension, Segment = _customer.Segment, Tier = _customer.Tier, PreferredLanguage = _customer.PreferredLanguage, Timezone = _customer.Timezone, CommunicationPreferences = _customer.CommunicationPreferences, Version = _customer.Version };
    }

    private void ToggleEditMode() { if (_isEditMode) MapToUpdateRequest(); else _activeTabIndex = 0; _isEditMode = !_isEditMode; }

    private async Task SaveChanges()
    {
        if (_editForm != null) { await _editForm.ValidateAsync(); if (!_editForm.IsValid) { Snackbar.Add("Please correct validation errors first.", Severity.Warning); return; } }
        _isSaving = true;
        try
        {
            var onboardingRequest = new CustomerOnboardingRequest
            {
                Customer = new CreateCustomerRequest
                {
                    FirstName = _updateRequest.FirstName,
                    LastName = _updateRequest.LastName,
                    Email = _updateRequest.Email,
                    Mobile = _updateRequest.Mobile,
                    Landline = _updateRequest.Landline,
                    Extension = _updateRequest.Extension,
                    Segment = _updateRequest.Segment,
                    Tier = _updateRequest.Tier,
                    PreferredLanguage = _updateRequest.PreferredLanguage,
                    Timezone = _updateRequest.Timezone,
                    CompanyId = _customer?.CompanyId,
                    CommunicationPreferences = _updateRequest.CommunicationPreferences
                },
                // Preserve existing addresses — omitting them causes BFF to delete all
                Addresses = _customer?.Addresses?.Select(a => new CreateAddressRequest
                {
                    Id = a.Id,
                    Type = a.Type,
                    IsDefault = a.IsDefault,
                    AddressLine1 = a.AddressLine1,
                    AddressLine2 = a.AddressLine2,
                    AddressLine3 = a.AddressLine3,
                    District = a.District,
                    City = a.City,
                    StateProvince = a.StateProvince,
                    PostalCode = a.PostalCode,
                    CountryId = a.CountryId,
                    RecipientName = a.RecipientName,
                    RecipientPhone = a.RecipientPhone,
                    Version = a.Version
                }).ToList() ?? []
            };
            var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);
            if (response.IsSuccessStatusCode) { Snackbar.Add("Customer updated successfully!", Severity.Success); _isEditMode = false; await LoadCustomerData(); await LoadInitialActivities(); }
            else { var err = await response.Content.ReadAsStringAsync(); Snackbar.Add($"Failed to save: {err}", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isSaving = false; }
    }

    private async Task AddAddressDialog()
    {
        if (_customer == null) return;
        var parameters = new DialogParameters<AddressDialog> { { x => x.Address, new CreateAddressRequest { Type = "Shipping", IsDefault = !_customer.Addresses.Any(a => a.Type == "Shipping"), CountryId = _allCountries.FirstOrDefault(c => c.Code == "TH")?.Id ?? Guid.Empty } }, { x => x.IsNew, true }, { x => x.HasCompany, _customer.CompanyId.HasValue }, { x => x.CompanyName, _customer.CompanyName }, { x => x.CustomerName, _customer.Name }, { x => x.CustomerMobile, _customer.Mobile }, { x => x.AllCountries, _allCountries }, { x => x.SearchLocations, (Func<string?, CancellationToken, Task<IEnumerable<RegistryThaiLocation>>>)SearchThaiLocations } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddressDialog>("Add New Address", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateAddressRequest newAddress)
        {
            try
            {
                var response = await Http.PostAsJsonAsync($"api/customers/{Id}/addresses", new List<CreateAddressRequest> { newAddress });
                if (response.IsSuccessStatusCode) { Snackbar.Add("Address added successfully", Severity.Success); await LoadCustomerData(); _dropContainer?.Refresh(); await LoadInitialActivities(); }
            }
            catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

    private async Task EditAddressDialog(AddressResponse currentAddress)
    {
        if (_customer == null) return;
        var editRequest = new CreateAddressRequest { Id = currentAddress.Id, Type = currentAddress.Type, IsDefault = currentAddress.IsDefault, AddressLine1 = currentAddress.AddressLine1, AddressLine2 = currentAddress.AddressLine2, AddressLine3 = currentAddress.AddressLine3, District = currentAddress.District, City = currentAddress.City, StateProvince = currentAddress.StateProvince, PostalCode = currentAddress.PostalCode, CountryId = currentAddress.CountryId, RecipientName = currentAddress.RecipientName, RecipientPhone = currentAddress.RecipientPhone, Version = currentAddress.Version };
        var parameters = new DialogParameters<AddressDialog> { { x => x.Address, editRequest }, { x => x.IsNew, false }, { x => x.HasCompany, _customer.CompanyId.HasValue }, { x => x.CompanyName, _customer.CompanyName }, { x => x.CustomerName, _customer.Name }, { x => x.CustomerMobile, _customer.Mobile }, { x => x.AllCountries, _allCountries }, { x => x.SearchLocations, (Func<string?, CancellationToken, Task<IEnumerable<RegistryThaiLocation>>>)SearchThaiLocations } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddressDialog>("Edit Address", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateAddressRequest updatedAddress)
        {
            try
            {
                var addresses = _customer.Addresses.Select(a => {
                    if (a.Id == currentAddress.Id) return updatedAddress;
                    // If updated is set to default, unset others of same type
                    if (updatedAddress.IsDefault && a.Type == updatedAddress.Type)
                    {
                        return new CreateAddressRequest { Id = a.Id, Type = a.Type, IsDefault = false, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version };
                    }
                    return new CreateAddressRequest { Id = a.Id, Type = a.Type, IsDefault = a.IsDefault, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version };
                }).ToList();

                var onboardingRequest = new CustomerOnboardingRequest { Customer = new CreateCustomerRequest { FirstName = _customer.FirstName, LastName = _customer.LastName, Email = _customer.Email, Mobile = _customer.Mobile, Landline = _customer.Landline, Extension = _customer.Extension, Segment = _customer.Segment, Tier = _customer.Tier, PreferredLanguage = _customer.PreferredLanguage, Timezone = _customer.Timezone, CompanyId = _customer.CompanyId, CommunicationPreferences = _customer.CommunicationPreferences }, Addresses = addresses };
                var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);
                if (response.IsSuccessStatusCode) { Snackbar.Add("Address updated successfully", Severity.Success); await LoadCustomerData(); _dropContainer?.Refresh(); await LoadInitialActivities(); }
            } catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

    private async Task DeleteAddress(AddressResponse address)
    {
        if (_customer == null) return;
        var result = await DialogService.ShowMessageBoxAsync("Delete Address", "Are you sure you want to delete this address?", yesText: "Delete", noText: "Cancel");
        if (result == true)
        {
            try
            {
                var onboardingRequest = new CustomerOnboardingRequest { Customer = new CreateCustomerRequest { FirstName = _customer.FirstName, LastName = _customer.LastName, Email = _customer.Email, Mobile = _customer.Mobile, Landline = _customer.Landline, Extension = _customer.Extension, Segment = _customer.Segment, Tier = _customer.Tier, PreferredLanguage = _customer.PreferredLanguage, Timezone = _customer.Timezone, CompanyId = _customer.CompanyId }, Addresses = _customer.Addresses.Where(a => a.Id != address.Id).Select(a => new CreateAddressRequest { Id = a.Id, Type = a.Type, IsDefault = a.IsDefault, AddressLine1 = a.AddressLine1, AddressLine2 = a.AddressLine2, AddressLine3 = a.AddressLine3, District = a.District, City = a.City, StateProvince = a.StateProvince, PostalCode = a.PostalCode, CountryId = a.CountryId, RecipientName = a.RecipientName, RecipientPhone = a.RecipientPhone, Version = a.Version }).ToList() };
                var response = await Http.PutAsJsonAsync($"api/customers/{Id}/full", onboardingRequest);
                if (response.IsSuccessStatusCode) { Snackbar.Add("Address deleted successfully", Severity.Success); await LoadCustomerData(); _dropContainer?.Refresh(); await LoadInitialActivities(); }
            } catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

    private async Task OpenDocumentUpload()
    {
        var parameters = new DialogParameters<UploadDocumentDialog> { { x => x.CustomerId, Id }, { x => x.Http, Http }, { x => x.Category, "General" } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UploadDocumentDialog>("Upload Documents", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) { await LoadCustomerData(); await LoadInitialActivities(); }
    }

    private async Task OpenNdaUpload()
    {
        var parameters = new DialogParameters<UploadDocumentDialog> { { x => x.CustomerId, Id }, { x => x.Http, Http }, { x => x.Category, "NDA" }, { x => x.Accept, ".pdf" }, { x => x.HideCategory, true } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UploadDocumentDialog>("Upload NDA Document", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data != null)
        {
            try
            {
                // Reload customer to get the newly linked document with its real ID
                await LoadCustomerData();

                var dataList = (IEnumerable<dynamic>)result.Data;
                var firstUpload = dataList.FirstOrDefault();

                if (firstUpload != null)
                {
                    string uploadId = firstUpload.UploadId;

                    // Find the document reference that was created by link-documents
                    var ndaDoc = _customer?.Documents?.FirstOrDefault(d =>
                        d.FileReference == uploadId && d.DocumentCategory == "NDA");

                    await Http.PostAsJsonAsync("api/customers/ndas", new {
                        customerId = Id,
                        status = "Draft",
                        documentReferenceId = ndaDoc?.Id
                    });

                    Snackbar.Add("NDA uploaded and draft created", Severity.Success);
                    await LoadCustomerData();
                    await LoadInitialActivities();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error creating NDA record: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditNdaDialog()
    {
        await LoadCustomerData();
        if (_customer?.Nda == null) return;
        var parameters = new DialogParameters<AddNdaDialog> { { x => x.CustomerId, Id }, { x => x.ExistingNda, _customer.Nda } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddNdaDialog>("NDA Settings", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data != null)
        {
            try
            {
                var data = result.Data;
                var expiresAt = (DateTime?)data.GetType().GetProperty("ExpiresAt")?.GetValue(data);
                var status = (string?)data.GetType().GetProperty("Status")?.GetValue(data);
                var version = (byte[]?)data.GetType().GetProperty("Version")?.GetValue(data);
                var signedAt = (DateTime?)data.GetType().GetProperty("SignedAt")?.GetValue(data);
                var signedBy = (string?)data.GetType().GetProperty("SignedBy")?.GetValue(data);
                var revokeReason = (string?)data.GetType().GetProperty("RevokeReason")?.GetValue(data);
                var revokedAt = (DateTime?)data.GetType().GetProperty("RevokedAt")?.GetValue(data);

                // Update status and expiration date via /status endpoint (now supports expiresAt)
                var response = await Http.PatchAsJsonAsync($"api/customers/ndas/{_customer.Nda.Id}/status", new { status, expiresAt, version, signedAt, signedBy, revokeReason, revokedAt });

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("NDA updated successfully", Severity.Success);
                    await LoadCustomerData();
                    await LoadInitialActivities();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Failed to update NDA: {error}", Severity.Error);
                }
            } catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        }
    }

