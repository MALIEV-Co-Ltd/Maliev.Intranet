@page "/sales/quotations"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quotations - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Quotations</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search quotations..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Create Quotation
        </MudButton>
    </MudStack>
</MudPaper>

    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
    <MudTabs Elevation="0" Rounded="false" TabPanelsClass="pa-0" Class="border-b mud-border-lines-default">
        <MudTabPanel Text="All" Icon="@Icons.Material.Outlined.List" />
        <!-- Badge logic removed for now as it requires complex counting or separate API -->
        <MudTabPanel Text="Draft" Icon="@Icons.Material.Outlined.Edit" />
        <MudTabPanel Text="Sent" Icon="@Icons.Material.Outlined.Send" />
        <MudTabPanel Text="Accepted" Icon="@Icons.Material.Outlined.CheckCircle" />
        <MudTabPanel Text="Expired" Icon="@Icons.Material.Outlined.EventBusy" />
    </MudTabs>

    @if (_isLoading)
    {
        <div class="pa-4">
            @for (int i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
            }
        </div>
    }
    else
    {
        <MudDataGrid T="QuotationSummaryDto" 
                     Items="@_quotations" 
                     Dense="true" 
                     Hover="true" 
                     Striped="false"
                     Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.QuotationNumber" Title="Quote #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.Total" Title="Total" Format="C2" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" 
                                           Size="Size.Small" 
                                           Color="Color.Default" 
                                           Href="@($"/sales/quotations/{context.Item.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" 
                                           Size="Size.Small" 
                                           Color="Color.Error" 
                                           OnClick="@(() => DeleteQuotation(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<QuotationSummaryDto> _quotations = new();

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<QuotationSummaryDto>>("api/quotations");
            if (response?.Data != null)
            {
                _quotations = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading quotations: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<CreateQuotationDialog>("Create Quotation", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task DeleteQuotation(QuotationSummaryDto quotation)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Delete Quotation", 
            $"Are you sure you want to delete {quotation.QuotationNumber}?", 
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/quotations/{quotation.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Quotation deleted", Severity.Success);
                await OnInitializedAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete quotation", Severity.Error);
            }
        }
    }
}
