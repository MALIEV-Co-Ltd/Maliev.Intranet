@page "/sales/quotations"
@using Maliev.Intranet.Shared
@inject HttpClient Http

<PageTitle>Quotations - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Quotations</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search quotations..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add">
            Create Quotation
        </MudButton>
    </MudStack>
</MudPaper>

    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
    <MudTabs Elevation="0" Rounded="false" PanelClass="pa-0" Class="border-b mud-border-lines-default">
        <MudTabPanel Text="All" Icon="@Icons.Material.Outlined.List" />
        <MudTabPanel Text="Draft" Icon="@Icons.Material.Outlined.Edit" BadgeData="@(_quotations.Count(x => x.Status == "Draft") > 0 ? _quotations.Count(x => x.Status == "Draft") : null)" BadgeColor="Color.Default" />
        <MudTabPanel Text="Sent" Icon="@Icons.Material.Outlined.Send" BadgeData="@(_quotations.Count(x => x.Status == "Sent") > 0 ? _quotations.Count(x => x.Status == "Sent") : null)" BadgeColor="Color.Primary" />
        <MudTabPanel Text="Accepted" Icon="@Icons.Material.Outlined.CheckCircle" BadgeData="@(_quotations.Count(x => x.Status == "Accepted") > 0 ? _quotations.Count(x => x.Status == "Accepted") : null)" BadgeColor="Color.Success" />
        <MudTabPanel Text="Expired" Icon="@Icons.Material.Outlined.EventBusy" />
    </MudTabs>

    @if (_isLoading)
    {
        <div class="pa-4">
            @for (int i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
            }
        </div>
    }
    else
    {
        <MudDataGrid T="QuotationDto" 
                     Items="@_quotations" 
                     Dense="true" 
                     Hover="true" 
                     Striped="false"
                     Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.QuoteNumber" Title="Quote #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.CreatedDate" Title="Created" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.ExpiryDate" Title="Expiry" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.Total" Title="Total" Format="C2" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" 
                                           Size="Size.Small" 
                                           Color="Color.Default" 
                                           Href="@($"/sales/quotations/{context.Item.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" 
                                           Size="Size.Small" 
                                           Color="Color.Primary" />
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" 
                                           Size="Size.Small" 
                                           Color="Color.Default" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<QuotationDto> _quotations = new();

    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace with BFF API call
        // _quotations = await Http.GetFromJsonAsync<List<QuotationDto>>("api/quotations");
        await Task.Delay(500);
        _isLoading = false;
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Sent" => Color.Primary,
        "Accepted" => Color.Success,
        "Expired" => Color.Error,
        "Rejected" => Color.Error,
        _ => Color.Default
    };

    public class QuotationDto
    {
        public Guid Id { get; set; }
        public string QuoteNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public DateTime CreatedDate { get; set; }
        public DateTime ExpiryDate { get; set; }
        public decimal Total { get; set; }
        public string Status { get; set; } = string.Empty;
    }
}
