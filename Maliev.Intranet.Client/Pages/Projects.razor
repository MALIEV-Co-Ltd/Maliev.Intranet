@page "/sales/projects"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Projects | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="Projects" Subtitle="Project intake, part configuration, quotation readiness, and production handoff.">
        <PrimaryButton Icon="@Icons.Material.Outlined.Add" Href="/sales/projects/new">New Project</PrimaryButton>
    </ModuleHeader>

    <PageBody Class="mlv-data-page-body">
        <StatBar Class="mb-4">
            <StatTile Label="Matching projects" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="Page count" Value="@_projects.Count.ToString("N0")" />
            <StatTile Label="Page value" Value="@CurrencyFormatter.Format(_projects.Sum(p => p.TotalPrice), "THB", 2)" />
            <StatTile Label="View" Value="@(ActiveStatus ?? "All")" />
        </StatBar>

        <div class="mlv-toolbar">
            <div class="mlv-toolbar-left">
                <SearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search projects..." OnEnter="SearchAsync" />
                <div class="mlv-segmented">
                    @foreach (var tab in _statusTabs)
                    {
                        <button type="button" class="@(string.Equals(ActiveStatusLabel, tab.Label, StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="@(() => SetStatusAsync(tab.Value))">@tab.Label</button>
                    }
                </div>
            </div>
            <div class="mlv-toolbar-right">
                <SecondaryButton Icon="@Icons.Material.Outlined.Search" OnClick="@SearchClickedAsync">Search</SecondaryButton>
                <SecondaryButton Icon="@Icons.Material.Outlined.Refresh" OnClick="@ReloadAsync">Refresh</SecondaryButton>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }

        @if (_loading)
        {
            <ProgressiveSkeleton Layout="table" Rows="6" Columns="6" ShowFilters="false" Class="mb-3" Label="Loading projects" />
        }

        <PanelCard Class="mlv-data-results-panel">
            @if (_projects.Count > 0)
            {
                <table class="mlv-table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Parts</th>
                            <th>Total</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in _projects)
                        {
                            <tr @onclick="@(() => Navigation.NavigateTo($"/sales/projects/{project.Id}"))">
                                <td>
                                    <div class="project-row-identity">
                                        <div class="project-part-preview-strip" aria-label="@ProjectPartPreviewLabel(project)">
                                            @if (project.PartPreviews.Count > 0)
                                            {
                                                @foreach (var part in project.PartPreviews.Take(MaxPartPreviewThumbnails))
                                                {
                                                    <span class="project-part-thumb" title="@PartPreviewTitle(part)">
                                                        @if (!string.IsNullOrWhiteSpace(part.ThumbnailUrl))
                                                        {
                                                            <img src="@part.ThumbnailUrl"
                                                                 alt="@PartPreviewAlt(part)"
                                                                 class="project-part-thumb-img"
                                                                 loading="lazy"
                                                                 onerror="this.closest('.project-part-thumb')?.classList.add('image-failed')" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                                        }
                                                    </span>
                                                }

                                                @if (HiddenPartCount(project) > 0)
                                                {
                                                    <span class="project-part-thumb-count" title="@($"{HiddenPartCount(project):N0} more part previews")">+@HiddenPartCount(project).ToString("N0")</span>
                                                }
                                            }
                                            else if (project.PartsCount > 0)
                                            {
                                                <span class="project-part-thumb empty" title="@($"{project.PartsCount:N0} part{(project.PartsCount == 1 ? "" : "s")} awaiting thumbnail")">
                                                    <MudIcon Icon="@Icons.Material.Outlined.ViewInAr" Size="Size.Small" />
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="project-part-preview-empty">-</span>
                                            }
                                        </div>
                                        <div class="project-row-copy">
                                            <div class="mlv-row-main mlv-mono">@project.ProjectNumber</div>
                                            <div class="mlv-row-sub">@Display(project.Title)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@Display(project.CustomerName)</td>
                                <td><StatusBadge Status="@project.Status" /></td>
                                <td>@project.PartsCount.ToString("N0")</td>
                                <td class="mlv-mono">@(project.TotalPrice > 0 ? CurrencyFormatter.Format(project.TotalPrice, "THB", 2) : "-")</td>
                                <td>@project.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="mlv-empty">
                    No projects match this view.
                    <div class="mt-3">
                        <PrimaryButton Icon="@Icons.Material.Outlined.Add" Href="/sales/projects/new">Create Project</PrimaryButton>
                    </div>
                </div>
            }
        </PanelCard>

        <PaginationFooter Meta="@_meta"
                          CurrentPage="@_page"
                          PageSize="@_pageSize"
                          PageChanged="OnPageChanged"
                          PageSizeChanged="OnPageSizeChanged"
                          Disabled="@_loading" />
    </PageBody>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? QueryPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public int? QueryPageSize { get; set; }

    private readonly (string Label, string? Value)[] _statusTabs =
    [
        ("All", null),
        ("Draft", "Draft"),
        ("Configuring", "Configuring"),
        ("Quoted", "Quoted"),
        ("In Production", "In Production"),
        ("Completed", "Completed")
    ];

    private string? _status;
    private string? _search;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 20;
    private List<ProjectSummaryDto> _projects = [];
    private PaginationMeta _meta = new();

    private const int MaxPartPreviewThumbnails = 3;

    private string? ActiveStatus => string.IsNullOrWhiteSpace(_status) ? null : _status;
    private string ActiveStatusLabel => _statusTabs.FirstOrDefault(t => string.Equals(t.Value, ActiveStatus, StringComparison.OrdinalIgnoreCase)).Label ?? "All";

    protected override async Task OnParametersSetAsync()
    {
        _status = NormalizeStatus(Status);
        _search = Search;
        _page = Math.Max(1, QueryPage ?? 1);
        _pageSize = NormalizePageSize(QueryPageSize ?? 20);
        await LoadProjectsAsync();
    }

    private async Task SetStatusAsync(string? status)
    {
        _status = status;
        _page = 1;
        await NavigateAndLoadAsync();
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return Task.CompletedTask;
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await NavigateAndLoadAsync();
    }

    private async Task SearchClickedAsync(MouseEventArgs _) => await SearchAsync();

    private async Task ReloadAsync(MouseEventArgs _) => await LoadProjectsAsync();

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await NavigateAndLoadAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = NormalizePageSize(pageSize);
        _page = 1;
        await NavigateAndLoadAsync();
    }

    private async Task NavigateAndLoadAsync()
    {
        Navigation.NavigateTo(BuildPageUri(), replace: true);
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync(CancellationToken ct = default)
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResponse<ProjectSummaryDto>>(BuildApiUrl(), ct);
            _projects = result?.Data.ToList() ?? [];
            _meta = result?.Meta ?? new();
            _meta.CurrentPage = _meta.CurrentPage == 0 ? _page : _meta.CurrentPage;
            _meta.PageSize = _meta.PageSize == 0 ? _pageSize : _meta.PageSize;
        }
        catch (Exception ex)
        {
            _error = "Projects could not be loaded.";
            Snackbar.Add(_error, Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private string BuildApiUrl()
    {
        var query = new List<string>
        {
            $"page={_page}",
            $"pageSize={_pageSize}"
        };

        if (!string.IsNullOrWhiteSpace(ActiveStatus))
        {
            query.Add($"status={Uri.EscapeDataString(ActiveStatus)}");
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query.Add($"search={Uri.EscapeDataString(_search)}");
        }

        return $"api/v1/projects?{string.Join("&", query)}";
    }

    private string BuildPageUri()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(ActiveStatus)) query.Add($"status={Uri.EscapeDataString(ActiveStatus)}");
        if (!string.IsNullOrWhiteSpace(_search)) query.Add($"search={Uri.EscapeDataString(_search)}");
        if (_page > 1) query.Add($"page={_page}");
        if (_pageSize != 20) query.Add($"pageSize={_pageSize}");
        return query.Count == 0 ? "/sales/projects" : $"/sales/projects?{string.Join("&", query)}";
    }

    private string? NormalizeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return null;
        var match = _statusTabs.FirstOrDefault(t => string.Equals(t.Value, status, StringComparison.OrdinalIgnoreCase));
        return match.Value;
    }

    private static int NormalizePageSize(int pageSize) => pageSize switch
    {
        <= 10 => 10,
        <= 20 => 20,
        _ => 50
    };

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static int HiddenPartCount(ProjectSummaryDto project) =>
        Math.Max(0, project.PartsCount - Math.Min(project.PartPreviews.Count, MaxPartPreviewThumbnails));

    private static string ProjectPartPreviewLabel(ProjectSummaryDto project)
    {
        if (project.PartPreviews.Count > 0)
            return $"Part previews for {project.ProjectNumber}";

        return project.PartsCount > 0
            ? $"{project.PartsCount:N0} part{(project.PartsCount == 1 ? "" : "s")} awaiting thumbnail"
            : "No parts";
    }

    private static string PartPreviewAlt(ProjectPartPreviewDto part) => $"{Display(part.FileName)} thumbnail";

    private static string PartPreviewTitle(ProjectPartPreviewDto part)
    {
        var details = new List<string> { Display(part.FileName) };
        if (!string.IsNullOrWhiteSpace(part.ProcessType)) details.Add(part.ProcessType);
        if (!string.IsNullOrWhiteSpace(part.MaterialName)) details.Add(part.MaterialName);
        if (part.Quantity > 1) details.Add($"Qty {part.Quantity:N0}");
        return string.Join(" | ", details);
    }
}
