@page "/finance/delivery-notes"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Delivery Notes - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 600;" Class="mb-4">Delivery Notes (ใบส่งของ)</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search delivery notes..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Create Delivery Note
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <div class="pa-4">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
        }
    </div>
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="DeliveryNoteSummaryDto" 
                     Items="@_deliveryNotes" 
                     Dense="true" 
                     Hover="true"
                     RowsPerPage="10"
                     Elevation="0">
            <Columns>
                <TemplateColumn Title="Delivery Note #">
                    <CellTemplate>
                        <MudLink Href="@($"/finance/delivery-notes/{context.Item.DeliveryNoteNumber}")" Color="Color.Primary">
                            @context.Item.DeliveryNoteNumber
                        </MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.OrderNumber" Title="Order #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.DeliveryDate" Title="Date" Format="dd MMM yyyy" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ItemCount" Title="Items" />
                <PropertyColumn Property="x => x.TrackingNumber" Title="Tracking #" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" 
                                           Size="Size.Small" 
                                           Color="Color.Default" 
                                           OnClick="@(() => ViewDetails(context.Item.Id))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" 
                                           Size="Size.Small" 
                                           Color="Color.Error" 
                                           OnClick="@(() => GeneratePdf(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" 
                                           Size="Size.Small" 
                                           Color="Color.Primary" 
                                           OnClick="@(() => OpenUpdateStatusDialog(context.Item))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Default">No delivery notes found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<DeliveryNoteSummaryDto> _deliveryNotes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<DeliveryNoteSummaryDto>>("api/deliverynotes");
            if (response?.Data != null)
            {
                _deliveryNotes = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading delivery notes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateDeliveryNoteDialog>("Create Delivery Note", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task OpenUpdateStatusDialog(DeliveryNoteSummaryDto note)
    {
        var parameters = new DialogParameters<UpdateDeliveryStatusDialog>
        {
            { x => x.DeliveryNoteId, note.Id },
            { x => x.CurrentStatus, note.Status }
        };
        
        var dialog = await DialogService.ShowAsync<UpdateDeliveryStatusDialog>("Update Status", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task GeneratePdf(DeliveryNoteSummaryDto note)
    {
        try
        {
            var response = await Http.PostAsync($"api/deliverynotes/{note.Id}/pdf", null);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("storageUrl", out var urlElement))
                {
                    var pdfUrl = urlElement.GetString();
                    if (!string.IsNullOrEmpty(pdfUrl))
                    {
                        await JS.InvokeVoidAsync("open", pdfUrl, "_blank");
                        Snackbar.Add("PDF generated successfully", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("PDF generated but URL is empty", Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add("Invalid response from server", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Failed to generate PDF", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/finance/delivery-notes/{id}");
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Delivered" => Color.Success,
        "InTransit" => Color.Info,
        "Pending" => Color.Default,
        "Cancelled" => Color.Error,
        "PartiallyDelivered" => Color.Warning,
        _ => Color.Default
    };
}
