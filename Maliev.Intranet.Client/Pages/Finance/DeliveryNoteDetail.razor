@page "/finance/delivery-notes/{DeliveryNoteId}"
@using Maliev.Intranet.Shared.Dtos
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Delivery Note @DeliveryNoteId - Maliev Intranet</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_deliveryNote == null)
{
    <MudAlert Severity="Severity.Error">Delivery note not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/finance/delivery-notes"))">
        Back to List
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.h5">Delivery Note @_deliveryNote.DeliveryNoteNumber</MudText>
                <MudChip T="string" Size="Size.Medium" Color="@GetStatusColor(_deliveryNote.Status)">
                    @_deliveryNote.Status
                </MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Outlined.Edit"
                           OnClick="@OpenEditStatusDialog">
                    Update Status
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Error" 
                           StartIcon="@Icons.Material.Outlined.PictureAsPdf"
                           OnClick="@GeneratePdf">
                    Download PDF
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mt-4">
        <MudTabPanel Text="Details" Icon="@Icons.Material.Outlined.Info">
            <MudGrid Class="pa-4">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Delivery Information</MudText>

                        <MudStack Spacing="2">
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Order #:</MudText>
                                @if (!string.IsNullOrEmpty(_deliveryNote.OrderId))
                                {
                                    <MudLink Href="@($"/sales/orders/{_deliveryNote.OrderId}")" Color="Color.Primary">
                                        @_deliveryNote.OrderId
                                    </MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">-</MudText>
                                }
                            </MudStack>

                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Customer:</MudText>
                                <MudText Typo="Typo.body2">@(_deliveryNote.CustomerName ?? "N/A")</MudText>
                            </MudStack>

                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Delivery Date:</MudText>
                                <MudText Typo="Typo.body2">@_deliveryNote.DeliveryDate.ToString("dd MMM yyyy")</MudText>
                            </MudStack>

                            @if (_deliveryNote.ActualDeliveryTime.HasValue)
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Actual Delivered:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.ActualDeliveryTime.Value.ToString("dd MMM yyyy HH:mm")</MudText>
                                </MudStack>
                            }

                            @if (!string.IsNullOrEmpty(_deliveryNote.ReceivedByName))
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Received By:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.ReceivedByName</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Shipping & Contact</MudText>

                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Shipping Address:</MudText>
                            <MudText Typo="Typo.body2" Class="pl-2">
                                @FormatAddress(_deliveryNote)
                            </MudText>

                            @if (!string.IsNullOrEmpty(_deliveryNote.DeliveryContactName))
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Contact:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.DeliveryContactName</MudText>
                                </MudStack>
                            }

                            @if (!string.IsNullOrEmpty(_deliveryNote.DeliveryContactPhone))
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Phone:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.DeliveryContactPhone</MudText>
                                </MudStack>
                            }

                            @if (!string.IsNullOrEmpty(_deliveryNote.CarrierName))
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Carrier:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.CarrierName</MudText>
                                </MudStack>
                            }

                            @if (!string.IsNullOrEmpty(_deliveryNote.TrackingNumber))
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Tracking #:</MudText>
                                    <MudText Typo="Typo.body2">@_deliveryNote.TrackingNumber</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                @if (!string.IsNullOrEmpty(_deliveryNote.DeliveryInstructions))
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                            <MudText Typo="Typo.h6" Class="mb-3">Delivery Instructions</MudText>
                            <MudText Typo="Typo.body2">@_deliveryNote.DeliveryInstructions</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Items" Icon="@Icons.Material.Outlined.Inventory2">
            <MudPaper Elevation="0" Class="pa-4">
                <MudTable Items="@_deliveryNote.Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Product Code</MudTh>
                        <MudTh>Product Name</MudTh>
                        <MudTh Style="text-align: right;">Ordered</MudTh>
                        <MudTh Style="text-align: right;">Manufactured</MudTh>
                        <MudTh Style="text-align: right;">Delivered</MudTh>
                        <MudTh>Unit</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Product Code">@context.ProductCode</MudTd>
                        <MudTd DataLabel="Product Name">@context.ProductName</MudTd>
                        <MudTd DataLabel="Ordered" Style="text-align: right;">@context.QuantityOrdered.ToString("N2")</MudTd>
                        <MudTd DataLabel="Manufactured" Style="text-align: right;">@context.QuantityManufactured.ToString("N2")</MudTd>
                        <MudTd DataLabel="Delivered" Style="text-align: right;">
                            @if (context.QuantityDelivered < context.QuantityManufactured)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                    @context.QuantityDelivered.ToString("N2")
                                </MudChip>
                            }
                            else
                            {
                                <strong>@context.QuantityDelivered.ToString("N2")</strong>
                            }
                        </MudTd>
                        <MudTd DataLabel="Unit">@context.UnitOfMeasure</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No items found</MudText>
                    </NoRecordsContent>
                </MudTable>

                <MudDivider Class="my-4" />
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudText Typo="Typo.body1"><strong>Total Items:</strong> @_deliveryNote.Items.Count</MudText>
                </MudStack>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Files" Icon="@Icons.Material.Outlined.AttachFile">
            <MudPaper Elevation="0" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                    <MudText Typo="Typo.h6">Attachments</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Upload" Variant="Variant.Outlined" Size="Size.Small" OnClick="UploadAttachment">Upload File</MudButton>
                </MudStack>

                @if (!_attachments.Any())
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No attachments yet. Click "Upload File" to add documents.</MudAlert>
                }
                else
                {
                    <MudList T="AttachmentItem">
                        @foreach (var attachment in _attachments)
                        {
                            <MudListItem T="AttachmentItem" Value="attachment">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.body2">@attachment.FileName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Default">@attachment.UploadedAt.ToString("dd MMM yyyy")</MudText>
                                        </div>
                                    </MudStack>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Activity" Icon="@Icons.Material.Outlined.History">
            <MudPaper Elevation="0" Class="pa-4">
                <MudTimeline TimelineAlign="TimelineAlign.Start" TimelinePosition="TimelinePosition.Start">
                    <MudTimelineItem Color="Color.Success" Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.body1"><strong>Created</strong></MudText>
                            <MudText Typo="Typo.body2">@_deliveryNote.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">by @_deliveryNote.CreatedBy</MudText>
                        </ItemContent>
                    </MudTimelineItem>

                    @if (_deliveryNote.UpdatedAt.HasValue)
                    {
                        <MudTimelineItem Color="Color.Info" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.body1"><strong>Status: @_deliveryNote.Status</strong></MudText>
                                <MudText Typo="Typo.body2">@_deliveryNote.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")</MudText>
                                @if (!string.IsNullOrEmpty(_deliveryNote.UpdatedBy))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">by @_deliveryNote.UpdatedBy</MudText>
                                }
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string DeliveryNoteId { get; set; } = null!;

    private bool _isLoading = true;
    private DeliveryNoteDetailDto? _deliveryNote;
    private List<BreadcrumbItem> _breadcrumbs = new();
    private List<AttachmentItem> _attachments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDeliveryNote();

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Finance", href: null, disabled: true),
            new BreadcrumbItem("Delivery Notes", href: "/finance/delivery-notes"),
            new BreadcrumbItem(_deliveryNote?.DeliveryNoteNumber ?? DeliveryNoteId, href: null, disabled: true)
        };
    }

    private async Task LoadDeliveryNote()
    {
        try
        {
            _isLoading = true;
            _deliveryNote = await Http.GetFromJsonAsync<DeliveryNoteDetailDto>($"api/deliverynotes/{DeliveryNoteId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading delivery note: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditStatusDialog()
    {
        if (_deliveryNote == null) return;

        var parameters = new DialogParameters
        {
            ["DeliveryNoteId"] = Guid.Parse(DeliveryNoteId),
            ["CurrentStatus"] = _deliveryNote.Status
        };

        var dialog = await DialogService.ShowAsync<UpdateDeliveryStatusDialog>("Update Status", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDeliveryNote();
            StateHasChanged();
        }
    }

    private async Task GeneratePdf()
    {
        try
        {
            var response = await Http.PostAsync($"api/deliverynotes/{DeliveryNoteId}/pdf", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("PDF generation requested. Check back shortly.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to generate PDF", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string FormatAddress(DeliveryNoteDetailDto note)
    {
        var parts = new List<string>();

        if (!string.IsNullOrEmpty(note.ShippingAddressLine1))
            parts.Add(note.ShippingAddressLine1);

        if (!string.IsNullOrEmpty(note.ShippingAddressLine2))
            parts.Add(note.ShippingAddressLine2);

        var cityProvince = new List<string>();
        if (!string.IsNullOrEmpty(note.ShippingCity))
            cityProvince.Add(note.ShippingCity);
        if (!string.IsNullOrEmpty(note.ShippingProvince))
            cityProvince.Add(note.ShippingProvince);
        if (!string.IsNullOrEmpty(note.ShippingPostalCode))
            cityProvince.Add(note.ShippingPostalCode);

        if (cityProvince.Any())
            parts.Add(string.Join(" ", cityProvince));

        if (!string.IsNullOrEmpty(note.ShippingCountry))
            parts.Add(note.ShippingCountry);

        return parts.Any() ? string.Join(", ", parts) : "N/A";
    }

    private async Task UploadAttachment()
    {
        // File upload dialog - integrate with DocumentUploadSection if available
        Snackbar.Add("Select a file to upload (file picker will open in browser)", Severity.Info);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Delivered" => Color.Success,
        "InTransit" => Color.Info,
        "Pending" => Color.Default,
        "Cancelled" => Color.Error,
        "PartiallyDelivered" => Color.Warning,
        _ => Color.Default
    };

    private class AttachmentItem
    {
        public string FileName { get; set; } = string.Empty;
        public DateTime UploadedAt { get; set; } = DateTime.Now;
        public string Url { get; set; } = string.Empty;
    }
}
