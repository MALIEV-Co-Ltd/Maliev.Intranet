@page "/finance/payments"
@using Maliev.Intranet.Client.Components
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Payments & Receipts | Intranet Gateway</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 600;">Payments &amp; Receipts</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Financial transaction records and payment receipts</MudText>
    </div>
</MudStack>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: Payments -->
    <MudTabPanel Text="Payments" Icon="@Icons.Material.Outlined.Payments">

        <MudGrid Class="mb-4">
            @if (_paymentsLoading)
            {
                @for (int i = 0; i < 4; i++)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="rounded-lg" />
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption" Color="Color.Default">Today's Total</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">@CurrencyFormatter.Format(_paymentStats.TodayTotal, "THB", 2)</MudText>
                            <MudText Typo="Typo.caption" Color="@(_paymentStats.PercentageChangeFromYesterday >= 0 ? Color.Success : Color.Error)">
                                <MudIcon Icon="@(_paymentStats.PercentageChangeFromYesterday >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" Size="Size.Small" />
                                @Math.Abs(_paymentStats.PercentageChangeFromYesterday).ToString("P0") from yesterday
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption" Color="Color.Default">Pending</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight: 700;">@CurrencyFormatter.Format(_paymentStats.PendingTotal, "THB", 2)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">@_paymentStats.PendingCount transactions</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption" Color="Color.Default">This Month</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">@CurrencyFormatter.Format(_paymentStats.MonthTotal, "THB", 2)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">Received</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.caption" Color="Color.Default">Failed</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight: 700;">@CurrencyFormatter.Format(_paymentStats.FailedTotal, "THB", 2)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">@_paymentStats.FailedCount transactions</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="_paymentSearch"
                              Placeholder="Search transactions..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="max-width: 400px;" />
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download">
                    Export
                </MudButton>
            </MudStack>
        </MudPaper>

        @if (_paymentsLoading)
        {
            <div class="pa-4">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
                }
            </div>
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="PaymentSummaryDto" Items="@_payments" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.PaymentNumber" Title="Number" />
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                        <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" />
                        <PropertyColumn Property="x => x.PaymentMethod" Title="Method" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@GetPaymentStatusColor(context.Item.Status)">
                                    @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.PaymentDate" Title="Date" Format="dd MMM yyyy HH:mm" />
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" Color="Color.Default" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Color="Color.Primary" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No transactions found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- TAB 1: Receipts -->
    <MudTabPanel Text="Receipts" Icon="@Icons.Material.Outlined.RequestQuote">

        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudTextField @bind-Value="_receiptSearch"
                              Placeholder="Search receipts..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="max-width: 400px;" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateReceiptDialog">
                    Create Receipt
                </MudButton>
            </MudStack>
        </MudPaper>

        @if (_receiptsLoading)
        {
            <div class="pa-4">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
                }
            </div>
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
                <MudDataGrid T="ReceiptDto" Items="@FilteredReceipts" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.ReceiptNumber" Title="Receipt #" />
                        <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice #" />
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                        <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" />
                        <PropertyColumn Property="x => x.PaymentMethod" Title="Method" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@GetReceiptStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Date" Title="Date" Format="dd MMM yyyy" />
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Outlined.PictureAsPdf" Size="Size.Small" Color="Color.Error" OnClick="@(() => Snackbar.Add($"Preparing PDF for {context.Item.ReceiptNumber}...", Severity.Info))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Print" Size="Size.Small" Color="Color.Default" OnClick="@(() => Snackbar.Add($"Printing {context.Item.ReceiptNumber}...", Severity.Info))" />
                                    @if (context.Item.Status != "Voided")
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Error" OnClick="@(() => VoidReceipt(context.Item))" />
                                    }
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Default">No receipts found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // Payments state
    private bool _paymentsLoading = true;
    private string _paymentSearch = "";
    private List<PaymentSummaryDto> _payments = new();
    private PaymentStatsDto _paymentStats = new();

    // Receipts state
    private bool _receiptsLoading = true;
    private string _receiptSearch = "";
    private List<ReceiptDto> _receipts = new();

    private IEnumerable<ReceiptDto> FilteredReceipts => string.IsNullOrEmpty(_receiptSearch)
        ? _receipts
        : _receipts.Where(r => r.ReceiptNumber.Contains(_receiptSearch, StringComparison.OrdinalIgnoreCase)
            || r.CustomerName.Contains(_receiptSearch, StringComparison.OrdinalIgnoreCase)
            || (r.InvoiceNumber?.Contains(_receiptSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    /// <summary>
    /// Initializes the page, checking URL query param to activate the correct tab.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Check if navigated directly to receipts tab via ?tab=receipts
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["tab"] == "receipts")
        {
            _activeTab = 1;
        }

        await Task.WhenAll(LoadPayments(), LoadReceipts());
    }

    private async Task LoadPayments()
    {
        try
        {
            _paymentsLoading = true;
            var statsTask = Http.GetFromJsonAsync<PaymentStatsDto>("api/payments/stats");
            var paymentsTask = Http.GetFromJsonAsync<PagedResponse<PaymentSummaryDto>>("api/payments");
            await Task.WhenAll(statsTask, paymentsTask);
            _paymentStats = await statsTask ?? new();
            var response = await paymentsTask;
            _payments = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payments: {ex.Message}");
        }
        finally
        {
            _paymentsLoading = false;
        }
    }

    private async Task LoadReceipts()
    {
        try
        {
            _receiptsLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<ReceiptDto>>("api/receipts");
            _receipts = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading receipts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _receiptsLoading = false;
        }
    }

    private async Task OpenCreateReceiptDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<CreateReceiptDialog>("Create Receipt", options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadReceipts();
            Snackbar.Add("Receipt created successfully", Severity.Success);
        }
    }

    private async Task VoidReceipt(ReceiptDto receipt)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Void Receipt",
            $"Are you sure you want to void receipt {receipt.ReceiptNumber}? This cannot be undone.",
            yesText: "Void", noText: "Cancel");
        if (confirm != true) return;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/receipts/{receipt.Id}/void", new { Reason = "Manual void" });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Receipt {receipt.ReceiptNumber} voided", Severity.Success);
                await LoadReceipts();
            }
            else
            {
                Snackbar.Add("Failed to void receipt", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetPaymentStatusColor(string status) => status switch
    {
        "Success" => Color.Success,
        "Pending" => Color.Warning,
        "Failed" => Color.Error,
        "Refunded" => Color.Info,
        _ => Color.Default
    };

    private Color GetReceiptStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Voided" => Color.Error,
        _ => Color.Default
    };
}
