@page "/finance/reports"
@inject NavigationManager Navigation

<PageTitle>Reports | Intranet Gateway</PageTitle>

@code {
    /// <summary>Redirects legacy /finance/reports URL to the consolidated Accounting page (Reports tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/finance/accounting?tab=reports", replace: true);
    }
}
