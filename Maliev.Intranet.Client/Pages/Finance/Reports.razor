@page "/finance/reports"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Financial Reports - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Financial Reports</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-6 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
        <MudSelect @bind-Value="_selectedReport" Label="Report Type" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 300px;">
            <MudSelectItem Value="@("ProfitAndLoss")">Profit & Loss</MudSelectItem>
            <MudSelectItem Value="@("BalanceSheet")">Balance Sheet</MudSelectItem>
            <MudSelectItem Value="@("CashFlow")">Cash Flow</MudSelectItem>
        </MudSelect>
        
        <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" Variant="Variant.Outlined" Margin="Margin.Dense" />
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@LoadReport" Disabled="@(_isLoading || _dateRange.Start == null || _dateRange.End == null)">
            Generate Report
        </MudButton>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Disabled="@(_report == null)" OnClick="DownloadReport" />
        <MudIconButton Icon="@Icons.Material.Filled.Print" Disabled="@(_report == null)" OnClick="PrintReport" />
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_report == null)
{
    <MudAlert Severity="Severity.Info">Select a report and date range to begin.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="pa-8 border mud-border-lines-default rounded-lg" Style="max-width: 800px; margin: 0 auto;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Maliev Platform</MudText>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-1">@_report.ReportName</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-8">
            Period: @(_dateRange.Start?.ToString("dd MMM yyyy")) to @(_dateRange.End?.ToString("dd MMM yyyy"))
        </MudText>
        
        @foreach (var reportSection in _report.Sections)
        {
            <div class="report-section mb-6">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; text-transform: uppercase;">@reportSection.Title</MudText>
                <MudDivider Class="my-2" Style="border-width: 2px;" />
                
                @foreach (var row in reportSection.Rows)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudText Typo="Typo.body2">@row.Label</MudText>
                        <MudText Typo="Typo.body2">@ThaiCurrency.Format(row.Amount, 2)</MudText>
                    </MudStack>
                }
                
                <MudDivider Class="mt-2 mb-1" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1" Style="font-weight: 600;">Total @reportSection.Title</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@ThaiCurrency.Format(reportSection.Total, 2)</MudText>
                </MudStack>
            </div>
        }
        
        <div class="mt-12">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Generated on @_report.GeneratedAt.ToString("f")</MudText>
        </div>
    </MudPaper>
}

@code {
    private bool _isLoading = false;
    private string _selectedReport = "ProfitAndLoss";
    private DateRange _dateRange = new DateRange(DateTime.Today.AddMonths(-1), DateTime.Today);
    private FinancialReportDto? _report;

    private async Task DownloadReport()
    {
        if (_dateRange.Start == null || _dateRange.End == null) return;
        var url = $"api/accounting/reports/{_selectedReport}/download?start={_dateRange.Start:yyyy-MM-dd}&end={_dateRange.End:yyyy-MM-dd}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("print");
    }

    private async Task LoadReport()
    {
        if (_dateRange.Start == null || _dateRange.End == null)
        {
            Snackbar.Add("Please select a date range", Severity.Warning);
            return;
        }

        try
        {
            _isLoading = true;
            _report = await Http.GetFromJsonAsync<FinancialReportDto>($"api/accounting/reports/{_selectedReport}?start={_dateRange.Start:yyyy-MM-dd}&end={_dateRange.End:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
