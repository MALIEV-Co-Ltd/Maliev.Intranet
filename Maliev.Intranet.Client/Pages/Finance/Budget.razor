@page "/finance/budget"
@inject NavigationManager Navigation

<PageTitle>Budget | Intranet Gateway</PageTitle>

@code {
    /// <summary>Redirects legacy /finance/budget URL to the consolidated Accounting page (Budget tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/finance/accounting?tab=budget", replace: true);
    }
}
