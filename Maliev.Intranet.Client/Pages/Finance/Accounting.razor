@page "/finance/accounting"
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Accounting - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4">Accounting</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Financial ledger, reports, and budget management</MudText>
    </div>
</MudStack>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         TabPanelsClass="pt-4" Color="Color.Primary">

    <!-- TAB 0: General Ledger -->
    <MudTabPanel Text="General Ledger" Icon="@Icons.Material.Outlined.AccountBalance">
        <MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudSelect @bind-Value="_ledgerPeriod" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 140px;">
                    <MudSelectItem Value="@("January 2026")">January 2026</MudSelectItem>
                    <MudSelectItem Value="@("December 2025")">December 2025</MudSelectItem>
                    <MudSelectItem Value="@("November 2025")">November 2025</MudSelectItem>
                </MudSelect>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Calculate" OnClick="@LoadTrialBalance">Trial Balance</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download" OnClick="@ExportLedger">Export</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@OpenNewEntryDialog">New Entry</MudButton>
            </MudStack>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Chart of Accounts</MudText>
                    @if (_ledgerLoading)
                    {
                        @for (int i = 0; i < 5; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2 rounded" />
                        }
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            @foreach (var account in _accountsTree)
                            {
                                <MudListItem T="string">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">@account.Code - @account.Name</MudText>
                                            @if (account.Children.Count > 0)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@account.Children.Count sub-accounts</MudText>
                                            }
                                        </div>
                                        <MudText Typo="Typo.subtitle2">@ThaiCurrency.Format(account.Balance, 0)</MudText>
                                    </MudStack>
                                </MudListItem>
                                <MudDivider />
                            }
                            @if (!_accountsTree.Any())
                            {
                                <MudText Typo="Typo.body2" Class="pa-4 text-center mud-text-secondary">No accounts found.</MudText>
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Journal Entries</MudText>
                    @if (_ledgerLoading)
                    {
                        @for (int i = 0; i < 6; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
                        }
                    }
                    else
                    {
                        <MudDataGrid T="JournalEntryDto" Items="@_journalEntries" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                            <Columns>
                                <PropertyColumn Property="x => x.EntryNumber" Title="Entry #" />
                                <PropertyColumn Property="x => x.Date" Title="Date" Format="dd MMM yyyy" />
                                <PropertyColumn Property="x => x.Description" Title="Description" />
                                <PropertyColumn Property="x => x.TotalDebit" Title="Debit" Format="C2" />
                                <PropertyColumn Property="x => x.TotalCredit" Title="Credit" Format="C2" />
                                <TemplateColumn Title="Status">
                                    <CellTemplate>
                                        <MudChip T="string" Size="Size.Small" Color="@GetLedgerStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Actions" Sortable="false">
                                    <CellTemplate>
                                        <MudStack Row="true" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default" OnClick="@(() => ViewJournalEntry(context.Item))" />
                                            @if (context.Item.Status == "Draft")
                                            {
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditJournalEntry(context.Item))" />
                                            }
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <NoRecordsContent>
                                <MudText Class="pa-4 text-center" Color="Color.Secondary">No journal entries found</MudText>
                            </NoRecordsContent>
                        </MudDataGrid>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <!-- TAB 1: Financial Reports -->
    <MudTabPanel Text="Financial Reports" Icon="@Icons.Material.Outlined.Assessment">
        <MudPaper Elevation="0" Class="pa-4 mb-6 border mud-border-lines-default rounded-lg">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudSelect @bind-Value="_selectedReport" Label="Report Type" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 300px;">
                    <MudSelectItem Value="@("ProfitAndLoss")">Profit & Loss</MudSelectItem>
                    <MudSelectItem Value="@("BalanceSheet")">Balance Sheet</MudSelectItem>
                    <MudSelectItem Value="@("CashFlow")">Cash Flow</MudSelectItem>
                </MudSelect>
                <MudDateRangePicker @bind-DateRange="_reportDateRange" Label="Date Range" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="@LoadReport" Disabled="@_reportLoading">Generate Report</MudButton>
                <MudSpacer />
                <MudTooltip Text="Download Report">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload" OnClick="DownloadReport" Disabled="@(_financialReport == null)" />
                </MudTooltip>
            </MudStack>
        </MudPaper>
        @if (_reportLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_financialReport == null)
        {
            <MudAlert Severity="Severity.Info">Select a report and date range to begin.</MudAlert>
        }
        else
        {
            <MudPaper Elevation="0" Class="pa-8 border mud-border-lines-default rounded-lg" Style="max-width: 800px; margin: 0 auto;">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Maliev Platform</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-1">@_financialReport.ReportName</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-8">
                    Period: @(_reportDateRange.Start?.ToString("dd MMM yyyy")) to @(_reportDateRange.End?.ToString("dd MMM yyyy"))
                </MudText>
                @foreach (var reportSection in _financialReport.Sections)
                {
                    <div class="report-section mb-6">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; text-transform: uppercase;">@reportSection.Title</MudText>
                        <MudDivider Class="my-2" Style="border-width: 2px;" />
                        @foreach (var row in reportSection.Rows)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-1">
                                <MudText Typo="Typo.body2">@row.Label</MudText>
                                <MudText Typo="Typo.body2">@row.Amount.ToString("C2")</MudText>
                            </MudStack>
                        }
                        <MudDivider Class="mt-2 mb-1" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body1" Style="font-weight: 600;">Total @reportSection.Title</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight: 600;">@reportSection.Total.ToString("C2")</MudText>
                        </MudStack>
                    </div>
                }
            </MudPaper>
        }
    </MudTabPanel>

    <!-- TAB 2: Budget -->
    <MudTabPanel Text="Budget" Icon="@Icons.Material.Outlined.AttachMoney">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <div>
                <MudText Typo="Typo.h6">Budget Planning</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Annual budget targets vs actual spending</MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudSelect T="string" @bind-Value="_selectedBudgetYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:120px;">
                    <MudSelectItem Value="@("2026")">2026</MudSelectItem>
                    <MudSelectItem Value="@("2025")">2025</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Snackbar.Add("Budget entry creation coming soon", Severity.Info))">
                    New Budget Entry
                </MudButton>
            </MudStack>
        </MudStack>

        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Budget</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:600;">฿0</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">FY @_selectedBudgetYear</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Actual Spent</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Warning">฿0</MudText>
                    <MudProgressLinear Value="0" Color="Color.Warning" Class="mt-2" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Remaining</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:600;" Color="Color.Success">฿0</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">0% utilised</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
            <MudDataGrid T="BudgetCategoryModel" Items="@_budgetCategories" Dense="true" Hover="true" Elevation="0">
                <Columns>
                    <PropertyColumn Property="x => x.Category" Title="Category" />
                    <PropertyColumn Property="x => x.Department" Title="Department" />
                    <TemplateColumn Title="Budget (THB)">
                        <CellTemplate><MudText Typo="Typo.body2">฿@context.Item.BudgetAmount.ToString("N0")</MudText></CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Actual (THB)">
                        <CellTemplate><MudText Typo="Typo.body2">฿@context.Item.ActualAmount.ToString("N0")</MudText></CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Variance">
                        <CellTemplate>
                            @{ var variance = context.Item.BudgetAmount - context.Item.ActualAmount; }
                            <MudText Typo="Typo.body2" Color="@(variance >= 0 ? Color.Success : Color.Error)">฿@variance.ToString("N0")</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Utilisation">
                        <CellTemplate>
                            @{ var pct = context.Item.BudgetAmount > 0 ? context.Item.ActualAmount / context.Item.BudgetAmount * 100 : 0; }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressLinear Color="@(pct > 100 ? Color.Error : pct > 80 ? Color.Warning : Color.Success)" Value="@Math.Min(100, (double)pct)" Style="min-width:80px;" Size="Size.Small" />
                                <MudText Typo="Typo.caption">@pct.ToString("N0")%</MudText>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Sortable="false">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Snackbar.Add("Budget editing coming soon", Severity.Info))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Size="Size.Large" Color="Color.Secondary" Style="font-size:60px;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No budget entries</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Budget data will appear here once configured</MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudPaper>
    </MudTabPanel>

    <!-- TAB 3: Report Builder -->
    <MudTabPanel Text="Report Builder" Icon="@Icons.Material.Outlined.Build">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-4">Report Configuration</MudText>
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_builderReportName" Label="Report Name" Variant="Variant.Outlined" Placeholder="My Custom Report" />
                        <MudSelect T="string" @bind-Value="_builderReportType" Label="Report Type" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("table")">Table</MudSelectItem>
                            <MudSelectItem Value="@("chart")">Chart</MudSelectItem>
                            <MudSelectItem Value="@("summary")">Summary Cards</MudSelectItem>
                        </MudSelect>
                        <MudText Typo="Typo.subtitle2">Date Range</MudText>
                        <MudDateRangePicker @bind-DateRange="_builderDateRange" Variant="Variant.Outlined" />
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Metrics</MudText>
                        @foreach (var metric in _availableMetrics)
                        {
                            <MudCheckBox T="bool" Value="@_selectedMetrics.Contains(metric)"
                                         ValueChanged="@((v) => ToggleMetric(metric, v))"
                                         Label="@metric" Color="Color.Primary" />
                        }
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Group By</MudText>
                        <MudSelect T="string" @bind-Value="_builderGroupBy" Label="Dimension" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("")">None</MudSelectItem>
                            <MudSelectItem Value="@("month")">Month</MudSelectItem>
                            <MudSelectItem Value="@("quarter")">Quarter</MudSelectItem>
                            <MudSelectItem Value="@("customer")">Customer</MudSelectItem>
                            <MudSelectItem Value="@("department")">Department</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunBuilderReport">Run Report</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => Snackbar.Add("Save report template coming soon", Severity.Info))">Save Template</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg" Style="min-height:500px;">
                    @if (!_builderHasRun)
                    {
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:400px;">
                            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Large" Color="Color.Secondary" Style="font-size:80px;" />
                            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">Configure and run your report</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Select metrics and click "Run Report" to see results</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                            <MudText Typo="Typo.h6">@(_builderReportName.Length > 0 ? _builderReportName : "Custom Report")</MudText>
                        </MudStack>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                            Report preview requires backend integration. Selected metrics: @string.Join(", ", _selectedMetrics).
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab = 0;

    // ─── General Ledger ────────────────────────────────────────────────────────
    private bool _ledgerLoading = true;
    private string _ledgerPeriod = "January 2026";
    private List<ChartOfAccountDto> _accountsTree = new();
    private List<JournalEntryDto> _journalEntries = new();

    // ─── Financial Reports ────────────────────────────────────────────────────
    private bool _reportLoading = false;
    private string _selectedReport = "ProfitAndLoss";
    private DateRange _reportDateRange = new DateRange(DateTime.Today.AddMonths(-1), DateTime.Today);
    private FinancialReportDto? _financialReport;

    // ─── Budget ───────────────────────────────────────────────────────────────
    private string _selectedBudgetYear = "2026";
    private List<BudgetCategoryModel> _budgetCategories = new();

    // ─── Report Builder ───────────────────────────────────────────────────────
    private string _builderReportName = string.Empty;
    private string _builderReportType = "table";
    private string _builderGroupBy = "";
    private bool _builderHasRun = false;
    private DateRange _builderDateRange = new DateRange(DateTime.Today.AddMonths(-1), DateTime.Today);
    private HashSet<string> _selectedMetrics = new() { "Revenue", "Orders" };

    private readonly List<string> _availableMetrics = new()
    {
        "Revenue", "Orders", "Invoices", "Payments",
        "Customers", "New Customers", "Headcount", "Materials Used"
    };

    /// <summary>
    /// Initializes the accounting page, checking URL tab query parameter and loading ledger data.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _activeTab = query["tab"] switch
        {
            "ledger" => 0,
            "reports" => 1,
            "budget" => 2,
            "builder" => 3,
            _ => 0
        };

        await LoadLedgerData();
    }

    private async Task LoadLedgerData()
    {
        try
        {
            _ledgerLoading = true;
            var accountsTask = Http.GetFromJsonAsync<List<ChartOfAccountDto>>("api/accounting/accounts-tree");
            var entriesTask = Http.GetFromJsonAsync<PagedResponse<JournalEntryDto>>("api/accounting/journal-entries");
            await Task.WhenAll(accountsTask, entriesTask);
            _accountsTree = await accountsTask ?? new();
            var response = await entriesTask;
            _journalEntries = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ledger data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ledgerLoading = false;
        }
    }

    private async Task OpenNewEntryDialog()
    {
        var parameters = new DialogParameters<JournalEntryDialog> { { x => x.Accounts, _accountsTree } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<JournalEntryDialog>("New Journal Entry", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadLedgerData();
            Snackbar.Add("Journal entry created", Severity.Success);
        }
    }

    private async Task ViewJournalEntry(JournalEntryDto entry)
    {
        var parameters = new DialogParameters<JournalEntryDialog>
        {
            { x => x.ExistingEntry, entry },
            { x => x.Accounts, _accountsTree },
            { x => x.IsReadOnly, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<JournalEntryDialog>($"Journal Entry {entry.EntryNumber}", parameters, options);
    }

    private async Task EditJournalEntry(JournalEntryDto entry)
    {
        if (entry.Status != "Draft") { Snackbar.Add("Only Draft entries can be edited", Severity.Warning); return; }
        var parameters = new DialogParameters<JournalEntryDialog>
        {
            { x => x.ExistingEntry, entry },
            { x => x.Accounts, _accountsTree },
            { x => x.IsReadOnly, false }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<JournalEntryDialog>($"Edit Entry {entry.EntryNumber}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) { await LoadLedgerData(); Snackbar.Add("Journal entry updated", Severity.Success); }
    }

    private async Task LoadTrialBalance()
    {
        try
        {
            var now = DateTime.Today;
            var start = new DateTime(now.Year, now.Month, 1);
            var end = start.AddMonths(1).AddDays(-1);
            var report = await Http.GetFromJsonAsync<FinancialReportDto>($"api/accounting/reports/TrialBalance?start={start:yyyy-MM-dd}&end={end:yyyy-MM-dd}");
            if (report != null)
            {
                var parameters = new DialogParameters<TrialBalanceDialog> { { x => x.Report, report } };
                var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
                await DialogService.ShowAsync<TrialBalanceDialog>("Trial Balance", parameters, options);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load trial balance: {ex.Message}", Severity.Error); }
    }

    private async Task ExportLedger()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"MALIEV General Ledger - {_ledgerPeriod}");
            sb.AppendLine($"Exported: {DateTime.Now:f}");
            sb.AppendLine();
            foreach (var entry in _journalEntries)
                sb.AppendLine($"{entry.EntryNumber,-12} {entry.Date:dd MMM yyyy,-15} {entry.Description,-30} {entry.TotalDebit,12:N2} {entry.TotalCredit,12:N2} {entry.Status,-10}");
            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("eval", $"const l=document.createElement('a');l.href='data:text/plain;charset=utf-8;base64,{base64}';l.download='ledger-{DateTime.Now:yyyyMMdd}.csv';l.click();");
            Snackbar.Add("Ledger exported successfully", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Export failed: {ex.Message}", Severity.Error); }
    }

    private async Task LoadReport()
    {
        if (_reportDateRange.Start == null || _reportDateRange.End == null) { Snackbar.Add("Please select a date range", Severity.Warning); return; }
        try
        {
            _reportLoading = true;
            _financialReport = await Http.GetFromJsonAsync<FinancialReportDto>($"api/accounting/reports/{_selectedReport}?start={_reportDateRange.Start:yyyy-MM-dd}&end={_reportDateRange.End:yyyy-MM-dd}");
        }
        catch (Exception ex) { Snackbar.Add($"Error generating report: {ex.Message}", Severity.Error); }
        finally { _reportLoading = false; }
    }

    private async Task DownloadReport()
    {
        if (_financialReport == null) return;
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"MALIEV - {_financialReport.ReportName}");
            foreach (var reportSection in _financialReport.Sections)
            {
                sb.AppendLine(reportSection.Title.ToUpper());
                foreach (var row in reportSection.Rows) sb.AppendLine($"{row.Label,-40} {row.Amount,12:C2}");
                sb.AppendLine($"{"Total " + reportSection.Title,-40} {reportSection.Total,12:C2}");
            }
            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            await JSRuntime.InvokeVoidAsync("eval", $"const l=document.createElement('a');l.href='data:text/plain;base64,{base64}';l.download='report-{_selectedReport}-{DateTime.Now:yyyyMMdd}.txt';l.click();");
            Snackbar.Add("Report downloaded", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Download failed: {ex.Message}", Severity.Error); }
    }

    private void ToggleMetric(string metric, bool selected)
    {
        if (selected) _selectedMetrics.Add(metric);
        else _selectedMetrics.Remove(metric);
    }

    private void RunBuilderReport()
    {
        if (!_selectedMetrics.Any()) { Snackbar.Add("Please select at least one metric", Severity.Warning); return; }
        _builderHasRun = true;
    }

    private Color GetLedgerStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Posted" => Color.Success,
        "Void" => Color.Error,
        _ => Color.Default
    };

    /// <summary>Budget category model for the budget planning tab.</summary>
    private class BudgetCategoryModel
    {
        /// <summary>Gets or sets the budget category name.</summary>
        public string Category { get; set; } = string.Empty;
        /// <summary>Gets or sets the department.</summary>
        public string Department { get; set; } = string.Empty;
        /// <summary>Gets or sets the budget amount in THB.</summary>
        public decimal BudgetAmount { get; set; }
        /// <summary>Gets or sets the actual amount spent in THB.</summary>
        public decimal ActualAmount { get; set; }
    }
}
