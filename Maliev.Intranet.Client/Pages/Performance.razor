@page "/hr/performance"
<PageTitle>Performance | Intranet Gateway</PageTitle>
@inject NavigationManager Navigation

@code {
    /// <summary>Redirects legacy /hr/performance route to the consolidated Training and Performance page (Performance tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/hr/training?tab=performance", replace: true);
    }
}
