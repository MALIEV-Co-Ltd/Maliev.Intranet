@page "/mfg/procurement"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Procurement - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Purchase Orders</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search POs..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@OpenCreatePoDialog">
            Create PO
        </MudButton>
    </MudStack>
</MudPaper>

    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="false" TabPanelsClass="pa-0" Class="border-b mud-border-lines-default">
        <MudTabPanel Text="Active" Icon="@Icons.Material.Outlined.LocalShipping" BadgeData="@(_purchaseOrders.Count(x => x.Status == "Ordered" || x.Status == "Approved") > 0 ? _purchaseOrders.Count(x => x.Status == "Ordered" || x.Status == "Approved") : null)" BadgeColor="Color.Primary" />
        <MudTabPanel Text="Draft" Icon="@Icons.Material.Outlined.Edit" BadgeData="@(_purchaseOrders.Count(x => x.Status == "Draft") > 0 ? _purchaseOrders.Count(x => x.Status == "Draft") : null)" BadgeColor="Color.Default" />
        <MudTabPanel Text="History" Icon="@Icons.Material.Outlined.History" />
    </MudTabs>

    @if (_isLoading)
    {
        <div class="pa-4">
            @for (int i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
            }
        </div>
    }
    else
    {
        <MudDataGrid T="PurchaseOrderDto" Items="@FilteredOrders" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.PoNumber" Title="PO #" />
                <PropertyColumn Property="x => x.SupplierName" Title="Supplier" />
                <PropertyColumn Property="x => x.ItemsCount" Title="Items" />
                <PropertyColumn Property="x => x.TotalValue" Title="Total" Format="C2" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CreatedDate" Title="Created" Format="dd MMM yyyy" />
                <PropertyColumn Property="x => x.ExpectedDelivery" Title="Expected" Format="dd MMM yyyy" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => ViewDetails(context.Item))" />
                            @if (context.Item.Status == "Draft")
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Color="Color.Success" OnClick="@(() => ApprovePo(context.Item))" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Secondary">No purchase orders found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private int _activeTab = 0;
    private List<PurchaseOrderDto> _purchaseOrders = new();

    private IEnumerable<PurchaseOrderDto> FilteredOrders
    {
        get
        {
            IEnumerable<PurchaseOrderDto> tabFiltered = _activeTab switch
            {
                0 => _purchaseOrders.Where(x => x.Status == "Ordered" || x.Status == "Approved"),
                1 => _purchaseOrders.Where(x => x.Status == "Draft" || x.Status == "Pending Approval"),
                2 => _purchaseOrders.Where(x => x.Status == "Received" || x.Status == "Cancelled"),
                _ => _purchaseOrders
            };
            if (string.IsNullOrEmpty(_searchString))
                return tabFiltered;
            return tabFiltered.Where(x =>
                x.PoNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.SupplierName.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<PurchaseOrderDto>>("api/procurement");
            _purchaseOrders = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading procurement data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ViewDetails(PurchaseOrderDto po)
    {
        var parameters = new DialogParameters<PurchaseOrderDetailDialog>
        {
            { x => x.PurchaseOrderId, po.Id }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<PurchaseOrderDetailDialog>($"PO {po.PoNumber}", parameters, options);
    }

    private async Task OpenCreatePoDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreatePurchaseOrderDialog>("Create Purchase Order", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadData();
            Snackbar.Add("Purchase order created", Severity.Success);
        }
    }

    private async Task ApprovePo(PurchaseOrderDto po)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Approve PO", $"Approve purchase order {po.PoNumber}?", yesText: "Approve", noText: "Cancel");
        if (confirm != true) return;
        try
        {
            var response = await Http.PatchAsync($"api/procurement/{po.Id}/approve", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"PO {po.PoNumber} approved", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Approval failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Pending Approval" => Color.Warning,
        "Approved" => Color.Info,
        "Ordered" => Color.Primary,
        "Partial" => Color.Warning,
        "Received" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}

