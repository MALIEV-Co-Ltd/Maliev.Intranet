    private string NextCustomerEmailTemplateKey()
    {
        var suffix = DateTimeOffset.UtcNow.ToString("yyyyMMddHHmmss");
        return $"customer-email-{suffix}";
    }

    private static string NormalizeTemplateKey(string value)
    {
        var key = value.Trim().ToLowerInvariant();
        var builder = new System.Text.StringBuilder(key.Length);
        var previousHyphen = false;
        foreach (var character in key)
        {
            if (char.IsAsciiLetterOrDigit(character))
            {
                builder.Append(character);
                previousHyphen = false;
            }
            else if (!previousHyphen)
            {
                builder.Append('-');
                previousHyphen = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private static bool IsTemplateKeyValid(string key) =>
        key.Length >= 3 &&
        char.IsAsciiLetterLower(key[0]) &&
        key.All(character => char.IsAsciiLetterLower(character) || char.IsAsciiDigit(character) || character == '-');

