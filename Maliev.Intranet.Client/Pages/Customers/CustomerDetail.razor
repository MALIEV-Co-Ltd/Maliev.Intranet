    private async Task SaveCompanyAsync()
    {
        if (_companyEdit is null || _edit is null)
        {
            return;
        }

        try
        {
            Guid? companyId = _companyEdit.ExistingCompanyId;
            if (companyId is null)
            {
                if (string.IsNullOrWhiteSpace(_companyEdit.Name))
                {
                    Snackbar.Add("Company name is required.", Severity.Warning);
                    return;
                }

                var response = await Http.PostAsJsonAsync("api/v1/companies", _companyEdit.ToCreateRequest());
                if (!response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Company could not be created.", Severity.Warning);
                    return;
                }

                var created = await response.Content.ReadFromJsonAsync<CompanyResponse>();
                companyId = created?.Id;
            }

            if (companyId is null)
            {
                Snackbar.Add("Select or create a company before linking.", Severity.Warning);
                return;
            }

            _edit.CompanyId = companyId;
            _edit.Company = _companyEdit.Name;
            if (await SaveCustomerCoreAsync())
            {
                _companyEdit = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Company could not be linked.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private static (string FirstName, string LastName) SplitName(string fullName)
    {
        var parts = fullName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => (string.Empty, string.Empty),
            1 => (parts[0], string.Empty),
            _ => (parts[0], parts[1])
        };
    }

    private static bool IsAddressType(AddressResponse address, string type) =>
        string.Equals(address.Type, type, StringComparison.OrdinalIgnoreCase);

    private static string AddressName(AddressResponse address, string fallback) =>
        string.IsNullOrWhiteSpace(address.RecipientName) ? fallback : address.RecipientName;

    private static IReadOnlyList<string> FormatAddressLines(AddressResponse address)
    {
        var street = string.Join(", ", new[] { address.AddressLine1, address.AddressLine2, address.AddressLine3 }
            .Where(part => !string.IsNullOrWhiteSpace(part)));
        var locality = string.Join(", ", new[] { address.District, address.City, address.StateProvince, address.PostalCode }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

        return new[] { street, locality }
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();
    }

    private static string FormatAddress(AddressResponse address) =>
        string.Join(", ", FormatAddressLines(address));

    private Guid DefaultCountryId() =>
        _countries.FirstOrDefault(country => string.Equals(country.Code, "TH", StringComparison.OrdinalIgnoreCase))?.Id
        ?? _countries.FirstOrDefault(country => country.Name.Contains("Thailand", StringComparison.OrdinalIgnoreCase))?.Id
        ?? _countries.FirstOrDefault()?.Id
        ?? Guid.Empty;

    private static string FormatLocation(RegistryThaiLocation location) =>
        string.Join(", ", new[]
        {
            ChooseText(location.SubDistrictEn, location.SubDistrictTh),
            ChooseText(location.DistrictEn, location.DistrictTh),
            ChooseText(location.ProvinceEn, location.ProvinceTh),
            location.PostalCode
        }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private static string ChooseText(string? english, string? fallback) =>
        !string.IsNullOrWhiteSpace(english) ? english : fallback ?? string.Empty;

    private static decimal ResolveOrderTotal(OrderSummaryDto order) =>
        order.TotalAmount > 0 ? order.TotalAmount : order.Total;

    private static string FormatMoney(decimal value) => value.ToString("$#,0.##");

    private string ResolveAccountManagerName(Guid? employeeId)
    {
        if (employeeId is null)
        {
            return "Unassigned";
        }

        var employee = _accountManagers.FirstOrDefault(item => item.Id == employeeId.Value);
        if (employee is not null)
        {
            return FormatEmployeeOption(employee);
        }

        return _customer?.AccountManagerName ?? $"Employee {employeeId.Value.ToString("N")[..8].ToUpperInvariant()}";
    }

    private static string FormatEmployeeOption(EmployeeSummaryDto employee)
    {
        var name = string.IsNullOrWhiteSpace(employee.Name) ? employee.Email : employee.Name;
        if (string.IsNullOrWhiteSpace(employee.Title))
        {
            return name;
        }

        return $"{name} - {employee.Title}";
    }

    private static string FormatDate(DateTime value) => value == default ? "-" : value.ToString("MMM dd, yyyy");

    private static string FormatMonthYear(DateTime value) => value == default ? "-" : value.ToString("MMM yyyy");

    private static string FormatDateTime(DateTime value) => value == default ? "-" : value.ToString("MMM dd, yyyy HH:mm");

    private static string ActivityIcon(string action)
    {
        if (action.Contains("order", StringComparison.OrdinalIgnoreCase) || action.Contains("paid", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.Material.Outlined.AttachMoney;
        }

        if (action.Contains("note", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.Material.Outlined.Edit;
        }

        if (action.Contains("email", StringComparison.OrdinalIgnoreCase) || action.Contains("invoice", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.Material.Outlined.AlternateEmail;
        }

        return Icons.Material.Outlined.Update;
    }

