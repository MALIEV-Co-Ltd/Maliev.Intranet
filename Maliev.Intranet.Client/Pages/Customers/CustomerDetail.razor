                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.City))" />
                            @if (ShouldShowAddressSuggestions(AddressField.City))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>Sub District</span>
                            <input class="customer-input"
                                   value="@_addressEdit.District"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.District, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.District))" />
                            @if (ShouldShowAddressSuggestions(AddressField.District))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>Province</span>
                            <input class="customer-input"
                                   value="@_addressEdit.StateProvince"
                                   disabled="@AddressProvinceLocked"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.StateProvince, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.StateProvince))" />
                            @if (ShouldShowAddressSuggestions(AddressField.StateProvince))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>Postal</span>
                            <input class="customer-input"
                                   value="@_addressEdit.PostalCode"
                                   disabled="@AddressPostalCodeLocked"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.PostalCode, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.PostalCode))" />
                            @if (ShouldShowAddressSuggestions(AddressField.PostalCode))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field">
                            <span>Country</span>
                            <select class="customer-input" @bind="_addressEdit.CountryId">
                                <option value="@Guid.Empty">Select country</option>
                                @foreach (var country in _countries)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            </select>
                        </label>
                        <label class="customer-checkbox-row customer-span-2">
                            <input type="checkbox" @bind="_addressEdit.IsDefault" />
                            <span>Default for this address type</span>
                        </label>
                    </div>
                </div>
                <aside class="customer-address-lookup-panel">
                    <label class="customer-field">
                        <span class="customer-address-lookup-label">
                            <span>AI address lookup</span>
                            <span class="customer-address-lookup-pill">Plain text ok</span>
                        </span>
                        <textarea class="customer-textarea customer-address-lookup-input"
                                  placeholder="Paste a full address, tax invoice address, copied map text, or delivery note..."
                                  @bind="_addressLookupQuery"
                                  @bind:event="oninput"></textarea>
                    </label>
                    <button type="button" class="customer-inline-action customer-address-search" @onclick="SearchLocationsAsync" disabled="@_addressLookupLoading">
                        @(_addressLookupLoading ? "Structuring..." : "Extract & search")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_addressLookupMessage))
                    {
                        <div class="@AddressLookupStateClass">@_addressLookupMessage</div>
                    }
                    @if (_locationMatches.Count > 0)
                    {
                        <div class="customer-result-list customer-address-result-list">
                            @foreach (var location in _locationMatches)
                            {
                                <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressLookupLanguage))">
                                    <strong>@FormatLocationPrimary(location, _addressLookupLanguage)</strong>
                                    <span>@FormatLocationSecondary(location, _addressLookupLanguage)</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="customer-address-map-panel">
                        <div id="@AddressMapElementId" class="customer-address-map"></div>
                        <div class="customer-address-map-caption">
                            @(_addressMapLocation?.DisplayName ?? "Select an address result to show the map location.")
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    }
</ConfirmModal>

<ConfirmModal Open="@(_companyEdit is not null)"
              Title="Link company"
              ConfirmLabel="@CompanyConfirmLabel"
              ConfirmDisabled="@CompanyConfirmDisabled"
              ConfirmButtonClass="customer-company-save"
              Class="customer-modal-wide"
              OnCancel="CloseCompanyModalAsync"
              OnConfirm="SaveCompanyAsync">
    @if (_companyEdit is not null)
    {
        <div class="customer-address-form">
            <div class="customer-form-grid">
                <label class="customer-field customer-span-2">
                    <span>Company lookup</span>
                    <div class="customer-split-field">
                        <input class="customer-input" placeholder="Name or tax ID..." @bind="_companyLookupQuery" @bind:event="oninput" />
