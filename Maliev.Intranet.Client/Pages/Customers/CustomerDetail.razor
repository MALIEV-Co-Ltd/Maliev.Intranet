    private async Task SaveCompanyAsync()
    {
        if (_savingCompany || _companyEdit is null || _edit is null)
        {
            return;
        }

        _savingCompany = true;
        try
        {
            Guid? companyId = _companyEdit.ExistingCompanyId;
            if (companyId is null)
            {
                if (string.IsNullOrWhiteSpace(_companyEdit.Name))
                {
                    Snackbar.Add("Company name is required.", Severity.Warning);
                    return;
                }

                companyId = await TryResolveExistingCompanyByTaxIdAsync(_companyEdit);
                if (companyId is null)
                {
                    var response = await Http.PostAsJsonAsync("api/v1/companies", _companyEdit.ToCreateRequest());
                    if (!response.IsSuccessStatusCode)
                    {
                        companyId = await TryResolveExistingCompanyByTaxIdAsync(_companyEdit);
                        if (companyId is null)
                        {
                            Snackbar.Add("Company could not be created.", Severity.Warning);
                            return;
                        }
                    }

                    if (companyId is null)
                    {
                        var created = await response.Content.ReadFromJsonAsync<CompanyResponse>();
                        companyId = created?.Id;
                    }
                }
            }

            if (companyId is null)
            {
                Snackbar.Add("Select or create a company before linking.", Severity.Warning);
                return;
            }

            _edit.CompanyId = companyId;
            _edit.Company = _companyEdit.Name;
            if (await SaveCustomerCoreAsync())
            {
                _companyEdit = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Company could not be linked.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _savingCompany = false;
        }
    }

    private async Task<Guid?> TryResolveExistingCompanyByTaxIdAsync(CompanyEditModel company)
    {
        var taxId = NormalizeCompanyTaxId(company.VatNumber);
        if (string.IsNullOrWhiteSpace(taxId))
        {
            taxId = NormalizeCompanyTaxId(company.RegistrationNumber);
        }

        if (string.IsNullOrWhiteSpace(taxId))
        {
            return null;
        }

        try
        {
            var matches = await Http.GetFromJsonAsync<List<CompanySearchResultDto>>($"api/v1/companies/search?query={Uri.EscapeDataString(taxId)}&limit=8") ?? [];
            var match = matches.FirstOrDefault(candidate =>
                candidate.Id is Guid &&
                (CompanyTaxMatches(candidate.VatNumber, taxId) || CompanyTaxMatches(candidate.RegistrationNumber, taxId)));

            if (match?.Id is Guid id)
            {
                ApplyCompany(match);
                return id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        return null;
    }

    private static bool CompanyTaxMatches(string? value, string normalizedTaxId) =>
        string.Equals(NormalizeCompanyTaxId(value), normalizedTaxId, StringComparison.OrdinalIgnoreCase);

    private static string NormalizeCompanyTaxId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var digits = new string(value.Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? value.Trim().ToUpperInvariant() : digits;
    }

    private static (string FirstName, string LastName) SplitName(string fullName)
    {
        var parts = fullName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => (string.Empty, string.Empty),
            1 => (parts[0], string.Empty),
            _ => (parts[0], parts[1])
        };
    }

