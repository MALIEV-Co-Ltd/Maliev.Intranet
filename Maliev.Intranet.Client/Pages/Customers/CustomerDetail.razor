            || string.Equals(AddressSource, "GoogleMapPin", StringComparison.OrdinalIgnoreCase);

        public static AddressEditModel Create(Guid countryId, string recipientName) => new()
        {
            Label = recipientName,
            CountryId = countryId,
            IsDefault = true
        };

        public static AddressEditModel FromAddress(AddressResponse address) => new()
        {
            Id = address.Id,
            Label = AddressName(address, address.Type),
            Type = string.IsNullOrWhiteSpace(address.Type) ? "Billing" : address.Type,
            IsDefault = address.IsDefault,
            PlaceLabel = string.IsNullOrWhiteSpace(address.PlaceLabel) ? "Home" : address.PlaceLabel,
            PlaceLabelOther = address.PlaceLabelOther,
            AddressLine1 = address.AddressLine1,
            AddressLine2 = address.AddressLine2,
            District = address.District,
            City = address.City,
            StateProvince = address.StateProvince,
            PostalCode = address.PostalCode,
            CountryId = address.CountryId,
            RecipientPhone = address.RecipientPhone,
            DriverNote = address.DriverNote,
            AddressSource = string.IsNullOrWhiteSpace(address.AddressSource) ? "Manual" : address.AddressSource,
            GooglePlaceId = address.GooglePlaceId,
            FormattedAddress = address.FormattedAddress,
            Latitude = address.Latitude,
            Longitude = address.Longitude,
            Version = address.Version,
            Xmin = address.Xmin
        };
    }

    private sealed class CompanyEditModel
    {
        public Guid? ExistingCompanyId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? VatNumber { get; set; }
        public string? RegistrationNumber { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
        public string Segment { get; set; } = "Retail";
        public string Tier { get; set; } = "Bronze";
        public string? FullNameTh { get; set; }
        public string? CompanyStatus { get; set; }
        public string? CompanyStatusNameTh { get; set; }
        public string? CompanyTypeCode { get; set; }
        public string? BusinessObjectives { get; set; }
        public bool IsVerifiedFromBdex { get; set; }

        public static CompanyEditModel FromCustomer(CustomerDetailDto? customer) => new()
        {
            ExistingCompanyId = customer?.CompanyId,
            Name = customer?.CompanyName ?? string.Empty,
            VatNumber = customer?.CompanyVatNumber,
            RegistrationNumber = customer?.CompanyRegistrationNumber,
            ContactEmail = customer?.CompanyContactEmail,
            ContactPhone = customer?.CompanyPhone,
            Segment = customer?.CompanySegment ?? "Retail",
            Tier = customer?.CompanyTier ?? "Bronze"
        };

        public CreateCompanyRequest ToCreateRequest() => new()
        {
            Name = Name.Trim(),
            VatNumber = string.IsNullOrWhiteSpace(VatNumber) ? null : VatNumber.Trim(),
            RegistrationNumber = string.IsNullOrWhiteSpace(RegistrationNumber) ? null : RegistrationNumber.Trim(),
            ContactEmail = string.IsNullOrWhiteSpace(ContactEmail) ? null : ContactEmail.Trim(),
            ContactPhone = string.IsNullOrWhiteSpace(ContactPhone) ? null : ContactPhone.Trim(),
            Segment = Segment,
            Tier = Tier,
            FullNameTh = FullNameTh,
            CompanyStatus = CompanyStatus,
            CompanyStatusNameTh = CompanyStatusNameTh,
            CompanyTypeCode = CompanyTypeCode,
            BusinessObjectives = BusinessObjectives,
            IsVerifiedFromBdex = IsVerifiedFromBdex
        };
    }
