        string.Join(", ", new[]
        {
            ChooseLocationText(location.SubDistrictTh, location.SubDistrictEn, language),
            ChooseLocationText(location.DistrictTh, location.DistrictEn, language),
            ChooseLocationText(location.ProvinceTh, location.ProvinceEn, language),
            location.PostalCode
        }.Where(part => !string.IsNullOrWhiteSpace(part)));

