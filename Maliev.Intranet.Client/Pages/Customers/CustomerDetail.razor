    private static string ChooseLocationText(string? thai, string? english, AddressLanguage language) =>
        language == AddressLanguage.Thai
            ? ChooseText(thai, english)
            : ChooseText(english, thai);

    private static string ChooseText(string? english, string? fallback) =>
        !string.IsNullOrWhiteSpace(english) ? english : fallback ?? string.Empty;

    private AddressLanguage DetectAddressLanguage(string? value)
    {
        if (ContainsThai(value))
        {
            return AddressLanguage.Thai;
        }

        if (value?.Any(c => c is >= 'A' and <= 'Z' or >= 'a' and <= 'z') == true)
        {
            return AddressLanguage.English;
        }

        return DetectAddressLanguageFromAddress();
    }

    private AddressLanguage DetectAddressLanguageFromAddress() =>
        ContainsThai(_addressEdit?.District) || ContainsThai(_addressEdit?.City) || ContainsThai(_addressEdit?.StateProvince)
            ? AddressLanguage.Thai
            : AddressLanguage.English;

    private static bool ContainsThai(string? value) =>
        value?.Any(c => c >= 0x0E00 && c <= 0x0E7F) == true;

