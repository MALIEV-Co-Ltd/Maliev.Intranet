    private string ResolveAccountManagerName(Guid? employeeId)
    {
        if (employeeId is null)
        {
            return "Unassigned";
        }

        var employee = _accountManagers.FirstOrDefault(item => item.Id == employeeId.Value);
        if (employee is not null)
        {
            return FormatEmployeeOption(employee);
        }

        return _customer?.AccountManagerName ?? $"Employee {employeeId.Value.ToString("N")[..8].ToUpperInvariant()}";
    }

    private static string FormatEmployeeOption(EmployeeSummaryDto employee)
    {
        var name = string.IsNullOrWhiteSpace(employee.Name) ? employee.Email : employee.Name;
        if (string.IsNullOrWhiteSpace(employee.Title))
        {
            return name;
        }

        return $"{name} - {employee.Title}";
    }

