    private AddressLanguage DetectAddressLanguage(string? value)
    {
        if (ContainsThai(value))
        {
            return AddressLanguage.Thai;
        }

        if (value?.Any(c => c is >= 'A' and <= 'Z' or >= 'a' and <= 'z') == true)
        {
            return AddressLanguage.English;
        }

        return DetectAddressLanguageFromAddress();
    }

    private AddressLanguage DetectAddressLanguageFromAddress() =>
        ContainsThai(_addressEdit?.District) || ContainsThai(_addressEdit?.City) || ContainsThai(_addressEdit?.StateProvince)
