    private static string PaymentTermSummary(PaymentTermDto term)
    {
        var category = string.IsNullOrWhiteSpace(term.Category) ? "Term" : term.Category;
        var timing = term.DiscountPercent is decimal discountPercent && term.DiscountDays is int discountDays
            ? $"{discountPercent:0.##}% discount within {discountDays} days"
            : term.DueDays is int dueDays
                ? dueDays == 0 ? "Due immediately" : $"Due in {dueDays} days"
                : "Negotiated schedule";

        return $"{category} - {timing}";
    }

