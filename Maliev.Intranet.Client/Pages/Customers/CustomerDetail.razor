                            </label>
                        }
                        <label class="customer-field">
                            <span>Recipient name</span>
                            <input class="customer-input" @bind="_addressEdit.Label" @bind:event="oninput" />
                        </label>
                        <label class="customer-field">
                            <span>Mobile Number</span>
                            <input class="customer-contact-input" @bind="_addressEdit.RecipientPhone" @bind:event="oninput" />
                        </label>
                        <label class="customer-field customer-span-2">
                            <span>Note to driver</span>
                            <textarea class="customer-textarea" @bind="_addressEdit.DriverNote" @bind:event="oninput"></textarea>
                        </label>
                        <label class="customer-field">
                            <span>Type</span>
                            <select class="customer-input" @bind="_addressEdit.Type">
                                <option>Billing</option>
                                <option>Shipping</option>
                            </select>
                        </label>
                        <label class="customer-field customer-span-2">
                            <span>Address No./Moo/Soi/Road</span>
                            <input class="customer-input" @bind="_addressEdit.AddressLine1" @bind:event="oninput" />
                        </label>
                        <label class="customer-field customer-span-2">
                            <span>Street 2</span>
                            <input class="customer-input" @bind="_addressEdit.AddressLine2" @bind:event="oninput" />
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>City</span>
                            <input class="customer-input"
