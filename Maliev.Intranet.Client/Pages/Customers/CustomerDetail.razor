@page "/customers/{Id:guid}"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@((_customer?.Name ?? "Customer") + " | MALIEV Intranet")</PageTitle>

<div class="mlv-module-shell customer-record-shell">
    <PageHeader Title="@(_customer?.Name ?? "Customer")" Subtitle="@(_customer?.CompanyName ?? _customer?.Email)" BackLabel="Customers" BackHref="/customers">
        @if (_customer is not null)
        {
            <SecondaryButton Class="customer-email-open" Icon="@Icons.Material.Outlined.Email" OnClick="OpenEmailComposerAsync" Disabled="@(_sendingEmail || string.IsNullOrWhiteSpace(_customer.Email))">Send email</SecondaryButton>
            <SecondaryButton OnClick="DiscardChangesAsync" Disabled="@_saving">Discard</SecondaryButton>
            <PrimaryButton Icon="@Icons.Material.Outlined.Check" OnClick="SaveCustomerAsync" Disabled="@_saving">Save</PrimaryButton>
        }
    </PageHeader>

    <nav class="customer-record-tabs" aria-label="Customer sections">
        <button type="button" data-tab="overview" class="@TabClass(CustomerDetailTab.Overview)" aria-current="@TabCurrent(CustomerDetailTab.Overview)" @onclick="@(() => SelectTab(CustomerDetailTab.Overview))">Overview</button>
        <button type="button" data-tab="addresses" class="@TabClass(CustomerDetailTab.Addresses)" aria-current="@TabCurrent(CustomerDetailTab.Addresses)" @onclick="@(() => SelectTab(CustomerDetailTab.Addresses))">Addresses (@(_customer?.Addresses.Count ?? 0))</button>
        <button type="button" data-tab="projects" class="@TabClass(CustomerDetailTab.Projects)" aria-current="@TabCurrent(CustomerDetailTab.Projects)" @onclick="@(() => SelectTab(CustomerDetailTab.Projects))">Projects (@ProjectCount.ToString("N0"))</button>
        <button type="button" data-tab="orders" class="@TabClass(CustomerDetailTab.Orders)" aria-current="@TabCurrent(CustomerDetailTab.Orders)" @onclick="@(() => SelectTab(CustomerDetailTab.Orders))">Orders</button>
        <button type="button" data-tab="notes" class="@TabClass(CustomerDetailTab.Notes)" aria-current="@TabCurrent(CustomerDetailTab.Notes)" @onclick="@(() => SelectTab(CustomerDetailTab.Notes))">Notes (@(_customer?.Notes.Count ?? 0))</button>
        <button type="button" data-tab="activity" class="@TabClass(CustomerDetailTab.Activity)" aria-current="@TabCurrent(CustomerDetailTab.Activity)" @onclick="@(() => SelectTab(CustomerDetailTab.Activity))">Activity</button>
    </nav>

    <PageBody Class="customer-record-body">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }
        else if (_customer is null || _edit is null)
        {
            <div class="mlv-empty">Customer was not found.</div>
        }
        else if (_activeTab == CustomerDetailTab.Overview)
        {
            <div class="customer-record-grid">
                <div class="customer-record-main">
                    <section class="customer-panel">
                        <SectionTitle Text="Contact information" />
                        <div class="customer-form-grid">
                            <label class="customer-field">
                                <span>Full name</span>
                                <input class="customer-input" @bind="_edit.FullName" />
                            </label>
                            <label class="customer-field">
                                <span>Company</span>
                                <div class="customer-split-field">
                                    <input class="customer-input" readonly value="@_edit.Company" />
                                    <button type="button" class="customer-inline-action" @onclick="OpenCompanyModalAsync">Link</button>
                                </div>
                            </label>
                            <label class="customer-field">
                                <span>Email</span>
                                <input class="customer-input" type="email" @bind="_edit.Email" />
                            </label>
                            <label class="customer-field">
                                <span>Phone</span>
                                <input class="customer-input" @bind="_edit.Phone" />
                            </label>
                        </div>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Account &amp; billing" />
                        <div class="customer-form-grid">
                            <label class="customer-field">
                                <span>Customer type</span>
                                <select class="customer-input" @bind="_edit.CustomerType">
                                    <option>Company</option>
                                    <option>Individual</option>
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Status</span>
                                <select class="customer-input" @bind="_edit.Status">
                                    <option>Active</option>
                                    <option>Lead</option>
                                    <option>Inactive</option>
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Account manager</span>
                                <select class="customer-input" @bind="AccountManagerSelectValue">
                                    <option value="">Unassigned</option>
                                    @if (_edit?.AccountManagerEmployeeId is Guid selectedManagerId && !_accountManagers.Any(employee => employee.Id == selectedManagerId))
                                    {
                                        <option value="@selectedManagerId">@AccountManager</option>
                                    }
                                    @foreach (var employee in _accountManagers)
                                    {
                                        <option value="@employee.Id">@FormatEmployeeOption(employee)</option>
                                    }
                                </select>
                            </label>
                            <div class="customer-field customer-payment-terms-field">
                                <span id="payment-terms-label">Payment terms</span>
                                <div class="customer-payment-term-picker">
                                    <button type="button"
                                            class="customer-payment-term-trigger"
                                            aria-haspopup="listbox"
                                            aria-expanded="@_paymentTermsOpen"
                                            aria-labelledby="payment-terms-label"
                                            @onclick="TogglePaymentTerms">
                                        <div class="customer-payment-term-card selected">
                                            <div class="customer-payment-term-card-head">
                                                <strong>@PaymentTermTriggerTitle</strong>
                                                <span>@PaymentTermTriggerSummary</span>
                                            </div>
                                            <p>@PaymentTermTriggerDescription</p>
                                            <p>@PaymentTermTriggerUse</p>
                                        </div>
                                        <MudIcon Icon="@(_paymentTermsOpen ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" Class="customer-payment-term-chevron" />
                                    </button>

                                    @if (_paymentTermsOpen)
                                    {
                                        <button type="button"
                                                class="customer-payment-term-backdrop"
                                                aria-label="Close payment terms"
                                                @onclick="ClosePaymentTerms"></button>
                                        <div class="customer-payment-term-menu" role="listbox" aria-labelledby="payment-terms-label">
                                            @if (SelectedPaymentTerm is null && !string.IsNullOrWhiteSpace(_edit!.PaymentTerms))
                                            {
                                                <button type="button"
                                                        class="customer-payment-term-option selected"
                                                        role="option"
                                                        aria-selected="true"
                                                        @onclick="@(() => SelectPaymentTerm(_edit!.PaymentTerms))">
                                                    <div class="customer-payment-term-card">
                                                        <div class="customer-payment-term-card-head">
                                                            <strong>@_edit.PaymentTerms</strong>
                                                            <span>Custom term</span>
                                                        </div>
                                                        <p>No saved payment-term definition is available for this customer value.</p>
                                                        <p>Keep this value when the customer uses a negotiated term that is not in the standard list.</p>
                                                    </div>
                                                </button>
                                            }
                                            @foreach (var term in _paymentTerms)
                                            {
                                                <button type="button"
                                                        class="@PaymentTermItemClass(term)"
                                                        role="option"
                                                        aria-selected="@IsPaymentTermSelected(term.Name)"
                                                        @onclick="@(() => SelectPaymentTerm(term.Name))">
                                                    <div class="customer-payment-term-card">
                                                        <div class="customer-payment-term-card-head">
                                                            <strong>@term.Name</strong>
                                                            <span>@PaymentTermSummary(term)</span>
                                                        </div>
                                                        <p>@PaymentTermDescription(term)</p>
                                                        <p>@PaymentTermUse(term)</p>
                                                    </div>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <label class="customer-field">
                                <span>Tax ID</span>
                                <input class="customer-input" readonly value="@TaxId" />
                            </label>
                            <label class="customer-field">
                                <span>Credit limit (USD)</span>
                                <input class="customer-input" readonly value="@CreditLimit" />
                            </label>
                        </div>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent projects" />
                        @if (_projects.Count > 0)
                        {
                            <table class="customer-orders-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Created</th>
                                        <th>Parts</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in _projects.Take(6))
                                    {
                                        <tr>
                                            <td>
                                                <a href="@($"/sales/projects/{project.Id}")">@project.ProjectNumber</a>
                                                <div class="customer-table-subtext">@project.Title</div>
                                            </td>
                                            <td>@FormatDate(project.CreatedAt)</td>
                                            <td>@project.PartsCount.ToString("N0")</td>
                                            <td class="mlv-mono">@FormatMoney(project.TotalPrice)</td>
                                            <td><StatusBadge Status="@project.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="customer-muted-box">No active projects yet.</div>
                        }
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent orders" />
                        @if (_orders.Count > 0)
                        {
                            <table class="customer-orders-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Parts</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in _orders.Take(6))
                                    {
                                        <tr>
                                            <td><a href="@($"/orders/{order.Id}")">@order.OrderNumber</a></td>
                                            <td>@FormatDate(order.CreatedAt)</td>
                                            <td>-</td>
                                            <td class="mlv-mono">@FormatMoney(ResolveOrderTotal(order))</td>
                                            <td><StatusBadge Status="@order.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="customer-muted-box">No recent orders yet.</div>
                        }
                    </section>
                </div>

                <aside class="customer-record-sidebar">
                    <section class="customer-panel">
                        <SectionTitle Text="Snapshot" />
                        <dl class="customer-snapshot">
                            <div><dt>Type</dt><dd><StatusBadge Text="@CustomerType" Status="@CustomerType" /></dd></div>
                            <div><dt>Customer ID</dt><dd>@CustomerCode</dd></div>
                            <div><dt>Joined</dt><dd>@FormatMonthYear(_customer.CreatedAt)</dd></div>
                            <div><dt>Last order</dt><dd>@LastOrderText</dd></div>
                            <div><dt>Lifetime orders</dt><dd>@LifetimeOrderCount.ToString("N0")</dd></div>
                            <div><dt>Lifetime revenue</dt><dd>@FormatMoney(_customer.TotalSpent)</dd></div>
                            <div><dt>Avg order</dt><dd>@FormatMoney(AverageOrderValue)</dd></div>
                        </dl>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Default addresses" />
                        <div class="customer-address-stack">
                            @if (BillingAddress is not null)
                            {
                                <div>
                                    <div class="customer-address-label">Bill to</div>
                                    <strong>@AddressName(BillingAddress, "Billing")</strong>
                                    <p>@FormatAddress(BillingAddress)</p>
                                </div>
                            }
                            @if (ShippingAddress is not null)
                            {
                                <div>
                                    <div class="customer-address-label ship">Ship to</div>
                                    <strong>@AddressName(ShippingAddress, "Shipping")</strong>
                                    <p>@FormatAddress(ShippingAddress)</p>
                                </div>
                            }
                            @if (BillingAddress is null && ShippingAddress is null)
                            {
                                <div class="customer-muted-box compact">No default addresses recorded.</div>
                            }
                        </div>
                        <button type="button" class="customer-inline-link" @onclick="@(() => SelectTab(CustomerDetailTab.Addresses))">Manage all addresses -></button>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent activity" />
                        @if (RecentActivity.Count > 0)
                        {
                            <div class="customer-activity-list">
                                @foreach (var activity in RecentActivity)
                                {
                                    <div class="customer-activity-item">
                                        <MudIcon Icon="@ActivityIcon(activity.Action)" Size="Size.Small" />
                                        <div>
                                            <strong>@ActivityDescription(activity)</strong>
                                            <span>@(activity.ActorName ?? "System") - @FormatDateTime(activity.Timestamp)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="customer-muted-box compact">No activity recorded.</div>
                        }
                        <button type="button" class="customer-inline-link" @onclick="@(() => SelectTab(CustomerDetailTab.Activity))">View all activity -></button>
                    </section>
                </aside>
            </div>
        }
        else if (_activeTab == CustomerDetailTab.Addresses)
        {
            <section class="customer-panel customer-tab-panel" data-section="addresses">
                <div class="customer-section-head">
                    <SectionTitle Text="Address book" />
                    <PrimaryButton Icon="@Icons.Material.Outlined.Add" OnClick="OpenAddAddressAsync">Add address</PrimaryButton>
                </div>

                @if (_customer.Addresses.Count > 0)
                {
                    <div class="customer-address-book-grid">
                        @foreach (var address in _customer.Addresses.OrderByDescending(address => address.IsDefault).ThenBy(address => address.Type).ThenBy(address => AddressName(address, address.Type)))
                        {
                            <article class="customer-address-card">
                                <div class="customer-address-card-head">
                                    <div>
                                        <strong>@AddressName(address, address.Type)</strong>
                                        <StatusBadge Text="@address.Type" Status="@address.Type" />
                                    </div>
                                    <div class="customer-icon-actions">
                                        <button type="button" class="customer-icon-button customer-address-edit" title="Edit address" aria-label="Edit address" @onclick="@(() => OpenEditAddress(address))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                        </button>
                                        <button type="button" class="customer-icon-button danger" title="Delete address" aria-label="Delete address" @onclick="@(() => DeleteAddressAsync(address))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                                        </button>
                                    </div>
                                </div>

                                <div class="customer-address-lines">
                                    @foreach (var line in FormatAddressLines(address))
                                    {
                                        <span>@line</span>
                                    }
                                </div>

                                <div class="customer-address-card-footer">
                                    @if (address.IsDefault)
                                    {
                                        <span class="customer-default-chip">Default @address.Type.ToLowerInvariant()</span>
                                    }
                                    else
                                    {
                                        <SecondaryButton Class="compact" OnClick="@(args => SetDefaultAddressAsync(address))">Set default @address.Type.ToLowerInvariant()</SecondaryButton>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No addresses recorded.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Projects)
        {
            <section class="customer-panel customer-tab-panel customer-projects-panel" data-section="projects">
                <SectionTitle Text="@($"All projects ({ProjectCount:N0})")" />
                @if (_projects.Count > 0)
                {
                    <table class="customer-orders-table">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Created</th>
                                <th>Parts</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in _projects)
                            {
                                <tr>
                                    <td>
                                        <a href="@($"/sales/projects/{project.Id}")">@project.ProjectNumber</a>
                                        <div class="customer-table-subtext">@project.Title</div>
                                    </td>
                                    <td>@FormatDate(project.CreatedAt)</td>
                                    <td>@project.PartsCount.ToString("N0")</td>
                                    <td class="mlv-mono">@FormatMoney(project.TotalPrice)</td>
                                    <td><StatusBadge Status="@project.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="customer-muted-box">No projects recorded for this customer.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Orders)
        {
            <section class="customer-panel customer-tab-panel customer-orders-panel" data-section="orders">
                <SectionTitle Text="@($"All orders ({LifetimeOrderCount:N0})")" />
                @if (_orders.Count > 0)
                {
                    <table class="customer-orders-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Parts</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr>
                                    <td><a href="@($"/orders/{order.Id}")">@order.OrderNumber</a></td>
                                    <td>@FormatDate(order.CreatedAt)</td>
                                    <td>-</td>
                                    <td class="mlv-mono">@FormatMoney(ResolveOrderTotal(order))</td>
                                    <td><StatusBadge Status="@order.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="customer-muted-box">No orders recorded for this customer.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Notes)
        {
            <div class="customer-notes-layout" data-section="notes">
                <section class="customer-panel customer-note-composer">
                    <SectionTitle Text="Add internal note" />
                    <textarea class="customer-textarea customer-internal-note-input"
                              rows="4"
                              maxlength="@InternalNoteMaxLength"
                              placeholder="Write a note visible only to your team..."
                              @bind="_newNoteText"
                              @bind:event="oninput"></textarea>
                    <div class="customer-note-composer-footer">
                        <span class="@NoteCounterClass">@NoteCharacterCount.ToString("N0") / @InternalNoteMaxLength.ToString("N0") characters</span>
                        <PrimaryButton Class="customer-post-note" OnClick="PostNoteAsync" Disabled="@(!CanPostInternalNote)">Post note</PrimaryButton>
                    </div>
                </section>

                @if (_customer.Notes.Count > 0)
                {
                    <div class="customer-note-list">
                        @foreach (var note in _customer.Notes.OrderByDescending(note => note.CreatedAt))
                        {
                            <article class="customer-note-card">
                                <Avatar Name="@(note.CreatedByName ?? note.CreatedByEmail ?? "MALIEV")" />
                                <div>
                                    <div class="customer-note-meta">
                                        <strong>@(note.CreatedByName ?? "System")</strong>
                                        <span>@FormatDate(note.CreatedAt)</span>
                                    </div>
                                    <p class="customer-note-text">@note.NoteText</p>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No internal notes yet.</div>
                }
            </div>
        }
        else if (_activeTab == CustomerDetailTab.Activity)
        {
            <section class="customer-panel customer-tab-panel customer-activity-panel" data-section="activity">
                <SectionTitle Text="Audit trail" />
                @if (ActivityFeed.Count > 0)
                {
                    <div class="customer-audit-list">
                        @foreach (var activity in ActivityFeed)
                        {
                            <div class="customer-activity-item">
                                <MudIcon Icon="@ActivityIcon(activity.Action)" Size="Size.Small" />
                                <div>
                                    <strong>@ActivityDescription(activity)</strong>
                                    <span>@(activity.ActorName ?? "System") - @FormatDateTime(activity.Timestamp)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No activity recorded.</div>
                }
            </section>
        }
    </PageBody>
</div>

<ConfirmModal Open="@_emailComposerOpen"
              Title="Email customer"
              ConfirmLabel="@EmailConfirmLabel"
              ConfirmDisabled="@EmailConfirmDisabled"
              ConfirmButtonClass="customer-email-send"
              Class="customer-modal-wide"
              OnCancel="CloseEmailComposerAsync"
              OnConfirm="SendCustomerEmailAsync">
    @if (_customer is not null)
    {
        <div class="customer-email-modal">
            <p class="customer-email-recipient">To <span>@_customer.Email</span></p>
            <label class="customer-field">
                <span>Subject</span>
                <input class="customer-input customer-email-subject" @bind="_emailSubject" @bind:event="oninput" disabled="@_emailQueued" />
            </label>
            <label class="customer-field">
                <span>Message</span>
                <textarea class="customer-textarea customer-email-body" @bind="_emailBody" @bind:event="oninput" disabled="@_emailQueued"></textarea>
            </label>
            @if (!string.IsNullOrWhiteSpace(_emailError))
            {
                <div class="customer-email-state error">@_emailError</div>
            }
            else if (_emailQueued)
            {
                <div class="customer-email-state success">Email queued for delivery.</div>
            }
        </div>
    }
</ConfirmModal>

<ConfirmModal Open="@(_addressEdit is not null)"
              Title="@AddressModalTitle"
              ConfirmLabel="Save"
              Class="customer-modal-address"
              CloseOnBackdropClick="false"
              OnCancel="CloseAddressModalAsync"
              OnConfirm="SaveAddressAsync">
    @if (_addressEdit is not null)
    {
        <div class="customer-address-form">
            <div class="customer-address-editor-grid">
                <div class="customer-address-editor-fields">
                    <div class="customer-form-grid">
                        <label class="customer-field">
                            <span>Recipient name</span>
                            <input class="customer-input" @bind="_addressEdit.Label" />
                        </label>
                        <label class="customer-field">
                            <span>Type</span>
                            <select class="customer-input" @bind="_addressEdit.Type">
                                <option>Billing</option>
                                <option>Shipping</option>
                                <option>Office</option>
                            </select>
                        </label>
                        <label class="customer-field customer-span-2">
                            <span>Street</span>
                            <input class="customer-input" @bind="_addressEdit.AddressLine1" />
                        </label>
                        <label class="customer-field customer-span-2">
                            <span>Street 2</span>
                            <input class="customer-input" @bind="_addressEdit.AddressLine2" />
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>City</span>
                            <input class="customer-input"
                                   value="@_addressEdit.City"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.City, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.City))" />
                            @if (ShouldShowAddressSuggestions(AddressField.City))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>District / sub-district</span>
                            <input class="customer-input"
                                   value="@_addressEdit.District"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.District, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.District))" />
                            @if (ShouldShowAddressSuggestions(AddressField.District))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>State / province</span>
                            <input class="customer-input"
                                   value="@_addressEdit.StateProvince"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.StateProvince, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.StateProvince))" />
                            @if (ShouldShowAddressSuggestions(AddressField.StateProvince))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field customer-suggestion-field">
                            <span>Postal</span>
                            <input class="customer-input"
                                   value="@_addressEdit.PostalCode"
                                   @oninput="@((ChangeEventArgs args) => OnAddressFieldInputAsync(AddressField.PostalCode, args.Value?.ToString()))"
                                   @onfocus="@(() => ShowAddressSuggestions(AddressField.PostalCode))" />
                            @if (ShouldShowAddressSuggestions(AddressField.PostalCode))
                            {
                                <div class="customer-autocomplete-list">
                                    @foreach (var location in _fieldLocationMatches)
                                    {
                                        <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressSuggestionLanguage))">
                                            <strong>@FormatLocationPrimary(location, _addressSuggestionLanguage)</strong>
                                            <span>@FormatLocationSecondary(location, _addressSuggestionLanguage)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label class="customer-field">
                            <span>Country</span>
                            <select class="customer-input" @bind="_addressEdit.CountryId">
                                <option value="@Guid.Empty">Select country</option>
                                @foreach (var country in _countries)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            </select>
                        </label>
                        <label class="customer-checkbox-row customer-span-2">
                            <input type="checkbox" @bind="_addressEdit.IsDefault" />
                            <span>Default for this address type</span>
                        </label>
                    </div>
                </div>
                <aside class="customer-address-lookup-panel">
                    <label class="customer-field">
                        <span>Address lookup</span>
                        <textarea class="customer-textarea customer-address-lookup-input"
                                  placeholder="Paste the full customer address text..."
                                  @bind="_addressLookupQuery"
                                  @bind:event="oninput"></textarea>
                    </label>
                    <button type="button" class="customer-inline-action customer-address-search" @onclick="SearchLocationsAsync" disabled="@_addressLookupLoading">
                        @(_addressLookupLoading ? "Searching..." : "Search")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_addressLookupError))
                    {
                        <div class="customer-address-lookup-state">@_addressLookupError</div>
                    }
                    @if (_locationMatches.Count > 0)
                    {
                        <div class="customer-result-list customer-address-result-list">
                            @foreach (var location in _locationMatches)
                            {
                                <button type="button" @onclick="@(() => ApplyLocationAsync(location, _addressLookupLanguage))">
                                    <strong>@FormatLocationPrimary(location, _addressLookupLanguage)</strong>
                                    <span>@FormatLocationSecondary(location, _addressLookupLanguage)</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="customer-address-map-panel">
                        <div id="@AddressMapElementId" class="customer-address-map"></div>
                        <div class="customer-address-map-caption">
                            @(_addressMapLocation?.DisplayName ?? "Select an address result to show the map location.")
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    }
</ConfirmModal>

<ConfirmModal Open="@(_companyEdit is not null)"
              Title="Link company"
              ConfirmLabel="@CompanyConfirmLabel"
              Class="customer-modal-wide"
              OnCancel="CloseCompanyModalAsync"
              OnConfirm="SaveCompanyAsync">
    @if (_companyEdit is not null)
    {
        <div class="customer-address-form">
            <div class="customer-form-grid">
                <label class="customer-field customer-span-2">
                    <span>Company lookup</span>
                    <div class="customer-split-field">
                        <input class="customer-input" placeholder="Name or tax ID..." @bind="_companyLookupQuery" />
                        <button type="button" class="customer-inline-action" @onclick="SearchCompaniesAsync">Search</button>
                    </div>
                </label>
                @if (_companyMatches.Count > 0 || _registryCompanyMatches.Count > 0)
                {
                    <div class="customer-result-list customer-span-2">
                        @foreach (var company in _companyMatches)
                        {
                            <button type="button" @onclick="@(() => ApplyCompany(company))">
                                @company.Name @(!string.IsNullOrWhiteSpace(company.VatNumber) ? $"({company.VatNumber})" : string.Empty)
                            </button>
                        }
                        @foreach (var company in _registryCompanyMatches)
                        {
                            <button type="button" @onclick="@(() => ApplyRegistryCompany(company))">
                                @(string.IsNullOrWhiteSpace(company.FullNameTh) ? company.CompanyNameTh : company.FullNameTh) @(!string.IsNullOrWhiteSpace(company.TaxId) ? $"({company.TaxId})" : string.Empty)
                            </button>
                        }
                    </div>
                }
                <label class="customer-field customer-span-2">
                    <span>Company name</span>
                    <input class="customer-input" @bind="_companyEdit.Name" />
                </label>
                <label class="customer-field">
                    <span>Tax ID</span>
                    <input class="customer-input" @bind="_companyEdit.VatNumber" />
                </label>
                <label class="customer-field">
                    <span>Registration number</span>
                    <input class="customer-input" @bind="_companyEdit.RegistrationNumber" />
                </label>
                <label class="customer-field">
                    <span>Contact email</span>
                    <input class="customer-input" type="email" @bind="_companyEdit.ContactEmail" />
                </label>
                <label class="customer-field">
                    <span>Contact phone</span>
                    <input class="customer-input" @bind="_companyEdit.ContactPhone" />
                </label>
            </div>
        </div>
    }
</ConfirmModal>

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerDetailDto? _customer;
    private CustomerEditModel? _edit;
    private readonly List<ProjectSummaryDto> _projects = [];
    private readonly List<OrderSummaryDto> _orders = [];
    private readonly List<CustomerActivityResponse> _activity = [];
    private readonly List<PaymentTermDto> _paymentTerms = [];
    private CustomerDetailTab _activeTab = CustomerDetailTab.Overview;
    private AddressEditModel? _addressEdit;
    private CompanyEditModel? _companyEdit;
    private bool _loading = true;
    private bool _saving;
    private bool _sendingEmail;
    private bool _emailComposerOpen;
    private bool _emailQueued;
    private bool _paymentTermsOpen;
    private string? _error;
    private string _emailSubject = string.Empty;
    private string _emailBody = string.Empty;
    private string? _emailError;
    private string _newNoteText = string.Empty;
    private const int InternalNoteMaxLength = 5000;
    private string _addressLookupQuery = string.Empty;
    private bool _addressLookupLoading;
    private string? _addressLookupError;
    private bool _applyingLocation;
    private bool _addressMapInitialized;
    private bool _addressMapNeedsSavedAddress;
    private AddressField? _activeAddressSuggestionField;
    private AddressLanguage _addressLookupLanguage = AddressLanguage.English;
    private AddressLanguage _addressSuggestionLanguage = AddressLanguage.English;
    private AddressGeocodeResponse? _addressMapLocation;
    private string _companyLookupQuery = string.Empty;
    private int _projectTotalCount;
    private int _orderTotalCount;
    private readonly List<CountryDto> _countries = [];
    private readonly List<EmployeeSummaryDto> _accountManagers = [];
    private readonly List<RegistryThaiLocation> _locationMatches = [];
    private readonly List<RegistryThaiLocation> _fieldLocationMatches = [];
    private readonly List<CompanySearchResultDto> _companyMatches = [];
    private readonly List<RegistryCompanyProfile> _registryCompanyMatches = [];

    private string CustomerType => HasCompany ? "Company" : "Individual";
    private bool HasCompany => _customer?.CompanyId is not null || !string.IsNullOrWhiteSpace(_customer?.CompanyName);
    private string AccountManager => ResolveAccountManagerName(_edit?.AccountManagerEmployeeId ?? _customer?.AccountManagerEmployeeId);
    private string TaxId => _customer?.CompanyVatNumber ?? _customer?.CompanyRegistrationNumber ?? "-";
    private const string CreditLimit = "0";
    private string CustomerCode => _customer is null ? "-" : $"C-{_customer.Id.ToString("N")[..8].ToUpperInvariant()}";
    private int ProjectCount => _projectTotalCount > 0 ? _projectTotalCount : _projects.Count;
    private int LifetimeOrderCount => _orderTotalCount > 0 ? _orderTotalCount : Math.Max(_orders.Count, _customer?.ActiveOrdersCount ?? 0);
    private decimal AverageOrderValue => LifetimeOrderCount > 0 && _customer is not null ? _customer.TotalSpent / LifetimeOrderCount : 0m;
    private string LastOrderText => _orders.Count == 0 ? "-" : FormatDate(_orders.Max(order => order.CreatedAt));
    private string AddressModalTitle => _addressEdit?.Id is null ? "Add address" : "Edit address";
    private string AddressMapElementId => $"customer-address-map-{Id:N}";
    private PaymentTermDto? SelectedPaymentTerm => _edit is null
        ? null
        : _paymentTerms.FirstOrDefault(term => string.Equals(term.Name, _edit.PaymentTerms, StringComparison.Ordinal));
    private string PaymentTermTriggerTitle => SelectedPaymentTerm?.Name ?? _edit?.PaymentTerms ?? "Select payment term";
    private string PaymentTermTriggerSummary => SelectedPaymentTerm is { } term ? PaymentTermSummary(term) : "Custom term";
    private string PaymentTermTriggerDescription => SelectedPaymentTerm is { } term
        ? PaymentTermDescription(term)
        : "No saved payment-term definition is available for this customer value.";
    private string PaymentTermTriggerUse => SelectedPaymentTerm is { } term
        ? PaymentTermUse(term)
        : "Keep this value when the customer uses a negotiated term that is not in the standard list.";
    private string CompanyConfirmLabel => _companyEdit?.ExistingCompanyId is Guid ? "Link company" : "Create and link";
    private string EmailConfirmLabel => _sendingEmail ? "Sending..." : _emailQueued ? "Queued" : "Send email";
    private bool EmailConfirmDisabled => _sendingEmail || _emailQueued;
    private int NoteCharacterCount => _newNoteText.Length;
    private bool CanPostInternalNote => !string.IsNullOrWhiteSpace(_newNoteText) && NoteCharacterCount <= InternalNoteMaxLength;
    private string NoteCounterClass => NoteCharacterCount > InternalNoteMaxLength ? "customer-note-counter over-limit" : "customer-note-counter";
    private string AccountManagerSelectValue
    {
        get => _edit?.AccountManagerEmployeeId?.ToString() ?? string.Empty;
        set
        {
            if (_edit is null)
            {
                return;
            }

            _edit.AccountManagerEmployeeId = Guid.TryParse(value, out var employeeId) ? employeeId : null;
        }
    }

    private AddressResponse? BillingAddress =>
        _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Billing") && address.IsDefault)
        ?? _customer?.CompanyBillingAddress
        ?? _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Billing"));

    private AddressResponse? ShippingAddress =>
        _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Shipping") && address.IsDefault)
        ?? _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Shipping"));

    private IReadOnlyList<CustomerActivityResponse> ActivityFeed =>
        _activity.Count > 0
            ? _activity
            : (_customer?.Notes.OrderByDescending(note => note.CreatedAt)
                .Select(note => new CustomerActivityResponse
                {
                    Action = "Note",
                    Description = note.NoteText,
                    ActorName = note.CreatedByName,
                    Timestamp = note.CreatedAt
                })
                .ToList() ?? []);

    private IReadOnlyList<CustomerActivityResponse> RecentActivity => ActivityFeed.Take(5).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_addressEdit is not null && !_addressMapInitialized)
        {
            _addressMapInitialized = true;
            await JS.InvokeVoidAsync("malievAddressMap.initialize", AddressMapElementId);
            if (_addressMapNeedsSavedAddress)
            {
                _addressMapNeedsSavedAddress = false;
                await GeocodeSavedAddressAsync();
                StateHasChanged();
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/v1/customers/{Id}");
            if (_customer is null)
            {
                _error = "Customer was not found.";
                return;
            }

            _edit = CustomerEditModel.FromCustomer(_customer);
            await Task.WhenAll(LoadProjectsAsync(), LoadOrdersAsync(), LoadActivityAsync(), LoadCountriesAsync(), LoadAccountManagersAsync(), LoadPaymentTermsAsync());
        }
        catch (Exception ex)
        {
            _error = "Customer could not be loaded.";
            Snackbar.Add(_error, Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<ProjectSummaryDto>>($"api/v1/projects?customerId={Id}&page=1&pageSize=20");
            _projects.Clear();
            _projects.AddRange(response?.Data.OrderByDescending(project => project.CreatedAt).ToList() ?? []);
            _projectTotalCount = response?.Meta.TotalItems > 0
                ? response.Meta.TotalItems
                : response?.Meta.TotalCount ?? _projects.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>($"api/v1/orders?customerId={Id}&page=1&pageSize=20");
            _orders.Clear();
            _orders.AddRange(response?.Data.OrderByDescending(order => order.CreatedAt).ToList() ?? []);
            _orderTotalCount = response?.Meta.TotalItems > 0
                ? response.Meta.TotalItems
                : response?.Meta.TotalCount ?? _orders.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadActivityAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerActivityResponse>>($"api/v1/customers/{Id}/history?page=1&pageSize=20");
            _activity.Clear();
            _activity.AddRange(response?.Data.OrderByDescending(activity => activity.Timestamp).ToList() ?? []);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void SelectTab(CustomerDetailTab tab) => _activeTab = tab;

    private string TabClass(CustomerDetailTab tab) => tab == _activeTab ? "active" : string.Empty;

    private string? TabCurrent(CustomerDetailTab tab) => tab == _activeTab ? "page" : null;

    private async Task LoadCountriesAsync()
    {
        if (_countries.Count > 0)
        {
            return;
        }

        var countries = await Http.GetFromJsonAsync<List<CountryDto>>("api/v1/customers/countries") ?? [];
        _countries.Clear();
        _countries.AddRange(countries.OrderBy(country => country.Name));
    }

    private async Task LoadAccountManagersAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<EmployeeSummaryDto>>("api/v1/employees?page=1&pageSize=100");
            _accountManagers.Clear();
            _accountManagers.AddRange((response?.Data ?? [])
                .Where(employee => employee.Id != Guid.Empty)
                .OrderByDescending(employee => string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .ThenBy(employee => employee.Name));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private Task DiscardChangesAsync(MouseEventArgs _)
    {
        if (_customer is not null)
        {
            _edit = CustomerEditModel.FromCustomer(_customer);
        }

        return Task.CompletedTask;
    }

    private async Task SaveCustomerAsync(MouseEventArgs _)
    {
        await SaveCustomerCoreAsync();
    }

    private Task OpenEmailComposerAsync(MouseEventArgs _)
    {
        if (_customer is null)
        {
            return Task.CompletedTask;
        }

        _emailSubject = string.Empty;
        _emailBody = $"Hello {_customer.Name},\n\n";
        _emailError = null;
        _emailQueued = false;
        _emailComposerOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseEmailComposerAsync()
    {
        _emailComposerOpen = false;
        _emailError = null;
        _emailQueued = false;
        return Task.CompletedTask;
    }

    private async Task SendCustomerEmailAsync()
    {
        if (_customer is null)
        {
            return;
        }

        var subject = _emailSubject.Trim();
        var body = _emailBody.Trim();
        if (string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(body))
        {
            _emailError = "Enter a subject and message before sending.";
            return;
        }

        _sendingEmail = true;
        _emailError = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/customers/{_customer.Id}/email", new CustomerEmailRequest
            {
                Subject = subject,
                Body = body
            });

            if (response.IsSuccessStatusCode)
            {
                _emailQueued = true;
                return;
            }

            var error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            _emailError = error?.Message ?? "Customer email could not be queued.";
        }
        catch (Exception ex)
        {
            _emailError = "Customer email could not be queued.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _sendingEmail = false;
        }
    }

    private async Task LoadPaymentTermsAsync()
    {
        try
        {
            var terms = await Http.GetFromJsonAsync<List<PaymentTermDto>>("api/v1/customers/payment-terms");
            _paymentTerms.Clear();
            _paymentTerms.AddRange((terms ?? [])
                .Where(term => !string.IsNullOrWhiteSpace(term.Name))
                .OrderBy(term => term.SortOrder)
                .ThenBy(term => term.Name));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            _paymentTerms.Clear();
            _paymentTerms.AddRange(DefaultPaymentTerms());
        }
    }

    private void TogglePaymentTerms()
    {
        _paymentTermsOpen = !_paymentTermsOpen;
    }

    private void ClosePaymentTerms()
    {
        _paymentTermsOpen = false;
    }

    private void SelectPaymentTerm(string name)
    {
        if (_edit is null)
        {
            return;
        }

        _edit.PaymentTerms = name;
        _paymentTermsOpen = false;
    }

    private async Task<bool> SaveCustomerCoreAsync()
    {
        if (_customer is null || _edit is null)
        {
            return false;
        }

        _saving = true;
        try
        {
            var (firstName, lastName) = SplitName(_edit.FullName);
            var request = new
            {
                firstName,
                lastName,
                email = _edit.Email,
                mobile = _edit.Phone,
                status = _edit.Status,
                extension = _customer.Extension,
                landline = _customer.Landline,
                segment = _customer.Segment,
                tier = _customer.Tier,
                preferredLanguage = _customer.PreferredLanguage,
                timezone = _customer.Timezone,
                communicationPreferences = _customer.CommunicationPreferences,
                paymentTerms = _edit.PaymentTerms,
                companyId = _edit.CompanyId,
                accountManagerEmployeeId = _edit.AccountManagerEmployeeId,
                clearAccountManager = _edit.AccountManagerEmployeeId is null,
                xmin = _customer.Xmin
            };

            var response = await Http.PatchAsJsonAsync($"api/v1/customers/{Id}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer saved.", Severity.Success);
                await LoadAsync();
                return true;
            }
            else
            {
                Snackbar.Add("Customer could not be saved.", Severity.Warning);
                return false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Customer could not be saved.", Severity.Warning);
            Console.WriteLine(ex.Message);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task OpenAddAddressAsync(MouseEventArgs _)
    {
        _addressEdit = AddressEditModel.Create(_customer?.Addresses.FirstOrDefault()?.CountryId ?? DefaultCountryId());
        ResetAddressLookupState();
        return Task.CompletedTask;
    }

    private void OpenEditAddress(AddressResponse address)
    {
        _addressEdit = AddressEditModel.FromAddress(address);
        ResetAddressLookupState();
        _addressLookupQuery = BuildAddressMapQuery(_addressEdit);
        _addressMapNeedsSavedAddress = !string.IsNullOrWhiteSpace(_addressLookupQuery);
    }

    private async Task CloseAddressModalAsync()
    {
        _addressEdit = null;
        ResetAddressLookupState();
        await JS.InvokeVoidAsync("malievAddressMap.dispose", AddressMapElementId);
    }

    private void ResetAddressLookupState()
    {
        _addressLookupQuery = string.Empty;
        _addressLookupLoading = false;
        _addressLookupError = null;
        _addressMapLocation = null;
        _activeAddressSuggestionField = null;
        _addressMapInitialized = false;
        _addressMapNeedsSavedAddress = false;
        _locationMatches.Clear();
        _fieldLocationMatches.Clear();
    }

    private async Task SaveAddressAsync()
    {
        if (_customer is null || _addressEdit is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_addressEdit.AddressLine1) ||
            string.IsNullOrWhiteSpace(_addressEdit.City) ||
            string.IsNullOrWhiteSpace(_addressEdit.PostalCode))
        {
            Snackbar.Add("Address needs street, city, and postal code.", Severity.Warning);
            return;
        }

        try
        {
            HttpResponseMessage response;
            if (_addressEdit.Id is Guid addressId)
            {
                response = await Http.PatchAsJsonAsync($"api/v1/customers/addresses/{addressId}", new UpdateAddressRequest
                {
                    Type = _addressEdit.Type,
                    IsDefault = _addressEdit.IsDefault,
                    AddressLine1 = _addressEdit.AddressLine1,
                    AddressLine2 = _addressEdit.AddressLine2,
                    District = _addressEdit.District,
                    City = _addressEdit.City,
                    StateProvince = _addressEdit.StateProvince,
                    PostalCode = _addressEdit.PostalCode,
                    CountryId = _addressEdit.CountryId == Guid.Empty ? null : _addressEdit.CountryId,
                    RecipientName = _addressEdit.Label,
                    Version = _addressEdit.Version,
                    Xmin = _addressEdit.Xmin
                });
            }
            else
            {
                if (_addressEdit.CountryId == Guid.Empty)
                {
                    Snackbar.Add("Select a country before adding a new address.", Severity.Warning);
                    return;
                }

                response = await Http.PostAsJsonAsync($"api/v1/customers/{Id}/addresses", new List<CreateAddressRequest>
                {
                    new()
                    {
                        Type = _addressEdit.Type,
                        IsDefault = _addressEdit.IsDefault,
                        AddressLine1 = _addressEdit.AddressLine1,
                        AddressLine2 = _addressEdit.AddressLine2,
                        District = _addressEdit.District,
                        City = _addressEdit.City,
                        StateProvince = _addressEdit.StateProvince,
                        PostalCode = _addressEdit.PostalCode,
                        CountryId = _addressEdit.CountryId,
                        RecipientName = _addressEdit.Label
                    }
                });
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Address saved.", Severity.Success);
                _addressEdit = null;
                await LoadAsync();
                _activeTab = CustomerDetailTab.Addresses;
            }
            else
            {
                Snackbar.Add("Address could not be saved.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Address could not be saved.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private async Task SetDefaultAddressAsync(AddressResponse address)
    {
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/v1/customers/addresses/{address.Id}", new UpdateAddressRequest
            {
                Type = address.Type,
                IsDefault = true,
                AddressLine1 = address.AddressLine1,
                AddressLine2 = address.AddressLine2,
                AddressLine3 = address.AddressLine3,
                District = address.District,
                City = address.City,
                StateProvince = address.StateProvince,
                PostalCode = address.PostalCode,
                CountryId = address.CountryId,
                RecipientName = address.RecipientName,
                RecipientPhone = address.RecipientPhone,
                Version = address.Version,
                Xmin = address.Xmin
            });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Default address updated.", Severity.Success);
                await LoadAsync();
                _activeTab = CustomerDetailTab.Addresses;
            }
            else
            {
                Snackbar.Add("Default address could not be updated.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Default address could not be updated.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private async Task DeleteAddressAsync(AddressResponse address)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/v1/customers/addresses/{address.Id}?xmin={address.Xmin}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Address deleted.", Severity.Success);
                await LoadAsync();
                _activeTab = CustomerDetailTab.Addresses;
            }
            else
            {
                Snackbar.Add("Address could not be deleted.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Address could not be deleted.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private async Task PostNoteAsync(MouseEventArgs _)
    {
        if (_customer is null || !CanPostInternalNote)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/customers/{Id}/notes", new CreateInternalNoteRequest
            {
                OwnerType = "Customer",
                OwnerId = Id,
                NoteText = _newNoteText.Trim()
            });

            if (response.IsSuccessStatusCode)
            {
                _newNoteText = string.Empty;
                Snackbar.Add("Note posted.", Severity.Success);
                await LoadAsync();
                _activeTab = CustomerDetailTab.Notes;
            }
            else
            {
                Snackbar.Add("Note could not be posted.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Note could not be posted.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private async Task SearchLocationsAsync()
    {
        _locationMatches.Clear();
        _addressLookupError = null;
        if (string.IsNullOrWhiteSpace(_addressLookupQuery) || _addressLookupQuery.Trim().Length < 2)
        {
            return;
        }

        _addressLookupLoading = true;
        _addressLookupLanguage = DetectAddressLanguage(_addressLookupQuery);

        try
        {
            var extracted = await ExtractAddressFromLookupTextAsync();
            if (extracted?.Addresses?.FirstOrDefault() is { } address)
            {
                if (address.Location is not null)
                {
                    AddLocationMatch(_locationMatches, address.Location);
                }

                var multiMatches = await SearchLocationsMultiFieldAsync(
                    address.PostalCode,
                    address.District,
                    address.City,
                    address.StateProvince,
                    8);
                AddLocationMatches(_locationMatches, multiMatches);
            }

            if (_locationMatches.Count == 0)
            {
                var query = Uri.EscapeDataString(_addressLookupQuery.Trim());
                var matches = await Http.GetFromJsonAsync<List<RegistryThaiLocation>>($"api/v1/customers/locations/thai?query={query}&limit=8") ?? [];
                AddLocationMatches(_locationMatches, matches);
            }

            if (_locationMatches.Count == 0)
            {
                _addressLookupError = "No RegistryService address matches found.";
            }
        }
        catch (Exception ex)
        {
            _addressLookupError = "Address lookup could not be loaded.";
            Snackbar.Add("Address lookup could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _addressLookupLoading = false;
        }
    }

    private async Task<ExtractedCustomerDataResponse?> ExtractAddressFromLookupTextAsync()
    {
        using var form = new MultipartFormDataContent();
        form.Add(new StringContent(_addressLookupQuery.Trim()), "rawText");

        var response = await Http.PostAsync("api/v1/AiProcessing/extract-customer", form);
        if (!response.IsSuccessStatusCode)
        {
            return null;
        }

        return await response.Content.ReadFromJsonAsync<ExtractedCustomerDataResponse>();
    }

    private async Task OnAddressFieldInputAsync(AddressField field, string? value)
    {
        if (_addressEdit is null)
        {
            return;
        }

        SetAddressFieldValue(field, value ?? string.Empty);

        if (_applyingLocation)
        {
            return;
        }

        _activeAddressSuggestionField = field;
        _fieldLocationMatches.Clear();

        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            return;
        }

        _addressSuggestionLanguage = DetectAddressLanguage(value);

        try
        {
            var matches = field switch
            {
                AddressField.City => await SearchLocationsMultiFieldAsync(null, null, value, null, 8),
                AddressField.District => await SearchLocationsMultiFieldAsync(null, value, null, null, 8),
                AddressField.StateProvince => await SearchLocationsMultiFieldAsync(null, null, null, value, 8),
                AddressField.PostalCode => await SearchLocationsMultiFieldAsync(value, null, null, null, 8),
                _ => []
            };

            AddLocationMatches(_fieldLocationMatches, matches);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void ShowAddressSuggestions(AddressField field)
    {
        if (_fieldLocationMatches.Count > 0)
        {
            _activeAddressSuggestionField = field;
        }
    }

    private bool ShouldShowAddressSuggestions(AddressField field) =>
        _activeAddressSuggestionField == field && _fieldLocationMatches.Count > 0;

    private async Task<List<RegistryThaiLocation>> SearchLocationsMultiFieldAsync(
        string? postalCode,
        string? district,
        string? city,
        string? province,
        int limit)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(postalCode))
        {
            parts.Add($"postalCode={Uri.EscapeDataString(postalCode.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(district))
        {
            parts.Add($"district={Uri.EscapeDataString(district.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add($"city={Uri.EscapeDataString(city.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(province))
        {
            parts.Add($"province={Uri.EscapeDataString(province.Trim())}");
        }

        parts.Add($"limit={limit}");
        var query = string.Join("&", parts);
        return await Http.GetFromJsonAsync<List<RegistryThaiLocation>>($"api/v1/customers/locations/thai/multi?{query}") ?? [];
    }

    private async Task ApplyLocationAsync(RegistryThaiLocation location, AddressLanguage language)
    {
        if (_addressEdit is null)
        {
            return;
        }

        _applyingLocation = true;
        _addressEdit.PostalCode = location.PostalCode;
        _addressEdit.District = ChooseLocationText(location.SubDistrictTh, location.SubDistrictEn, language);
        _addressEdit.City = ChooseLocationText(location.DistrictTh, location.DistrictEn, language);
        _addressEdit.StateProvince = ChooseLocationText(location.ProvinceTh, location.ProvinceEn, language);
        _addressEdit.CountryId = DefaultCountryId();
        _addressLookupQuery = FormatLocationPrimary(location, language);
        _locationMatches.Clear();
        _fieldLocationMatches.Clear();
        _activeAddressSuggestionField = null;
        _applyingLocation = false;

        await GeocodeLocationAsync(location, language);
    }

    private async Task GeocodeLocationAsync(RegistryThaiLocation location, AddressLanguage language)
    {
        var query = FormatLocationForMap(location, language);
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        await GeocodeAddressQueryAsync(query);
    }

    private async Task GeocodeSavedAddressAsync()
    {
        if (_addressEdit is null)
        {
            return;
        }

        var query = BuildAddressMapQuery(_addressEdit);
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        _addressLookupQuery = query;
        await GeocodeAddressQueryAsync(query);
    }

    private async Task GeocodeAddressQueryAsync(string query)
    {
        try
        {
            _addressMapLocation = await Http.GetFromJsonAsync<AddressGeocodeResponse>(
                $"api/v1/customers/locations/thai/geocode?query={Uri.EscapeDataString(query)}");
            if (_addressMapLocation is not null)
            {
                await JS.InvokeVoidAsync(
                    "malievAddressMap.update",
                    AddressMapElementId,
                    _addressMapLocation.Latitude,
                    _addressMapLocation.Longitude,
                    _addressMapLocation.DisplayName);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private string BuildAddressMapQuery(AddressEditModel address)
    {
        var countryName = _countries.FirstOrDefault(country => country.Id == address.CountryId)?.Name;
        var parts = new[]
        {
            address.AddressLine1,
            address.AddressLine2,
            address.District,
            address.City,
            address.StateProvince,
            address.PostalCode,
            countryName
        };

        return string.Join(", ", parts
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Select(part => part!.Trim()));
    }

    private void SetAddressFieldValue(AddressField field, string value)
    {
        if (_addressEdit is null)
        {
            return;
        }

        switch (field)
        {
            case AddressField.City:
                _addressEdit.City = value;
                break;
            case AddressField.District:
                _addressEdit.District = value;
                break;
            case AddressField.StateProvince:
                _addressEdit.StateProvince = value;
                break;
            case AddressField.PostalCode:
                _addressEdit.PostalCode = value;
                break;
        }
    }

    private static void AddLocationMatches(List<RegistryThaiLocation> target, IEnumerable<RegistryThaiLocation> locations)
    {
        foreach (var location in locations)
        {
            AddLocationMatch(target, location);
        }
    }

    private static void AddLocationMatch(List<RegistryThaiLocation> target, RegistryThaiLocation location)
    {
        if (!target.Any(existing => existing.Id == location.Id && existing.Id != Guid.Empty))
        {
            target.Add(location);
        }
    }

