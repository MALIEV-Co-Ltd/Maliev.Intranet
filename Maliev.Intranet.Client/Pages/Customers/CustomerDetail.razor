    private async Task SearchLocationsAsync()
    {
        _locationMatches.Clear();
        _addressLookupMessage = null;
        _addressLookupMessageIsWarning = false;

        var lookupText = _addressLookupQuery.Trim();
        if (lookupText.Length < 2)
        {
            _addressLookupMessage = "Paste a full address or a few searchable address parts first.";
            _addressLookupMessageIsWarning = true;
            return;
        }

        _addressLookupLoading = true;
        _addressLookupLanguage = DetectAddressLanguage(lookupText);

        try
        {
            var extractedAddress = await ExtractAddressFromLookupTextAsync(lookupText);
            if (extractedAddress is not null)
            {
                ApplyExtractedAddressToDraft(extractedAddress);
                var structuredQuery = BuildExtractedAddressQuery(extractedAddress);
                if (!string.IsNullOrWhiteSpace(structuredQuery))
                {
                    _addressLookupLanguage = DetectAddressLanguage(structuredQuery);
                }

                if (extractedAddress.Location is not null)
                {
                    AddLocationMatch(_locationMatches, extractedAddress.Location);
                }

                if (HasRegistrySearchTerms(extractedAddress))
                {
                    var multiMatches = await SearchLocationsMultiFieldAsync(
                        extractedAddress.PostalCode,
                        extractedAddress.District,
                        extractedAddress.City,
                        extractedAddress.StateProvince,
                        8);
                    AddLocationMatches(_locationMatches, multiMatches);
                }

                await GeocodeAddressQueryAsync(string.IsNullOrWhiteSpace(structuredQuery) ? lookupText : structuredQuery);
            }

            if (_locationMatches.Count == 0)
            {
                var query = Uri.EscapeDataString(lookupText);
                var matches = await Http.GetFromJsonAsync<List<RegistryThaiLocation>>($"api/v1/customers/locations/thai?query={query}&limit=8") ?? [];
                AddLocationMatches(_locationMatches, matches);

                if (_locationMatches.Count == 0)
                {
                    await GeocodeAddressQueryAsync(lookupText);
                }
            }

            if (_locationMatches.Count > 0)
            {
                var matchLabel = _locationMatches.Count == 1 ? "match" : "matches";
                _addressLookupMessage = extractedAddress is null
                    ? $"Found {_locationMatches.Count} RegistryService {matchLabel}."
                    : $"AI structured the address and found {_locationMatches.Count} RegistryService {matchLabel}.";
            }
            else if (extractedAddress is not null && HasAnyExtractedAddressField(extractedAddress))
            {
                _addressLookupMessage = "AI filled the address fields, but RegistryService did not return an official match. Review the fields before saving.";
                _addressLookupMessageIsWarning = true;
            }
            else
            {
                _addressLookupMessage = "No address could be extracted. Paste a fuller address with district, province, or postal code.";
                _addressLookupMessageIsWarning = true;
            }
        }
        catch (Exception ex)
        {
            _addressLookupMessage = "Address lookup could not be loaded. Try a fuller address or fill the fields manually.";
            _addressLookupMessageIsWarning = true;
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _addressLookupLoading = false;
        }
    }

    private async Task<ExtractedAddress?> ExtractAddressFromLookupTextAsync(string lookupText)
    {
        using var form = new MultipartFormDataContent();
        form.Add(new StringContent(lookupText), "rawText");

        var response = await Http.PostAsync("api/v1/AiProcessing/extract-customer", form);
        if (!response.IsSuccessStatusCode)
        {
            return null;
        }

        var extracted = await response.Content.ReadFromJsonAsync<ExtractedCustomerDataResponse>();
        return extracted?.Addresses?.FirstOrDefault(HasAnyExtractedAddressField);
    }

    private void ApplyExtractedAddressToDraft(ExtractedAddress address)
    {
        if (_addressEdit is null)
        {
            return;
        }

        var addressType = NormalizeAddressType(address.Type);
        if (!string.IsNullOrWhiteSpace(addressType))
        {
            _addressEdit.Type = addressType;
        }

        if (!string.IsNullOrWhiteSpace(address.RecipientName))
        {
            _addressEdit.Label = address.RecipientName.Trim();
        }

        if (!string.IsNullOrWhiteSpace(address.AddressLine1))
        {
            _addressEdit.AddressLine1 = address.AddressLine1.Trim();
        }

        var secondaryLine = CombineAddressLines(address.AddressLine2, address.AddressLine3);
        if (!string.IsNullOrWhiteSpace(secondaryLine))
        {
            _addressEdit.AddressLine2 = secondaryLine;
        }

        if (!string.IsNullOrWhiteSpace(address.District))
        {
            _addressEdit.District = address.District.Trim();
        }

        if (!string.IsNullOrWhiteSpace(address.City))
        {
            _addressEdit.City = address.City.Trim();
        }

        if (!string.IsNullOrWhiteSpace(address.StateProvince))
        {
            _addressEdit.StateProvince = address.StateProvince.Trim();
        }

        if (!string.IsNullOrWhiteSpace(address.PostalCode))
        {
            _addressEdit.PostalCode = address.PostalCode.Trim();
        }

        if (LooksLikeThaiAddress(address))
        {
            var thaiCountryId = DefaultCountryId();
            if (thaiCountryId != Guid.Empty)
            {
                _addressEdit.CountryId = thaiCountryId;
            }
        }
    }

    private static bool HasAnyExtractedAddressField(ExtractedAddress address) =>
        !string.IsNullOrWhiteSpace(address.RecipientName) ||
        !string.IsNullOrWhiteSpace(address.AddressLine1) ||
        !string.IsNullOrWhiteSpace(address.AddressLine2) ||
        !string.IsNullOrWhiteSpace(address.AddressLine3) ||
        !string.IsNullOrWhiteSpace(address.District) ||
        !string.IsNullOrWhiteSpace(address.City) ||
        !string.IsNullOrWhiteSpace(address.StateProvince) ||
        !string.IsNullOrWhiteSpace(address.PostalCode) ||
        address.Location is not null;

    private static bool HasRegistrySearchTerms(ExtractedAddress address) =>
        !string.IsNullOrWhiteSpace(address.PostalCode) ||
        !string.IsNullOrWhiteSpace(address.District) ||
        !string.IsNullOrWhiteSpace(address.City) ||
        !string.IsNullOrWhiteSpace(address.StateProvince);

    private static string BuildExtractedAddressQuery(ExtractedAddress address)
    {
        var parts = new[]
        {
            address.AddressLine1,
            address.AddressLine2,
            address.AddressLine3,
            address.District,
            address.City,
            address.StateProvince,
            address.PostalCode
        };

        return string.Join(", ", parts
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Select(part => part!.Trim()));
