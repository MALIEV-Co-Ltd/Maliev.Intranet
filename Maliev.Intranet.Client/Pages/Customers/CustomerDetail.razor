    private async Task SaveEmailTemplateAsync()
    {
        if (EmailTemplateSaveDisabled)
        {
            return;
        }

        var templateKey = NormalizeTemplateKey(_emailTemplateKey);
        if (!IsTemplateKeyValid(templateKey))
        {
            _emailTemplateError = "Template key must be kebab-case and start with a letter.";
            return;
        }

        _savingEmailTemplate = true;
        _emailTemplateError = null;

        try
        {
            HttpResponseMessage response;
            if (EmailTemplateIsNew)
            {
                response = await Http.PostAsJsonAsync("api/v1/notifications/templates", new CreateNotificationTemplateRequest
                {
                    Name = _emailTemplateName.Trim(),
                    TemplateKey = templateKey,
                    SubjectTemplate = _emailTemplateSubject.Trim(),
                    BodyTemplate = _emailTemplateBody.Trim(),
                    ChannelType = "email",
                    Language = "en",
                    Version = 1
                });
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/v1/notifications/templates/{_selectedEmailTemplateId}", new UpdateNotificationTemplateRequest
                {
                    Name = _emailTemplateName.Trim(),
                    SubjectTemplate = _emailTemplateSubject.Trim(),
                    BodyTemplate = _emailTemplateBody.Trim(),
                    IsActive = _emailTemplateIsActive
                });
            }

            if (!response.IsSuccessStatusCode)
            {
                _emailTemplateError = "Template could not be saved.";
                return;
            }

            var savedTemplate = await response.Content.ReadFromJsonAsync<NotificationTemplateDto>();
            if (savedTemplate is not null)
            {
                UpsertEmailTemplate(savedTemplate);
                SelectEmailTemplate(savedTemplate);
            }
        }
        catch (Exception ex)
        {
            _emailTemplateError = "Template could not be saved.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _savingEmailTemplate = false;
        }
    }

    private void UpsertEmailTemplate(NotificationTemplateDto template)
    {
        _emailTemplates.RemoveAll(existing => existing.Id == template.Id);
        _emailTemplates.Add(template);
        _emailTemplates.Sort((left, right) =>
        {
            var activeCompare = right.IsActive.CompareTo(left.IsActive);
            return activeCompare != 0 ? activeCompare : string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase);
        });
    }

    private string RenderEmailTemplate(string template)
    {
        if (_customer is null)
        {
            return template;
        }

        var companyName = string.IsNullOrWhiteSpace(_customer.CompanyName) ? _customer.Name : _customer.CompanyName;
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["customerName"] = _customer.Name,
            ["name"] = _customer.Name,
            ["customerEmail"] = _customer.Email,
            ["email"] = _customer.Email,
            ["companyName"] = companyName,
            ["customerCode"] = CustomerCode
        };

        var rendered = template;
        foreach (var pair in values)
        {
            rendered = rendered.Replace($"{{{{{pair.Key}}}}}", pair.Value, StringComparison.OrdinalIgnoreCase);
        }

        return rendered;
    }

