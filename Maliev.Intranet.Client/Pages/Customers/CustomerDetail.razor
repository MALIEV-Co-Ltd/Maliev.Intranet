                </label>
                <label class="customer-field">
                    <span>Contact email</span>
                    <input class="customer-input" type="email" @bind="_companyEdit.ContactEmail" @bind:event="oninput" />
                </label>
                <label class="customer-field">
                    <span>Contact phone</span>
                    <input class="customer-input" @bind="_companyEdit.ContactPhone" @bind:event="oninput" />
                </label>
            </div>
        </div>
    }
</ConfirmModal>

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerDetailDto? _customer;
    private CustomerEditModel? _edit;
    private readonly List<ProjectSummaryDto> _projects = [];
    private readonly List<OrderSummaryDto> _orders = [];
    private readonly List<CustomerActivityResponse> _activity = [];
    private PaginationMeta _activityMeta = new();
    private readonly List<PaymentTermDto> _paymentTerms = [];
    private CustomerDetailTab _activeTab = CustomerDetailTab.Overview;
    private AddressEditModel? _addressEdit;
    private CompanyEditModel? _companyEdit;
    private bool _loading = true;
    private bool _saving;
    private bool _postingNote;
    private bool _sendingEmail;
    private bool _savingCompany;
    private bool _emailComposerOpen;
    private bool _emailQueued;
    private bool _emailTemplatesLoading;
    private bool _savingEmailTemplate;
    private bool _paymentTermsOpen;
    private bool _activityLoading;
    private string? _error;
    private string _emailSubject = string.Empty;
    private string _emailBody = string.Empty;
    private string? _emailError;
    private string? _emailTemplateError;
    private Guid? _selectedEmailTemplateId;
    private string _emailTemplateName = string.Empty;
    private string _emailTemplateKey = string.Empty;
    private string _emailTemplateSubject = string.Empty;
    private string _emailTemplateBody = string.Empty;
    private bool _emailTemplateIsActive = true;
    private string _newNoteText = string.Empty;
    private string _activitySearch = string.Empty;
    private const int InternalNoteMaxLength = 5000;
    private string _addressLookupQuery = string.Empty;
    private bool _addressLookupLoading;
    private string? _addressLookupMessage;
    private bool _addressLookupMessageIsWarning;
    private bool _applyingLocation;
    private bool _addressMapInitialized;
    private bool _addressMapNeedsSavedAddress;
    private AddressField? _activeAddressSuggestionField;
    private AddressLanguage _addressLookupLanguage = AddressLanguage.English;
    private AddressLanguage _addressSuggestionLanguage = AddressLanguage.English;
    private AddressGeocodeResponse? _addressMapLocation;
    private string _companyLookupQuery = string.Empty;
    private int _projectTotalCount;
    private int _orderTotalCount;
    private int _activityPage = 1;
    private int _activityPageSize = 20;
    private readonly List<CountryDto> _countries = [];
    private readonly List<EmployeeSummaryDto> _accountManagers = [];
    private readonly List<RegistryThaiLocation> _locationMatches = [];
    private readonly List<RegistryThaiLocation> _fieldLocationMatches = [];
    private readonly List<CompanySearchResultDto> _companyMatches = [];
    private readonly List<RegistryCompanyProfile> _registryCompanyMatches = [];
    private readonly List<NotificationTemplateDto> _emailTemplates = [];

    private string CustomerType => HasCompany ? "Company" : "Individual";
    private bool HasCompany => _customer?.CompanyId is not null || !string.IsNullOrWhiteSpace(_customer?.CompanyName);
    private string AccountManager => ResolveAccountManagerName(_edit?.AccountManagerEmployeeId ?? _customer?.AccountManagerEmployeeId);
    private string TaxId => _customer?.CompanyVatNumber ?? _customer?.CompanyRegistrationNumber ?? "-";
    private string CompanyBranchLabel => HasCompany ? "Head office / สำนักงานใหญ่" : "-";
    private string CustomerCode => _customer is null ? "-" : $"C-{_customer.Id.ToString("N")[..8].ToUpperInvariant()}";
    private int ProjectCount => _projectTotalCount > 0 ? _projectTotalCount : _projects.Count;
    private int LifetimeOrderCount => _orderTotalCount > 0 ? _orderTotalCount : Math.Max(_orders.Count, _customer?.ActiveOrdersCount ?? 0);
    private decimal AverageOrderValue => LifetimeOrderCount > 0 && _customer is not null ? _customer.TotalSpent / LifetimeOrderCount : 0m;
    private string LastOrderText => _orders.Count == 0 ? "-" : FormatDate(_orders.Max(order => order.CreatedAt));
    private string NewProjectHref => $"/sales/projects/new?customerId={Id}";
    private int ActivityTotalCount => _activityMeta.TotalItems > 0 ? _activityMeta.TotalItems : _activityMeta.TotalCount;
    private string AuditTrailTitle => $"Audit trail ({ActivityTotalCount:N0})";
    private bool HasActivitySearch => !string.IsNullOrWhiteSpace(_activitySearch);
    private bool HasPagedActivity => ActivityTotalCount > 0 || ActivityFeed.Count > 0;
    private string EmptyActivityMessage => HasActivitySearch ? "No activity matches this search." : "No activity recorded.";
    private string AddressModalTitle => _addressEdit?.Id is null ? "Add address" : "Edit address";
    private string AddressMapElementId => $"customer-address-map-{Id:N}";
    private bool AddressProvinceLocked => _addressEdit is not null
        && _addressEdit.IsGoogleAddress
        && !string.IsNullOrWhiteSpace(_addressEdit.StateProvince);
    private bool AddressPostalCodeLocked => _addressEdit is not null
        && _addressEdit.IsGoogleAddress
        && !string.IsNullOrWhiteSpace(_addressEdit.PostalCode);
    private PaymentTermDto? SelectedPaymentTerm => _edit is null
        ? null
        : _paymentTerms.FirstOrDefault(term => string.Equals(term.Name, _edit.PaymentTerms, StringComparison.Ordinal));
    private string PaymentTermTriggerTitle => SelectedPaymentTerm?.Name ?? _edit?.PaymentTerms ?? "Select payment term";
    private string PaymentTermTriggerSummary => SelectedPaymentTerm is { } term ? PaymentTermSummary(term) : "Custom term";
    private string PaymentTermTriggerDescription => SelectedPaymentTerm is { } term
        ? PaymentTermDescription(term)
        : "No saved payment-term definition is available for this customer value.";
    private string PaymentTermTriggerUse => SelectedPaymentTerm is { } term
        ? PaymentTermUse(term)
        : "Keep this value when the customer uses a negotiated term that is not in the standard list.";
    private string CompanyConfirmLabel => _savingCompany
        ? (_companyEdit?.ExistingCompanyId is Guid ? "Linking..." : "Creating...")
        : (_companyEdit?.ExistingCompanyId is Guid ? "Link company" : "Create and link");
    private bool CompanyConfirmDisabled => _savingCompany || _saving;
    private string EmailConfirmLabel => _sendingEmail ? "Sending..." : _emailQueued ? "Queued" : "Send email";
    private bool EmailConfirmDisabled => _sendingEmail || _emailQueued;
    private bool EmailTemplateIsNew => _selectedEmailTemplateId is null;
    private string EmailTemplateSaveLabel => _savingEmailTemplate
        ? "Saving..."
        : EmailTemplateIsNew ? "Create template" : "Update template";
    private bool EmailTemplateSaveDisabled => _savingEmailTemplate ||
        string.IsNullOrWhiteSpace(_emailTemplateName) ||
        string.IsNullOrWhiteSpace(_emailTemplateKey) ||
        string.IsNullOrWhiteSpace(_emailTemplateSubject) ||
        string.IsNullOrWhiteSpace(_emailTemplateBody);
    private int NoteCharacterCount => _newNoteText.Length;
    private bool CanPostInternalNote => !_postingNote && !string.IsNullOrWhiteSpace(_newNoteText) && NoteCharacterCount <= InternalNoteMaxLength;
    private string NoteCounterClass => NoteCharacterCount > InternalNoteMaxLength ? "customer-note-counter over-limit" : "customer-note-counter";
    private string AddressLookupStateClass => _addressLookupMessageIsWarning
        ? "customer-address-lookup-state warning"
        : "customer-address-lookup-state success";
    private string AccountManagerSelectValue
    {
        get => _edit?.AccountManagerEmployeeId?.ToString() ?? string.Empty;
        set
        {
            if (_edit is null)
            {
                return;
            }

            _edit.AccountManagerEmployeeId = Guid.TryParse(value, out var employeeId) ? employeeId : null;
        }
    }

    private AddressResponse? BillingAddress =>
        CanonicalDefaultAddress("Billing")
        ?? _customer?.CompanyBillingAddress
        ?? _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Billing"));

    private AddressResponse? ShippingAddress =>
        CanonicalDefaultAddress("Shipping")
        ?? _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Shipping"));

    private AddressResponse? CanonicalDefaultAddress(string type) =>
        _customer?.Addresses
            .Where(address => IsAddressType(address, type) && address.IsDefault)
            .OrderByDescending(address => address.UpdatedAt)
            .ThenByDescending(address => address.CreatedAt)
            .ThenByDescending(address => address.Id)
            .FirstOrDefault();

    private bool IsCanonicalDefaultAddress(AddressResponse address)
    {
        var canonical = CanonicalDefaultAddress(address.Type);
        return canonical is not null &&
            (ReferenceEquals(canonical, address) || canonical.Id != Guid.Empty && canonical.Id == address.Id);
    }

    private IReadOnlyList<CustomerActivityResponse> ActivityFeed => _activity;

    private IReadOnlyList<CustomerActivityResponse> NoteActivityFallback =>
        _customer?.Notes.OrderByDescending(note => note.CreatedAt)
            .Select(note => new CustomerActivityResponse
            {
                Action = "Note",
                Description = note.NoteText,
                ActorName = note.CreatedByName,
                Timestamp = note.CreatedAt
            })
            .ToList() ?? [];

    private IReadOnlyList<CustomerActivityResponse> RecentActivity => (_activity.Count > 0 ? _activity : NoteActivityFallback).Take(5).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_addressEdit is not null && !_addressMapInitialized)
        {
            _addressMapInitialized = true;
            await JS.InvokeVoidAsync("malievAddressMap.initialize", AddressMapElementId);
            if (_addressMapNeedsSavedAddress)
            {
                _addressMapNeedsSavedAddress = false;
                await GeocodeSavedAddressAsync();
                StateHasChanged();
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/v1/customers/{Id}");
            if (_customer is null)
            {
                _error = "Customer was not found.";
                return;
            }

            _edit = CustomerEditModel.FromCustomer(_customer);
            await Task.WhenAll(LoadProjectsAsync(), LoadOrdersAsync(), LoadActivityAsync(), LoadCountriesAsync(), LoadAccountManagersAsync(), LoadPaymentTermsAsync());
        }
        catch (Exception ex)
        {
            _error = "Customer could not be loaded.";
            Snackbar.Add(_error, Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<ProjectSummaryDto>>($"api/v1/projects?customerId={Id}&page=1&pageSize=20");
            _projects.Clear();
            _projects.AddRange(response?.Data.OrderByDescending(project => project.CreatedAt).ToList() ?? []);
            _projectTotalCount = response?.Meta.TotalItems > 0
                ? response.Meta.TotalItems
                : response?.Meta.TotalCount ?? _projects.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>($"api/v1/orders?customerId={Id}&page=1&pageSize=20");
            _orders.Clear();
            _orders.AddRange(response?.Data.OrderByDescending(order => order.CreatedAt).ToList() ?? []);
            _orderTotalCount = response?.Meta.TotalItems > 0
                ? response.Meta.TotalItems
                : response?.Meta.TotalCount ?? _orders.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task LoadActivityAsync()
    {
        _activityLoading = true;

        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerActivityResponse>>(BuildActivityHistoryUrl());
            _activity.Clear();
            _activity.AddRange(response?.Data.OrderByDescending(activity => activity.Timestamp).ToList() ?? []);
            _activityMeta = response?.Meta ?? new PaginationMeta();
            _activityMeta.CurrentPage = _activityMeta.CurrentPage == 0 ? _activityPage : _activityMeta.CurrentPage;
            _activityMeta.PageSize = _activityMeta.PageSize == 0 ? _activityPageSize : _activityMeta.PageSize;
            _activityMeta.TotalCount = _activityMeta.TotalCount == 0 ? _activity.Count : _activityMeta.TotalCount;
            _activityMeta.TotalItems = _activityMeta.TotalItems == 0 ? _activityMeta.TotalCount : _activityMeta.TotalItems;
            _activityMeta.TotalPages = _activityMeta.TotalPages == 0 && _activityMeta.TotalItems > 0
                ? (int)Math.Ceiling((double)_activityMeta.TotalItems / Math.Max(1, _activityPageSize))
                : _activityMeta.TotalPages;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _activityLoading = false;
        }
    }

    private string BuildActivityHistoryUrl()
    {
        var parts = new List<string>
        {
            $"page={_activityPage}",
            $"pageSize={_activityPageSize}"
        };

        if (HasActivitySearch)
        {
            parts.Add($"search={Uri.EscapeDataString(_activitySearch.Trim())}");
        }

        return $"api/v1/customers/{Id}/history?{string.Join("&", parts)}";
    }

    private Task OnActivitySearchChanged(string? value)
    {
        _activitySearch = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SearchActivityAsync()
    {
        _activityPage = 1;
        await LoadActivityAsync();
    }

    private async Task SearchActivityClickedAsync(MouseEventArgs _) => await SearchActivityAsync();

    private async Task ClearActivitySearchAsync(MouseEventArgs _)
    {
        if (!HasActivitySearch)
        {
            return;
        }

        _activitySearch = string.Empty;
        _activityPage = 1;
        await LoadActivityAsync();
    }

    private async Task OnActivityPageChanged(int page)
    {
        _activityPage = Math.Max(1, page);
        await LoadActivityAsync();
    }

    private async Task OnActivityPageSizeChanged(int pageSize)
    {
        _activityPageSize = NormalizeActivityPageSize(pageSize);
        _activityPage = 1;
        await LoadActivityAsync();
    }

    private static int NormalizeActivityPageSize(int pageSize) => pageSize <= 0 ? 20 : pageSize;

    private void SelectTab(CustomerDetailTab tab) => _activeTab = tab;

    private string TabClass(CustomerDetailTab tab) => tab == _activeTab ? "active" : string.Empty;

    private string? TabCurrent(CustomerDetailTab tab) => tab == _activeTab ? "page" : null;

    private async Task LoadCountriesAsync()
    {
        if (_countries.Count > 0)
        {
            return;
        }

        var countries = await Http.GetFromJsonAsync<List<CountryDto>>("api/v1/customers/countries") ?? [];
        _countries.Clear();
        _countries.AddRange(countries.OrderBy(country => country.Name));
    }

    private async Task LoadAccountManagersAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<EmployeeSummaryDto>>("api/v1/employees?page=1&pageSize=100");
            _accountManagers.Clear();
            _accountManagers.AddRange((response?.Data ?? [])
                .Where(employee => employee.Id != Guid.Empty)
                .OrderByDescending(employee => string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .ThenBy(employee => employee.Name));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private Task DiscardChangesAsync(MouseEventArgs _)
    {
        if (_customer is not null)
        {
            _edit = CustomerEditModel.FromCustomer(_customer);
        }

