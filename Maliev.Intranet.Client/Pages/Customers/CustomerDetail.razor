    private async Task SearchCompaniesAsync()
    {
        _companyMatches.Clear();
        _registryCompanyMatches.Clear();
        if (string.IsNullOrWhiteSpace(_companyLookupQuery) || _companyLookupQuery.Trim().Length < 2)
        {
            return;
        }

        try
        {
            var query = Uri.EscapeDataString(_companyLookupQuery.Trim());
            var internalTask = Http.GetFromJsonAsync<List<CompanySearchResultDto>>($"api/v1/companies/search?query={query}&limit=8");
            var registryTask = Http.GetFromJsonAsync<List<RegistryCompanyProfile>>($"api/v1/customers/companies/search?query={query}&limit=8");

            await Task.WhenAll(internalTask, registryTask);
            _companyMatches.AddRange((await internalTask) ?? []);
            _registryCompanyMatches.AddRange((await registryTask) ?? []);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Company lookup could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

