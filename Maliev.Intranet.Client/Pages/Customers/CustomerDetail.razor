@page "/customers/{Id:guid}"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@((_customer?.Name ?? "Customer") + " | MALIEV Intranet")</PageTitle>

<div class="mlv-module-shell customer-record-shell">
    <PageHeader Title="@(_customer?.Name ?? "Customer")" Subtitle="@(_customer?.CompanyName ?? _customer?.Email)" BackLabel="Customers" BackHref="/customers">
        @if (_customer is not null)
        {
            <SecondaryButton Icon="@Icons.Material.Outlined.Email" OnClick="SendCustomerEmailAsync" Disabled="@(_sendingEmail || string.IsNullOrWhiteSpace(_customer.Email))">Send email</SecondaryButton>
            <SecondaryButton OnClick="DiscardChangesAsync" Disabled="@_saving">Discard</SecondaryButton>
            <PrimaryButton Icon="@Icons.Material.Outlined.Check" OnClick="SaveCustomerAsync" Disabled="@_saving">Save</PrimaryButton>
        }
    </PageHeader>

    <nav class="customer-record-tabs" aria-label="Customer sections">
        <button type="button" data-tab="overview" class="@TabClass(CustomerDetailTab.Overview)" aria-current="@TabCurrent(CustomerDetailTab.Overview)" @onclick="@(() => SelectTab(CustomerDetailTab.Overview))">Overview</button>
        <button type="button" data-tab="addresses" class="@TabClass(CustomerDetailTab.Addresses)" aria-current="@TabCurrent(CustomerDetailTab.Addresses)" @onclick="@(() => SelectTab(CustomerDetailTab.Addresses))">Addresses (@(_customer?.Addresses.Count ?? 0))</button>
        <button type="button" data-tab="projects" class="@TabClass(CustomerDetailTab.Projects)" aria-current="@TabCurrent(CustomerDetailTab.Projects)" @onclick="@(() => SelectTab(CustomerDetailTab.Projects))">Projects (@ProjectCount.ToString("N0"))</button>
        <button type="button" data-tab="orders" class="@TabClass(CustomerDetailTab.Orders)" aria-current="@TabCurrent(CustomerDetailTab.Orders)" @onclick="@(() => SelectTab(CustomerDetailTab.Orders))">Orders</button>
        <button type="button" data-tab="notes" class="@TabClass(CustomerDetailTab.Notes)" aria-current="@TabCurrent(CustomerDetailTab.Notes)" @onclick="@(() => SelectTab(CustomerDetailTab.Notes))">Notes (@(_customer?.Notes.Count ?? 0))</button>
        <button type="button" data-tab="activity" class="@TabClass(CustomerDetailTab.Activity)" aria-current="@TabCurrent(CustomerDetailTab.Activity)" @onclick="@(() => SelectTab(CustomerDetailTab.Activity))">Activity</button>
    </nav>

    <PageBody Class="customer-record-body">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }
        else if (_customer is null || _edit is null)
        {
            <div class="mlv-empty">Customer was not found.</div>
        }
        else if (_activeTab == CustomerDetailTab.Overview)
        {
            <div class="customer-record-grid">
                <div class="customer-record-main">
                    <section class="customer-panel">
                        <SectionTitle Text="Contact information" />
                        <div class="customer-form-grid">
                            <label class="customer-field">
                                <span>Full name</span>
                                <input class="customer-input" @bind="_edit.FullName" />
                            </label>
                            <label class="customer-field">
                                <span>Company</span>
                                <div class="customer-split-field">
                                    <input class="customer-input" readonly value="@_edit.Company" />
                                    <button type="button" class="customer-inline-action" @onclick="OpenCompanyModalAsync">Link</button>
                                </div>
                            </label>
                            <label class="customer-field">
                                <span>Email</span>
                                <input class="customer-input" type="email" @bind="_edit.Email" />
                            </label>
                            <label class="customer-field">
                                <span>Phone</span>
                                <input class="customer-input" @bind="_edit.Phone" />
                            </label>
                        </div>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Account &amp; billing" />
                        <div class="customer-form-grid">
                            <label class="customer-field">
                                <span>Customer type</span>
                                <select class="customer-input" @bind="_edit.CustomerType">
                                    <option>Company</option>
                                    <option>Individual</option>
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Status</span>
                                <select class="customer-input" @bind="_edit.Status">
                                    <option>Active</option>
                                    <option>Lead</option>
                                    <option>Inactive</option>
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Account manager</span>
                                <select class="customer-input" @bind="AccountManagerSelectValue">
                                    <option value="">Unassigned</option>
                                    @if (_edit?.AccountManagerEmployeeId is Guid selectedManagerId && !_accountManagers.Any(employee => employee.Id == selectedManagerId))
                                    {
                                        <option value="@selectedManagerId">@AccountManager</option>
                                    }
                                    @foreach (var employee in _accountManagers)
                                    {
                                        <option value="@employee.Id">@FormatEmployeeOption(employee)</option>
                                    }
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Payment terms</span>
                                <select class="customer-input" @bind="_edit!.PaymentTerms">
                                    <option>Due on receipt</option>
                                    <option>Net 15</option>
                                    <option>Net 30</option>
                                    <option>Net 45</option>
                                </select>
                            </label>
                            <label class="customer-field">
                                <span>Tax ID</span>
                                <input class="customer-input" readonly value="@TaxId" />
                            </label>
                            <label class="customer-field">
                                <span>Credit limit (USD)</span>
                                <input class="customer-input" readonly value="@CreditLimit" />
                            </label>
                        </div>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent projects" />
                        @if (_projects.Count > 0)
                        {
                            <table class="customer-orders-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Created</th>
                                        <th>Parts</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in _projects.Take(6))
                                    {
                                        <tr>
                                            <td>
                                                <a href="@($"/sales/projects/{project.Id}")">@project.ProjectNumber</a>
                                                <div class="customer-table-subtext">@project.Title</div>
                                            </td>
                                            <td>@FormatDate(project.CreatedAt)</td>
                                            <td>@project.PartsCount.ToString("N0")</td>
                                            <td class="mlv-mono">@FormatMoney(project.TotalPrice)</td>
                                            <td><StatusBadge Status="@project.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="customer-muted-box">No active projects yet.</div>
                        }
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent orders" />
                        @if (_orders.Count > 0)
                        {
                            <table class="customer-orders-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Parts</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in _orders.Take(6))
                                    {
                                        <tr>
                                            <td><a href="@($"/orders/{order.Id}")">@order.OrderNumber</a></td>
                                            <td>@FormatDate(order.CreatedAt)</td>
                                            <td>-</td>
                                            <td class="mlv-mono">@FormatMoney(ResolveOrderTotal(order))</td>
                                            <td><StatusBadge Status="@order.Status" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="customer-muted-box">No recent orders yet.</div>
                        }
                    </section>
                </div>

                <aside class="customer-record-sidebar">
                    <section class="customer-panel">
                        <SectionTitle Text="Snapshot" />
                        <dl class="customer-snapshot">
                            <div><dt>Type</dt><dd><StatusBadge Text="@CustomerType" Status="@CustomerType" /></dd></div>
                            <div><dt>Customer ID</dt><dd>@CustomerCode</dd></div>
                            <div><dt>Joined</dt><dd>@FormatMonthYear(_customer.CreatedAt)</dd></div>
                            <div><dt>Last order</dt><dd>@LastOrderText</dd></div>
                            <div><dt>Lifetime orders</dt><dd>@LifetimeOrderCount.ToString("N0")</dd></div>
                            <div><dt>Lifetime revenue</dt><dd>@FormatMoney(_customer.TotalSpent)</dd></div>
                            <div><dt>Avg order</dt><dd>@FormatMoney(AverageOrderValue)</dd></div>
                        </dl>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Default addresses" />
                        <div class="customer-address-stack">
                            @if (BillingAddress is not null)
                            {
                                <div>
                                    <div class="customer-address-label">Bill to</div>
                                    <strong>@AddressName(BillingAddress, "Billing")</strong>
                                    <p>@FormatAddress(BillingAddress)</p>
                                </div>
                            }
                            @if (ShippingAddress is not null)
                            {
                                <div>
                                    <div class="customer-address-label ship">Ship to</div>
                                    <strong>@AddressName(ShippingAddress, "Shipping")</strong>
                                    <p>@FormatAddress(ShippingAddress)</p>
                                </div>
                            }
                            @if (BillingAddress is null && ShippingAddress is null)
                            {
                                <div class="customer-muted-box compact">No default addresses recorded.</div>
                            }
                        </div>
                        <button type="button" class="customer-inline-link" @onclick="@(() => SelectTab(CustomerDetailTab.Addresses))">Manage all addresses -></button>
                    </section>

                    <section class="customer-panel">
                        <SectionTitle Text="Recent activity" />
                        @if (RecentActivity.Count > 0)
                        {
                            <div class="customer-activity-list">
                                @foreach (var activity in RecentActivity)
                                {
                                    <div class="customer-activity-item">
                                        <MudIcon Icon="@ActivityIcon(activity.Action)" Size="Size.Small" />
                                        <div>
                                            <strong>@activity.Description</strong>
                                            <span>@(activity.ActorName ?? "System") - @FormatDateTime(activity.Timestamp)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="customer-muted-box compact">No activity recorded.</div>
                        }
                        <button type="button" class="customer-inline-link" @onclick="@(() => SelectTab(CustomerDetailTab.Activity))">View all activity -></button>
                    </section>
                </aside>
            </div>
        }
        else if (_activeTab == CustomerDetailTab.Addresses)
        {
            <section class="customer-panel customer-tab-panel" data-section="addresses">
                <div class="customer-section-head">
                    <SectionTitle Text="Address book" />
                    <PrimaryButton Icon="@Icons.Material.Outlined.Add" OnClick="OpenAddAddressAsync">Add address</PrimaryButton>
                </div>

                @if (_customer.Addresses.Count > 0)
                {
                    <div class="customer-address-book-grid">
                        @foreach (var address in _customer.Addresses.OrderByDescending(address => address.IsDefault).ThenBy(address => address.Type).ThenBy(address => AddressName(address, address.Type)))
                        {
                            <article class="customer-address-card">
                                <div class="customer-address-card-head">
                                    <div>
                                        <strong>@AddressName(address, address.Type)</strong>
                                        <StatusBadge Text="@address.Type" Status="@address.Type" />
                                    </div>
                                    <div class="customer-icon-actions">
                                        <button type="button" class="customer-icon-button customer-address-edit" title="Edit address" aria-label="Edit address" @onclick="@(() => OpenEditAddress(address))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                                        </button>
                                        <button type="button" class="customer-icon-button danger" title="Delete address" aria-label="Delete address" @onclick="@(() => DeleteAddressAsync(address))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                                        </button>
                                    </div>
                                </div>

                                <div class="customer-address-lines">
                                    @foreach (var line in FormatAddressLines(address))
                                    {
                                        <span>@line</span>
                                    }
                                </div>

                                <div class="customer-address-card-footer">
                                    @if (address.IsDefault)
                                    {
                                        <span class="customer-default-chip">Default @address.Type.ToLowerInvariant()</span>
                                    }
                                    else
                                    {
                                        <SecondaryButton Class="compact" OnClick="@(args => SetDefaultAddressAsync(address))">Set default @address.Type.ToLowerInvariant()</SecondaryButton>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No addresses recorded.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Projects)
        {
            <section class="customer-panel customer-tab-panel customer-projects-panel" data-section="projects">
                <SectionTitle Text="@($"All projects ({ProjectCount:N0})")" />
                @if (_projects.Count > 0)
                {
                    <table class="customer-orders-table">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Created</th>
                                <th>Parts</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in _projects)
                            {
                                <tr>
                                    <td>
                                        <a href="@($"/sales/projects/{project.Id}")">@project.ProjectNumber</a>
                                        <div class="customer-table-subtext">@project.Title</div>
                                    </td>
                                    <td>@FormatDate(project.CreatedAt)</td>
                                    <td>@project.PartsCount.ToString("N0")</td>
                                    <td class="mlv-mono">@FormatMoney(project.TotalPrice)</td>
                                    <td><StatusBadge Status="@project.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="customer-muted-box">No projects recorded for this customer.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Orders)
        {
            <section class="customer-panel customer-tab-panel customer-orders-panel" data-section="orders">
                <SectionTitle Text="@($"All orders ({LifetimeOrderCount:N0})")" />
                @if (_orders.Count > 0)
                {
                    <table class="customer-orders-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Parts</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr>
                                    <td><a href="@($"/orders/{order.Id}")">@order.OrderNumber</a></td>
                                    <td>@FormatDate(order.CreatedAt)</td>
                                    <td>-</td>
                                    <td class="mlv-mono">@FormatMoney(ResolveOrderTotal(order))</td>
                                    <td><StatusBadge Status="@order.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="customer-muted-box">No orders recorded for this customer.</div>
                }
            </section>
        }
        else if (_activeTab == CustomerDetailTab.Notes)
        {
            <div class="customer-notes-layout" data-section="notes">
                <section class="customer-panel customer-note-composer">
                    <SectionTitle Text="Add internal note" />
                    <textarea class="customer-textarea" rows="4" placeholder="Write a note visible only to your team..." @bind="_newNoteText"></textarea>
                    <div class="customer-panel-actions">
                        <PrimaryButton OnClick="PostNoteAsync" Disabled="@string.IsNullOrWhiteSpace(_newNoteText)">Post note</PrimaryButton>
                    </div>
                </section>

                @if (_customer.Notes.Count > 0)
                {
                    <div class="customer-note-list">
                        @foreach (var note in _customer.Notes.OrderByDescending(note => note.CreatedAt))
                        {
                            <article class="customer-note-card">
                                <Avatar Name="@(note.CreatedByName ?? note.CreatedByEmail ?? "MALIEV")" />
                                <div>
                                    <div class="customer-note-meta">
                                        <strong>@(note.CreatedByName ?? "System")</strong>
                                        <span>@FormatDate(note.CreatedAt)</span>
                                    </div>
                                    <p>@note.NoteText</p>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No internal notes yet.</div>
                }
            </div>
        }
        else if (_activeTab == CustomerDetailTab.Activity)
        {
            <section class="customer-panel customer-tab-panel customer-activity-panel" data-section="activity">
                <SectionTitle Text="Audit trail" />
                @if (ActivityFeed.Count > 0)
                {
                    <div class="customer-audit-list">
                        @foreach (var activity in ActivityFeed)
                        {
                            <div class="customer-activity-item">
                                <MudIcon Icon="@ActivityIcon(activity.Action)" Size="Size.Small" />
                                <div>
                                    <strong>@activity.Description</strong>
                                    <span>@(activity.ActorName ?? "System") - @FormatDateTime(activity.Timestamp)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="customer-muted-box">No activity recorded.</div>
                }
            </section>
        }
    </PageBody>
</div>

<ConfirmModal Open="@(_addressEdit is not null)"
              Title="@AddressModalTitle"
              ConfirmLabel="Save"
              Class="customer-modal-wide"
              OnCancel="CloseAddressModalAsync"
              OnConfirm="SaveAddressAsync">
    @if (_addressEdit is not null)
    {
        <div class="customer-address-form">
            <div class="customer-form-grid">
                <label class="customer-field">
                    <span>Recipient name</span>
                    <input class="customer-input" @bind="_addressEdit.Label" />
                </label>
                <label class="customer-field">
                    <span>Type</span>
                    <select class="customer-input" @bind="_addressEdit.Type">
                        <option>Billing</option>
                        <option>Shipping</option>
                        <option>Office</option>
                    </select>
                </label>
                <label class="customer-field customer-span-2">
                    <span>Address lookup</span>
                    <div class="customer-split-field">
                        <input class="customer-input" placeholder="Postal code, province, district..." @bind="_addressLookupQuery" />
                        <button type="button" class="customer-inline-action" @onclick="SearchLocationsAsync">Search</button>
                    </div>
                </label>
                @if (_locationMatches.Count > 0)
                {
                    <div class="customer-result-list customer-span-2">
                        @foreach (var location in _locationMatches)
                        {
                            <button type="button" @onclick="@(() => ApplyLocation(location))">
                                @FormatLocation(location)
                            </button>
                        }
                    </div>
                }
                <label class="customer-field customer-span-2">
                    <span>Street</span>
                    <input class="customer-input" @bind="_addressEdit.AddressLine1" />
                </label>
                <label class="customer-field customer-span-2">
                    <span>Street 2</span>
                    <input class="customer-input" @bind="_addressEdit.AddressLine2" />
                </label>
                <label class="customer-field">
                    <span>City</span>
                    <input class="customer-input" @bind="_addressEdit.City" />
                </label>
                <label class="customer-field">
                    <span>District / sub-district</span>
                    <input class="customer-input" @bind="_addressEdit.District" />
                </label>
                <label class="customer-field">
                    <span>State / province</span>
                    <input class="customer-input" @bind="_addressEdit.StateProvince" />
                </label>
                <label class="customer-field">
                    <span>Postal</span>
                    <input class="customer-input" @bind="_addressEdit.PostalCode" />
                </label>
                <label class="customer-field">
                    <span>Country</span>
                    <select class="customer-input" @bind="_addressEdit.CountryId">
                        <option value="@Guid.Empty">Select country</option>
                        @foreach (var country in _countries)
                        {
                            <option value="@country.Id">@country.Name</option>
                        }
                    </select>
                </label>
                <label class="customer-checkbox-row customer-span-2">
                    <input type="checkbox" @bind="_addressEdit.IsDefault" />
                    <span>Default for this address type</span>
                </label>
            </div>
        </div>
    }
</ConfirmModal>

<ConfirmModal Open="@(_companyEdit is not null)"
              Title="Link company"
              ConfirmLabel="@CompanyConfirmLabel"
              Class="customer-modal-wide"
              OnCancel="CloseCompanyModalAsync"
              OnConfirm="SaveCompanyAsync">
    @if (_companyEdit is not null)
    {
        <div class="customer-address-form">
            <div class="customer-form-grid">
                <label class="customer-field customer-span-2">
                    <span>Company lookup</span>
                    <div class="customer-split-field">
                        <input class="customer-input" placeholder="Name or tax ID..." @bind="_companyLookupQuery" />
                        <button type="button" class="customer-inline-action" @onclick="SearchCompaniesAsync">Search</button>
                    </div>
                </label>
                @if (_companyMatches.Count > 0 || _registryCompanyMatches.Count > 0)
                {
                    <div class="customer-result-list customer-span-2">
                        @foreach (var company in _companyMatches)
                        {
                            <button type="button" @onclick="@(() => ApplyCompany(company))">
                                @company.Name @(!string.IsNullOrWhiteSpace(company.VatNumber) ? $"({company.VatNumber})" : string.Empty)
                            </button>
                        }
                        @foreach (var company in _registryCompanyMatches)
                        {
                            <button type="button" @onclick="@(() => ApplyRegistryCompany(company))">
                                @(string.IsNullOrWhiteSpace(company.FullNameTh) ? company.CompanyNameTh : company.FullNameTh) @(!string.IsNullOrWhiteSpace(company.TaxId) ? $"({company.TaxId})" : string.Empty)
                            </button>
                        }
                    </div>
                }
                <label class="customer-field customer-span-2">
                    <span>Company name</span>
                    <input class="customer-input" @bind="_companyEdit.Name" />
                </label>
                <label class="customer-field">
                    <span>Tax ID</span>
                    <input class="customer-input" @bind="_companyEdit.VatNumber" />
                </label>
                <label class="customer-field">
                    <span>Registration number</span>
                    <input class="customer-input" @bind="_companyEdit.RegistrationNumber" />
                </label>
                <label class="customer-field">
                    <span>Contact email</span>
                    <input class="customer-input" type="email" @bind="_companyEdit.ContactEmail" />
                </label>
                <label class="customer-field">
                    <span>Contact phone</span>
                    <input class="customer-input" @bind="_companyEdit.ContactPhone" />
                </label>
            </div>
        </div>
    }
</ConfirmModal>

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerDetailDto? _customer;
    private CustomerEditModel? _edit;
    private readonly List<ProjectSummaryDto> _projects = [];
    private readonly List<OrderSummaryDto> _orders = [];
    private readonly List<CustomerActivityResponse> _activity = [];
    private CustomerDetailTab _activeTab = CustomerDetailTab.Overview;
    private AddressEditModel? _addressEdit;
    private CompanyEditModel? _companyEdit;
    private bool _loading = true;
    private bool _saving;
    private bool _sendingEmail;
    private string? _error;
    private string _newNoteText = string.Empty;
    private string _addressLookupQuery = string.Empty;
    private string _companyLookupQuery = string.Empty;
    private int _projectTotalCount;
    private int _orderTotalCount;
    private readonly List<CountryDto> _countries = [];
    private readonly List<EmployeeSummaryDto> _accountManagers = [];
    private readonly List<RegistryThaiLocation> _locationMatches = [];
    private readonly List<CompanySearchResultDto> _companyMatches = [];
    private readonly List<RegistryCompanyProfile> _registryCompanyMatches = [];

    private string CustomerType => HasCompany ? "Company" : "Individual";
    private bool HasCompany => _customer?.CompanyId is not null || !string.IsNullOrWhiteSpace(_customer?.CompanyName);
    private string AccountManager => ResolveAccountManagerName(_edit?.AccountManagerEmployeeId ?? _customer?.AccountManagerEmployeeId);
    private string TaxId => _customer?.CompanyVatNumber ?? _customer?.CompanyRegistrationNumber ?? "-";
    private const string CreditLimit = "0";
    private string CustomerCode => _customer is null ? "-" : $"C-{_customer.Id.ToString("N")[..8].ToUpperInvariant()}";
    private int ProjectCount => _projectTotalCount > 0 ? _projectTotalCount : _projects.Count;
    private int LifetimeOrderCount => _orderTotalCount > 0 ? _orderTotalCount : Math.Max(_orders.Count, _customer?.ActiveOrdersCount ?? 0);
    private decimal AverageOrderValue => LifetimeOrderCount > 0 && _customer is not null ? _customer.TotalSpent / LifetimeOrderCount : 0m;
    private string LastOrderText => _orders.Count == 0 ? "-" : FormatDate(_orders.Max(order => order.CreatedAt));
    private string AddressModalTitle => _addressEdit?.Id is null ? "Add address" : "Edit address";
    private string CompanyConfirmLabel => _companyEdit?.ExistingCompanyId is Guid ? "Link company" : "Create and link";
    private string AccountManagerSelectValue
    {
        get => _edit?.AccountManagerEmployeeId?.ToString() ?? string.Empty;
        set
        {
            if (_edit is null)
            {
                return;
            }

            _edit.AccountManagerEmployeeId = Guid.TryParse(value, out var employeeId) ? employeeId : null;
        }
    }

    private AddressResponse? BillingAddress =>
        _customer?.Addresses.FirstOrDefault(address => IsAddressType(address, "Billing") && address.IsDefault)
        ?? _customer?.CompanyBillingAddress
