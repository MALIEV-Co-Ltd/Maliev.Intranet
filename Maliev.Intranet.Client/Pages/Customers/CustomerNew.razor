        NotifyCustomerFieldChanged(nameof(CreateCustomerRequest.Mobile));
        NotifyCustomerFieldChanged(nameof(CreateCustomerRequest.Landline));
        NotifyCustomerFieldChanged(nameof(CreateCustomerRequest.Extension));
        NotifyCustomerFieldChanged(nameof(CreateCustomerRequest.Segment));
        NotifyCustomerFieldChanged(nameof(CreateCustomerRequest.Tier));
