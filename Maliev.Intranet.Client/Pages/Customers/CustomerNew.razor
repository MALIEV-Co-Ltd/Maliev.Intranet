    private AddressDraft ToAddressDraft(ExtractedAddress address)
    {
        var draft = new AddressDraft
        {
            SelectedLocation = address.Location,
            Request = new CreateAddressRequest
            {
                Type = NormalizeAddressType(address.Type),
                IsDefault = true,
                AddressLine1 = address.AddressLine1 ?? string.Empty,
                AddressLine2 = address.AddressLine2,
                AddressLine3 = address.AddressLine3,
                District = address.District,
                City = address.City ?? string.Empty,
                StateProvince = address.StateProvince ?? string.Empty,
                PostalCode = address.PostalCode ?? string.Empty,
                RecipientName = address.RecipientName,
                RecipientPhone = address.RecipientPhone,
                CountryId = _thailand?.Id ?? Guid.Empty
            }
        };

        return draft;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            _onboarding.Customer.CompanyId = _selectedCompanyId;
            _onboarding.NewCompany = BuildCompanyRequest();
            _onboarding.Addresses = _addresses
                .Where(a => !string.Equals(a.Request.Type, "Company Billing", StringComparison.OrdinalIgnoreCase))
                .Select(a => a.Request)
                .Where(HasAddressContent)
                .ToList();
            _onboarding.CompanyBillingAddress = BuildCompanyBillingAddress();
            _onboarding.Documents = BuildUploadedDocumentRequests();
            _onboarding.Nda = BuildNdaRequest();
            _onboarding.InternalNote = BuildInternalNote();

            var response = await Http.PostAsJsonAsync("api/v1/customers/create-basic", _onboarding);
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadApiErrorMessageAsync(response, "Customer could not be created.");
                return;
            }

            var customer = await response.Content.ReadFromJsonAsync<CustomerResponse>();
            if (customer == null)
            {
                _error = "Customer was created but the response was empty.";
                return;
            }

            Snackbar.Add("Customer created.", Severity.Success);
            Navigation.NavigateTo($"/customers/{customer.Id}");
        }
        catch (Exception ex)
        {
            _error = "Customer could not be created.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private CreateCompanyRequest? BuildCompanyRequest()
    {
        if (_selectedCompanyId.HasValue)
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(_companyName) && string.IsNullOrWhiteSpace(_companyTaxId))
        {
            return null;
        }

        return new CreateCompanyRequest
        {
            Name = string.IsNullOrWhiteSpace(_companyName) ? _companyTaxId : _companyName,
            VatNumber = string.IsNullOrWhiteSpace(_companyTaxId) ? null : _companyTaxId,
            RegistrationNumber = string.IsNullOrWhiteSpace(_companyTaxId) ? null : _companyTaxId,
            ContactEmail = _onboarding.Customer.Email,
            ContactPhone = _onboarding.Customer.Mobile,
            Segment = _onboarding.Customer.Segment,
            Tier = _onboarding.Customer.Tier
        };
    }

    private CreateAddressRequest? BuildCompanyBillingAddress()
    {
        var address = _addresses.FirstOrDefault(a => string.Equals(a.Request.Type, "Company Billing", StringComparison.OrdinalIgnoreCase));
        if (address == null || !HasAddressContent(address.Request))
        {
            return null;
        }

        return CloneAddress(address, "Billing").Request;
    }

    private string? BuildInternalNote()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_onboarding.InternalNote))
        {
            parts.Add(_onboarding.InternalNote.Trim());
        }

        if (!string.IsNullOrWhiteSpace(_companyName) || !string.IsNullOrWhiteSpace(_companyTaxId))
        {
            parts.Add($"Company branch: {GetBranchLabel()}");
        }

        return parts.Count == 0 ? null : string.Join(Environment.NewLine + Environment.NewLine, parts);
    }

    private List<CreateDocumentRequest> BuildUploadedDocumentRequests() =>
        _customerDocumentUploads
            .Concat(_ndaDocumentUploads)
            .Where(upload => upload.IsUploaded)
            .Select(upload => new CreateDocumentRequest
            {
                DocumentCategory = upload.Category,
                DocumentSubType = string.Equals(upload.Category, DocumentCategories.NDA, StringComparison.OrdinalIgnoreCase)
                    ? _ndaStatus
                    : upload.SubType,
                FileReference = upload.LinkReference,
                FileName = upload.FileName,
                FileSize = upload.FileSize,
                MimeType = upload.MimeType
            })
            .ToList();

    private CreateNDARequest? BuildNdaRequest()
    {
        var signedNda = _ndaDocumentUploads.FirstOrDefault(upload => upload.IsUploaded);
        if (signedNda == null)
        {
            return null;
        }

        return new CreateNDARequest
        {
            ExpiresAt = _ndaExpiresAt,
            IsActive = string.Equals(_ndaStatus, "Signed", StringComparison.OrdinalIgnoreCase),
            FileReference = signedNda.LinkReference,
            FileName = signedNda.FileName
        };
    }

    private async Task UploadDocumentGroupAsync(
        IReadOnlyList<IBrowserFile> files,
        List<UploadedDocumentDraft> target,
        string category,
        string? subType,
        int limit)
    {
        var acceptedFiles = files
            .Take(limit)
            .Where(file => !target.Any(existing => existing.FileName == file.Name && existing.FileSize == file.Size))
            .ToList();

        if (acceptedFiles.Count == 0)
        {
            return;
        }

        var drafts = acceptedFiles.Select(file => new UploadedDocumentDraft
        {
            Category = category,
            SubType = subType,
            FileName = file.Name,
            FileSize = file.Size,
            MimeType = string.IsNullOrWhiteSpace(file.ContentType) ? GetMimeType(file.Name) : file.ContentType,
            IsUploading = true
        }).ToList();

        target.AddRange(drafts);
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in acceptedFiles)
            {
                var stream = file.OpenReadStream(10 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }

            var uploadUrl = $"api/v1/aiprocessing/upload-documents?category={Uri.EscapeDataString(category)}";
            if (!string.IsNullOrWhiteSpace(subType))
            {
                uploadUrl += $"&subType={Uri.EscapeDataString(subType)}";
            }

            var response = await Http.PostAsync(uploadUrl, content);
            if (!response.IsSuccessStatusCode)
            {
                var error = await ReadApiErrorMessageAsync(response, $"{category} upload failed.");
                foreach (var draft in drafts)
                {
                    draft.Error = error;
                    draft.IsUploading = false;
                }

                Snackbar.Add(error, Severity.Warning);
                return;
            }

            var uploads = await response.Content.ReadFromJsonAsync<List<BffUploadResponse>>() ?? [];
            foreach (var draft in drafts)
            {
                var upload = uploads.FirstOrDefault(item => string.Equals(item.FileName, draft.FileName, StringComparison.OrdinalIgnoreCase))
                    ?? uploads.FirstOrDefault(item => string.IsNullOrWhiteSpace(item.FileName));

                if (upload == null)
                {
                    draft.Error = "Upload completed but no file reference was returned.";
                    draft.IsUploading = false;
                    continue;
                }

                draft.UploadId = upload.UploadId;
                draft.FileReference = upload.FileReference;
                draft.StoragePath = upload.StoragePath;
                draft.SignedUrl = upload.SignedUrl;
                draft.FileName = string.IsNullOrWhiteSpace(upload.FileName) ? draft.FileName : upload.FileName;
                draft.FileSize = upload.FileSize > 0 ? upload.FileSize : draft.FileSize;
                draft.IsUploading = false;
            }

            await PreviewUploadedDocumentAsync(drafts.FirstOrDefault(draft => draft.IsUploaded) ?? drafts[0]);
        }
        catch (Exception ex)
        {
            foreach (var draft in drafts)
            {
                draft.Error = ex.Message;
                draft.IsUploading = false;
            }

            Snackbar.Add($"{category} upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task<IEnumerable<CompanySearchResultDto>> SearchCompaniesAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            _companySuggestionCount = 0;
            return [];
        }

        return await Http.GetFromJsonAsync<List<CompanySearchResultDto>>(
            $"api/v1/companies/search?query={Uri.EscapeDataString(value.Trim())}&limit={CompanySuggestionSearchLimit}",
            ct) ?? [];
    }

    private async Task<IEnumerable<RegistryThaiLocation>> SearchLocationsAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2)
        {
            return [];
        }

        return await ReferenceData.AutocompleteLocationsAsync(value.Trim(), 8, ct);
    }

    private void OnCompanyLookupTextChanged(string value)
    {
        _companyLookup = value;
        _companySuggestionCount = string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2
            ? 0
            : _companySuggestionCount;

        if (string.Equals(value, _selectedCompanyLookupValue, StringComparison.Ordinal))
        {
            return;
        }

        _selectedCompanyId = null;
        _selectedCompanySource = null;
        _selectedCompanyLookupValue = null;
        _onboarding.Customer.CompanyId = null;
    }

    private void ApplyCompanySuggestion(CompanySearchResultDto? company)
    {
        if (company == null)
        {
            return;
        }

        _selectedCompanyId = company.Id;
        _selectedCompanySource = company.Source;
        _companyName = company.Name;
        _companyTaxId = NormalizeTaxId(company.VatNumber ?? company.RegistrationNumber);
        _companyLookup = company.Name;
        _selectedCompanyLookupValue = _companyLookup;
        _onboarding.Customer.CompanyId = company.Id;

        if (company.DefaultBillingAddress != null)
        {
            ApplyCompanyBillingAddress(company.DefaultBillingAddress);
        }

        SetCompanyBranch(null);
    }

    private async Task ApplyBestCompanyMatchAsync(string query)
    {
        var matches = (await SearchCompaniesAsync(query, CancellationToken.None)).ToList();
        if (matches.Count == 0)
        {
            return;
        }

        var normalizedQuery = NormalizeTaxId(query);
        var match = matches.FirstOrDefault(company =>
                string.Equals(NormalizeTaxId(company.VatNumber), normalizedQuery, StringComparison.OrdinalIgnoreCase)
                || string.Equals(NormalizeTaxId(company.RegistrationNumber), normalizedQuery, StringComparison.OrdinalIgnoreCase))
            ?? matches[0];

        ApplyCompanySuggestion(match);
    }

