    private async Task ExtractAsync(MouseEventArgs _)
    {
        _extracting = true;
        _showExtractionSummary = false;
        _error = null;
        _currentExtractionAttempt = 0;

        try
        {
            ExtractedCustomerDataResponse? bestResult = null;
            string? lastError = null;

            for (var attempt = 1; attempt <= MaxExtractionAttempts; attempt++)
            {
                _currentExtractionAttempt = attempt;
                StateHasChanged();

                var extracted = await RunExtractionAttemptAsync();
                if (extracted == null)
                {
                    lastError = _error ?? "Customer extraction returned no usable data.";
                    continue;
                }

                if (bestResult == null || extracted.Confidence > bestResult.Confidence)
                {
                    bestResult = extracted;
                }

                if (extracted.Confidence >= HighConfidenceThreshold)
                {
                    break;
                }
            }

            if (bestResult == null)
            {
                _error = lastError ?? "Customer information could not be extracted.";
                return;
            }

            _error = null;
            _lastExtractionAttempts = _currentExtractionAttempt;
            await ApplyExtractionAsync(bestResult);
            _lastExtraction = bestResult;
            _showExtractionSummary = true;
            _extractionFiles.Clear();
        }
        finally
        {
            _extracting = false;
            _currentExtractionAttempt = 0;
        }
    }

    private async Task<ExtractedCustomerDataResponse?> RunExtractionAttemptAsync()
    {
        using var content = new MultipartFormDataContent();
        if (!string.IsNullOrWhiteSpace(_extractionText))
        {
            content.Add(new StringContent(_extractionText), "rawText");
        }

        foreach (var file in _extractionFiles)
        {
            var stream = file.OpenReadStream(10 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(fileContent, "files", file.Name);
        }

        var response = await Http.PostAsync("api/v1/aiprocessing/extract-customer", content);
        if (!response.IsSuccessStatusCode)
        {
            _error = await ReadApiErrorMessageAsync(response, "Customer information could not be extracted.");
            return null;
        }

        return await response.Content.ReadFromJsonAsync<ExtractedCustomerDataResponse>();
    }

    private async Task ApplyExtractionAsync(ExtractedCustomerDataResponse extracted)
    {
        SetIfPresent(value => _onboarding.Customer.FirstName = value, extracted.FirstName);
        SetIfPresent(value => _onboarding.Customer.LastName = value, extracted.LastName);
        SetIfPresent(value => _onboarding.Customer.Email = value, extracted.Email);
        SetIfPresent(value => _onboarding.Customer.Mobile = value, extracted.Mobile);
        SetIfPresent(value => _onboarding.Customer.Landline = value, extracted.Landline);
        SetIfPresent(value => _onboarding.Customer.Extension = value, extracted.Extension);
        SetIfPresent(value => _companyName = value, extracted.CompanyName);

        if (!string.IsNullOrWhiteSpace(extracted.VatNumber))
        {
            _companyTaxId = NormalizeTaxId(extracted.VatNumber);
            _companyLookup = extracted.CompanyName?.Trim() ?? string.Empty;
            await ApplyBestCompanyMatchAsync(_companyTaxId);
        }
        else if (!string.IsNullOrWhiteSpace(extracted.CompanyName))
        {
            _companyLookup = extracted.CompanyName.Trim();
        }

        SetCompanyBranch(extracted.BranchNumber);

        if (extracted.Addresses?.Count > 0)
        {
            _addresses = DeduplicateExtractedAddresses(extracted.Addresses)
                .Take(3)
                .Select(ToAddressDraft)
                .ToList();
        }

        EnsureDefaultAddressSet();
        RefreshCustomerValidationState();
    }

