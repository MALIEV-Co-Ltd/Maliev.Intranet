    private void ApplyCompanyBillingAddress(AddressResponse address)
    {
        var index = CompanyBillingIndex;
        if (index < 0)
        {
            _addresses.Add(new AddressDraft { Request = new CreateAddressRequest { Type = "Company Billing", IsDefault = true, CountryId = _thailand?.Id ?? Guid.Empty } });
            index = _addresses.Count - 1;
        }

        _addresses[index] = new AddressDraft
        {
            Request = new CreateAddressRequest
            {
                Type = "Company Billing",
                IsDefault = true,
                AddressLine1 = address.AddressLine1,
                AddressLine2 = address.AddressLine2,
                AddressLine3 = address.AddressLine3,
                District = address.District,
                City = address.City,
                StateProvince = address.StateProvince,
                PostalCode = address.PostalCode,
                CountryId = address.CountryId,
                RecipientName = address.RecipientName,
                RecipientPhone = address.RecipientPhone
            }
        };
