    private static string FormatPair(string? first, string? second)
    {
        var values = new[] { first, second }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return values.Count == 0 ? "Not set" : string.Join(" / ", values);
    }

    private static string FormatValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not set" : value.Trim();

    private string FormatAddressSummary(int index)
    {
        if (index < 0 || index >= _addresses.Count || !HasAddressContent(_addresses[index].Request))
        {
            return "Not set";
        }

        var address = _addresses[index].Request;
        var parts = new[] { address.AddressLine1, address.District, address.City, address.StateProvince, address.PostalCode }
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim());

        return string.Join(", ", parts);
    }

    private static string NormalizeTaxId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        return trimmed.StartsWith("TH-", StringComparison.OrdinalIgnoreCase)
            ? $"TH-{new string(trimmed[3..].Where(char.IsDigit).ToArray())}"
            : new string(trimmed.Where(char.IsDigit).ToArray());
    }

