@page "/customers/new"
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Text.Json
@using Maliev.Intranet.Shared.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IReferenceDataService ReferenceData

<PageTitle>New Customer | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell customer-create-page">
    <PageHeader Title="New Customer" Subtitle="Create a complete customer, company, address, document, and NDA profile." BackHref="/customers" />

    <PageBody>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }

        <div class="customer-create-layout">
            <div class="customer-create-main">
                <PanelCard Title="AI data extraction">
                    <button type="button" class="ai-intake-toggle" @onclick="ToggleAiIntake">
                        <span>
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
                            <strong>Extract from text or documents</strong>
                        </span>
                        <span class="ai-intake-toggle-meta">
                            @if (_extracting)
                            {
                                <MudProgressCircular Size="Size.Small"
                                                     Color="Color.Primary"
                                                     Indeterminate="true"
                                                     Class="ai-processing-spinner" />
                            }
                            <span>@GetAiIntakeStatus()</span>
                            <MudIcon Icon="@(_aiIntakeExpanded ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" />
                        </span>
                    </button>

                    @if (_aiIntakeExpanded)
                    {
                        <div class="ai-intake">
                            <div class="ai-text-column">
                                <label class="ai-text-label" for="customer-extraction-text">Paste customer text</label>
                                <MudTextField T="string"
                                              Class="ai-text-input"
                                              InputId="customer-extraction-text"
                                              Value="@_extractionText"
                                              ValueChanged="@((string value) => _extractionText = value)"
                                              Variant="Variant.Outlined"
                                              Lines="5"
                                              MaxLines="10"
                                              Sizing="InputSizing.Auto"
                                              FullWidth="true"
                                              Margin="Margin.None"
                                              Immediate="true"
                                              Placeholder="Paste an email signature, business card text, tax invoice details, or customer request..." />
                            </div>

                            <div class="ai-file-column">
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                               FilesChanged="OnExtractionFilesSelected"
                                               Accept=".pdf,.jpg,.jpeg,.png,.docx,.txt"
                                               Class="ai-file-upload"
                                               Hidden="true"
                                               MaximumFileCount="10">
                                    <CustomContent Context="uploadContext">
                                        <button type="button" class="document-dropzone ai-dropzone" @onclick="@uploadContext.OpenFilePickerAsync">
                                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
                                            <span>
                                                <strong>AI extraction files</strong>
                                                <small>Choose one or more PDFs, images, DOCX, or text files</small>
                                            </span>
                                        </button>
                                    </CustomContent>
                                </MudFileUpload>

                                @if (_extractionFiles.Count > 0)
                                {
                                    <div class="ai-selected-files" aria-label="Selected AI extraction files">
                                        @foreach (var file in _extractionFiles)
                                        {
                                            <div class="ai-selected-file">
                                                <MudIcon Icon="@Icons.Material.Outlined.Description" />
                                                <span>
                                                    <strong>@file.Name</strong>
                                                    <small>@FormatFileSize(file.Size)</small>
                                                </span>
                                                <button type="button" aria-label="@($"Remove {file.Name}")" @onclick="() => RemoveExtractionFile(file)">
                                                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="ai-action-row">
                                    <SecondaryButton Class="ai-extract-action" Icon="@Icons.Material.Outlined.Psychology" Disabled="@(!_hasExtractionInput || _extracting)" OnClick="ExtractAsync">
                                        @(_extracting ? $"Extracting attempt {_currentExtractionAttempt}/{MaxExtractionAttempts}..." : "Extract and autofill")
                                    </SecondaryButton>
                                </div>
                            </div>

                            @if (_extracting)
                            {
                                <div class="ai-processing-state" role="status" aria-live="polite">
                                    <MudProgressCircular Size="Size.Small"
                                                         Color="Color.Primary"
                                                         Indeterminate="true"
                                                         Class="ai-processing-spinner" />
                                    <span>
                                        <strong>AI extraction in progress</strong>
                                        <small>Analyzing customer text and documents. Attempt @_currentExtractionAttempt of @MaxExtractionAttempts.</small>
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    @if (_lastExtraction != null && _showExtractionSummary)
                    {
                        var extractedItems = GetExtractedSummaryItems();
                        var missingItems = GetMissingExtractionItems();

                        <div class="extraction-summary" role="status" aria-live="polite">
                            <div class="extraction-summary-head">
                                <span class="extraction-summary-icon">
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                                </span>
                                <span class="extraction-summary-title">
                                    <strong>AI extraction review</strong>
                                    <small>@GetExtractionSummaryText(extractedItems.Count, missingItems.Count)</small>
                                </span>
                                <span class="extraction-confidence">@($"{_lastExtraction.Confidence:P0}")</span>
                                <button type="button"
                                        class="extraction-summary-dismiss"
                                        aria-label="Dismiss AI extraction review"
                                        @onclick="DismissExtractionSummary">
                                    <MudIcon Icon="@Icons.Material.Outlined.Close" Size="Size.Small" />
                                </button>
                            </div>

                            <div class="extraction-summary-grid">
                                <section>
                                    <span>Extracted</span>
                                    <ul>
                                        @foreach (var item in extractedItems)
                                        {
                                            <li>
                                                <strong>@item.Label</strong>
                                                <small>@item.Value</small>
                                            </li>
                                        }
                                    </ul>
                                </section>

                                <section class="extraction-summary-missing">
                                    <span>Needs input</span>
                                    @if (missingItems.Count == 0)
                                    {
                                        <p>Nothing obvious missing. Review and save when ready.</p>
                                    }
                                    else
                                    {
                                        <ul>
                                            @foreach (var item in missingItems)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }
                                </section>
                            </div>
                        </div>
                    }
                </PanelCard>

                <PanelCard Title="Customer profile">
                    <EditForm EditContext="@_customerEditContext" OnValidSubmit="SaveAsync" class="customer-profile-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <nav class="customer-create-tabs" aria-label="Customer creation sections">
                            <button type="button" class="@GetCreateTabClass(CreateTab.Contact)" @onclick="@(() => _activeCreateTab = CreateTab.Contact)">Customer</button>
                            <button type="button" class="@GetCreateTabClass(CreateTab.Company)" @onclick="@(() => _activeCreateTab = CreateTab.Company)">Company</button>
                            <button type="button" class="@GetCreateTabClass(CreateTab.Addresses)" @onclick="@(() => _activeCreateTab = CreateTab.Addresses)">Addresses</button>
                            <button type="button" class="@GetCreateTabClass(CreateTab.Documents)" @onclick="@(() => _activeCreateTab = CreateTab.Documents)">Documents</button>
                            <button type="button" class="@GetCreateTabClass(CreateTab.Notes)" @onclick="@(() => _activeCreateTab = CreateTab.Notes)">Notes</button>
                        </nav>

                        <div class="customer-create-tab-panel">
                            @if (_activeCreateTab == CreateTab.Contact)
                            {
                                <FormGrid>
                                    <FormField Label="First name"><ImmediateInputText class="mlv-form-input" @bind-Value="_onboarding.Customer.FirstName" /></FormField>
                                    <FormField Label="Last name"><ImmediateInputText class="mlv-form-input" @bind-Value="_onboarding.Customer.LastName" /></FormField>
                                    <FormField Label="Email"><ImmediateInputText class="mlv-form-input" @bind-Value="_onboarding.Customer.Email" /></FormField>
                                    <FormField Label="Phone number"><ImmediateInputText class="mlv-form-input" @bind-Value="_onboarding.Customer.Mobile" /></FormField>
                                    <div class="customer-classification-default">
                                        <span>Initial classification</span>
                                        <strong>@GetInitialClassificationLabel()</strong>
                                        <small>Managed automatically from order history after the customer starts buying.</small>
                                    </div>
                                </FormGrid>
                            }
                            else if (_activeCreateTab == CreateTab.Company)
                            {
                                <div class="company-editor">
                                    <div class="section-divider compact">
                                        <h3>Company</h3>
                                        <span>Registry-backed lookup by company name or 13-digit tax ID.</span>
                                    </div>

                                    <div class="company-grid">
                                        <FormField Label="Company lookup" Class="company-lookup">
                                            <MudAutocomplete T="CompanySearchResultDto"
                                                             Text="@_companyLookup"
                                                             TextChanged="OnCompanyLookupTextChanged"
                                                             ValueChanged="ApplyCompanySuggestion"
                                                             SearchFunc="SearchCompaniesAsync"
                                                             ToStringFunc="@(company => company == null ? _companyLookup : company.Name)"
                                                             Placeholder="Search by company name or tax ID"
                                                             Variant="Variant.Outlined"
                                                             Clearable="true"
                                                             Dense="true"
                                                             Immediate="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ResetValueOnEmptyText="false"
                                                             DebounceInterval="350"
                                                             MinCharacters="2"
                                                             MaxItems="8"
                                                             ReturnedItemsCountChanged="UpdateCompanySuggestionCount"
                                                             PopoverClass="company-lookup-popover"
                                                             ListClass="company-lookup-results"
                                                             ListItemClass="company-lookup-result-item"
                                                             Class="styled-autocomplete company-lookup-input">
                                                <BeforeItemsTemplate>
                                                    <div class="company-suggestion-header">
                                                        <span>
                                                            <strong>Company matches</strong>
                                                            <small>Saved customers and Registry-backed companies</small>
                                                        </span>
                                                        <span class="company-suggestion-count">@GetCompanySuggestionCountText()</span>
                                                    </div>
                                                </BeforeItemsTemplate>
                                                <ItemTemplate Context="company">
                                                    <div class="suggestion-card company-suggestion-card">
                                                        <div class="company-suggestion-main">
                                                            <strong>@company.Name</strong>
                                                            <span class="company-suggestion-tax">@FormatPair(company.VatNumber, company.RegistrationNumber)</span>
                                                        </div>
                                                        <div class="company-suggestion-meta">
                                                            <span class="company-suggestion-registry">@GetCompanySourceBadge(company)</span>
                                                            <small class="company-suggestion-status">@GetCompanyBusinessType(company)</small>
                                                        </div>
                                                    </div>
                                                </ItemTemplate>
                                                <NoItemsTemplate>
                                                    <div class="company-suggestion-empty">
                                                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" />
                                                        <span>
                                                            <strong>No matching companies</strong>
                                                            <small>Check the Thai or English name, or search by 13-digit tax ID.</small>
                                                        </span>
                                                    </div>
                                                </NoItemsTemplate>
                                            </MudAutocomplete>
                                        </FormField>

                                        <div class="company-core-row">
                                            <FormField Label="Company name" Class="company-name-field">
                                                <ImmediateInputText class="mlv-form-input" @bind-Value="_companyName" />
                                            </FormField>

                                            <FormField Label="Company tax ID" Class="company-tax-field">
                                                <ImmediateInputText class="mlv-form-input" @bind-Value="_companyTaxId" />
                                            </FormField>

                                            <FormField Label="Company branch" Class="company-branch-field">
                                                <select class="mlv-form-input" @bind="_companyBranchMode">
                                                    <option value="@BranchModeHeadOffice">@GetHeadOfficeBranchLabel()</option>
                                                    <option value="@BranchModeManual">Manual branch ID</option>
                                                </select>
                                            </FormField>

                                            @if (_companyBranchMode == BranchModeManual)
                                            {
                                                <FormField Label="Branch ID" Class="company-manual-branch-field">
                                                    <ImmediateInputText class="mlv-form-input" @bind-Value="_companyBranchManual" />
                                                </FormField>
                                            }
                                        </div>

                                        @if (CompanyBillingIndex >= 0)
                                        {
                                            var companyAddressIndex = CompanyBillingIndex;
                                            <div class="company-address-block">
                                                <div class="company-address-header">
                                                    <div>
                                                        <strong>Company billing address</strong>
                                                        <span>Stored with the company and copied into onboarding when needed.</span>
                                                    </div>
                                                    <button type="button" class="address-copy" @onclick="@(() => CopyBillingTo(companyAddressIndex))">Copy customer billing</button>
                                                </div>

                                                <FormGrid>
                                                    <FormField Label="Address line 1"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[companyAddressIndex].Request.AddressLine1" /></FormField>
                                                    <FormField Label="Address line 2"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[companyAddressIndex].Request.AddressLine2" /></FormField>
                                                    <FormField Label="Subdistrict">
                                                        @AddressAutocomplete(companyAddressIndex, AddressField.Subdistrict)
                                                    </FormField>
                                                    <FormField Label="District">
                                                        @AddressAutocomplete(companyAddressIndex, AddressField.District)
                                                    </FormField>
                                                    <FormField Label="State / Province">
                                                        @AddressAutocomplete(companyAddressIndex, AddressField.Province)
                                                    </FormField>
                                                    <FormField Label="Postal code">
                                                        @AddressAutocomplete(companyAddressIndex, AddressField.PostalCode)
                                                    </FormField>
                                                </FormGrid>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (_activeCreateTab == CreateTab.Addresses)
                            {
                                <div class="section-divider compact">
                                    <h3>Addresses</h3>
                                    <span>Customer billing and shipping addresses are separate, with billing available as the default copy source.</span>
                                </div>

                                <div class="address-two-column">
                                    @if (CustomerBillingIndex >= 0)
                                    {
                                        var index = CustomerBillingIndex;
                                        <div class="address-panel">
                                            <div class="address-panel-header">
                                                <strong>Customer billing address</strong>
                                            </div>

                                            <FormGrid>
                                                <FormField Label="Address line 1"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[index].Request.AddressLine1" /></FormField>
                                                <FormField Label="Address line 2"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[index].Request.AddressLine2" /></FormField>
                                                <FormField Label="Subdistrict">
                                                    @AddressAutocomplete(index, AddressField.Subdistrict)
                                                </FormField>
                                                <FormField Label="District">
                                                    @AddressAutocomplete(index, AddressField.District)
                                                </FormField>
                                                <FormField Label="State / Province">
                                                    @AddressAutocomplete(index, AddressField.Province)
                                                </FormField>
                                                <FormField Label="Postal code">
                                                    @AddressAutocomplete(index, AddressField.PostalCode)
                                                </FormField>
                                            </FormGrid>
                                        </div>
                                    }

                                    @if (CustomerShippingIndex >= 0)
                                    {
                                        var index = CustomerShippingIndex;
                                        <div class="address-panel">
                                            <div class="address-panel-header">
                                                <strong>Customer shipping address</strong>
                                                <div>
                                                    <button type="button" class="address-copy" @onclick="@(() => CopyBillingTo(index))">Copy billing</button>
                                                </div>
                                            </div>

                                            <FormGrid>
                                                <FormField Label="Address line 1"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[index].Request.AddressLine1" /></FormField>
                                                <FormField Label="Address line 2"><ImmediateInputText class="mlv-form-input" @bind-Value="_addresses[index].Request.AddressLine2" /></FormField>
                                                <FormField Label="Subdistrict">
                                                    @AddressAutocomplete(index, AddressField.Subdistrict)
                                                </FormField>
                                                <FormField Label="District">
                                                    @AddressAutocomplete(index, AddressField.District)
                                                </FormField>
                                                <FormField Label="State / Province">
                                                    @AddressAutocomplete(index, AddressField.Province)
                                                </FormField>
                                                <FormField Label="Postal code">
                                                    @AddressAutocomplete(index, AddressField.PostalCode)
                                                </FormField>
                                            </FormGrid>
                                        </div>
                                    }
                                </div>
                            }
                            else if (_activeCreateTab == CreateTab.Documents)
                            {
                                <div class="section-divider compact">
                                    <h3>Documents</h3>
                                    <span>Files upload immediately. Customer documents and NDA documents stay separate until they are linked on create.</span>
                                </div>

                                <div class="documents-workspace">
                                    <div class="document-library-panel">
                                        <div class="document-type-tabs" role="tablist" aria-label="Document groups">
                                            <button type="button"
                                                    role="tab"
                                                    aria-selected="@(_activeDocumentPanel == DocumentPanel.Standard)"
                                                    class="@GetDocumentTabClass(DocumentPanel.Standard)"
                                                    @onclick="@(() => _activeDocumentPanel = DocumentPanel.Standard)">
                                                <MudIcon Icon="@Icons.Material.Outlined.Folder" />
                                                <span>
                                                    <strong>Standard documents</strong>
                                                    <small>@GetUploadedDocumentCount(_customerDocumentUploads) uploaded</small>
                                                </span>
                                            </button>
                                            <button type="button"
                                                    role="tab"
                                                    aria-selected="@(_activeDocumentPanel == DocumentPanel.Nda)"
                                                    class="@GetDocumentTabClass(DocumentPanel.Nda)"
                                                    @onclick="@(() => _activeDocumentPanel = DocumentPanel.Nda)">
                                                <MudIcon Icon="@Icons.Material.Outlined.Gavel" />
                                                <span>
                                                    <strong>NDA documents</strong>
                                                    <small>@GetUploadedDocumentCount(_ndaDocumentUploads) uploaded</small>
                                                </span>
                                            </button>
                                        </div>

                                        @if (_activeDocumentPanel == DocumentPanel.Standard)
                                        {
                                            <div class="document-section">
                                                <div class="document-section-header">
                                                    <strong>Customer documents</strong>
                                                    <span>@GetUploadedDocumentCount(_customerDocumentUploads)</span>
                                                </div>
                                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                               FilesChanged="OnCustomerDocumentsSelected"
                                                               Accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt"
                                                               Class="document-file-upload"
                                                               Hidden="true"
                                                               MaximumFileCount="20">
                                                    <CustomContent Context="uploadContext">
                                                        <button type="button" class="document-dropzone" @onclick="@uploadContext.OpenFilePickerAsync">
                                                            <MudIcon Icon="@Icons.Material.Outlined.AttachFile" />
                                                            <span>
                                                                <strong>Upload standard documents</strong>
                                                                <small>Contracts, forms, IDs, certificates</small>
                                                            </span>
                                                        </button>
                                                    </CustomContent>
                                                </MudFileUpload>
                                                @DocumentUploadList(_customerDocumentUploads, DocumentPanel.Standard)
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="document-section nda-document-section">
                                                <div class="document-section-header">
                                                    <strong>NDA lifecycle</strong>
                                                    <span>@GetUploadedDocumentCount(_ndaDocumentUploads)</span>
                                                </div>
                                                <div class="nda-lifecycle-grid">
                                                    <FormField Label="Initial status">
                                                        <select class="mlv-form-input" @bind="_ndaStatus">
                                                            <option value="Draft">Draft</option>
                                                            <option value="Signed">Signed</option>
                                                        </select>
                                                    </FormField>
                                                    <FormField Label="Expiration date">
                                                        <InputDate class="mlv-form-input" @bind-Value="_ndaExpiresAt" />
                                                    </FormField>
                                                </div>
                                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                               FilesChanged="OnNdaDocumentsSelected"
                                                               Accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                                                               Class="document-file-upload"
                                                               Hidden="true"
                                                               MaximumFileCount="10">
                                                    <CustomContent Context="uploadContext">
                                                        <button type="button" class="document-dropzone nda-dropzone" @onclick="@uploadContext.OpenFilePickerAsync">
                                                            <MudIcon Icon="@Icons.Material.Outlined.Gavel" />
                                                            <span>
                                                                <strong>Upload NDA documents</strong>
                                                                <small>Signed agreements or legal drafts</small>
                                                            </span>
                                                        </button>
                                                    </CustomContent>
                                                </MudFileUpload>
                                                @DocumentUploadList(_ndaDocumentUploads, DocumentPanel.Nda)
                                            </div>
                                        }
                                    </div>

                                    <div class="document-preview-panel persistent">
                                        <div class="document-preview-header">
                                            <span>
                                                <small>Document preview</small>
                                                <strong>@(_previewDocument?.FileName ?? "No document selected")</strong>
                                            </span>
                                            @if (_previewDocument != null)
                                            {
                                                <button type="button" class="address-remove" @onclick="CloseDocumentPreview">Close preview</button>
                                            }
                                        </div>
                                        @if (_previewDocument == null)
                                        {
                                            <div class="document-preview-empty">
                                                <MudIcon Icon="@Icons.Material.Outlined.Preview" />
                                                <span>Select an uploaded document to preview PDFs and images.</span>
                                            </div>
                                        }
                                        else if (_loadingDocumentPreview)
                                        {
                                            <ProgressiveSkeleton Layout="compact" Rows="3" ShowFilters="false" Label="Loading document preview" />
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_documentPreviewError))
                                        {
                                            <div class="document-preview-empty error">
                                                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                                                <span>@_documentPreviewError</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_documentPreviewUrl) && IsPreviewable(_previewDocument.MimeType))
                                        {
                                            @if (IsPdf(_previewDocument.MimeType))
                                            {
                                                <iframe src="@_documentPreviewUrl" title="@_previewDocument.FileName"></iframe>
                                            }
                                            else
                                            {
                                                <img src="@_documentPreviewUrl" alt="@_previewDocument.FileName" />
                                            }
                                        }
                                        else
                                        {
                                            <div class="document-preview-empty">
                                                <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" />
                                                <span>Preview is not available for this file type.</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (_activeCreateTab == CreateTab.Notes)
                            {
                                <div class="notes-panel">
                                    <FormField Label="Notes">
                                        <ImmediateInputTextArea class="mlv-form-input notes-input" @bind-Value="_onboarding.InternalNote" />
                                    </FormField>
                                </div>
                            }
                        </div>

                        <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                            <SecondaryButton Href="/customers">Cancel</SecondaryButton>
                            <PrimaryButton Type="submit" Disabled="@(_saving || _hasPendingDocumentUploads)" Icon="@Icons.Material.Outlined.PersonAdd">
                                @(_saving ? "Creating..." : "Create Customer")
                            </PrimaryButton>
                        </div>
                    </EditForm>
                </PanelCard>
            </div>

            <aside class="customer-create-side">
                <PanelCard Title="Creation summary">
                    <div class="summary-stack">
                        <section>
                            <h4>Customer</h4>
                            <div><span>Name</span><strong>@GetCustomerName()</strong></div>
                            <div><span>Email</span><strong>@FormatValue(_onboarding.Customer.Email)</strong></div>
                            <div><span>Phone</span><strong>@FormatPair(_onboarding.Customer.Mobile, _onboarding.Customer.Landline)</strong></div>
                            <div><span>Initial class</span><strong>@GetInitialClassificationLabel()</strong></div>
                        </section>
                        <section>
                            <h4>Company</h4>
                            <div><span>Name</span><strong>@(string.IsNullOrWhiteSpace(_companyName) ? "Private customer" : _companyName)</strong></div>
                            <div><span>Tax ID</span><strong>@FormatValue(_companyTaxId)</strong></div>
                            <div><span>Branch</span><strong>@GetBranchLabel()</strong></div>
                            <div><span>Source</span><strong>@GetCompanySourceLabel()</strong></div>
                        </section>
                        <section>
                            <h4>Addresses</h4>
                            <div><span>Billing</span><strong>@FormatAddressSummary(CustomerBillingIndex)</strong></div>
                            <div><span>Shipping</span><strong>@FormatAddressSummary(CustomerShippingIndex)</strong></div>
                            <div><span>Company billing</span><strong>@FormatAddressSummary(CompanyBillingIndex)</strong></div>
                        </section>
                        <section>
                            <h4>Files</h4>
                            <div><span>Customer docs</span><strong>@GetUploadedDocumentCount(_customerDocumentUploads)</strong></div>
                            <div><span>NDA docs</span><strong>@GetUploadedDocumentCount(_ndaDocumentUploads)</strong></div>
                            <div><span>NDA status</span><strong>@_ndaStatus</strong></div>
                            <div><span>AI confidence</span><strong>@(_lastExtraction == null ? "Not extracted" : $"{_lastExtraction.Confidence:P0}")</strong></div>
                        </section>
                    </div>
                </PanelCard>
            </aside>
        </div>
    </PageBody>
</div>

@code {
    private enum CreateTab
    {
        Contact,
        Company,
        Addresses,
        Documents,
        Notes
    }

    private enum DocumentPanel
    {
        Standard,
        Nda
    }

    private sealed record ExtractionSummaryItem(string Label, string Value);

    private enum AddressField
    {
        Subdistrict,
        District,
        Province,
        PostalCode
    }

    private sealed class AddressDraft
    {
        public CreateAddressRequest Request { get; set; } = new();
