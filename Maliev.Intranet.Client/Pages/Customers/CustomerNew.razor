    private List<ExtractionSummaryItem> GetExtractedSummaryItems()
    {
        List<ExtractionSummaryItem> items = [];

        var name = GetCustomerName();
        if (name != "Not named yet")
        {
            items.Add(new("Name", name));
        }

        if (!string.IsNullOrWhiteSpace(_onboarding.Customer.Email))
        {
            items.Add(new("Email", _onboarding.Customer.Email.Trim()));
        }

        var phone = FormatPair(_onboarding.Customer.Mobile, _onboarding.Customer.Landline);
        if (phone != "Not set")
        {
            items.Add(new("Phone", phone));
        }

        if (!string.IsNullOrWhiteSpace(_companyName) || !string.IsNullOrWhiteSpace(_companyTaxId))
        {
            items.Add(new("Company", FormatPair(_companyName, _companyTaxId)));
        }

        var addressCount = _addresses.Count(address => HasAddressContent(address.Request));
        if (addressCount > 0)
        {
            items.Add(new("Addresses", $"{addressCount} address{(addressCount == 1 ? string.Empty : "es")}"));
        }

        if (_lastExtractionAttempts > 0)
        {
            items.Add(new("Attempts", $"{_lastExtractionAttempts} of {MaxExtractionAttempts}"));
        }

        return items.Count == 0
            ? [new("Result", "No usable customer fields found")]
            : items;
    }

    private List<string> GetMissingExtractionItems()
    {
        List<string> missing = [];

        if (string.IsNullOrWhiteSpace(_onboarding.Customer.FirstName))
        {
            missing.Add("Customer first name");
        }

        if (string.IsNullOrWhiteSpace(_onboarding.Customer.LastName))
        {
            missing.Add("Customer last name");
        }

        if (string.IsNullOrWhiteSpace(_onboarding.Customer.Email))
        {
            missing.Add("Email address");
        }

        if (string.IsNullOrWhiteSpace(_onboarding.Customer.Mobile) &&
            string.IsNullOrWhiteSpace(_onboarding.Customer.Landline))
        {
            missing.Add("Phone number");
        }

        if (!string.IsNullOrWhiteSpace(_companyName) && string.IsNullOrWhiteSpace(_companyTaxId))
        {
            missing.Add("Company tax ID");
        }

        if (_addresses.All(address => !HasAddressContent(address.Request)))
        {
            missing.Add("Billing or shipping address");
        }

        if (_lastExtraction?.Confidence < HighConfidenceThreshold)
        {
            missing.Add("Manual review for low confidence");
        }

        return missing;
    }

