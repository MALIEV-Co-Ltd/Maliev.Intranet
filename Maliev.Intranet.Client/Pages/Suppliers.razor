@page "/mfg/suppliers"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Components
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Suppliers - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Supplier Management</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search suppliers..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Supplier
        </MudButton>
    </MudStack>
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="4">
        @if (_isLoading)
        {
            @for (int i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" Class="mb-2 rounded" />
            }
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg" Style="max-height: 600px; overflow-y: auto;">
                <MudList T="SupplierSummaryDto" Dense="true" SelectedValue="_selectedSupplier">
                    @foreach (var supplier in _suppliers)
                    {
                        <MudListItem T="SupplierSummaryDto" Value="supplier" OnClick="@(() => OnSupplierSelected(supplier))">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">@supplier.CompanyName</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(supplier.Status)">@supplier.Status</MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@supplier.Country</MudText>
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                        <MudDivider />
                    }
                    @if (!_suppliers.Any())
                    {
                        <MudText Class="pa-4 text-center" Color="Color.Secondary">No suppliers found</MudText>
                    }
                </MudList>
            </MudPaper>
        }
    </MudItem>

    <MudItem xs="12" md="8">
        @if (_selectedSupplierDetails != null)
        {
            <MudStack Spacing="3">
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4">
                        <div>
                            <MudText Typo="Typo.h5">@_selectedSupplierDetails.CompanyName</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedSupplierDetails.Country</MudText>
                        </div>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart">Create PO</MudButton>
                        </MudStack>
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Contact Information</MudText>
                            @if (_isDetailsLoading)
                            {
                                <MudSkeleton Width="100%" />
                                <MudSkeleton Width="80%" />
                                <MudSkeleton Width="90%" />
                            }
                            else
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2"><strong>Tax ID:</strong> @_selectedSupplierDetails.TaxId</MudText>
                                    <MudText Typo="Typo.body2"><strong>City:</strong> @_selectedSupplierDetails.City</MudText>
                                    <MudText Typo="Typo.body2"><strong>Address:</strong> @_selectedSupplierDetails.Address</MudText>
                                    <MudText Typo="Typo.body2"><strong>Postal Code:</strong> @(_selectedSupplierDetails.PostalCode ?? "—")</MudText>
                                </MudStack>
                            }
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Onboarding</MudText>
                            @if (_isDetailsLoading)
                            {
                                <MudSkeleton Width="40%" Height="40px" />
                                <MudSkeleton Width="100%" Height="20px" />
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                                        <MudChip T="string" Color="@GetStatusColor(_selectedSupplierDetails.Status)" Size="Size.Small">@_selectedSupplierDetails.Status</MudChip>
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Onboarding Stage</MudText>
                                        <MudText Typo="Typo.body2">@_selectedSupplierDetails.OnboardingStage</MudText>
                                    </div>
                                </MudStack>
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                
                <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                    <MudText Typo="Typo.h6" Class="mb-3">Audit Details</MudText>
                    <MudText Typo="Typo.body2"><strong>Created At:</strong> @_selectedSupplierDetails.CreatedAt.ToString("g")</MudText>
                    <MudText Typo="Typo.body2"><strong>Last Updated:</strong> @_selectedSupplierDetails.UpdatedAt.ToString("g")</MudText>
                </MudPaper>
            </MudStack>
        }
        else if (_isDetailsLoading)
        {
            <MudPaper Elevation="0" Class="pa-6 border mud-border-lines-default rounded-lg">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="150px" Class="rounded-lg" />
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Class="pa-12 border mud-border-lines-default rounded-lg d-flex flex-column align-center justify-center" Style="min-height: 400px;">
                <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Large" Color="Color.Secondary" Style="font-size: 80px;" Class="mb-4" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">Select a supplier to view details</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private bool _isLoading = true;
    private bool _isDetailsLoading = false;
    private string _searchString = "";
    private List<SupplierSummaryDto> _suppliers = new();
    private SupplierSummaryDto? _selectedSupplier;
    private SupplierDetailDto? _selectedSupplierDetails;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<SupplierSummaryDto>>("api/suppliers");
            _suppliers = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading suppliers: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSupplierSelected(SupplierSummaryDto supplier)
    {
        _selectedSupplier = supplier;
        _isDetailsLoading = true;
        _selectedSupplierDetails = null;
        
        try
        {
            _selectedSupplierDetails = await Http.GetFromJsonAsync<SupplierDetailDto>($"api/suppliers/{supplier.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading supplier details: {ex.Message}");
        }
        finally
        {
            _isDetailsLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateSupplierDialog>("Add New Supplier", options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Default,
        "Pending" => Color.Warning,
        "Deactivated" => Color.Error,
        _ => Color.Default
    };
}


