@page "/mfg/suppliers"
<PageTitle>Suppliers | Intranet Gateway</PageTitle>
@inject NavigationManager Navigation

@code {
    /// <summary>Redirects legacy /mfg/suppliers route to the consolidated Procurement and Suppliers page (Suppliers tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/mfg/procurement?tab=suppliers", replace: true);
    }
}
