@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - Maliev Intranet</PageTitle>

<style>
    /* Hide legend for mini charts as requested */
    .mini-chart .mud-chart-legend {
        display: none !important;
    }
</style>

@if (_loading)
{
    <!-- Loading Skeletons State - Simplified for General Dashboard -->
    <MudGrid>
        <!-- Stats Row Skeletons -->
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        
        <!-- Table Skeleton -->
        <MudItem xs="12" Class="mt-4"><MudSkeleton Height="400px" Class="rounded-lg"/></MudItem>
    </MudGrid>
}
else
{
    <!-- General Dashboard View -->
    <MudGrid>
        <!-- Stats Widgets -->
        @if (_dashboard?.Widgets.Any() == true)
        {
            @foreach (var widget in _dashboard.Widgets)
            {
                <MudItem xs="12" sm="4">
                    <MudCard Elevation="0" Class="rounded-lg pa-4" Style="background-color: var(--mud-palette-surface);">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@widget.Title</MudText>
                        <div class="d-flex align-center justify-space-between mt-2">
                            <MudText Typo="Typo.h4" Style="font-weight: 500;">
                                @if(widget.Type == "Stat") { @widget.Data } else { <text>THB 0</text> }
                            </MudText>
                            
                            <!-- Mini Chart Visualization -->
                            <div style="width: 120px; height: 50px;">
                                @if(widget.Type == "Chart" || widget.Type == "Graph")
                                {
                                     var chartData = System.Text.Json.JsonSerializer.Deserialize<ChartData>(widget.Data.GetRawText());
                                     if(chartData != null)
                                     {
                                        <MudChart Class="mini-chart" ChartType="ChartType.Line" XAxisLabels="@chartData.Labels" ChartSeries="@(new List<ChartSeries> { new ChartSeries { Data = chartData.Values } })" Width="100%" Height="50px" ChartOptions="@_chartOptions" />
                                     }
                                }
                                else
                                {
                                    <MudChart Class="mini-chart" ChartType="ChartType.Line" ChartSeries="@(new List<ChartSeries> { new ChartSeries { Data = new double[] { 0, 0, 0, 0 } } })" Width="100%" Height="50px" ChartOptions="@_chartOptions" />
                                }
                            </div>
                        </div>
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                    No active dashboard widgets available.
                </MudAlert>
            </MudItem>
        }
        
        <!-- Orders Table Area -->
        <MudItem xs="12">
             <MudCard Elevation="0" Class="rounded-lg mt-4" Style="background-color: var(--mud-palette-surface);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">All Orders</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudTabs Rounded="true" Color="Color.Transparent" SliderColor="Color.Primary" ApplyEffectsToContainer="true">
                            <MudTabPanel Text="All Orders" />
                            <MudTabPanel Text="Processing" />
                            <MudTabPanel Text="Shipped" />
                        </MudTabs>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@(new List<string>())" Elevation="0" Hover="true" Loading="@_loading">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh>Price</MudTh>
                            <MudTh>Payment</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <LoadingContent>
                             <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2"/>
                             <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2"/>
                             <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2"/>
                        </LoadingContent>
                        <NoRecordsContent>
                            <MudText Class="pa-4 text-center" Color="Color.Secondary">No orders found</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
             </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private UserInfo? _userInfo;
    private DashboardViewModel? _dashboard;
    private bool _loading = true;
    
    // CSS class handles legend hiding
    private ChartOptions _chartOptions = new ChartOptions 
    { 
        LineStrokeWidth = 2,
        ChartPalette = new[] { "#3d7cf9", "#238636", "#a855f7" }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;



        _userInfo = new UserInfo
        {
            Name = user.Identity?.Name ?? user.FindFirst("name")?.Value ?? "Unknown",
            Email = user.FindFirst("email")?.Value ?? "No email",
            UserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "Unknown",
            // Check both standard and literal claim types
            Roles = user.Claims.Where(c => c.Type == ClaimTypes.Role || c.Type == "roles").Select(c => c.Value).Distinct().ToList(),
            Permissions = user.Claims.Where(c => c.Type == "permissions" || c.Type == "permission").Select(c => c.Value).Distinct().ToList()
        };

        try
        {
            _dashboard = await Http.GetFromJsonAsync<DashboardViewModel>("api/dashboard");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching dashboard: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private class UserInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string UserId { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
        public List<string> Permissions { get; set; } = new();
    }

    private class ChartData
    {
        public string[] Labels { get; set; } = Array.Empty<string>();
        public double[] Values { get; set; } = Array.Empty<double>();
    }
}
