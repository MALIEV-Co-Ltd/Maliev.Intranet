@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - Maliev Intranet</PageTitle>

<style>
    /* Hide legend for mini charts as requested */
    .mini-chart .mud-chart-legend {
        display: none !important;
    }
</style>

@if (_loading)
{
    <!-- Loading Skeletons State - Simplified for General Dashboard -->
    <MudGrid>
        <!-- Stats Row Skeletons -->
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        <MudItem xs="12" md="4"><MudSkeleton Height="140px" Class="rounded-lg"/></MudItem>
        
        <!-- Table Skeleton -->
        <MudItem xs="12" Class="mt-4"><MudSkeleton Height="400px" Class="rounded-lg"/></MudItem>
    </MudGrid>
}
else
{
    <!-- General Dashboard View -->
    <MudGrid>
        <!-- Stats Widgets -->
        @if (_dashboard?.Widgets.Any() == true)
        {
            @foreach (var widget in _dashboard.Widgets)
            {
                <MudItem xs="12" sm="4">
                    <MudCard Elevation="0" Class="rounded-lg pa-4" Style="background-color: var(--mud-palette-surface);">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@widget.Title</MudText>
                        <div class="d-flex align-center justify-space-between mt-2">
                            <MudText Typo="Typo.h4" Style="font-weight: 500;">
                                @if(widget.Type == "Stat") { @widget.Data } else { <text>THB 0</text> }
                            </MudText>
                            
                            <!-- Mini Chart Visualization -->
                            <div style="width: 120px; height: 50px;">
                                @if(widget.Type == "Chart" || widget.Type == "Graph")
                                {
                                     var chartData = System.Text.Json.JsonSerializer.Deserialize<ChartData>(widget.Data.GetRawText());
                                     if(chartData != null)
                                     {
                                        <MudChart T="double" Class="mini-chart" ChartType="ChartType.Line" ChartLabels="@chartData.Labels" ChartSeries="@(new List<ChartSeries<double>> { new ChartSeries<double> { Data = chartData.Values } })" Width="100%" Height="50px" ChartOptions="@_chartOptions" />
                                     }
                                }
                                else
                                {
                                    <MudChart T="double" Class="mini-chart" ChartType="ChartType.Line" ChartSeries="@(new List<ChartSeries<double>> { new ChartSeries<double> { Data = new double[] { 0, 0, 0, 0 } } })" Width="100%" Height="50px" ChartOptions="@_chartOptions" />
                                }
                            </div>
                        </div>
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                    No active dashboard widgets available.
                </MudAlert>
            </MudItem>
        }
        
        <!-- Orders Table Area -->
        <MudItem xs="12">
             <MudCard Elevation="0" Class="rounded-lg mt-4" Style="background-color: var(--mud-palette-surface);">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Recent Orders</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudTabs @bind-ActivePanelIndex="_activeOrderTab" Rounded="true" Color="Color.Transparent" SliderColor="Color.Primary" ApplyEffectsToContainer="true">
                            <MudTabPanel Text="All Orders" />
                            <MudTabPanel Text="Processing" />
                            <MudTabPanel Text="Shipped" />
                        </MudTabs>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (_ordersLoading)
                    {
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-2"/>
                        }
                    }
                    else
                    {
                        <MudTable T="OrderSummaryDto" Items="@FilteredOrders" Elevation="0" Hover="true" OnRowClick="@((TableRowClickEventArgs<OrderSummaryDto> args) => Navigation.NavigateTo($"/sales/orders/{args.Item!.Id}"))">
                            <HeaderContent>
                                <MudTh>Order #</MudTh>
                                <MudTh>Customer</MudTh>
                                <MudTh>Total</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Date</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Order #">@context.OrderNumber</MudTd>
                                <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                                <MudTd DataLabel="Total">฿@context.TotalAmount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="@GetOrderStatusColor(context.Status)">@context.Status</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="pa-4 text-center" Color="Color.Secondary">No orders found</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </MudCardContent>
             </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private UserInfo? _userInfo;
    private DashboardViewModel? _dashboard;
    private bool _loading = true;
    private bool _ordersLoading = false;
    private int _activeOrderTab = 0;
    private List<OrderSummaryDto> _orders = new();
    
    // CSS class handles legend hiding
    private ChartOptions _chartOptions = new ChartOptions 
    { 
        ChartPalette = new[] { "#3d7cf9", "#238636", "#a855f7" }
    };

    private IEnumerable<OrderSummaryDto> FilteredOrders => _activeOrderTab switch
    {
        1 => _orders.Where(o => o.Status == "Processing" || o.Status == "Confirmed"),
        2 => _orders.Where(o => o.Status == "Shipped"),
        _ => _orders
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _userInfo = new UserInfo
        {
            Name = user.Identity?.Name ?? user.FindFirst("name")?.Value ?? "Unknown",
            Email = user.FindFirst("email")?.Value ?? "No email",
            UserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "Unknown",
            Roles = user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "roles").Select(c => c.Value).Distinct().ToList(),
            Permissions = user.Claims.Where(c => c.Type == "permissions" || c.Type == "permission").Select(c => c.Value).Distinct().ToList()
        };

        try
        {
            string widgetQuery = "";
            try
            {
                var pref = await Http.GetFromJsonAsync<UserPreferenceDto>("api/preferences/dashboard");
                if (pref?.PreferenceData != null && pref.PreferenceData.TryGetValue("Widgets", out var widgetsObj) && widgetsObj is System.Text.Json.JsonElement widgetsElement)
                {
                    var widgets = System.Text.Json.JsonSerializer.Deserialize<List<string>>(widgetsElement);
                    if (widgets?.Any() == true)
                        widgetQuery = "?widgets=" + string.Join(",", widgets);
                }
            }
            catch { }

            var dashboardTask = Http.GetFromJsonAsync<DashboardViewModel>($"api/dashboard{widgetQuery}");
            var ordersTask = Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>("api/orders?pageSize=20&sortBy=createdAt&sortDesc=true");
            
            await Task.WhenAll(dashboardTask, ordersTask);
            
            _dashboard = await dashboardTask;
            var ordersResponse = await ordersTask;
            _orders = ordersResponse?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching dashboard: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetOrderStatusColor(string status) => status switch
    {
        "New" or "Draft" => Color.Default,
        "Confirmed" or "Processing" => Color.Info,
        "Shipped" => Color.Primary,
        "Delivered" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private class DashboardPreference
    {
        public List<string> Widgets { get; set; } = new();
    }

    private class UserInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string UserId { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
        public List<string> Permissions { get; set; } = new();
    }

    private class ChartData
    {
        public string[] Labels { get; set; } = Array.Empty<string>();
        public double[] Values { get; set; } = Array.Empty<double>();
    }
}
