@page "/"
@using System.Text.Json
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Dashboard | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="Dashboard" Subtitle="Operational control center for quotes, orders, and finance.">
        <SecondaryButton Icon="@Icons.Material.Outlined.Refresh" OnClick="@ReloadAsync">Refresh</SecondaryButton>
        <PrimaryButton Icon="@Icons.Material.Outlined.Add" Href="/sales/projects/new">New Quote</PrimaryButton>
    </ModuleHeader>

    <PageBody>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }

        <PanelCard Title="Quick actions" Class="mb-4">
            <div class="mlv-toolbar" style="margin-bottom:0">
                <div class="mlv-toolbar-left">
                    <SecondaryButton Icon="@Icons.Material.Outlined.PersonAdd" Href="/customers/new">New Customer</SecondaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.ReceiptLong" Href="/accounting/new">New Invoice</SecondaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.Inventory2" Href="/purchasing/new">New PO</SecondaryButton>
                </div>
                <div class="mlv-toolbar-right">
                    <SecondaryButton Icon="@Icons.Material.Outlined.AdminPanelSettings" Href="/iam">IAM Review</SecondaryButton>
                </div>
            </div>
        </PanelCard>

        <StatBar Class="mb-4">
            @foreach (var tile in DashboardStats)
            {
                <StatTile Label="@tile.Label" Value="@tile.Value" Subtext="@tile.Subtext" Trend="@tile.Trend" Loading="@tile.Loading" />
            }
        </StatBar>

        <div class="mlv-grid">
            <PanelCard Title="Action items" Class="mlv-span-4">
                @if (_loadingActionItems)
                {
                    <div class="mlv-section-skeleton" aria-busy="true">
                        @for (var row = 0; row < 3; row++)
                        {
                            <div class="mlv-list-row">
                                <div class="mlv-row-title">
                                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="20px" Height="20px" Animation="Animation.Wave" />
                                    <div class="mlv-list-skeleton-copy">
                                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="190px" Height="16px" Animation="Animation.Wave" />
                                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="72px" Height="12px" Animation="Animation.Wave" />
                                    </div>
                                </div>
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="32px" Height="22px" Animation="Animation.Wave" />
                            </div>
                        }
                    </div>
                }
                else if (_actionItems?.Categories.Count > 0)
                {
                    <div class="mlv-list">
                        @foreach (var item in _actionItems.Categories)
                        {
                            <div class="mlv-list-row" @onclick="@(() => Navigation.NavigateTo(NormalizeRoute(item.NavigateTo)))">
                                <div class="mlv-row-title">
                                    <MudIcon Icon="@ResolveIcon(item.Icon)" Color="@ResolveSeverity(item.Severity)" Size="Size.Small" />
                                    <div>
                                        <div class="mlv-row-main">@item.Label</div>
                                        <div class="mlv-row-sub">@item.Severity</div>
                                    </div>
                                </div>
                                <StatusBadge Status="@item.Severity" Text="@item.Count.ToString()" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mlv-empty">No active action items.</div>
                }
            </PanelCard>

            <PanelCard Title="Recent orders" Class="mlv-span-8">
                @if (_loadingOrders)
                {
                    <table class="mlv-table" aria-busy="true">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var row = 0; row < 5; row++)
                            {
                                <tr>
                                    <td><MudSkeleton SkeletonType="SkeletonType.Text" Width="82px" Height="16px" Animation="Animation.Wave" /></td>
                                    <td><MudSkeleton SkeletonType="SkeletonType.Text" Width="148px" Height="16px" Animation="Animation.Wave" /></td>
                                    <td><MudSkeleton SkeletonType="SkeletonType.Text" Width="76px" Height="16px" Animation="Animation.Wave" /></td>
                                    <td><MudSkeleton SkeletonType="SkeletonType.Text" Width="70px" Height="16px" Animation="Animation.Wave" /></td>
                                    <td><MudSkeleton SkeletonType="SkeletonType.Text" Width="92px" Height="16px" Animation="Animation.Wave" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_orders.Count > 0)
                {
                    <table class="mlv-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders.Take(8))
                            {
                                <tr @onclick="@(() => Navigation.NavigateTo($"/sales/orders/{order.Id}"))">
                                    <td class="mlv-mono">@order.OrderNumber</td>
                                    <td>@order.CustomerName</td>
                                    <td><StatusBadge Status="@order.Status" /></td>
                                    <td class="mlv-mono">@CurrencyFormatter.Format(order.TotalAmount, "THB", 2)</td>
                                    <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No recent orders found.</div>
                }
            </PanelCard>
        </div>
    </PageBody>
</div>

@code {
    private static readonly DashboardStatDefinition[] StatDefinitions =
    [
        new("Revenue", "Total Revenue (Today)"),
        new("ActiveOrders", "Active Orders"),
        new("PendingQuotes", "Pending Quotes"),
        new("Headcount", "Total Headcount")
    ];

    private readonly List<DashboardStatState> _dashboardStats = StatDefinitions
        .Select(definition => new DashboardStatState(definition.WidgetKey, definition.Label))
        .ToList();

    private DashboardActionItemsDto? _actionItems;
    private List<OrderSummaryDto> _orders = [];
    private bool _loadingActionItems = true;
    private bool _loadingOrders = true;
    private bool _loadWarningShown;
    private int _loadGeneration;
    private string? _error;

    private IEnumerable<DashboardStatState> DashboardStats => _dashboardStats;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ReloadAsync(MouseEventArgs _) => await LoadAsync();

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        _error = null;
        _loadWarningShown = false;

        foreach (var stat in _dashboardStats)
        {
            stat.Loading = true;
        }

        _loadingActionItems = true;
        _loadingOrders = true;
        await InvokeAsync(StateHasChanged);

        var tasks = _dashboardStats
            .Select(stat => LoadStatWidgetAsync(stat, generation))
            .Append(LoadOrdersAsync(generation))
            .Append(LoadActionItemsAsync(generation));

        await Task.WhenAll(tasks);
    }

    private async Task LoadStatWidgetAsync(DashboardStatState stat, int generation)
    {
        try
        {
            var dashboard = await Http.GetFromJsonAsync<DashboardViewModel>($"api/v1/dashboard?widgets={Uri.EscapeDataString(stat.WidgetKey)}");
            var widget = dashboard?.Widgets.FirstOrDefault(w => string.Equals(w.Type, "Stat", StringComparison.OrdinalIgnoreCase));

            if (IsCurrent(generation) && widget is not null)
            {
                stat.Label = widget.Title;
                stat.Value = ReadWidgetValue(widget.Data);
                stat.Subtext = FormatTrend(widget.TrendPercent);
                stat.Trend = widget.Trend == "up" ? true : widget.Trend == "down" ? false : null;
            }
        }
        catch (Exception ex)
        {
            if (IsCurrent(generation))
            {
                ReportLoadFailure(ex);
            }
        }
        finally
        {
            if (IsCurrent(generation))
            {
                stat.Loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadOrdersAsync(int generation)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>("api/v1/orders?pageSize=20&sortBy=createdAt&sortDesc=true");
            if (IsCurrent(generation))
            {
                _orders = response?.Data.ToList() ?? [];
            }
        }
        catch (Exception ex)
        {
            if (IsCurrent(generation))
            {
                ReportLoadFailure(ex);
            }
        }
        finally
        {
            if (IsCurrent(generation))
            {
                _loadingOrders = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadActionItemsAsync(int generation)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<DashboardActionItemsDto>("api/v1/dashboard/action-items");
            if (IsCurrent(generation))
            {
                _actionItems = response ?? new DashboardActionItemsDto();
            }
        }
        catch (Exception ex)
        {
            if (IsCurrent(generation))
            {
                ReportLoadFailure(ex);
            }
        }
        finally
        {
            if (IsCurrent(generation))
            {
                _loadingActionItems = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static string ReadWidgetValue(JsonElement element) => element.ValueKind switch
    {
        JsonValueKind.String => element.GetString() ?? "-",
        JsonValueKind.Number => element.ToString(),
        _ => element.ToString()
    };

    private static string? FormatTrend(double? value) => value.HasValue ? $"{value.Value:N1}%" : null;

    private bool IsCurrent(int generation) => generation == _loadGeneration;

    private void ReportLoadFailure(Exception ex)
    {
        _error = "Some dashboard data could not be loaded.";
        if (!_loadWarningShown)
        {
            Snackbar.Add(_error, Severity.Warning);
            _loadWarningShown = true;
        }

        Console.WriteLine(ex.Message);
    }

    private static string NormalizeRoute(string route) => route.Replace("/sales/customers", "/customers", StringComparison.OrdinalIgnoreCase);

    private static Color ResolveSeverity(string severity) => severity switch
    {
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        _ => Color.Info
    };

    private static string ResolveIcon(string icon) => icon switch
    {
        "Icons.Material.Outlined.PauseCircle" => Icons.Material.Outlined.PauseCircle,
        "Icons.Material.Outlined.HourglassBottom" => Icons.Material.Outlined.HourglassBottom,
        "Icons.Material.Outlined.ReceiptLong" => Icons.Material.Outlined.ReceiptLong,
        "Icons.Material.Outlined.BeachAccess" => Icons.Material.Outlined.BeachAccess,
        "Icons.Material.Outlined.FolderSpecial" => Icons.Material.Outlined.FolderSpecial,
        "Icons.Material.Outlined.PrecisionManufacturing" => Icons.Material.Outlined.PrecisionManufacturing,
        _ => Icons.Material.Outlined.Info
    };

    private sealed record DashboardStatDefinition(string WidgetKey, string Label);

    private sealed class DashboardStatState(string widgetKey, string label)
    {
        public string WidgetKey { get; } = widgetKey;
        public string Label { get; set; } = label;
        public string Value { get; set; } = "-";
        public string? Subtext { get; set; }
        public bool? Trend { get; set; }
        public bool Loading { get; set; } = true;
    }
}
