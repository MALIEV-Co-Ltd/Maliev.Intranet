@page "/mfg/suppliers/{Id:guid}"
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Supplier Details - Maliev Intranet</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_supplier == null)
{
    <MudAlert Severity="Severity.Error">Supplier not found.</MudAlert>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/mfg/suppliers"))">
        Back to List
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.h5">@_supplier.CompanyName</MudText>
                <MudChip T="string" Size="Size.Medium" Color="@(_supplier.Status == "Active" ? Color.Success : Color.Default)">
                    @_supplier.Status
                </MudChip>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                @if (_supplier.Status == "Active")
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Outlined.Block"
                               OnClick="@DeactivateSupplier">
                        Deactivate
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mt-4">
        <MudTabPanel Text="Contact Information" Icon="@Icons.Material.Outlined.ContactPage">
            <MudGrid Class="pa-4">
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Contact Details</MudText>
                        <MudStack Spacing="2">
                            @{
                                var primaryContact = _supplier.Contacts.FirstOrDefault(c => c.IsPrimary) ?? _supplier.Contacts.FirstOrDefault();
                            }
                            @if (primaryContact != null)
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Email:</MudText>
                                    <MudLink Href="@($"mailto:{primaryContact.Email}")">@primaryContact.Email</MudLink>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(primaryContact.Phone))
                                {
                                    <MudStack Row="true">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Phone:</MudText>
                                        <MudText Typo="Typo.body2">@primaryContact.Phone</MudText>
                                    </MudStack>
                                }
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Contact Person:</MudText>
                                    <MudText Typo="Typo.body2">@primaryContact.Name</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">Location & Performance</MudText>
                        <MudStack Spacing="2">
                            @if (!string.IsNullOrEmpty(_supplier.Country))
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Country:</MudText>
                                    <MudText Typo="Typo.body2">@_supplier.Country</MudText>
                                </MudStack>
                            }
                            @if (!string.IsNullOrEmpty(_supplier.Address))
                            {
                                <MudStack Row="true">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Address:</MudText>
                                    <MudText Typo="Typo.body2">@_supplier.Address</MudText>
                                </MudStack>
                            }
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Rating:</MudText>
                                @if (_supplier.PerformanceSummary != null && _supplier.PerformanceSummary.OverallRating.HasValue)
                                {
                                    <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(_supplier.PerformanceSummary.OverallRating.Value))" MaxValue="5" />
                                    <MudText Typo="Typo.body2">@_supplier.PerformanceSummary.OverallRating.Value.ToString("F1")</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">No ratings yet</MudText>
                                }
                            </MudStack>
                            <MudStack Row="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">Member Since:</MudText>
                                <MudText Typo="Typo.body2">@_supplier.CreatedAt.ToString("dd MMM yyyy")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Purchase Orders" Icon="@Icons.Material.Outlined.ShoppingCart">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Purchase order history for this supplier will appear here.</MudText>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Materials" Icon="@Icons.Material.Outlined.Inventory">
            <MudPaper Elevation="0" Class="pa-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Materials supplied by this supplier will appear here.</MudText>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private SupplierDetailDto? _supplier;
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSupplier();
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Manufacturing", href: null, disabled: true),
            new BreadcrumbItem("Suppliers", href: "/mfg/suppliers"),
            new BreadcrumbItem(_supplier?.CompanyName ?? Id.ToString(), href: null, disabled: true)
        };
    }

    private async Task LoadSupplier()
    {
        try
        {
            _isLoading = true;
            _supplier = await Http.GetFromJsonAsync<SupplierDetailDto>($"api/suppliers/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading supplier: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeactivateSupplier()
    {
        if (_supplier == null) return;

        try
        {
            var response = await Http.PatchAsync($"api/suppliers/{Id}/deactivate", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Supplier deactivated successfully.", Severity.Success);
                await LoadSupplier();
            }
            else
            {
                Snackbar.Add("Failed to deactivate supplier.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
