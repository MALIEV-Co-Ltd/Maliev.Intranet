@page "/finance/payments"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Helpers
@inject HttpClient Http

<PageTitle>Payments - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Payment Transactions</MudText>

<MudGrid Class="mb-4">
    @if (_isLoading)
    {
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="rounded-lg" />
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Today's Total</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">@ThaiCurrency.Format(_stats.TodayTotal, 2)</MudText>
                    <MudText Typo="Typo.caption" Color="@(_stats.PercentageChangeFromYesterday >= 0 ? Color.Success : Color.Error)">
                        <MudIcon Icon="@(_stats.PercentageChangeFromYesterday >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)" Size="Size.Small" /> 
                        @Math.Abs(_stats.PercentageChangeFromYesterday).ToString("P0") from yesterday
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight: 700;">@ThaiCurrency.Format(_stats.PendingTotal, 2)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_stats.PendingCount transactions</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Successful</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">@ThaiCurrency.Format(_stats.MonthTotal, 2)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">This month</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Failed</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight: 700;">@ThaiCurrency.Format(_stats.FailedTotal, 2)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Error">@_stats.FailedCount transactions</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search transactions..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download">
            Export
        </MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <div class="pa-4">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
        }
    </div>
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="PaymentSummaryDto" Items="@_payments" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.PaymentNumber" Title="Number" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" />
                <PropertyColumn Property="x => x.PaymentMethod" Title="Method" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.PaymentDate" Title="Date" Format="dd MMM yyyy HH:mm" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Color="Color.Primary" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Secondary">No transactions found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<PaymentSummaryDto> _payments = new();
    private PaymentStatsDto _stats = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var statsTask = Http.GetFromJsonAsync<PaymentStatsDto>("api/payments/stats");
            var paymentsTask = Http.GetFromJsonAsync<PagedResponse<PaymentSummaryDto>>("api/payments");

            await Task.WhenAll(statsTask, paymentsTask);

            _stats = await statsTask ?? new();
            var response = await paymentsTask;
            _payments = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payments: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Success" => Color.Success,
        "Pending" => Color.Warning,
        "Failed" => Color.Error,
        "Refunded" => Color.Info,
        _ => Color.Default
    };
}

