@page "/finance/payments"

<PageTitle>Payments - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Payment Transactions</MudText>

<MudGrid Class="mb-4">
    @if (_isLoading)
    {
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="rounded-lg" />
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Today's Total</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">$42,350</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Success">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /> +12% from yesterday
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight: 700;">$8,120</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">3 transactions</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Successful</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight: 700;">$156,780</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">This month</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Failed</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight: 700;">$2,450</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Error">2 transactions</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudTextField @bind-Value="_searchString" 
                      Placeholder="Search transactions..." 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" 
                      Margin="Margin.Dense" 
                      Style="max-width: 400px;" />
        
        <MudDateRangePicker Label="Date Range" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 300px;" />
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download">
            Export
        </MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <div class="pa-4">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
        }
    </div>
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="PaymentDto" Items="@_payments" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.TransactionId" Title="Transaction ID" />
                <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice #" />
                <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
                <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" />
                <PropertyColumn Property="x => x.Method" Title="Method" />
                <PropertyColumn Property="x => x.Provider" Title="Provider" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Date" Title="Date" Format="dd MMM yyyy HH:mm" />
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Color="Color.Primary" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<PaymentDto> _payments = new();

    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace with BFF API call
        // _payments = await Http.GetFromJsonAsync<List<PaymentDto>>("api/payments");
        await Task.Delay(500);
        _isLoading = false;
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Success" => Color.Success,
        "Pending" => Color.Warning,
        "Failed" => Color.Error,
        "Refunded" => Color.Info,
        _ => Color.Default
    };

    public class PaymentDto
    {
        public Guid Id { get; set; }
        public string TransactionId { get; set; } = string.Empty;
        public string InvoiceNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string Method { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime Date { get; set; }
    }
}
