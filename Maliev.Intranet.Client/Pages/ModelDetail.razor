@page "/mfg/models/{Id:guid}"
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(model?.FileName ?? "3D Model") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudBreadcrumbs Items="_breadcrumbs" />

    @if (_isLoading)
    {
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="600px" Class="rounded-lg" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else if (model == null)
    {
        <MudAlert Severity="Severity.Error">Model not found.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">@model.FileName</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Info">@model.ContentType</MudChip>
                    @if (model.GeometryAnalyzed)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Analyzed</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassEmpty">Analysis Pending</MudChip>
                    }
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadOriginal">Original</MudButton>
                @if (!string.IsNullOrEmpty(model.ViewerUrl))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="DownloadGlb">GLB</MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteModel">Delete</MudButton>
            </MudStack>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" lg="8">
                @if (!string.IsNullOrEmpty(model.ViewerUrl))
                {
                    <ModelViewer Model="model" ViewerUrl="@model.ViewerUrl" />
                }
                else
                {
                    <MudPaper Height="600px" Class="d-flex flex-column align-center justify-center border mud-border-lines-default rounded-lg">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                        <MudText Typo="Typo.h6">Viewer Preview Not Available</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">The GLB artifact for this model hasn't been generated yet or analysis failed.</MudText>
                    </MudPaper>
                }
            </MudItem>
            
            <MudItem xs="12" lg="4">
                <MudStack Spacing="4">
                    <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">File Information</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr>
                                        <td><strong>File Name</strong></td>
                                        <td>@model.FileName</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Original Name</strong></td>
                                        <td>@(model.OriginalFileName ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <td><strong>File Size</strong></td>
                                        <td>@FormatFileSize(model.FileSize)</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Format</strong></td>
                                        <td>@Path.GetExtension(model.FileName).ToUpper().TrimStart('.')</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Uploaded By</strong></td>
                                        <td>@model.UploadedBy</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Uploaded At</strong></td>
                                        <td>@model.UploadedAt.ToString("g")</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>

                    <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Geometry Analysis</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (model.GeometryAnalyzed)
                            {
                                <MudSimpleTable Dense="true" Elevation="0">
                                    <tbody>
                                        <tr>
                                            <td><strong>Triangles</strong></td>
                                            <td>@model.TriangleCount?.ToString("N0")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Volume</strong></td>
                                            <td>@(model.VolumeCm3?.ToString("F4") ?? "-") cm³</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Support Vol</strong></td>
                                            <td>@(model.SupportVolumeCm3?.ToString("F4") ?? "-") cm³</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Surface Area</strong></td>
                                            <td>@(model.SurfaceAreaCm2?.ToString("F4") ?? "-") cm²</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Bounding Box</strong></td>
                                            <td>
                                                X: @(model.BoundingBoxX?.ToString("F2") ?? "-") mm<br/>
                                                Y: @(model.BoundingBoxY?.ToString("F2") ?? "-") mm<br/>
                                                Z: @(model.BoundingBoxZ?.ToString("F2") ?? "-") mm
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Is Manifold</strong></td>
                                            <td>
                                                @if (model.IsManifold == true)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Yes</MudChip>
                                                }
                                                else if (model.IsManifold == false)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">No</MudChip>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption">-</MudText>
                                                }
                                            </td>
                                        </tr>
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else
                            {
                                <div class="pa-4 d-flex flex-column align-center">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" Class="mb-2" />
                                    <MudText Typo="Typo.body2" Align="Align.Center">Waiting for GeometryService to analyze model...</MudText>
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>

                    @* Placeholder for Linked Orders and Customer as per spec *@
                    <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Associated Orders</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="italic">No linked orders found.</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private Model3DDto? model;
    private bool _isLoading = true;
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("3D Models", href: "/mfg/models"),
            new BreadcrumbItem("Detail", href: null, disabled: true)
        };

        await LoadModel();
    }

    private async Task LoadModel()
    {
        _isLoading = true;
        try
        {
            model = await Http.GetFromJsonAsync<Model3DDto>($"api/models/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading model: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:F1} {suffixes[counter]}";
    }

    private async Task DownloadOriginal()
    {
        if (model == null) return;
        
        if (!string.IsNullOrEmpty(model.DownloadUrl))
        {
            await JS.InvokeVoidAsync("open", model.DownloadUrl, "_blank");
        }
        else
        {
            Snackbar.Add("Download URL not available.", Severity.Warning);
        }
    }

    private async Task DownloadGlb()
    {
        if (model == null || string.IsNullOrEmpty(model.ViewerUrl)) return;
        await JS.InvokeVoidAsync("open", model.ViewerUrl, "_blank");
    }

    private async Task DeleteModel()
    {
        var result = await DialogService.ShowMessageBox(
            "Delete Model",
            "Are you sure you want to delete this 3D model? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/models/{Id}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Model deleted successfully", Severity.Success);
                    NavigationManager.NavigateTo("/mfg/models");
                }
                else
                {
                    Snackbar.Add("Failed to delete model", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting model: {ex.Message}", Severity.Error);
            }
        }
    }
}
