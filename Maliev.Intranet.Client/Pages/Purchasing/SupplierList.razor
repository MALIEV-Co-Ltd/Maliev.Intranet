@page "/purchasing/suppliers"
@using System.Net.Http.Headers
@using System.Text.Json
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Supplier Profiles | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="Supplier Profiles" Subtitle="Procurement supplier source records and purchasing readiness." BackHref="/purchasing">
        <PrimaryButton Icon="@Icons.Material.Outlined.AddBusiness" OnClick="@ShowCreateAsync">New Supplier</PrimaryButton>
    </PageHeader>

    <PageBody>
        <StatBar Class="mb-4">
            <StatTile Label="Suppliers" Value="@_meta.TotalItems.ToString("N0")" />
            <StatTile Label="On page" Value="@_suppliers.Count.ToString("N0")" />
            <StatTile Label="Active" Value="@_suppliers.Count(IsActive).ToString("N0")" />
            <StatTile Label="Countries" Value="@_suppliers.Select(s => s.Country).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")" />
        </StatBar>

        @if (_showCreate)
        {
            <PanelCard Title="Create supplier" Class="mb-4 supplier-create-card">
                <div class="supplier-intake-grid">
                    <section class="supplier-ai-panel" aria-label="AI supplier extraction">
                        <div class="supplier-panel-heading">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" />
                            <div>
                                <strong>Extract from supplier text or documents</strong>
                                <span>Paste emails, invoices, registry text, business cards, or upload supplier documents.</span>
                            </div>
                        </div>
                        <ImmediateInputTextArea class="mlv-form-textarea supplier-ai-textarea"
                                                @bind-Value="_supplierExtractionText"
                                                placeholder="Paste supplier profile, quotation email, tax invoice, registration text, or contact block..." />
                        <div class="supplier-file-row">
                            <InputFile OnChange="OnExtractionFilesSelected" multiple />
                            @if (_extractionFiles.Count > 0)
                            {
                                <span>@_extractionFiles.Count file(s) selected</span>
                            }
                        </div>
                        @if (_extractionFiles.Count > 0)
                        {
                            <div class="supplier-file-list">
                                @foreach (var file in _extractionFiles)
                                {
                                    <span><MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" /> @file.Name <small>@FormatFileSize(file.Size)</small></span>
                                }
                            </div>
                        }
                        <div class="supplier-intake-actions">
                            <SecondaryButton Icon="@Icons.Material.Outlined.AutoFixHigh" Disabled="@(_extracting || !CanExtractSupplier)" OnClick="@ExtractSupplierAsync">
                                @(_extracting ? "Extracting..." : "Extract and autofill")
                            </SecondaryButton>
                        </div>
                        @if (_lastExtraction is not null)
                        {
                            <div class="supplier-extraction-summary">
                                <strong>AI extraction @((_lastExtraction.Confidence * 100).ToString("0"))%</strong>
                                <span>@GetExtractionSummary()</span>
                                @if (_lastExtraction.DocumentTypes.Count > 0)
                                {
                                    <small>Documents detected: @string.Join(", ", _lastExtraction.DocumentTypes)</small>
                                }
                            </div>
                        }
                    </section>

                    <section class="supplier-registry-panel" aria-label="Registry company lookup">
                        <div class="supplier-panel-heading">
                            <MudIcon Icon="@Icons.Material.Outlined.ManageSearch" Size="Size.Small" />
                            <div>
                                <strong>Registry lookup</strong>
                                <span>Search Thai company registry by name or 13-digit tax ID, then apply the official company profile.</span>
                            </div>
                        </div>
                        <div class="supplier-registry-search">
                            <ImmediateInputText class="mlv-form-input" @bind-Value="_registryQuery" placeholder="Company name or tax ID" />
                            <SecondaryButton Icon="@Icons.Material.Outlined.Search" Disabled="@_registrySearching" OnClick="@SearchRegistryAsync">
                                @(_registrySearching ? "Searching..." : "Search")
                            </SecondaryButton>
                        </div>
                        @if (_registryResults.Count > 0)
                        {
                            <div class="supplier-suggestion-header">@_registryResults.Count matched result(s)</div>
                            <div class="supplier-suggestion-list">
                                @foreach (var company in _registryResults)
                                {
                                    <button type="button" class="supplier-suggestion-card" @onclick="@(() => ApplyRegistryCompany(company))">
                                        <span>
                                            <strong>@Display(company.CompanyNameTh)</strong>
                                            <small>@Display(company.TaxId)</small>
                                        </span>
                                        <span>
                                            <em>Registry</em>
                                            <small>@Display(company.StatusNameTh)</small>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else if (_registrySearched)
                        {
                            <div class="supplier-empty-inline">No registry matches found.</div>
                        }
                    </section>
                </div>

                <FormGrid>
                    <FormField Label="Supplier name"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.Name" /></FormField>
                    <FormField Label="Tax ID"><ImmediateInputText class="mlv-form-input mlv-mono" @bind-Value="_newSupplier.TaxId" /></FormField>
                    <FormField Label="Email"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.Email" /></FormField>
                    <FormField Label="Phone"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.Phone" /></FormField>
                    <FormField Label="Contact person"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.ContactPerson" /></FormField>
                    <FormField Label="Country"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.Country" /></FormField>
                    <FormField Label="City"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.City" /></FormField>
                    <FormField Label="Postal code"><ImmediateInputText class="mlv-form-input" @bind-Value="_newSupplier.PostalCode" /></FormField>
                    <FormField Label="Address" Class="mlv-span-6"><ImmediateInputTextArea class="mlv-form-textarea" @bind-Value="_newSupplier.Address" /></FormField>
                    <FormField Label="Capabilities" Class="mlv-span-6">
                        <ImmediateInputText class="mlv-form-input" @bind-Value="_capabilityText" placeholder="CNC, Sheet metal, Anodizing" />
                    </FormField>
                </FormGrid>
                <div class="mlv-toolbar mt-4" style="justify-content:flex-end">
                    <SecondaryButton OnClick="@HideCreateAsync">Cancel</SecondaryButton>
                    <PrimaryButton Icon="@Icons.Material.Outlined.Save" Disabled="@_saving" OnClick="@CreateSupplierAsync">Create Supplier</PrimaryButton>
                </div>
            </PanelCard>
        }

        <PanelCard>
            @if (_loading)
            {
                <ProgressiveSkeleton Layout="table" Rows="6" Columns="4" ShowFilters="false" Label="Loading suppliers" />
            }
            else if (_suppliers.Count == 0)
            {
                <div class="mlv-empty">No suppliers found.</div>
            }
            else
            {
                <table class="mlv-table">
                    <thead>
                        <tr>
                            <th>Supplier</th>
                            <th>Tax ID</th>
                            <th>Country</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in _suppliers)
                        {
                            <tr @onclick="@(() => Navigation.NavigateTo($"/purchasing/suppliers/{supplier.Id}"))">
                                <td>
                                    <div class="mlv-row-main">@supplier.Name</div>
                                    <div class="mlv-row-sub">@Display(supplier.City)</div>
                                </td>
                                <td class="mlv-mono">@Display(supplier.TaxId)</td>
                                <td>@Display(supplier.Country)</td>
                                <td><StatusBadge Status="@supplier.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </PanelCard>

        <PaginationFooter Meta="@_meta"
                          CurrentPage="@_page"
                          PageSize="@_pageSize"
                          PageChanged="OnPageChanged"
                          PageSizeChanged="OnPageSizeChanged"
                          Disabled="@_loading" />
    </PageBody>
</div>

@code {
    private readonly List<SupplierSummaryDto> _suppliers = [];
    private PaginationMeta _meta = new();
    private CreateSupplierRequest _newSupplier = new()
    {
        Country = "Thailand",
        City = "Bangkok"
    };
    private string _capabilityText = string.Empty;
    private string _supplierExtractionText = string.Empty;
    private string _registryQuery = string.Empty;
    private readonly List<IBrowserFile> _extractionFiles = [];
    private readonly List<RegistryCompanyProfile> _registryResults = [];
    private ExtractedSupplierDataResponse? _lastExtraction;
    private bool _loading = true;
    private bool _saving;
    private bool _showCreate;
    private bool _extracting;
    private bool _registrySearching;
    private bool _registrySearched;
    private int _page = 1;
    private int _pageSize = 20;

    private bool CanExtractSupplier => !string.IsNullOrWhiteSpace(_supplierExtractionText) || _extractionFiles.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<SupplierSummaryDto>>($"api/v1/suppliers?page={_page}&pageSize={_pageSize}");
            _suppliers.Clear();
            _suppliers.AddRange(response?.Data ?? []);
            _meta = response?.Meta ?? new PaginationMeta();
            _meta.CurrentPage = _meta.CurrentPage == 0 ? _page : _meta.CurrentPage;
            _meta.PageSize = _meta.PageSize == 0 ? _pageSize : _meta.PageSize;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load suppliers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await LoadAsync();
    }

    private Task ShowCreateAsync(MouseEventArgs _)
    {
        _showCreate = true;
        if (string.IsNullOrWhiteSpace(_registryQuery))
        {
            _registryQuery = _newSupplier.TaxId;
        }
        return Task.CompletedTask;
    }

    private Task HideCreateAsync(MouseEventArgs _)
    {
        _showCreate = false;
        _lastExtraction = null;
        _registryResults.Clear();
        _registrySearched = false;
        return Task.CompletedTask;
    }

    private void OnExtractionFilesSelected(InputFileChangeEventArgs args)
    {
        _extractionFiles.Clear();
        _extractionFiles.AddRange(args.GetMultipleFiles(10));
    }

    private async Task ExtractSupplierAsync(MouseEventArgs _)
    {
        if (!CanExtractSupplier)
        {
            return;
        }

        _extracting = true;
        try
        {
            using var content = new MultipartFormDataContent();
            if (!string.IsNullOrWhiteSpace(_supplierExtractionText))
            {
                content.Add(new StringContent(_supplierExtractionText), "rawText");
            }

            foreach (var file in _extractionFiles)
            {
                var stream = file.OpenReadStream(10 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(fileContent, "files", file.Name);
            }

            var response = await Http.PostAsync("api/v1/aiprocessing/extract-supplier", content);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Supplier information could not be extracted.", Severity.Warning);
                return;
            }

            var extracted = await response.Content.ReadFromJsonAsync<ExtractedSupplierDataResponse>();
            if (extracted is null)
            {
                Snackbar.Add("Supplier extraction returned no usable data.", Severity.Warning);
                return;
            }

            ApplyExtraction(extracted);
            _lastExtraction = extracted;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to extract supplier data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _extracting = false;
        }
    }

    private async Task SearchRegistryAsync(MouseEventArgs _)
    {
        var query = !string.IsNullOrWhiteSpace(_registryQuery)
            ? _registryQuery
            : !string.IsNullOrWhiteSpace(_newSupplier.TaxId)
                ? _newSupplier.TaxId
                : _newSupplier.Name;

        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 2)
        {
            Snackbar.Add("Enter a company name or tax ID to search the registry.", Severity.Warning);
            return;
        }

        _registrySearching = true;
        _registrySearched = false;
        try
        {
            var matches = await Http.GetFromJsonAsync<List<RegistryCompanyProfile>>(
                $"api/v1/suppliers/companies/search?query={Uri.EscapeDataString(query.Trim())}&limit=8");
            _registryResults.Clear();
            _registryResults.AddRange(matches ?? []);
            _registrySearched = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registry lookup failed: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _registrySearching = false;
        }
    }

    private void ApplyRegistryCompany(RegistryCompanyProfile company)
    {
        _newSupplier.Name = string.IsNullOrWhiteSpace(company.CompanyNameTh) ? _newSupplier.Name : company.CompanyNameTh;
        _newSupplier.TaxId = string.IsNullOrWhiteSpace(company.TaxId) ? _newSupplier.TaxId : company.TaxId;
        _registryQuery = _newSupplier.TaxId;

        if (!string.IsNullOrWhiteSpace(company.BusinessObjectives))
        {
            var capabilities = SplitDisplayList(_capabilityText).ToList();
            if (!capabilities.Any(item => string.Equals(item, company.BusinessObjectives, StringComparison.OrdinalIgnoreCase)))
            {
                capabilities.Add(company.BusinessObjectives);
                _capabilityText = string.Join(", ", capabilities);
            }
        }
    }

    private void ApplyExtraction(ExtractedSupplierDataResponse extracted)
    {
        SetIfPresent(value => _newSupplier.Name = value, extracted.SupplierName);
        SetIfPresent(value => _newSupplier.TaxId = value, extracted.TaxId);
        SetIfPresent(value => _newSupplier.Email = value, extracted.Email);
        SetIfPresent(value => _newSupplier.Phone = value, extracted.Phone);
        SetIfPresent(value => _newSupplier.ContactPerson = value, extracted.ContactPerson);
        SetIfPresent(value => _newSupplier.Country = value, extracted.Country);

        if (extracted.Address is not null)
        {
            SetIfPresent(value => _newSupplier.Address = value, ComposeAddress(extracted.Address));
            SetIfPresent(value => _newSupplier.City = value, extracted.Address.City);
            SetIfPresent(value => _newSupplier.PostalCode = value, extracted.Address.PostalCode);
        }

        if (extracted.Capabilities.Count > 0)
        {
            _capabilityText = string.Join(", ", extracted.Capabilities.Distinct(StringComparer.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_newSupplier.TaxId))
        {
            _registryQuery = _newSupplier.TaxId;
        }
    }

    private async Task CreateSupplierAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_newSupplier.Name) ||
            string.IsNullOrWhiteSpace(_newSupplier.TaxId) ||
            string.IsNullOrWhiteSpace(_newSupplier.Email) ||
            string.IsNullOrWhiteSpace(_newSupplier.Address) ||
            string.IsNullOrWhiteSpace(_newSupplier.City) ||
            string.IsNullOrWhiteSpace(_newSupplier.Country))
        {
            Snackbar.Add("Enter supplier name, tax ID, email, address, city, and country.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _newSupplier.Capabilities = SplitDisplayList(_capabilityText).ToList();
            _newSupplier.Name = _newSupplier.Name.Trim();
            _newSupplier.TaxId = _newSupplier.TaxId.Trim();
            _newSupplier.Email = _newSupplier.Email.Trim();
            _newSupplier.Address = _newSupplier.Address?.Trim();
            _newSupplier.City = _newSupplier.City.Trim();
            _newSupplier.Country = _newSupplier.Country.Trim();
            _newSupplier.PostalCode = _newSupplier.PostalCode?.Trim();
            _newSupplier.ContactPerson = _newSupplier.ContactPerson?.Trim();

            var response = await Http.PostAsJsonAsync("api/v1/suppliers", _newSupplier);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(body) ? "Supplier could not be created." : body, Severity.Warning);
                return;
            }

            var supplierId = await ReadSupplierIdAsync(response);
            Snackbar.Add("Supplier created.", Severity.Success);
            _newSupplier = new CreateSupplierRequest { Country = "Thailand", City = "Bangkok" };
            _capabilityText = string.Empty;
            _supplierExtractionText = string.Empty;
            _extractionFiles.Clear();
            _lastExtraction = null;
            _showCreate = false;

            if (supplierId is not null)
            {
                Navigation.NavigateTo($"/purchasing/suppliers/{supplierId}");
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to create supplier: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static async Task<Guid?> ReadSupplierIdAsync(HttpResponseMessage response)
    {
        await using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);
        return document.RootElement.TryGetProperty("id", out var idElement) &&
            Guid.TryParse(idElement.GetString(), out var id)
                ? id
                : null;
    }

    private static IReadOnlyList<string> SplitDisplayList(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private static void SetIfPresent(Action<string> setter, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            setter(value.Trim());
        }
    }

    private static string ComposeAddress(ExtractedSupplierAddress address)
    {
        return string.Join(", ", new[]
        {
            address.AddressLine1,
            address.District,
            address.StateProvince
        }.Where(part => !string.IsNullOrWhiteSpace(part)).Select(part => part!.Trim()));
    }

    private string GetExtractionSummary()
    {
        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(_newSupplier.Name)) missing.Add("name");
        if (string.IsNullOrWhiteSpace(_newSupplier.TaxId)) missing.Add("tax ID");
        if (string.IsNullOrWhiteSpace(_newSupplier.Email)) missing.Add("email");
        if (string.IsNullOrWhiteSpace(_newSupplier.Address)) missing.Add("address");
        if (string.IsNullOrWhiteSpace(_newSupplier.City)) missing.Add("city");

        return missing.Count == 0
            ? "Required supplier fields were filled from the extraction."
            : $"Needs manual input: {string.Join(", ", missing)}.";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes / 1024d / 1024d:0.#} MB";
    }

    private static bool IsActive(SupplierSummaryDto supplier)
    {
        return string.Equals(supplier.Status, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }
}
