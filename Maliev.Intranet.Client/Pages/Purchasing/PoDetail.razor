@page "/purchasing/{Id:int}"
@page "/mfg/procurement/{Id:int}"
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Purchase Order | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <PageHeader Title="@(_order?.PoNumber ?? "Purchase Order")" Subtitle="@(_order?.SupplierName ?? "Procurement detail")" BackHref="/purchasing">
        @if (_order is not null)
        {
            <StatusBadge Status="@_order.Status" />
        }
    </PageHeader>

    <PageBody>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_order is null)
        {
            <div class="mlv-empty">Purchase order was not found.</div>
        }
        else
        {
            <div class="mlv-toolbar mb-4">
                <div class="mlv-toolbar-left">
                    <SecondaryButton Icon="@Icons.Material.Outlined.CheckCircle" Disabled="@(!CanApprove || _busy)" OnClick="@ApproveAsync">Approve</SecondaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.Send" Disabled="@(!CanSend || _busy)" OnClick="@SendAsync">Send</SecondaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.Inventory" Disabled="@(!CanReceive || _busy)" OnClick="@ReceiveAsync">Receive</SecondaryButton>
                    <SecondaryButton Icon="@Icons.Material.Outlined.FileDownload" Disabled="@_busy" OnClick="@ExportAsync">Export</SecondaryButton>
                </div>
                <div class="mlv-toolbar-right">
                    <SecondaryButton Icon="@Icons.Material.Outlined.Cancel" Disabled="@(!CanCancel || _busy)" OnClick="@ShowCancelAsync">Cancel PO</SecondaryButton>
                </div>
            </div>

            @if (_showCancel)
            {
                <PanelCard Title="Cancel purchase order" Class="mb-4">
                    <textarea class="mlv-form-input" rows="3" @bind="_cancelReason" placeholder="Cancellation reason"></textarea>
                    <div class="mlv-toolbar mt-3" style="justify-content:flex-end">
                        <SecondaryButton Disabled="@_busy" OnClick="@HideCancelAsync">Keep PO</SecondaryButton>
                        <PrimaryButton Icon="@Icons.Material.Outlined.Cancel" Disabled="@_busy" OnClick="@CancelAsync">Confirm cancel</PrimaryButton>
                    </div>
                </PanelCard>
            }

            <StatBar Class="mb-4">
                <StatTile Label="Total" Value="@FormatMoney(_order.TotalAmount, _order.CurrencyCode)" />
                <StatTile Label="Items" Value="@_order.ItemsCount.ToString("N0")" />
                <StatTile Label="Issued" Value="@_order.Date.ToString("dd MMM yyyy")" />
                <StatTile Label="Expected" Value="@(_order.ExpectedDelivery?.ToString("dd MMM yyyy") ?? "-")" />
            </StatBar>

            <div class="mlv-two-column-grid">
                <PanelCard Title="Purchase order">
                    <dl class="mlv-detail-list">
                        <dt>Type</dt><dd>@Display(_order.OrderType)</dd>
                        <dt>Status</dt><dd>@Display(_order.Status)</dd>
                        <dt>Supplier ID</dt><dd class="mlv-mono">@_order.SupplierId</dd>
                        <dt>Source order</dt><dd class="mlv-mono">@_order.OrderId</dd>
                        <dt>Customer PO</dt><dd>@Display(_order.CustomerPo)</dd>
                        <dt>Currency</dt><dd>@Display(_order.CurrencyCode)</dd>
                        <dt>WHT</dt><dd>@((_order.WhtRate ?? 0).ToString("N2"))%</dd>
                    </dl>
                </PanelCard>

                <PanelCard Title="Lifecycle">
                    <dl class="mlv-detail-list">
                        <dt>Created by</dt><dd>@Display(_order.CreatedBy)</dd>
                        <dt>Created</dt><dd>@_order.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                        <dt>Approved by</dt><dd>@Display(_order.ApprovedBy)</dd>
                        <dt>Approved</dt><dd>@(_order.ApprovedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</dd>
                        <dt>Modified by</dt><dd>@Display(_order.LastModifiedBy)</dd>
                        <dt>Modified</dt><dd>@(_order.LastModifiedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</dd>
                    </dl>
                </PanelCard>
            </div>

            <PanelCard Title="Line items" Class="mt-4">
                @if (_order.Items.Count > 0)
                {
                    <table class="mlv-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>External ID</th>
                                <th>Qty</th>
                                <th>Unit</th>
                                <th>Unit price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _order.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="mlv-row-main">@Display(item.ProductName)</div>
                                        <div class="mlv-row-sub mlv-mono">@Display(item.ProductCode)</div>
                                    </td>
                                    <td class="mlv-mono">@item.ExternalOrderItemId</td>
                                    <td>@item.Quantity.ToString("N2")</td>
                                    <td>@Display(item.UnitOfMeasure)</td>
                                    <td class="mlv-mono">@item.UnitPrice.ToString("N2")</td>
                                    <td class="mlv-mono">@item.TotalPrice.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No line items.</div>
                }
            </PanelCard>

            <PanelCard Title="Files" Class="mt-4">
                @if (_order.Files.Count > 0)
                {
                    <table class="mlv-table">
                        <thead><tr><th>File</th><th>Type</th><th>Size</th><th>Uploaded</th></tr></thead>
                        <tbody>
                            @foreach (var file in _order.Files)
                            {
                                <tr>
                                    <td>@Display(file.FileName)</td>
                                    <td>@Display(file.DocumentType)</td>
                                    <td>@FormatBytes(file.FileSize)</td>
                                    <td>@file.UploadedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="mlv-empty">No files attached.</div>
                }
            </PanelCard>
        }
    </PageBody>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PurchaseOrderDto? _order;
    private bool _loading = true;
    private bool _busy;
    private bool _showCancel;
    private string _cancelReason = string.Empty;

    private bool CanApprove => HasStatus("Pending");
    private bool CanSend => HasStatus("Approved");
    private bool CanReceive => HasStatus("Ordered");
    private bool CanCancel => !HasStatus("Delivered") && !HasStatus("Cancelled");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _order = await Http.GetFromJsonAsync<PurchaseOrderDto>($"api/v1/procurement/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Purchase order could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(MouseEventArgs _) =>
        await RunLifecycleAsync(() => Http.PostAsync($"api/v1/procurement/{Id}/approve", null), "Purchase order approved.");

    private async Task SendAsync(MouseEventArgs _) =>
        await RunLifecycleAsync(() => Http.PostAsync($"api/v1/procurement/{Id}/send-to-supplier", null), "Purchase order sent to supplier.");

    private async Task ReceiveAsync(MouseEventArgs _) =>
        await RunLifecycleAsync(() => Http.PostAsync($"api/v1/procurement/{Id}/receive?isPartialReceipt=false", null), "Purchase order received.");

    private Task ShowCancelAsync(MouseEventArgs _)
    {
        _showCancel = true;
        return Task.CompletedTask;
    }

    private Task HideCancelAsync(MouseEventArgs _)
    {
        _showCancel = false;
        return Task.CompletedTask;
    }

    private async Task CancelAsync(MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            Snackbar.Add("Enter a cancellation reason.", Severity.Warning);
            return;
        }

        await RunLifecycleAsync(
            () => Http.PostAsJsonAsync($"api/v1/procurement/{Id}/cancel", new CancelPurchaseOrderRequest { Reason = _cancelReason }),
            "Purchase order cancelled.",
            reloadAfterNoContent: true);
        _showCancel = false;
    }

    private async Task ExportAsync(MouseEventArgs _)
    {
        _busy = true;
        try
        {
            using var response = await Http.GetAsync($"api/v1/procurement/{Id}/export?format=pdf");
            Snackbar.Add(response.IsSuccessStatusCode ? "Purchase order export requested." : "Purchase order export failed.", response.IsSuccessStatusCode ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Purchase order export failed.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunLifecycleAsync(Func<Task<HttpResponseMessage>> action, string successMessage, bool reloadAfterNoContent = false)
    {
        _busy = true;
        try
        {
            using var response = await action();
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Purchase order action failed.", Severity.Warning);
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.NoContent || reloadAfterNoContent)
            {
                await LoadAsync();
            }
            else
            {
                _order = await response.Content.ReadFromJsonAsync<PurchaseOrderDto>();
            }

            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Purchase order action failed.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool HasStatus(string status) =>
        string.Equals(_order?.Status, status, StringComparison.OrdinalIgnoreCase);

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatMoney(decimal amount, string currency) => $"{amount:N2} {currency}";

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes:N0} B";
        var kb = bytes / 1024d;
        if (kb < 1024) return $"{kb:N1} KB";
        return $"{kb / 1024d:N1} MB";
    }
}
