<PageTitle>Organization Chart | Intranet Gateway</PageTitle>

@using Maliev.Intranet.Shared

<MudPaper Elevation="0" Class="@($"pa-4 border {(IsRoot ? "border-primary" : "mud-border-lines-default")} rounded mb-4")">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="@(IsRoot ? 3 : 2)">
            <MudAvatar Size="@(IsRoot ? Size.Large : Size.Medium)" Color="@GetColor()">@Node.Initials</MudAvatar>
            <div>
                <MudText Typo="@(IsRoot ? Typo.h6 : Typo.subtitle2)">@Node.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">@Node.Title</MudText>
            </div>
        </MudStack>
        
        @if (Node.TeamCount > 0)
        {
            <MudDivider />
            <MudText Typo="Typo.caption" Color="Color.Default">@Node.TeamCount team members</MudText>
        }

        @if (Node.Subordinates.Any())
        {
            <MudGrid Class="mt-2">
                @foreach (var sub in Node.Subordinates)
                {
                    <MudItem xs="12" md="4">
                        <OrgChartNode Node="sub" IsRoot="false" />
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public OrgNodeDto Node { get; set; } = null!;
    [Parameter] public bool IsRoot { get; set; }

    private Color GetColor() => Node.Department switch
    {
        "Executive" => Color.Primary,
        "Engineering" => Color.Info,
        "Sales" => Color.Success,
        "Operations" => Color.Warning,
        _ => Color.Default
    };
}
