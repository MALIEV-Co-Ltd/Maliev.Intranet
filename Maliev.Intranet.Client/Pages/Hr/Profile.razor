@page "/hr/profile"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>My Profile | MALIEV Intranet</PageTitle>

<div class="mlv-module-shell">
    <ModuleHeader Title="My Profile" Subtitle="Employee profile, preferences, and work details.">
        <SecondaryButton Icon="@Icons.Material.Outlined.Refresh" OnClick="@ReloadAsync">Refresh</SecondaryButton>
    </ModuleHeader>

    <PageBody>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="mlv-error">@_error</div>
        }

        @if (_profile is null && !_loading)
        {
            <div class="mlv-empty">Your employee profile could not be found.</div>
        }
        else if (_profile is not null)
        {
            <StatBar Class="mb-4">
                <StatTile Label="Status" Value="@DisplayStatus" />
                <StatTile Label="Department" Value="@Display(_profile.Department)" />
                <StatTile Label="Job Title" Value="@DisplayJobTitle" />
                <StatTile Label="Manager" Value="@Display(_profile.ManagerName)" />
            </StatBar>

            <div class="mlv-grid">
                <div class="mlv-span-7">
                    <PanelCard Title="Employee details">
                        <div class="mlv-actions mb-3">
                            @if (_editing)
                            {
                                <SecondaryButton Icon="@Icons.Material.Outlined.Close" OnClick="@CancelEditAsync">Cancel</SecondaryButton>
                                <PrimaryButton Icon="@Icons.Material.Outlined.Save" OnClick="@SaveProfileAsync" Disabled="@_saving">Save changes</PrimaryButton>
                            }
                            else
                            {
                                <PrimaryButton Icon="@Icons.Material.Outlined.Edit" OnClick="@StartEditAsync">Edit profile</PrimaryButton>
                            }
                        </div>

                        @if (_editing)
                        {
                            <EditForm Model="@_editModel" class="profile-form">
                                <DataAnnotationsValidator />
                                <div class="profile-edit-grid">
                                    <label class="profile-field">
                                        <span>Preferred name</span>
                                        <InputText class="profile-input" @bind-Value="_editModel.PreferredName" />
                                        <ValidationMessage For="@(() => _editModel.PreferredName)" />
                                    </label>
                                    <label class="profile-field">
                                        <span>Personal email</span>
                                        <InputText class="profile-input" type="email" @bind-Value="_editModel.PersonalEmail" />
                                        <ValidationMessage For="@(() => _editModel.PersonalEmail)" />
                                    </label>
                                    <label class="profile-field">
                                        <span>Mobile phone</span>
                                        <InputText class="profile-input" type="tel" @bind-Value="_editModel.MobilePhone" />
                                        <ValidationMessage For="@(() => _editModel.MobilePhone)" />
                                    </label>
                                </div>
                            </EditForm>
                        }

                        <table class="mlv-table profile-table">
                            <tbody>
                                <tr><th>Name</th><td>@_profile.Name</td></tr>
                                <tr><th>Preferred name</th><td>@Display(_selfProfile?.PreferredName)</td></tr>
                                <tr><th>Email</th><td>@DisplayEmail</td></tr>
                                <tr><th>Personal email</th><td>@Display(_selfProfile?.PersonalEmail)</td></tr>
                                <tr><th>Phone</th><td>@Display(_selfProfile?.MobilePhone ?? _profile.Phone)</td></tr>
                                <tr><th>Location</th><td>@Display(_profile.WorkLocation)</td></tr>
                                <tr><th>Employee type</th><td>@DisplayEmployeeType</td></tr>
                                <tr><th>Hire date</th><td>@DisplayHireDate</td></tr>
                            </tbody>
                        </table>
                    </PanelCard>
                </div>
                <div class="mlv-span-5">
                    <PanelCard Title="Preferences">
                        <div class="mlv-list">
                            <div class="mlv-list-row">
                                <div>
                                    <div class="mlv-row-main">Profile scope</div>
                                    <div class="mlv-row-sub">Stored in EmployeeService preferences</div>
                                </div>
                                <StatusBadge Status="@(_preferences is null ? "Missing" : "Ready")" />
                            </div>
                            <div class="mlv-list-row">
                                <div>
                                    <div class="mlv-row-main">Preference keys</div>
                                    <div class="mlv-row-sub">@((_preferences?.PreferenceData.Count ?? 0).ToString("N0")) configured</div>
                                </div>
                                <SecondaryButton Icon="@Icons.Material.Outlined.Tune" OnClick="@LoadPreferencesAsync">Reload</SecondaryButton>
                            </div>
                        </div>
                    </PanelCard>
                </div>
                <div class="mlv-span-12">
                    <PanelCard Title="Teams and documents">
                        <div class="mlv-grid">
                            <div class="mlv-span-6">
                                @if (_profile.Teams.Count == 0)
                                {
                                    <div class="mlv-empty">No team assignments.</div>
                                }
                                else
                                {
                                    <div class="mlv-list">
                                        @foreach (var team in _profile.Teams)
                                        {
                                            <div class="mlv-list-row">
                                                <div>
                                                    <div class="mlv-row-main">@team.Name</div>
                                                    <div class="mlv-row-sub">@team.Role</div>
                                                </div>
                                                @if (team.IsLead)
                                                {
                                                    <StatusBadge Status="Lead" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="mlv-span-6">
                                @if (_profile.Documents.Count == 0)
                                {
                                    <div class="mlv-empty">No employee documents.</div>
                                }
                                else
                                {
                                    <div class="mlv-list">
                                        @foreach (var doc in _profile.Documents)
                                        {
                                            <div class="mlv-list-row">
                                                <div>
                                                    <div class="mlv-row-main">@doc.FileName</div>
                                                    <div class="mlv-row-sub">@doc.DocumentType</div>
                                                </div>
                                                <span>@doc.UploadedAt.ToString("dd MMM yyyy")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </PanelCard>
                </div>
            </div>
        }
    </PageBody>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private EmployeeDetailDto? _profile;
    private EmployeeSelfProfileDto? _selfProfile;
    private UserPreferenceDto? _preferences;
    private UpdateEmployeeSelfProfileRequest _editModel = new();
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private string? _error;

    private string DisplayEmail => Display(FirstNonBlank(_profile?.Email, _selfProfile?.WorkEmail));
    private string DisplayJobTitle => Display(FirstNonBlank(_profile?.Title, _selfProfile?.JobTitle));
    private string DisplayStatus => Display(FirstNonBlank(_profile?.Status, _selfProfile?.EmploymentStatus, "Active"));
    private string DisplayEmployeeType => FormatEmployeeType(FirstNonBlank(_profile?.EmployeeType, _selfProfile?.EmploymentType, "FullTime"));
    private string DisplayHireDate => (_profile?.HireDate ?? _selfProfile?.StartDate ?? _selfProfile?.CreatedAt)?.ToString("dd MMM yyyy") ?? "-";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ReloadAsync(MouseEventArgs _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var profileTask = Http.GetFromJsonAsync<EmployeeDetailDto>("api/v1/employees/me");
            var selfProfileTask = Http.GetFromJsonAsync<EmployeeSelfProfileDto>("api/v1/employees/me/profile");
            var preferencesTask = Http.GetFromJsonAsync<UserPreferenceDto>("api/v1/preferences/intranet-profile");
            await Task.WhenAll(profileTask, selfProfileTask, preferencesTask);
            _profile = await profileTask;
            _selfProfile = await selfProfileTask;
            _preferences = await preferencesTask;
            ResetEditModel();
        }
        catch (Exception ex)
        {
            _error = "Profile data could not be loaded.";
            Snackbar.Add(_error, Severity.Warning);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task StartEditAsync(MouseEventArgs _)
    {
        ResetEditModel();
        _editing = true;
        return Task.CompletedTask;
    }

    private Task CancelEditAsync(MouseEventArgs _)
    {
        ResetEditModel();
        _editing = false;
        return Task.CompletedTask;
    }

    private async Task SaveProfileAsync(MouseEventArgs _)
    {
        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/v1/employees/me/profile", _editModel);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Profile changes could not be saved.", Severity.Error);
                return;
            }

            _selfProfile = await response.Content.ReadFromJsonAsync<EmployeeSelfProfileDto>() ?? _selfProfile;
            _editing = false;
            Snackbar.Add("Profile updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Profile changes could not be saved.", Severity.Error);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetEditModel()
    {
        _editModel = new UpdateEmployeeSelfProfileRequest
        {
            PreferredName = _selfProfile?.PreferredName,
            PersonalEmail = _selfProfile?.PersonalEmail,
            MobilePhone = _selfProfile?.MobilePhone ?? _profile?.Phone
        };
    }

    private async Task LoadPreferencesAsync(MouseEventArgs _)
    {
        try
        {
            _preferences = await Http.GetFromJsonAsync<UserPreferenceDto>("api/v1/preferences/intranet-profile");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Preferences could not be loaded.", Severity.Warning);
            Console.WriteLine(ex.Message);
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatEmployeeType(string? value)
    {
        var display = FirstNonBlank(value, "FullTime");
        return display switch
        {
            "FullTime" => "Full Time",
            "PartTime" => "Part Time",
            _ => Display(display)
        };
    }

    private static string FirstNonBlank(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;
}
