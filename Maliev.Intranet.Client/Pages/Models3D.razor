@page "/mfg/models"
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>3D Models - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h5" Style="font-weight: 600;">3D Models Library</MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="OpenUploadDialog">
            Upload Model
        </MudButton>
    </MudStack>

    <MudPaper Elevation="0" Class="pa-4 mb-6 border mud-border-lines-default rounded-lg">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_searchString" 
                              Placeholder="Search models..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense"
                              Clearable="true"
                              OnClearButtonClick="() => LoadModels()"
                              OnKeyDown="HandleSearchKeyDown" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_filterProcess" Label="Process" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" SelectedValuesChanged="() => LoadModels()">
                    <MudSelectItem Value="@("All")">All Processes</MudSelectItem>
                    <MudSelectItem Value="@("3D Printing")">3D Printing</MudSelectItem>
                    <MudSelectItem Value="@("CNC")">CNC Machining</MudSelectItem>
                    <MudSelectItem Value="@("Sheet Metal")">Sheet Metal</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudToggleGroup T="bool" Value="@_isGridView" ValueChanged="OnViewModeChanged" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="false" Delimiters="false">
                    <MudToggleItem Value="@(true)" UnselectedIcon="@Icons.Material.Outlined.GridView" SelectedIcon="@Icons.Material.Filled.GridView" />
                    <MudToggleItem Value="@(false)" UnselectedIcon="@Icons.Material.Outlined.List" SelectedIcon="@Icons.Material.Filled.List" />
                </MudToggleGroup>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="250px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (_models == null || !_models.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            No models found. Upload your first model to get started.
        </MudAlert>
    }
    else
    {
        @if (_isGridView)
        {
            <MudGrid>
                @foreach (var model in _models)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="0" Class="border mud-border-lines-default rounded-lg hover-card" @onclick="() => NavigateToDetail(model.Id)">
                            <div style="height: 180px; background-color: var(--mud-palette-background-grey); display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                                @if (!string.IsNullOrEmpty(model.ThumbnailUrl))
                                {
                                    <img src="@model.ThumbnailUrl" alt="@model.FileName" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" Color="Color.Default" Style="font-size: 4rem; opacity: 0.3;" />
                                }
                                
                                <div class="card-overlay">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Inherit" Size="Size.Medium" OnClick="() => NavigateToDetail(model.Id)" />
                                </div>
                            </div>
                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.subtitle2" Class="mud-text-truncate fw-bold">@model.FileName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">Uploaded @model.UploadedAt.ToString("dd MMM yyyy")</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-2">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@Path.GetExtension(model.FileName).ToUpper().TrimStart('.')</MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Default">@FormatFileSize(model.FileSize)</MudText>
                                </MudStack>
                            </MudCardContent>
                            <MudCardActions Class="pa-2 border-top mud-border-lines-default">
                                <MudStack Row="true" Spacing="0" Class="flex-grow-1">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default" OnClick="() => NavigateToDetail(model.Id)" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" Color="Color.Primary" OnClick="() => DownloadModel(model)" />
                                </MudStack>
                                @if (model.GeometryAnalyzed)
                                {
                                    <MudTooltip Text="Geometry Analyzed">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                    </MudTooltip>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg overflow-hidden">
                <MudTable Items="@_models" Hover="true" Elevation="0" OnRowClick="@(args => NavigateToDetail(args.Item != null ? args.Item.Id : Guid.Empty))" T="Model3DDto">
                    <HeaderContent>
                        <MudTh>File Name</MudTh>
                        <MudTh>Size</MudTh>
                        <MudTh>Uploaded At</MudTh>
                        <MudTh>Analysis</MudTh>
                        <MudTh Style="text-align: right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="File Name">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.body2" Class="fw-bold">@context.FileName</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Size">@FormatFileSize(context.FileSize)</MudTd>
                        <MudTd DataLabel="Uploaded At">@context.UploadedAt.ToString("g")</MudTd>
                        <MudTd DataLabel="Analysis">
                            @if (context.GeometryAnalyzed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Analyzed</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassEmpty">Pending</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions" Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" OnClick="() => NavigateToDetail(context.Id)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" Color="Color.Primary" OnClick="() => DownloadModel(context)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <div class="d-flex justify-center mt-6">
            <MudPagination Color="Color.Primary" Count="@_totalPages" Selected="@_currentPage" SelectedChanged="OnPageChanged" />
        </div>
    }
</MudContainer>

<style>
    .hover-card {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .hover-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--mud-elevation-4);
    }
    .card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--mud-palette-overlay-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s;
        color: var(--mud-palette-white);
    }
    .hover-card:hover .card-overlay {
        opacity: 1;
    }
    .fw-bold {
        font-weight: 600;
    }
    .border-top {
        border-top: 1px solid var(--mud-palette-divider);
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isGridView = true;
    private string _searchString = "";
    private string _filterProcess = "All";
    private List<Model3DDto> _models = new();
    
    private int _currentPage = 1;
    private int _pageSize = 12;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadModels();
    }

    private async Task LoadModels()
    {
        _isLoading = true;
        try
        {
            var url = $"api/models?page={_currentPage}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                url += $"&filter={Uri.EscapeDataString(_searchString)}";
            }
            
            var result = await Http.GetFromJsonAsync<PagedResponse<Model3DDto>>(url);
            if (result != null)
            {
                _models = result.Data.ToList();
                _totalPages = result.Meta.TotalPages;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading models: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadModels();
    }

    private void OnViewModeChanged(bool isGridView)
    {
        _isGridView = isGridView;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadModels();
        }
    }

    private void NavigateToDetail(Guid id)
    {
        if (id != Guid.Empty)
        {
            NavigationManager.NavigateTo($"/mfg/models/{id}");
        }
    }

    private async Task DownloadModel(Model3DDto model)
    {
        if (!string.IsNullOrEmpty(model.DownloadUrl))
        {
            await JS.InvokeVoidAsync("open", model.DownloadUrl, "_blank");
        }
        else
        {
            Snackbar.Add("Download URL not available.", Severity.Warning);
        }
    }

    private async Task OpenUploadDialog()
    {
        var dialog = await DialogService.ShowAsync<UploadModelDialog>("Upload 3D Models");
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadModels();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:F1} {suffixes[counter]}";
    }
}
