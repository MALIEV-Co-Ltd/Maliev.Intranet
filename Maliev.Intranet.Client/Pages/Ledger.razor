@using Maliev.Intranet.Client.Helpers
@page "/finance/ledger"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>General Ledger - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">General Ledger</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudSelect @bind-Value="_selectedPeriod" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 200px;">
            <MudSelectItem Value="@("January 2026")">January 2026</MudSelectItem>
            <MudSelectItem Value="@("December 2025")">December 2025</MudSelectItem>
            <MudSelectItem Value="@("November 2025")">November 2025</MudSelectItem>
        </MudSelect>
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Calculate" OnClick="@(() => Snackbar.Add("Trial Balance generation requested", Severity.Info))">
            Trial Balance
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => Snackbar.Add("Excel export starting...", Severity.Info))">
            Export to Excel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@OpenNewEntryDialog">
            New Entry
        </MudButton>
    </MudStack>
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-4">Chart of Accounts</MudText>
            @if (_isLoading)
            {
                @for (int i = 0; i < 5; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2 rounded" />
                }
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var account in _accountsTree)
                    {
                        <MudListItem T="string">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@account.Code - @account.Name</MudText>
                                    @if (account.Children.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@account.Children.Count sub-accounts</MudText>
                                    }
                                </div>
                                <MudText Typo="Typo.subtitle2">@ThaiCurrency.Format(account.Balance, 0)</MudText>
                            </MudStack>
                        </MudListItem>
                        <MudDivider />
                    }
                    @if (!_accountsTree.Any())
                    {
                        <MudText Typo="Typo.body2" Class="pa-4 text-center mud-text-secondary">No accounts found.</MudText>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-4">Journal Entries</MudText>
            
            @if (_isLoading)
            {
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mb-2 rounded" />
                }
            }
            else
            {
                <MudDataGrid T="JournalEntryDto" Items="@_entries" Dense="true" Hover="true" Elevation="0">
                    <Columns>
                        <PropertyColumn Property="x => x.EntryNumber" Title="Entry #" />
                        <PropertyColumn Property="x => x.Date" Title="Date" Format="dd MMM yyyy" />
                        <PropertyColumn Property="x => x.Description" Title="Description" />
                        <PropertyColumn Property="x => x.TotalDebit" Title="Debit" Format="C2" />
                        <PropertyColumn Property="x => x.TotalCredit" Title="Credit" Format="C2" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">
                                    @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Default" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 text-center" Color="Color.Secondary">No journal entries found</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _isLoading = true;
    private string _selectedPeriod = "January 2026";
    private List<ChartOfAccountDto> _accountsTree = new();
    private List<JournalEntryDto> _entries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var accountsTask = Http.GetFromJsonAsync<List<ChartOfAccountDto>>("api/accounting/accounts-tree");
            var entriesTask = Http.GetFromJsonAsync<PagedResponse<JournalEntryDto>>("api/accounting/journal-entries");

            await Task.WhenAll(accountsTask, entriesTask);

            _accountsTree = await accountsTask ?? new();
            var response = await entriesTask;
            _entries = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ledger data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenNewEntryDialog()
    {
        Snackbar.Add("New Journal Entry dialog coming soon", Severity.Info);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Posted" => Color.Success,
        "Void" => Color.Error,
        _ => Color.Default
    };
}
