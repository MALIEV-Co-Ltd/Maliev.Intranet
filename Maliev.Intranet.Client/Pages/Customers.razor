@page "/sales/customers"
@using MudBlazor
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Client.Helpers
@using Maliev.Intranet.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISignalRCustomerService SignalRService
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>Customers - Maliev Intranet</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 600;">Customers</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Manage your client relationships and account balances.</MudText>
    </div>
</MudStack>

<MudDataGrid T="CustomerSummaryDto" ServerData="@LoadGridData" Filterable="true" SortMode="SortMode.Multiple" @ref="_grid"
                 Dense="true" Hover="true" Striped="true" Elevation="0" Class="border mud-border-lines-default rounded-lg overflow-hidden">
        <ToolBarContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="w-100 pa-4 flex-grow-1">
                <div class="d-flex align-center gap-4 flex-grow-1">
                    <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search customers..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" 
                                  Style="max-width: 350px;" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"></MudTextField>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" 
                               OnClick="@(() => Navigation.NavigateTo("/sales/customers/new"))" Class="px-6 rounded-lg d-none d-sm-flex">
                        Create Customer
                    </MudButton>
                    <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Add" 
                                   OnClick="@(() => Navigation.NavigateTo("/sales/customers/new"))" Class="d-flex d-sm-none rounded-lg" />
                </div>
            </MudStack>
        </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Customer Name" SortBy="x => x.Name" HeaderClass="pl-6" CellClass="pl-6" HeaderStyle="white-space: nowrap;">
            <CellTemplate>
                <MudLink Href="@($"/sales/customers/{context.Item.Id}")" Class="cursor-pointer font-bold" Underline="Underline.None">
                    <div class="d-flex align-center" style="white-space: nowrap;">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-3" Style="width: 28px; height: 28px; font-size: 0.75rem;">
                            @(!string.IsNullOrEmpty(context.Item.Name) ? context.Item.Name[0] : 'C')
                        </MudAvatar>
                        @context.Item.Name
                        @if (context.Item.NdaStatus == "Signed")
                        {
                            <MudTooltip Text="Active NDA Protected">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Success" Size="Size.Small" Class="ml-1" Style="font-size: 0.9rem;" />
                            </MudTooltip>
                        }
                    </div>
                </MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Company" SortBy="x => x.CompanyName" HeaderClass="d-none d-md-table-cell" CellClass="d-none d-md-table-cell" HeaderStyle="white-space: nowrap;">
            <CellTemplate>
                <div style="white-space: nowrap;">
                    @if (context.Item.CompanyId.HasValue)
                    {
                        <MudLink OnClick="@(() => Navigation.NavigateTo($"/sales/companies/{context.Item.CompanyId}"))" Underline="Underline.Hover" Color="Color.Info">
                            @context.Item.CompanyName
                        </MudLink>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Personal</MudText>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Email" HeaderClass="d-none d-lg-table-cell" CellClass="d-none d-lg-table-cell" HeaderStyle="white-space: nowrap;" />
        <TemplateColumn Title="Phone" HeaderStyle="width: 180px; white-space: nowrap;" HeaderClass="d-none d-xl-table-cell" CellClass="d-none d-xl-table-cell">
            <CellTemplate>
                <div class="d-flex flex-column" style="white-space: nowrap;">
                    @if (!string.IsNullOrEmpty(context.Item.CompanyPhone))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Default" Style="font-size: 1rem;" />
                            <MudText Typo="Typo.body2">@context.Item.CompanyPhone</MudText>
                            @if (!string.IsNullOrEmpty(context.Item.Extension))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ma-0 px-1" Style="height: 18px; font-size: 0.7rem;">
                                    ext. @context.Item.Extension
                                </MudChip>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(context.Item.Landline))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Default" Style="font-size: 1rem;" />
                            <MudText Typo="Typo.body2">@context.Item.Landline</MudText>
                        </div>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Mobile" HeaderStyle="width: 140px; white-space: nowrap;" HeaderClass="d-none d-md-table-cell" CellClass="d-none d-md-table-cell">
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.Mobile))
                {
                    <div class="d-flex align-center gap-1" style="white-space: nowrap;">
                        <MudIcon Icon="@Icons.Material.Filled.Smartphone" Size="Size.Small" Color="Color.Default" Style="font-size: 1rem;" />
                        <MudText Typo="Typo.body2">@context.Item.Mobile</MudText>
                    </div>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Segment" Title="Segment" HeaderStyle="width: 120px; white-space: nowrap;" HeaderClass="d-none d-lg-table-cell" CellClass="d-none d-lg-table-cell" />
        <TemplateColumn Title="NDA" HeaderStyle="width: 100px; white-space: nowrap;" HeaderClass="d-none d-sm-table-cell" CellClass="d-none d-sm-table-cell">
            <CellTemplate>
                <MudChip T="string" Color="@GetNdaColor(context.Item.NdaStatus)" Size="Size.Small" Variant="Variant.Filled" Class="ma-0">
                    @(context.Item.NdaStatus ?? "None")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" HeaderStyle="width: 100px; white-space: nowrap;">
            <CellTemplate>
                <MudChip T="string" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Balance" HeaderStyle="width: 120px; white-space: nowrap;" CellStyle="text-align: right;" HeaderClass="justify-end">
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="font-mono" Style="white-space: nowrap;">@CurrencyFormatter.Format(context.Item.OutstandingBalance, "THB", 2)</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellClass="pr-6" HeaderClass="justify-end pr-6" HeaderStyle="width: 60px;">
            <CellTemplate>
                <div class="d-flex justify-end">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"/sales/customers/{context.Item.Id}")" />
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">No customers found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Class="pa-4">Loading customers...</MudText>
    </LoadingContent>
        <PagerContent>
            <MudDataGridPager T="CustomerSummaryDto" />
        </PagerContent>
    </MudDataGrid>




@code {
    private MudDataGrid<CustomerSummaryDto> _grid = null!;
    private string? _searchString;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Start SignalR connection
        await SignalRService.StartAsync();
        SignalRService.OnCustomerChanged += HandleCustomerChanged;

        // Ensure grid loads data on initialization
        await Task.CompletedTask;
    }

    private async Task HandleCustomerChanged()
    {
        await InvokeAsync(async () =>
        {
            if (_grid != null)
            {
                await _grid.ReloadServerData();
                Snackbar.Add("Customer data updated by another user", Severity.Info);
                StateHasChanged();
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        SignalRService.OnCustomerChanged -= HandleCustomerChanged;
        await SignalRService.StopAsync();
    }

    private async Task<GridData<CustomerSummaryDto>> LoadGridData(GridState<CustomerSummaryDto> state, CancellationToken cancellationToken)
    {
        var page = state.Page + 1;
        var url = $"api/customers?page={page}&query={_searchString}";
        
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>(url);
            if (response != null)
            {
                return new GridData<CustomerSummaryDto>
                {
                    TotalItems = response.Meta.TotalCount,
                    Items = response.Data
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }

        return new GridData<CustomerSummaryDto> { TotalItems = 0, Items = Array.Empty<CustomerSummaryDto>() };
    }

    private Task OnSearch(string text)
    {
        _searchString = text;
        return _grid.ReloadServerData();
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Warning,
        "Blocked" => Color.Error,
        _ => Color.Default
    };

    private Color GetNdaColor(string? status) => status switch
    {
        "Signed" => Color.Success,
        "Expired" => Color.Error,
        "Pending" => Color.Warning,
        _ => Color.Default
    };
}
