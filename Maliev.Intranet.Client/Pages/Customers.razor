@page "/sales/customers"
@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Customers - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Customers</MudText>

<MudDataGrid T="CustomerSummaryDto" ServerData="@LoadGridData" Filterable="true" SortMode="SortMode.Multiple" @ref="_grid">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Customer List</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></MudTextField>
    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Company Name" SortBy="x => x.Name">
            <CellTemplate>
                <MudLink OnClick="@(() => ViewDetails(context.Item.Id))" Class="cursor-pointer" Underline="Underline.None">
                    <div class="d-flex align-center">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">@context.Item.Name[0]</MudAvatar>
                        @context.Item.Name
                    </div>
                </MudLink>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Email" />
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small">@context.Item.Status</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.OutstandingBalance" Title="Balance" Format="C2" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudTooltip Text="View Details">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => ViewDetails(context.Item.Id))" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No customers found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading customers...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager T="CustomerSummaryDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<CustomerSummaryDto> _grid = null!;
    private string? _searchString;

    private async Task<GridData<CustomerSummaryDto>> LoadGridData(GridState<CustomerSummaryDto> state)
    {
        var page = state.Page + 1;
        var url = $"api/customers?page={page}&query={_searchString}";
        
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>(url);
            if (response != null)
            {
                return new GridData<CustomerSummaryDto>
                {
                    TotalItems = response.Meta.TotalCount,
                    Items = response.Data
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }

        return new GridData<CustomerSummaryDto> { TotalItems = 0, Items = Array.Empty<CustomerSummaryDto>() };
    }

    private Task OnSearch(string text)
    {
        _searchString = text;
        return _grid.ReloadServerData();
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/sales/customers/{id}");
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Warning,
        "Blocked" => Color.Error,
        _ => Color.Default
    };
}
