@page "/orders"
@using Microsoft.AspNetCore.Authorization
@using Maliev.Intranet.Shared
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Orders - Maliev Intranet</PageTitle>

<div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4">Order Management</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart">Create Order</MudButton>
</div>

@if (_orders == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_orders" Elevation="2" Hover="true">
        <HeaderContent>
            <MudTh>Order #</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Order #">
                <MudLink Underline="Underline.None" Color="Color.Primary" Typo="Typo.body2" Class="fw-bold">
                    @context.OrderNumber
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
            <MudTd DataLabel="Date">@context.CreatedAt.ToShortDateString()</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Filled">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Total" Style="text-align:right" Class="fw-semibold">@context.TotalAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">Track</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<OrderSummaryDto>? _orders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try 
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>("api/orders");
            _orders = response?.Data.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
            _orders = new();
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Shipped" => Color.Success,
        "Pending" => Color.Warning,
        "Cancelled" => Color.Error,
        "Processing" => Color.Info,
        _ => Color.Default
    };
}