@using Maliev.Intranet.Client.Helpers
@page "/sales/orders"
@using Maliev.Intranet.Shared
@inject HttpClient Http

<PageTitle>Orders - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Order Board</MudText>

@if (_isLoading)
{
    <MudGrid>
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="pa-4 border mud-border-lines-default rounded-lg">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Class="mb-2" />
                    @for (int j = 0; j < 3; j++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-2 rounded" />
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudDropContainer T="OrderSummaryDto" Items="@_orders" ItemsSelector="@((item,column) => item.Status == column)" ItemDropped="ItemUpdated" Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudPaper Elevation="0" Width="25%" MinHeight="400px" Class="pa-4 ma-2 d-flex flex-column border mud-border-lines-default rounded-lg">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1"><b>New</b></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@_orders.Count(x => x.Status == "New")</MudChip>
                </MudStack>
                <MudDropZone T="OrderSummaryDto" Identifier="New" Class="flex-grow-1" />
            </MudPaper>
            <MudPaper Elevation="0" Width="25%" MinHeight="400px" Class="pa-4 ma-2 d-flex flex-column border mud-border-lines-default rounded-lg">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1"><b>Processing</b></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_orders.Count(x => x.Status == "Processing")</MudChip>
                </MudStack>
                <MudDropZone T="OrderSummaryDto" Identifier="Processing" Class="flex-grow-1" />
            </MudPaper>
            <MudPaper Elevation="0" Width="25%" MinHeight="400px" Class="pa-4 ma-2 d-flex flex-column border mud-border-lines-default rounded-lg">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1"><b>Shipped</b></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@_orders.Count(x => x.Status == "Shipped")</MudChip>
                </MudStack>
                <MudDropZone T="OrderSummaryDto" Identifier="Shipped" Class="flex-grow-1" />
            </MudPaper>
            <MudPaper Elevation="0" Width="22%" MinHeight="400px" Class="pa-4 ma-2 d-flex flex-column border mud-border-lines-default rounded-lg">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1"><b>Delivered</b></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@_orders.Count(x => x.Status == "Delivered")</MudChip>
                </MudStack>
                <MudDropZone T="OrderSummaryDto" Identifier="Delivered" Class="flex-grow-1" />
            </MudPaper>
        </ChildContent>
        <ItemRenderer>
            <MudCard Elevation="0" Class="mb-2 border mud-border-lines-default">
                <MudCardContent>
                    <MudText Typo="Typo.body1" Style="font-weight: 600;">@context.OrderNumber</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CustomerName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2">@ThaiCurrency.Format(context.TotalAmount, 2)</MudText>
                </MudCardContent>
            </MudCard>
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    private bool _isLoading = true;
    private List<OrderSummaryDto> _orders = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<OrderSummaryDto>>("api/orders?page=1");
            if (response?.Data != null)
            {
                _orders = response.Data.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ItemUpdated(MudItemDropInfo<OrderSummaryDto> dropItem)
    {
        if (dropItem.Item is not null)
        {
            dropItem.Item.Status = dropItem.DropzoneIdentifier;
            // TODO: Call API to update order status
        }
    }
}
