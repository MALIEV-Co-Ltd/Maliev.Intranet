@page "/hr/onboarding"
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Onboarding - Maliev Intranet</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Employee Onboarding</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 border mud-border-lines-default rounded-lg">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_searchString" Placeholder="Search employees..." Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width: 300px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => Snackbar.Add("New onboarding flow coming soon", Severity.Info))">New Onboarding</MudButton>
    </MudStack>
</MudPaper>

@if (_isLoading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg" />
}
else
{
    <MudPaper Elevation="0" Class="border mud-border-lines-default rounded-lg">
        <MudDataGrid T="OnboardingSummaryDto" Items="@_onboardings" Dense="true" Hover="true" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.EmployeeName" Title="Employee" />
                <PropertyColumn Property="x => x.Department" Title="Department" />
                <PropertyColumn Property="x => x.StartDate" Title="Start Date" Format="dd MMM yyyy" />
                <TemplateColumn Title="Progress">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressLinear Color="Color.Primary" Value="@context.Item.Progress" Size="Size.Small" Style="min-width: 100px;" />
                            <MudText Typo="Typo.caption">@context.Item.Progress%</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Buddy" Title="Buddy" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <MudChip Size="Size.Small" Color="@GetStatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => ViewChecklist(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4 text-center" Color="Color.Secondary">No onboarding records found</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private string _searchString = "";
    private List<OnboardingSummaryDto> _onboardings = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var response = await Http.GetFromJsonAsync<PagedResponse<OnboardingSummaryDto>>("api/onboarding");
            _onboardings = response?.Data.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading onboarding data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ViewChecklist(OnboardingSummaryDto onboarding)
    {
        Snackbar.Add($"Checklist for {onboarding.EmployeeName} coming soon", Severity.Info);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Pre-Start" => Color.Info,
        "In Progress" => Color.Primary,
        "Complete" => Color.Success,
        "Delayed" => Color.Error,
        _ => Color.Default
    };
}

