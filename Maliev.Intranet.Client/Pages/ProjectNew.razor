@page "/sales/projects/new"
@layout EmptyLayout
@rendermode InteractiveAuto
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>New Project | Intranet Gateway</PageTitle>

<div class="pn-root">
    <ErrorBoundary>
        <ChildContent>
            <ProjectTopBar
                Title="@_title"
                OnTitleChanged="@(v => { _title = v; ValidateTitle(); TriggerAutoSave(); })"
                SelectedCurrency="@_selectedCurrency"
                Currencies="@_currencies"
                OnCurrencyChanged="@(c => { _selectedCurrency = c; TriggerAutoSave(); })"
                AutoSaving="@_autoSaving"
                LayoutMode="@_layoutMode"
                OnLayoutModeChanged="@(m => _layoutMode = m)"
                OnDuplicate="DuplicateProject" />

            <div class="pn-body">
                <ErrorBoundary>
                    <ChildContent>
                        <ProjectLeftPanel
                            SelectedCustomer="@_selectedCustomer"
                            ShowCustomerSearch="@_showCustomerSearch"
                            OnCustomerSelected="OnCustomerSelected"
                            OnShowSearchChanged="@(v => _showCustomerSearch = v)"
                            Description="@_description"
                            OnDescriptionChanged="@(v => { _description = v; ValidateDescription(); TriggerAutoSave(); })"
                            OnOpenFilePicker="OpenFilePicker"
                            SearchCustomersFunc="SearchCustomersAsync" />
                    </ChildContent>
                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Left panel error.</MudAlert></ErrorContent>
                </ErrorBoundary>

                <div class="pn-center">
                    @if (_layoutMode == LayoutMode.Configurator)
                    {
                        @if (_parts.Count > 0)
                        {
                            <PartCarousel
                                Parts="@_parts"
                                SelectedIndex="@_selectedPartIndex"
                                CurrencyCode="@(_selectedCurrency?.Code ?? "THB")"
                                OnSelectPart="@(i => { _selectedPartIndex = i; StateHasChanged(); })"
                                OnRemovePart="RemovePart"
                                OnAddPart="OpenFilePicker" />
                        }

                        @if (_parts.Count > 0 && _selectedPartIndex < _parts.Count)
                        {
                            <div class="pn-detail-row">
                                <ErrorBoundary>
                                    <ChildContent>
                                        <PartDetailCard
                                            Part="@_parts[_selectedPartIndex]"
                                            TempProjectId="@_tempProjectId"
                                            OnPartChanged="OnPartChanged"
                                            OnOpenViewer="OpenBabylonViewer" />
                                    </ChildContent>
                                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Detail panel error.</MudAlert></ErrorContent>
                                </ErrorBoundary>
                                <PartConfigSidebar
                                    Part="@_parts[_selectedPartIndex]"
                                    Processes="@_processes"
                                    TempProjectId="@_tempProjectId"
                                    OnPartChanged="OnPartChanged"
                                    CurrencySymbol="@(_selectedCurrency?.Symbol ?? "฿")" />
                            </div>
                        }
                        else
                        {
                            <div class="pn-empty-state">
                                <FileUploadDropzone Icon="@Icons.Material.Outlined.CloudUpload"
                                                   Label="Drop files here or click to upload"
                                                   SubLabel="@FileTypes.ThreeDSubLabel"
                                                   MaxFileSizeLabel="max 100 MB"
                                                   Class="pn-empty-dropzone"
                                                   OnClick="OpenFilePicker"
                                                   OnFilesDropped="OpenFilePicker" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pn-list-view">
                            <PartListView Parts="@_parts"
                                          Processes="@_processes"
                                          TempProjectId="@_tempProjectId"
                                          OnPartActivated="ActivatePartFromList"
                                          OnRemovePart="RemovePart"
                                          OnAddPart="OpenFilePicker"
                                          OnPartChanged="OnPartChanged" />
                        </div>
                    }
                </div>

                <ErrorBoundary>
                    <ChildContent>
                        <ProjectQuotePanel
                            Parts="@_parts"
                            LeadTimeOptions="@_leadTimeOptions"
                            SelectedLeadTime="@_selectedLeadTime"
                            OnLeadTimeChanged="@(async lt => { _selectedLeadTime = lt; TriggerAutoSave(); foreach (var p in _parts) { await TriggerRoutingFetchAsync(p); } })"
                            SelectedCurrency="@_selectedCurrency"
                            CanQuote="@CanSubmit"
                            Saving="@_saving"
                            OnQuote="CreateProjectAndQuoteAsync"
                            OnPartActivated="ActivatePartFromList"
                            SelectedPartIndex="@_selectedPartIndex" />
                    </ChildContent>
                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Quote panel error.</MudAlert></ErrorContent>
                </ErrorBoundary>
            </div>
        </ChildContent>
        <ErrorContent>
            <MudAlert Severity="Severity.Error" Class="ma-4">An unexpected error occurred. Please refresh.</MudAlert>
        </ErrorContent>
    </ErrorBoundary>
</div>

<MudFileUpload T="IReadOnlyList<IBrowserFile>"
               @ref="_fileUpload"
               FilesChanged="HandleFileSelected"
               Accept="@FileTypes.AllUploadAcceptString"
               MaximumFileCount="20"
               Hidden="true"
               Style="display:none;" />

<style>
    .pn-root {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background: var(--mud-palette-background-grey);
    }
    .pn-body {
        flex: 1;
        display: flex;
        overflow: hidden;
        min-height: 0;
    }
    .pn-center {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
    }
    .pn-empty-detail {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pn-empty-state {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }
    /* Hero dropzone — overrides FileUploadDropzone defaults for the empty-state CTA */
    .pn-empty-dropzone {
        padding: 60px 40px !important;
        border-radius: 16px !important;
        max-width: 600px;
        width: 100%;
    }
    .pn-table-placeholder {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pn-detail-row {
        flex: 1;
        display: flex;
        overflow: hidden;
        min-height: 0;
    }
    .pn-list-view {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
    }

    /* ── Tablet / Mobile ─────────────────────────────────────────────── */
    @@media (max-width: 1200px) {
        .pn-root {
            height: auto;
            min-height: 100dvh;
            overflow-y: auto;
        }
        .pn-body {
            flex-direction: column;
            overflow: visible;
            min-height: unset;
        }
        .pn-center {
            order: 1;
            overflow: visible;
            min-height: unset;
        }
        .pn-detail-row {
            flex-direction: column;
            overflow: visible;
            min-height: unset;
        }
    }
</style>
