@page "/sales/projects/new"
@rendermode InteractiveAuto
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>New Project - Maliev Intranet</PageTitle>

<style>
    /* ── Upload drop zone ── */
    .upload-drop-zone {
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 10px;
        min-height: 70px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        user-select: none;
        padding: 8px 16px;
        gap: 4px;
    }
    .upload-drop-zone:hover, .upload-drop-zone.drag-over {
        border-color: var(--mud-palette-primary);
        background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent);
    }
    /* ── Responsive file card grid (4 cols desktop, 3 tablet, 2 small tablet, 1 mobile) ── */
    .file-cards-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        max-height: 520px;
        overflow-y: auto;
        padding-right: 2px;
    }
    @@media (max-width 1400px) {
        .file-cards-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @@media (max-width 1100px) {
        .file-cards-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width 600px) {
        .file-cards-grid { grid-template-columns: 1fr; }
    }
    /* ── Vertical file card ── */
    .file-card {
        display: flex;
        flex-direction: column;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
    }
    .file-card-header {
        display: flex;
        align-items: center;
        padding: 6px 4px 6px 10px;
        gap: 4px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        min-width: 0;
    }
    .file-card-name {
        font-weight: 500;
        font-size: 0.82rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        min-width: 0;
        line-height: 1.3;
    }
    /* Middle: preview (left) + dims/volume (right) */
    .file-card-middle {
        display: flex;
        flex-direction: row;
        padding: 8px;
        gap: 8px;
        min-height: 100px;
    }
    .file-card-preview {
        width: 100px;
        min-width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--mud-palette-background-grey);
        border-radius: 6px;
        overflow: hidden;
        flex-shrink: 0;
    }
    .file-card-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .file-card-dims {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 3px;
        padding-top: 2px;
    }
    .file-card-dim-value {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
    }
    /* Footer row */
    .file-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 5px 6px 5px 10px;
        border-top: 1px solid var(--mud-palette-lines-default);
        gap: 4px;
    }
    .file-card-status {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        min-width: 0;
        white-space: nowrap;
        overflow: visible;
    }
    /* Global quantity bar */
    .global-qty-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        background: var(--mud-palette-background-grey);
        border-radius: 8px;
    }
    .customer-info-grid {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .customer-info-field {
        display: flex;
        align-items: center;
        font-size: 0.8rem;
    }
</style>

<ErrorBoundary>
    <ChildContent>
        <MudStack Spacing="4">

            @* ── Section 1: Customer + Project Info (3-col grid) ── *@
            <MudGrid Spacing="3">
                @* Left: Customer selection *@
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="mb-2">Customer</MudText>

                    @if (!_showCustomerSearch && _selectedCustomer != null)
                    {
                        <MudPaper Outlined="true" Class="pa-3" Style="border-color: var(--mud-palette-success);">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@_selectedCustomer.Name</MudText>
                                @if (!string.IsNullOrEmpty(_selectedCustomer.Status))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Label="true">@_selectedCustomer.Status</MudChip>
                                }
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => _showCustomerSearch = true)" />
                            </div>
                            <div class="customer-info-grid">
                                @if (!string.IsNullOrEmpty(_selectedCustomer.Email))
                                {
                                    <MudLink Href="@($"mailto:{_selectedCustomer.Email}")" Underline="Underline.None" Color="Color.Secondary" Class="customer-info-field">
                                        <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" Class="mr-1" />
                                        @_selectedCustomer.Email
                                    </MudLink>
                                }
                                @if (!string.IsNullOrEmpty(_selectedCustomer.Mobile))
                                {
                                    <MudLink Href="@($"tel:{_selectedCustomer.Mobile}")" Underline="Underline.None" Color="Color.Secondary" Class="customer-info-field">
                                        <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" Class="mr-1" />
                                        @_selectedCustomer.Mobile @if (!string.IsNullOrEmpty(_selectedCustomer.Extension)) { <text> ext. @_selectedCustomer.Extension</text> }
                                    </MudLink>
                                }
                                @if (!string.IsNullOrEmpty(_selectedCustomer.CompanyName))
                                {
                                    <MudLink Href="@($"tel:{_selectedCustomer.CompanyPhone}")" Underline="Underline.None" Color="Color.Secondary" Class="customer-info-field">
                                        <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" Class="mr-1" />
                                        @_selectedCustomer.CompanyName @if (!string.IsNullOrEmpty(_selectedCustomer.CompanyPhone)) { <text>· @_selectedCustomer.CompanyPhone</text> }
                                    </MudLink>
                                }
                                @if (!string.IsNullOrEmpty(_selectedCustomer.Landline))
                                {
                                    <MudLink Href="@($"tel:{_selectedCustomer.Landline}")" Underline="Underline.None" Color="Color.Secondary" Class="customer-info-field">
                                        <MudIcon Icon="@Icons.Material.Outlined.PhoneCallback" Size="Size.Small" Class="mr-1" />
                                        @_selectedCustomer.Landline
                                    </MudLink>
                                }
                            </div>
                        </MudPaper>
                    }
                    else
                    {
                        <MudAutocomplete T="CustomerSummaryDto"
                                        Label="Search customer..."
                                        Placeholder="Type 2+ characters to search..."
                                        SearchFunc="SearchCustomersAsync"
                                        ToStringFunc="@(c => c?.Name ?? "")"
                                        ValueChanged="@(OnCustomerSelected)"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Outlined.Search"
                                        ShowProgressIndicator="true"
                                        MinCharacters="2"
                                        Clearable="true"
                                        OnClearButtonClick="@(() => { _selectedCustomer = null; _showCustomerSearch = true; })" />
                        @if (_selectedCustomer != null)
                        {
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Class="mt-1"
                                       OnClick="@(() => _showCustomerSearch = false)">
                                Done selecting
                            </MudButton>
                        }
                    }
                </MudItem>

                @* Center: Project Title + Description (stacked) *@
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="mb-2">Project Details</MudText>
                    <MudTextField @bind-Value="_title"
                                  Label="Project Title *"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  MaxLength="500"
                                  Counter="500"
                                  HelperText="Briefly describe what the customer wants manufactured"
                                  Error="@_titleHasError"
                                  ErrorText="@_titleError"
                                  OnBlur="ValidateTitle"
                                  Immediate="true"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="_description"
                                  Label="Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  MaxLength="2000"
                                  Counter="2000"
                                  HelperText="Optional scope notes or special requirements"
                                  Error="@_descriptionHasError"
                                  ErrorText="@_descriptionError"
                                  OnBlur="ValidateDescription"
                                  Immediate="true" />
                </MudItem>

                @* Right: File upload + actions *@
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;" Class="mb-2">Upload Files</MudText>
                    <div class="upload-drop-zone @(_dragOver ? "drag-over" : "")"
                         @onclick="OpenFilePicker"
                         @ondragenter:preventDefault @ondragenter="@(() => _dragOver = true)"
                         @ondragleave="@(() => _dragOver = false)"
                         @ondragover:preventDefault
                         @ondrop:preventDefault @ondrop="@(() => _dragOver = false)">
                        <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>Click or drag &amp; drop</strong> files here
                        </MudText>
                    </div>

                    @if (_uploadedFiles.Any(f => Is3DFile(f.Name)))
                    {
                        var globalQtyFiles = _uploadedFiles.Where(f => Is3DFile(f.Name) && !f.Uploading && f.Error == null).ToList();
                        var allSameQty = globalQtyFiles.Count > 0 && globalQtyFiles.Select(f => f.Quantity).Distinct().Count() == 1;
                        var globalQtyValue = allSameQty ? globalQtyFiles[0].Quantity : (int?)null;

                        <div class="global-qty-bar mt-3">
                            <MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Style="white-space:nowrap;">Qty:</MudText>
                            <MudNumericField T="int?"
                                             Value="@globalQtyValue"
                                             ValueChanged="@SetGlobalQuantity"
                                             Min="1" Max="999"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="false"
                                             Disabled="@(!allSameQty && globalQtyFiles.Count > 1)"
                                             Placeholder="@(!allSameQty && globalQtyFiles.Count > 1 ? "—" : "")"
                                             Style="width:72px; flex-shrink:0;" />
                            @if (!allSameQty && globalQtyFiles.Count > 1)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap;">
                                    Set equal qty
                                </MudText>
                            }
                        </div>
                    }

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Text"
                                   OnClick="@(() => Navigation.NavigateTo("/sales/projects"))">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Outlined.RocketLaunch"
                                   Disabled="@(!CanSubmit)"
                                   OnClick="CreateProjectAsync">
                            @if (_saving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>Creating...</text>
                            }
                            else
                            {
                                <text>Create Project</text>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           @ref="_fileUpload"
                           FilesChanged="HandleFileSelected"
                           Accept=".stl,.step,.stp,.3mf,.obj,.igs,.iges,.blend,.fbx,.gltf,.glb,.pdf,.dxf,.dwg,.png,.jpg,.jpeg,.tiff,.bmp,.webp,.doc,.docx,.xls,.xlsx,.zip,.rar,.7z"
                           MaximumFileCount="20"
                           Hidden="true"
                           Style="display:none;" />

            @* ── Section 3: File cards grid ── *@
            @if (_uploadedFiles.Any())
            {
                <div class="file-cards-grid">
                    @foreach (var file in _uploadedFiles.ToList())
                    {
                        var is3D = Is3DFile(file.Name);

                        <div class="file-card">
                            @* Header: filename + delete icon (red) *@
                            <div class="file-card-header">
                                <MudTooltip Text="@file.Name" Placement="Placement.Top">
                                    <div class="file-card-name">@file.Name</div>
                                </MudTooltip>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveFile(file))"
                                               Disabled="@file.Uploading" />
                            </div>

                            @* Middle: preview (100x100) + dims/volume *@
                            <div class="file-card-middle">
                                <div class="file-card-preview">
                                    @if (file.PreviewLoadFailed)
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.BrokenImage" Size="Size.Large" Color="Color.Error" />
                                    }
                                    else if (!string.IsNullOrEmpty(file.PreviewUrl))
                                    {
                                        <img src="@file.PreviewUrl"
                                             alt="@file.Name"
                                             @onerror="@(() => { file.PreviewLoadFailed = true; file.PreviewUrl = null; InvokeAsync(StateHasChanged); })" />
                                    }
                                    else if (is3D && (file.Uploading || file.AwaitingPreview))
                                    {
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                                     Width="100px" Height="100px"
                                                     Animation="Animation.Wave" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@GetFileIcon(file.Name)" Size="Size.Large" Color="Color.Default" />
                                    }
                                </div>

                                @* Dims + volume — top-aligned *@
                                <div class="file-card-dims">
                                    @if (file.Dimensions != null)
                                    {
                                        <div class="file-card-dim-value">
                                            @($"{file.Dimensions.X:N1} × {file.Dimensions.Y:N1} × {file.Dimensions.Z:N1} mm")
                                        </div>
                                        @if (file.VolumeMm3.HasValue)
                                        {
                                            <div class="file-card-dim-value">
                                                @($"{file.VolumeMm3.Value:N2} mm³")
                                            </div>
                                        }
                                    }
                                    else if (is3D && (file.Uploading || file.AwaitingPreview))
                                    {
                                        <MudSkeleton Width="110px" Height="14px" Animation="Animation.Wave" Class="mb-1" />
                                        <MudSkeleton Width="80px" Height="14px" Animation="Animation.Wave" />
                                    }
                                </div>
                            </div>

                            @* Footer: status + quantity *@
                            <div class="file-card-footer">
                                <div class="file-card-status">
                                    @if (file.Uploading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Style="width:12px;height:12px;" />
                                        <span style="color:var(--mud-palette-primary)">Uploading...</span>
                                    }
                                    else if (file.Error != null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.Error" Color="Color.Error" Size="Size.Small" />
                                        <MudTooltip Text="@file.Error">
                                            <span style="color:var(--mud-palette-error)">Upload failed</span>
                                        </MudTooltip>
                                    }
                                    else if (file.AwaitingPreview)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" Style="width:12px;height:12px;" />
                                        <span style="color:var(--mud-palette-text-secondary)">@file.StatusText</span>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        <span style="color:var(--mud-palette-success)">Ready</span>
                                        @if (file.IsManifold == false)
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.Warning"
                                                     Color="Color.Warning"
                                                     Size="Size.Small"
                                                     Style="margin-left:2px;" />
                                            <MudTooltip Text="Non-manifold mesh — preview may be incomplete" Placement="Placement.Top">
                                                <span />
                                            </MudTooltip>
                                        }
                                    }
                                </div>

                                @if (!file.Uploading && file.Error == null)
                                {
                                    <MudNumericField T="int"
                                                     Value="@file.Quantity"
                                                     ValueChanged="@((v) => OnFileQuantityChanged(file, v))"
                                                     Min="1" Max="999"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     HideSpinButtons="false"
                                                     Style="width:68px; flex-shrink:0;" />
                                }
                            </div>

                            @if (file.Uploading)
                            {
                                <MudProgressLinear Indeterminate="true"
                                                   Color="Color.Primary"
                                                   Rounded="true"
                                                   Style="height:3px;" />
                            }
                        </div>
                    }
                </div>
            }

        </MudStack>
    </ChildContent>
    <ErrorContent>
        <MudAlert Severity="Severity.Error" Class="ma-4">
            An error occurred loading this component. Please refresh the page.
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private CustomerSummaryDto? _selectedCustomer;
    private bool _showCustomerSearch = true;
    private string _title = string.Empty;
    private string? _description;
    private bool _saving;
    private bool _dragOver;
    private readonly Guid _tempProjectId = Guid.NewGuid();
    private readonly List<UploadedFileState> _uploadedFiles = [];
    private readonly Dictionary<string, CancellationTokenSource> _pollingTokens = new();
    private const int PollingIntervalMs = 2000;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;

    private string? _titleError;
    private bool _titleHasError;
    private string? _descriptionError;
    private bool _descriptionHasError;

    private static readonly HashSet<string> ThreeDExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        { ".stl", ".step", ".stp", ".3mf", ".obj", ".igs", ".iges", ".blend", ".fbx", ".gltf", ".glb" };

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".stl", ".step", ".stp", ".3mf", ".obj", ".igs", ".iges", ".blend", ".fbx", ".gltf", ".glb",
            ".pdf", ".dxf", ".dwg",
            ".png", ".jpg", ".jpeg", ".tiff", ".bmp", ".webp",
            ".doc", ".docx", ".xls", ".xlsx",
            ".zip", ".rar", ".7z",
        };

    private bool CanSubmit =>
        !_saving &&
        _selectedCustomer != null &&
        !string.IsNullOrWhiteSpace(_title) &&
        !_titleHasError &&
        !_descriptionHasError &&
        !_uploadedFiles.Any(f => f.Uploading);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
            return;
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var cts in _pollingTokens.Values)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
    }

    private async Task PollAnalysisStatusAsync(UploadedFileState file)
    {
        if (string.IsNullOrEmpty(file.StoragePath))
            return;

        var cts = new CancellationTokenSource();
        _pollingTokens[file.StoragePath] = cts;

        try
        {
            while (!cts.Token.IsCancellationRequested)
            {
                try
                {
                    var status = await Http.GetFromJsonAsync<FileAnalysisStatusDto>(
                        $"api/uploads/analysis-status?storagePath={Uri.EscapeDataString(file.StoragePath)}",
                        cts.Token);

                    if (status == null)
                        break;

                    switch (status.Status)
                    {
                        case FileAnalysisStatus.Processing:
                            if (status.Dimensions != null)
                            {
                                file.Dimensions = status.Dimensions;
                                file.VolumeMm3 = status.Dimensions.VolumeMm3;
                            }
                            if (string.IsNullOrEmpty(file.PreviewUrl))
                            {
                                file.PreviewUrl = ResolvePreviewUrl(status.PreviewUrls?.Iso)
                                                  ?? ResolvePreviewUrl(status.PreviewUrls?.Front)
                                                  ?? ResolvePreviewUrl(status.ThumbnailUrl);
                            }
                            if (status.PreviewProcessingStatus == PreviewProcessingStatus.Processing
                                || status.PreviewProcessingStatus == PreviewProcessingStatus.Pending)
                            {
                                file.StatusText = "Generating preview...";
                            }
                            else
                            {
                                file.StatusText = "Processing 3D file...";
                            }
                            break;

                        case FileAnalysisStatus.Completed:
                            file.Dimensions = status.Dimensions;
                            file.VolumeMm3 = status.Dimensions?.VolumeMm3;
                            file.PreviewUrl = ResolvePreviewUrl(status.PreviewUrls?.Iso)
                                             ?? ResolvePreviewUrl(status.PreviewUrls?.Front)
                                             ?? ResolvePreviewUrl(status.ThumbnailUrl);
                            file.IsManifold = status.IsManifold;
                            if (status.PreviewProcessingStatus == PreviewProcessingStatus.Completed)
                            {
                                file.AwaitingPreview = false;
                                file.StatusText = "Ready";
                                cts.Cancel();
                            }
                            else if (status.PreviewProcessingStatus == PreviewProcessingStatus.Failed)
                            {
                                file.AwaitingPreview = false;
                                file.StatusText = "Ready (preview unavailable)";
                                cts.Cancel();
                            }
                            else
                            {
                                file.StatusText = "Generating preview...";
                            }
                            break;

                        case FileAnalysisStatus.Failed:
                            file.AwaitingPreview = false;
                            file.StatusText = "Analysis failed";
                            file.Error = status.ErrorCode;
                            cts.Cancel();
                            break;
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch
                {
                    // Continue polling on network errors
                }

                await Task.Delay(PollingIntervalMs, cts.Token);
            }
        }
        finally
        {
            _pollingTokens.Remove(file.StoragePath);
            cts.Dispose();
        }
    }

    private async Task<IEnumerable<CustomerSummaryDto>> SearchCustomersAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value)) return [];
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>(
                $"api/customers?query={Uri.EscapeDataString(value)}&pageSize=10", ct);
            return result?.Data ?? [];
        }
        catch { return []; }
    }

    private void OnCustomerSelected(CustomerSummaryDto? customer)
    {
        _selectedCustomer = customer;
        if (customer != null)
        {
            _showCustomerSearch = false;
        }
    }

    private string? ResolvePreviewUrl(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return null;
        if (url.StartsWith("http://") || url.StartsWith("https://"))
            return url;
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        return url.StartsWith("/") ? $"{baseUri}{url}" : $"{baseUri}/{url}";
    }

    private Task OpenFilePicker()
        => _fileUpload?.OpenFilePickerAsync() ?? Task.CompletedTask;

    private async Task HandleFileSelected(IReadOnlyList<IBrowserFile> files)
    {
        _dragOver = false;
        if (files.Count == 0) return;

        const long maxBytes = 200L * 1024 * 1024;
        var newFiles = files
            .Where(f =>
            {
                var ext = Path.GetExtension(f.Name);
                if (!AllowedExtensions.Contains(ext))
                {
                    Snackbar.Add($"'{ext}' files are not supported.", Severity.Error);
                    return false;
                }
                if (_uploadedFiles.Any(u => u.Name == f.Name))
                {
                    Snackbar.Add($"'{f.Name}' is already added.", Severity.Warning);
                    return false;
                }
                return true;
            })
            .ToList();

        var states = newFiles.Select(f => new UploadedFileState
        {
            Name = f.Name,
            Uploading = true,
            AwaitingPreview = false,
            StatusText = "Processing...",
        }).ToList();

        _uploadedFiles.AddRange(states);
        StateHasChanged();

        var tasks = newFiles.Zip(states, (browserFile, state) =>
            UploadFileAsync(browserFile, state, maxBytes));

        await Task.WhenAll(tasks);
        StateHasChanged();
    }

    private async Task UploadFileAsync(IBrowserFile browserFile, UploadedFileState state, long maxBytes)
    {
        try
        {
            await using var stream = browserFile.OpenReadStream(maxBytes);
            using var content = new MultipartFormDataContent();
            content.Add(new StreamContent(stream), "file", browserFile.Name);

            var response = await Http.PostAsync($"api/uploads?projectId={_tempProjectId}", content);

            if (response.IsSuccessStatusCode)
            {
                var uploaded = await response.Content.ReadFromJsonAsync<BffUploadResponse>();
                state.FileId = Guid.TryParse(uploaded?.UploadId, out var id) ? id : Guid.Empty;
                state.StoragePath = uploaded?.StoragePath;
                state.Uploading = false;

                if (Is3DFile(browserFile.Name))
                {
                    state.AwaitingPreview = true;
                    state.StatusText = "Processing 3D file...";
                    _ = PollAnalysisStatusAsync(state);
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                state.Error = $"HTTP {(int)response.StatusCode}: {err}";
                state.Uploading = false;
            }
        }
        catch (Exception ex)
        {
            state.Error = ex.Message;
            state.Uploading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RemoveFile(UploadedFileState file)
    {
        if (!string.IsNullOrEmpty(file.StoragePath) && _pollingTokens.TryGetValue(file.StoragePath, out var cts))
        {
            cts.Cancel();
            cts.Dispose();
            _pollingTokens.Remove(file.StoragePath);
        }
        _uploadedFiles.Remove(file);
        StateHasChanged();
    }

    private void OnFileQuantityChanged(UploadedFileState file, int value)
    {
        file.Quantity = value;
        StateHasChanged();
    }

    private void SetGlobalQuantity(int? value)
    {
        if (value is null or < 1) return;
        foreach (var file in _uploadedFiles.Where(f => Is3DFile(f.Name) && !f.Uploading && f.Error == null))
        {
            file.Quantity = value.Value;
        }
        StateHasChanged();
    }

    private async Task CreateProjectAsync()
    {
        if (_selectedCustomer == null || string.IsNullOrWhiteSpace(_title)) return;
        _saving = true;
        StateHasChanged();

        try
        {
            var createRequest = new CreateProjectRequest
            {
                CustomerId = _selectedCustomer.Id,
                CustomerName = _selectedCustomer.Name,
                Title = _title,
                Description = _description,
            };

            var response = await Http.PostAsJsonAsync("api/projects", createRequest);
            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(errorContent)
                        ? "Failed to create project. Please try again."
                        : $"Failed to create project: {errorContent}",
                    Severity.Error);
                return;
            }

            var project = await response.Content.ReadFromJsonAsync<ProjectDetailDto>();
            if (project == null) { Snackbar.Add("Unexpected response from server.", Severity.Error); return; }

            var validParts = _uploadedFiles.Where(f => f.FileId != Guid.Empty && f.Error == null).ToList();
            foreach (var file in validParts)
            {
                var partRequest = new AddProjectPartRequest
                {
                    FileId = file.FileId,
                    FileName = file.Name,
                    Quantity = file.Quantity,
                };
                await Http.PostAsJsonAsync($"api/projects/{project.Id}/parts", partRequest);
            }

            Snackbar.Add($"Project {project.ProjectNumber} created with {validParts.Count} part(s).", Severity.Success);
            Navigation.NavigateTo($"/sales/projects/{project.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ValidateTitle()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            _titleError = "Project title is required";
            _titleHasError = true;
        }
        else if (_title.Length > 500)
        {
            _titleError = "Project title must be 500 characters or fewer";
            _titleHasError = true;
        }
        else
        {
            _titleError = null;
            _titleHasError = false;
        }
    }

    private void ValidateDescription()
    {
        if (_description?.Length > 2000)
        {
            _descriptionError = "Description must be 2000 characters or fewer";
            _descriptionHasError = true;
        }
        else
        {
            _descriptionError = null;
            _descriptionHasError = false;
        }
    }

    private static bool Is3DFile(string name) =>
        ThreeDExtensions.Contains(Path.GetExtension(name));

    private static string GetFileIcon(string name) =>
        Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".stl" or ".step" or ".stp" or ".3mf" or ".obj" or ".igs" or ".iges"
            or ".blend" or ".fbx" or ".gltf" or ".glb"
                => Icons.Material.Outlined.ViewInAr,
            ".pdf" => Icons.Material.Outlined.PictureAsPdf,
            ".dxf" or ".dwg" => Icons.Material.Outlined.Architecture,
            ".png" or ".jpg" or ".jpeg" or ".tiff" or ".bmp" or ".webp"
                => Icons.Material.Outlined.Image,
            ".doc" or ".docx" => Icons.Material.Outlined.Description,
            ".xls" or ".xlsx" => Icons.Material.Outlined.TableChart,
            ".zip" or ".rar" or ".7z" => Icons.Material.Outlined.FolderZip,
            _ => Icons.Material.Outlined.InsertDriveFile,
        };

    private sealed class UploadedFileState
    {
        public string Name { get; set; } = string.Empty;
        public Guid FileId { get; set; }
        public string? StoragePath { get; set; }
        public bool Uploading { get; set; }
        public bool AwaitingPreview { get; set; }
        public string StatusText { get; set; } = "Processing...";
        public string? PreviewUrl { get; set; }
        public bool PreviewLoadFailed { get; set; }
        public FileAnalysisDimensionsDto? Dimensions { get; set; }
        public double? VolumeMm3 { get; set; }
        public bool? IsManifold { get; set; }
        public int Quantity { get; set; } = 1;
        public string? Error { get; set; }
    }
}
