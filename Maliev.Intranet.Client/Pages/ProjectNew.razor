@page "/sales/projects/new"
@layout EmptyLayout
@rendermode InteractiveAuto
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>New Project | Intranet Gateway</PageTitle>

<div class="pn-root">
    <ErrorBoundary>
        <ChildContent>
            <ProjectTopBar
                Title="@_title"
                OnTitleChanged="@(v => { _title = v; ValidateTitle(); TriggerAutoSave(); })"
                SelectedCurrency="@_selectedCurrency"
                Currencies="@_currencies"
                OnCurrencyChanged="@(c => { _selectedCurrency = c; TriggerAutoSave(); })"
                AutoSaving="@_autoSaving"
                LayoutMode="@_layoutMode"
                OnLayoutModeChanged="@(m => _layoutMode = m)"
                OnDuplicate="DuplicateProject" />

            <div class="pn-body">
                <ErrorBoundary>
                    <ChildContent>
                        <ProjectLeftPanel
                            SelectedCustomer="@_selectedCustomer"
                            ShowCustomerSearch="@_showCustomerSearch"
                            OnCustomerSelected="OnCustomerSelected"
                            OnShowSearchChanged="@(v => _showCustomerSearch = v)"
                            Description="@_description"
                            OnDescriptionChanged="@(v => { _description = v; ValidateDescription(); TriggerAutoSave(); })"
                            OnOpenFilePicker="OpenFilePicker"
                            SearchCustomersFunc="SearchCustomersAsync" />
                    </ChildContent>
                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Left panel error.</MudAlert></ErrorContent>
                </ErrorBoundary>

                <div class="pn-center">
                    @if (_layoutMode == LayoutMode.Configurator)
                    {
                        @if (_parts.Count > 0)
                        {
                            <PartCarousel
                                Parts="@_parts"
                                SelectedIndex="@_selectedPartIndex"
                                OnSelectPart="@(i => _selectedPartIndex = i)"
                                OnRemovePart="RemovePart"
                                OnAddPart="OpenFilePicker" />
                        }

                        @if (_parts.Count > 0 && _selectedPartIndex < _parts.Count)
                        {
                            <div class="pn-detail-row">
                                <ErrorBoundary>
                                    <ChildContent>
                                        <PartDetailCard
                                            Part="@_parts[_selectedPartIndex]"
                                            TempProjectId="@_tempProjectId"
                                            OnPartChanged="OnPartChanged"
                                            OnOpenViewer="OpenBabylonViewer" />
                                    </ChildContent>
                                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Detail panel error.</MudAlert></ErrorContent>
                                </ErrorBoundary>
                                <PartConfigSidebar
                                    Part="@_parts[_selectedPartIndex]"
                                    Processes="@_processes"
                                    TempProjectId="@_tempProjectId"
                                    OnPartChanged="OnPartChanged" />
                            </div>
                        }
                        else
                        {
                            <div class="pn-empty-state"
                                 @ondragenter="@(() => _dragOver = true)"
                                 @ondragleave="@(() => _dragOver = false)"
                                 @ondragover:preventDefault="true">
                                <div class="pn-empty-dropzone @(_dragOver ? "pn-empty-dropzone-active" : "")"
                                     @ondrop.prevent="@(() => { _dragOver = false; OpenFilePicker(); })"
                                     @onclick="OpenFilePicker">
                                    <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Large" Color="@(_dragOver ? Color.Primary : Color.Default)" />
                                    <MudText Typo="Typo.h6" Color="@(_dragOver ? Color.Primary : Color.Default)" Class="mt-2">Drop files here or click to upload</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-1">STL, STEP, 3MF, OBJ, and more — up to 100 MB each</MudText>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pn-list-view">
                            <PartListView Parts="@_parts"
                                          Processes="@_processes"
                                          TempProjectId="@_tempProjectId"
                                          OnPartActivated="ActivatePartFromList"
                                          OnRemovePart="RemovePart"
                                          OnAddPart="OpenFilePicker"
                                          OnPartChanged="OnPartChanged" />
                        </div>
                    }
                </div>

                <ErrorBoundary>
                    <ChildContent>
                        <ProjectQuotePanel
                            Parts="@_parts"
                            LeadTimeOptions="@_leadTimeOptions"
                            SelectedLeadTime="@_selectedLeadTime"
                            OnLeadTimeChanged="@(lt => { _selectedLeadTime = lt; TriggerAutoSave(); })"
                            SelectedCurrency="@_selectedCurrency"
                            CanQuote="@CanSubmit"
                            Saving="@_saving"
                            OnQuote="CreateProjectAndQuoteAsync"
                            OnPartActivated="ActivatePartFromList" />
                    </ChildContent>
                    <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Quote panel error.</MudAlert></ErrorContent>
                </ErrorBoundary>
            </div>
        </ChildContent>
        <ErrorContent>
            <MudAlert Severity="Severity.Error" Class="ma-4">An unexpected error occurred. Please refresh.</MudAlert>
        </ErrorContent>
    </ErrorBoundary>
</div>

<MudFileUpload T="IReadOnlyList<IBrowserFile>"
               @ref="_fileUpload"
               FilesChanged="HandleFileSelected"
               Accept=".stl,.step,.stp,.3mf,.obj,.igs,.iges,.blend,.fbx,.gltf,.glb,.pdf,.dxf,.dwg,.png,.jpg,.jpeg,.tiff,.bmp,.webp,.doc,.docx,.xls,.xlsx,.zip,.rar,.7z"
               MaximumFileCount="20"
               Hidden="true"
               Style="display:none;" />

<style>
    .pn-root {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background: var(--mud-palette-background-grey);
    }
    .pn-body {
        flex: 1;
        display: flex;
        overflow: hidden;
        min-height: 0;
    }
    .pn-center {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
    }
    .pn-empty-detail {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pn-empty-state {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }
    .pn-empty-dropzone {
        border: 2px dashed var(--mud-palette-lines-default);
        border-radius: 16px;
        padding: 60px 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        max-width: 600px;
        width: 100%;
        transition: border-color 0.2s, background 0.2s;
    }
    .pn-empty-dropzone:hover { border-color: var(--mud-palette-primary); background: var(--mud-palette-primary-lighten); }
    .pn-empty-dropzone-active { border-color: var(--mud-palette-primary); background: var(--mud-palette-primary-lighten); }
    .pn-table-placeholder {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pn-detail-row {
        flex: 1;
        display: flex;
        overflow: hidden;
        min-height: 0;
    }
    .pn-list-view {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
    }
</style>
