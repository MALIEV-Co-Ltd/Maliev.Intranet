@page "/sales/projects/new"
@layout MainLayout
@using Maliev.Intranet.Shared
@using Maliev.Intranet.Shared.Dtos
@using Maliev.Intranet.Client.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>New Project | Intranet Gateway</PageTitle>

<div class="pn-root">
    <ErrorBoundary>
        <ChildContent>
            <div class="pn-body">
                @* ── Left: Parts List ─────────────────────────────────────── *@
                <div class="pn-desktop-parts">
                    <PartsListPanel
                        Parts="@_parts"
                        SelectedIndex="@_selectedPartIndex"
                        Title="@_title"
                        OnTitleChanged="@(v => { _title = v; ValidateTitle(); TriggerAutoSave(); })"
                        OnTitleCommit="@(() => { ValidateTitle(); TriggerAutoSave(); })"
                        AutoSaving="@_autoSaving"
                        LastSavedAt="@_lastSavedAt"
                        HasCustomerSelected="@(_selectedCustomer != null)"
                        OnDuplicate="DuplicateProject"
                        OnSelectPart="SelectPartFromPanel"
                        OnAddPart="OpenFilePicker"
                        OnRemovePart="RemovePart"
                        OnDuplicatePart="DuplicateSinglePart" />
                </div>

                <MudDrawer @bind-Open="_partsDrawerOpen"
                           Anchor="Anchor.Start"
                           Variant="DrawerVariant.Temporary"
                           Elevation="6"
                           ClipMode="DrawerClipMode.Never"
                           Class="pn-parts-drawer">
                    <PartsListPanel
                        Parts="@_parts"
                        SelectedIndex="@_selectedPartIndex"
                        Title="@_title"
                        OnTitleChanged="@(v => { _title = v; ValidateTitle(); TriggerAutoSave(); })"
                        OnTitleCommit="@(() => { ValidateTitle(); TriggerAutoSave(); })"
                        AutoSaving="@_autoSaving"
                        LastSavedAt="@_lastSavedAt"
                        HasCustomerSelected="@(_selectedCustomer != null)"
                        OnDuplicate="DuplicateProject"
                        OnSelectPart="SelectPartFromDrawer"
                        OnAddPart="OpenFilePicker"
                        OnRemovePart="RemovePart"
                        OnDuplicatePart="DuplicateSinglePart" />
                </MudDrawer>

                @* ── Center: Viewer + Detail ─────────────────────────────── *@
                <div class="pn-center">
                    <div class="pn-mobile-toolbar">
                        <button class="pn-parts-toggle" title="Open parts list" @onclick="@(() => _partsDrawerOpen = true)">
                            <MudIcon Icon="@Icons.Material.Outlined.Menu" Size="Size.Small" />
                            <span>Parts</span>
                            <span class="pn-parts-count">@_parts.Count</span>
                        </button>
                    </div>

                    @if (_parts.Count > 0 && _selectedPartIndex < _parts.Count)
                    {
                        <div class="pn-detail-row">
                            <ErrorBoundary>
                                <ChildContent>
                                    <PartDetailCard
                                        Part="@_parts[_selectedPartIndex]"
                                        TempProjectId="@_tempProjectId"
                                        OnPartChanged="OnPartChanged"
                                        OnOpenViewer="OpenBabylonViewer"
                                        OnRequestFreshViewerUrl="RequestFreshViewerUrlAsync"
                                        OnRemovePart="RemovePart" />
                                </ChildContent>
                                <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Detail panel error.</MudAlert></ErrorContent>
                            </ErrorBoundary>
                            <PartConfigSidebar
                                Part="@_parts[_selectedPartIndex]"
                                Processes="@_processes"
                                TempProjectId="@_tempProjectId"
                                CustomerId="@_selectedCustomerId"
                                OnPartChanged="OnPartChanged" />
                        </div>
                    }
                    else
                    {
                        <div class="pn-empty-state">
                            <FileUploadDropzone Icon="@Icons.Material.Outlined.CloudUpload"
                                               Label="Drop files here or click to upload"
                                               SubLabel="@FileTypes.ThreeDSubLabel"
                                               MaxFileSizeLabel="max 100 MB"
                                               Class="pn-empty-dropzone"
                                               OnClick="OpenFilePicker"
                                               OnFilesDropped="OpenFilePicker" />
                        </div>
                    }
                </div>
            </div>

            @* ── Bottom: Quote Summary ───────────────────────────────────── *@
            <ErrorBoundary>
                <ChildContent>
                    <QuoteSummaryBar
                        SelectedCustomer="@_selectedCustomer"
                        SearchCustomers="@SearchCustomersAsync"
                        OnCustomerSelected="@OnCustomerSelected"
                        Parts="@_parts"
                        LeadTimeOptions="@_leadTimeOptions"
                        SelectedLeadTime="@_selectedLeadTime"
                        OnLeadTimeChanged="@(async lt => { _selectedLeadTime = lt; TriggerAutoSave(); foreach (var p in _parts) { TriggerPricingAsync(p); await TriggerRoutingFetchAsync(p); } })"
                        CanQuote="@CanSubmit"
                        Saving="@_saving"
                        OnQuote="CreateProjectAndQuoteAsync"
                        OnGeneratePdf="GenerateDraftPdfAsync" />
                </ChildContent>
                <ErrorContent><MudAlert Severity="Severity.Error" Class="ma-2">Quote panel error.</MudAlert></ErrorContent>
            </ErrorBoundary>
        </ChildContent>
        <ErrorContent>
            <MudAlert Severity="Severity.Error" Class="ma-4">An unexpected error occurred. Please refresh.</MudAlert>
        </ErrorContent>
    </ErrorBoundary>
</div>

<MudFileUpload T="IReadOnlyList<IBrowserFile>"
               @ref="_fileUpload"
               FilesChanged="HandleFileSelected"
               Accept="@FileTypes.ThreeDAcceptString"
               MaximumFileCount="20"
               Hidden="true"
               Style="display:none;" />

