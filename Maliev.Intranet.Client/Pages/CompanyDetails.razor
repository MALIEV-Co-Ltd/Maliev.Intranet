@page "/sales/companies/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_company?.Name ?? "Company Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16 pt-8">
    @if (_loading)
    {
        <MudStack Spacing="4">
            <MudSkeleton Height="60px" Width="40%" />
            <MudGrid>
                <MudItem xs="12" lg="8">
                    <MudSkeleton Height="400px" />
                </MudItem>
                <MudItem xs="12" lg="4">
                    <MudSkeleton Height="200px" />
                </MudItem>
            </MudGrid>
        </MudStack>
    }
    else if (_company == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Company not found.</MudAlert>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/sales/companies"))" Class="mt-4">Back to Companies</MudButton>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-8">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_company.Name</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Company ID: @_company.Id</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           Class="rounded-lg px-6" OnClick="OpenEditDialog">Edit Company</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Class="rounded-lg px-6 shadow-none">New Transaction</MudButton>
            </MudStack>
        </MudStack>

        <MudGrid Spacing="6">
            <MudItem xs="12" lg="8">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Business">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Registration Info</MudText>
                                    <MudStack Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tax ID (เลขประจำตัวผู้เสียภาษี)</MudText>
                                            <MudText Typo="Typo.body1">@(_company.VatNumber ?? "N/A")</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Registration Number (เลขทะเบียนนิติบุคคล)</MudText>
                                            <MudText Typo="Typo.body1">@(_company.RegistrationNumber ?? "N/A")</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Industry Segment</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="ma-0">@_company.Segment</MudChip>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Customer Tier</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ma-0">@_company.Tier</MudChip>
                                        </div>
                                    </MudStack>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Company Contact</MudText>
                                    <MudStack Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Email Address</MudText>
                                            @{
                                                var displayEmail = _company.ContactEmail
                                                    ?? _company.PrimaryContact?.Email
                                                    ?? _associatedCustomers.FirstOrDefault()?.Email;
                                            }
                                            @if (!string.IsNullOrEmpty(displayEmail))
                                            {
                                                <MudText Typo="Typo.body1">@displayEmail</MudText>
                                                @if (string.IsNullOrEmpty(_company.ContactEmail))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                                        (from primary contact)
                                                    </MudText>
                                                }
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body1">N/A</MudText>
                                            }
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Phone Number</MudText>
                                            <MudText Typo="Typo.body1">@(_company.ContactPhone ?? "N/A")</MudText>
                                        </div>
                                        @if (_company.PrimaryContact != null)
                                        {
                                            <div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Primary Contact</MudText>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                                                    <MudText Typo="Typo.body1">@_company.PrimaryContact.FullName</MudText>
                                                </MudStack>
                                            </div>
                                        }
                                    </MudStack>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Recent Transactions</MudText>
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No transactions found for this company.</MudAlert>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Associated Contacts" Icon="@Icons.Material.Filled.People">
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Company Representatives</MudText>
                            @if (_associatedCustomers != null && _associatedCustomers.Any())
                            {
                                <MudTable Items="_associatedCustomers" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="true">
                                    <HeaderContent>
                                        <MudTh></MudTh>
                                        <MudTh>Name</MudTh>
                                        <MudTh>Email</MudTh>
                                        <MudTh>Role/Segment</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd Style="width: 40px;">
                                            <MudTooltip Text="@(context.Id == _company?.PrimaryContact?.Id ? "Primary Contact" : "Set as Primary Contact")">
                                                <MudIconButton Icon="@(context.Id == _company?.PrimaryContact?.Id ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
                                                               Color="@(context.Id == _company?.PrimaryContact?.Id ? Color.Warning : Color.Default)"
                                                               Size="Size.Small"
                                                               Disabled="_promotingContactId != Guid.Empty"
                                                               OnClick="@(() => PromotePrimaryContact(context.Id))" />
                                            </MudTooltip>
                                        </MudTd>
                                        <MudTd DataLabel="Name">@context.Name</MudTd>
                                        <MudTd DataLabel="Email">@context.Email</MudTd>
                                        <MudTd DataLabel="Segment">@context.Segment</MudTd>
                                        <MudTd>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                       OnClick="@(() => Navigation.NavigateTo($"/sales/customers/{context.Id}"))">View Profile</MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No registered contacts found for this company.</MudAlert>
                            }
                        </MudCard>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Spacing="6">
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">System Details</MudText>
                        <MudStack Spacing="2">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Created At</MudText>
                                <MudText Typo="Typo.body2">@_company.CreatedAt.ToLocalTime().ToString("g")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Last Updated</MudText>
                                <MudText Typo="Typo.body2">@_company.UpdatedAt.ToLocalTime().ToString("g")</MudText>
                            </div>
                        </MudStack>
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private CompanyResponse? _company;
    private List<CustomerSummaryDto> _associatedCustomers = [];
    private bool _loading = true;
    private Guid _promotingContactId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompany();
        await LoadAssociatedCustomers();
    }

    private async Task LoadAssociatedCustomers()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>($"api/customers?companyId={Id}");
            _associatedCustomers = response?.Data.ToList() ?? [];
        }
        catch { }
    }

    private async Task LoadCompany()
    {
        _loading = true;
        try
        {
            _company = await Http.GetFromJsonAsync<CompanyResponse>($"api/companies/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading company: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditDialog()
    {
        if (_company == null) return;

        var parameters = new DialogParameters<EditCompanyDialog>
        {
            { x => x.Company, _company }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditCompanyDialog>("Edit Company", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadCompany();
            Snackbar.Add("Company updated successfully.", Severity.Success);
        }
    }

    private async Task PromotePrimaryContact(Guid customerId)
    {
        if (_company == null || _promotingContactId != Guid.Empty) return;
        if (_company.PrimaryContact?.Id == customerId) return; // already primary

        _promotingContactId = customerId;
        try
        {
            var response = await Http.PostAsync($"api/companies/{Id}/primary-contact/{customerId}", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Primary contact updated.", Severity.Success);
                await LoadCompany();
            }
            else
            {
                Snackbar.Add("Failed to update primary contact.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _promotingContactId = Guid.Empty;
        }
    }
}
