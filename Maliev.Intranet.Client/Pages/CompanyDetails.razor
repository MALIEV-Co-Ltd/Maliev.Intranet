@page "/sales/companies/{Id:guid}"
@using MudBlazor
@using Maliev.Intranet.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_company?.Name ?? "Company Details") - Maliev Intranet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16 pt-8">
    @if (_loading)
    {
        <MudStack Spacing="4">
            <MudSkeleton Height="60px" Width="40%" />
            <MudGrid>
                <MudItem xs="12" lg="8">
                    <MudSkeleton Height="400px" />
                </MudItem>
                <MudItem xs="12" lg="4">
                    <MudSkeleton Height="200px" />
                </MudItem>
            </MudGrid>
        </MudStack>
    }
    else if (_company == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Company not found.</MudAlert>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/sales/customers"))" Class="mt-4">Back to Customers</MudButton>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-8">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h3" Style="font-weight: 700;">@_company.Name</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Company ID: @_company.Id</MudText>
            </MudStack>
            
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Class="rounded-lg px-6" OnClick="@OpenEditCompanyDialog">Edit Company</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="rounded-lg px-6 shadow-none">New Transaction</MudButton>
            </MudStack>
        </MudStack>

        <MudGrid Spacing="6">
            <MudItem xs="12" lg="8">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-6" Color="Color.Transparent" SliderColor="Color.Primary">
                    <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Business">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Registration Info</MudText>
                                    <MudStack Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tax ID (เลขประจำตัวผู้เสียภาษี)</MudText>
                                            <MudText Typo="Typo.body1">@(_company.VatNumber ?? "N/A")</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Registration Number (เลขทะเบียนนิติบุคคล)</MudText>
                                            <MudText Typo="Typo.body1">@(_company.RegistrationNumber ?? "N/A")</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Industry Segment</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="ma-0">@_company.Segment</MudChip>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Customer Tier</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ma-0">@_company.Tier</MudChip>
                                        </div>
                                    </MudStack>
                                </MudCard>
                            </MudItem>
                            
                            <MudItem xs="12" sm="6">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default h-100">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Company Contact</MudText>
                                    <MudStack Spacing="3">
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Email Address</MudText>
                                            <MudText Typo="Typo.body1">@(_company.ContactEmail ?? "N/A")</MudText>
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Company Phone Number</MudText>
                                            <MudText Typo="Typo.body1">@(_company.ContactPhone ?? "N/A")</MudText>
                                        </div>
                                        
                                        <MudDivider Class="my-2" />
                                        
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Primary Contact Person</MudText>
                                            @if (!string.IsNullOrEmpty(_company.MainContactName))
                                            {
                                                <MudStack Spacing="0">
                                                    <MudLink OnClick="@(() => Navigation.NavigateTo($"/sales/customers/{_company.MainContactId}"))" Typo="Typo.body1" Style="font-weight: 600;">@_company.MainContactName</MudLink>
                                                    <MudText Typo="Typo.caption">@(_company.ContactEmail)</MudText>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body1">N/A</MudText>
                                            }
                                        </div>
                                    </MudStack>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12">
                                <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Recent Transactions</MudText>
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No transactions found for this company.</MudAlert>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    
                    <MudTabPanel Text="Contacts" Icon="@Icons.Material.Filled.People">
                        <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                            <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Company Representatives</MudText>
                            @if (_associatedCustomers != null && _associatedCustomers.Any())
                            {
                                <MudTable Items="_associatedCustomers" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Dense="true">
                                    <HeaderContent>
                                        <MudTh>Name</MudTh>
                                        <MudTh>Email</MudTh>
                                        <MudTh>Role/Segment</MudTh>
                                        <MudTh>Contact Person</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Name">
                                            <MudLink OnClick="@(() => Navigation.NavigateTo($"/sales/customers/{context.Id}"))" Typo="Typo.body2" Style="font-weight: 600;">@context.Name</MudLink>
                                        </MudTd>
                                        <MudTd DataLabel="Email">@context.Email</MudTd>
                                        <MudTd DataLabel="Segment">@context.Segment</MudTd>
                                        <MudTd DataLabel="Contact Person">
                                            @if (context.Id == _company.MainContactId)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Main Contact</MudChip>
                                            }
                                            else
                                            {
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => PromoteToMainContact(context.Id))">Promote</MudButton>
                                            }
                                        </MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/sales/customers/{context.Id}"))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Text">No registered contacts found for this company.</MudAlert>
                            }
                        </MudCard>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Spacing="6">
                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">System Details</MudText>
                        <MudStack Spacing="2">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Created At</MudText>
                                <MudText Typo="Typo.body2">@_company.CreatedAt.ToLocalTime().ToString("g")</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Last Updated</MudText>
                                <MudText Typo="Typo.body2">@_company.UpdatedAt.ToLocalTime().ToString("g")</MudText>
                            </div>
                        </MudStack>
                    </MudCard>

                    <MudCard Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default">
                        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: 700;">Audit Logs</MudText>
                        <MudTable Items="_activities" Hover="true" Dense="true" Elevation="0" FixedHeader="true" Height="400px">
                            <HeaderContent>
                                <MudTh>Action</MudTh>
                                <MudTh>Actor</MudTh>
                                <MudTh>Date</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Action">
                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Description</MudText>
                                </MudTd>
                                <MudTd DataLabel="Actor">
                                    <MudText Typo="Typo.caption">@GetActorDisplayName(context.ActorName, context.ActorId)</MudText>
                                </MudTd>
                                <MudTd DataLabel="Date">
                                    <MudText Typo="Typo.caption">@context.Timestamp.ToLocalTime().ToString("g")</MudText>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2">No logs found.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                        @if (_activityHasNextPage)
                        {
                            <MudButton OnClick="LoadMoreActivities" Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Class="mt-2" Disabled="@_loadingMoreActivities">
                                @(_loadingMoreActivities ? "Loading..." : "Load More")
                            </MudButton>
                        }
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private CompanyResponse? _company;
    private List<CustomerSummaryDto> _associatedCustomers = [];
    private List<CustomerActivityResponse> _activities = [];
    private bool _loading = true;
    private bool _loadingMoreActivities = false;
    private int _activityPage = 1;
    private bool _activityHasNextPage = false;
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Customers", href: "/sales/customers"),
        new BreadcrumbItem("Company Details", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCompany();
        await LoadAssociatedCustomers();
        await LoadInitialActivities();
    }

    private async Task LoadAssociatedCustomers()
    {
        try 
        { 
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerSummaryDto>>($"api/customers?companyId={Id}"); 
            _associatedCustomers = response?.Data.ToList() ?? [];
        }
        catch { }
    }

    private async Task LoadCompany()
    {
        _loading = true;
        try
        {
            _company = await Http.GetFromJsonAsync<CompanyResponse>($"api/companies/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading company: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInitialActivities()
    {
        _activityPage = 1;
        _activities.Clear();
        await LoadActivities();
    }

    private async Task LoadMoreActivities()
    {
        _activityPage++;
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        _loadingMoreActivities = true;
        try
        {
            var take = 10;
            var response = await Http.GetFromJsonAsync<PagedResponse<CustomerActivityResponse>>($"api/companies/{Id}/history?page={_activityPage}&pageSize={take}");
            if (response != null)
            {
                if (_activityPage == 1) _activities = response.Data.ToList();
                else _activities.AddRange(response.Data);
                _activityHasNextPage = _activities.Count < (response.Meta?.TotalItems ?? 0);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load activities", Severity.Error);
        }
        finally
        {
            _loadingMoreActivities = false;
            StateHasChanged();
        }
    }

    private string GetActorDisplayName(string? name, string? id)
    {
        if (!string.IsNullOrEmpty(name)) return name;
        if (string.IsNullOrEmpty(id)) return "Unknown User";
        if (id.Equals("00000000-0000-0000-0000-000000000001", StringComparison.OrdinalIgnoreCase) || 
            id.Equals("system", StringComparison.OrdinalIgnoreCase))
            return "System";
        return id;
    }

    private async Task OpenEditCompanyDialog()
    {
        if (_company == null) return;

        var parameters = new DialogParameters<EditCompanyDialog> { { x => x.Company, _company } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditCompanyDialog>("Edit Company", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadCompany();
        }
    }

    private async Task PromoteToMainContact(Guid customerId)
    {
        try
        {
            var response = await Http.PostAsync($"api/customers/{customerId}/promote", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Customer promoted to main contact", Severity.Success);
                await LoadCompany();
                await LoadAssociatedCustomers();
                await LoadInitialActivities();
            }
            else
            {
                Snackbar.Add("Failed to promote customer", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
