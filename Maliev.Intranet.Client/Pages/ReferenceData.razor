@page "/admin/reference-data"
<PageTitle>Reference Data | Intranet Gateway</PageTitle>
@inject NavigationManager Navigation

@code {
    /// <summary>Redirects legacy /admin/reference-data route to the consolidated Settings page (Reference Data tab).</summary>
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/settings?tab=reference-data", replace: true);
    }
}
